Options -Indexes
Options -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Defence-in-depth: never execute uploaded files as scripts. Uploads are
  # admin-only, re-encoded images (see Admin/Services/UploadService), but a hard
  # 403 here guarantees Apache can never run a malformed/smuggled .php under
  # /uploads/. Evaluated first, before any other rule. (Layer 2: public/uploads/.htaccess.)
  RewriteRule ^uploads/.*\.(?:php|phtml|phps|php[0-9]|phar|cgi|pl|py|asp|sh)$ - [F,L,NC]

  # Legacy redirect — old /africa-gates/* URLs (pre-subdomain) → new clean paths.
  # Keeps bookmarks, share links, and SEO-indexed pages alive after the cutover.
  RewriteRule ^africa-gates/?$        /             [R=301,L]
  RewriteRule ^africa-gates/(.+)$     /$1           [R=301,L,QSA]

  # Don't rewrite real files/directories
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Route everything through index.php
  RewriteRule ^ index.php [QSA,L]
</IfModule>

# Security headers
#
# These MUST match SecurityHeadersMiddleware::SHARED exactly, and both are needed.
# Apache serves every real file under public/ WITHOUT touching PHP (the
# RewriteCond !-f above), so a stylesheet, an SVG or an upload never reaches the
# middleware — only this block protects those. PHP responses need the middleware
# because this file is not read at all on nginx or the built-in server.
#
# `Header always set` REPLACES, so where both apply Apache's value is what a
# visitor gets and the middleware's is silently discarded. They were two
# independent copies with nothing checking they agreed. SecurityHeadersTest now
# parses this file and asserts it against the PHP constant, so a change to one
# without the other fails the suite instead of drifting in production.
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  # Deliberately 0, not "1; mode=block": the legacy XSS auditor introduced its own
  # vulnerabilities and CSP supersedes it. 0 disables it explicitly.
  Header always set X-XSS-Protection "0"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  # interest-cohort is gone — FLoC was withdrawn in 2022, so it denied nothing.
  Header always set Permissions-Policy "accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), usb=(), xr-spatial-tracking=()"
  # allow-popups, not plain same-origin: the payment flows redirect in the same tab
  # today, but a future popup checkout would lose window.opener and be unable to
  # report back. Reverse tabnabbing is severed either way.
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header unset Server
  Header unset X-Powered-By

  # ── CSP FALLBACK FOR EVERYTHING PHP NEVER SEES ────────────────────────────
  #
  # The site's real Content-Security-Policy is built per request by
  # AfricaGates\Support\Csp and sent by SecurityHeadersMiddleware, because it carries
  # a per-request NONCE. A nonce cannot exist in a static file, so the policy could
  # never be duplicated here the way the six headers above are.
  #
  # The consequence was a gap nobody had closed: Apache serves every real file under
  # public/ without touching PHP (the `RewriteCond !-f` above), so
  # /assets/**, /africa-gates-logo.svg and every file under /uploads/ went out with
  # NO CSP AT ALL. The one that matters is SVG — a browser executes an SVG navigated
  # to directly, same-origin, and script inside it runs with the site's cookies. The
  # flier route sends its own sandbox for exactly this reason; a file on disk had
  # nothing.
  #
  # ── `setifempty`, NOT `set`. THIS IS THE WHOLE DESIGN. ────────────────────
  #
  # `Header always set` REPLACES — which is documented above as the reason the six
  # shared headers must agree with the PHP constant. Applied to CSP it would be far
  # worse than a mismatch: it would overwrite the nonce-bearing policy on every HTML
  # page with this nonce-free one, and every inline script on the site — Alpine, the
  # nav, the cart, the ballot — would stop running. The page would look broken with
  # no error in any log.
  #
  # `setifempty` adds the header only when the response does not already have one, so
  # it is by construction a BACKUP: PHP's policy always wins where PHP ran, and this
  # applies to exactly the responses that had nothing. It also covers a PHP fatal that
  # dies before the middleware, where previously a stack trace went out unprotected.
  #
  # Version-gated because `setifempty` is Apache 2.4.7+; on anything older the
  # directive is a syntax error and would 500 the entire site. Guarded so a host
  # without mod_version simply keeps the previous behaviour — losing a backup is
  # acceptable, taking the site down to add one is not.
  #
  # ── WHY THIS POLICY ──────────────────────────────────────────────────────
  #
  # `default-src 'none'` is what stops a navigated-to SVG running script: script-src
  # inherits from it. `img-src` and `font-src` allow self+data so a directly-opened
  # image or font still renders. `style-src 'unsafe-inline'` keeps an SVG's internal
  # styling intact, which is presentation with no script capability.
  #
  # Deliberately NO `sandbox` here. Every stylesheet and script the site loads is a
  # real file under /assets/, so this header rides along on the site's own
  # subresources. Browsers ignore CSP delivered with a subresource for the embedding
  # document, so it is inert there — but `sandbox` is the one directive whose
  # behaviour on a non-document response is worth not betting the site's CSS on. The
  # hard sandbox lives in public/uploads/.htaccess instead, where the bytes are
  # untrusted and nothing the site depends on is served.
  <IfModule mod_version.c>
    <IfVersion >= 2.4.7>
      Header always setifempty Content-Security-Policy "default-src 'none'; img-src 'self' data:; style-src 'unsafe-inline'; font-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'self'"
    </IfVersion>
  </IfModule>
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

# Cache
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Block sensitive files
<FilesMatch "^\.env">
  Order allow,deny
  Deny from all
</FilesMatch>
