# Africa GATES — environment template.
# Copy to .env on the server. Any value containing spaces or non-ASCII
# characters MUST be wrapped in double quotes — vlucas/phpdotenv rejects
# bare-word values with whitespace.

APP_ENV=production
APP_URL=https://afg.afrovanguard.org.ng
APP_DEBUG=false
ASSET_VERSION=v1
TWIG_CACHE=true
# Force the Secure flag on session cookies. In production the app already defaults
# this on; setting it explicitly is belt-and-suspenders. Use =false ONLY for
# plain-HTTP local development (otherwise the login cookie won't be sent).
SESSION_SECURE=true

# ─── Database ───────────────────────────────────────────────────────
# DB_DRIVER=sqlite          # Uncomment for local dev (no config needed)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=africa_gates
DB_USER=your_db_user
DB_PASS=your_db_password

# ─── SMTP ────────────────────────────────────────────────────────────
# Brevo (recommended — free tier sends 300 emails/day)
#   Sign up at https://app.brevo.com → SMTP & API → SMTP
#   Host: smtp-relay.brevo.com  Port: 587  Auth: login (NOT API key)
#
# Gmail alternative (requires an App Password, not your Google password)
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587
#   SMTP_USER=you@gmail.com   SMTP_PASS=<16-char app password>
#   Generate at: myaccount.google.com → Security → App passwords
#
# cPanel/WHM shared hosting
#   SMTP_HOST=mail.yourdomain.com  SMTP_PORT=587
#   SMTP_USER=noreply@yourdomain.com  SMTP_PASS=<mailbox password>
#
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_login@email.com
SMTP_PASS=your_brevo_smtp_key
MAIL_FROM_ADDRESS=noreply@afrovanguard.org.ng
MAIL_FROM_NAME="Africa GATES"
# Inbox for admin alerts (nominations, registrations, partner enquiries).
# Falls back to MAIL_FROM_ADDRESS if left blank.
ADMIN_ALERT_EMAIL=app.admin@afrovanguard.org.ng

# ─── Cloudflare Turnstile (optional — bot protection for vote OTPs) ──
# Leave blank to disable. Free at dash.cloudflare.com → Turnstile.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# ─── Payments: Paystack + Flutterwave (optional) ────────────────────
# Leave ALL of these blank for development. With no SECRET key set, the partner
# page shows NO pay buttons and every CTA falls back to the enquiry form, so the
# site works end-to-end without a gateway. A provider goes live the moment its
# SECRET key is present (the public key alone does nothing).
#
# SECRET keys are server-only — they are NEVER sent to the browser. Use TEST keys
# (sk_test_… / FLWSECK_TEST-…) until you're ready, then swap to live keys.
#
# Paystack — dashboard.paystack.com → Settings → API Keys & Webhooks
#   • Set the webhook URL there to:  {APP_URL}/pay/webhook
#   • Signature is HMAC-SHA512 of the raw body with your SECRET key (auto-verified).
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
#
# Flutterwave — dashboard.flutterwave.com → Settings → Webhooks & API
#   • Set the webhook URL to:  {APP_URL}/pay/webhook
#   • Set a "Secret hash" in the FW webhook settings and copy the SAME value into
#     FLUTTERWAVE_WEBHOOK_HASH below — FW sends it back in the `verif-hash` header
#     and the app rejects any webhook whose hash doesn't match.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# ─── Google Apps Script sync (optional) ─────────────────────────────
GAS_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# ─── AI moderation (optional; falls back to heuristics if blank) ────
GROQ_API_KEY=
GEMINI_API_KEY=

# ─── Public-site copy ───────────────────────────────────────────────
ANNOUNCE_TEXT="Nominations open — 2026 Cycle · live in Nigeria · building toward 54 nations"

# ─── Subpath deployment ─────────────────────────────────────────────
# Leave blank when the site is on its own domain/subdomain root.
# e.g. APP_BASE_PATH=/africa-gates when serving under a subfolder.
APP_BASE_PATH=

# ─── GO-LIVE SECURITY CHECKLIST ─────────────────────────────────────
# Confirm before pointing real traffic at this deployment:
#   [ ] APP_ENV=production + APP_DEBUG=false  (hides stack traces — the error
#       handler shows a friendly page instead of internals)
#   [ ] Real DB_USER / DB_PASS set; DB_DRIVER left on MySQL (sqlite line commented)
#   [ ] SMTP_PASS is a real provider key — and ROTATE any secret that was ever
#       committed to a repo or pasted into a shared plaintext .env
#   [ ] Served over HTTPS — Secure cookies + HSTS only take effect on TLS
#   [ ] Default/seeded admin passwords changed (see database/seed.sql)
#   [ ] TURNSTILE_* set if you want bot protection on vote/OTP
#   [ ] ASSET_VERSION bumped each deploy so browsers fetch fresh CSS/JS
#   [ ] Payments (if going live): real PAYSTACK_SECRET_KEY and/or
#       FLUTTERWAVE_SECRET_KEY set; webhook URL {APP_URL}/pay/webhook registered in
#       each gateway dashboard; FLUTTERWAVE_WEBHOOK_HASH matches the FW "Secret
#       hash"; APP_URL is the real HTTPS host (callback + webhook are built from it)
