# Africa GATES — environment template.
# Copy to .env on the server. Any value containing spaces or non-ASCII
# characters MUST be wrapped in double quotes — vlucas/phpdotenv rejects
# bare-word values with whitespace.
#
# A .env FILE IS NOT THE ONLY OPTION. Every name below can equally be supplied as
# a real process environment variable — Docker `-e`, docker-compose `environment:`,
# Kubernetes secrets, systemd `Environment=`, PHP-FPM pool `env[]`, Apache
# `SetEnv`, or a PaaS config panel — and that is the better place for secrets,
# because they never touch the deployment tree. A real environment variable takes
# precedence over the same name in this file.
#
# Blank means unset. `SMTP_PASS=` reads as "not configured", so a value commented
# out this way falls back to the application default rather than to an empty string.
#
# Boolean flags accept 1/true/yes/on and 0/false/no/off, in any case. An
# unrecognised value (`TRUST_PROXY=maybe`) is treated as unset, not as true.

APP_ENV=production
APP_URL=https://afg.afrovanguard.org.ng
APP_DEBUG=false
# FALLBACK ONLY — you do not need to touch this any more.
#
# Stylesheets and scripts are linked through `{{ asset('/path') }}`, which appends a
# hash of the FILE'S CONTENTS. Uploading a changed file changes its URL immediately:
# no version to bump, no build step, nothing to remember. Files you did not change
# keep their URL and stay in the visitor's cache.
#
# This value is now used only when a path cannot be hashed (not a file under
# public/). It used to be the cache buster for everything, and that was a real bug:
# public/.htaccess caches css and js for ONE YEAR, and nothing on this host bumps
# this line — so every returning visitor stayed pinned to whatever they first
# downloaded, however many times the site was deployed.
ASSET_VERSION=v1
TWIG_CACHE=true
# Force the Secure flag on session cookies. In production the app already defaults
# this on; setting it explicitly is belt-and-suspenders. Use =false ONLY for
# plain-HTTP local development (otherwise the login cookie won't be sent).
SESSION_SECURE=true

# Reverse proxy / CDN trust. Set TRUST_PROXY=true ONLY when the app sits behind a
# proxy you control (Cloudflare, nginx, a load balancer) that sets X-Forwarded-For.
# When true, the client IP used for rate-limiting and fraud scoring is taken from
# X-Forwarded-For; when false (default) it uses REMOTE_ADDR. Setting true on a
# directly-exposed host lets clients SPOOF their IP; leaving false behind a proxy
# makes every visitor share the proxy's IP (rate limits over-trigger).
TRUST_PROXY=false

# ─── Database ───────────────────────────────────────────────────────
# MySQL is the CANONICAL / production database (schema.sql is the source of truth
# and the app defaults to the mysql driver). Configure the MySQL values below.
# Timezone every stored datetime is expressed in. UTC is strongly recommended:
# award-cycle phases are computed from date windows against the clock, and the
# CLI and web SAPIs on shared hosting often read different php.ini files — a
# mismatch makes cron and web requests disagree about whether voting is open.
APP_TIMEZONE=UTC

# MySQL session timezone. Leave UNSET — it is derived from APP_TIMEZONE's current
# UTC offset, which is what you want, and pinned on every connect so web, console,
# cron and migrations all agree.
#
# Why it is pinned at all: cycle boundaries are stored as DATETIME (MySQL returns
# them verbatim) while ballot and nomination timestamps are TIMESTAMP (converted
# into the SESSION timezone on read). So `voted_at >= voting_close` shifts by the
# session offset. Measured on MySQL 8.0 with the session at +01:00 — WAT, the
# obvious setting for a Nigerian server — a vote cast THIRTY MINUTES BEFORE a
# deadline is reported as late; under a negative offset real late votes are hidden.
#
# Set this only to override: a zone NAME if you have populated MySQL's timezone
# tables (mysql_tzinfo_to_sql — often absent on shared hosting, and the failure
# mode is every request erroring), or a fixed offset to match a database already
# written in some other frame.
# DB_TIMEZONE=+01:00

DB_DRIVER=mysql
# DB_DRIVER=sqlite          # Uncomment ONLY for quick local dev (no MySQL needed)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=africa_gates
DB_USER=your_db_user
DB_PASS=your_db_password

# ─── SMTP ────────────────────────────────────────────────────────────
# Brevo (recommended — free tier sends 300 emails/day)
#   Sign up at https://app.brevo.com → SMTP & API → SMTP
#   Host: smtp-relay.brevo.com  Port: 587  Auth: login (NOT API key)
#
# Gmail alternative (requires an App Password, not your Google password)
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587
#   SMTP_USER=you@gmail.com   SMTP_PASS=<16-char app password>
#   Generate at: myaccount.google.com → Security → App passwords
#
# cPanel/WHM shared hosting
#   SMTP_HOST=mail.yourdomain.com  SMTP_PORT=587
#   SMTP_USER=noreply@yourdomain.com  SMTP_PASS=<mailbox password>
#
# ── THESE FOUR ARE THE FALLBACK, NOT THE ONLY WAY ───────────────────────────
# All four are also settable at /admin/settings → Email & sender, and a value
# stored there WINS over the one here. That is the supported route on a host with
# no shell, where this file cannot be edited at all: mail would otherwise be
# unconfigurable, and OTP codes gate voting. Resolved in OtpService::boot().
#
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_login@email.com
SMTP_PASS=your_brevo_smtp_key
MAIL_FROM_ADDRESS=noreply@afrovanguard.org.ng
MAIL_FROM_NAME="Africa GATES"
# Inbox for admin alerts (nominations, registrations, partner enquiries).
# Falls back to MAIL_FROM_ADDRESS if left blank.
ADMIN_ALERT_EMAIL=app.admin@afrovanguard.org.ng

# ─── Cloudflare Turnstile (optional — bot protection for vote OTPs) ──
# Leave blank to disable. Free at dash.cloudflare.com → Turnstile.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# ─── Cloudinary image hosting (optional; local disk when blank) ──────
# Blank means "store uploads under public/uploads/" — exactly the behaviour this
# app has always had. Nothing degrades without these; images are just served from
# your own server, unoptimised and uncropped.
#
# WHAT YOU GAIN by setting them:
#   • Nominee portraits are delivered FACE-CROPPED (Cloudinary's g_faces:auto), so
#     the shareable flier frames the nominee's face instead of centre-cropping a
#     waist-up photo to their chest. That crop is the whole persuasive content of
#     a share graphic and GD cannot do it — see Support\Media.
#   • AVIF/WebP and per-device sizing via f_auto/q_auto/dpr_auto, which on a
#     mobile-first audience paying for data is the largest page-weight win here.
#   • Uploads stop consuming your hosting disk quota.
#
# Settable at /admin/settings → Media as well, and a value stored there wins over
# this file — the supported route where there is no shell to edit it with. Resolved
# in CloudinaryService::config().
#
# ONE LINE, from the Cloudinary dashboard (Programmable Media → API keys):
CLOUDINARY_URL=
# …or the same three values discretely, which is what a PaaS secret manager wants
# and what to use if your API secret contains a character that breaks the URL form:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Root folder for everything this site uploads. Namespaced so one Cloudinary
# account can host several sites without their folders colliding.
CLOUDINARY_FOLDER=africa-gates
#
# MOVING EXISTING IMAGES. Setting the credentials only affects NEW uploads. To move
# the photos already on disk and repoint every row that references them:
#   bin/console media:cloudinary --dry-run     # prints what it would do, changes nothing
#   bin/console media:cloudinary               # does it
# No shell on this host? Admin → Media has the same thing behind a button. Either
# way it is batched, resumable, safe to re-run, and it NEVER deletes a local file.

# ─── Payments: Paystack + Flutterwave (optional) ────────────────────
# Leave ALL of these blank for development. With no SECRET key set, the partner
# page shows NO pay buttons and every CTA falls back to the enquiry form, so the
# site works end-to-end without a gateway. A provider goes live the moment its
# SECRET key is present (the public key alone does nothing).
#
# SECRET keys are server-only — they are NEVER sent to the browser. Use TEST keys
# (sk_test_… / FLWSECK_TEST-…) until you're ready, then swap to live keys.
#
# Paystack — dashboard.paystack.com → Settings → API Keys & Webhooks
#   • Set the webhook URL there to:  {APP_URL}/pay/webhook
#   • Signature is HMAC-SHA512 of the raw body with your SECRET key (auto-verified).
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
#   • OPTIONAL second line of defence: restrict which addresses may deliver a webhook.
#     Leave BLANK unless you know your server sees Paystack's real address — behind
#     Cloudflare or any reverse proxy it does not, and every payment notification would
#     be refused. The signature check above is the real control; this is belt and braces.
#     Paystack's published addresses, for when you do want it:
#     PAYSTACK_WEBHOOK_IPS=52.31.139.75,52.49.173.169,52.214.14.220
PAYSTACK_WEBHOOK_IPS=
#   • KILL SWITCH for subaccount routing. Set to `off` to stop sending the `subaccount`
#     field entirely — money settles to the main account, exactly as it did before
#     subaccounts were configured. Your codes stay saved in Settings and come back the
#     moment you remove this. Reach for it if payments start failing after you route a
#     stream and you need them working again in one line rather than one deploy.
PAYSTACK_SUBACCOUNTS=
#
# Flutterwave — dashboard.flutterwave.com → Settings → Webhooks & API
#   • Set the webhook URL to:  {APP_URL}/pay/webhook
#   • Set a "Secret hash" in the FW webhook settings and copy the SAME value into
#     FLUTTERWAVE_WEBHOOK_HASH below — FW sends it back in the `verif-hash` header
#     and the app rejects any webhook whose hash doesn't match.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# ─── Google Apps Script sync (optional) ─────────────────────────────
GAS_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Shared secret for the PRIVILEGED Apps Script actions — creating a Google Meet link for a
# judging interview, and fetching the transcript afterwards. Sheet writes never use it.
#
# The web app is deployed "access: anyone" so this platform can post to it without
# credentials. Writing a row into a private sheet is a tolerable thing for a stranger with
# the URL to be able to do; booking events in your calendar and reading your meeting
# transcripts is not. So those two actions require this value to match the SECRET constant
# at the top of config/AfricaGATES_AppScript.gs, and the script refuses them when either
# side is empty.
#
# Generate one and paste the SAME string into both places, then redeploy the script
# (Deploy → Manage deployments → edit → New version):
#     php -r 'echo bin2hex(random_bytes(24)), PHP_EOL;'
#
# Leave it blank and interviews still work — you paste the Meet link and the transcript in
# by hand on the interview screen.
GAS_SECRET=

# ─── AI model delegation ────────────────────────────────────────────
# Each AI feature pins a model by what its output is USED for, not by whichever
# key happens to be configured first (see AiCapability::PRIMARY). All three tiers
# pin GROQ, whose relevant models are free-tier:
#
#   reason (temp 0.15) — moderation, nomination triage, duplicate-merge
#                        suggestions, the operator copilot, integrity briefs,
#                        search interpretation. Being wrong is the cost.
#                        -> groq:llama-3.3-70b-versatile
#   write  (temp 0.70) — prose a human reads and may publish: the public guide,
#                        thread summaries, the note sent to a nominator, rally
#                        copy on a share flier, admin drafting help. The failure
#                        mode is flat machine text nobody will post, so it needs a
#                        warmer temperature and a longer budget than a classifier.
#                        -> groq:llama-3.3-70b-versatile
#   fast   (temp 0.20) — suggestions accepted or discarded on a synchronous
#                        request, where latency IS the feature.
#                        -> groq:llama-3.1-8b-instant
#
# Fallback ladder: Gemini (free tier), then the OTHER Groq model — Groq rate-limits
# per MODEL, so a 429 on the 8b model says nothing about the 70b one, which makes
# that the most likely recoverable failure. Two fallbacks, because the attempt cap
# is three hops and a longer ladder has rungs nothing can reach.
#
# ANTHROPIC AND OPENAI ARE NOT IN THE LADDER, on purpose. An unpaid key fails with
# a 401 rather than being absent, and the router can only skip a provider with NO
# key — so the hop costs a real timeout. They are still reached after the declared
# hops when a key is present, and a deployment whose only key is one of those gets
# every feature: a pin decides preference, not eligibility.
#
# Setting a model below overrides the pin for that provider, so moving to a newer
# or larger free Groq model is a config change, not a deploy. Admin Settings →
# AI providers does the same through the browser and takes precedence over these.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Optional, and NOT in any declared ladder — see above.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_API_KEY=
OPENAI_MODEL=

GROQ_MODERATION_KEY=
# GROQ_MODERATION_MODEL=llama-3.3-70b-versatile

# ─── ElevenLabs (optional) — voice on the nominee's questionnaire ────
# Not a language model and not part of the ladder above: with a key here, each
# question on /my-work/{token} can be READ ALOUD, and a nominee can ANSWER BY
# TALKING. A craftsperson or a 71-year-old master drummer should not lose a
# nomination to a phone keyboard — that is the whole reason this exists.
#
# The transcription lands in the answer box for the nominee to correct and send
# themselves; it never writes to the record directly, because a judge reads those
# answers as the nominee's own words. Blank = the questionnaire is text-only and
# no microphone is rendered at all.
#
# PICK A VOICE. The built-in default is an American one and is a placeholder, not
# a recommendation — copy an ID from your ElevenLabs voice library. For a
# continental African panel the accent is not a cosmetic choice.
# Admin Settings → AI providers holds the same three and takes precedence.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_multilingual_v2
# ELEVENLABS_STT_MODEL=scribe_v1

# ── THE INTERVIEW RECORDING BOT (Attendee) ───────────────────────────────────
#
# WHAT IT IS. Attendee (github.com/attendee-labs/attendee) joins a judging
# interview on Google Meet as a participant, records it, transcribes it, and
# will play audio into the room. That last part is what nothing else here can
# do: this host is PHP-FPM on cPanel with no long-running process, so it cannot
# hold a media session. Attendee runs elsewhere and this platform is a client.
#
# YOU HAVE TO HOST IT. The default base URL below is the vendor's hosted
# service, billed per meeting-hour. Self-hosted it is free per meeting and you
# pay for the container instead. Point ATTENDEE_BASE_URL at your own instance;
# Admin → Interviews prints which one is answering, because discovering it from
# an invoice is the expensive way to find out.
#
# Blank ATTENDEE_API_KEY = no bot is ever sent. Interviews fall back to the
# browser extension reading Meet's live captions, exactly as before.
# ATTENDEE_API_KEY=
# ATTENDEE_BASE_URL=https://meetbot.your-domain.org
# ATTENDEE_BOT_NAME=Africa GATES Interview Assistant

# The transcription model Attendee is told to use. OpenAI rather than Meet's
# free captions on purpose: the recogniser is primed with the nominee's name,
# organisation and category, and Meet's is not — in a transcript whose whole job
# is to quote an African nominee accurately to a panel. Needs OPENAI_API_KEY
# above; without it Attendee falls back to the meeting's own captions.
# ATTENDEE_STT_MODEL=gpt-4o-transcribe

# The bot's own voice, when a sitting has voice switched on. Synthesised HERE and
# handed to Attendee as MP3 — NOT Attendee's built-in /speech, which supports only
# Google Cloud TTS and would mean a second vendor and a service-account JSON on
# the bot host.
#
# TWO ENGINES. Blank picks whichever has a key, preferring ElevenLabs. That order
# is NOT about price — ElevenLabs is generally dearer per character. It is about
# accent: this voice asks forty nominees about their life's work, and OpenAI's
# catalogue is eight American-English presets with no say in the matter.
#
# The model that decides WHAT to ask is separate and stays with the AI gateway, so
# the brain and the mouth can be changed independently.
#
# What actually bounds the bill is neither engine: it is the clip cache in
# var/cache/interview-voice. The opening disclosure and every scripted pack
# question are identical across sittings, so they are synthesised once for the
# season. Only generated follow-ups are ever paid for twice.
# INTERVIEW_TTS_ENGINE=            # elevenlabs | openai | blank to auto-detect

# ElevenLabs. Uses ELEVENLABS_API_KEY above — SO IT SHARES THE QUESTIONNAIRE'S
# QUOTA. A season of interviews can exhaust what nominees use to hear their own
# questions read aloud, and nobody finds out until a play button stops working.
# Watch the ElevenLabs dashboard during a judging round.
# INTERVIEW_ELEVEN_VOICE_ID=       # blank reuses the questionnaire's voice
# INTERVIEW_ELEVEN_MODEL=eleven_multilingual_v2

# OpenAI. 'alloy' is a placeholder, not a recommendation — Admin → Interviews
# lists the alternatives.
# INTERVIEW_TTS_MODEL=gpt-4o-mini-tts
# INTERVIEW_TTS_VOICE=alloy

# Attendee's callback, which only makes 'auto' mode fast — the cron sweep
# recovers everything by polling, and no callback is registered at all unless one
# of the two secrets below is set and this site is reachable over HTTPS.
#
# PREFER THIS ONE. It is Attendee's OWN webhook secret, not a value you invent:
# copy it from the instance at Settings → Webhooks. Attendee signs every delivery
# and sends base64(HMAC-SHA256(canonical JSON, secret)) in the X-Webhook-Signature
# header, and this is what verifies it.
# ATTENDEE_WEBHOOK_SIGNING_SECRET=
#
# The fallback, for a deployment that injects a shared secret at a reverse proxy,
# checked against an X-Attendee-Secret header. Generate with:
#   openssl rand -hex 32
# Attendee itself cannot send this — its per-bot webhooks take only a url and a
# list of triggers, with no custom headers — so it is only useful when something
# in front of this host adds the header. An earlier version of this file claimed
# you could configure it inside Attendee. You cannot.
# ATTENDEE_WEBHOOK_SECRET=

# What the bot says when it joins the room. The nominee has already consented in
# writing before a bot is ever dispatched, so this is not the consent step — it is
# the reminder, the moment someone who agreed a week ago can see it and object.
# Set to 'none' to say nothing. Blank does NOT disable it; blank reads as unset
# and gets the default.
# ATTENDEE_JOIN_NOTICE=This interview is being recorded and transcribed for the judging panel.

# Path to a PNG or JPEG for the bot's avatar in the participant list. Checked by
# its actual bytes, so africa-gates-logo.svg copied to .png is ignored rather than
# failing the whole create-bot call. SVG is not supported by Attendee at all.
# ATTENDEE_BOT_IMAGE=/home/user/public_html/assets/bot-avatar.png

# Model for Gee's legacy direct-Anthropic path. Blank uses a real pinned
# default; it previously fell back to an id no provider serves, so setting only
# ANTHROPIC_API_KEY made Gee LOOK AI-powered while every call 404'd and it
# silently served canned answers.
# GEE_MODEL=claude-haiku-4-5-20251001

# ─── Gee ↔ Make.com AI-agent bridge (optional; off by default) ──────
# When set, Gee forwards conversations to your Make agent (and can use its
# tools); the SAME key authenticates Make's inbound calls to
# POST /api/v1/agent/gee. Admin Settings can also hold these (settings win).
GEE_MAKE_AGENT_URL=
GEE_MAKE_AGENT_KEY=

# ─── Messaging: SMS + WhatsApp (optional; off by default) ───────────
# Admin Settings → "Messaging" can also hold these (settings win over env).
# SMS_ENABLED / WA_ENABLED must be truthy ('1') for anything to send.
# SMS via Twilio; WhatsApp via the Meta WhatsApp Business Cloud API
# (preferred) or Twilio's WhatsApp channel. Numbers are E.164.
SMS_ENABLED=
WA_ENABLED=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
# TWILIO_WA_FROM=+14155238886
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=

# ─── Public-site copy ───────────────────────────────────────────────
ANNOUNCE_TEXT="Nominations open — 2026 Cycle · live in Nigeria · building toward 54 nations"

# ─── Subpath deployment ─────────────────────────────────────────────
# Leave blank when the site is on its own domain/subdomain root.
# e.g. APP_BASE_PATH=/africa-gates when serving under a subfolder.
APP_BASE_PATH=

# ─── Webcron (optional — for hosts without reliable shell cron) ─────
# Set a strong secret, then point a webcron service (cron-job.org, EasyCron, or a
# cPanel "curl a URL" job) at {APP_URL}/__cron/run?token=THIS every ~15 min. It
# runs the same maintenance hub as cron/maintenance.php. Blank = endpoint 404s
# (disabled). The token may also be sent as the X-Cron-Token header.
CRON_TOKEN=

# ─── Data retention (privacy:purge — NDPR/GDPR) ─────────────────────
# OFF by default: an unset/0 window means that table is NEVER purged.
# `bin/console privacy:purge` is a dry-run unless --commit. Drafts default to 30d.
# Donations / approved profiles / votes are never auto-purged (legal/public/integrity).
# See docs/SECURITY-HARDENING-V3.md for the policy + erasure runbook.
# RETAIN_DRAFT_DAYS=30
# RETAIN_REJECTED_NOMINATION_DAYS=120
# AI audit trail. The call log holds no prompt text (only a hash) but does hold
# subject ids. Decisions are the accountability + evaluation record, so keep them
# longer. 0 or unset = never purged.
# RETAIN_AI_CALL_DAYS=90
# RETAIN_AI_DECISION_DAYS=365
# RETAIN_CLOSED_ENQUIRY_DAYS=365
# RETAIN_EVENT_REGISTRATION_DAYS=365
# RETAIN_UNSUBSCRIBED_NEWSLETTER_DAYS=90

# ─── Ads (Google AdSense — optional monetization) ───────────────────
# Off until set. Use IDs from your approved AdSense account. The shop renders a
# labeled, responsive unit below the product grid; set ADSENSE_SLOT_2 for a second
# (bottom) unit. Admin → Settings can override these without a redeploy.
# ADSENSE_CLIENT=ca-pub-0000000000000000
# ADSENSE_SLOT=0000000000
# ADSENSE_SLOT_2=

# ─── GO-LIVE SECURITY CHECKLIST ─────────────────────────────────────
# Confirm before pointing real traffic at this deployment:
#   [ ] APP_ENV=production + APP_DEBUG=false  (hides stack traces — the error
#       handler shows a friendly page instead of internals)
#   [ ] Real DB_USER / DB_PASS set; DB_DRIVER left on MySQL (sqlite line commented)
#   [ ] SMTP_PASS is a real provider key — and ROTATE any secret that was ever
#       committed to a repo or pasted into a shared plaintext .env
#   [ ] Served over HTTPS — Secure cookies + HSTS only take effect on TLS
#   [ ] Default/seeded admin passwords changed (see database/seed.sql)
#   [ ] GROQ_API_KEY set if you want AI at all — every feature pins Groq first
#       (free tier) and falls back to Gemini. With no key anywhere, moderation and
#       triage run on the built-in heuristics and the guide serves scripted
#       answers; nothing breaks, but nothing is AI-assisted either. Confirm with
#       `php bin/console app:doctor` on the server.
#   [ ] TURNSTILE_* set if you want bot protection on vote/OTP
#   [ ] ASSET_VERSION bumped each deploy so browsers fetch fresh CSS/JS
#   [ ] Payments (if going live): real PAYSTACK_SECRET_KEY and/or
#       FLUTTERWAVE_SECRET_KEY set; webhook URL {APP_URL}/pay/webhook registered in
#       each gateway dashboard; FLUTTERWAVE_WEBHOOK_HASH matches the FW "Secret
#       hash"; APP_URL is the real HTTPS host (callback + webhook are built from it)

# Where support tickets and “email the team” land. One address, resolved by
# Notifier::supportEmail() — admin setting `support_email` overrides this.
SUPPORT_EMAIL=gates@afrovanguard.org.ng
