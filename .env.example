# Africa GATES — environment template.
# Copy to .env on the server. Any value containing spaces or non-ASCII
# characters MUST be wrapped in double quotes — vlucas/phpdotenv rejects
# bare-word values with whitespace.

APP_ENV=production
APP_URL=https://afg.afrovanguard.org.ng
APP_DEBUG=false
ASSET_VERSION=v1
TWIG_CACHE=true
# Force the Secure flag on session cookies. In production the app already defaults
# this on; setting it explicitly is belt-and-suspenders. Use =false ONLY for
# plain-HTTP local development (otherwise the login cookie won't be sent).
SESSION_SECURE=true

# Reverse proxy / CDN trust. Set TRUST_PROXY=true ONLY when the app sits behind a
# proxy you control (Cloudflare, nginx, a load balancer) that sets X-Forwarded-For.
# When true, the client IP used for rate-limiting and fraud scoring is taken from
# X-Forwarded-For; when false (default) it uses REMOTE_ADDR. Setting true on a
# directly-exposed host lets clients SPOOF their IP; leaving false behind a proxy
# makes every visitor share the proxy's IP (rate limits over-trigger).
TRUST_PROXY=false

# ─── Database ───────────────────────────────────────────────────────
# MySQL is the CANONICAL / production database (schema.sql is the source of truth
# and the app defaults to the mysql driver). Configure the MySQL values below.
# Timezone every stored datetime is expressed in. UTC is strongly recommended:
# award-cycle phases are computed from date windows against the clock, and the
# CLI and web SAPIs on shared hosting often read different php.ini files — a
# mismatch makes cron and web requests disagree about whether voting is open.
APP_TIMEZONE=UTC

DB_DRIVER=mysql
# DB_DRIVER=sqlite          # Uncomment ONLY for quick local dev (no MySQL needed)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=africa_gates
DB_USER=your_db_user
DB_PASS=your_db_password

# ─── SMTP ────────────────────────────────────────────────────────────
# Brevo (recommended — free tier sends 300 emails/day)
#   Sign up at https://app.brevo.com → SMTP & API → SMTP
#   Host: smtp-relay.brevo.com  Port: 587  Auth: login (NOT API key)
#
# Gmail alternative (requires an App Password, not your Google password)
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587
#   SMTP_USER=you@gmail.com   SMTP_PASS=<16-char app password>
#   Generate at: myaccount.google.com → Security → App passwords
#
# cPanel/WHM shared hosting
#   SMTP_HOST=mail.yourdomain.com  SMTP_PORT=587
#   SMTP_USER=noreply@yourdomain.com  SMTP_PASS=<mailbox password>
#
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_login@email.com
SMTP_PASS=your_brevo_smtp_key
MAIL_FROM_ADDRESS=noreply@afrovanguard.org.ng
MAIL_FROM_NAME="Africa GATES"
# Inbox for admin alerts (nominations, registrations, partner enquiries).
# Falls back to MAIL_FROM_ADDRESS if left blank.
ADMIN_ALERT_EMAIL=app.admin@afrovanguard.org.ng

# ─── Cloudflare Turnstile (optional — bot protection for vote OTPs) ──
# Leave blank to disable. Free at dash.cloudflare.com → Turnstile.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# ─── Payments: Paystack + Flutterwave (optional) ────────────────────
# Leave ALL of these blank for development. With no SECRET key set, the partner
# page shows NO pay buttons and every CTA falls back to the enquiry form, so the
# site works end-to-end without a gateway. A provider goes live the moment its
# SECRET key is present (the public key alone does nothing).
#
# SECRET keys are server-only — they are NEVER sent to the browser. Use TEST keys
# (sk_test_… / FLWSECK_TEST-…) until you're ready, then swap to live keys.
#
# Paystack — dashboard.paystack.com → Settings → API Keys & Webhooks
#   • Set the webhook URL there to:  {APP_URL}/pay/webhook
#   • Signature is HMAC-SHA512 of the raw body with your SECRET key (auto-verified).
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
#
# Flutterwave — dashboard.flutterwave.com → Settings → Webhooks & API
#   • Set the webhook URL to:  {APP_URL}/pay/webhook
#   • Set a "Secret hash" in the FW webhook settings and copy the SAME value into
#     FLUTTERWAVE_WEBHOOK_HASH below — FW sends it back in the `verif-hash` header
#     and the app rejects any webhook whose hash doesn't match.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# ─── Google Apps Script sync (optional) ─────────────────────────────
GAS_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# ─── AI moderation (optional; falls back to heuristics if blank) ────
# Any ONE provider key enables AI spam checks on borderline submissions; with
# none set, the heuristic scorer is used. Optional *_MODEL overrides fall back to
# a built-in default per provider.
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Per-provider model overrides — point each at the best model your plan allows.
# Blank = a sensible built-in default. Admin → Settings → AI providers sets these
# too (and there's a "Test AI now" button to confirm keys + connectivity).
# GROQ_MODEL=
# GEMINI_MODEL=
# ANTHROPIC_MODEL=
# OPENAI_MODEL=
# Optional 2nd Groq key JUST for moderation (spam/abuse classifier). Runs the
# best model and keeps safety decisions off the public AI budget. If blank,
# moderation free-falls back to GROQ_API_KEY. Admin Settings can also hold these.
GROQ_MODERATION_KEY=
# GROQ_MODERATION_MODEL=llama-3.3-70b-versatile

# ─── Gee ↔ Make.com AI-agent bridge (optional; off by default) ──────
# When set, Gee forwards conversations to your Make agent (and can use its
# tools); the SAME key authenticates Make's inbound calls to
# POST /api/v1/agent/gee. Admin Settings can also hold these (settings win).
GEE_MAKE_AGENT_URL=
GEE_MAKE_AGENT_KEY=

# ─── Messaging: SMS + WhatsApp (optional; off by default) ───────────
# Admin Settings → "Messaging" can also hold these (settings win over env).
# SMS_ENABLED / WA_ENABLED must be truthy ('1') for anything to send.
# SMS via Twilio; WhatsApp via the Meta WhatsApp Business Cloud API
# (preferred) or Twilio's WhatsApp channel. Numbers are E.164.
SMS_ENABLED=
WA_ENABLED=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
# TWILIO_WA_FROM=+14155238886
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=

# ─── Public-site copy ───────────────────────────────────────────────
ANNOUNCE_TEXT="Nominations open — 2026 Cycle · live in Nigeria · building toward 54 nations"

# ─── Subpath deployment ─────────────────────────────────────────────
# Leave blank when the site is on its own domain/subdomain root.
# e.g. APP_BASE_PATH=/africa-gates when serving under a subfolder.
APP_BASE_PATH=

# ─── Webcron (optional — for hosts without reliable shell cron) ─────
# Set a strong secret, then point a webcron service (cron-job.org, EasyCron, or a
# cPanel "curl a URL" job) at {APP_URL}/__cron/run?token=THIS every ~15 min. It
# runs the same maintenance hub as cron/maintenance.php. Blank = endpoint 404s
# (disabled). The token may also be sent as the X-Cron-Token header.
CRON_TOKEN=

# ─── Data retention (privacy:purge — NDPR/GDPR) ─────────────────────
# OFF by default: an unset/0 window means that table is NEVER purged.
# `bin/console privacy:purge` is a dry-run unless --commit. Drafts default to 30d.
# Donations / approved profiles / votes are never auto-purged (legal/public/integrity).
# See docs/SECURITY-HARDENING-V3.md for the policy + erasure runbook.
# RETAIN_DRAFT_DAYS=30
# RETAIN_REJECTED_NOMINATION_DAYS=120
# RETAIN_CLOSED_ENQUIRY_DAYS=365
# RETAIN_EVENT_REGISTRATION_DAYS=365
# RETAIN_UNSUBSCRIBED_NEWSLETTER_DAYS=90

# ─── Ads (Google AdSense — optional monetization) ───────────────────
# Off until set. Use IDs from your approved AdSense account. The shop renders a
# labeled, responsive unit below the product grid; set ADSENSE_SLOT_2 for a second
# (bottom) unit. Admin → Settings can override these without a redeploy.
# ADSENSE_CLIENT=ca-pub-0000000000000000
# ADSENSE_SLOT=0000000000
# ADSENSE_SLOT_2=

# ─── GO-LIVE SECURITY CHECKLIST ─────────────────────────────────────
# Confirm before pointing real traffic at this deployment:
#   [ ] APP_ENV=production + APP_DEBUG=false  (hides stack traces — the error
#       handler shows a friendly page instead of internals)
#   [ ] Real DB_USER / DB_PASS set; DB_DRIVER left on MySQL (sqlite line commented)
#   [ ] SMTP_PASS is a real provider key — and ROTATE any secret that was ever
#       committed to a repo or pasted into a shared plaintext .env
#   [ ] Served over HTTPS — Secure cookies + HSTS only take effect on TLS
#   [ ] Default/seeded admin passwords changed (see database/seed.sql)
#   [ ] TURNSTILE_* set if you want bot protection on vote/OTP
#   [ ] ASSET_VERSION bumped each deploy so browsers fetch fresh CSS/JS
#   [ ] Payments (if going live): real PAYSTACK_SECRET_KEY and/or
#       FLUTTERWAVE_SECRET_KEY set; webhook URL {APP_URL}/pay/webhook registered in
#       each gateway dashboard; FLUTTERWAVE_WEBHOOK_HASH matches the FW "Secret
#       hash"; APP_URL is the real HTTPS host (callback + webhook are built from it)
