{% extends "layout/gates.twig" %}

{% block head_styles %}
<style>
  body[data-page="blog"]{ background:#eef0ec; color:var(--ag-ink); }
  .bl{ max-width:1180px; margin:0 auto; padding:0 var(--ag-gutter,28px) 60px; }

  .bl-hero{ position:relative; overflow:hidden; border-radius:24px; margin-top:24px; background:radial-gradient(130% 130% at 80% 0%,#1d5b2a,#10292C 60%); padding:clamp(2.4rem,5.5vw,3.2rem) clamp(1.6rem,4vw,2.6rem); color:#fff; }
  .bl-hero__orb{ position:absolute; right:-60px; bottom:-80px; width:320px; height:320px; border-radius:50%; background:radial-gradient(circle,rgba(212,154,14,.28),transparent 68%); }
  .bl-hero__in{ position:relative; max-width:600px; }
  .bl-badge{ display:inline-flex; align-items:center; gap:7px; font-size:11px; font-weight:700; letter-spacing:.1em; text-transform:uppercase; color:#ffd24a; background:rgba(8,26,16,.55); box-shadow:inset 0 0 0 1px rgba(212,154,14,.32); padding:7px 14px; border-radius:999px; }
  .bl-hero h1{ margin:16px 0 0; color:#fff; font-family:var(--ag-font-display); font-weight:800; font-size:clamp(2rem,5vw,2.7rem); line-height:1.04; letter-spacing:-.02em; }
  .bl-hero h1 em{ color:#7FC87C; font-style:normal; }
  .bl-hero p{ margin:13px 0 0; font-size:15.5px; line-height:1.6; color:rgba(255,255,255,.85); max-width:480px; }

  .bl-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:20px; margin-top:28px; }
  @media(max-width:860px){ .bl-grid{ grid-template-columns:repeat(2,1fr); gap:14px; } }
  @media(max-width:560px){ .bl-grid{ grid-template-columns:1fr; } }
  .bl-card{ background:var(--ag-surface,#fff); border:1px solid rgba(16,41,44,.08); border-radius:18px; overflow:hidden; display:flex; flex-direction:column; text-decoration:none; color:inherit; transition:transform .15s, box-shadow .15s, border-color .15s; }
  .bl-card:hover{ transform:translateY(-3px); border-color:rgba(16,41,44,.16); box-shadow:0 20px 40px -26px rgba(16,41,44,.45); }
  .bl-card__media{ position:relative; aspect-ratio:16/10; background-size:cover; background-position:center; background-color:#10292C; }
  .bl-card__media--empty{ background:radial-gradient(120% 120% at 75% 0%,#1d5b2a,#10292C); }
  .bl-card__badge{ position:absolute; top:12px; left:12px; font-size:10px; font-weight:700; letter-spacing:.05em; text-transform:uppercase; color:#10292C; background:rgba(255,255,255,.92); padding:5px 10px; border-radius:999px; }
  .bl-card__body{ padding:16px 18px 18px; flex:1; display:flex; flex-direction:column; }
  .bl-card__meta{ font-size:12px; color:#5a6d6f; font-weight:500; }
  .bl-card__title{ margin:6px 0 0; font-family:var(--ag-font-display,serif); font-weight:700; font-size:17.5px; color:var(--ag-ink); line-height:1.2; }
  .bl-card__desc{ margin:9px 0 0; font-size:13.5px; line-height:1.55; color:#4a5256; display:-webkit-box; -webkit-line-clamp:3; -webkit-box-orient:vertical; overflow:hidden; }
  .bl-card__foot{ margin-top:14px; padding-top:13px; border-top:1px solid rgba(16,41,44,.06); display:flex; align-items:center; justify-content:space-between; }
  .bl-card__author{ font-size:12.5px; color:#5a6d6f; }
  .bl-card__link{ display:inline-flex; align-items:center; gap:6px; font-size:13px; font-weight:600; color:var(--ag-green,#237b22); }

  .bl-empty{ background:var(--ag-surface,#fff); border:1px solid rgba(16,41,44,.08); border-radius:20px; padding:clamp(2rem,5vw,3rem); text-align:center; margin-top:28px; }
  .bl-empty h3{ margin:0 0 .4rem; font-family:var(--ag-font-display); font-weight:700; font-size:1.4rem; color:var(--ag-ink); }
  .bl-empty p{ margin:0 auto 18px; color:#4a5256; max-width:440px; }
  .bl-empty__cta{ display:inline-flex; align-items:center; gap:7px; background:var(--ag-green,#237b22); color:#fff; font-weight:600; font-size:14px; padding:11px 22px; border-radius:999px; text-decoration:none; }
</style>
{% endblock %}

{% block content %}
<div class="bl">
  <div class="bl-hero">
    <div class="bl-hero__orb" aria-hidden="true"></div>
    <div class="bl-hero__in">
      <span class="bl-badge">✎ The Blog</span>
      <h1>Notes from the <em>index.</em></h1>
      <p>Announcements, methodology and partnership stories — written in the open, like the scores.</p>
    </div>
  </div>

  <h2 class="sr-only">Latest posts</h2>
  {% if posts is not empty %}
  <div class="bl-grid">
    {% for p in posts %}
    <a class="bl-card" href="/blog/{{ p.slug }}">
      <div class="bl-card__media {% if not p.cover_image %}bl-card__media--empty{% endif %}" {% if p.cover_image %}style="background-image:url('{{ p.cover_image }}')"{% endif %}>
        {% if p.tag %}<span class="bl-card__badge">{{ p.tag }}</span>{% endif %}
      </div>
      <div class="bl-card__body">
        <div class="bl-card__meta">{{ p.published_at|date('j F Y') }}</div>
        <h3 class="bl-card__title">{{ p.title }}</h3>
        {% if p.excerpt %}<p class="bl-card__desc">{{ p.excerpt }}</p>{% endif %}
        <div class="bl-card__foot">
          <span class="bl-card__author">{{ p.author }}</span>
          <span class="bl-card__link">Read
            <svg aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 20 20" fill="none"><path d="M7.5 4.5 13 10 7.5 15.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        </div>
      </div>
    </a>
    {% endfor %}
  </div>
  {% else %}
  <div class="bl-empty">
    <h3>The first story is being written</h3>
    <p>Announcements, methodology notes and partner stories will land here as the inaugural cycle unfolds.</p>
    <a class="bl-empty__cta" href="/nominate">Submit a nomination →</a>
  </div>
  {% endif %}
</div>
{% endblock %}
