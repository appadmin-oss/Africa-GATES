{% extends "layout/gates.twig" %}
{% block content %}
<div style="max-width:760px;margin:0 auto;padding:clamp(28px,5vw,48px) var(--ag-gutter,28px) 64px">
  <p style="font-size:12.5px;color:#5a6d6f;margin:0 0 10px"><a href="/" style="color:#5a6d6f;text-decoration:none">Africa GATES</a> · <a href="/terms" style="color:#5a6d6f;text-decoration:none">Terms</a> · <b style="color:var(--ag-ink,#10292C);font-weight:500">{{ programme.title }}</b></p>
  <h1 style="font-family:var(--ag-font-display);font-weight:800;font-size:clamp(1.9rem,5vw,2.7rem);line-height:1.05;letter-spacing:-.02em;color:var(--ag-ink,#10292C);margin:0">{{ programme.icon_emoji }} {{ programme.title }} — Terms</h1>
  <p style="margin:12px 0 0;font-size:14.5px;color:#5a6d6f">Eligibility, nomination and voting rules for this programme.</p>

  <div style="margin:26px 0 0;font-size:16px;line-height:1.75;color:#2b373d">
    {% if programme.terms %}
      {{ programme.terms|sanitize_html }}
    {% else %}
      <p>Specific terms for this programme haven't been published yet. The platform-wide <a href="/terms" style="color:var(--ag-green,#237b22);font-weight:600">Terms of Service</a> apply in the meantime, and our <a href="/integrity" style="color:var(--ag-green,#237b22);font-weight:600">Integrity &amp; Methodology</a> page explains how voting and judging work.</p>
    {% endif %}
  </div>

  <p style="margin:32px 0 0;font-size:13px;color:#5f7273;border-top:1px solid rgba(16,41,44,.08);padding-top:16px">See also the platform <a href="/terms" style="color:var(--ag-green,#237b22)">Terms of Service</a> and <a href="/privacy" style="color:var(--ag-green,#237b22)">Privacy Policy</a>.</p>
</div>
{% endblock %}
