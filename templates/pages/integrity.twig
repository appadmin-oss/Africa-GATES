      ? [{note: {title: 'Not running on this site'|trans|e, body: ['The return is a share of what supporters contribute. Voting here is free, so nothing is raised in anyone’s name and nothing is earned. The rules below would apply if contributions were turned on.'|trans|e]}}]
      : (return_off_reason|default('') == 'rate_zero'
        ? [{note: {title: 'Currently set to nothing'|trans|e, body: ['The share is set to 0%, so new contributions earn nothing for a nominee. Money already earned is kept.'|trans|e]}}]
        : [])
    )|merge([
    {p: 'A nominee keeps a share of what supporters contribute in their name, win or lose, because they raised it either way.'|trans|e},
    {table: {caption: 'How a nominee qualifies, and what they keep'|trans, head: ['Rule'|trans, 'Setting'|trans, 'What it means'|trans],
