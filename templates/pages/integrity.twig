{% block content %}
{#
  Alpine's expression compiler runs on a deferred script, so this inline block —
  which runs during parse — is guaranteed to have defined the component before
  `x-data` is evaluated. It carries a nonce; see Support\Csp.
#}
<script nonce="{{ csp_nonce }}">
window.agIntegrityDoc = function () {
  return {
    tabs: {{ doc_citations|column('id')|json_encode|raw }},
    tab: 'apa',
    said: '',
    menu: false,
    done: '',

    /* Arrow-key movement across the citation tabs.

       Not a nicety. The tabs carry a roving tabindex — the selected one is 0, the
       rest are -1 — which is correct for a tablist and means Tab enters the group
       once instead of stopping four times. But it also means the arrow keys are the
       ONLY way to reach the other three, so without this handler a keyboard user
       could see four formats and reach exactly one. Home and End are included
       because a four-item list is short enough that jumping to an end is faster
       than stepping to it. */
    moveTab: function (dir) {
      var i = this.tabs.indexOf(this.tab);
      if (i < 0) i = 0;
      var next = dir === 'home' ? 0
               : dir === 'end'  ? this.tabs.length - 1
               : (i + (dir === 'next' ? 1 : -1) + this.tabs.length) % this.tabs.length;
      this.tab = this.tabs[next];
      /* Selection follows focus, so focus has to follow selection — otherwise the
         next arrow press is computed from a tab the browser is no longer on. */
      var el = document.getElementById('ar-tab-' + this.tab);
      if (el) el.focus();
    },

    /* One clipboard path for every button on the page.
       navigator.clipboard needs a secure context and is missing on some older
       Android WebViews, so the textarea fallback is not belt-and-braces — it is
       the only path on a real slice of this platform's traffic. */
    put: function (text, key, msg) {
      var self = this;
      var ok = function () {
        self.done = key;
        self.said = msg;
        window.setTimeout(function () { self.done = ''; }, 2200);
      };
      var fail = function () { self.said = 'Could not copy — select the text and copy it manually.'; };
      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(text).then(ok, fail);
        return;
      }
      try {
        var t = document.createElement('textarea');
        t.value = text;
        t.setAttribute('readonly', '');
        t.style.position = 'fixed';
        t.style.top = '-1000px';
        document.body.appendChild(t);
        t.select();
        var worked = document.execCommand('copy');
        document.body.removeChild(t);
        worked ? ok() : fail();
      } catch (e) { fail(); }
    },

    /* The whole document.

       Fetched from /integrity.txt rather than scraped out of the DOM or inlined
       into it. Scraping would put the furniture — contents, button labels, tab
       names — on the clipboard alongside the prose; inlining would ship ~15KB of
       duplicate text to every visitor for a button most never press. The fetch
       also guarantees the paste and the download are byte-identical, because
       they are the same response. */
    copyAll: function () {
      var self = this;
      this.said = 'Preparing…';
      fetch('/integrity.txt', { headers: { 'Accept': 'text/plain' } })
        .then(function (r) {
          if (!r.ok) throw new Error('http ' + r.status);
          return r.text();
        })
        .then(function (t) { self.put(t, 'all', 'Full document copied to the clipboard.'); })
        .catch(function () {
          self.said = 'Could not fetch the text — use Download instead.';
        });
    },

    copyCite: function (el) {
      this.put(el.innerText, 'cite', 'Citation copied.');
    },

    copyLink: function () {
      this.put({{ doc_url|json_encode|raw }}, 'link', 'Permalink copied.');
    }
  };
};
</script>

