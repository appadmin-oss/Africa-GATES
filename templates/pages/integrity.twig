{% extends "layout/gates.twig" %}

{% block head_styles %}
<style nonce="{{ csp_nonce }}">
  body[data-page="integrity"]{ background:#eef0ec; color:var(--ag-ink); }
  .mth{ max-width:920px; margin:0 auto; padding:clamp(2rem,5vw,2.9rem) var(--ag-gutter,32px) clamp(3rem,6vw,4rem); }

  .mth-hero{ text-align:center; max-width:640px; margin:0 auto; }
  .mth-hero .mth-eyebrow{ margin:0 0 10px; font:600 12px/1 var(--ag-font-body); letter-spacing:.14em; text-transform:uppercase; color:var(--ag-green); }
  .mth-hero h1{ margin:0; font-family:var(--ag-font-display); font-weight:700; font-size:clamp(2rem,4.6vw,2.625rem); letter-spacing:-.02em; }
  .mth-hero h1 em{ font-style:italic; color:var(--ag-green); }
  .mth-hero p{ margin:14px 0 0; font-size:16px; line-height:1.6; color:#52605c; }
  .mth-chips{ display:flex; flex-wrap:wrap; gap:8px; justify-content:center; margin-top:18px; }
  .mth-chip{ display:inline-flex; align-items:center; gap:7px; background:var(--ag-surface); border:1px solid rgba(16,41,44,.1); border-radius:999px; padding:7px 13px; font-size:12.5px; font-weight:500; color:#3a4448; }
  .mth-chip::before{ content:""; width:6px; height:6px; border-radius:50%; background:var(--ag-green); }

  .mth-h2{ margin:clamp(2.4rem,5vw,3.2rem) 0 4px; font-family:var(--ag-font-display); font-weight:700; font-size:clamp(1.5rem,3vw,1.85rem); letter-spacing:-.01em; }
  .mth-lead{ margin:0 0 1.3rem; color:#52605c; font-size:15px; line-height:1.6; max-width:46rem; }

  /* scoring card */
  .mth-score{ background:var(--ag-surface); border:1px solid rgba(16,41,44,.08); border-radius:22px; padding:clamp(1.6rem,3vw,2rem); }
  .mth-score__head{ display:flex; align-items:center; justify-content:space-between; gap:1rem; margin-bottom:1.3rem; }
  .mth-score__head h3{ margin:0; font-family:var(--ag-font-display); font-weight:700; font-size:1.25rem; }
  .mth-score__max{ font:700 14px/1 var(--ag-font-mono); color:var(--ag-green); }
  .mth-bar{ margin-bottom:1.3rem; }
  .mth-bar:last-child{ margin-bottom:0; }
  .mth-bar__top{ display:flex; align-items:center; justify-content:space-between; margin-bottom:8px; }
  .mth-bar__name{ display:flex; align-items:center; gap:11px; font-weight:600; font-size:15.5px; }
  .mth-bar__ico{ width:34px; height:34px; border-radius:10px; display:flex; align-items:center; justify-content:center; flex:none; }
  .mth-bar__pct{ font:700 14px/1 var(--ag-font-mono); color:var(--ag-ink); }
  .mth-bar__track{ height:9px; border-radius:5px; background:#eef2ee; overflow:hidden; margin-bottom:7px; }
  .mth-bar__fill{ display:block; height:100%; border-radius:5px; background:linear-gradient(90deg,var(--ag-green),var(--ag-green-light)); }
  .mth-bar__desc{ margin:0; font-size:13.5px; line-height:1.55; color:#626a6e; }
  .mth-eq{ text-align:center; margin:1.4rem 0 0; font:700 .95rem/1 var(--ag-font-mono); color:var(--ag-ink); }
  .mth-why{ margin-top:1.1rem; background:#fff8e8; border:1px solid rgba(201,162,75,.3); border-radius:14px; padding:1rem 1.2rem; font-size:14px; line-height:1.6; color:#5b4a1f; }
  .mth-why strong{ color:#3a2f12; }

  /* grids */
  .mth-grid{ display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-top:1.2rem; }
  .mth-cell{ background:var(--ag-surface); border:1px solid rgba(16,41,44,.08); border-radius:16px; padding:20px; }
  .mth-cell__top{ display:flex; align-items:center; justify-content:space-between; gap:.5rem; margin-bottom:.5rem; }
  .mth-cell h3{ margin:0; font-weight:600; font-size:15.5px; color:var(--ag-ink); }
  .mth-cell__pct{ font:700 12px/1 var(--ag-font-mono); color:var(--ag-green); background:var(--ag-green-wash); padding:5px 9px; border-radius:999px; }
  .mth-cell p{ margin:0; font-size:13.5px; line-height:1.6; color:#626a6e; }
  .mth-cell__ico{ width:40px; height:40px; border-radius:11px; background:#effaf0; display:flex; align-items:center; justify-content:center; margin-bottom:12px; }

  /* timeline (dark) */
  .mth-time{ position:relative; overflow:hidden; background:var(--ag-ink); border-radius:22px; padding:clamp(1.6rem,3vw,2.1rem); margin-top:1.2rem; }
  .mth-time__orb{ position:absolute; right:-50px; top:-50px; width:200px; height:200px; border-radius:50%; background:radial-gradient(circle,rgba(127,200,124,.18),transparent 68%); }
  .mth-time h3{ position:relative; margin:0 0 1.3rem; font-family:var(--ag-font-display); font-weight:700; font-size:1.25rem; color:#fff; }
  .mth-time__row{ position:relative; display:grid; grid-template-columns:repeat(6,1fr); gap:0; }
  .mth-step__head{ display:flex; align-items:center; }
  .mth-step__n{ width:30px; height:30px; flex:none; border-radius:50%; background:var(--ag-green-light); color:var(--ag-ink); display:flex; align-items:center; justify-content:center; font:700 13px/1 var(--ag-font-mono); }
  .mth-step__line{ flex:1; height:2px; background:rgba(127,200,124,.35); }
  .mth-step:last-child .mth-step__line{ background:transparent; }
  .mth-step__t{ font-weight:600; font-size:13px; color:#fff; margin-top:12px; padding-right:12px; }
  .mth-step__d{ font-size:11.5px; line-height:1.5; color:rgba(255,255,255,.6); margin-top:4px; padding-right:12px; }

  /* prose */
  .mth-prose h3{ margin:1.5rem 0 .35rem; font-family:var(--ag-font-display); font-weight:700; font-size:1.15rem; color:var(--ag-ink); }
  .mth-prose p{ margin:0; font-size:14.5px; line-height:1.7; color:#3a4448; }
  .mth-prose a{ color:var(--ag-green); }
  .mth-prose ol{ margin:.6rem 0 0; padding-left:1.3rem; display:flex; flex-direction:column; gap:.4rem; font-size:14px; line-height:1.6; color:#3a4448; }

  .mth-cta{ text-align:center; margin-top:clamp(2.4rem,5vw,3.2rem); }
  .mth-cta p{ margin:0 0 1rem; color:#52605c; }
  .mth-btn{ display:inline-flex; align-items:center; gap:.5rem; background:var(--ag-green); color:#fff; text-decoration:none; font-weight:600; font-size:15px; padding:14px 28px; border-radius:999px; box-shadow:0 12px 24px -12px rgba(35,123,34,.6); }
  .mth-btn:hover{ background:var(--ag-green-dark); }

  @media (max-width:680px){
    .mth-grid{ grid-template-columns:1fr; }
    .mth-time__row{ grid-template-columns:1fr; gap:1rem; }
    .mth-step__line{ display:none; }
  }
  .mth-money{ display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:16px; margin:18px 0 12px }
  .mth-money__col{ border-radius:14px; padding:18px 20px; border:1px solid }
  .mth-money__col--can{ background:#f2f9f1; border-color:#bfe0bd }
  .mth-money__col--cannot{ background:#fdf6f6; border-color:#eccaca }
  .mth-money__col h3{ margin:0 0 10px; font-size:14.5px; color:#10292C }
  .mth-money__col ul{ margin:0; padding-left:18px }
  .mth-money__col li{ font-size:13.5px; line-height:1.7; color:#3f4a4c; margin-bottom:8px }
  .mth-money__note{ font-size:13.5px; line-height:1.75; color:#4a5256; max-width:74ch; margin:0 0 8px }
</style>
{% endblock %}

{% block content %}
<div class="mth">
  <header class="mth-hero">
    <p class="mth-eyebrow">Methodology · Integrity Center</p>
    <h1>How the CPI is <em>scored.</em></h1>
    <p>Transparent rules, verified identities, independent scoring. The Cultural Power Index is a defensible, audited score — this page is your reference if anything is ever disputed.</p>
    <div class="mth-chips">
      {% for label in ['OTP-verified voting','One vote per identity','Fraud-scored','Independent jury','Weighted public + judge','Full audit trail'] %}
        <span class="mth-chip">{{ label }}</span>
      {% endfor %}
    </div>
  </header>

  {# ── The score ── #}
  <h2 class="mth-h2">The score</h2>
  <p class="mth-lead">The final CPI is a weighted combination of the community’s verified votes and an independent judge panel. Neither alone decides the winner.</p>
  <div class="mth-score">
    <div class="mth-score__head">
      <h3>Two weighted inputs</h3>
      <span class="mth-score__max">= CPI score</span>
    </div>
    <div class="mth-bar">
      <div class="mth-bar__top">
        <span class="mth-bar__name"><span class="mth-bar__ico" style="background:#eef7ee;color:#1a6118"><svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg></span>Public votes</span>
        <span class="mth-bar__pct">{{ community_pct|default(45) }}%</span>
      </div>
      <span class="mth-bar__track"><span class="mth-bar__fill" style="width:{{ community_pct|default(45) }}%"></span></span>
      <p class="mth-bar__desc">Community voice — normalised within each category against the category’s highest vote count. Only organic, OTP-verified votes count toward the score; donation bonus votes never move it.</p>
    </div>
    <div class="mth-bar">
      <div class="mth-bar__top">
        <span class="mth-bar__name"><span class="mth-bar__ico" style="background:#f3eef7;color:#5b3a8a"><svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.9M16 3.1a4 4 0 0 1 0 7.8"/></svg></span>Judge panel</span>
        <span class="mth-bar__pct">{{ judge_pct|default(55) }}%</span>
      </div>
      <span class="mth-bar__track"><span class="mth-bar__fill" style="width:{{ judge_pct|default(55) }}%"></span></span>
      <p class="mth-bar__desc">An independent panel scores each shortlisted nominee on four equally-weighted criteria. Only complete scorecards count, and a nominee needs at least {{ min_judges|default(2) }} of them to be winner-eligible.</p>
    </div>
    <p class="mth-eq">{{ community_pct|default(45) }}% public&nbsp;+&nbsp;{{ judge_pct|default(55) }}% judges&nbsp;=&nbsp;CPI</p>
    <div class="mth-why"><strong>Why {{ community_pct|default(45) }}/{{ judge_pct|default(55) }}?</strong> Popularity alone shouldn’t decide a winner — a well-funded campaign can generate disproportionate vote volume. The slight tilt to the judge panel keeps merit, not marketing, in charge of the decision.</div>
  </div>

  {# ── What money can and cannot do ──────────────────────────────────────────
     Published because the separation was real in the engine and invisible on the
     site. The platform keeps organic votes and purchased ones in different columns
     and normalises the community share over the organic one only — a genuine
     commitment, enforced in code, that a visitor had no way of knowing about. A
     promise nobody can see is not a promise anybody can hold us to.

     Every number here comes from RuleEngine via the route, so this section cannot
     go on claiming a rule the platform has stopped following. #}
  <h2 class="mth-h2" id="money">What a contribution can — and cannot — do</h2>
  <p class="mth-lead">
    Supporters can contribute to the programme in a nominee’s name, and each contribution adds to
    that nominee’s public tally. The money keeps the awards running — the judging panel, the
    verification work, the platform itself. It is fair to ask what it actually buys, and the honest
    answer is: visibility, never rank.
  </p>

  <div class="mth-money">
    <div class="mth-money__col mth-money__col--can">
      <h3>What a contribution does</h3>
      <ul>
        <li>Adds to the nominee’s <strong>public tally</strong> — the number shown on their page and on the leaderboard.</li>
        <li>Puts the buyer’s name on the nominee’s supporters list, if they chose to be named.</li>
        <li>Funds the judging panel, the verification work and running the programme.</li>
      </ul>
    </div>
    <div class="mth-money__col mth-money__col--cannot">
      <h3>What it does not do</h3>
      <ul>
        <li>It <strong>does not move the Cultural Power Index</strong>. The {{ community_pct|default(45) }}% community
            share is normalised over organic, OTP-verified votes only. Purchased votes are held in a
            separate column the scorer never reads.</li>
        <li>It <strong>does not break a tie</strong>. When two nominees finish level, the tiebreak is organic
            votes — one verified supporter outranks any number of purchased ones.</li>
        <li>It is <strong>capped</strong>: purchased votes on any nominee cannot exceed
            {{ paid_cap_pct|default(50) }}% of the organic support they have earned, so money can amplify a
            real following and cannot manufacture one.</li>
      </ul>
    </div>
  </div>
  <p class="mth-money__note">
    Put plainly: money can make a nominee <em>look</em> more popular. It cannot make them win.
    If that ever stops being true, this page is wrong and we want to hear about it —
    the numbers above are read from the live scoring configuration, not typed in by hand.
  </p>

  {# ── When we take money and something goes wrong ──────────────────────────── #}
  <h2 class="mth-h2">If you paid and your votes did not appear</h2>
  <p class="mth-lead">
    Payments pass through a bank and a payment gateway before they reach us, and any of those
    steps can fail after your card has been charged. We would rather say so than pretend it
    never happens.
  </p>
  <div class="mth-grid">
    <div class="mth-card">
      <h3>Your votes are still owed to you</h3>
      <p>If the ballot was open when you paid, the votes are yours even if the confirmation
         reached us late. We check the time you started the payment, not the moment our
         system happened to notice it.</p>
    </div>
    <div class="mth-card">
      <h3>If they cannot be delivered, the money goes back</h3>
      <p>Where votes genuinely cannot be counted — the nominee left the ballot, or the payment
         confirmed long after voting closed — the order is refunded rather than kept. We do not
         keep money for votes we did not deliver.</p>
    </div>
    <div class="mth-card">
      <h3>Tell us, with your reference</h3>
      <p>Every order has a reference beginning <code>AFG-</code>. Send it to us through
         <a href="/support">support</a> and we can trace the payment all the way to the gateway
         and tell you exactly what happened to it.</p>
    </div>
  </div>

  {# ── Judge criteria ── #}
  <h2 class="mth-h2">The four judging criteria</h2>
  <p class="mth-lead">Every judge scores each nominee 0–10 on four dimensions. The equally-weighted average becomes that judge’s score.</p>
  <div class="mth-grid">
    {% set crit = {
      'Impact':'Measurable difference made for the community, industry, or continent.',
      'Originality':'Inventiveness and novelty — has this person introduced something genuinely new?',
      'Reach':'Breadth of influence: local, regional, continental, or global.',
      'Integrity':'Consistency of values, ethics, and accountability under pressure.'
    } %}
    {% for title, desc in crit %}
      <div class="mth-cell">
        <div class="mth-cell__top"><h3>{{ title }}</h3><span class="mth-cell__pct">25%</span></div>
        <p>{{ desc }}</p>
      </div>
    {% endfor %}
  </div>

  {# ── Principles ── #}
  <h2 class="mth-h2">Principles we hold</h2>
  <div class="mth-grid">
    {% set princ = [
      ['One person, one vote','Email is hashed (SHA-256) and checked for uniqueness per category. Plain addresses are never stored.'],
      ['No pay-to-win','Donations and ticket sales never affect a score. Funding and ranking are fully separated.'],
      ['Open audit trail','Every recomputation is logged. An independent reviewer can replay the math from source.'],
      ['Panel verification','A profile must clear human review before any votes or impact points are counted.']
    ] %}
    {% for p in princ %}
      <div class="mth-cell">
        <div class="mth-cell__ico"><svg aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1a6118" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></div>
        <h3>{{ p[0] }}</h3>
        <p style="margin-top:6px">{{ p[1] }}</p>
      </div>
    {% endfor %}
  </div>

  {# ── Lifecycle timeline ── #}
  <h2 class="mth-h2">From nomination to result</h2>
  <div class="mth-time">
    <div class="mth-time__orb" aria-hidden="true"></div>
    <h3>Every programme runs six enforced stages</h3>
    <div class="mth-time__row">
      {% set steps = [
        ['1','Nominated','Anyone can nominate; entries are queued for moderation.'],
        ['2','Verified','The team reviews eligibility, accuracy and completeness.'],
        ['3','Shortlisted','Approved nominees go public; the list is then frozen.'],
        ['4','Voted','OTP-verified, fraud-scored community votes are collected.'],
        ['5','Judged','The independent panel scores each nominee.'],
        ['6','Sealed','A signed snapshot is taken; results are computed and archived.']
      ] %}
      {% for s in steps %}
        <div class="mth-step">
          <div class="mth-step__head"><span class="mth-step__n">{{ s[0] }}</span><span class="mth-step__line"></span></div>
          <div class="mth-step__t">{{ s[1] }}</div>
          <div class="mth-step__d">{{ s[2] }}</div>
        </div>
      {% endfor %}
    </div>
  </div>

  {# ── Detailed rules (prose) ── #}
  <div class="mth-prose">
    <h2 class="mth-h2">Voting rules in detail</h2>
    <h3>OTP verification required</h3>
    <p>Every vote requires a one-time 6-digit code delivered to the voter’s email. The code expires in {{ otp_expiry_minutes }} minutes, can only be used once, and is cryptographically bound to the specific nominee it was requested for — it cannot be reused for a different nominee.</p>
    <h3>Fraud scoring on every vote</h3>
    <p>Each vote attempt gets a risk score (0–100) from device fingerprint, IP vote density, OTP request patterns, and behavioural signals. Below 30 auto-approves; 60–79 is flagged for manual review; 80+ is blocked before the vote is recorded.</p>
    <h3>Disposable email addresses blocked</h3>
    <p>Known temporary email domains (Mailinator, Guerrilla Mail, 10-minute mail, and 30+ others) are rejected at code-request time — before any database write occurs.</p>
    <h3>Donation votes</h3>
    <p>Supporters who donate earn bonus votes (currently {{ donation_votes_per_1000 }} per ₦1,000 donated, admin-configurable). Bonus votes face the same OTP verification and fraud scoring as standard votes, and — importantly — they are excluded from the CPI calculation. They show support; they do not move the score.</p>

    <h2 class="mth-h2">Nomination eligibility</h2>
    <h3>Who can nominate</h3>
    <p>Any person with a valid, non-disposable email address. There is no fee. Nominators provide their full name, phone number, and location for accountability.</p>
    <h3>Who can be nominated</h3>
    <p>Any African individual, school, choir, or business that meets the criteria for the specific award programme. Self-nominations are accepted.</p>
    <h3>Grounds for rejection</h3>
    <p>A nomination is rejected if the nominee doesn’t meet the criteria, the reason given is demonstrably false, it duplicates an existing approved entry, or it violates our community standards.</p>

    <h2 class="mth-h2">Disputes &amp; your data</h2>
    <p>If you believe a result was manipulated or a fraud pattern was missed, email <a href="mailto:integrity@afrovanguard.org.ng">integrity@afrovanguard.org.ng</a> or open an appeal via <a href="/support">Support &amp; Appeals</a>. We will:</p>
    <ol>
      <li>Acknowledge the complaint within {{ review_sla_hours }} hours.</li>
      <li>Export the relevant vote audit trail (timestamps, hashed identities, risk scores).</li>
      <li>Engage an independent reviewer if the complaint is substantiated.</li>
      <li>Publish a summary of findings if the dispute affected a final result.</li>
    </ol>
    <h3>What we store</h3>
    <p>A SHA-256 hash of your email and IP, a device fingerprint, and the nominee ID and timestamp of your vote. We never store your plain-text email, name, or personal identifier against a vote, and we never sell or monetise voter data. Full details: <a href="/privacy">Privacy Policy</a> · <a href="/terms">Terms</a>.</p>
  </div>

  <div class="mth-cta">
    <p>Questions not answered here?</p>
    <a class="mth-btn" href="mailto:integrity@afrovanguard.org.ng">Contact the Integrity Team
      <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M7.5 4.5 13 10 7.5 15.5" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
  </div>
</div>
{% endblock %}
