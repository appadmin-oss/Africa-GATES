    {p: '<strong>' ~ ('Why %c%/%j%?'|trans({'%c%': c, '%j%': j})|e) ~ '</strong> ' ~ ('Popularity alone shouldn’t decide a winner. A well-funded campaign can buy a lot of votes, and being popular online isn’t the same as making a difference. Giving the judges the larger share keeps merit, not marketing, in charge.'|trans|e)},
    {refs: [{href: '/help/how-cpi-works', label: 'How the CPI is calculated'|trans},
            {href: '/help/why-a-small-category-is-not-a-disadvantage', label: 'How a small category is scored'|trans}]}
  ]},
  {id: 'eligible', blocks: [
