  {% endfor %}
  {% set _ret_editions = [
    {p: 'Some editions use a different rule. It is chosen before the edition opens and does not change once anything is earned under it. Two-stage: a smaller share from the start, locked until the edition’s contributions reach a published target and a person confirms it; then the full share. Flat: one share on every contribution. Tiered: the share rises as more is raised. A refunded or fraudulent contribution earns nothing.'|trans|e},
    {table: {caption: 'Editions with their own return rule'|trans, head: ['Edition'|trans, 'Rule'|trans, 'When it is released'|trans], rows: _rows}}
  ] %}
{% endif %}
{% set _t = return_terms|default(null) %}
{% set _ret_terms = [] %}
{% if _t and _t.published %}
  {% set _ret_terms = [
    {table: {caption: 'Asking for the money'|trans, head: ['Term'|trans, 'Setting'|trans, 'What it means'|trans],
      rows: [
        ['Smallest withdrawal'|trans, '₦' ~ (_t.min_kobo / 100)|number_format, 'Below this, the balance waits until there is more.'|trans|e],
        ['Service fee'|trans, _t.fee_text|e, 'Taken from each withdrawal and shown before you confirm. It covers the bank transfer and keeps the platform and the project running. It is a fee, not a donation.'|trans|e],
        ['Paid within'|trans, '%n% working days'|trans({'%n%': _t.payout_days}), _t.automatic
            ? 'At the latest. Most requests are sent within minutes. One that needs a closer look waits for a person.'|trans|e
            : 'After a person has reviewed the request.'|trans|e],
        ['Appeals'|trans, '%n% days'|trans({'%n%': _t.appeal_days}), 'To appeal a refusal or a hold, reply to the email that told you.'|trans|e],
        ['Unclaimed balances'|trans, '%n% days'|trans({'%n%': _t.unclaimed_days}), 'Claim your money within this time. Nothing is taken away automatically: a person decides, and it is recorded.'|trans|e],
        ['Tax'|trans, '—', _t.tax_note|e]
      ]}},
    {p: _t.automatic
      ? 'Money goes by bank transfer to an account in the nominee’s own name. Before it is sent we check that the money is released, the person asking owns the page, the bank confirms the name on the account, and every naira came from a real contribution. If all of that passes, it is sent automatically. Anything unusual — a recent password or bank change, a shared account, a large amount — is checked by a person first.'|trans|e
      : 'Money goes by bank transfer to an account in the nominee’s own name, after a person has checked that the money is released, the person asking owns the page, the account is theirs, and every naira came from a real contribution.'|trans|e}
  ] %}
{% else %}
  {% set _ret_terms = [{p: 'Withdrawals open once their terms are published here: the smallest amount, the fee, how long it takes, appeals, unclaimed money and tax.'|trans|e}] %}
{% endif %}

