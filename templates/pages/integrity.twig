<link rel="stylesheet" href="{{ asset('/assets/css/components/doc.css') }}">
{{ art.cite_meta({title: doc_title, author: doc_author, publisher: doc_publisher, published: doc_published, updated: doc_updated, url: doc_url}) }}
{{ art.article_ld({title: doc_title, subtitle: doc_subtitle, description: meta_description, author: doc_author, publisher: doc_publisher,
                   published: doc_published, updated: doc_updated, version: doc_version, url: doc_url}, csp_nonce) }}
{# A FAQPage built only from questions this page VISIBLY answers, from the same figures. #}
<script nonce="{{ csp_nonce }}" type="application/ld+json">
{% set _faq = [
  {q: 'How is the Cultural Power Index calculated?', a: 'The CPI is ' ~ c ~ '% verified community votes and ' ~ j ~ '% independent judge panel. ' ~ _score_rule ~ ' The judging half is the panel average out of ten on four equally weighted criteria.'},
  {q: 'Can you buy votes to win an Africa GATES award?', a: 'Buying votes helps a nominee in the community half, and every result publishes how much of a tally was bought. Money cannot multiply one supporter, and it cannot reach the judging half (' ~ j ~ '%): judges never see a vote count.'},
  {q: 'Why might the nominee with the most votes not win?', a: 'Winning also requires at least ' ~ q ~ ' complete judge scorecards. A partial scorecard counts as nothing, judges recuse themselves from nominees they are connected to, and if nobody in a category reaches the quorum the award is not given.'},
  {q: 'How do you know the results were not edited afterwards?', a: 'Every computed standing is sealed with a fingerprint of itself and of the record before it, so editing an old result breaks every record after it. The chain is re-verified automatically every day.'}
] %}
{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{% for f in _faq %}{"@type":"Question","name":{{ f.q|json_encode|raw }},"acceptedAnswer":{"@type":"Answer","text":{{ f.a|json_encode|raw }}}}{% if not loop.last %},{% endif %}{% endfor %}]}
</script>
