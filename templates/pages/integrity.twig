{# ── Every section, as DocPage blocks. Built at template scope so `content` reads it. ── #}
{% set _score_rule = rule_is_default|default(true)
  ? 'Every vote counts, free or bought, measured against the edition’s strongest support. %pp%% of this half counts separate verified people; the rest counts total votes.'|trans({'%pp%': pp})
  : 'Measured on an earlier basis kept so an announced standing stays reproducible. The help article below states the arithmetic in force.'|trans %}

{% set _sections = [
  {id: 'why', blocks: doc_summary|merge([
    {next: {href: '/philosophy', kicker: 'The argument in full'|trans,
            title: 'The philosophy behind Africa GATES community voting'|trans,
            blurb: 'What a vote means here, what we mean by a community, and what this model can’t do. Available to download and cite.'|trans}}
  ])},
  {id: 'score', blocks: [
    {p: 'The Cultural Power Index is a weighted combination of verified community votes and an independent judge panel. Neither alone decides a winner, and that is the point of having both.'|trans},
    {table: {caption: 'Composition of the Cultural Power Index'|trans, head: ['Input'|trans, 'Share'|trans, 'What it measures'|trans],
      rows: [
        ['Community votes'|trans, c ~ '%', _score_rule],
        ['Judge panel'|trans, j ~ '%', 'The panel average out of ten on four equal criteria. Only complete scorecards count, and judges never see the tally.'|trans]
      ],
      foot: '%c%% community + %j%% judges = CPI. The split is set per edition, and this page always shows the one in force.'|trans({'%c%': c, '%j%': j})}},
    {p: '<strong>' ~ ('Why %c%/%j%?'|trans({'%c%': c, '%j%': j})|e) ~ '</strong> ' ~ ('Popularity alone shouldn’t decide a winner. A well-funded campaign can generate disproportionate vote volume, and reach on the internet isn’t the same as impact on the continent. The tilt to the panel keeps merit, not marketing, in charge.'|trans|e)},
    {refs: [{href: '/help/how-cpi-works', label: 'How the CPI is calculated'|trans},
            {href: '/help/why-a-small-category-is-not-a-disadvantage', label: 'How a small category is scored'|trans}]}
  ]},
  {id: 'eligible', blocks: [
    {p: 'Leading the public vote makes a nominee the front-runner. It doesn’t, by itself, make them eligible to win.'|trans|e},
    {p: '<strong>' ~ ('Complete judge scorecards, minimum %n%.'|trans({'%n%': q})|e) ~ '</strong> ' ~ ('A nominee needs at least %n% judges to have scored them on every criterion. A half-finished card counts as nothing, not as a zero. If nobody in a category reaches the quorum, the award isn’t given.'|trans({'%n%': q})|e)},
    {h3: 'Three exclusions that apply before anything is counted'|trans|e},
    {list: [
      '<strong>' ~ ('Judges recuse themselves.'|trans|e) ~ '</strong> ' ~ ('A judge with any connection to a nominee steps out of scoring them, and a judge’s own votes in a category they judge are left out of the community count.'|trans|e),
      '<strong>' ~ ('The shortlist is frozen.'|trans|e) ~ '</strong> ' ~ ('Once a category opens for voting, nobody can be added to it.'|trans|e),
      '<strong>' ~ ('Unverified profiles score nothing.'|trans|e) ~ '</strong> ' ~ ('A profile must clear human review before any votes attach to it.'|trans|e)
    ]},
    {refs: [{href: '/help/why-the-leader-may-not-be-eligible-to-win', label: 'Why the vote leader may not be eligible'|trans},
            {href: '/help/what-happens-if-two-nominees-tie', label: 'What happens if two nominees tie'|trans}]}
  ]},
  {id: 'criteria', blocks: [
    {p: 'Every judge scores each nominee from 0 to 10 on four dimensions of equal weight. There is no hidden multiplier.'|trans|e},
    {table: {caption: 'The judging rubric'|trans, head: ['Criterion'|trans, 'Weight'|trans, 'What it asks'|trans],
      rows: [
        ['Impact'|trans, '25%', 'What is different because this person did the work?'|trans|e],
        ['Originality'|trans, '25%', 'Has something genuinely new been introduced?'|trans|e],
        ['Reach'|trans, '25%', 'Local, regional, continental, global. Reach isn’t follower count.'|trans|e],
        ['Integrity'|trans, '25%', 'Consistency of values and accountability, including when it costs them something.'|trans|e]
      ]}},
    {note: {title: '', body: ['Judges see a nominee’s dossier, not their vote count. The tally is kept off the scoring screen so it can’t anchor a score.'|trans|e]}},
    {refs: [{href: '/help/what-the-judges-actually-score', label: 'What the judges actually score you on'|trans}]}
  ]},
  {id: 'money', blocks: [
    {p: ('Supporters can contribute in a nominee’s name, and each contribution adds votes to their tally. It buys community support, and community support is %c%% of the index. It buys nothing on the other %j%%, and it buys no privacy: every purchased vote is published as one.'|trans({'%c%': c, '%j%': j})|e)},
    {cols: [
      {mark: 'yes', h: 'What a contribution does'|trans|e, items: [
        'Adds to the nominee’s tally and the community half of their index.'|trans|e,
        (paid_sentence|default('') ? paid_sentence|e : 'Adds to the tally at full weight.'|trans|e),
        'Has no ceiling on vote packs bought on the ballot.'|trans|e,
        'Names the supporter, if they chose to be named.'|trans|e,
        'Sets aside a share for the nominee once they qualify.'|trans|e
      ]},
      {mark: 'no', h: 'What it can’t reach'|trans|e, items: [
        'None of the judging half: judges can’t see votes or money.'|trans|e,
        'It isn’t hidden: every result shows how much of a tally was bought.'|trans|e,
        ('A contribution mints bonus votes only up to %p%% of the organic support a nominee has earned. Vote packs on the ballot have no such limit.'|trans({'%p%': paid_cap_pct|default(50)})|e),
        'It doesn’t survive a refund: reversed votes leave the tally.'|trans|e
      ]}
    ]},
    {p: rule_is_default|default(true)
      ? '<strong>' ~ ('Put plainly:'|trans|e) ~ '</strong> ' ~ ('buying votes does help a nominee, and there is a rate. Both counts in the community half are measured against the edition’s largest total, so in that half one verified supporter is worth about %r% votes, in every edition. What money can’t do is multiply a supporter — one person is one person however many orders they place — reach the judging half, or hide.'|trans({'%r%': supporter_votes|default('2.33')})|e)
      : '<strong>' ~ ('Put plainly:'|trans|e) ~ '</strong> ' ~ ('buying votes does help a nominee. What money can’t do is multiply a supporter, reach the judging half, or hide.'|trans|e)},
    {refs: [{href: '/help/what-paid-votes-do', label: 'What paid votes actually do'|trans},
            {href: '/help/how-free-voting-works', label: 'How free voting works'|trans}]}
  ]},
  {id: 'return', blocks: (return_off_reason|default('') == 'no_paid_voting'
      ? [{note: {title: 'Not running on this site'|trans|e, body: ['The return is a share of what supporters contribute, and this site doesn’t sell votes — voting here is free, and nothing is being raised in anybody’s name. So nothing accrues. The rules below are the ones that would apply if contributions were opened.'|trans|e]}}]
      : (return_off_reason|default('') == 'rate_zero'
        ? [{note: {title: 'Currently set to nothing'|trans|e, body: ['The share is set to 0%, so no new contribution accrues anything for a nominee. Shares already recorded are unaffected — the ledger only ever grows.'|trans|e]}}]
        : [])
    )|merge([
    {p: 'A nominee keeps a share of what supporters contribute in their name, win or lose, because they raised it either way.'|trans|e},
    {table: {caption: 'How a nominee qualifies, and what they keep'|trans, head: ['Rule'|trans, 'Setting'|trans, 'What it means'|trans],
      rows: [
        ['Qualifying support'|trans, '%t% votes'|trans({'%t%': return_threshold|default(250)|number_format}), 'Earning starts once a nominee has %t% votes of qualifying support.'|trans({'%t%': return_threshold|default(250)|number_format})|e],
        ['No single pocket'|trans, return_cap_pct|default(10) ~ '%', 'One supporter counts for at most %v% votes toward the threshold, so it takes at least %n% different people.'|trans({'%v%': return_cap_votes|default(25)|number_format, '%n%': return_people|default(10)})|e],
        ['The share'|trans, return_pct|default('50') ~ '%', 'That share of each later contribution is set aside. Crossing the line doesn’t reach backwards.'|trans|e]
      ]}},
    {p: 'It is an append-only ledger. A refund reverses the share and the reversal stays on the record. Nothing is payable until the edition’s results are announced.'|trans|e},
    {refs: [{href: '/help/the-community-return', label: 'The community return, in full'|trans}]}
  ])},
  {id: 'honest', blocks: [
    {p: 'Every vote needs a one-time code sent to a working email address, and every attempt is scored for risk from 0 to 100 before anything is written down.'|trans|e},
    {table: {caption: 'Risk bands, and what each one does'|trans, head: ['Band'|trans, 'Score'|trans, 'What happens'|trans],
      rows: [
        ['Clear'|trans, '0–' ~ fraud_monitor|default(30), 'Approved as it is cast.'|trans],
        ['Monitored'|trans, fraud_monitor|default(30) ~ '–' ~ fraud_flag|default(60), 'Counted, and kept under observation.'|trans],
        ['Flagged'|trans, fraud_flag|default(60) ~ '–' ~ fraud_block|default(80), 'Held for a person to review.'|trans],
        ['Blocked'|trans, fraud_block|default(80) ~ '+', 'Refused before the vote exists.'|trans]
      ]}},
    {list: [
      '<strong>' ~ ('One identity, one vote,'|trans|e) ~ '</strong> ' ~ ('per category. The address is stored only as a hash.'|trans|e),
      '<strong>' ~ ('Disposable mail is refused'|trans|e) ~ '</strong> ' ~ ('when a code is requested.'|trans|e),
      '<strong>' ~ ('A total can go down.'|trans|e) ~ '</strong> ' ~ ('Fraudulent votes are removed and refunds take their votes with them.'|trans|e)
    ]},
    {note: {title: '', body: ['Being flagged isn’t an accusation. A campus network produces the same pattern a vote farm does, which is why a flag sends a vote to a person, not the bin.'|trans|e]}},
    {refs: [{href: '/help/how-we-spot-a-vote-that-is-not-real', label: 'How we decide a vote is not real'|trans},
            {href: '/help/already-voted', label: 'It says I already voted'|trans}]}
  ]},
  {id: 'failures', blocks: [
    {list: [
      '<strong>' ~ ('The votes are still owed to you.'|trans|e) ~ '</strong> ' ~ ('If the ballot was open when you started paying, the votes are yours even if confirmation arrived late.'|trans|e),
      '<strong>' ~ ('If they can’t be delivered, the money goes back.'|trans|e) ~ '</strong> ' ~ ('We don’t keep money for votes we didn’t deliver.'|trans|e),
      '<strong>' ~ ('Tell Gee your reference.'|trans|e) ~ '</strong> ' ~ ('Every order has a reference starting AFG-. Gee re-checks it with the bank and adds the votes if the money arrived.'|trans|e)
    ]},
    {note: {title: '', body: ['The same honesty applies to our own failures. When our records show a voting code never left the building, that vote can be restored after voting closes — proposed by one person, approved by a different one, capped in size, and disclosed on the nominee’s page.'|trans|e]}},
    {refs: [{href: '/help/paid-but-no-votes', label: 'I paid but my votes haven’t appeared'|trans},
            {href: '/help/refund-when-votes-cannot-count', label: 'When do you refund?'|trans},
            {href: '/help/votes-we-could-not-deliver', label: 'Votes that never reached you'|trans}]}
  ]},
  {id: 'sealed', blocks: [
    {p: 'Every time standings are computed they are sealed: each record carries a fingerprint of itself and of the record before it. Editing an old standing breaks every record after it.'|trans|e},
    {steps: [
      'The chain is re-verified automatically every day.'|trans|e,
      'A break is raised to people, with the position of the broken link.'|trans|e,
      'The database refuses two standings claiming the same predecessor.'|trans|e,
      'An independent reviewer can replay the arithmetic from source.'|trans|e
    ]},
    {p: 'A published result is the one that was announced: the standing is sealed at release, and a later change to the rules does not rewrite it.'|trans|e},
    {refs: [{href: '/help/how-results-are-sealed', label: 'How you can tell a result was not edited'|trans},
            {href: '/help/dispute-a-result', label: 'I think a count or a ranking is wrong'|trans}]}
  ]},
  {id: 'cycle', blocks: [
    {p: 'An edition moves through six stages in one direction. Each transition closes something permanently.'|trans|e},
    {steps: [
      '<strong>' ~ ('Nominated.'|trans|e) ~ '</strong> ' ~ ('Anyone can enter someone; entries queue for review.'|trans|e),
      '<strong>' ~ ('Verified.'|trans|e) ~ '</strong> ' ~ ('Eligibility, accuracy and completeness are checked.'|trans|e),
      '<strong>' ~ ('Shortlisted.'|trans|e) ~ '</strong> ' ~ ('Approved nominees go public, and the list is frozen.'|trans|e),
      '<strong>' ~ ('Voted.'|trans|e) ~ '</strong> ' ~ ('Code-verified, risk-scored votes are collected.'|trans|e),
      '<strong>' ~ ('Judged.'|trans|e) ~ '</strong> ' ~ ('After voting closes, the panel scores the shortlist without seeing tallies.'|trans|e),
      '<strong>' ~ ('Sealed.'|trans|e) ~ '</strong> ' ~ ('A signed snapshot is taken; results are published and archived.'|trans|e)
    ]},
    {note: {title: '', body: ['Card contribution closes a little earlier than free voting, so payments already in flight have time to land before the ballot shuts. Free voting runs to the bell.'|trans|e]}},
    {refs: [{href: '/help/the-stages-of-an-award-cycle', label: 'The stages, and what freezes at each'|trans},
            {href: '/help/when-does-voting-close', label: 'When does voting close?'|trans}]}
  ]},
  {id: 'disputes', blocks: [
    {p: 'If you believe a result was manipulated, say so. Every recomputation is logged, so a count can be replayed and the working shown to you. Appeals go to somebody independent of the original decision.'|trans|e},
    {p: ('Raise it at %m% or through %s%. We will:'|trans|e)|replace({'%m%': '<a href="mailto:integrity@afrovanguard.org.ng">integrity@afrovanguard.org.ng</a>', '%s%': '<a href="/support">' ~ ('Support and appeals'|trans|e) ~ '</a>'})},
    {steps: [
      'We acknowledge within %h% hours.'|trans({'%h%': review_sla_hours})|e,
      'We export the relevant audit trail.'|trans|e,
      'An independent reviewer is engaged if the complaint is substantiated.'|trans|e,
      'A summary is published if the dispute affected a final result.'|trans|e
    ]},
    {h3: 'What we store when you vote'|trans|e},
    {p: ('A hash of your email and IP, a device fingerprint, and the nominee and time of your vote. Never your plain-text email against a vote, and we never sell voter data. Full details: %p% · %t%.'|trans|e)|replace({'%p%': '<a href="/privacy">' ~ ('Privacy policy'|trans|e) ~ '</a>', '%t%': '<a href="/terms">' ~ ('Terms'|trans|e) ~ '</a>'})},
    {refs: [{href: '/help/dispute-a-result', label: 'I think a count or a ranking is wrong'|trans},
            {href: '/help/report-a-profile', label: 'How do I report a nominee or profile?'|trans},
            {href: '/help/what-data-do-you-keep', label: 'What data do you keep about me?'|trans}]},
    {next: {href: '/philosophy', kicker: 'The argument behind the method'|trans,
            title: 'The philosophy behind Africa GATES community voting'|trans,
            blurb: 'Why the public vote carries a token contribution, what we mean by a community, and what this model can’t do.'|trans}}
  ]}
] %}

