{% extends "layout/gates.twig" %}

{#
  ── DONATIONS ────────────────────────────────────────────────────────────────

  One template, three recipients: the Africa GATES fund, a partner organisation's own
  page, and a specific appeal inside one. Which of the three it is decides the heading,
  the disclosure and whether the "raise donations yourself" block appears at all.

  ── WHAT THE REBUILD CHANGED, AND WHY ───────────────────────────────────────

  THE POSITIONING. The form used to live inside a dark full-width band beside the ask,
  which put the two loudest things on the page in competition and left the case for
  giving squeezed into a 33rem column beside a card three times its height. Now:

    · The masthead is an editorial masthead — kicker, headline, deck, hairline, and the
      real figures set as a ledger row. It runs the full measure of the text column,
      because a paragraph making a case wants a line length that can be read.
    · The donation form is a STICKY RAIL. It is beside the reader at the top of the page
      and it is still beside them at the bottom, so the decision to give does not depend
      on remembering to scroll back. On a phone the grid collapses and the rail is the
      SECOND block, immediately under the masthead, so the primary action is never below
      a screenful of case-making.
    · Everything below is one column of prose-width content — the allocation, the
      mission, the ledger of recent donations — instead of three-across cards.

  THE LOOK. Two dark radial-gradient bands with glowing orbs became flat panels and
  hairline rules; the figures became mono, because they are money; the allocation became
  a ruled list rather than three shadowed boxes. It is the same visual language as the
  event ticket — Playfair display, mono micro-labels, cream and kale, one gold accent —
  so the platform reads as one system rather than as a set of separately-styled pages.

  THE WORD. "Donations" is the noun on this page. The prose still says gift and give
  where that is the natural verb, but the thing itself is a donation, the section is
  Donations, and that is what the nav, the footer and the page title all say.

  ── WHAT DID NOT CHANGE, BECAUSE IT MUST NOT ────────────────────────────────

    · EVERY FIGURE IS SUMMED FROM CONFIRMED ROWS. A fundraising number that drifts from
      the rows underneath it is the one number nobody forgives.
    · THE PLATFORM'S CUT IS STATED IN NAIRA, beside the amount, before paying — not in a
      footnote and never discovered afterwards.
    · WHAT HAPPENS IF A TARGET IS MISSED is stated BEFORE anybody gives.
    · THE REFUSAL MESSAGE IS OUTSIDE THE FORM BRANCH. A closed appeal renders with no
      payment providers, so a message that lives inside `{% if providers %}` is a message
      that never prints on the one page that most needs to explain itself.
#}

{% block head_styles %}
<style nonce="{{ csp_nonce }}">
  /* ══════════════════════════════════════════════════════════════════════════
     TOKENS — see the direction note in the commit. Every value below resolves to
     one of these; nothing further down hard-codes a hex, so the page cannot drift
     apart from itself.
     ══════════════════════════════════════════════════════════════════════════ */
  body[data-page="donate"]{
    --dn-paper:#f0f2f2;                   /* the page ground, as on the ticket */
    --dn-card:#ffffff;
    --dn-cream:#f6f2e6;                   /* accent panels */
    --dn-ink:#10292C;
    --dn-ink-2:#4a5256;                   /* 6.6:1 on paper */
    --dn-mute:#626a6e;                    /* 4.7:1 on paper — the floor, never lighter */
    --dn-line:rgba(16,41,44,.12);
    --dn-line-2:rgba(16,41,44,.22);
    --dn-gold:#f3b416;
    --dn-gold-ink:#745001;                /* gold that has to be read: 6.1:1 on paper */
    --dn-green:#237b22;
    --dn-green-dark:#1a6118;
    --dn-deep:#10292C;
    --dn-on-deep:rgba(251,246,230,.88);
    --dn-on-deep-2:rgba(251,246,230,.66); /* 6.5:1 on --dn-deep */
    --dn-rule-deep:rgba(251,246,230,.20);
    --dn-figure:#8fd58b;
    --dn-r:14px;
    --dn-r-sm:4px;
    --dn-sec:clamp(40px,6vw,72px);        /* rhythm between sections */

    background:var(--dn-paper); color:var(--dn-ink);
  }
  body[data-page="donate"] [x-cloak]{ display:none !important; }

  .dn{ max-width:1200px; margin:0 auto; padding:clamp(24px,4vw,44px) var(--ag-gutter,32px) 72px; }

  /* ── shared type ─────────────────────────────────────────────────────────
     The mono micro-label is the one motif that carries across every surface. */
  .dn-kick{ display:block; font-family:var(--ag-font-mono,monospace); font-size:10.5px;
    font-weight:700; letter-spacing:.24em; text-transform:uppercase; color:var(--dn-gold-ink); }
  .dn-kick--deep{ color:var(--dn-gold); }
  .dn-h2{ margin:10px 0 0; font-family:var(--ag-font-display,Georgia,serif); font-weight:700;
    font-size:clamp(1.45rem,2.8vw,1.95rem); line-height:1.14; letter-spacing:-.02em;
    color:var(--dn-ink); text-wrap:balance; }
  .dn-h2--deep{ color:#fff; }
  .dn-lede{ margin:12px 0 0; max-width:60ch; font-size:15px; line-height:1.7;
    color:var(--dn-ink-2); text-wrap:pretty; }

  /* ══ AN ORGANISATION'S OWN BLOCKS ═════════════════════════════════════════
     Every value resolves to a --dn-* token or to the organisation's own accent, which
     arrives as --ob-accent on the wrapper. Nothing here hard-codes a hex, so the page
     cannot drift from itself and an organisation changing their accent moves all of it.

     The accent is used for RULES and FIGURES and never for body text. It has been
     checked at 4.5:1 against white by OrgBrand::readable(), which is the floor for text
     on white — it is not a promise about the accent against the paper ground, against
     the cream panel, or as a hairline. A figure at 2rem is large text and clears 3:1
     comfortably; a paragraph in the same colour would not be covered by that check. */
  .ob-sec{ padding-top:var(--dn-sec); }
  .ob-prose p{ margin:12px 0 0; max-width:64ch; font-size:15.5px; line-height:1.75;
    color:var(--dn-ink-2); text-wrap:pretty; }

  .ob-figs{ margin:18px 0 0; display:grid; gap:1px; background:var(--dn-line);
    grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); border:1px solid var(--dn-line);
    border-radius:var(--dn-r); overflow:hidden; }
  .ob-fig{ background:var(--dn-card); padding:18px 16px; }
  .ob-fig__n{ font-family:var(--ag-font-display,Georgia,serif); font-weight:700;
    font-size:clamp(1.6rem,3.4vw,2.1rem); line-height:1; letter-spacing:-.02em;
    color:var(--ob-accent); font-variant-numeric:tabular-nums; }
  .ob-fig__l{ margin-top:7px; font-size:13px; line-height:1.45; color:var(--dn-mute); }

  .ob-asks{ margin:18px 0 0; padding:0; list-style:none; display:grid; gap:1px;
    background:var(--dn-line); border:1px solid var(--dn-line);
    border-radius:var(--dn-r); overflow:hidden; }
  .ob-asks li{ background:var(--dn-card); padding:14px 16px; display:flex; gap:14px;
    align-items:baseline; flex-wrap:wrap; }
  .ob-asks__a{ flex:0 0 auto; min-width:6.5em; font-family:var(--ag-font-mono,monospace);
    font-weight:700; font-size:14px; letter-spacing:.02em; color:var(--ob-accent);
    font-variant-numeric:tabular-nums; }
  .ob-asks__b{ flex:1 1 14ch; font-size:14.5px; line-height:1.55; color:var(--dn-ink-2); }

  /* ── the video facade ──────────────────────────────────────────────────────
     16:9 held by aspect-ratio so the swap for a real iframe does not move the page
     under a reader's thumb. A layout shift at the moment of a press is how somebody
     ends up tapping the donate button by accident. */
  .ob-vids{ margin:18px 0 0; display:grid; gap:16px;
    grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); }
  .ob-vid{ margin:0; }
  .ob-vid__play{ position:relative; display:flex; gap:13px; align-items:center;
    width:100%; aspect-ratio:16/9; padding:16px; text-align:left; cursor:pointer;
    border:1px solid var(--dn-line-2); border-radius:var(--dn-r);
    background:var(--dn-cream); color:var(--dn-ink); }
  .ob-vid__play:hover{ background:var(--ob-accent-wash); border-color:var(--ob-accent); }
  .ob-vid__icon{ flex:0 0 auto; display:grid; place-items:center; width:52px; height:52px;
    border-radius:999px; background:var(--ob-accent); color:#fff; }
  .ob-vid__meta{ display:block; }
  .ob-vid__t{ display:block; font-weight:650; font-size:15px; line-height:1.35;
    color:var(--dn-ink); }
  .ob-vid__p{ display:block; margin-top:5px; font-size:12.5px; line-height:1.45;
    color:var(--dn-mute); }
  .ob-vid iframe{ display:block; width:100%; aspect-ratio:16/9; height:auto;
    border:0; border-radius:var(--dn-r); background:var(--dn-deep); }
  .ob-vid__alt{ margin-top:8px; font-size:12.5px; }
  .ob-vid__alt a{ color:var(--dn-mute); }

  .ob-shots{ margin:18px 0 0; display:grid; gap:10px;
    grid-template-columns:repeat(auto-fit,minmax(160px,1fr)); }
  .ob-shots img{ width:100%; aspect-ratio:4/3; object-fit:cover; border-radius:var(--dn-r-sm);
    background:var(--dn-cream); }

  .ob-quotes{ margin:18px 0 0; display:grid; gap:14px;
    grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); }
  .ob-quote{ margin:0; padding:16px 18px; background:var(--dn-card);
    border:1px solid var(--dn-line); border-left:3px solid var(--ob-accent);
    border-radius:var(--dn-r-sm); }
  .ob-quote p{ margin:0; font-size:15px; line-height:1.65; color:var(--dn-ink); }
  .ob-quote cite{ display:block; margin-top:10px; font-style:normal;
    font-family:var(--ag-font-mono,monospace); font-size:11px; font-weight:700;
    letter-spacing:.14em; text-transform:uppercase; color:var(--dn-mute); }

  .ob-people, .ob-with{ margin:18px 0 0; padding:0; list-style:none; display:grid; gap:1px;
    background:var(--dn-line); border:1px solid var(--dn-line);
    border-radius:var(--dn-r); overflow:hidden; }
  .ob-people li, .ob-with li{ background:var(--dn-card); padding:13px 16px; }
  .ob-people__n, .ob-with__n{ display:block; font-weight:650; font-size:14.5px;
    color:var(--dn-ink); }
  .ob-people__r, .ob-with__d{ display:block; margin-top:3px; font-size:13px; line-height:1.5;
    color:var(--dn-mute); }

  .ob-track{ margin:18px 0 0; padding:0 0 0 18px; list-style:none;
    border-left:1px solid var(--dn-line-2); display:grid; gap:16px; }
  .ob-track li{ position:relative; }
  .ob-track li::before{ content:''; position:absolute; left:-23px; top:6px; width:9px;
    height:9px; border-radius:999px; background:var(--ob-accent);
    box-shadow:0 0 0 3px var(--dn-paper); }
  .ob-track__w{ display:block; font-family:var(--ag-font-mono,monospace); font-size:11px;
    font-weight:700; letter-spacing:.16em; text-transform:uppercase;
    color:var(--dn-gold-ink); }
  .ob-track__d{ display:block; margin-top:4px; font-size:14.5px; line-height:1.6;
    color:var(--dn-ink-2); }

  /* `<details>` rather than a scripted accordion — see the partial. The 44px floor is on
     the summary, which is the whole hit area. */
  .ob-faq{ margin:18px 0 0; border:1px solid var(--dn-line); border-radius:var(--dn-r);
    overflow:hidden; background:var(--dn-card); }
  .ob-faq__i + .ob-faq__i{ border-top:1px solid var(--dn-line); }
  .ob-faq summary{ padding:14px 16px; min-height:44px; display:flex; align-items:center;
    gap:10px; cursor:pointer; font-weight:650; font-size:14.5px; color:var(--dn-ink); }
  .ob-faq summary:hover{ background:var(--ob-accent-wash); }
  .ob-faq__a{ padding:0 16px 15px; font-size:14.5px; line-height:1.7;
    color:var(--dn-ink-2); max-width:66ch; }

  .ob-links{ margin:18px 0 0; padding:0; list-style:none; display:grid; gap:1px;
    background:var(--dn-line); border:1px solid var(--dn-line);
    border-radius:var(--dn-r); overflow:hidden; }
  .ob-links a{ display:flex; gap:12px; align-items:baseline; flex-wrap:wrap;
    padding:14px 16px; min-height:44px; background:var(--dn-card); text-decoration:none; }
  .ob-links a:hover{ background:var(--ob-accent-wash); }
  .ob-links__l{ flex:1 1 12ch; font-weight:650; font-size:14.5px; color:var(--ob-accent-dark);
    text-decoration:underline; text-underline-offset:2px; }
  .ob-links__h{ flex:0 0 auto; font-family:var(--ag-font-mono,monospace); font-size:11.5px;
    letter-spacing:.04em; color:var(--dn-mute); }
  .ob-sr{ position:absolute; width:1px; height:1px; overflow:hidden; clip-path:inset(50%);
    white-space:nowrap; }

  /* ── the platform underneath ───────────────────────────────────────────────
     Quiet on purpose. See the note in the partial: a charity's page with the platform's
     hand out beside theirs converts worse for the charity, which is the one thing this
     platform exists to be good at. */
  .ob-gates{ margin-top:var(--dn-sec); padding:20px 0 0; border-top:1px solid var(--dn-line); }
  .ob-gates__c{ margin:0; font-family:var(--ag-font-mono,monospace); font-size:10.5px;
    font-weight:700; letter-spacing:.22em; text-transform:uppercase; color:var(--dn-mute); }
  .ob-gates__b{ margin:9px 0 0; max-width:62ch; font-size:13px; line-height:1.65;
    color:var(--dn-mute); }
  .ob-gates__l{ margin:11px 0 0; display:flex; gap:10px; align-items:center;
    flex-wrap:wrap; font-size:13px; }
  .ob-gates__l a{ display:inline-flex; align-items:center; min-height:44px;
    color:var(--dn-green-dark); }

  /* ══ THE SHELL ════════════════════════════════════════════════════════════
     Two named areas so the DOM order can be masthead → form → case at every
     width. On a phone that puts the primary action second; on a desktop it puts
     it in a rail that stays beside the reader. Getting the same result with
     `order` on a flex column would leave the tab order following the visual order
     into the case content and back out again. */
  .dn-shell{ display:grid; grid-template-columns:minmax(0,1fr) 396px;
    grid-template-rows:auto 1fr; grid-template-areas:"say rail" "body rail";
    column-gap:clamp(36px,4.5vw,72px); }
  .dn-say{ grid-area:say; min-width:0; }
  .dn-body{ grid-area:body; min-width:0; }
  /* `align-self:start` so the item is its own height rather than stretched — a
     stretched grid item has nothing to stick within. The stickiness range is the
     grid container, which spans both rows, so the rail travels the whole case. */
  .dn-rail{ grid-area:rail; align-self:start; position:sticky; top:92px; }

  /* ══ THE MASTHEAD ═════════════════════════════════════════════════════════ */
  .dn-say h1{ margin:12px 0 0; font-family:var(--ag-font-display,Georgia,serif);
    font-weight:800; font-size:clamp(2.1rem,4.6vw,3.1rem); line-height:1.02;
    letter-spacing:-.03em; color:var(--dn-ink); text-wrap:balance; }
  .dn-say p{ margin:16px 0 0; max-width:52ch; font-size:16.5px; line-height:1.65;
    color:var(--dn-ink-2); text-wrap:pretty; }

  /* The figures, in the same breath as the ask rather than in a card further down.
     Mono, because they are money, and set against a rule rather than in a box. */
  .dn-fig{ display:flex; flex-wrap:wrap; gap:clamp(24px,5vw,56px); margin-top:32px;
    padding-top:22px; border-top:1px solid var(--dn-line-2); }
  .dn-fig__n{ font-family:var(--ag-font-mono,monospace); font-weight:700;
    letter-spacing:-.02em; font-size:clamp(1.5rem,3vw,2.05rem); color:var(--dn-ink);
    line-height:1.1; }
  .dn-fig__l{ margin-top:6px; font-size:12.5px; line-height:1.5; color:var(--dn-mute);
    max-width:22ch; }
  /* No figures yet. A zero beside an ask reads as a verdict, so the space says what
     it means instead of printing one. */
  /* The rule spans the column and the SENTENCE is what is measured, so the hairline
     lines up with the one under the figures rather than stopping short of it. */
  .dn-first{ display:flex; align-items:flex-start; gap:11px; margin-top:32px;
    padding-top:22px; border-top:1px solid var(--dn-line-2); font-size:14px;
    line-height:1.65; color:var(--dn-ink-2); }
  .dn-first span{ max-width:52ch; }
  .dn-first svg{ flex:none; margin-top:3px; color:var(--dn-gold-ink); }

  /* ══ THE FORM ═════════════════════════════════════════════════════════════
     A gold rule across the top rather than a coloured header: it marks the card as
     the subject of the page without spending a whole band on saying so. */
  .dn-card{ background:var(--dn-card); border:1px solid var(--dn-line);
    border-top:3px solid var(--dn-gold); border-radius:var(--dn-r);
    box-shadow:0 18px 40px -30px rgba(16,41,44,.5); overflow:hidden; }
  .dn-card__in{ padding:clamp(20px,2.2vw,26px); }
  .dn-card h2{ margin:0; font-family:var(--ag-font-display,Georgia,serif); font-weight:700;
    font-size:21px; line-height:1.2; letter-spacing:-.02em; color:var(--dn-ink); }
  .dn-card__sub{ margin:10px 0 0; font-size:13px; line-height:1.6; color:var(--dn-ink-2); }
  .dn-card__sub strong{ color:var(--dn-ink); font-weight:700; }
  .dn-card__sub + .dn-card__sub{ margin-top:8px; }
  .dn-card__gap{ height:18px; }

  /* Appeal progress. The bar carries an aria-label with the real figures, because a
     width is not readable — and the numbers sit under it in text for everybody else,
     since a bar alone invites "90% is nearly there" on a fifty-million-naira target. */
  /* The fund's own target. Same instrument as `.dn-prog` below, which is the campaign
     bar — taller only because this one sits in a masthead rather than inside a form
     card, and a 8px rule under a 40px figure reads as a hairline rather than a gauge. */
  /* Once / every month. Two buttons in the amount group's own vocabulary — a monthly
     gift agreed to by accident is a dispute, and a checkbox under a row of amounts is
     the control people miss. */
  .dn-freq{ display:flex; gap:8px; margin-top:8px; }
  .dn-freq__b{ flex:1; cursor:pointer; font-family:inherit; font-size:14px; font-weight:600;
               padding:12px 10px; min-height:44px; border-radius:12px;
               border:1px solid var(--dn-line); background:var(--dn-card,#fff); color:var(--dn-ink-2); }
  .dn-freq__b.is-on{ border-color:var(--dn-gold-ink,#8a6005); color:var(--dn-ink);
                     box-shadow:inset 0 0 0 1px var(--dn-gold-ink,#8a6005); }
  .dn-freq__n{ margin:9px 0 0; font-size:12.5px; line-height:1.55; color:var(--dn-mute); }

  .dn-goal{ margin:30px 0 0; max-width:44rem; }
  .dn-goal__bar{ height:11px; border-radius:99px; background:rgba(16,41,44,.10);
                 overflow:hidden; }
  .dn-goal__bar i{ display:block; height:100%; border-radius:99px;
                   background:var(--dn-gold-ink,#8a6005); }
  .dn-goal__nums{ margin:11px 0 0; font-size:13.5px; line-height:1.6; color:var(--dn-ink-2); }
  .dn-goal__nums b{ font-family:var(--ag-font-mono,monospace); font-weight:700;
                    font-variant-numeric:tabular-nums; color:var(--dn-ink); }
  .dn-goal__met{ color:var(--ag-green-dark,#1a6118); font-weight:600; }

  .dn-prog{ margin:16px 0 0; }
  .dn-prog__bar{ height:8px; border-radius:99px; background:rgba(16,41,44,.10);
    overflow:hidden; }
  .dn-prog__bar i{ display:block; height:100%; border-radius:99px;
    background:var(--dn-green); transition:width .4s ease; }
  .dn-prog__nums{ margin-top:9px; font-size:12.5px; line-height:1.6; color:var(--dn-ink-2); }
  .dn-prog__nums b{ font-family:var(--ag-font-mono,monospace); color:var(--dn-ink);
    font-size:14px; }
  @media (prefers-reduced-motion:reduce){ .dn-prog__bar i{ transition:none } }

  /* The other appeals an organisation has open, offered BEFORE the amount picker:
     somebody who came for a specific cause should not have their donation land in a
     general fund by default. */
  .dn-appeals{ margin:16px 0 0; display:grid; gap:8px; }
  .dn-appeal{ display:block; text-decoration:none; padding:12px 14px;
    border-radius:var(--dn-r-sm); border:1px solid var(--dn-line-2);
    background:var(--dn-card); }
  .dn-appeal:hover{ border-color:var(--dn-green); }
  .dn-appeal:focus-visible{ outline:3px solid var(--dn-green); outline-offset:2px; }
  .dn-appeal b{ display:block; font-size:14px; color:var(--dn-ink); }
  .dn-appeal span{ display:block; margin-top:3px; font-size:12.5px; color:var(--dn-mute); }

  .dn-lab{ display:block; margin:18px 0 8px; font-family:var(--ag-font-mono,monospace);
    font-size:11px; font-weight:700; letter-spacing:.18em; text-transform:uppercase;
    color:var(--dn-ink-2); }

  .dn-amounts{ display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:8px; }
  .dn-amt{ cursor:pointer; border:1px solid var(--dn-line-2); background:var(--dn-card);
    color:var(--dn-ink); font-family:var(--ag-font-mono,monospace); font-weight:700;
    font-size:14px; min-height:48px; padding:14px 4px; border-radius:var(--dn-r-sm);
    transition:border-color .12s, background .12s, color .12s; }
  .dn-amt:hover{ border-color:var(--dn-ink); }
  .dn-amt.is-on{ border-color:var(--dn-ink); background:var(--dn-ink); color:#fff; }
  .dn-amt:focus-visible{ outline:3px solid var(--dn-green); outline-offset:2px; }
  .dn-custom{ margin-top:8px; display:flex; align-items:center; gap:10px;
    background:var(--dn-card); border:1px solid var(--dn-line-2);
    border-radius:var(--dn-r-sm); padding:0 14px; min-height:48px;
    transition:border-color .12s; }
  .dn-custom:focus-within{ border-color:var(--dn-green);
    box-shadow:0 0 0 3px rgba(35,123,34,.14); }
  .dn-custom span{ font-family:var(--ag-font-mono,monospace); font-weight:700;
    font-size:16px; color:var(--dn-mute); }
  /* 16px, because anything smaller and iOS zooms the page on focus. */
  .dn-custom input{ flex:1; min-width:0; border:none; outline:none; background:none;
    font-family:var(--ag-font-mono,monospace); font-size:16px; font-weight:700;
    color:var(--dn-ink); }

  /* What the money does, on a cream strip rather than a green tint: the green in this
     palette is the action, and using it for a note makes the button quieter. */
  .dn-echo{ margin-top:16px; display:flex; align-items:flex-start; gap:10px;
    padding:13px 15px; border-radius:var(--dn-r-sm); background:var(--dn-cream);
    font-size:12.5px; line-height:1.55; color:var(--dn-ink-2); }
  .dn-echo svg{ flex:none; margin-top:1px; color:var(--dn-gold-ink); }

  .dn-cta{ width:100%; margin-top:18px; cursor:pointer; border:none;
    background:var(--dn-green); color:#fff; font-family:inherit; font-weight:700;
    font-size:15px; min-height:52px; padding:15px; border-radius:var(--ag-r-pill,999px);
    transition:background .15s; }
  .dn-cta:hover{ background:var(--dn-green-dark); }
  .dn-cta:focus-visible{ outline:3px solid var(--dn-ink); outline-offset:2px; }
  /* #5b6669 on #dfe4e3 is 4.6:1. A disabled control still has to be readable — it is
     carrying the sentence that says what to do to enable it. */
  .dn-cta:disabled{ background:#dfe4e3; color:#5b6669; cursor:not-allowed; }
  .dn-secure{ display:flex; align-items:center; justify-content:center; gap:7px;
    margin-top:12px; font-size:11.5px; color:var(--dn-mute); text-align:center; }
  .dn-secure svg{ flex:none; }

  .dn-back{ cursor:pointer; border:none; background:none; font-family:inherit;
    font-size:13px; font-weight:700; color:var(--dn-ink-2); padding:6px 0;
    margin:0 0 10px; min-height:32px; }
  .dn-back:hover{ color:var(--dn-ink); }
  .dn-back:focus-visible{ outline:3px solid var(--dn-green); outline-offset:2px; }
  .dn-recap{ display:flex; align-items:center; justify-content:space-between; gap:12px;
    margin:16px 0 0; padding:14px 16px; border-radius:var(--dn-r-sm);
    background:var(--dn-cream); }
  .dn-recap span{ font-size:13px; color:var(--dn-ink-2); }
  /* The total is the row a donor checks against their bank, so it is the one given
     weight — a stack of identically-set rows makes somebody add them up themselves. */
  .dn-recap--total{ border-top:1px solid var(--dn-line-2); }
  .dn-recap--total b{ color:var(--dn-green-dark); }
  /* A heading that only exists to catch focus must not draw a focus ring when a mouse
     put it there — `:focus-visible` is the whole reason that selector exists. */
  .dn-card h2[tabindex="-1"]:focus{ outline:none; }
  .dn-card h2[tabindex="-1"]:focus-visible{ outline:3px solid var(--dn-green); outline-offset:3px; }
  .dn-recap b{ font-family:var(--ag-font-mono,monospace); font-weight:700; font-size:17px;
    color:var(--dn-ink); }

  .dn-field{ margin-top:16px; }
  /* 11px, not the 9.5px the decorative kickers use. This is the primary label of a
     required field — it is read rather than glanced at, and uppercase mono at 9.5px with
     .22em tracking is a caption. */
  .dn-field label{ display:block; font-family:var(--ag-font-mono,monospace); font-size:11px;
    font-weight:700; letter-spacing:.18em; text-transform:uppercase; color:var(--dn-ink-2);
    margin-bottom:8px; }
  .dn-field input{ width:100%; box-sizing:border-box; border:1px solid var(--dn-line-2);
    border-radius:var(--dn-r-sm); padding:0 14px; min-height:48px; font-family:inherit;
    font-size:16px; color:var(--dn-ink); background:var(--dn-card); outline:none;
    transition:border-color .12s; }
  .dn-field input:focus{ border-color:var(--dn-green);
    box-shadow:0 0 0 3px rgba(35,123,34,.14); }
  .dn-field small{ display:block; margin-top:6px; font-size:12px; line-height:1.5;
    color:var(--dn-mute); }

  .dn-prov{ display:flex; gap:8px; flex-wrap:wrap; }
  .dn-prov label{ flex:1 1 128px; display:flex; align-items:center; gap:9px;
    min-height:48px; border:1px solid var(--dn-line-2); border-radius:var(--dn-r-sm);
    padding:12px 14px; cursor:pointer; font-size:13.5px; font-weight:600;
    color:var(--dn-ink); }
  .dn-prov label:has(input:checked){ border-color:var(--dn-ink);
    box-shadow:inset 0 0 0 1px var(--dn-ink); }
  .dn-prov label:focus-within{ outline:3px solid var(--dn-green); outline-offset:2px; }
  .dn-prov input{ accent-color:var(--dn-green); width:17px; height:17px; }

  /* ── THE VOLUNTARY GIFT TO THE PLATFORM ──────────────────────────────────
     Set apart from the amount picker rather than dressed like one: it is a different
     question about a different recipient, and a control that looks like the donation
     amount is a control somebody answers by accident. */
  .dn-tip{ border:1px solid rgba(16,41,44,.12); border-radius:12px; padding:12px 14px;
    margin:14px 0 0; }
  .dn-tip legend{ padding:0 4px; }
  .dn-tip__why{ margin:4px 0 10px; font-size:12.5px; line-height:1.6; color:#5a6d6f; }
  .dn-tip__opts{ display:flex; gap:8px; flex-wrap:wrap; }
  .dn-tip__opts label{ cursor:pointer; }
  .dn-tip__opts input{ position:absolute; opacity:0; width:0; height:0; }
  .dn-tip__opts span{ display:inline-block; min-height:40px; line-height:24px;
    padding:7px 14px; border-radius:999px; border:1px solid rgba(16,41,44,.18);
    font-size:13px; font-weight:600; color:#3d4b4d; }
  .dn-tip__opts input:checked + span{ border-color:#237b22; background:rgba(35,123,34,.08);
    color:#18571a; }
  /* Focus has to survive the hidden input — without this the whole row is unreachable by
     keyboard, which is the failure an accessibility pass catches and a mouse never does. */
  .dn-tip__opts input:focus-visible + span{ outline:2px solid #237b22; outline-offset:2px; }
  .dn-tip__sum{ margin:10px 0 0; font-size:12.5px; font-weight:600; color:#18571a; }
  [x-cloak]{ display:none !important; }
  .dn-cover{ display:flex; align-items:flex-start; gap:10px; margin-top:16px;
    padding:13px 15px; border-radius:var(--dn-r-sm); background:var(--dn-cream);
    cursor:pointer; }
  .dn-cover input{ margin-top:2px; width:17px; height:17px; flex:none;
    accent-color:var(--dn-green); }
  .dn-cover span{ font-size:12.5px; line-height:1.55; color:var(--dn-ink-2); }
  .dn-cover:focus-within{ outline:3px solid var(--dn-green); outline-offset:2px; }

  .dn-soon{ margin-top:16px; background:var(--dn-cream); border:1px solid #e3d9ba;
    color:#5f4805; border-radius:var(--dn-r-sm); padding:14px 16px; font-size:13.5px;
    line-height:1.6; }
  .dn-soon a{ color:var(--dn-green-dark); font-weight:700; text-decoration:underline; }
  /* #8f1d14 on #fdecec is 6.5:1. An error message that fails contrast is not an
     error message. */
  .dn-err{ font-size:13.5px; line-height:1.55; color:#8f1d14; background:#fdecec;
    border:1px solid rgba(180,35,24,.24); border-radius:var(--dn-r-sm);
    padding:12px 14px; margin-top:16px; }

  /* ══ WHERE THE DONATIONS GO ═══════════════════════════════════════════════
     A ruled list, not three cards. The three lines are short and of unequal
     length; three equal boxes in a row make them look like a comparison table
     between options a donor is being asked to choose from, which they are not. */
  .dn-sec{ margin-top:var(--dn-sec); }
  .dn-alloc{ margin:22px 0 0; display:flex; flex-direction:column;
    border-top:1px solid var(--dn-line-2); }
  .dn-alloc__r{ display:grid; grid-template-columns:34px minmax(0,1fr);
    column-gap:clamp(16px,2.4vw,28px); align-items:baseline; padding:20px 0;
    border-bottom:1px solid var(--dn-line); }
  .dn-alloc__n{ font-family:var(--ag-font-mono,monospace); font-size:11px; font-weight:700;
    letter-spacing:.14em; color:var(--dn-gold-ink); }
  .dn-alloc__t{ margin:0; font-family:var(--ag-font-display,Georgia,serif); font-weight:700;
    font-size:clamp(1.05rem,1.8vw,1.2rem); line-height:1.25; letter-spacing:-.01em;
    color:var(--dn-ink); }
  .dn-alloc__b{ margin:6px 0 0; font-size:14px; line-height:1.65; color:var(--dn-ink-2);
    max-width:52ch; text-wrap:pretty; }

  .dn-trust{ display:flex; align-items:flex-start; gap:12px; margin-top:22px;
    font-size:13.5px; line-height:1.65; color:var(--dn-ink-2); max-width:60ch; }
  .dn-trust svg{ flex:none; margin-top:2px; color:var(--dn-gold-ink); }
  .dn-trust a{ color:var(--dn-green-dark); font-weight:700; text-decoration:underline; }

  /* ══ THE MISSION — a pull quote, with a hanging rule ══════════════════════ */
  .dn-quote{ margin:var(--dn-sec) 0 0; padding-left:clamp(18px,3vw,30px);
    border-left:3px solid var(--dn-gold); }
  .dn-quote p{ margin:0; max-width:44ch; font-family:var(--ag-font-display,Georgia,serif);
    font-style:italic; font-weight:600; font-size:clamp(1.2rem,2.4vw,1.6rem);
    line-height:1.4; letter-spacing:-.01em; color:var(--dn-ink); text-wrap:pretty; }
  .dn-quote small{ display:block; margin-top:14px; font-family:var(--ag-font-mono,monospace);
    font-size:10.5px; font-style:normal; font-weight:700; letter-spacing:.2em;
    text-transform:uppercase; color:var(--dn-mute); }

  /* ══ RECENT DONATIONS — a ledger, not a testimonial wall ══════════════════ */
  .dn-led{ margin:22px 0 0; border-top:1px solid var(--dn-line-2); }
  .dn-led__r{ display:flex; align-items:baseline; gap:16px; padding:14px 0;
    border-bottom:1px solid var(--dn-line); }
  .dn-led__n{ flex:1; min-width:0; font-size:14.5px; color:var(--dn-ink);
    overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  /* `tabular-nums` so a column of amounts lines up on its digits rather than
     roughly. A ledger whose figures do not align is not being read as a ledger. */
  /* When it arrived, between the giver and the amount. `flex:none` so it never squeezes
     the name, and the name keeps `flex:1` so a long one still ellipsises rather than
     pushing the figure off a phone. */
  .dn-led__w{ flex:none; font-size:12px; color:var(--dn-mute);
              font-variant-numeric:tabular-nums; white-space:nowrap; }
  .dn-sec--share .dn-share__l{ margin:10px 0 18px; max-width:58ch; font-size:14.5px;
                               line-height:1.65; color:var(--dn-ink-2); }
  .dn-led__a{ flex:none; font-family:var(--ag-font-mono,monospace); font-weight:700;
    font-size:14.5px; font-variant-numeric:tabular-nums; color:var(--dn-ink); }

  /* Hidden by default. Above the breakpoint the form is still in the rail beside the
     reader, and a "donate" link that scrolls to something already on screen is a dead
     control. CSS rather than a script, so it is right with JavaScript off too. */
  .dn-jump{ display:none; margin:var(--dn-sec) 0 0; }
  .dn-jump a{ display:inline-flex; align-items:center; gap:9px; min-height:48px;
    padding:0 24px; border-radius:var(--ag-r-pill,999px); background:var(--dn-ink);
    color:#fff; font-weight:700; font-size:14.5px; text-decoration:none; }
  .dn-jump a:hover{ background:var(--dn-green-dark); }
  .dn-jump a:focus-visible{ outline:3px solid var(--dn-green); outline-offset:3px; }

  /* ══ FOR ORGANISATIONS — a flat band, hairlines inside it ═════════════════ */
  .dn-org{ margin-top:var(--dn-sec); border-radius:var(--dn-r);
    background:var(--dn-deep); padding:clamp(28px,4vw,48px); }
  .dn-org__grid{ display:grid; grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);
    gap:clamp(28px,4vw,56px); align-items:start; }
  .dn-org p{ margin:14px 0 0; max-width:48ch; font-size:15px; line-height:1.7;
    color:var(--dn-on-deep); text-wrap:pretty; }
  .dn-org p strong{ color:#fff; }
  .dn-org__fine{ margin-top:16px; max-width:48ch; font-size:12.5px; line-height:1.65;
    color:var(--dn-on-deep-2); }
  .dn-org__cta{ display:inline-flex; align-items:center; justify-content:center;
    margin-top:24px; min-height:50px; padding:0 28px; border-radius:var(--ag-r-pill,999px);
    background:var(--dn-gold); color:#241c00; font-weight:700; font-size:15px;
    text-decoration:none; }
  .dn-org__cta:hover{ background:#ffc63d; }
  .dn-org__cta:focus-visible{ outline:3px solid #fff; outline-offset:3px; }
  .dn-org__panel{ border-top:1px solid var(--dn-rule-deep); }
  /* The pre-launch state has one row and no figures, so the closing rule under it would
     read as a table with a missing second line. */
  .dn-org__panel--new .dn-org__row{ border-bottom:0; }
  .dn-org__panel--new .dn-org__l{ max-width:44ch; }
  .dn-org__row{ padding:20px 0; border-bottom:1px solid var(--dn-rule-deep); }
  .dn-org__n{ font-family:var(--ag-font-mono,monospace); font-weight:700;
    letter-spacing:-.02em; font-size:clamp(1.4rem,2.6vw,1.85rem); color:var(--dn-figure);
    line-height:1.1; }
  .dn-org__l{ margin-top:7px; font-size:12.5px; line-height:1.55;
    color:var(--dn-on-deep-2); }

  /* ── ONE BREAKPOINT ──────────────────────────────────────────────────────
     The rail becomes the second block. 1000px is where a 396px rail stops leaving
     the text column a readable measure rather than a column of two-word lines. */
  @media (max-width:1000px){
    .dn-shell{ grid-template-columns:minmax(0,1fr); grid-template-rows:auto auto auto;
      grid-template-areas:"say" "rail" "body"; }
    .dn-rail{ position:static; margin-top:32px; max-width:520px; }
    .dn-jump{ display:block; }
    .dn-org__grid{ grid-template-columns:minmax(0,1fr); }
  }
  @media (max-width:420px){
    .dn-amounts{ grid-template-columns:1fr 1fr; }
  }
</style>
{% endblock %}

{% block content %}
<div class="dn" x-data="donate()">
  <div class="dn-shell">

    {# ══ THE MASTHEAD ══════════════════════════════════════════════════════
       The identity of what is being funded lives HERE, once. The form carries the
       mechanics — an amount and a payment method — and does not repeat the title. #}
    <header class="dn-say">
      {% if campaign %}
        <span class="dn-kick">Donations · {{ org.name }}</span>
        <h1>{{ campaign.title }}</h1>
        <p>{% if campaign.summary %}{{ campaign.summary }}{% else %}An appeal run by
          {{ org.name }}. Your donation settles directly to their own account.{% endif %}</p>
      {% elseif org %}
        <span class="dn-kick">Donations · partner appeal</span>
        <h1>Donate to {{ org.name }}</h1>
        <p>Your donation settles directly into {{ org.name }}’s own account — Africa GATES
          never holds it.</p>
      {% else %}
        <span class="dn-kick">Donations</span>
        <h1>Fund the next generation of leaders</h1>
        <p>Every donation funds child leadership programmes across the continent —
          mentorship, scholarships, and the classrooms where tomorrow’s icons begin.</p>
      {% endif %}

      {# ── THE TARGET ──────────────────────────────────────────────────────
         A partner's appeal has had a goal and a bar since it shipped; this fund had a
         raised figure and nothing to measure it against. "₦2,400,000 raised" is a fact
         with no shape — a stranger cannot tell whether that is nearly done or barely
         started, and a number that cannot be read as progress does not read as an ask.

         It draws only when an operator has set one. An invented target is worse than
         none, and `donation_goal_naira` is unset by default — so a deployment that has
         not decided what it is raising for keeps exactly the page it had.

         The bar is capped at 100%; the FIGURE beside it is not. A bar running past its
         own track reads as a rendering fault, and passing the target is good news. #}
      {% if fund_goal %}
        <div class="dn-goal">
          <div class="dn-goal__bar" role="img"
               aria-label="₦{{ fund_goal.raised|number_format }} raised of a ₦{{ fund_goal.goal|number_format }} target">
            <i style="width:{{ fund_goal.pct }}%"></i>
          </div>
          <p class="dn-goal__nums">
            <b>₦{{ fund_goal.raised|number_format }}</b> raised of
            <b>₦{{ fund_goal.goal|number_format }}</b>
            {%- if fund_goal.met %} — <span class="dn-goal__met">target reached, and still open</span>
            {%- else %} · <b>₦{{ fund_goal.remaining|number_format }}</b> to go{% endif %}
          </p>
        </div>
      {% endif %}

      {# ── THE FIGURES, OR THE ABSENCE OF THEM ──
         Confirmed rows only. With none yet the space says so plainly rather than
         printing a zero, because "₦0 raised" beside an ask reads as a verdict. #}
      {% if stats.gifts > 0 %}
        <div class="dn-fig">
          {# The raised figure is in the target line above when there is one, and printing
             it again forty pixels below is the masthead saying the same thing twice. The
             count is the half the bar cannot carry. #}
          {% if not fund_goal %}
          <div>
            <div class="dn-fig__n">₦{{ stats.raised_naira|number_format }}</div>
            <div class="dn-fig__l">Raised {% if campaign %}for this appeal{% elseif org %}for
              {{ org.name }}{% else %}in community donations{% endif %}</div>
          </div>
          {% endif %}
          <div>
            <div class="dn-fig__n">{{ stats.gifts|number_format }}</div>
            <div class="dn-fig__l">Donation{{ stats.gifts == 1 ? '' : 's' }} received</div>
          </div>
        </div>
      {% else %}
        <div class="dn-first">
          <svg aria-hidden="true" focusable="false" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8Z"/></svg>
          <span>Be among the first to fund this cycle — every donation is receipted and goes
            straight to the programmes.</span>
        </div>
      {% endif %}
    </header>

    {# ══ THE FORM ══════════════════════════════════════════════════════════ #}
    <div class="dn-rail">
      <div class="dn-card" id="give">
        {# The refusal message is hoisted ABOVE the providers branch on purpose. A closed
           appeal renders with no providers at all, so while this lived inside the form the
           one page that most needed to explain itself — "that appeal has closed, nothing
           was charged" — rendered the message into a branch that was never taken. #}
        {% if providers is empty %}
        <div class="dn-card__in">
          <h2>{% if org_closed is defined and org_closed %}This appeal is closed{% else %}Make a donation{% endif %}</h2>
          {% if error %}<div class="dn-err" role="alert">{{ error }}</div>{% endif %}
          {% if not (org_closed is defined and org_closed) %}
            <p class="dn-card__sub">Choose how you’d like to donate.</p>
            <div class="dn-soon">Online giving is being set up. In the meantime, reach our
              team via <a href="/support">/support</a> to make a donation — we’ll send you
              secure payment details and a receipt.</div>
          {% endif %}
        </div>
        {% else %}
        <form class="dn-card__in" method="post" action="/giving" @submit="submitting = true">
          <input type="hidden" name="_token" value="{{ csrf_token }}">
          <input type="hidden" name="amount" :value="value">
          {# Which appeal this is. Re-resolved and re-checked server-side — the slug is a
             request, not an instruction. #}
          {% if org %}<input type="hidden" name="org" value="{{ org.slug }}">{% endif %}
          {# Re-resolved by (org, slug) TOGETHER server-side: a campaign slug belonging to a
             different organisation must not attach. #}
          {% if campaign %}<input type="hidden" name="campaign" value="{{ campaign.slug }}">{% endif %}

          {% if error %}<div class="dn-err" role="alert">{{ error }}</div>{% endif %}

          {# ── STEP ONE · THE AMOUNT ─────────────────────────────────────── #}
          <div x-show="step==='choose'">
            {#- `tabindex="-1"` for the same reason as step two's: coming BACK has to land
                somewhere, or "Change the amount" returns a keyboard user to the document
                and they have to find the form again. -#}
            <h2 id="dnStep1" tabindex="-1">{% if campaign %}Donate to this appeal{% else %}Make a donation{% endif %}</h2>

            {% if campaign %}
              {# ── PROGRESS, FROM CONFIRMED ROWS ──────────────────────────
                 A target is a representation, so the bar can only ever show money that
                 actually arrived. The figures under it are the raw numbers, because a bar
                 alone invites somebody to read 90% as "nearly there" when the target is
                 ₦50,000,000. #}
              {% if progress and progress.target > 0 %}
                <div class="dn-prog">
                  <div class="dn-prog__bar" role="img"
                       aria-label="Raised ₦{{ progress.raised|number_format }} of a ₦{{ progress.target|number_format }} target, {{ progress.pct }} percent">
                    <i style="width:{{ progress.pct }}%"></i>
                  </div>
                  <div class="dn-prog__nums">
                    <b>₦{{ progress.raised|number_format }}</b> raised of
                    ₦{{ progress.target|number_format }}
                    · {{ progress.count }} donation{{ progress.count == 1 ? '' : 's' }}
                    {%- if days_left is not null %} · {{ days_left }} day{{ days_left == 1 ? '' : 's' }} left{% endif %}
                  </div>
                </div>
                {# ── WHAT HAPPENS IF THE TARGET IS MISSED ──────────────────
                   Stated BEFORE anybody donates. It is the first question a thoughtful
                   donor asks and the last thing most platforms answer — and deciding it
                   after the money is in hand means deciding it in whatever way is most
                   convenient. #}
                {% if shortfall_text %}
                  <p class="dn-card__sub"><strong>If the target is not reached:</strong>
                    {{ shortfall_text|lower }}.</p>
                {% endif %}
              {% elseif days_left is not null %}
                <p class="dn-card__sub">{{ days_left }} day{{ days_left == 1 ? '' : 's' }} left
                  · ₦{{ progress.raised|number_format }} raised so far</p>
              {% endif %}

              <p class="dn-card__sub">Run by <strong>{{ org.name }}</strong>. Your donation
                settles directly to their own account.
                {%- if org_fee_bps > 0 %} Africa GATES keeps
                {{ (org_fee_bps / 100)|number_format(2) }}% of each donation.{% else %} Africa
                GATES takes nothing.{% endif %}</p>

            {% elseif org %}
              {# Open appeals, offered BEFORE the amount picker. Somebody who arrived at an
                 organisation's page may have come for a specific cause, and burying the
                 list under the form means their donation lands in the general fund by
                 default rather than by choice. The general fund stays available below. #}
              {% if appeals %}
                <p class="dn-card__sub">{{ org.name }} is raising for {{ appeals|length }}
                  specific appeal{{ appeals|length == 1 ? '' : 's' }}. Donate to one of those,
                  or to their general fund below.</p>
                <div class="dn-appeals">
                  {% for a in appeals %}
                    <a class="dn-appeal" href="/giving/{{ org.slug }}/{{ a.slug }}">
                      <b>{{ a.title }}</b>
                      {% if a.summary %}<span>{{ a.summary }}</span>{% endif %}
                    </a>
                  {% endfor %}
                </div>
              {% endif %}
              {# ── WHAT THIS PAGE MAY PROMISE, AND WHAT IT MUST NOT ────────
                 "100% funds the programmes" is true when Africa GATES is the recipient and
                 the fee cover offsets the gateway's cut. It stops being true the moment a
                 platform fee is deducted from somebody else's donation, so the claim is
                 made ONLY where it holds, and the fee is stated in naira beside the amount
                 otherwise — not in a footnote, and never discovered after paying. #}
              {% if org_fee_bps > 0 %}
                <p class="dn-card__sub">Africa GATES keeps
                  {{ (org_fee_bps / 100)|number_format(2) }}% of this donation
                  (<span x-text="ngn(Math.floor(value * {{ org_fee_bps }} / 10000))"></span>);
                  the rest goes to {{ org.name }}.</p>
              {% else %}
                <p class="dn-card__sub">A one-time donation — Africa GATES takes nothing.
                  100% goes to {{ org.name }}.</p>
              {% endif %}
              <p class="dn-card__sub">Africa GATES checks that {{ org.name }} is registered
                with the CAC{% if org.scuml_number %} and with SCUML{% endif %}, and that
                donations settle to a bank account in their own name. We do not audit how the
                money is spent.</p>
            {% else %}
              <p class="dn-card__sub">A one-time donation — 100% funds the programmes.</p>
            {% endif %}

            <span class="dn-lab" id="dnAmtLab">Choose an amount</span>
            {# A group, named by the label above it: without the role and the label these
               are six unrelated buttons to a screen reader, and `aria-pressed` on each is
               the only thing saying which is chosen. #}
            <div class="dn-amounts" role="group" aria-labelledby="dnAmtLab">
              <template x-for="a in presets" :key="a">
                <button type="button" class="dn-amt" :class="{ 'is-on': !custom && amt===a }"
                        :aria-pressed="(!custom && amt===a).toString()"
                        @click="amt=a; custom=''" x-text="ngn(a)"></button>
              </template>
            </div>
            <div class="dn-custom">
              <span aria-hidden="true">₦</span>
              <input type="text" inputmode="numeric" placeholder="Or another amount"
                     aria-label="Another amount, in naira" x-model="custom" @input="onCustom">
            </div>

            <div class="dn-echo">
              <svg aria-hidden="true" focusable="false" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8Z"/></svg>
              <span>Your donation funds mentorship, scholarships and grassroots education
                across the continent.</span>
            </div>

            {# ── ONCE, OR EVERY MONTH ────────────────────────────────────────
               Drawn only where it can be honoured. `recurring` is false unless Paystack is
               configured, because this is a real plan at the gateway — Paystack bills,
               retries, and lets the donor stop from their own receipt. An option that
               quietly fell back to a single gift would be worse than none: the donor would
               believe they had set something up.

               Two buttons rather than a checkbox. "Give monthly" as a tick under an amount
               is the pattern that gets missed and then disputed; two visible choices with
               one of them selected cannot be agreed to by accident. #}
            {% if recurring %}
            <span class="dn-lab" id="dnFreqLab">How often</span>
            <div class="dn-freq" role="group" aria-labelledby="dnFreqLab">
              <button type="button" class="dn-freq__b" :class="{ 'is-on': !monthly }"
                      :aria-pressed="(!monthly).toString()" @click="monthly=false">Once</button>
              <button type="button" class="dn-freq__b" :class="{ 'is-on': monthly }"
                      :aria-pressed="monthly.toString()" @click="monthly=true">Every month</button>
            </div>
            <p class="dn-freq__n" x-show="monthly" x-cloak>
              Charged today and on this date each month. Stop any time from the link in your
              receipt &mdash; no account, no phone call.</p>
            {% endif %}

            {# The disabled state says the minimum rather than merely refusing. A greyed
               button with no sentence is a dead end somebody leaves rather than solves. #}
            <button type="button" class="dn-cta" :disabled="value < {{ min_naira }}"
                    @click="advance({{ min_naira }})"
                    x-text="value>={{ min_naira }} ? ('Continue with '+ngn(value)) : ('Minimum donation is ₦{{ min_naira|number_format }}')"></button>
            <div class="dn-secure">
              <svg aria-hidden="true" focusable="false" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              Secure · encrypted · receipted
            </div>
          </div>

          {# Carried on the form rather than re-asked in step two: the donor chose it beside
             the amount, and a second question about frequency at the payment step reads as
             the page not having listened. #}
          {% if recurring %}<input type="hidden" name="monthly" :value="monthly ? '1' : '0'">{% endif %}

          {# ── STEP TWO · WHO AND HOW ────────────────────────────────────── #}
          <div x-show="step==='details'" x-cloak>
            <button type="button" class="dn-back" @click="back()">← Change the amount</button>
            {#- `tabindex="-1"` so `focus()` can reach it. Without the move, advancing a step
                leaves focus on a button that is now `display:none` — the browser drops it to
                the document and a keyboard or screen-reader user is standing at the top of
                the page with no idea the form advanced. The whole flow works with a mouse
                and is unusable without one, which is the split an accessibility pass is
                least likely to catch because every individual control is fine. -#}
            <h2 id="dnStep2" tabindex="-1">Your details</h2>

            {# ── WHAT THEY ARE ABOUT TO AGREE TO, STATED CORRECTLY ──────────
               This said "One-time donation" unconditionally — so a donor who chose "Every
               month" one step earlier was shown the words "One-time donation" on the step
               where they confirm what they are agreeing to. The page had listened and then
               told them it had not, immediately before taking a standing order.

               The tip is here for the same reason: the button and the recap must agree,
               and a total that appears for the first time on the gateway's own screen is
               the moment a donor abandons. -#}
            <div class="dn-recap">
              <span x-text="monthly ? 'Every month' : 'One-time donation'"></span>
              <b x-text="ngn(value)"></b>
            </div>
            <div class="dn-recap" x-show="tipPct > 0" x-cloak>
              <span>Gift to Africa GATES</span>
              <b x-text="ngn(tipAmount)"></b>
            </div>
            <div class="dn-recap dn-recap--total" x-show="tipPct > 0" x-cloak>
              <span>Total today</span><b x-text="ngn(value + tipAmount)"></b>
            </div>
            <div class="dn-field">
              <label for="dnName">Full name</label>
              <input id="dnName" type="text" name="name" autocomplete="name">
              <small>Optional. Leave it out and the receipt goes to your email alone.</small>
            </div>
            <div class="dn-field">
              <label for="dnEmail">Email</label>
              <input id="dnEmail" type="email" name="email" required autocomplete="email"
                     x-model="email">
              <small>Where the receipt goes. It is the only thing we need.</small>
            </div>
            <div class="dn-field">
              <span class="dn-lab" id="dnProvLab" style="margin-top:0">Pay with</span>
              <div class="dn-prov" role="group" aria-labelledby="dnProvLab">
                {% for p in providers %}
                  <label><input type="radio" name="provider" value="{{ p.id }}"
                                {% if loop.first %}checked{% endif %}>{{ p.label }}</label>
                {% endfor %}
              </div>
            </div>
            <label class="dn-cover">
              <input type="checkbox" name="cover_fees" value="1" checked>
              {# The claim is scoped to what the cover actually buys. It offsets the
                 GATEWAY's cut; it has never offset a platform fee, so on a partner appeal
                 that charges one it says what it covers and stops there rather than
                 promising 100%. #}
              <span>{% if org and org_fee_bps > 0 %}Add {{ processing_fee_pct }}% to cover the
                payment processing charge, so the full amount above reaches {{ org.name }}
                less the Africa GATES share shown.{% else %}Add {{ processing_fee_pct }}% to
                cover processing, so 100% of my donation reaches
                {{ org ? org.name : 'the cause' }}.{% endif %}</span>
            </label>
            {# ── A VOLUNTARY GIFT TO AFRICA GATES ──────────────────────────
               Only on somebody ELSE's appeal. On the Africa GATES page the donor is
               already giving to Africa GATES, and a second field asking whether they
               would also like to reads as a trick rather than an offer.

               NOT PRE-TICKED, and that is a legal position as much as a commercial one:
               under the NDPA 2023 and the GDPR line on consent, a default the user did
               not choose is not a choice. It is also bad for the thing it funds — a donor
               who finds at the bank that they gave us something they did not intend
               disputes the whole payment, and the organisation loses their gift with it.

               The percentage is what posts; the naira figure beside it is rendered for
               the reader and recomputed server-side, because a total from a browser is a
               number the donor's bank will be shown that the donor's browser chose.

               ZERO IS AN OPTION IN THE LIST rather than the absence of the control. A
               donor who is asked and says no has declined; one who was never asked has
               not, and only the first is a record anybody can stand behind. #}
            {% if platform_tip.offered %}
              <fieldset class="dn-tip">
                <legend class="dn-lab">Add a gift to Africa GATES?</legend>
                <p class="dn-tip__why">Africa GATES is a project of a Nigerian non-profit.
                  We build and run the giving, voting and verification this appeal uses.
                  <strong>Anything you add here is on top of your donation</strong> &mdash; it
                  does not come out of what {{ org.name }} receives.</p>
                <div class="dn-tip__opts" role="group" aria-label="Gift to Africa GATES">
                  {% for pct in platform_tip.options %}
                    <label>
                      <input type="radio" name="platform_tip" value="{{ pct }}"
                             {% if pct == platform_tip.default %}checked{% endif %}
                             x-model="tipPct">
                      <span>{% if pct == 0 %}No thanks{% else %}{{ pct }}%{% endif %}</span>
                    </label>
                  {% endfor %}
                </div>
                <p class="dn-tip__sum" x-show="tipPct > 0" x-cloak>
                  <span x-text="ngn(Math.floor(value * tipPct / 100))"></span> to Africa GATES
                  &middot; total <span x-text="ngn(value + Math.floor(value * tipPct / 100))"></span>
                </p>
              </fieldset>
            {% endif %}
            <button type="submit" class="dn-cta" :disabled="submitting"
                    x-text="submitting ? 'Redirecting…' : ('Donate '+ngn(value + (tipPct>0 ? Math.floor(value*tipPct/100) : 0)))"></button>
            <div class="dn-secure">
              <svg aria-hidden="true" focusable="false" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              You’ll complete payment on our secure gateway.
            </div>
          </div>
        </form>
        {% endif %}
      </div>
    </div>

    {# ══ THE CASE ══════════════════════════════════════════════════════════ #}
    <div class="dn-body">

      {# ══ WHERE THE MONEY GOES ══════════════════════════════════════════════
         Numbered rather than iconed: three little tinted squares beside three short lines
         is decoration, and a reader scanning "where does my money go" is counting the
         things it goes to.

         ── TWO THINGS THIS BLOCK USED TO GET WRONG ────────────────────────
         It was a `{% set %}` of three hardcoded destinations, so a representation about
         the use of charitable funds was editable only by somebody who could deploy — on a
         host with no shell. And it was UNGATED, so a partner's appeal told a donor their
         money funded Africa GATES' scholarships while it settled into the partner's own
         account: a false statement about somebody else's money on the page collecting it.

         `FundAllocation::forOrg()` is both halves. Empty on a partner page, and empty on a
         deployment that has never been asked — in which case the section does not draw at
         all, because a heading over nothing is worse than no heading. A partner's own case
         is their `OrgBrand` story, rendered further down. #}
      {% if allocation %}
      <section class="dn-sec">
        <span class="dn-kick">The allocation</span>
        <h2 class="dn-h2">Where donations go</h2>
        <div class="dn-alloc">
          {% for a in allocation %}
            <div class="dn-alloc__r">
              <span class="dn-alloc__n" aria-hidden="true">{{ '%02d'|format(loop.index) }}</span>
              <div>
                <h3 class="dn-alloc__t">{{ a.title }}</h3>
                {% if a.body %}<p class="dn-alloc__b">{{ a.body }}</p>{% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
        <p class="dn-trust">
          <svg aria-hidden="true" focusable="false" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 4 5v6c0 5 3.4 9.7 8 11 4.6-1.3 8-6 8-11V5l-8-3Z"/><path d="m9 12 2 2 4-4"/></svg>
          <span>Every donation is receipted and the fund is independently audited — read the
            full method in the <a href="/integrity">Integrity Center</a>.</span>
        </p>
      </section>
      {% endif %}

      {# Africa GATES' own mission, so it belongs on Africa GATES' own page. On a partner's
         appeal it displaced the thing a donor came to read with a statement about a
         different organisation's purpose. #}
      {% if not org %}
      <blockquote class="dn-quote">
        <p>“Recognition is only the beginning. The fund turns a spotlight into a scholarship,
          a mentor, a classroom — so the next generation of African leaders has somewhere to
          begin.”</p>
        <small>The Africa GATES mission · an Afrovanguard initiative</small>
      </blockquote>
      {% endif %}

      {# Held back below three, because a ledger carrying a single anonymised row says less
         than the figure in the masthead already does.

         WHEN each gift arrived is the half that was missing. The timestamp has been
         collected and handed to this template since the ledger shipped and was printed
         nowhere, so a page whose whole job is to show that other people are giving could
         not say whether the last one came this morning or last year — which is the
         difference between a live appeal and an archive. #}
      {% if givers|length >= 3 %}
      <section class="dn-sec">
        <span class="dn-kick">Confirmed</span>
        <h2 class="dn-h2">Recent donations</h2>
        <div class="dn-led">
          {% for g in givers %}
            <div class="dn-led__r">
              <span class="dn-led__n">{{ g.name }}</span>
              {% if g.ago %}<span class="dn-led__w">{{ g.ago }}</span>{% endif %}
              <span class="dn-led__a">₦{{ g.amount|number_format }}</span>
            </div>
          {% endfor %}
        </div>
      </section>
      {% endif %}

      {# ── THE ORGANISATION'S OWN PAGE ─────────────────────────────────────
         Rendered here, above the share row and below their appeals: everything the
         organisation wrote about themselves is the case, and the share row asks a favour
         of somebody who has just been given a reason.

         A partial rather than three hundred more lines in this file, and included `only`
         so it cannot quietly read a variable this page happens to have in scope — which
         is how a partial comes to work on one page and render blank on the next. #}
      {% include 'partials/org-page.twig' with {
        org: org, brand: brand, brand_css: brand_css,
        story_paragraphs: story_paragraphs, gates_credit: gates_credit
      } only %}

      {# ── PASSING IT ON ───────────────────────────────────────────────────
         The one thing a fundraising page cannot do for itself. Every other surface here
         that asks somebody to pass a link on renders the same partial, so the
         destinations, the copy and the no-JavaScript fallback cannot drift apart between
         a ballot and an appeal.

         Placed AFTER the case has been made and never before it: a share row above the
         reason to share is asking for a favour from somebody who has not been given one. #}
      <section class="dn-sec dn-sec--share">
        <span class="dn-kick">Pass it on</span>
        <h2 class="dn-h2">{% if campaign %}Share this appeal{% elseif org %}Share {{ org.name }}{% else %}Share the fund{% endif %}</h2>
        <p class="dn-share__l">Most gifts here arrive because somebody sent the link to
          somebody else. It costs nothing and it is the single most useful thing you can do
          if you cannot give today.</p>
        {% include 'partials/share.twig' with {
          share_label: '',
          share_text: campaign ? campaign.title
                    : (org ? ('Support ' ~ org.name ~ ' on Africa GATES')
                           : 'Fund the next generation of African leaders — Africa GATES')
        } only %}
      </section>

      {# Only below the breakpoint, where the form is not beside the reader any more. On a
         desktop the rail is still on screen and a "donate" link that scrolls to something
         already visible is a dead control. #}
      {% if providers is not empty %}
        <p class="dn-jump"><a href="#give">Make a donation</a></p>
      {% endif %}
    </div>
  </div>

  {# ══ FOR ORGANISATIONS ════════════════════════════════════════════════════
     Shown only on the Africa GATES page, never on an organisation's own. On a partner's
     appeal it would be an advert for the platform in the middle of somebody else's ask,
     competing with the reason the visitor came.

     The two figures are the ones a stranger is actually asking: has anybody applied, and
     has anybody got money out of it. The first counts EVERY applicant rather than only the
     ones who got through — a page reporting successes alone claims a 100% acceptance rate
     for a process that refuses people. #}
  {% if not org %}
  <section class="dn-org">
    <div class="dn-org__grid">
      <div>
        <span class="dn-kick dn-kick--deep">For organisations</span>
        <h2 class="dn-h2 dn-h2--deep">Raise donations on a page of your own</h2>
        <p>Supporters donate on a page in your name and the money settles
          <strong>directly into your own account</strong> — Africa GATES never holds it,
          because the split happens at the payment gateway rather than in a balance we are
          looking after for you.</p>
        <a class="dn-org__cta" href="/giving/apply">Apply to raise donations</a>
        <p class="dn-org__fine">CAC and SCUML registration are both required, and the
          settlement account must be in your organisation’s own registered name. Everything
          we ask for is listed on the form.</p>
      </div>
      {# ── AND THE SAME RULE THE MASTHEAD OBEYS ──────────────────────────
         "₦0 raised" beside an ask reads as a verdict, which is why the figures at the top
         of this page are suppressed until there are any. A panel reading `0 organisations
         applied · ₦0 generated` beside "raise donations on a page of your own" is the same
         mistake with more authority — it is the platform publishing a nil return on its own
         scheme. Until there is something to report, the space says what stage the scheme is
         at, which is the honest answer and the more encouraging one. #}
      {% if org_totals.orgs > 0 %}
        <div class="dn-org__panel">
          <div class="dn-org__row">
            <div class="dn-org__n">{{ org_totals.orgs|number_format }}</div>
            <div class="dn-org__l">organisation{{ org_totals.orgs == 1 ? '' : 's' }} applied,
              {{ org_totals.approved|number_format }} approved</div>
          </div>
          <div class="dn-org__row">
            <div class="dn-org__n">₦{{ org_totals.raised|number_format }}</div>
            <div class="dn-org__l">generated for them, across
              {{ org_totals.gifts|number_format }} donation{{ org_totals.gifts == 1 ? '' : 's' }}</div>
          </div>
        </div>
      {% else %}
        <div class="dn-org__panel dn-org__panel--new">
          <div class="dn-org__row">
            <div class="dn-org__l" style="margin-top:0">
              <strong style="color:#fff;font-weight:700">The scheme is open and nobody has
              applied yet.</strong><br>
              Registration is checked, the settlement account is verified with your bank, and
              you keep your own page. What we publish here once there are applications is the
              number who applied and the number approved — both figures, not just the ones who
              got through.</div>
          </div>
        </div>
      {% endif %}
    </div>
  </section>
  {% endif %}
</div>
{% endblock %}

{% block foot_scripts %}
<script nonce="{{ csp_nonce }}">
  function donate(){
    return {
      presets:[5000,15000,50000,100000,250000,500000],
      amt:15000, custom:'', email:'', step:'choose', submitting:false,
      /* Defaults to a single gift. A page that arrives with "every month" already chosen is
         asking somebody to notice and undo it, which is the same fault as a pre-ticked box. */
      monthly:false,
      /* The voluntary gift to Africa GATES, as a PERCENTAGE. Zero by default for the same
         reason `monthly` is false: a page that arrives with a choice already made is asking
         somebody to notice and undo it. The naira figure is derived for display only —
         PlatformTip recomputes it server-side from this percentage, because a total from a
         browser is a number the donor's bank will be shown that the browser chose. */
      tipPct:0,
      get value(){ return this.custom ? (parseInt(String(this.custom).replace(/[^0-9]/g,''))||0) : this.amt; },
      ngn(n){ return '₦'+Number(n||0).toLocaleString('en-NG'); },
      onCustom(){ this.custom = String(this.custom).replace(/[^0-9]/g,''); },

      /* The tip in naira, derived. `PlatformTip` recomputes it server-side from the
         percentage — a total from a browser is a number the donor's bank will be shown that
         the browser chose — so this exists only so the recap and the button can agree with
         each other before they get there. */
      get tipAmount(){ return this.tipPct > 0 ? Math.floor(this.value * this.tipPct / 100) : 0; },

      /* ── MOVING BETWEEN STEPS MOVES FOCUS ───────────────────────────────────
         `x-show` sets `display:none`, and a focused element that becomes display:none has
         its focus dropped to the document — so advancing left a keyboard or screen-reader
         user at the top of the page with no announcement that anything had happened. Every
         individual control passes an audit; the flow is unusable without a mouse.

         `$nextTick` because the target is still hidden at the moment of the click, and
         `focus()` on a `display:none` element does nothing at all. */
      advance(min){
        if (this.value < min) return;
        this.step = 'details';
        this.$nextTick(() => { const h = document.getElementById('dnStep2'); if (h) h.focus(); });
      },
      back(){
        this.step = 'choose';
        this.$nextTick(() => { const h = document.getElementById('dnStep1'); if (h) h.focus(); });
      }
    };
  }

  /* ══ CLICK-TO-LOAD VIDEO ════════════════════════════════════════════════════
     Nothing reaches YouTube or Vimeo until this runs, which is the point: an iframe
     present in the markup sends the visitor's IP to a third party on page view, before
     they have done anything. See the note at the top of partials/org-page.twig for why
     that is a legal question and not a performance one.

     Delegated from the document, so it costs nothing on the pages with no video and does
     not care that the facade may be inside a partial included conditionally.

     The src is read from the container rather than built here. It was assembled by
     OrgBrand::embedUrl() from a fixed per-provider prefix and an id that had to match
     `[A-Za-z0-9_-]{11}` or a run of digits — so it cannot carry a second URL, and this
     function must not start composing one from anything else on the page. */
  document.addEventListener('click', function (e) {
    var btn = e.target.closest && e.target.closest('[data-ob-play]');
    if (!btn) return;
    var box = btn.closest('[data-ob-video]');
    if (!box) return;

    var src = box.getAttribute('data-ob-src') || '';
    /* Our own origins, checked again at the point of use. Cheap, and it means a future
       edit that lets some other value into the attribute cannot turn this into an
       arbitrary-iframe injector. */
    if (!/^https:\/\/(www\.youtube-nocookie\.com|player\.vimeo\.com)\//.test(src)) return;

    var f = document.createElement('iframe');
    /* autoplay=1 because the press WAS the gesture — without it a visitor presses play
       and then has to press play again inside the provider's own player, which reads as
       the first press having failed. */
    f.src = src + (src.indexOf('?') === -1 ? '?' : '&') + 'autoplay=1&rel=0';
    f.title = box.getAttribute('data-ob-name') || 'Video';
    f.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; picture-in-picture; fullscreen');
    f.setAttribute('referrerpolicy', 'strict-origin-when-cross-origin');
    f.setAttribute('allowfullscreen', '');
    f.setAttribute('loading', 'lazy');

    btn.replaceWith(f);
    /* Focus follows the swap, or a keyboard visitor who pressed Enter is left with focus
       on an element that no longer exists and lands back at the top of the document. */
    try { f.focus({ preventScroll: true }); } catch (_) {}
  });
</script>
{% endblock %}
