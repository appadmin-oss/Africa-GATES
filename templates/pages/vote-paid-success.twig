{% extends 'layout/shell.twig' %}

{#
  ══════════════════════════════════════════════════════════════════════════════
  `/vote/paid/success` — AFTER A CONTRIBUTED VOTE · Phase 5 · VoteBallot.dc.html's done state
  ══════════════════════════════════════════════════════════════════════════════

  Rebuilt after the old page was destroyed (inventory: docs/handoff/inventory/
  pages--vote-paid-success.md). THREE states, because two was a lie: `confirmed` says the
  money arrived, `minted` says the votes landed, and the two come apart whenever a payment
  begun inside the voting window confirms after it closes — PaidVoteService::mint() refuses
  that on purpose.

    paid + minted      → the `vote` celebration (asked of Services\Celebration with
                         `confirmed` = minted, so an unminted order cannot reach it), and the
                         /vote hub's per-device tracker is marked.
    paid + NOT minted  → plainly: nothing was counted, a refund is owed, here is the
                         reference and the route to claim it. No celebration, no tracker.
    not confirmed      → the gateway has not landed yet — not a refund case, nothing was
                         charged that we know of.

  The message-of-support box posts to /api/vote-message with the REFERENCE, which is what
  authorises it (VoteMessageController::post). Plain form; vote.js enhances it.
#}

{% set colour_tier = '2' %}
{% set flow_page = true %}
{% set meta_robots = 'noindex, nofollow' %}
{% set app_bar = {variant: 'child', title: minted ? 'Votes confirmed'|trans : 'Payment'|trans, back: ballot_url} %}
{% set first = nominee_name ? nominee_name|split(' ')|first : '' %}

{% block head_styles %}<link rel="stylesheet" href="{{ asset('/assets/css/components/vote-pages.css') }}">{% endblock %}

{% block content %}
<div class="ps">
  {% if confirmed and minted %}
    {% include 'partials/celebration.twig' with {kind: 'vote', size: 'full', first: first,
        title: votes == 1 ? '1 vote added.'|trans : '%n% votes added.'|trans({'%n%': votes|number_format}),
        sub: first ? '%first% moved up the race. They are in the public tally now.'|trans({'%first%': first}) : 'They are in the public tally now.'|trans,
        context: {moment: 'vote_cast', confirmed: minted, edition: 'paid', subject: reference},
        primary: {label: first ? 'Share %first%’s voting link'|trans({'%first%': first}) : 'Share the voting link'|trans},
        secondary: {label: 'Back to the ballot'|trans, href: ballot_url}} only %}

    {% if programme_id and category_id %}
      <span hidden data-vote-mark data-award="{{ programme_id }}" data-category="{{ category_id }}" data-nominee="{{ nominee_id }}"
            data-name="{{ nominee_name }}" data-url="{{ ballot_url }}" data-category-title="{{ category_title }}"></span>
    {% endif %}

    <dl class="ps-facts">
      <div><dt>{{ 'Votes'|trans }}</dt><dd>{{ votes|number_format }}</dd></div>
      <div><dt>{{ 'Contribution'|trans }}</dt><dd>₦{{ amount_naira|number_format }}</dd></div>
      {% if nominee_name %}<div><dt>{{ 'For'|trans }}</dt><dd>{{ nominee_name }}</dd></div>{% endif %}
      <div><dt>{{ 'Reference'|trans }}</dt><dd class="ps-ref">{{ reference }}</dd></div>
    </dl>
    <p class="ps-p">{{ 'A receipt is on its way to your email. The judges are %j%% of every result and never see a vote count or who paid for what.'|trans({'%j%': judge_pct}) }}
      <a href="/vote/verify?ref={{ reference|url_encode }}">{{ 'See exactly where your votes went'|trans }}</a></p>

    {% if msg_posted %}
      <p class="ps-p ps-done">{{ 'Your message is with the moderators and appears on %n%’s page once it is approved.'|trans({'%n%': first ?: 'their'|trans}) }}</p>
    {% else %}
      <form class="ps-msg" data-ps-msg data-sent="{{ 'Thanks — your message appears once a moderator has read it.'|trans }}" data-failed="{{ 'That did not send. Try again in a moment.'|trans }}">
        <h2 class="ps-h2">{{ 'Say something about %n%'|trans({'%n%': first ?: 'them'|trans}) }}</h2>
        <input type="hidden" name="ref" value="{{ reference }}">
        <label class="ag-sr" for="psBody">{{ 'Your message'|trans }}</label>
        <textarea class="ps-msg__t" id="psBody" name="body" rows="3" maxlength="{{ msg_max }}" placeholder="{{ 'Why you backed them, in a sentence'|trans }}"></textarea>
        <p class="ps-msg__h">{{ 'Up to %n% characters. A moderator reads it before it appears.'|trans({'%n%': msg_max}) }}</p>
        <button type="submit" class="ag-btn ag-btn--secondary ag-btn--pill">{{ 'Post my message'|trans }}</button>
        <p class="ps-msg__s" data-ps-say role="status"></p>
      </form>
    {% endif %}

  {% elseif confirmed %}
    <section class="ps-card ps-card--owed" aria-labelledby="ps-h">
      <h1 class="ps-h1" id="ps-h">{{ 'Your payment arrived, but no votes were counted'|trans }}</h1>
      <p class="ps-p">{{ 'Voting had closed by the time the payment was confirmed, so the votes were not added — a closed tally is never changed. You are owed a full refund of ₦%a%.'|trans({'%a%': amount_naira|number_format}) }}</p>
      <dl class="ps-facts">
        <div><dt>{{ 'Reference'|trans }}</dt><dd class="ps-ref">{{ reference }}</dd></div>
        <div><dt>{{ 'Votes counted'|trans }}</dt><dd>0</dd></div>
      </dl>
      <p class="ps-p">{{ 'Keep this reference: it is what the refund is claimed with.'|trans }}</p>
      <div class="ps-acts">
        <a class="ag-btn ag-btn--primary ag-btn--pill" href="/help?gee=support&amp;ref={{ reference|url_encode }}&amp;ask=1">{{ 'Claim the refund'|trans }}</a>
        <a class="ag-btn ag-btn--secondary ag-btn--pill" href="/vote/verify?ref={{ reference|url_encode }}">{{ 'See the record'|trans }}</a>
      </div>
    </section>

  {% else %}
    <section class="ps-card" aria-labelledby="ps-h">
      <h1 class="ps-h1" id="ps-h">{{ 'Waiting for the payment to confirm'|trans }}</h1>
      <p class="ps-p">{{ 'We have not had confirmation from the payment provider yet. That usually takes a minute; nothing has been counted until it arrives, and nothing has been charged that we know of.'|trans }}</p>
      {% if reference %}<dl class="ps-facts"><div><dt>{{ 'Reference'|trans }}</dt><dd class="ps-ref">{{ reference }}</dd></div></dl>{% endif %}
      <div class="ps-acts">
        {% if reference %}<a class="ag-btn ag-btn--primary ag-btn--pill" href="/vote/paid/success?ref={{ reference|url_encode }}">{{ 'Check again'|trans }}</a>
        <a class="ag-btn ag-btn--secondary ag-btn--pill" href="/vote/verify?ref={{ reference|url_encode }}">{{ 'See the record'|trans }}</a>{% endif %}
        <a class="ag-btn ag-btn--secondary ag-btn--pill" href="{{ ballot_url }}">{{ 'Back to the ballot'|trans }}</a>
      </div>
    </section>
  {% endif %}
</div>
{% endblock %}

{% block foot_scripts %}<script defer src="{{ asset('/assets/js/vote.js') }}"></script>{% endblock %}
