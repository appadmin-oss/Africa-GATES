{% extends "layout/gates.twig" %}

{#
  THE LIST OF AWARDS THIS PLATFORM HAS DECIDED.

  Deliberately a ledger and not a trophy case. Every row carries the winner's index and
  the split that produced it, because a list of names is an announcement and a list of
  decomposable numbers is a record. The one gold accent is reserved for the index itself.
#}

{% block head_styles %}
<style nonce="{{ csp_nonce }}">
  body[data-page="results"]{ background:#f0f2f2; color:var(--ag-ink); }

  .rx{ max-width:1080px; margin:0 auto; padding:clamp(2rem,5vw,2.8rem) var(--ag-gutter,32px) clamp(3rem,6vw,4.5rem); }

  .rx-head{ max-width:44rem; }
  .rx-eyebrow{ margin:0 0 10px; font:600 var(--ag-fs-label) / 1 var(--ag-font-mono);
               letter-spacing:var(--ag-tracking-label); text-transform:uppercase; color:var(--ag-green); }
  .rx-head h1{ margin:0; font-family:var(--ag-font-display); font-weight:700;
               font-size:clamp(2rem,4.6vw,2.7rem); letter-spacing:-.02em; }
  .rx-head p{ margin:14px 0 0; font-size:15.5px; line-height:1.62; color:#4a5256; max-width:62ch; }

  .rx-rule{ height:1px; background:var(--ag-line-strong); margin:clamp(1.6rem,4vw,2.2rem) 0 0; }

  /* ── an edition ── */
  .rx-ed{ margin-top:clamp(2rem,5vw,2.9rem); }
  .rx-ed__h{ display:flex; align-items:flex-end; justify-content:space-between; gap:16px 24px;
             flex-wrap:wrap; padding-bottom:12px; border-bottom:2px solid var(--ag-ink); }
  .rx-ed__kick{ margin:0 0 6px; font:600 11px/1.4 var(--ag-font-mono); letter-spacing:.12em;
                text-transform:uppercase; color:var(--ag-ink-soft); }
  .rx-ed__t{ margin:0; font-family:var(--ag-font-display); font-weight:700;
             font-size:clamp(1.5rem,3.4vw,2rem); letter-spacing:-.02em; line-height:1.1; }
  .rx-ed__t a{ color:inherit; text-decoration:none; border-bottom:2px solid transparent; }
  .rx-ed__t a:hover{ border-color:var(--ag-green); }
  .rx-ed__t a:focus-visible{ outline:3px solid var(--ag-green); outline-offset:3px; }
  .rx-ed__n{ margin:0; font:600 11.5px/1.4 var(--ag-font-mono); letter-spacing:.06em;
             text-transform:uppercase; color:var(--ag-ink-soft); white-space:nowrap; }
  .rx-ed__n a{ color:inherit; text-decoration:none; }
  .rx-ed__n a:hover{ color:var(--ag-green); }
  .rx-ed__held{ margin:16px 0 0; font-size:14.5px; line-height:1.65; color:#4a5256; }

  .rx-list{ list-style:none; margin:0; padding:0; }
  .rx-item{ border-bottom:1px solid var(--ag-line); }
  .rx-a{ display:grid; grid-template-columns:minmax(0,1fr) auto; gap:8px 20px; align-items:center;
         padding:20px 4px; text-decoration:none; color:inherit; transition:background var(--ag-dur-fast) var(--ag-ease); }
  .rx-a:hover{ background:rgba(16,41,44,.03); }
  .rx-a:focus-visible{ outline:2px solid var(--ag-green); outline-offset:2px; }

  .rx-meta{ font:600 11px/1.4 var(--ag-font-mono); letter-spacing:.1em; text-transform:uppercase;
            color:var(--ag-ink-soft); margin:0 0 6px; }
  .rx-cat{ margin:0; font-family:var(--ag-font-display); font-weight:700; font-size:1.22rem;
           letter-spacing:-.01em; line-height:1.25; }
  .rx-won{ margin:6px 0 0; font-size:14.5px; color:#4a5256; }
  .rx-won b{ color:var(--ag-ink); font-weight:600; }

  .rx-score{ text-align:right; }
  .rx-cpi{ font:700 1.7rem/1 var(--ag-font-mono); color:var(--ag-ink); font-variant-numeric:tabular-nums; }
  .rx-cpi span{ font-size:.72rem; color:var(--ag-ink-soft); font-weight:600; }
  .rx-split{ margin:5px 0 0; font:600 10.5px/1 var(--ag-font-mono); letter-spacing:.07em;
             text-transform:uppercase; color:var(--ag-ink-soft); font-variant-numeric:tabular-nums; }
  .rx-split i{ font-style:normal; color:var(--ag-green); }

  .rx-held{ margin:26px 0 0; padding:16px 18px; border-left:3px solid var(--ag-gold);
            background:rgba(201,162,75,.07); font-size:14px; line-height:1.6; color:#4a5256; }

  /* A result that is LATE, not withheld — a different piece of news from .rx-held, and
     above the list rather than under it, because somebody who came for this cycle must not
     have to read past last year's awards to find out why theirs is not here. */
  .rx-late{ margin:0 0 26px; padding:18px 20px; border:1px solid var(--ag-line-strong);
            border-left:3px solid var(--ag-pulse); border-radius:var(--ag-r-lg);
            background:var(--ag-surface); }
  .rx-late h2{ margin:0 0 .4rem; font-family:var(--ag-font-display); font-weight:700;
               font-size:1.15rem; color:var(--ag-ink); }
  .rx-late p{ margin:.5rem 0 0; font-size:14px; line-height:1.65; color:#4a5256; max-width:64ch; }
  .rx-late__meta{ margin:0; font:600 10.5px/1.4 var(--ag-font-mono); letter-spacing:.07em;
                  text-transform:uppercase; color:var(--ag-ink-soft); }
  /* The operator's own words, set apart from the platform's — a reader is entitled to know
     which sentences a person wrote and which the site derived. */
  .rx-late__note{ margin:.7rem 0 0; padding:.7rem .9rem; border-radius:var(--ag-r-sm,8px);
                  background:rgba(16,41,44,.04); font-size:14px; line-height:1.62;
                  color:var(--ag-ink); white-space:pre-line; }

  .rx-empty{ margin-top:30px; padding:clamp(2rem,5vw,3rem) 1.5rem; text-align:center;
             border:1px solid var(--ag-line-strong); border-radius:var(--ag-r-lg); background:var(--ag-surface); }
  .rx-empty h2{ margin:0 0 .5rem; font-family:var(--ag-font-display); font-weight:700; font-size:1.4rem; }
  .rx-empty p{ margin:0 auto 1.4rem; max-width:44ch; color:#4a5256; line-height:1.62; }
  .rx-btn{ display:inline-flex; align-items:center; gap:.5rem; min-height:44px; padding:0 24px;
           border-radius:var(--ag-r-pill); background:var(--ag-green); color:#fff; font-weight:600;
           font-size:14.5px; text-decoration:none; box-shadow:var(--ag-shadow-cta); }
  .rx-btn:hover{ background:var(--ag-green-dark); }

  @media (max-width:560px){
    .rx-a{ grid-template-columns:minmax(0,1fr); }
    .rx-score{ text-align:left; }
    .rx-cpi{ font-size:1.4rem; }
  }
</style>
{% endblock %}

{% block content %}
{# The outer guard is "is there a published award ANYWHERE", not "is there an edition":
   a released edition whose every award is withheld produces an edition block with no
   rows, and gating on that would replace "No award has been decided yet" — the honest
   headline when nothing is published — with a heading over an apology. #}
{% set rows = items|default([]) %}

<div class="rx">
  <header class="rx-head">
    <p class="rx-eyebrow">The record</p>
    <h1>Results</h1>
    <p>Every award this platform has decided, edition by edition. A Cultural Power Index
       runs from 0 to 1000 and always splits two ways — the support a community gave, and
       the marks a panel awarded. Open any award for the full standing, and the working
       behind it.</p>
  </header>

  <div class="rx-rule"></div>

  {#
    ── A RESULT THAT IS LATE, SAID BEFORE THE LIST AND NOT AFTER IT ──────────

    A results date is a promise made in public. This page used to serve the current
    standing once that date passed, whether or not the cycle had been announced — a named
    winner nobody had crowned, from a panel still open, unsealed. Gating that off leaves
    the other failure: the page a nominee's family refreshes on the day would go from a
    wrong answer to NO answer, which reads as the result being hidden.

    So the fact is stated. Above the list, because somebody who came for this cycle must
    not have to read past three years of other people's awards to find out why theirs is
    not here — and `.rx-held` below is a different piece of news (decided, not published)
    that would be actively misleading if the two were merged.

    Derived, so nobody has to remember to take it down: it appears when a release slips
    and disappears when the cycle is announced, which is the same moment the real result
    replaces it.
  #}
  {% for d in delayed|default([]) %}
    <div class="rx-late">
      <p class="rx-late__meta">{{ d.programme }}{% if d.edition %} &middot; {{ d.edition }}{% endif %}</p>
      <h2>{% if d.awards == 1 %}This award has not been decided yet{% else %}These results have not been decided yet{% endif %}</h2>
      {#
        The promised date is NAMED. It is the thing a reader is holding this platform to,
        and a delay notice that will not repeat the date it broke is asking to be trusted
        twice.
      #}
      <p>Results for {{ d.edition ?: d.programme }} were expected on
        <strong>{{ d.promised|date('j F Y') }}</strong> and are late.
        {% if d.awards > 1 %}{{ d.awards }} awards are waiting.{% endif %}
        Nothing is published here until every part of the index can be shown and the
        standing has been sealed &mdash; a figure that could still move is not a result,
        and we would rather be late than announce one twice.</p>
      {#
        The operator's own words, where somebody has written them. Escaped like every
        other operator string on a public page, and `white-space:pre-line` so a
        paragraph they typed stays a paragraph. Absent, the page says what it knows and
        does not invent a reason or a new date: a made-up date is a second broken
        promise, and the first one is why anybody is reading this.
      #}
      {% if d.note %}
        <p class="rx-late__note">{{ d.note }}</p>
      {% endif %}
    </div>
  {% endfor %}

  {% if rows %}
    {#
      ── AN EDITION AT A TIME ────────────────────────────────────────────────

      This was one flat list of categories, newest first, with the programme and year
      repeated on every row. Two things were wrong with that. An award programme is the
      thing people come here for — "the 2026 Principal Awards", not "Teachers' Choice" —
      and its eleven categories were scattered down a page interleaved with three other
      programmes, so the one question a reader actually has (who won this edition?) could
      only be answered by reading every row and sorting them in their head.

      And the list was capped at sixty CATEGORIES, so the cut landed wherever the
      sixtieth happened to be: an edition could appear with seven of its eleven awards
      and nothing saying four were missing. {@see PublicResults::index} caps editions
      now, and each one arrives whole.
    #}
    {% for e in editions|default([]) %}
      <section class="rx-ed" aria-labelledby="ed-{{ e.cycle_id }}">
        <header class="rx-ed__h">
          <div>
            <p class="rx-ed__kick">{{ e.programme }}</p>
            {# The heading IS the link to the edition's own page. An edition is the thing
               people name — "the 2026 Principal Awards" — and until it had a page there
               was nowhere for that name to point. #}
            <h2 class="rx-ed__t" id="ed-{{ e.cycle_id }}">
              <a href="{{ e.url }}">{{ e.edition ?: e.year }}</a>
            </h2>
          </div>
          <p class="rx-ed__n">
            <a href="{{ e.url }}">{{ e.awards|length }} award{{ e.awards|length == 1 ? '' : 's' }}
            {%- if e.held %} · {{ e.held }} withheld{% endif %} &rarr;</a>
          </p>
        </header>

        {% if e.awards|length %}
        <ul class="rx-list">
          {% for c in e.awards %}
            <li class="rx-item">
              <a class="rx-a" href="{{ c.url }}">
                <div>
                  {# The programme and year are the heading above, so the row carries the
                     category alone. Repeating them on every line is what made the old
                     list unreadable at eleven awards. #}
                  <h3 class="rx-cat">{{ c.category.title }}</h3>
                  <p class="rx-won"><b>{{ c.winner.name }}</b>{% if c.dead_heat %} — dead heat, separated by nominee id{% endif %}</p>
                </div>
                <div class="rx-score">
                  <div class="rx-cpi">{{ c.winner.cpi }}<span> / 1000</span></div>
                  {# The split, and nothing more. The arithmetic behind it is on the award's
                     own page, one click away — a list of sixty decompositions is a
                     spreadsheet, and nobody checks a spreadsheet they did not ask for. #}
                  <p class="rx-split"><i>{{ c.winner.community_points }} community</i> · {{ c.winner.judge_points }} judges</p>
                </div>
              </a>
            </li>
          {% endfor %}
        </ul>
        {% else %}
          {# Named, not dropped. A released edition that disappears reads as one that
             never happened. #}
          <p class="rx-ed__held">Every award in this edition is decided and not yet
            published — see the note at the foot of this page.</p>
        {% endif %}
      </section>
    {% endfor %}
  {% else %}
    <div class="rx-empty">
      <h2>No award has been decided yet</h2>
      <p>Results appear here the moment a cycle closes and its panel has finished. Nothing
         is published before the arithmetic can be shown in full.</p>
      <a href="/awards" class="rx-btn">See the awards running now</a>
    </div>
  {% endif %}

  {#
    A withheld result is SAID, not hidden. A category that vanishes from this list reads as
    a category that never existed; one that is named as being verified is a promise somebody
    can hold this platform to.
  #}
  {% if held > 0 %}
    <p class="rx-held">{{ held }} further {{ held == 1 ? 'award is' : 'awards are' }} decided but
      not published: {{ held == 1 ? 'its' : 'their' }} community half has not been counted into
      the index yet, or no nominee met the judging quorum. Nothing is announced until the
      whole index can be shown.</p>
  {% endif %}
</div>
{% endblock %}
