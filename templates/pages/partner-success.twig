{% extends 'layout/shell.twig' %}
{#
  /partner/success — "enquiry received". No DC (GAPS §5.1); rebuilt on the shell with the
  receipts after the 3 Oct destroy, because the partnership form redirects here and an
  organisation that had just written to us was shown a 500.

  It promises only what a person on our side does: read it and reply. No reply window is
  stated — the old page typed "within two working days" with nothing behind it, and a
  number a screen prints as a promise needs a resolver (CLAUDE.md, review_sla_hours).
  Tier 2 although it asks nothing: it links the receipts' one sheet, whose verdicts spend
  green and live, and ColourBudgetTest reads the sheet a page links, not the rules it uses.
#}
{% set colour_tier = '2' %}
{% set app_bar = {variant: 'child', share: false, title: 'Enquiry received'|trans, back: '/'} %}

{% block head_styles %}
  <link rel="stylesheet" href="{{ asset('/assets/css/components/receipt.css') }}">
  <meta name="robots" content="noindex, nofollow">
{% endblock %}

{% block content %}
<div class="rc">
  <section class="rc__card" aria-labelledby="rcH">
    <p class="rc__kicker">{{ 'Enquiry received'|trans }}</p>
    <h1 class="rc__h1" id="rcH">{{ 'Thanks — we’ll be in touch'|trans }}</h1>
    <p class="rc__p">{{ 'We have your partnership enquiry. A member of the partnerships team reads every one and will reply to the email address you shared.'|trans }}</p>
    <div class="rc__do">
      <a class="ag-btn ag-btn--primary" href="/awards">{{ 'See the awards'|trans }}</a>
      <a class="ag-btn ag-btn--secondary" href="/">{{ 'Back home'|trans }}</a>
    </div>
  </section>
</div>
{% endblock %}
