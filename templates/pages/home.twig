{% extends 'layout/shell.twig' %}

{#
  ══════════════════════════════════════════════════════════════════════════════
  `/` — THE HOMEPAGE · Home V7 · HomePageV7.dc.html (handoff 21 Oct 2026, from V6)
  ══════════════════════════════════════════════════════════════════════════════

  V7 is V6 with the wallet's feel — soft green, white cards, icon tiles — and the site's
  colour reference. Every block still follows the low-data rules, and rule 3 (never
  fabricate) beats the DC wherever they disagree:

    1 Hero ............ rotating recognitions: real decided awards (2+ rotate, 1 is static);
                        none selects one owner-supplied photograph daily, naming nobody
    2 Quick actions ... REMOVED by the owner (22 Oct 2026) after seeing it built
    3 Honours counter . people honoured, from Recognitions::peopleCount(); a NUMBER only
                        from 1,000 — below that the DC's own headline stands in
    4 Who to honour ... six categories; a matching utility replaces a photograph already used in the hero
    5 How it works .... static, green number tiles
    6 Wall ............ NOT DRAWN: it needs approved quotes with consent (under 3: hide)
    7 Featured ........ the open challenge (light gold: the one honour field), then three
                        evergreen topics on green wash — never curated topics nobody made
    8 Join band ....... signed-out visitors only
    9 Giving .......... one campaign past ≥10% raised and ≥10 gifts, not funded, not closing
   10 Recognise ....... four audience cards (utility graphic, label, arrow)
   11 We Are Africa ... full bleed (partials/we-are-africa.twig)
   12 Closing band .... green wash, with three unused real portraits or a utility graphic

  Colour tier 2 (transactional: it asks to nominate, join and give).
#}

{% set colour_tier = '2' %}
{% set app_bar = {variant: 'root', title: 'Africa GATES', brand: true} %}

{% block head_styles %}
  <link rel="stylesheet" href="{{ asset('/assets/css/components/home.css') }}">
  <link rel="stylesheet" href="{{ asset('/assets/css/components/photo.css') }}">
{% endblock %}

{% block content %}
<div class="hm">

  {# ── 1 · Hero ───────────────────────────────────────────────────────────── #}
  <section class="hm-hero" aria-labelledby="hm-h1" data-hm-hero{% if hero_slides|length > 1 %} data-hm-rotate{% endif %}>
    <div class="hm-hero__text">
      <h1 class="hm-hero__h1" id="hm-h1">{{ 'Where Africa recognises its people'|trans }}</h1>
      <p class="hm-hero__lead">{{ 'Honour the people who make a difference, verified and kept on the record.'|trans }}</p>
      <div class="hm-hero__ctas">
        <a class="hm-cta hm-cta--go" href="/nominate">{{ 'Nominate someone'|trans }}</a>
        <a class="hm-cta hm-cta--line" href="#hm-host">{{ 'Recognise with Africa GATES'|trans }}</a>
      </div>
    </div>
    <div class="hm-hero__media" id="hm-slides" role="group" aria-label="{{ 'Featured recognitions'|trans }}">
      {% for sl in hero_slides %}
        <div class="hm-slide{{ loop.first ? ' is-on' }}" data-hm-slide role="group" aria-label="{{ 'Slide %n% of %total%'|trans({'%n%': loop.index, '%total%': hero_slides|length}) }}"{% if not loop.first %} aria-hidden="true" hidden{% endif %}>
          <div class="hm-slide__img">
            {% include 'partials/selected-image.twig' with {image: sl.image, class: 'hm-slide__photo', sizes: '(min-width: 1024px) 560px, 100vw', eager: loop.first} only %}
          </div>
        </div>
      {% endfor %}
      {% if hero_slides|length > 1 %}
        <div class="hm-controls" data-hm-controls hidden>
        <div class="hm-dots" role="group" aria-label="{{ 'Recognitions'|trans }}">
          {% for sl in hero_slides %}
            <button type="button" class="hm-dots__b{{ loop.first ? ' is-on' }}" data-hm-dot="{{ loop.index0 }}" aria-label="{{ 'Show %name%'|trans({'%name%': sl.name}) }}"{{ loop.first ? ' aria-current="true"' }}><span aria-hidden="true"></span></button>
          {% endfor %}
        </div>
        <button class="hm-play" type="button" data-hm-pause aria-controls="hm-slides"
                data-hm-play="{{ 'Play slideshow'|trans }}" data-hm-stop="{{ 'Pause slideshow'|trans }}">{{ 'Pause slideshow'|trans }}</button>
        </div>
      {% endif %}
      <div class="hm-rec-box" aria-live="off">
        {% for sl in hero_slides %}
          <a class="hm-rec{{ loop.first ? ' is-on' }}" href="{{ sl.url }}" data-hm-card{% if not loop.first %} hidden{% endif %}>
            <span class="hm-rec__who">
              {% if sl.real %}<span class="hm-av hm-av--44" aria-hidden="true">{% include 'partials/photo.twig' with {kind: 'person', src: '', name: sl.name} only %}</span>{% endif %}
              <span class="hm-rec__t"><span class="hm-rec__n">{{ sl.name }}</span><span class="hm-rec__s">{{ sl.what }}</span></span>
            </span>
            <span class="hm-rec__by">
              <span class="hm-rec__tile" aria-hidden="true">{{ sl.issuer|first|upper }}</span>
              <span class="hm-rec__issuer">{{ sl.issuer }}</span>
              {% if sl.real %}<span class="hm-rec__chip">{{ 'Winner'|trans }}</span>{% endif %}
            </span>
          </a>
        {% endfor %}
      </div>
    </div>
  </section>

  {# ── 3 · Honours counter — a number only from 1,000 ─────────────────────── #}
  <section class="hm-ctr" aria-label="{{ 'Honours so far'|trans }}">
    <div class="hm-ctr__fig">
      {% if honoured >= 1000 %}
        <span class="hm-ctr__n" data-hm-count="{{ honoured }}">{{ honoured|number_format }}</span>
        <span class="hm-ctr__l">{{ 'people honoured on Africa GATES'|trans }}</span>
      {% else %}
        <span class="hm-ctr__h">{{ 'Every honour here is checked, then kept for good'|trans }}</span>
      {% endif %}
    </div>
    <div class="hm-ctr__side">
      <p class="hm-ctr__p">{{ 'Nominated by someone who knew them, verified, and open for anyone to check.'|trans }}</p>
      <a class="hm-cta hm-cta--go" href="/nominate">{{ 'Add the next name'|trans }}</a>
    </div>
  </section>

  {# ── 4 · Who do you want to honour? ─────────────────────────────────────── #}
  <section class="hm-sec" aria-labelledby="hm-honour">
    <div class="hm-head hm-head--row">
      <h2 class="hm-h2" id="hm-honour">{{ 'Who do you want to honour?'|trans }}</h2>
      <a class="hm-more hm-more--lg" href="/awards">{{ 'All categories'|trans }}</a>
    </div>
    <ul class="hm-honour" role="list">
      {% for t in honour %}
        <li><a class="hm-hon" href="/nominate?who={{ t.key }}">
          {% include 'partials/selected-image.twig' with {image: t.image, class: 'hm-hon__img', sizes: '(min-width: 1200px) 180px, (min-width: 600px) 200px, 46vw'} only %}
          <span class="hm-hon__row"><span class="hm-hon__l">{{ t.label|trans }}</span><span class="hm-hon__go" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 20 20" fill="none"><path d="M5 10h10M11 6l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span></span>
        </a></li>
      {% endfor %}
    </ul>
  </section>

  {# ── 5 · How it works ──────────────────────────────────────────────────── #}
  <section class="hm-sec" aria-labelledby="hm-how">
    <h2 class="hm-h2" id="hm-how">{{ 'Honouring someone takes five minutes'|trans }}</h2>
    <ol class="hm-how" role="list">
      <li class="hm-how__c"><span class="hm-how__n" aria-hidden="true">1</span><h3 class="hm-how__t">{{ 'Nominate'|trans }}</h3><p class="hm-how__d">{{ 'Pick an award and up to three categories, then say why.'|trans }}</p></li>
      <li class="hm-how__c"><span class="hm-how__n" aria-hidden="true">2</span><h3 class="hm-how__t">{{ 'Your community votes'|trans }}</h3><p class="hm-how__d">{{ 'Friends, family and old students vote. Judges score finalists after voting closes.'|trans }}</p></li>
      <li class="hm-how__c"><span class="hm-how__n" aria-hidden="true">3</span><h3 class="hm-how__t">{{ 'It stays on their record'|trans }}</h3><p class="hm-how__d">{{ 'Winners get a verified honour on their profile, for good.'|trans }}</p></li>
    </ol>
  </section>

  {# ── 7 · Featured: the open challenge, then three evergreen topics ─────── #}
  <section class="hm-sec" aria-labelledby="hm-feat">
    <h2 class="hm-vh" id="hm-feat">{{ 'Featured'|trans }}</h2>
    {% if challenge %}
    <a class="hm-feat" href="{{ challenge.url }}">
      <span class="hm-feat__media">
        {% if challenge.img %}<img src="{{ challenge.img }}" alt="" loading="lazy">{% else %}{% include 'partials/photo.twig' with {identity: challenge.id|default(null), kind: 'thing', subject: 'award', src: '', name: challenge.title} only %}{% endif %}
        <span class="hm-feat__tag">{{ 'Challenge'|trans }}</span>
      </span>
      <span class="hm-feat__body">
        <span class="hm-feat__t">{{ challenge.title }}</span>
        {% if challenge.body %}<span class="hm-feat__d">{{ challenge.body }}</span>{% endif %}
        <span class="hm-feat__go">{{ 'Join the challenge'|trans }} <span aria-hidden="true">→</span></span>
      </span>
    </a>
    {% endif %}
    <div class="hm-topics">
      {% for tp in topics %}
        <a class="hm-topic" href="{{ tp.href }}">
          <span class="hm-topic__field">
            {% include 'partials/selected-image.twig' with {image: tp.image, class: 'hm-topic__pic', sizes: '(min-width: 1024px) 240px, (min-width: 600px) 280px, 52vw', decorative: true} only %}
            <span class="hm-topic__tag">{{ tp.tag|trans }}</span>
          </span>
          <span class="hm-topic__body"><span class="hm-topic__t">{{ tp.title|trans }}</span><span class="hm-topic__d">{{ tp.description|trans }}</span></span>
        </a>
      {% endfor %}
    </div>
  </section>

  {# ── 8 · Join band — signed-out visitors only ───────────────────────────── #}
  {% if not is_member %}
  <section class="hm-join" aria-labelledby="hm-join-h">
    <div class="hm-join__text">
      <span class="hm-join__pill">{{ 'Free for everyone'|trans }}</span>
      <h2 class="hm-join__h" id="hm-join-h">{{ 'Join the people celebrating Africa'|trans }}</h2>
      <p class="hm-join__d">{{ 'One free account to nominate, vote, follow people and keep your honours.'|trans }}</p>
      <div class="hm-join__ctas">
        <a class="hm-cta hm-cta--white" href="/account/register">{{ 'Join free'|trans }}</a>
        <a class="hm-cta hm-cta--whiteline" href="/account/login">{{ 'Sign in'|trans }}</a>
      </div>
      <p class="hm-join__note">{{ 'Use your phone number or email. No password to remember.'|trans }}</p>
    </div>
    <ul class="hm-perks" role="list">
      {% for pk in [
        ['Nominate and vote', 'Back the people you believe in, in any open award.', 'M12 5v14M5 12h14'],
        ['Hear first', 'Get a message when an award opens near you.', 'M6 16V11a6 6 0 0 1 12 0v5l1.5 2h-15L6 16ZM10 20.5a2 2 0 0 0 4 0'],
        ['Follow people', 'See when someone you admire is honoured.', 'M5 12.5 10 17 19 7'],
        ['Keep your honours', 'One verified profile for every recognition you receive.', 'M12 3.5l2.6 5.3 5.9.9-4.2 4.1 1 5.8-5.3-2.8-5.3 2.8 1-5.8L3.5 9.7l5.9-.9L12 3.5Z']
      ] %}
        <li class="hm-perk">
          <span class="hm-perk__ic" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="{{ pk[2] }}" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          <span class="hm-perk__t">{{ pk[0]|trans }}</span>
          <span class="hm-perk__d">{{ pk[1]|trans }}</span>
        </li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  {# ── 9 · Giving — one campaign, past the low-data line (HomeFront::featurable) ────────────── #}
  {% if campaign %}
  <section class="hm-sec" aria-labelledby="hm-give">
    <div class="hm-head hm-head--row">
      <div class="hm-head">
        <span class="hm-eyebrow">{{ 'Giving'|trans }}</span>
        <h2 class="hm-h2" id="hm-give">{{ 'Back the programmes that grow Africa’s next leaders'|trans }}</h2>
      </div>
      <a class="hm-more hm-more--lg" href="/giving">{{ 'See all campaigns'|trans }}</a>
    </div>
    <a class="hm-give" href="{{ campaign.url }}">
      <span class="hm-give__media">
        {% if campaign.logo %}<img class="hm-give__logo" src="{{ campaign.logo }}" alt="{{ campaign.org }}">{% else %}{% include 'partials/photo.twig' with {kind: 'thing', subject: 'campaign', src: '', name: campaign.org} only %}{% endif %}
      </span>
      <span class="hm-give__body">
        <span class="hm-give__org">{{ campaign.org }}</span>
        <span class="hm-give__t">{{ campaign.title }}</span>
        <span class="hm-give__prog">
          {% if campaign.goal %}<span class="hm-give__bar"><span aria-hidden="true" style="--hm-pct:{{ campaign.pct }}%"></span><span class="hm-vh">{{ '%pct%% of the goal'|trans({'%pct%': campaign.pct}) }}</span></span>{% endif %}
          <span class="hm-give__sum"><strong>{{ campaign.raised }}</strong> <span>{{ campaign.goal ? 'raised of %goal%'|trans({'%goal%': campaign.goal}) : 'raised'|trans }}</span></span>
        </span>
        <span class="hm-cta hm-cta--give">{{ 'Give'|trans }}</span>
      </span>
    </a>
  </section>
  {% endif %}

  {# ── 10 · Recognise with Africa GATES — four audiences, only what exists today ── #}
  <section class="hm-sec" id="hm-host" aria-labelledby="hm-host-h" tabindex="-1">
    <div class="hm-head hm-head--row">
      <div class="hm-head">
        <span class="hm-eyebrow">{{ 'For organisations'|trans }}</span>
        <h2 class="hm-h2" id="hm-host-h">{{ 'Recognise with Africa GATES'|trans }}</h2>
      </div>
      <a class="hm-more hm-more--lg" href="/partner">{{ 'How it works for organisers'|trans }}</a>
    </div>
    <ul class="hm-who" role="list">
      {% for a in audiences %}
        <li><a class="hm-whoc" href="{{ a.href }}">
          {% include 'partials/selected-image.twig' with {image: a.image, class: 'hm-whoc__img', sizes: '(min-width: 1024px) 200px, (min-width: 600px) 240px, 52vw', decorative: true} only %}
          <span class="hm-whoc__bar"><span class="hm-whoc__t"><b>{{ a.title|trans }}</b><span>{{ a.cta|trans }}</span></span><span class="hm-whoc__go" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></span>
        </a></li>
      {% endfor %}
    </ul>
  </section>

  {# ── 11 · We Are Africa — full bleed ────────────────────────────────────── #}
  <div class="hm-bleed">{% include 'partials/we-are-africa.twig' with {countries: globe_countries, note: globe_note} only %}</div>

  {# ── 12 · Closing band ─────────────────────────────────────────────────── #}
  <section class="hm-close" aria-labelledby="hm-close-h">
    <div class="hm-close__text">
      <h2 class="hm-close__h" id="hm-close-h">{{ 'Someone you know deserves to be celebrated'|trans }}</h2>
      <p class="hm-close__d">{{ 'Tell their story. It takes five minutes.'|trans }}</p>
      <div class="hm-close__ctas">
        <a class="hm-cta hm-cta--go" href="/nominate">{{ 'Start a nomination'|trans }}</a>
        <a class="hm-cta hm-cta--line" href="/partner">{{ 'Run an award for your organisation'|trans }}</a>
      </div>
    </div>
    <div class="hm-close__pics" aria-hidden="true">
      {% if closing_pics %}
        {% for pc in closing_pics %}
          {% include 'partials/selected-image.twig' with {image: pc, class: 'hm-close__pic hm-close__pic--' ~ loop.index, decorative: true} only %}
        {% endfor %}
      {% else %}
        {% include 'partials/selected-image.twig' with {image: closing_art, class: 'hm-close__art', sizes: '(min-width: 1024px) 360px, 80vw', decorative: true} only %}
      {% endif %}
    </div>
  </section>

</div>
{% endblock %}

{% block foot_scripts %}
  <script defer src="{{ asset('/assets/js/we-are-africa.js') }}"></script>
  <script defer src="{{ asset('/assets/js/home.js') }}"></script>
{% endblock %}
