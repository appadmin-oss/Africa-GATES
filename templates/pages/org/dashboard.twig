{% extends "layout/gates.twig" %}

{# The partner organisation's own money.

   Everything here is scoped to the signed-in user's organisation by the controller —
   there is no organisation id anywhere in this template, and there must not be one, because
   an id a template can render is an id somebody can change.

   Donor names appear only where the donor ticked the box that publishes them; everyone else
   is "Anonymous". Email addresses never appear at all: there is no consent on file for
   handing a donor's contact details to a partner. #}

{% block head_styles %}
<style nonce="{{ csp_nonce }}">
  .pd{ max-width:960px; margin:0 auto; padding:30px 20px 90px; }
  .pd__head{ display:flex; align-items:flex-end; justify-content:space-between; gap:14px;
    flex-wrap:wrap; margin-bottom:6px; }
  .pd__head h1{ margin:0; font-family:var(--ag-font-display); font-weight:800;
    font-size:clamp(1.4rem,4vw,1.95rem); color:var(--ag-ink); }
  .pd__who{ font-size:13px; color:var(--ag-ink-soft,#626a6e); margin-top:3px; }
  .pd__out{ min-height:38px; padding:9px 16px; border-radius:999px; cursor:pointer;
    background:none; border:1px solid rgba(16,41,44,.18); font:600 13px/1 inherit;
    color:var(--ag-ink-soft,#626a6e); }

  .pd__flag{ border-radius:12px; padding:12px 15px; font-size:13.5px; line-height:1.65;
    margin:14px 0 0; font-weight:600; }
  .pd__flag--ok{ background:#effaf0; border:1px solid #bfe6bd; color:#1a6118; }
  .pd__flag--err{ background:#fdeaea; border:1px solid #f3c2c2; color:#b42318; }
  .pd__flag--warn{ background:#fffdf5; border:1px solid #ecd9a0; color:#6b5312; }

  .pd__grid{ display:grid; grid-template-columns:repeat(auto-fit,minmax(190px,1fr));
    gap:14px; margin-top:18px; }
  .pd__stat{ background:var(--ag-surface,#fff); border:1px solid rgba(16,41,44,.09);
    border-radius:16px; padding:16px 18px; }
  .pd__stat dt{ font-size:11.5px; font-weight:700; letter-spacing:.09em; text-transform:uppercase;
    color:var(--ag-ink-soft,#626a6e); margin:0; }
  .pd__stat dd{ margin:6px 0 0; font-family:var(--ag-font-mono,monospace); font-weight:700;
    font-size:1.35rem; color:var(--ag-ink); }
  .pd__stat small{ display:block; margin-top:4px; font-size:12px; font-weight:400;
    font-family:var(--ag-font-body); color:var(--ag-ink-soft,#626a6e); }

  .pd__card{ background:var(--ag-surface,#fff); border:1px solid rgba(16,41,44,.09);
    border-radius:18px; padding:20px 22px; margin-top:18px; }
  .pd__card h2{ margin:0 0 4px; font-size:1.05rem; font-family:var(--ag-font-display);
    font-weight:700; color:var(--ag-ink); }
  .pd__card p{ margin:6px 0 0; font-size:13.5px; line-height:1.7; color:var(--ag-ink-soft,#626a6e); }

  .pd__wrap{ overflow-x:auto; margin-top:12px; }
  .pd__t{ width:100%; border-collapse:collapse; font-size:13.5px; }
  .pd__t th{ text-align:left; font-size:11px; font-weight:700; letter-spacing:.08em;
    text-transform:uppercase; color:var(--ag-ink-soft,#626a6e); padding:0 12px 8px 0;
    border-bottom:1px solid rgba(16,41,44,.12); white-space:nowrap; }
  .pd__t td{ padding:10px 12px 10px 0; border-bottom:1px solid rgba(16,41,44,.06);
    color:var(--ag-ink); vertical-align:top; }
  .pd__num{ font-family:var(--ag-font-mono,monospace); white-space:nowrap; }
  .pd__empty{ font-size:13.5px; color:var(--ag-ink-soft,#626a6e); margin:12px 0 0; }

  /* Status is never colour alone — the word is the signal and the tint is decoration. */
  .pd__chip{ display:inline-block; font-size:11.5px; font-weight:700; padding:3px 9px;
    border-radius:999px; border:1px solid; white-space:nowrap; }
  .pd__chip--done{ background:#effaf0; border-color:#bfe6bd; color:#1a6118; }
  .pd__chip--open{ background:#fffdf5; border-color:#ecd9a0; color:#6b5312; }
  .pd__chip--dead{ background:#fdeaea; border-color:#f3c2c2; color:#b42318; }

  .pd__pay{ display:flex; gap:10px; align-items:flex-end; flex-wrap:wrap; margin-top:14px; }
  .pd__pay label{ flex:1 1 180px; }
  .pd__pay span{ display:block; font-size:12.5px; font-weight:600;
    color:var(--ag-ink-soft,#626a6e); margin-bottom:5px; }
  .pd__pay input{ width:100%; font:inherit; font-size:16px; color:var(--ag-ink);
    border:1px solid rgba(16,41,44,.18); border-radius:11px; padding:10px 13px; }
  .pd__pay button{ min-height:44px; padding:0 20px; border:none; border-radius:999px;
    background:var(--ag-green,#237b22); color:#fff; font:700 14px/1 inherit; cursor:pointer; }
  .pd__pay button:disabled{ opacity:.55; cursor:not-allowed; }
</style>
{% endblock %}

{% block content %}
{% set ngn = '₦' %}
<div class="pd">

  <div class="pd__head">
    <div>
      <h1>{{ org.name }}</h1>
      <div class="pd__who">
        Signed in as {{ me.email }}{% if me.role != 'owner' %} · view only{% endif %}
      </div>
    </div>
    <form method="post" action="/org/logout">
      <input type="hidden" name="_token" value="{{ csrf_token }}">
      <button class="pd__out" type="submit">Sign out</button>
    </form>
  </div>

  {% if flash_ok %}<div class="pd__flag pd__flag--ok" role="status">{{ flash_ok }}</div>{% endif %}
  {% if flash_error %}<div class="pd__flag pd__flag--err" role="alert">{{ flash_error }}</div>{% endif %}

  {# A suspended partner keeps its dashboard and loses its donate button. Said plainly at the
     top, because the alternative is a treasurer wondering why donations stopped. #}
  {% if org.status == 'suspended' %}
    <div class="pd__flag pd__flag--err" role="alert">
      This organisation is suspended, so it is not currently accepting donations.
      {% if org.suspended_reason %}Reason on file: {{ org.suspended_reason }}.{% endif %}
      Everything already given to you is unaffected.
    </div>
  {% elseif org.status == 'rejected' %}
    {# §10.10 of the vendor specification: an applicant is entitled to an outcome with a
       reason. Letting them sign in and read it is the cheapest honest way to deliver one —
       the alternative is a person who was told "unsuccessful" and left to invent why. #}
    <div class="pd__flag pd__flag--err" role="alert">
      This application was not accepted.
      {% if org.vetting_note %}Reason on file: {{ org.vetting_note }}.{% endif %}
      You are welcome to apply again to a future call.
    </div>
  {% elseif org.status != 'approved' %}
    <div class="pd__flag pd__flag--warn" role="status">
      {% if is_vendor %}
        Your account is not approved yet, so you cannot be offered a stand. Get your documents
        below on file — that is the part you control, and nothing moves until it is done.
      {% else %}
        Your organisation is not live yet, so your appeal page is not public.
        We will be in touch once the review is complete.
      {% endif %}
    </div>
  {% endif %}

  {# ── DOCUMENTS ──────────────────────────────────────────────────────────────
     A vendor files their own. The alternative — emailing them to an administrator — makes
     the eligibility check dishonest, because an application marked incomplete may just be
     one whose insurance certificate is sitting unread in an inbox.

     Shown to every kind of organisation, because a donation partner has required documents
     too and the list simply differs. #}
  {% if required is not empty %}
  <div class="pd__card">
    <h2>Your documents</h2>
    <p>
      {% if individual %}
        You are registered as an <strong>individual</strong>, so no CAC certificate is asked for.
      {% endif %}
      A document that has expired counts as missing — that is what the expiry date is for, and
      finding out on the morning of an event makes it everybody's problem.
    </p>

    <div class="pd__wrap">
      <table class="pd__t">
        <caption class="sr-only">Documents required and held</caption>
        <thead><tr>
          <th scope="col">Required</th><th scope="col">Status</th>
        </tr></thead>
        <tbody>
        {% for slug, label in required %}
          <tr>
            <td>{{ label }}</td>
            <td>
              {% if missing[slug] is defined %}
                <span class="pd__chip pd__chip--dead">Not on file</span>
              {% else %}
                <span class="pd__chip pd__chip--done">On file</span>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>

    {% if documents %}
      <div class="pd__wrap">
        <table class="pd__t">
          <caption class="sr-only">Documents you have uploaded</caption>
          <thead><tr>
            <th scope="col">Uploaded</th><th scope="col">Kind</th>
            <th scope="col">File</th><th scope="col">Expires</th>
          </tr></thead>
          <tbody>
          {% for d in documents %}
            <tr>
              <td class="pd__num">{{ d.created_at|slice(0,10) }}</td>
              <td>{{ doc_kinds[d.kind]|default(d.kind) }}</td>
              <td>{{ d.original_name }}</td>
              <td class="pd__num">
                {% if d.expires_on %}
                  {{ d.expires_on|slice(0,10) }}
                  {% if d.expires_on|slice(0,10) < "now"|date("Y-m-d") %}
                    <span class="pd__chip pd__chip--dead">Lapsed</span>
                  {% endif %}
                {% else %}—{% endif %}
              </td>
            </tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
    {% endif %}

    {% if can_payout and uploads_on %}
      <form method="post" action="/org/document" enctype="multipart/form-data" class="pd__pay">
        <input type="hidden" name="_token" value="{{ csrf_token }}">
        <label style="flex:1 1 190px">
          <span>What is it?</span>
          <select name="kind" style="width:100%;font:inherit;font-size:16px;padding:10px 13px;
                  border:1px solid rgba(16,41,44,.18);border-radius:11px;background:#fff">
            {% for slug, label in doc_kinds %}<option value="{{ slug }}">{{ label }}</option>{% endfor %}
          </select>
        </label>
        <label style="flex:1 1 190px">
          <span>File (PDF or photo)</span>
          <input type="file" name="document" accept=".pdf,image/*" required>
        </label>
        <label style="flex:1 1 150px">
          <span>Expires (if it does)</span>
          <input type="date" name="expires_on">
        </label>
        <button type="submit">Upload</button>
      </form>
    {% elseif not uploads_on %}
      <p>Uploads are unavailable on this server right now. Email your certificates and we will file them.</p>
    {% endif %}
  </div>
  {% endif %}

  {# ── STAND APPLICATIONS ─────────────────────────────────────────────────────
     The decision AND its reason are shown, including a rejection. §5.7: every applicant gets
     an outcome they can understand, and the difference between a disappointment and a story
     about favouritism is whether anybody ever told them which rule they fell on. #}
  {% if applications %}
  <div class="pd__card">
    <h2>Your stand applications</h2>
    <p>An offer is held for a limited time. If it runs out the place returns to the waiting
       list, because a place held by somebody who stopped replying is a place somebody else
       was promised.</p>

    <div class="pd__wrap">
      <table class="pd__t">
        <caption class="sr-only">Stand applications and their outcomes</caption>
        <thead><tr>
          <th scope="col">Event</th><th scope="col">Stand</th>
          <th scope="col">Applied</th><th scope="col">Outcome</th><th scope="col">&nbsp;</th>
        </tr></thead>
        <tbody>
        {% for a in applications %}
          <tr>
            <td>{{ a.event ? a.event.title : '—' }}</td>
            <td>{{ a.type ? a.type.name : '—' }}
              {% if a.type %}<div class="pd__num" style="font-size:12px;color:var(--ag-ink-soft,#626a6e)">
                {{ ngn }}{{ a.type.price_naira|number_format }}</div>{% endif %}</td>
            <td class="pd__num">{{ a.app.submitted_at|slice(0,10) }}
              {% if not a.app.completed_at %}
                <div style="font-size:12px;color:#b42318">Not complete</div>
              {% endif %}</td>
            <td>
              {% set c = {'accepted':'done','offered':'open','waitlisted':'open',
                          'rejected':'dead','declined':'dead','pending':'open'}[a.app.decision]|default('open') %}
              <span class="pd__chip pd__chip--{{ c }}">{{ decisions[a.app.decision]|default(a.app.decision) }}</span>
              {% if a.app.decision_reason %}
                <div style="margin-top:5px;font-size:12.5px;line-height:1.55;color:var(--ag-ink-soft,#626a6e)">
                  {{ a.app.decision_reason }}</div>
              {% endif %}
              {% if a.app.eligibility == 'fail' and a.app.eligibility_note %}
                <div style="margin-top:5px;font-size:12.5px;line-height:1.55;color:#b42318">
                  {{ a.app.eligibility_note }}</div>
              {% endif %}
            </td>
            <td>
              {% if a.live_offer %}
                {% if can_payout %}
                  <form method="post" action="/org/stand/{{ a.app.id }}/accept">
                    <input type="hidden" name="_token" value="{{ csrf_token }}">
                    <button type="submit" style="min-height:44px;padding:0 18px;border:none;
                            border-radius:999px;background:var(--ag-green,#237b22);color:#fff;
                            font:700 13.5px/1 inherit;cursor:pointer">Accept</button>
                  </form>
                  <div style="margin-top:5px;font-size:12px;color:var(--ag-ink-soft,#626a6e)">
                    By {{ a.app.offer_expires_at|slice(0,16) }}</div>
                {% else %}
                  <span style="font-size:12.5px;color:var(--ag-ink-soft,#626a6e)">
                    Only an account owner can accept</span>
                {% endif %}
              {% elseif a.expired %}
                <span style="font-size:12.5px;color:#b42318">This offer expired</span>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
  {% endif %}

  <dl class="pd__grid">
    <div class="pd__stat">
      <dt>Received</dt>
      <dd>{{ ngn }}{{ totals.gross|number_format }}</dd>
      <small>{{ totals.count }} confirmed gift{{ totals.count == 1 ? '' : 's' }}</small>
    </div>
    <div class="pd__stat">
      <dt>Africa GATES share</dt>
      <dd>{{ ngn }}{{ totals.platform_fee|number_format }}</dd>
      <small>{{ org.platform_fee_bps > 0 ? (org.platform_fee_bps / 100)|number_format(2) ~ '% of each gift' : 'We take nothing' }}</small>
    </div>
    <div class="pd__stat">
      <dt>Yours</dt>
      <dd>{{ ngn }}{{ totals.net|number_format }}</dd>
      <small>After our share</small>
    </div>
    <div class="pd__stat">
      <dt>Available</dt>
      <dd>{{ ngn }}{{ available|number_format }}</dd>
      <small>Not already requested</small>
    </div>
  </dl>

  {# ── WITHDRAWALS ────────────────────────────────────────────────────────────
     In settlement mode this platform is not holding the money and must not imply it is:
     donations split at the gateway into the organisation's own subaccount and Paystack
     settles them to the organisation's own bank. The request is a request. #}
  <div class="pd__card">
    <h2>Getting your money</h2>
    {% if payout_mode == 'settlement' %}
      <p>
        Donations to you settle <strong>directly into your own account</strong> — they are split
        at the payment gateway and never held by Africa GATES. Paystack releases them on your
        subaccount’s settlement schedule
        {%- if org.settlement_schedule == 'manual' %}, which is set to <strong>manual</strong>, so
        they wait until requested{% else %}, which is set to <strong>{{ org.settlement_schedule }}</strong>{% endif -%}.
      </p>
      {% if org.settlement_schedule == 'manual' %}
        <p>Use this to tell us to release the next settlement. You will see it here when it moves.</p>
      {% endif %}
    {% else %}
      <p>Request a payout to your settlement account
        {%- if org.account_last4 %} ending {{ org.account_last4 }}{% endif -%}.
        Transfers are not confirmed until the bank says so, which can take a little time
        after the status here changes.</p>
    {% endif %}

    {% if can_payout %}
      {% if available >= min_payout and org.status == 'approved' %}
        <form class="pd__pay" method="post" action="/org/payout">
          <input type="hidden" name="_token" value="{{ csrf_token }}">
          <label for="pdAmt">
            <span>Amount in naira (up to {{ ngn }}{{ available|number_format }})</span>
            <input id="pdAmt" name="amount" type="text" inputmode="numeric"
                   placeholder="{{ available }}" required>
          </label>
          <button type="submit">Request payout</button>
        </form>
      {% else %}
        <p class="pd__empty">
          {% if org.status != 'approved' %}Payouts are on hold while your organisation is not live.
          {% else %}The smallest payout is {{ ngn }}{{ min_payout|number_format }}. You have
          {{ ngn }}{{ available|number_format }} available.{% endif %}
        </p>
      {% endif %}
    {% else %}
      <p class="pd__empty">Only an account owner can request a payout.</p>
    {% endif %}

    {% if payouts %}
      <div class="pd__wrap">
        <table class="pd__t">
          <caption class="sr-only">Payout requests</caption>
          <thead><tr><th scope="col">Requested</th><th scope="col">Amount</th><th scope="col">Status</th><th scope="col">Reference</th></tr></thead>
          <tbody>
          {% for p in payouts %}
            {% set cls = p.status == 'success' ? 'done'
                       : (p.status in ['failed','reversed','abandoned','blocked','rejected'] ? 'dead' : 'open') %}
            <tr>
              <td class="pd__num">{{ p.requested_at|date('d M Y') }}</td>
              <td class="pd__num">{{ ngn }}{{ p.amount_naira|number_format }}</td>
              <td><span class="pd__chip pd__chip--{{ cls }}">{{ p.status|capitalize }}</span>
                {% if p.gateway_message %}<div class="pd__who">{{ p.gateway_message }}</div>{% endif %}</td>
              <td class="pd__num">{{ p.reference }}</td>
            </tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
    {% endif %}
  </div>

  {# ── APPEALS ────────────────────────────────────────────────────────────────
     An appeal is a public claim about what this organisation will do with money, so an
     owner writes it and Africa GATES publishes it. Editing a LIVE appeal's story or target
     sends it back for review, because a donor gave against the words that were on the
     page. #}
  <div class="pd__card">
    <h2>Appeals</h2>
    <p>Raise for something specific. Donations to an appeal are restricted to it — what you
       write here is what donors are giving for.</p>

    {% if campaigns %}
      <div class="pd__wrap">
        <table class="pd__t">
          <caption class="sr-only">Your appeals</caption>
          <thead><tr><th scope="col">Appeal</th><th scope="col">Raised</th><th scope="col">Status</th><th scope="col">&nbsp;</th></tr></thead>
          <tbody>
          {% for c in campaigns %}
            {% set st = c.row.status %}
            {% set cls = st == 'live' ? 'done' : (st == 'closed' ? 'dead' : 'open') %}
            <tr>
              <td>
                <strong>{{ c.row.title }}</strong>
                {% if c.open %}<div class="pd__who"><a href="/donate/{{ org.slug }}/{{ c.row.slug }}">/donate/{{ org.slug }}/{{ c.row.slug }}</a></div>{% endif %}
                {% if c.days is not null and c.open %}<div class="pd__who">{{ c.days }} day{{ c.days == 1 ? '' : 's' }} left</div>{% endif %}
              </td>
              <td class="pd__num">
                {{ ngn }}{{ c.progress.raised|number_format }}
                {%- if c.progress.target > 0 %} <span style="color:var(--ag-ink-soft,#626a6e)">of {{ ngn }}{{ c.progress.target|number_format }}</span>{% endif %}
                <div class="pd__who">{{ c.progress.count }} gift{{ c.progress.count == 1 ? '' : 's' }}</div>
              </td>
              <td>
                <span class="pd__chip pd__chip--{{ cls }}">{{ st|capitalize }}</span>
                {% if st == 'live' and not c.open %}<div class="pd__who">Outside its dates</div>{% endif %}
              </td>
              <td>
                {% if can_payout %}
                  {% if st in ['draft', 'closed'] %}
                    <form method="post" action="/org/appeal/{{ c.row.id }}/submit" style="display:inline">
                      <input type="hidden" name="_token" value="{{ csrf_token }}">
                      <button class="pd__out" type="submit">Send for review</button>
                    </form>
                  {% elseif st == 'live' %}
                    <form method="post" action="/org/appeal/{{ c.row.id }}/close" style="display:inline">
                      <input type="hidden" name="_token" value="{{ csrf_token }}">
                      <button class="pd__out" type="submit"
                              data-confirm="Close “{{ c.row.title }}”? It stops accepting donations immediately. Everything already given is unaffected.">Close</button>
                    </form>
                  {% endif %}
                {% endif %}
              </td>
            </tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
    {% else %}
      <p class="pd__empty">No appeals yet.</p>
    {% endif %}

    {% if can_payout %}
      <details style="margin-top:16px">
        <summary style="cursor:pointer;font-weight:600;font-size:13.5px;min-height:24px">Start a new appeal</summary>
        <form method="post" action="/org/appeal" style="margin-top:12px;display:grid;gap:12px">
          <input type="hidden" name="_token" value="{{ csrf_token }}">
          <label for="caTitle"><span>What are you raising for?</span>
            <input id="caTitle" name="title" type="text" maxlength="200" required></label>
          <label for="caSum"><span>One line a donor will read first</span>
            <input id="caSum" name="summary" type="text" maxlength="400"></label>
          <label for="caStory"><span>The full story</span>
            <textarea id="caStory" name="story" rows="5"
              style="width:100%;font:inherit;font-size:15px;border:1px solid rgba(16,41,44,.18);border-radius:11px;padding:11px 13px"></textarea></label>
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px">
            <label for="caTarget"><span>Target in naira (optional)</span>
              <input id="caTarget" name="target_naira" type="text" inputmode="numeric"></label>
            <label for="caClose"><span>Closing date (optional)</span>
              <input id="caClose" name="closes_on" type="date"></label>
          </div>
          <label for="caShort"><span>If you do not reach the target</span>
            <select id="caShort" name="shortfall_policy"
                    style="width:100%;font:inherit;font-size:16px;border:1px solid rgba(16,41,44,.18);border-radius:11px;padding:10px 13px">
              {% for k, label in shortfall %}<option value="{{ k }}">{{ label }}</option>{% endfor %}
            </select></label>
          <p class="pd__empty" style="margin:0">
            This is shown to donors <strong>before</strong> they give. Choose the one you will
            actually do.
          </p>
          <div><button class="pd__out" type="submit"
                       style="background:var(--ag-green,#237b22);color:#fff;border-color:transparent;min-height:44px;padding:0 20px;font-weight:700">
            Save as draft</button></div>
        </form>
      </details>
    {% endif %}
  </div>

  <div class="pd__card">
    <h2>Recent donations</h2>
    <p>Confirmed gifts only. Donors appear by name only where they chose to be named —
       we do not pass on donor email addresses.</p>

    {% if donations %}
      <div class="pd__wrap">
        <table class="pd__t">
          <caption class="sr-only">Confirmed donations to {{ org.name }}</caption>
          <thead>
            <tr>
              <th scope="col">When</th><th scope="col">Donor</th>
              <th scope="col">Gift</th><th scope="col">Our share</th><th scope="col">Yours</th>
            </tr>
          </thead>
          <tbody>
          {% for d in donations %}
            <tr>
              <td class="pd__num">{{ d.when|date('d M Y') }}</td>
              <td>{{ d.name }}</td>
              <td class="pd__num">{{ ngn }}{{ d.gross|number_format }}</td>
              <td class="pd__num">{{ ngn }}{{ d.fee|number_format }}</td>
              <td class="pd__num">{{ ngn }}{{ d.net|number_format }}</td>
            </tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
    {% else %}
      <p class="pd__empty">No confirmed donations yet. When somebody gives, it appears here.</p>
    {% endif %}
  </div>

</div>
{% endblock %}
