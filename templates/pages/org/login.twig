{% extends "layout/gates.twig" %}

{# Partner organisation sign-in. Deliberately plain: this screen's only job is to be
   unambiguous about which organisation's money is behind it. #}

{% block head_styles %}
<style nonce="{{ csp_nonce }}">
  .pl{ max-width:420px; margin:0 auto; padding:48px 20px 90px; }
  .pl h1{ margin:0 0 6px; font-family:var(--ag-font-display); font-weight:800;
    font-size:clamp(1.5rem,4vw,2rem); color:var(--ag-ink); }
  .pl__sub{ margin:0 0 22px; font-size:14px; line-height:1.65; color:var(--ag-ink-soft,#626a6e); }
  .pl__card{ background:var(--ag-surface,#fff); border:1px solid rgba(16,41,44,.1);
    border-radius:18px; padding:24px 22px; }
  .pl__f{ display:block; margin-bottom:14px; }
  .pl__f span{ display:block; font-size:12.5px; font-weight:600; color:var(--ag-ink-soft,#626a6e); margin-bottom:5px; }
  .pl__f input{ width:100%; font:inherit; font-size:16px; color:var(--ag-ink);
    border:1px solid rgba(16,41,44,.18); border-radius:11px; padding:11px 13px; background:#fff; }
  .pl__go{ width:100%; min-height:46px; cursor:pointer; border:none; border-radius:999px;
    background:var(--ag-green,#237b22); color:#fff; font:700 15px/1 inherit; }
  .pl__err{ background:#fdeaea; border:1px solid #f3c2c2; color:#b42318; border-radius:12px;
    padding:11px 13px; font-size:13.5px; margin-bottom:16px; font-weight:600; }
  .pl__note{ margin:18px 0 0; font-size:12.5px; line-height:1.7; color:var(--ag-ink-soft,#626a6e); }
</style>
{% endblock %}

{% block content %}
<div class="pl">
  <h1>Partner sign in</h1>
  <p class="pl__sub">For organisations collecting donations through Africa GATES.</p>

  <div class="pl__card">
    {# One message for every kind of failure. Telling an unknown address apart from a wrong
       password is an account-enumeration oracle. #}
    {% if error %}<div class="pl__err" role="alert">{{ error }}</div>{% endif %}

    <form method="post" action="/org/login">
      <input type="hidden" name="_token" value="{{ csrf_token }}">

      <label class="pl__f" for="plEmail">
        <span>Email address</span>
        <input id="plEmail" name="email" type="email" autocomplete="username" required>
      </label>

      <label class="pl__f" for="plPassword">
        <span>Password</span>
        <input id="plPassword" name="password" type="password" autocomplete="current-password" required>
      </label>

      <button class="pl__go" type="submit">Sign in</button>
    </form>

    <p class="pl__note">
      This login can see your organisation’s donations and request payouts. If you have lost
      access, contact Africa GATES — we will not send a password over email.
    </p>
  </div>
</div>
{% endblock %}
