{% extends "layout/gates.twig" %}

{#
  THE DOOR.

  EVERY TIME ON THIS PAGE IS PRE-FORMATTED BY THE CONTROLLER, in the EVENT's own zone.
  These were `|slice(11, 5)` over the stored string — and storage is UTC by this
  application's convention, so a gate closing at 23:00 in Lagos told its steward it
  closed at 22:00. Slicing a datetime is not formatting it; it is reading the storage
  convention out loud.

  Used one-handed, outdoors, at night, by somebody who has never seen it before, with a queue
  behind them. Three rules drive every choice here:

    1. The verdict is a WORD before it is a colour. Colour alone fails WCAG 1.4.1 and fails
       harder in sunlight and colour blindness, so ADMIT / ALREADY IN / REFUSE carry an icon
       and a word, and the colour is confirmation rather than information.
    2. The typed box is the door, not the fallback. BarcodeDetector does not exist on iOS
       Safari and a camera fails on a wet lens — so manual entry is always present and holds
       focus, and the camera is the addition.
    3. Nothing reloads. A page load per attendee IS the queue.
#}

{% block content %}
<canvas class="dr__conf" id="dr-conf" aria-hidden="true"></canvas>
<style nonce="{{ csp_nonce }}">
  .dr{ max-width:560px; margin:0 auto; padding:16px 14px 40px }
  .dr__head{ display:flex; align-items:baseline; justify-content:space-between; gap:10px;
    flex-wrap:wrap; margin-bottom:14px }
  .dr__ev{ font-size:16px; font-weight:700; color:#10292C; margin:0 }
  .dr__gate{ font-size:12.5px; color:#5a6d6f }
  .dr__count{ font-variant-numeric:tabular-nums; font-size:12.5px; color:#5a6d6f }

  /* ── THE VERDICT ────────────────────────────────────────────────────────────
     min-height so the panel does not jump between states — a layout shift at a
     door is a mis-read. clamp() so it is large on a phone held at arm's length. */
  .dr__v{ min-height:168px; display:flex; flex-direction:column; align-items:center;
    justify-content:center; text-align:center; gap:6px; border-radius:14px; padding:20px 16px;
    border:2px solid #d9e2e0; background:#f3f6f5; color:#3d5457 }
  .dr__v b{ font-size:clamp(26px, 8vw, 40px); line-height:1.05; letter-spacing:-0.01em }
  .dr__v .dr__who{ font-size:17px; font-weight:600 }
  .dr__v .dr__sub{ font-size:13.5px; opacity:.85; max-width:34ch }
  .dr__mark{ font-size:34px; line-height:1 }

  .dr__v--admit{ background:#eaf7ec; border-color:#237b22; color:#14531a }
  .dr__v--dup  { background:#fff4e5; border-color:#b4671a; color:#7a3f0b }
  .dr__v--refuse{ background:#fdeceb; border-color:#a32b1f; color:#7d1d14 }
  .dr__v--closed{ background:#fdeceb; border-color:#a32b1f; color:#7d1d14 }

  .dr__form{ margin-top:14px; display:flex; gap:8px }
  /* 16px minimum, or iOS zooms the whole page on focus and the operator loses the queue. */
  /* #849693 is 3.1:1 on white; the #cfdad8 all three of these carried was 1.43:1.
     WCAG 1.4.11 asks 3:1 of the visual information needed to IDENTIFY a control, and for
     a text box the border is the whole of that — there is no label inside it to fall back
     on. It matters here more than on most screens: this box IS the door, and it is looked
     for outdoors, at night, on a phone turned down to save battery. */
  .dr__form input{ flex:1; min-width:0; font-size:19px; font-family:ui-monospace,monospace;
    letter-spacing:.06em; text-transform:uppercase; padding:14px 12px; min-height:52px;
    border:2px solid #849693; border-radius:10px; background:#fff; color:#10292C }
  .dr__form input:focus{ outline:3px solid #237b22; outline-offset:1px; border-color:#237b22 }
  /* 52px: comfortably past the 44×44 touch recommendation, one-handed, in the dark. */
  .dr__form button{ min-height:52px; min-width:88px; padding:0 18px; font-size:16px;
    font-weight:700; border:0; border-radius:10px; background:#10292C; color:#fff; cursor:pointer }
  .dr__form button:disabled{ opacity:.55; cursor:default }

  .dr__cam{ margin-top:10px }
  .dr__cam button{ width:100%; min-height:48px; font-size:15px; font-weight:600;
    border:2px solid #849693; border-radius:10px; background:#fff; color:#10292C; cursor:pointer }
  .dr__video{ width:100%; margin-top:10px; border-radius:12px; background:#000; display:none }
  .dr__video.on{ display:block }

  /* 48px and full width: pressed one-handed, in the dark, by somebody who has just
     realised they admitted the wrong person. Deliberately NOT red until it is armed —
     an alarm-coloured control sitting under every successful scan reads as an error. */
  .dr__undo{ margin-top:10px }
  .dr__undo__b{ width:100%; min-height:48px; font-size:15px; font-weight:600; cursor:pointer;
    border:2px solid #849693; border-radius:10px; background:#fff; color:#5a6d6f }
  .dr__undo__b.is-armed{ border-color:#a32b1f; color:#7d1d14; background:#fdeceb }
  .dr__undo__b:focus-visible{ outline:3px solid #237b22; outline-offset:2px }

  .dr__v--undone{ background:#eef1f5; border-color:#5a6d6f; color:#39464a }

  .dr__log{ margin:18px 0 0; padding:0; list-style:none; border-top:1px solid #e3eae9 }
  .dr__log li{ display:flex; gap:10px; align-items:baseline; padding:9px 2px;
    border-bottom:1px solid #eef3f2; font-size:13.5px }
  .dr__log .t{ font-variant-numeric:tabular-nums; color:#7d8f90; font-size:12px }
  .dr__log .v{ font-weight:700; font-size:12px; letter-spacing:.04em; text-transform:uppercase }
  .dr__log .v--admit{ color:#237b22 } .dr__log .v--dup{ color:#b4671a }
  .dr__log .v--refuse{ color:#a32b1f } .dr__log .v--undone{ color:#5a6d6f }
  .dr__log .v--slow{ color:#5a6d6f } .dr__log .v--held{ color:#243d4e }

  .dr__note{ font-size:12.5px; color:#5a6d6f; line-height:1.6; margin-top:16px }
  @media (prefers-reduced-motion: no-preference){
    .dr__v{ transition: background-color .12s linear, border-color .12s linear }
  }

  /* ── A GUEST OF HONOUR ────────────────────────────────────────────────────
     A green tick is the right answer for a ticket and the wrong one for somebody
     arriving at an evening held for them. Gold, their role named, and a burst — while
     still carrying the WORD, because rule 1 above does not get an exception for
     ceremony. */
  .dr__v--honour{background:#10292c;border-color:#f3b416}
  .dr__v--honour .dr__mark{color:#f3b416}
  .dr__v--honour b{color:#fff}
  .dr__v--honour .dr__who{color:#f3b416}
  .dr__conf{position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:60;
       display:none}
  .dr__conf.is-on{display:block}
  @media (prefers-reduced-motion:reduce){ .dr__conf{display:none !important} }

  /* ── THE ORDINARY ADMIT ───────────────────────────────────────────────────
     A band of the organiser's own accent crossing the panel once. The colour is
     resolved server-side and printed here: a hardcoded one would be a second opinion
     about an event's identity and the only one the organiser cannot change.

     420ms because this is the effect that fires most. A steward sees it four hundred
     times in an evening, so it has to be something they stop noticing — the burst is
     reserved for the arrival that is genuinely rare.

     overflow:hidden on the panel so the band is clipped to it rather than running
     across the page, and the pseudo-element is aria-hidden by construction. */
  .dr__v{ position:relative; overflow:hidden }
  .dr__v::after{ content:''; position:absolute; inset:0; pointer-events:none;
    opacity:0; background:linear-gradient(100deg, transparent 30%,
      {{ accent_soft|default('rgba(35,123,34,0.55)') }} 50%, transparent 70%);
    transform:translateX(-100%) }
  .dr__v.is-sweep::after{ animation:dr-sweep .42s cubic-bezier(.22,.61,.36,1) 1 }
  @keyframes dr-sweep{
    0%   { opacity:0; transform:translateX(-100%) }
    35%  { opacity:1 }
    100% { opacity:0; transform:translateX(100%) }
  }

  /* ── STOP AND LOOK ────────────────────────────────────────────────────────
     A duplicate, a refusal and a throttle all shake. Small — 5px — and twice: a
     violent movement at a door reads as a broken screen rather than a wrong ticket,
     and the steward is holding the phone one-handed.

     translate3d rather than `left`, so this runs on the compositor and cannot cost a
     layout pass on a phone that is also decoding a camera frame. */
  .dr__v.is-nudge{ animation:dr-nudge .3s ease-in-out 1 }
  @keyframes dr-nudge{
    0%,100% { transform:translate3d(0,0,0) }
    20%     { transform:translate3d(-5px,0,0) }
    50%     { transform:translate3d(5px,0,0) }
    80%     { transform:translate3d(-3px,0,0) }
  }

  /* Both are OFF, not merely slowed, under reduced motion. A full-width band and a
     shaking panel are precisely what that setting is for, and the word and the mark
     carry the verdict without either of them. */
  @media (prefers-reduced-motion:reduce){
    .dr__v.is-sweep::after{ animation:none; opacity:0 }
    .dr__v.is-nudge{ animation:none }
  }

  /* The throttle. Its own ground rather than the refusal's: a steward whose gate has
     been told to slow down has not been shown a bad ticket, and painting it red would
     send them to argue with somebody who has paid. */
  .dr__v--slow{ background:#eef1f5; border-color:#5a6d6f; color:#39464a }

  /* ── RECORDED, NOT CHECKED ────────────────────────────────────────────────
     Its own ground, and deliberately neither green nor red. This is the one verdict
     where the door does not know the answer, and painting it as either would be the
     screen deciding on the steward's behalf. Slate reads as "held", which is what it
     is. The word says the rest. */
  .dr__v--held{ background:#eef4f8; border-color:#3a5c73; color:#243d4e }

  /* The waiting count. A bar rather than a line of text because it has a button in it,
     and 44px on that button because it is pressed one-handed in the dark. */
  .dr__pend{ margin-top:10px; display:flex; align-items:center; gap:10px; flex-wrap:wrap;
    padding:10px 12px; border-radius:10px; background:#eef4f8; border:1.5px solid #3a5c73 }
  .dr__pend__n{ flex:1; min-width:0; font-size:13.5px; font-weight:600; color:#243d4e }
  .dr__pend__b{ min-height:44px; padding:0 16px; cursor:pointer; font:inherit; font-size:14px;
    font-weight:700; border:0; border-radius:9px; background:#243d4e; color:#fff }
  .dr__pend__b:focus-visible{ outline:3px solid #237b22; outline-offset:2px }
</style>

<div class="dr">

{% if not ok %}
  {# A refused pass still gets a page. The holder is standing at a door, and "opens at 18:00"
     is the difference between waiting two minutes and ringing an organiser mid-event. #}
  <div class="dr__v dr__v--closed" role="status">
    <span class="dr__mark" aria-hidden="true">✕</span>
    <b>Door closed</b>
    <span class="dr__sub">{{ message }}</span>
    {% if reason == 'early' and opens_at %}
      <span class="dr__sub">It opens at <strong>{{ opens_at }}</strong>.</span>
    {% elseif reason == 'expired' and closes_at %}
      <span class="dr__sub">It closed at <strong>{{ closes_at }}</strong>.</span>
    {% endif %}
  </div>
  <p class="dr__note">Ask whoever sent you this link for a new one. Nothing you scan here will
    be recorded.</p>

{% else %}
  <div class="dr__head">
    <div>
      <p class="dr__ev">{{ event.title }}</p>
      <span class="dr__gate">{{ label ?: 'Door' }} · closes {{ closes_short }}</span>
    </div>
    <span class="dr__count" id="drCount" aria-live="polite">{{ admitted }} in{% if expected %} / {{ expected }}{% endif %}</span>
  </div>

  {#
    aria-live="assertive": the verdict is the entire purpose of the page and it replaces
    itself faster than a screen-reader user could go looking for it. This is one of the few
    places assertive is the correct choice rather than the rude one.
  #}
  <div class="dr__v" id="drV" role="status" aria-live="assertive">
    <span class="dr__mark" aria-hidden="true">⌁</span>
    <b>Ready</b>
    <span class="dr__sub">Scan a ticket, or type the code below.</span>
  </div>

  <form class="dr__form" id="drForm" autocomplete="off">
    <label for="drCode" class="sr-only">Ticket code</label>
    <input id="drCode" name="code" inputmode="latin" autocapitalize="characters"
           spellcheck="false" placeholder="ABCD-2468" required
           aria-describedby="drHelp">
    <button type="submit" id="drGo">Check</button>
  </form>

  {# ── TAKING IT BACK ────────────────────────────────────────────────────
     Shown only after an admit, and hidden again on the next scan. A permanent
     "undo" button beside a queue is a thing that gets pressed by accident; one that
     appears for the person who just came through, and disappears the moment the next
     ticket is scanned, can only ever mean the scan on screen.

     It is a two-step press rather than a confirm dialog: at a door, a modal is a
     second thing to dismiss one-handed, and the second tap is the confirmation. #}
  {# ── WHAT IS WAITING ───────────────────────────────────────────────────
     Shown only while something is held. A steward has to be able to see, without
     asking anybody, that the gate is carrying scans nobody has checked yet — and
     to be able to push them through the moment the line is back rather than
     waiting for the page to notice. #}
  <div class="dr__pend" id="drPend" hidden>
    <span class="dr__pend__n" role="status" aria-live="polite"></span>
    <button type="button" id="drFlush" class="dr__pend__b">Send them now</button>
  </div>

  <div class="dr__undo" id="drUndoWrap" hidden>
    <button type="button" id="drUndo" class="dr__undo__b">Not them — take it back</button>
  </div>

  <div class="dr__cam" id="drCamWrap" hidden>
    <button type="button" id="drCam">Use the camera</button>
    <video id="drVideo" class="dr__video" playsinline muted></video>
  </div>

  {# The running list. Not decoration: it is how somebody proves what happened when an
     attendee disputes being turned away ten minutes later. #}
  <ul class="dr__log" id="drLog" aria-label="Recent scans"></ul>

  <p class="dr__note" id="drHelp">
    Codes are not case sensitive. This link works until
    <strong>{{ closes_at }}</strong> and then stops by itself —
    it cannot be used for any other event, and it cannot show you the guest list.
  </p>
{% endif %}
</div>

{% if ok %}
<script nonce="{{ csp_nonce }}">
(function () {
  var form  = document.getElementById('drForm');
  var input = document.getElementById('drCode');
  var go    = document.getElementById('drGo');
  var panel = document.getElementById('drV');
  var logEl = document.getElementById('drLog');
  var count = document.getElementById('drCount');
  var url   = {{ ('/door/' ~ token ~ '/check')|json_encode|raw }};
  if (!form || !input || !panel) return;

  {# ── THE VOICE ──────────────────────────────────────────────────────────
     One <audio> element, reused. Created once rather than per scan because a phone
     that has been granted playback keeps it on the same element, and a fresh element
     per attendee would be blocked by autoplay policy after the first one.

     The src is a key the server rendered HOURS ago. Nothing is synthesised here and
     nothing is awaited — play() is fired and forgotten, so a slow clip, a muted
     phone or a refused autoplay cannot hold up the verdict or the queue. #}
  var welcomeOn = {{ welcome_on|default(false) ? 'true' : 'false' }};
  var audio = null;

  function greet(key) {
    if (!welcomeOn || !key) return;
    try {
      if (!audio) { audio = new Audio(); audio.preload = 'none'; }
      audio.src = '/door/' + {{ token|json_encode|raw }} + '/welcome/' + key;
      // Deliberately not awaited, and the rejection is swallowed. A browser that refuses
      // autoplay until the operator has tapped something is the normal case on a phone,
      // and it must read as "no sound yet", never as a failed scan.
      var p = audio.play();
      if (p && p.catch) p.catch(function () {});
    } catch (e) { /* a door with no sound is a working door */ }
  }

  var pendEl  = document.getElementById('drPend');
  var syncUrl = {{ ('/door/' ~ token ~ '/sync')|json_encode|raw }};

  var undoWrap = document.getElementById('drUndoWrap');
  var undoBtn  = document.getElementById('drUndo');
  var undoUrl  = {{ ('/door/' ~ token ~ '/undo')|json_encode|raw }};

  var MARK = { admit: '✓', duplicate: '!', refuse: '✕', closed: '✕', undone: '↩',
               slow: '⏳', held: '⋯' };
  var CLS  = { admit: 'admit', duplicate: 'dup', refuse: 'refuse', closed: 'closed',
               undone: 'undone', slow: 'slow', held: 'held' };

  // The ticket currently on the panel, and whether the undo button is armed. Held here
  // rather than read off the DOM so a re-render cannot leave the button pointing at a
  // code that is no longer displayed — which is the one way this control could admit
  // the wrong reversal.
  var onPanel = '', armed = false;

  function disarm() {
    armed = false;
    if (!undoBtn || !undoWrap) return;
    undoBtn.classList.remove('is-armed');
    undoBtn.textContent = 'Not them — take it back';
    undoWrap.hidden = true;
  }

  function paint(v) {
    var kind = CLS[v.verdict] || 'refuse';
    // A guest of honour still gets the admit WORD and mark — the gold is added to it, not
    // substituted for it, so the panel reads the same way in sunlight and to a steward who
    // cannot tell the two colours apart.
    panel.className = 'dr__v dr__v--' + kind + (v.honour && v.verdict === 'admit' ? ' dr__v--honour' : '');
    panel.innerHTML = '';

    var mark = document.createElement('span');
    mark.className = 'dr__mark'; mark.setAttribute('aria-hidden', 'true');
    mark.textContent = MARK[v.verdict] || '✕';

    var title = document.createElement('b');
    title.textContent = v.title || '';

    panel.appendChild(mark);
    panel.appendChild(title);

    // The NAME is the second thing on the panel, because the person on the door is about to
    // say it out loud. textContent throughout — an attendee's name is user input and this
    // string is being written into the DOM.
    if (v.name) {
      var who = document.createElement('span');
      who.className = 'dr__who';
      who.textContent = v.name + (v.seats > 1 ? ' · ' + v.seats + ' seats' : '');
      panel.appendChild(who);
    }
    if (v.detail) {
      var sub = document.createElement('span');
      sub.className = 'dr__sub'; sub.textContent = v.detail;
      panel.appendChild(sub);
    }

    if (typeof v.admitted === 'number' && count) {
      count.textContent = v.admitted + ' in' + ({{ expected|default(0) }} ? ' / {{ expected|default(0) }}' : '');
    }

    // A short buzz on anything that is not a clean admit. The operator is looking at the
    // queue, not the screen, and this is the cheapest way to make them look down.
    if (v.verdict !== 'admit' && navigator.vibrate) { try { navigator.vibrate(180); } catch (e) {} }

    // One effect per verdict, and never one that could be mistaken for another. A
    // duplicate and a refusal both shake, because both mean "stop and look"; only an
    // admit sweeps; only a guest of honour bursts.
    if (v.honour && v.verdict === 'admit') celebrate();
    else if (v.verdict === 'admit') sweep();
    else if (v.verdict === 'duplicate' || v.verdict === 'refuse' || v.verdict === 'slow') nudge();
    else fxStop();

    greet(v.welcome);

    // Offered only for a ticket that was just admitted here. Not for a duplicate (the
    // admission being undone would be somebody else's, minutes ago), not for a guest of
    // honour (there is no registration to reverse), and never for a refusal.
    disarm();
    onPanel = (v.verdict === 'admit' && !v.honour && v.code) ? String(v.code) : '';
    if (onPanel && undoWrap) undoWrap.hidden = false;
  }

  /**
   * ── THE EFFECTS ───────────────────────────────────────────────────────────
   *
   * Hand-rolled on one canvas rather than a library: this page is opened on a venue's
   * wifi by a steward who needs it working, and a CDN script is a thing that can fail
   * to arrive. Sixty lines is cheaper than that risk.
   *
   * FOUR RULES, and each one is a bug this replaced:
   *
   *  1. ONE LOOP, CANCELLABLE. The previous burst started a fresh requestAnimationFrame
   *     on every call with nothing stopping the last one — two guests of honour scanned
   *     inside its 2.6s and both loops wrote to the same canvas, each clearing the
   *     other's frame. At a door, effects overlap by definition.
   *  2. PAINTED IN THE ORGANISER'S ACCENT. It hardcoded gold and green. A tier's colour
   *     is a slot resolved from the event's own accent everywhere else on this platform
   *     — the ticket, the flier, the selection light — and a gold gala bursting emerald
   *     at its own door is exactly what that rule exists to prevent.
   *  3. NEVER THE SIGNAL. The word and the mark carry the verdict; these are added to
   *     it. A steward who cannot tell the colours apart, or whose phone is in sunlight,
   *     or who has motion switched off, loses nothing that matters.
   *  4. IT NEVER DELAYS THE NEXT SCAN. Fired and forgotten, capped in duration, and the
   *     input keeps focus throughout. A queue does not wait for confetti.
   */
  var ACCENT = {{ accent|default('#f3b416')|json_encode|raw }};
  var fx = { cv: null, ctx: null, raf: 0, until: 0 };

  function fxReady() {
    if (fx.cv) return fx.ctx;
    var cv = document.getElementById('dr-conf');
    if (!cv || !cv.getContext) return null;
    fx.cv = cv; fx.ctx = cv.getContext('2d');
    return fx.ctx;
  }

  function fxStop() {
    if (fx.raf) cancelAnimationFrame(fx.raf);
    fx.raf = 0;
    if (fx.ctx && fx.cv) fx.ctx.clearRect(0, 0, fx.cv.width, fx.cv.height);
    if (fx.cv) fx.cv.classList.remove('is-on');
  }

  function reduced() {
    return window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  /**
   * The burst, for somebody arriving at an evening held for them.
   *
   * Their accent leads, with white and the platform's gold behind it — three colours
   * rather than one so the field reads as celebration rather than as a coloured smear,
   * and white because it survives every accent an organiser can choose.
   */
  function celebrate() {
    var ctx = fxReady();
    if (!ctx || reduced()) return;
    fxStop();

    var cv = fx.cv;
    var dpr = Math.min(2, window.devicePixelRatio || 1);
    cv.width = Math.floor(cv.clientWidth * dpr);
    cv.height = Math.floor(cv.clientHeight * dpr);
    cv.classList.add('is-on');

    var COLOURS = [ACCENT, '#ffffff', '#f3b416', ACCENT];
    var bits = [];
    for (var i = 0; i < 90; i++) {
      bits.push({
        x: cv.width * (0.2 + Math.random() * 0.6),
        y: cv.height * (0.35 + Math.random() * 0.1),
        vx: (Math.random() - 0.5) * 9 * dpr,
        vy: (-7 - Math.random() * 8) * dpr,
        r: (3 + Math.random() * 4) * dpr,
        spin: (Math.random() - 0.5) * 0.3,
        a: Math.random() * Math.PI,
        c: COLOURS[i % COLOURS.length]
      });
    }

    var started = Date.now();
    (function frame() {
      var age = Date.now() - started;
      ctx.clearRect(0, 0, cv.width, cv.height);
      for (var j = 0; j < bits.length; j++) {
        var b = bits[j];
        b.vy += 0.28 * dpr;          // gravity
        b.x += b.vx; b.y += b.vy; b.a += b.spin;
        ctx.save();
        ctx.globalAlpha = Math.max(0, 1 - age / 2600);
        ctx.translate(b.x, b.y); ctx.rotate(b.a);
        ctx.fillStyle = b.c;
        ctx.fillRect(-b.r, -b.r * 0.4, b.r * 2, b.r * 0.8);
        ctx.restore();
      }
      if (age < 2600) fx.raf = requestAnimationFrame(frame);
      else fxStop();
    })();
  }

  /**
   * The ordinary admit: a band of the accent crossing the panel once.
   *
   * Short — 420ms — because this is the effect that fires most, and an effect a steward
   * sees four hundred times in an evening has to be something they stop noticing. The
   * burst is reserved for the arrival that is genuinely rare.
   */
  function sweep() {
    if (reduced()) return;
    panel.classList.remove('is-sweep');
    // Reading offsetWidth forces the style recalculation that makes removing and
    // re-adding a class actually restart the animation. Without it, two admits in a row
    // play the effect once.
    void panel.offsetWidth;
    panel.classList.add('is-sweep');
  }

  /** A shake, for the two verdicts that need the operator to look down. */
  function nudge() {
    if (reduced()) return;
    panel.classList.remove('is-nudge');
    void panel.offsetWidth;
    panel.classList.add('is-nudge');
  }

  function remember(v) {
    if (!logEl) return;
    var li = document.createElement('li');
    var t  = document.createElement('span');
    t.className = 't';
    t.textContent = new Date().toTimeString().slice(0, 5);
    var k = document.createElement('span');
    k.className = 'v v--' + (CLS[v.verdict] || 'refuse');
    k.textContent = v.verdict === 'duplicate' ? 'again'
                  : v.verdict === 'undone' ? 'back'
                  : v.verdict === 'slow' ? 'wait'
                  : v.verdict === 'held' ? 'held'
                  : (v.verdict === 'admit' ? 'in' : 'no');
    var n = document.createElement('span');
    n.textContent = v.name || v.code || '—';
    li.appendChild(t); li.appendChild(k); li.appendChild(n);
    logEl.insertBefore(li, logEl.firstChild);
    while (logEl.children.length > 12) logEl.removeChild(logEl.lastChild);
  }

  /**
   * ── THE LINE GOING DOWN ───────────────────────────────────────────────────
   *
   * Before this, a failed fetch stopped the door: the message was honest and the queue
   * stopped moving, which at a gate is the whole failure.
   *
   * An offline scan is RECORDED, never decided. The server is the only thing that ever
   * says admit — see DoorController::sync() for why shipping the code list to this phone
   * was considered and rejected — so the panel says what actually happened, in words
   * that are not "admit", and the steward looks at the physical ticket in their hand.
   *
   * The queue lives in localStorage, and that is not a detail: a phone at a venue
   * suspends tabs to save memory, and losing fifty admissions to a tab reload would be
   * worse than having no offline mode at all. It is keyed to this pass, so two gates on
   * one borrowed phone never flush each other's scans.
   */
  var QKEY = 'ag-door-q:' + {{ token|json_encode|raw }}.slice(0, 12);
  var pending = [];

  function qLoad() {
    try {
      var raw = localStorage.getItem(QKEY);
      pending = raw ? (JSON.parse(raw) || []) : [];
    } catch (e) { pending = []; }
    if (!Array.isArray(pending)) pending = [];
    paintPending();
  }

  function qSave() {
    try { localStorage.setItem(QKEY, JSON.stringify(pending)); }
    catch (e) { /* a full or disabled store must not stop the door; the queue lives in memory */ }
    paintPending();
  }

  function paintPending() {
    if (!pendEl) return;
    pendEl.hidden = pending.length === 0;
    if (pending.length) {
      pendEl.querySelector('.dr__pend__n').textContent =
        pending.length + (pending.length === 1 ? ' scan waiting' : ' scans waiting');
    }
  }

  function qAdd(code) {
    pending.push({
      // A client id so a flush that half-succeeds, or is retried after a timeout, cannot
      // record the same person twice.
      id: (Date.now().toString(36) + Math.random().toString(36).slice(2, 8)),
      code: code,
      // The moment it HAPPENED. Sent so the arrivals log reads as an evening rather than
      // as forty people arriving in the same second half an hour later.
      at: stamp()
    });
    qSave();
  }

  /** 'YYYY-MM-DD HH:MM:SS' in the phone's own clock — the server clamps it. */
  function stamp() {
    var d = new Date(), p = function (n) { return (n < 10 ? '0' : '') + n; };
    return d.getFullYear() + '-' + p(d.getMonth() + 1) + '-' + p(d.getDate()) + ' '
         + p(d.getHours()) + ':' + p(d.getMinutes()) + ':' + p(d.getSeconds());
  }

  var flushing = false;
  async function flush(quiet) {
    if (flushing || !pending.length) return;
    flushing = true;
    var sending = pending.slice(0, 200);

    try {
      var r = await fetch(syncUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: JSON.stringify({ scans: sending })
      });
      var d = await r.json();
      if (!d || !d.ok) { flushing = false; return; }

      // Retire exactly what the server answered for, by id. Clearing the whole queue would
      // drop anything scanned while the request was in the air.
      var done = {};
      (d.results || []).forEach(function (x) { if (x && x.id) done[x.id] = x; });
      pending = pending.filter(function (i) { return !done[i.id]; });
      qSave();

      (d.results || []).forEach(function (x) {
        remember({ verdict: x.verdict, name: x.name, code: x.code, title: x.title });
      });

      if (typeof d.admitted === 'number' && count) {
        count.textContent = d.admitted + ' in' + ({{ expected|default(0) }} ? ' / {{ expected|default(0) }}' : '');
      }

      if (!quiet) {
        var went = (d.results || []).length;
        var no = (d.results || []).filter(function (x) { return x.verdict !== 'admit'; }).length;
        paint({
          verdict: no ? 'duplicate' : 'admit',
          title: went + ' sent',
          // The failures are the point of saying anything at all. A steward who admitted
          // somebody on a code the server later refused needs to know it happened while
          // that person is still in the room.
          detail: no
            ? no + ' of them were not admitted — the list below says which.'
            : 'Everything scanned while the line was down has gone through.'
        });
      }
    } catch (e) { /* still down: the queue keeps, and the next reconnect tries again */ }

    flushing = false;
  }

  var busy = false;
  async function check(code) {
    code = (code || '').trim();
    if (!code || busy) return;
    busy = true; go.disabled = true;
    try {
      var r = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: JSON.stringify({ code: code })
      });
      var v = await r.json();
      paint(v); remember(v);
    } catch (e) {
      // The line is down. RECORD it and keep the queue moving — but say exactly what that
      // means, because this verdict is the one place the door does not know the answer.
      // "Admit" here would be the screen guessing on the steward's behalf.
      qAdd(code);
      paint({
        verdict: 'held',
        title: 'Recorded — not checked',
        detail: 'This gate is offline. Check the ticket yourself and let them through if it '
              + 'looks right. It will be checked as soon as the line is back.',
        code: code
      });
      remember({ verdict: 'held', code: code });
      input.value = '';
      input.focus();
      busy = false; go.disabled = false;
      return;
    }
    input.value = '';
    input.focus();
    busy = false; go.disabled = false;
  }

  form.addEventListener('submit', function (e) { e.preventDefault(); check(input.value); });
  input.focus();

  // ── COMING BACK ──────────────────────────────────────────────────────────
  //
  // Three ways, because none of them is reliable on its own at a venue. `online` does not
  // fire on every recovery and `navigator.onLine` reports the wifi association rather than
  // whether anything is reachable through it — a captive portal is "online" and useless.
  // So: the browser's hint, a slow poll, and a button the steward can press.
  qLoad();
  flush(true);
  window.addEventListener('online', function () { flush(true); });
  setInterval(function () { if (pending.length) flush(true); }, 20000);
  var flushBtn = document.getElementById('drFlush');
  if (flushBtn) flushBtn.addEventListener('click', function () { flush(false); });

  // Two taps, no dialog. The first arms and relabels; the second sends. A modal at a door
  // is a second thing to dismiss one-handed with a queue waiting, and the relabel carries
  // the same information a confirm box would — including the name, so the steward is
  // reversing a person rather than a code.
  if (undoBtn) {
    undoBtn.addEventListener('click', async function () {
      if (!onPanel || busy) return;

      if (!armed) {
        armed = true;
        undoBtn.classList.add('is-armed');
        undoBtn.textContent = 'Press again to un-admit';
        return;
      }

      busy = true; undoBtn.disabled = true;
      try {
        var r = await fetch(undoUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
          body: JSON.stringify({ code: onPanel })
        });
        var v = await r.json();
        paint(v); remember(v);
      } catch (e) {
        paint({ verdict: 'refuse', title: 'No connection',
                detail: 'Nothing was changed. Scan the ticket again and retry.' });
      }
      busy = false; undoBtn.disabled = false;
      input.focus();
    });
  }

  // ── THE CAMERA, WHICH IS THE ADDITION AND NOT THE DOOR ───────────────────
  //
  // Shown only where it can actually work: BarcodeDetector is absent on iOS Safari, and
  // getUserMedia needs a secure context. Offering a button that cannot function is worse than
  // not offering one, because the operator spends the queue tapping it.
  var wrap = document.getElementById('drCamWrap');
  var vid  = document.getElementById('drVideo');
  var camBtn = document.getElementById('drCam');
  var secure = window.isSecureContext || location.hostname === 'localhost';
  if (!wrap || !vid || !camBtn || !secure) return;
  if (!('BarcodeDetector' in window) || !navigator.mediaDevices) return;

  var detector = null, stream = null, timer = null;
  BarcodeDetector.getSupportedFormats().then(function (f) {
    if (f.indexOf('qr_code') === -1) return;
    detector = new BarcodeDetector({ formats: ['qr_code'] });
    wrap.hidden = false;
  }).catch(function () { /* no scanner: the typed box is the door */ });

  var last = '', lastAt = 0;
  camBtn.addEventListener('click', async function () {
    if (stream) {
      stream.getTracks().forEach(function (t) { t.stop(); });
      stream = null; clearInterval(timer); vid.classList.remove('on');
      camBtn.textContent = 'Use the camera';
      input.focus();
      return;
    }
    try {
      // The REAR camera: the operator holds the phone and the ticket is in front of it.
      stream = await navigator.mediaDevices.getUserMedia({
        video: { facingMode: { ideal: 'environment' } }, audio: false });
      vid.srcObject = stream; await vid.play();
      vid.classList.add('on'); camBtn.textContent = 'Stop the camera';
    } catch (e) {
      camBtn.textContent = 'Camera unavailable — type the code';
      return;
    }
    timer = setInterval(async function () {
      if (busy || vid.readyState < 2 || !detector) return;
      try {
        var found = await detector.detect(vid);
        if (!found || !found.length) return;
        var raw = String(found[0].rawValue || '').trim();
        // A camera pointed at one ticket fires many times a second. Same code inside three
        // seconds is the same person, and re-sending it would report them as a duplicate of
        // themselves — the one wrong answer that looks like fraud.
        var now = Date.now();
        if (raw === last && now - lastAt < 3000) return;
        last = raw; lastAt = now;
        check(raw);
      } catch (e) { /* a bad frame is not an error */ }
    }, 350);
  });
})();
</script>
{% endif %}
{% endblock %}
