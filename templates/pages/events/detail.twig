{% extends "layout/gates.twig" %}

{% block head_styles %}
<style nonce="{{ csp_nonce }}">
  body[data-page="events"]{ background:#eef0ec; color:var(--ag-ink); }
  [x-cloak]{ display:none !important; }
  .ed{ max-width:1080px; margin:0 auto; padding:18px var(--ag-gutter,32px) clamp(3rem,6vw,4rem); }
  .ed-crumb{ font-size:12.5px; color:#5a6d6f; margin-bottom:14px; }
  .ed-crumb a{ color:#5a6d6f; text-decoration:none; }
  .ed-crumb b{ color:var(--ag-ink); font-weight:500; }

  .ed-hero{ position:relative; overflow:hidden; border-radius:24px; min-height:320px; display:flex; align-items:flex-end;
    padding:clamp(1.8rem,3vw,2.4rem); background:radial-gradient(130% 130% at 78% 0%,#1d5b2a,#10292C 60%); }
  .ed-hero__bg{ position:absolute; inset:0; width:100%; height:100%; object-fit:cover; opacity:.42; }
  .ed-hero__orb{ position:absolute; right:-60px; top:-60px; width:300px; height:300px; border-radius:50%; background:radial-gradient(circle,rgba(212,154,14,.3),transparent 68%); }
  .ed-hero__in{ position:relative; }
  .ed-hero__badge{ display:inline-flex; align-items:center; gap:7px; font-size:11px; font-weight:600; letter-spacing:.1em; text-transform:uppercase; color:#fbc329; background:rgba(212,154,14,.18); padding:7px 14px; border-radius:999px; }
  .ed-hero__title{ margin:16px 0 0; font-family:var(--ag-font-display); font-weight:800; font-size:clamp(2rem,4.6vw,2.9rem); line-height:1.03; letter-spacing:-.02em; color:#fff; }
  .ed-hero__meta{ display:flex; flex-wrap:wrap; gap:20px; margin-top:18px; }
  .ed-hero__meta span{ display:flex; align-items:center; gap:8px; color:rgba(255,255,255,.85); font-size:14px; }

  .ed-grid{ display:grid; grid-template-columns:1fr 340px; gap:28px; align-items:start; margin-top:28px; }
  .ed-main{ display:flex; flex-direction:column; gap:24px; min-width:0; }
  .ed-card{ background:var(--ag-surface); border:1px solid rgba(16,41,44,.08); border-radius:20px; padding:clamp(1.4rem,3vw,1.75rem); }
  .ed-card h2{ margin:0 0 12px; font-family:var(--ag-font-display); font-weight:700; font-size:1.3rem; color:var(--ag-ink); }
  .ed-card p{ margin:0; font-size:15px; line-height:1.7; color:#3a4448; white-space:pre-line; }
  .ed-venue__name{ font-weight:600; font-size:15px; color:var(--ag-ink); margin-top:4px; }
  .ed-venue__addr{ font-size:13.5px; color:#626a6e; margin-top:3px; }

  .ed-rail{ position:sticky; top:88px; display:flex; flex-direction:column; gap:18px; }
  .ed-rsvp{ background:var(--ag-surface); border:1px solid rgba(16,41,44,.08); border-radius:20px; padding:22px; box-shadow:0 12px 36px -20px rgba(16,41,44,.35); }
  .ed-rsvp__top{ display:flex; align-items:center; justify-content:space-between; }
  .ed-rsvp__eyebrow{ font-size:12px; font-weight:600; letter-spacing:.06em; text-transform:uppercase; color:var(--ag-green); }
  .ed-rsvp__count{ font:700 13px/1 var(--ag-font-mono); color:#5a6d6f; }
  .ed-rsvp h2{ margin:10px 0 0; font-family:var(--ag-font-display); font-weight:700; font-size:1.2rem; color:var(--ag-ink); }
  .ed-rsvp p.sub{ margin:7px 0 0; font-size:13px; line-height:1.5; color:#626a6e; }
  .ed-label{ display:block; font-size:12px; font-weight:600; color:#4a5256; margin:14px 0 6px; }
  .ed-input{ width:100%; border:1px solid rgba(16,41,44,.16); border-radius:11px; padding:12px 14px; font-family:inherit; font-size:14px; color:var(--ag-ink); outline:none; transition:border-color .15s; }
  .ed-input:focus{ border-color:var(--ag-green); }
  .ed-cta{ width:100%; margin-top:16px; cursor:pointer; border:none; background:var(--ag-green); color:#fff; font-family:inherit; font-weight:600; font-size:15px; padding:13px; border-radius:999px; transition:background .15s; }
  .ed-cta:hover{ background:var(--ag-green-dark); }
  .ed-cta:disabled{ background:#dfe4e3; color:#5b6669; opacity:1; cursor:not-allowed; }
  .ed-secure{ display:flex; align-items:center; justify-content:center; gap:7px; margin-top:12px; font-size:11.5px; color:#5a6d6f; }
  .ed-err{ font-size:13px; color:#b42318; background:#fdecec; border:1px solid rgba(180,35,24,.18); border-radius:10px; padding:9px 12px; margin-top:12px; }
  .ed-ext{ display:block; text-align:center; margin-top:12px; font-size:12.5px; color:var(--ag-green); font-weight:600; text-decoration:none; }
  .ed-done{ text-align:center; padding:8px 0; }
  .ed-done__ico{ width:60px; height:60px; margin:0 auto 12px; border-radius:50%; background:#effaf0; display:flex; align-items:center; justify-content:center; }
  .ed-done h2{ margin:0; }
  .ed-past{ font-size:14px; color:#626a6e; margin-top:10px; line-height:1.6; }

  /* early-bird banner */
  .ed-eb{ display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:12px; background:#eafaf0; border:1px solid rgba(35,123,34,.2); border-radius:14px; padding:12px 18px; margin-bottom:16px; }
  .ed-eb__t{ font-weight:600; font-size:14px; color:#10292C; }
  .ed-eb__cta{ font-size:13px; font-weight:600; color:var(--ag-green); text-decoration:none; white-space:nowrap; }
  /* run of show */
  .ed-sched__row{ display:flex; gap:18px; padding:13px 0; border-bottom:1px solid rgba(16,41,44,.06); }
  .ed-sched__row:last-child{ border-bottom:0; padding-bottom:0; }
  .ed-sched__time{ flex:none; width:72px; font:700 13px/1.4 var(--ag-font-mono,monospace); color:#a47306; }
  .ed-sched__t{ font-weight:600; font-size:14.5px; color:var(--ag-ink); }
  .ed-sched__b{ font-size:13px; color:#717a7e; margin-top:2px; }
  .ed-maplink{ display:inline-flex; align-items:center; gap:6px; margin-top:14px; font-size:13px; font-weight:600; color:var(--ag-green); text-decoration:none; }
  /* agenda — sessions as rows, grouped by day */
  .ed-ag__day + .ed-ag__day{ margin-top:22px; }
  .ed-ag__dayh{ display:flex; align-items:center; gap:10px; font-size:12px; font-weight:700; letter-spacing:.07em; text-transform:uppercase; color:var(--ag-green); }
  .ed-ag__dayh::after{ content:''; flex:1; height:1px; background:rgba(16,41,44,.1); }
  .ed-ag__row{ display:flex; gap:16px; padding:14px 0; border-bottom:1px solid rgba(16,41,44,.06); }
  .ed-ag__row:last-child{ border-bottom:0; padding-bottom:0; }
  .ed-ag__time{ flex:none; width:104px; font-family:var(--ag-font-mono,monospace); font-size:12.5px; font-weight:700; line-height:1.5; color:#a47306; }
  .ed-ag__t{ font-weight:600; font-size:15px; color:var(--ag-ink); }
  .ed-ag__b{ font-size:13.5px; line-height:1.65; color:#717a7e; margin-top:4px; white-space:pre-line; }
  .ed-ag__tags{ display:flex; flex-wrap:wrap; gap:6px; margin-top:7px; }
  .ed-ag__tag{ font-size:11px; font-weight:600; padding:3px 9px; border-radius:999px; background:#eef2ee; color:#4a5256; }
  .ed-ag__tag.is-track{ background:#eafaf0; color:#1a6118; }
  .ed-ag__who{ font-size:12.5px; color:#5a6d6f; margin-top:6px; }
  .ed-ag__filter{ display:flex; flex-wrap:wrap; gap:7px; margin-bottom:16px; }
  .ed-ag__fb{ cursor:pointer; font-family:inherit; font-size:12px; font-weight:600; padding:6px 13px; border-radius:999px; border:1px solid rgba(16,41,44,.14); background:#fff; color:#4a5256; }
  .ed-ag__fb.is-on{ background:var(--ag-green); border-color:var(--ag-green); color:#fff; }
  /* the small print an organiser writes once */
  .ed-fine dt{ font-size:12px; font-weight:700; letter-spacing:.05em; text-transform:uppercase; color:#92a6a7; margin-top:14px; }
  .ed-fine dt:first-child{ margin-top:0; }
  .ed-fine dd{ margin:5px 0 0; font-size:14px; line-height:1.7; color:#3a4448; white-space:pre-line; }
  .ed-fine a{ color:var(--ag-green); font-weight:600; text-decoration:none; }
  /* discount code */
  .ed-disc{ display:flex; gap:8px; margin-top:6px; }
  .ed-disc .ed-input{ text-transform:uppercase; letter-spacing:.04em; }
  .ed-disc button{ flex:none; cursor:pointer; border:1px solid rgba(16,41,44,.16); background:#fff; color:#10292C; font-family:inherit; font-size:13px; font-weight:600; padding:0 15px; border-radius:11px; }
  .ed-disc button:disabled{ opacity:.5; cursor:not-allowed; }
  .ed-disc__ok{ font-size:12.5px; font-weight:600; color:#1a6118; margin-top:7px; }
  .ed-disc__no{ font-size:12.5px; color:#8a5a00; margin-top:7px; }
  .ed-was{ text-decoration:line-through; color:#92a6a7; font-weight:500; }
  /* waitlist */
  .ed-wl{ background:#fff8ec; border:1px solid rgba(212,154,14,.28); border-radius:14px; padding:14px 16px; margin-top:14px; }
  .ed-wl__h{ font-weight:700; font-size:13.5px; color:#7a4d00; }
  .ed-wl__p{ font-size:12.5px; line-height:1.6; color:#7a5a1a; margin:5px 0 0; }
  .ed-wl__go{ width:100%; margin-top:10px; cursor:pointer; border:none; background:#a47306; color:#fff; font-family:inherit; font-weight:600; font-size:13.5px; padding:11px; border-radius:999px; }
  .ed-wl__go:disabled{ opacity:.6; cursor:not-allowed; }
  /* tiers + sold bar */
  .ed-sold__top{ display:flex; justify-content:space-between; font-size:12px; color:#5a6d6f; }
  .ed-sold__bar{ height:7px; border-radius:5px; background:#eef2ee; overflow:hidden; margin:7px 0 4px; }
  .ed-sold__fill{ display:block; height:100%; border-radius:5px; background:linear-gradient(90deg,#d49a0e,#fbc329); }
  /* align-items:flex-start, not center: a tier with three perks is a tall card, and a radio
     floating halfway down one reads as belonging to whichever perk it happens to sit beside. */
  .ed-tier{ width:100%; text-align:left; border:1.5px solid rgba(16,41,44,.12); background:#fff; border-radius:13px; padding:12px 14px; display:flex; align-items:flex-start; gap:11px; cursor:pointer; margin-top:9px; font-family:inherit; }
  .ed-tier.is-sel{ border-color:var(--ag-green); background:#f6fcf5; }
  .ed-tier:disabled{ opacity:.5; cursor:not-allowed; }
  .ed-tier__radio{ flex:none; width:18px; height:18px; margin-top:2px; border-radius:50%; border:2px solid rgba(16,41,44,.25); display:flex; align-items:center; justify-content:center; }
  .ed-tier.is-sel .ed-tier__radio{ border-color:var(--ag-green); }
  .ed-tier.is-sel .ed-tier__radio::after{ content:''; width:9px; height:9px; border-radius:50%; background:var(--ag-green); }
  .ed-tier__name{ font-weight:600; font-size:14px; color:var(--ag-ink); }
  .ed-tier__perk{ font-size:11.5px; color:#92a6a7; }
  .ed-tier__price{ flex:none; margin-left:auto; padding-left:8px; font-family:var(--ag-font-mono,monospace); font-size:14px; font-weight:700; line-height:1.4; white-space:nowrap; color:var(--ag-ink); }
  /* share / calendar */
  .ed-share{ display:flex; gap:9px; margin-top:4px; }
  .ed-share button{ flex:1; cursor:pointer; border:1px solid rgba(16,41,44,.14); background:#fff; color:#10292C; font-family:inherit; font-size:13px; font-weight:600; padding:10px; border-radius:11px; display:flex; align-items:center; justify-content:center; gap:7px; }
  .ed-share button:hover{ background:#f0f4f0; }
  /* The calendar download. Styled like the share button rather than as a link, because it
     is an action of the same weight — and it is the PRIMARY of the two, since a .ics works
     in every calendar app with no account and no page in the middle. */
  .ed-cal{ flex:1; cursor:pointer; border:1px solid rgba(16,41,44,.14); background:#fff;
    color:#10292C; font-size:13px; font-weight:600; padding:10px; border-radius:11px;
    display:flex; align-items:center; justify-content:center; gap:7px; text-decoration:none; }
  .ed-cal:hover{ background:#f0f4f0; border-color:rgba(16,41,44,.24); }
  .ed-cal__alt{ margin:9px 0 0; font-size:11.5px; color:#92a6a7; text-align:center; }
  .ed-cal__alt a{ color:#237b22; font-weight:600; }

  @media (max-width:820px){ .ed-grid{ grid-template-columns:1fr; } .ed-rail{ position:static; } }
</style>
{% endblock %}

{% block content %}
<div class="ed">
  {% if early_bird %}
  <div class="ed-eb">
    <span class="ed-eb__t">🎟 {{ early_bird.text }}</span>
    <a class="ed-eb__cta" href="{{ early_bird.url|default('#ed-rsvp') }}">Register{% if early_bird.deadline %} — ends {{ early_bird.deadline|date('j F') }}{% endif %} →</a>
  </div>
  {% endif %}
  <div class="ed-crumb"><a href="/events">Events</a> · <b>{{ event.title }}</b></div>

  <div class="ed-hero">
    {% if event.cover_image %}<img class="ed-hero__bg" src="{{ event.cover_image }}" alt="" aria-hidden="true">{% endif %}
    <div class="ed-hero__orb" aria-hidden="true"></div>
    <div class="ed-hero__in">
      <span class="ed-hero__badge">{{ is_past ? 'Past event' : 'Upcoming' }} · {{ event.event_date|date('Y') }}</span>
      <h1 class="ed-hero__title">{{ event.title }}</h1>
      <div class="ed-hero__meta">
        <span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#7FC87C" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>{{ event.event_date|date('j F Y') }}</span>
        <span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#7FC87C" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>{{ event.event_date|date('H:i') }}{% if event.end_date %}–{{ event.end_date|date('H:i') }}{% endif %} WAT</span>
        {% if event.location or event.venue %}<span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#7FC87C" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>{{ event.venue|default(event.location) }}</span>{% endif %}
      </div>
    </div>
  </div>

  <div class="ed-grid">
    <div class="ed-main">
      {% if event.description %}
      <div class="ed-card">
        <h2>About this event</h2>
        <p>{{ event.description }}</p>
      </div>
      {% endif %}

      {# ── AGENDA ─────────────────────────────────────────────────────────────
         Sessions are rows now, grouped into days by EventAgenda so no date arithmetic
         happens in a template — an undated session in Twig silently becomes 1 January
         1970. The track filter is offered only when there is more than one track,
         because a filter with one option is a control that cannot do anything. #}
      {% if agenda|default([]) %}
      {% set tracks = [] %}
      {% for d in agenda %}{% for s in d.sessions %}{% if s.track and s.track not in tracks %}{% set tracks = tracks|merge([s.track]) %}{% endif %}{% endfor %}{% endfor %}
      <div class="ed-card" x-data="{ track: '' }">
        <h2>Agenda</h2>
        {% if tracks|length > 1 %}
        <div class="ed-ag__filter">
          <button type="button" class="ed-ag__fb" :class="track === '' ? 'is-on' : ''" @click="track = ''">All tracks</button>
          {% for t in tracks %}
          <button type="button" class="ed-ag__fb" :class="track === {{ t|json_encode }} ? 'is-on' : ''" @click="track = {{ t|json_encode }}">{{ t }}</button>
          {% endfor %}
        </div>
        {% endif %}
        {% for d in agenda %}
        <div class="ed-ag__day">
          {% if agenda|length > 1 or d.key == '' %}<div class="ed-ag__dayh">{{ d.label }}</div>{% endif %}
          {% for s in d.sessions %}
          <div class="ed-ag__row" x-show="track === '' || track === {{ s.track|json_encode }}">
            <span class="ed-ag__time">{{ s.when ?: '—' }}</span>
            <div>
              <div class="ed-ag__t">{{ s.title }}</div>
              {% if s.description %}<div class="ed-ag__b">{{ s.description }}</div>{% endif %}
              {% if s.speakers %}<div class="ed-ag__who">🎤 {{ s.speakers|join(', ') }}</div>{% endif %}
              {% if s.track or s.room %}
              <div class="ed-ag__tags">
                {% if s.track %}<span class="ed-ag__tag is-track">{{ s.track }}</span>{% endif %}
                {% if s.room %}<span class="ed-ag__tag">{{ s.room }}</span>{% endif %}
              </div>
              {% endif %}
            </div>
          </div>
          {% endfor %}
        </div>
        {% endfor %}
      </div>
      {% elseif schedule %}
      {# The old JSON run of show, for an event that never moved to sessions. #}
      <div class="ed-card">
        <h2>Run of show</h2>
        <div class="ed-sched">
          {% for s in schedule %}
          <div class="ed-sched__row">
            {% if s.time %}<span class="ed-sched__time">{{ s.time }}</span>{% endif %}
            <div><div class="ed-sched__t">{{ s.title }}</div>{% if s.body %}<div class="ed-sched__b">{{ s.body }}</div>{% endif %}</div>
          </div>
          {% endfor %}
        </div>
      </div>
      {% endif %}

      {% if event.venue or event.location %}
      <div class="ed-card">
        <h2>Venue</h2>
        <div class="ed-venue__name">{{ event.venue|default(event.location) }}</div>
        {% if event.venue and event.location %}<div class="ed-venue__addr">{{ event.location }}</div>{% endif %}
        {% if event.map_embed %}<a class="ed-maplink" href="{{ event.map_embed }}" target="_blank" rel="noopener">📍 View on map →</a>{% endif %}
      </div>
      {% endif %}

      {# ── THE SMALL PRINT, BEFORE ANYBODY PAYS ───────────────────────────────
         A refund policy discovered after a card has been charged is not a policy, it is a
         complaint waiting to be made — and a question about parking that reaches this
         platform's support desk instead of the organiser is a question nobody can answer. #}
      {% if refund_policy|default('') or attendee_note|default('') or organiser_email|default('') or organiser_phone|default('') %}
      <div class="ed-card">
        <h2>Good to know</h2>
        <dl class="ed-fine">
          {% if attendee_note|default('') %}
          <dt>Before you come</dt><dd>{{ attendee_note }}</dd>
          {% endif %}
          {% if refund_policy|default('') %}
          <dt>Refunds &amp; transfers</dt><dd>{{ refund_policy }}</dd>
          {% endif %}
          {% if organiser_email|default('') or organiser_phone|default('') %}
          <dt>Questions about this event</dt>
          <dd>
            {% if organiser_email|default('') %}<a href="mailto:{{ organiser_email }}">{{ organiser_email }}</a>{% endif %}
            {% if organiser_email|default('') and organiser_phone|default('') %} · {% endif %}
            {% if organiser_phone|default('') %}<a href="tel:{{ organiser_phone|replace({' ': ''}) }}">{{ organiser_phone }}</a>{% endif %}
          </dd>
          {% endif %}
        </dl>
      </div>
      {% endif %}
    </div>

    {# ── RSVP rail ── #}
    <aside class="ed-rail">
      {% if is_past %}
        <div class="ed-rsvp">
          <span class="ed-rsvp__eyebrow">Closed</span>
          <h2>This event has ended</h2>
          <p class="ed-past">Thanks to everyone who joined{% if reg_count %} — {{ reg_count }} registered{% endif %}. Catch the next one on the <a href="/events" style="color:var(--ag-green);font-weight:600">events calendar</a>.</p>
        </div>
      {% elseif sales_closed|default('') %}
        {# A cutoff BEFORE the event date, which almost every organiser needs for catering
           and badges. Said with its date rather than as a bare "closed", because the two
           are different amounts of respect for somebody who arrived a day late. #}
        <div class="ed-rsvp">
          <span class="ed-rsvp__eyebrow" style="color:#b42318">Registration closed</span>
          <h2>Bookings have closed</h2>
          <p class="ed-past">{{ sales_closed }} The event itself still goes ahead — if you need to come, please
            {% if organiser_email|default('') %}email <a href="mailto:{{ organiser_email }}" style="color:var(--ag-green);font-weight:600">{{ organiser_email }}</a>{% else %}contact the organisers{% endif %}.</p>
        </div>
      {% elseif is_full %}
        <div class="ed-rsvp">
          <span class="ed-rsvp__eyebrow" style="color:#b42318">Fully booked</span>
          <h2>This event is full</h2>
          <p class="ed-past">All {{ capacity }} places have been reserved. Join the <a href="/community" style="color:var(--ag-green);font-weight:600">community</a> to hear first about the next one — and any released places.</p>
        </div>
      {% else %}
        <div class="ed-rsvp" id="ed-rsvp" x-data="evReg('{{ event.slug|e('js') }}', '{{ csrf_token|e('js') }}', {{ reg_count }}, {{ tiers ? 'true' : 'false' }}, {{ access_code|default('')|json_encode }}, {{ waitlist_open|default(false) ? 'true' : 'false' }})">
          <div x-show="step==='form'">
            <div class="ed-rsvp__top">
              <span class="ed-rsvp__eyebrow">{{ tiers ? 'Tickets' : 'Free registration' }}</span>
              <span class="ed-rsvp__count" x-text="count + ' registered'"></span>
            </div>
            {% if pct_sold is not null %}
            <div style="margin-top:12px">
              <div class="ed-sold__top"><span>{{ pct_sold >= 80 ? 'Selling fast' : 'Filling up' }}</span><span>{{ pct_sold }}% full</span></div>
              <div class="ed-sold__bar"><span class="ed-sold__fill" style="width:{{ pct_sold }}%"></span></div>
            </div>
            {% endif %}
            {% if tiers %}
            {# Tiers are rows now, each with its OWN attendee limit — so a tier can be sold
               out while the event is not, and it says which of those it is rather than just
               going grey. `state` is the one word the branch reads: open / sold_out / early
               / closed, each a different sentence to somebody who wants to come. #}
            <div style="margin-top:8px">
              {% for t in tiers %}
                {% set gone = (t.state|default('open')) == 'sold_out' %}
                {# A sold-out tier stays PRESSABLE when there is a waiting list, because the
                   thing to do about it is join that list — and a disabled button is a dead
                   end for the most motivated person on the page. Without a list it is
                   disabled, since there is genuinely nothing to press. #}
                {% set shut = (t.state|default('open')) != 'open' and not (gone and waitlist_open|default(false)) %}
                <button type="button" class="ed-tier"
                        :class="tierId === {{ t.id|default(0) }} ? 'is-sel' : ''"
                        {{ shut ? 'disabled' : '' }}
                        @click="pick({{ t.id|default(0) }}, {{ t.price_naira|default(0) }}, {{ t.max|default(10) }}, {{ (t.min|default(1)) }}, {{ gone ? 'true' : 'false' }}, {{ waitlist_counts[t.id]|default(0) }})">
                  <span class="ed-tier__radio"></span>
                  <span>
                    <span class="ed-tier__name">{{ t.name }}{% if gone %} · sold out{% endif %}</span>
                    {% if t.description|default('') %}<br><span class="ed-tier__perk">{{ t.description }}</span>{% endif %}
                    {% for p in t.perks|default([]) %}<br><span class="ed-tier__perk">✓ {{ p }}</span>{% endfor %}
                    {% if (t.state|default('open')) != 'open' and t.why|default('') %}<br><span class="ed-tier__perk">{{ t.why }}</span>
                    {% if gone and waitlist_open|default(false) %}<br><span class="ed-tier__perk" style="color:#a47306;font-weight:700">Join the waiting list{% if waitlist_counts[t.id]|default(0) %} · {{ waitlist_counts[t.id] }} waiting{% endif %}</span>{% endif %}
                    {# The scarcity line is a FACT read off the tier's own remaining count,
                       not a nudge: it appears when there are few enough left that somebody
                       deciding today deserves to know, and never otherwise. #}
                    {% elseif t.left is not null and t.left <= 10 %}<br><span class="ed-tier__perk" style="color:#8a2020;font-weight:700">Only {{ t.left }} left</span>
                    {% endif %}
                  </span>
                  <span class="ed-tier__price">{{ (t.price_naira|default(0)) > 0 ? '₦' ~ (t.price_naira|number_format) : 'Free' }}</span>
                </button>
              {% endfor %}
            </div>

            {# Seats, only when the chosen tier allows more than one. A quantity box on a
               one-per-person ticket is a question with a single legal answer. #}
            <div x-show="maxQty > 1 && !soldOut" x-cloak style="margin-top:12px">
              <label class="ed-label" for="edQty">How many seats</label>
              <select id="edQty" class="ed-input" x-model.number="qty">
                <template x-for="n in seatOptions()" :key="n">
                  <option :value="n" x-text="n"></option>
                </template>
              </select>
            </div>

            {# ── DISCOUNT CODE ────────────────────────────────────────────────
               A preview and nothing more: EventTicketService::reserve() prices the row
               again from the tier and the code rows, so what is shown here cannot change
               what anybody is charged. Offered only on a paid tier — a code on a free
               ticket is a field with nothing to do. #}
            <div x-show="price > 0 && !soldOut" x-cloak style="margin-top:12px">
              <label class="ed-label" for="edDisc">Discount code <span style="font-weight:400;color:#92a6a7">(optional)</span></label>
              <div class="ed-disc">
                <input id="edDisc" class="ed-input" x-model="discount" placeholder="ALUMNI20"
                       autocomplete="off" @keydown.enter.prevent="checkCode()">
                <button type="button" :disabled="checking || !discount.trim()" @click="checkCode()"
                        x-text="checking ? '…' : 'Apply'"></button>
              </div>
              <p class="ed-disc__ok" x-show="off > 0" x-cloak x-text="codeNote"></p>
              <p class="ed-disc__no" x-show="codeNote && off === 0" x-cloak x-text="codeNote"></p>
            </div>

            <p class="sub" x-show="price > 0 && !soldOut" x-cloak style="margin-top:10px;font-weight:700;color:#10292C">
              Total:
              <span class="ed-was" x-show="off > 0" x-cloak x-text="'₦' + (price * qty).toLocaleString()"></span>
              <span x-text="'₦' + Math.max(0, price * qty - off).toLocaleString()"></span>
            </p>

            {# ── THE WAITING LIST ─────────────────────────────────────────────
               Shown when the chosen tier has gone and the organiser has opened a list.
               A seat comes back often enough — a declined card, an expired hold, three
               cancellations the week before — that re-selling them to whoever happens to
               be looking is a lottery dressed as a queue. #}
            <div class="ed-wl" x-show="soldOut" x-cloak>
              <div class="ed-wl__h">This ticket has sold out</div>
              <p class="ed-wl__p">
                Leave your details and you will be emailed the moment a seat comes back — a
                declined card, an expired checkout, a cancellation. You get
                {{ constant('AfricaGates\\Services\\EventWaitlist::OFFER_HOURS') }} hours to take it
                before it passes to the next person.
                <span x-show="wlCount > 0" x-cloak x-text="' ' + wlCount + ' already waiting.'"></span>
              </p>
            </div>
            {% else %}
            <h2>Reserve your place</h2>
            <p class="sub">Register and we’ll email you the details and any updates.</p>
            {% endif %}

            {% if paid_tiers and not gateway_ready %}
              {# Said out loud rather than discovered at the end. A buyer who fills in three
                 fields and then meets "payments are unavailable" has been wasted; and the
                 operator needs to know their own site cannot take money. #}
              {# Hidden in waitlist mode: joining a queue asks for no money, and warning
                 somebody about card payment while they are giving you their name reads as
                 a problem with the thing they are actually doing. #}
              <p class="ed-err" style="margin-top:10px" x-show="!soldOut">Card payment is not
                available on this site right now, so paid tickets cannot be bought here. Please
                contact us and we will register you directly.</p>
            {% endif %}
            {% if spots_left is not null %}<p class="sub" style="color:#1a6118;font-weight:600;margin-top:9px">⚡ Only {{ spots_left }} {{ spots_left == 1 ? 'place' : 'places' }} left</p>{% endif %}
            {% include 'partials/member-autofill.twig' with {
              member: member|default(null),
              maf_fields: [
                {sel: '#edName',  key: 'name'},
                {sel: '#edEmail', key: 'email'},
                {sel: '#edPhone', key: 'phone'},
              ],
            } only %}
            <label class="ed-label" for="edName">Full name</label>
            <input id="edName" class="ed-input" x-model="name" placeholder="Amara Okonkwo" autocomplete="name">
            <label class="ed-label" for="edEmail">Email</label>
            <input id="edEmail" class="ed-input" x-model="email" type="email" placeholder="you@email.com" autocomplete="email" @keydown.enter="submit()">
            <label class="ed-label" for="edPhone">Phone</label>
            <input id="edPhone" class="ed-input" x-model="phone" type="tel" inputmode="tel" placeholder="+234…" autocomplete="tel" @keydown.enter="submit()">
            <p class="ed-err" x-show="error" x-cloak x-text="error"></p>
            <button type="button" class="ed-cta" :disabled="busy || !valid" @click="submit()" x-text="cta"></button>
            <div class="ed-secure"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#5a6d6f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>Your details are kept private</div>
          </div>
          <div class="ed-done" x-show="step==='done'" x-cloak>
            <div class="ed-done__ico"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#237b22" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></div>
            <h2 class="ed-card" style="border:0;padding:0;background:none;font-family:var(--ag-font-display);font-weight:700;font-size:1.2rem"
                x-text="wlPlace ? 'You’re on the list ✓' : 'You’re registered ✓'"></h2>
            <p class="sub" x-text="msg"></p>
            {# The ticket, not just a thank-you. It is the thing they will need at the door,
               and burying it in an email that may not arrive for ten minutes is how somebody
               turns up with nothing to show. #}
            <a class="ed-cta" x-show="ticketUrl" x-cloak :href="ticketUrl" style="margin-top:14px;display:block;text-align:center;text-decoration:none">View your ticket →</a>
            <a class="ed-ext" href="/events" style="margin-top:16px">Back to all events →</a>
          </div>
        </div>
      {% endif %}

      {# ── Share and save the date ────────────────────────────────────────────
         The DOWNLOAD is the primary action, not the Google link. A `.ics` file is understood
         by Apple Calendar, Outlook, Thunderbird, Samsung, Fastmail and Google alike, works
         with no account and no third-party page in the middle, and is the only one of the
         two that a phone can open offline. Google keeps its place because a Google user
         genuinely prefers it — but as the second option, not the only one.

         THE `Z` ON THE GOOGLE DATES IS A BUG FIX. This link previously emitted
         `date('Ymd\THis')` with no zone marker. Google reads a bare timestamp as the
         READER's local time, and stored datetimes here are UTC by convention
         ({@see \AfricaGates\Support\Clock}) — so anybody outside UTC was adding the event at
         the wrong hour, silently, with a perfectly plausible-looking entry in their diary.
         `|date('Ymd\THis\Z')` converts and marks it. The same reasoning is why
         {@see \AfricaGates\Support\Ics} emits UTC throughout. #}
      {% if not is_past %}
      {% set gcal = 'https://calendar.google.com/calendar/render?action=TEMPLATE&text=' ~ event.title|url_encode ~ '&dates=' ~ event.event_date|date('Ymd\\THis\\Z') ~ '/' ~ (event.end_date ?: event.event_date)|date('Ymd\\THis\\Z') ~ '&location=' ~ (event.venue ?: event.location)|default('')|url_encode ~ '&details=' ~ event.tagline|default('')|url_encode %}
      <div class="ed-rsvp" x-data="evShare()">
        <p style="margin:0 0 10px;font-size:11px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:#92a6a7">Share &amp; save the date</p>
        <div class="ed-share">
          <button type="button" @click="share()"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4"/></svg>Share</button>
          <a class="ed-cal" href="/events/{{ event.slug|url_encode }}/calendar.ics"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>Add to calendar</a>
        </div>
        <p class="ed-cal__alt">Uses Google Calendar? <a href="{{ gcal }}" target="_blank" rel="noopener">Add it there instead</a>.</p>
        <span x-show="note" x-cloak x-text="note" style="display:block;text-align:center;margin-top:8px;font-size:12px;color:#1a6118;font-weight:600"></span>
      </div>
      {% endif %}
    </aside>
  </div>
</div>

<script nonce="{{ csp_nonce }}">
  function evReg(slug, csrf, count, hasTiers, code, wlOpen){
    return {
      step:'form', name:'', email:'', phone:'', busy:false, error:'', msg:'',
      count: count || 0, hasTiers: !!hasTiers, code: code || '',
      /* The tier is chosen by ID now, not by its NAME. A name is display text an organiser
         may edit after somebody has bought against it, and matching on it is also how
         "VIP" and "V.I.P." became two tiers sharing one limit. */
      tierId: 0, price: 0, qty: 1, minQty: 1, maxQty: 1,
      ticketUrl: '',
      /* Discount state. `off` is what the SERVER said this code takes off — never computed
         here, because a total worked out in the browser is a total anybody can edit, and
         confirm() refuses a payment smaller than the amount on the row. */
      discount: '', off: 0, codeNote: '', checking: false,
      /* Sold out, and whether there is a queue to join about it. */
      soldOut: false, wlOpen: !!wlOpen, wlCount: 0, wlPlace: 0,

      init(){
        /* A percentage code against three seats is not the same number as against one, so a
           quantity change re-prices it. Re-asked rather than scaled here, because scaling in
           the browser would reimplement the rounding rule and eventually disagree with the
           server about what somebody owes. */
        this.$watch('qty', () => { if (this.discount.trim() !== '') this.checkCode(); });
      },

      pick(id, price, max, min, soldOut, wlCount){
        this.tierId = id; this.price = price;
        this.minQty = min || 1;
        this.maxQty = Math.max(this.minQty, max || 1);
        /* Clamp rather than reset: somebody who picked 4 of one tier and switches to
           another that allows 2 meant "as many as I can", not "start again". */
        this.qty = Math.min(Math.max(this.qty, this.minQty), this.maxQty);
        this.soldOut = !!soldOut && this.wlOpen;
        this.wlCount = wlCount || 0;
        /* A code priced against the old tier is not priced against this one. Dropping it
           rather than re-checking it silently is the honest move: the number on screen must
           never belong to a ticket they are no longer buying. */
        this.off = 0; this.codeNote = '';
        this.error = '';
      },
      seatOptions(){
        var out = [];
        for (var n = this.minQty; n <= this.maxQty; n++) out.push(n);
        return out;
      },
      get valid(){
        return this.name.trim() !== '' && /.+@.+\..+/.test(this.email)
          && this.phone.replace(/\D/g,'').length >= 7 && (!this.hasTiers || this.tierId > 0);
      },
      get cta(){
        if (this.soldOut) return this.busy ? 'Adding you…' : 'Join the waiting list';
        if (this.busy) return this.due > 0 ? 'Taking you to payment…' : 'Registering…';
        if (this.due > 0) return 'Pay ₦' + this.due.toLocaleString();
        if (this.price > 0) return 'Get my ticket — free with code';
        return this.hasTiers ? 'Get my ticket' : 'Register — free';
      },
      get due(){
        return Math.max(0, this.price * this.qty - this.off);
      },

      /* Ask the server what a code does. A preview only — see the panel comment. */
      async checkCode(){
        var typed = this.discount.trim();
        if(typed === '' || this.tierId === 0){ return; }
        this.checking = true;
        try{
          var r = await fetch('/events/'+slug+'/quote', {
            method:'POST', headers:{'Content-Type':'application/x-www-form-urlencoded'},
            body: new URLSearchParams({ _token: csrf, tier_id:this.tierId,
                                        quantity:this.qty, discount:typed, email:this.email })
          });
          var d = await r.json().catch(function(){ return {}; });
          this.off = d.applied ? (d.off || 0) : 0;
          this.codeNote = d.message || (d.applied ? '' : 'That code could not be applied.');
        }catch(e){ this.off = 0; this.codeNote = 'We could not check that code just now.'; }
        finally{ this.checking = false; }
      },

      async submit(){
        if(this.name.trim()===''){ this.error='Please enter your name.'; return; }
        if(!/.+@.+\..+/.test(this.email)){ this.error='Please enter a valid email.'; return; }
        if(this.phone.replace(/\D/g,'').length < 7){ this.error='Please enter a valid phone number.'; return; }
        if(this.hasTiers && this.tierId === 0){ this.error='Please choose a ticket type.'; return; }
        if(this.soldOut){ return this.joinList(); }
        this.busy=true; this.error='';
        try{
          var r = await fetch('/events/'+slug+'/register', {
            method:'POST', headers:{'Content-Type':'application/x-www-form-urlencoded'},
            body: new URLSearchParams({ _token: csrf, name:this.name, email:this.email,
                                        phone:this.phone, tier_id:this.tierId,
                                        quantity:this.qty, code:this.code,
                                        discount:this.discount.trim() })
          });
          var d = await r.json().catch(function(){ return {}; });

          /* A paid tier answers with a hand-off URL instead of a confirmation. The seats
             are already held server-side by then, so leaving the button spinning while the
             browser navigates is honest: nothing more is asked of them here. */
          if(d.success && d.pay){ window.location.href = d.pay; return; }

          if(d.success){
            this.msg = d.message || 'You’re registered.';
            this.ticketUrl = d.ticket_url || '';
            this.count += (this.qty || 1);
            this.step='done';
          } else {
            /* The seats went while they were filling the form in. If there is a list, offer
               it here rather than making them find the tier button again — the answer to
               "it sold out just now" is the queue, and they are already typed in. */
            if(d.full && d.waitlist){ this.soldOut = true; this.error = d.message || ''; }
            else { this.error = d.message || 'Could not register. Please try again.'; }
          }
        }catch(e){ this.error='Network error. Please try again.'; }
        finally{ this.busy=false; }
      },

      async joinList(){
        this.busy=true; this.error='';
        try{
          var r = await fetch('/events/'+slug+'/waitlist', {
            method:'POST', headers:{'Content-Type':'application/x-www-form-urlencoded'},
            body: new URLSearchParams({ _token: csrf, name:this.name, email:this.email,
                                        phone:this.phone, tier_id:this.tierId })
          });
          var d = await r.json().catch(function(){ return {}; });
          if(d.success){
            this.wlPlace = d.place || 0;
            this.msg = (d.message || 'You are on the list.')
                     + (d.place ? ' You are number ' + d.place + ' in the queue.' : '');
            this.ticketUrl = '';
            this.step='done';
          } else {
            this.error = d.message || 'Could not add you to the list. Please try again.';
          }
        }catch(e){ this.error='Network error. Please try again.'; }
        finally{ this.busy=false; }
      }
    };
  }
  function evShare(){
    return {
      note:'',
      async share(){
        var url = location.href;
        try{ if(navigator.share){ await navigator.share({ title: document.title, url: url }); return; } }
        catch(e){ if(e && e.name === 'AbortError') return; }
        try{ await navigator.clipboard.writeText(url); }catch(e){}
        this.note = 'Link copied ✓'; clearTimeout(this._t); this._t = setTimeout(function(){}, 0);
        var self = this; this._t = setTimeout(function(){ self.note = ''; }, 2000);
      }
    };
  }
</script>
{% endblock %}
