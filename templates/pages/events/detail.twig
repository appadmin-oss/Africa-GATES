{% extends "layout/gates.twig" %}

{# ── IS THIS EVENT A FUNDRAISER? ───────────────────────────────────────────────
   Derived from the live appeals already joined to the event rather than from a new
   flag on the row. An event that is raising for something IS one with an open
   appeal attached, and a second boolean beside it is a second thing to keep in
   step — the first time somebody closes the appeal and forgets the flag, the page
   asks for money for a campaign that has ended.

   At TEMPLATE scope on purpose: a `{% set %}` inside a `{% block %}` is invisible
   to every other block and renders as null with no error, which has taken out this
   codebase's navigation once and a share link a second time. #}
{% set is_fundraiser = appeals|default([]) is not empty %}
{% set appeal_for = is_fundraiser ? (appeals|first).campaign.title : '' %}

{% block head_styles %}
<style nonce="{{ csp_nonce }}">
  body[data-page="events"]{ background:#eef0ec; color:var(--ag-ink); }
  [x-cloak]{ display:none !important; }
  .ed{ max-width:1080px; margin:0 auto; padding:18px var(--ag-gutter,32px) clamp(3rem,6vw,4rem); }
  .ed-crumb{ font-size:12.5px; color:#5a6d6f; margin-bottom:14px; }
  .ed-crumb a{ color:#5a6d6f; text-decoration:none; }
  .ed-crumb b{ color:var(--ag-ink); font-weight:500; }

  .ed-hero{ position:relative; overflow:hidden; border-radius:24px; min-height:320px; display:flex; align-items:flex-end;
    padding:clamp(1.8rem,3vw,2.4rem); background:radial-gradient(130% 130% at 78% 0%,#1d5b2a,#10292C 60%); }
  .ed-hero__bg{ position:absolute; inset:0; width:100%; height:100%; object-fit:cover; opacity:.42; }
  .ed-hero__orb{ position:absolute; right:-60px; top:-60px; width:300px; height:300px; border-radius:50%; background:radial-gradient(circle,rgba(212,154,14,.3),transparent 68%); }
  .ed-hero__in{ position:relative; }
  .ed-hero__badge{ display:inline-flex; align-items:center; gap:7px; font-size:11px; font-weight:600; letter-spacing:.1em; text-transform:uppercase; color:#fbc329; background:rgba(212,154,14,.18); padding:7px 14px; border-radius:999px; }
  .ed-hero__title{ margin:16px 0 0; font-family:var(--ag-font-display); font-weight:800; font-size:clamp(2rem,4.6vw,2.9rem); line-height:1.03; letter-spacing:-.02em; color:#fff; }
  .ed-hero__meta{ display:flex; flex-wrap:wrap; gap:20px; margin-top:18px; }
  .ed-hero__meta span{ display:flex; align-items:center; gap:8px; color:rgba(255,255,255,.85); font-size:14px; }

  .ed-grid{ display:grid; grid-template-columns:1fr 340px; gap:28px; align-items:start; margin-top:28px; }
  .ed-main{ display:flex; flex-direction:column; gap:24px; min-width:0; }
  .ed-card{ background:var(--ag-surface); border:1px solid rgba(16,41,44,.08); border-radius:20px; padding:clamp(1.4rem,3vw,1.75rem); }
  .ed-card h2{ margin:0 0 12px; font-family:var(--ag-font-display); font-weight:700; font-size:1.3rem; color:var(--ag-ink); }
  .ed-card p{ margin:0; font-size:15px; line-height:1.7; color:#3a4448; white-space:pre-line; }
  .ed-venue__name{ font-weight:600; font-size:15px; color:var(--ag-ink); margin-top:4px; }
  .ed-venue__addr{ font-size:13.5px; color:#626a6e; margin-top:3px; }

  .ed-rail{ position:sticky; top:88px; display:flex; flex-direction:column; gap:18px; }
  .ed-rsvp{ background:var(--ag-surface); border:1px solid rgba(16,41,44,.08); border-radius:20px; padding:22px; box-shadow:0 12px 36px -20px rgba(16,41,44,.35); }
  .ed-rsvp__top{ display:flex; align-items:center; justify-content:space-between; }
  .ed-rsvp__eyebrow{ font-size:12px; font-weight:600; letter-spacing:.06em; text-transform:uppercase; color:var(--ag-green); }
  /* The fundraiser line. Sits between the eyebrow and the tier list because it is the
     thing that changes what the prices below MEAN, and a reader who meets it after the
     prices has already decided. */
  .ed-rsvp__fund{ margin:10px 0 0; font-size:13px; line-height:1.55; color:#3c4649;
    padding-left:11px; border-left:2px solid rgba(243,180,22,.55); }
  .ed-rsvp__fund strong{ font-weight:600; color:var(--ag-ink); }
  .ed-rsvp__count{ font:700 13px/1 var(--ag-font-mono); color:#5a6d6f; }
  .ed-rsvp h2{ margin:10px 0 0; font-family:var(--ag-font-display); font-weight:700; font-size:1.2rem; color:var(--ag-ink); }
  .ed-rsvp p.sub{ margin:7px 0 0; font-size:13px; line-height:1.5; color:#626a6e; }
  .ed-label{ display:block; font-size:12px; font-weight:600; color:#4a5256; margin:14px 0 6px; }
  .ed-input{ width:100%; border:1px solid rgba(16,41,44,.16); border-radius:11px; padding:12px 14px; font-family:inherit; font-size:16px; color:var(--ag-ink); outline:none; transition:border-color .15s; }
  .ed-input:focus{ border-color:var(--ag-green); }
  .ed-cta{ width:100%; margin-top:16px; cursor:pointer; border:none; background:var(--ag-green); color:#fff; font-family:inherit; font-weight:600; font-size:15px; padding:13px; border-radius:999px; transition:background .15s; }
  .ed-cta:hover{ background:var(--ag-green-dark); }
  .ed-cta:disabled{ background:#dfe4e3; color:#5b6669; opacity:1; cursor:not-allowed; }
  .ed-secure{ display:flex; align-items:center; justify-content:center; gap:7px; margin-top:12px; font-size:11.5px; color:#5a6d6f; }
  .ed-err{ font-size:13px; color:#b42318; background:#fdecec; border:1px solid rgba(180,35,24,.18); border-radius:10px; padding:9px 12px; margin-top:12px; }
  .ed-ext{ display:block; text-align:center; margin-top:12px; font-size:12.5px; color:var(--ag-green); font-weight:600; text-decoration:none; }
  .ed-done{ text-align:center; padding:8px 0; }
  .ed-done__ico{ width:60px; height:60px; margin:0 auto 12px; border-radius:50%; background:#effaf0; display:flex; align-items:center; justify-content:center; }
  .ed-done h2{ margin:0; }
  .ed-past{ font-size:14px; color:#626a6e; margin-top:10px; line-height:1.6; }

  /* early-bird banner */
  .ed-eb{ display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:12px; background:#eafaf0; border:1px solid rgba(35,123,34,.2); border-radius:14px; padding:12px 18px; margin-bottom:16px; }
  .ed-eb__t{ font-weight:600; font-size:14px; color:#10292C; }
  .ed-eb__cta{ font-size:13px; font-weight:600; color:var(--ag-green); text-decoration:none; white-space:nowrap; }
  /* run of show */
  .ed-sched__row{ display:flex; gap:18px; padding:13px 0; border-bottom:1px solid rgba(16,41,44,.06); }
  .ed-sched__row:last-child{ border-bottom:0; padding-bottom:0; }
  .ed-sched__time{ flex:none; width:72px; font:700 13px/1.4 var(--ag-font-mono,monospace); color:#966905; }
  .ed-sched__t{ font-weight:600; font-size:14.5px; color:var(--ag-ink); }
  .ed-sched__b{ font-size:13px; color:var(--ag-ink-soft,#626a6e); margin-top:2px; }
  .ed-maplink{ display:inline-flex; align-items:center; gap:6px; margin-top:14px; font-size:13px; font-weight:600; color:var(--ag-green); text-decoration:none; }
  /* agenda — sessions as rows, grouped by day */
  .ed-ag__day + .ed-ag__day{ margin-top:22px; }
  .ed-ag__dayh{ display:flex; align-items:center; gap:10px; font-size:12px; font-weight:700; letter-spacing:.07em; text-transform:uppercase; color:var(--ag-green); }
  .ed-ag__dayh::after{ content:''; flex:1; height:1px; background:rgba(16,41,44,.1); }
  .ed-ag__row{ display:flex; gap:16px; padding:14px 0; border-bottom:1px solid rgba(16,41,44,.06); }
  .ed-ag__row:last-child{ border-bottom:0; padding-bottom:0; }
  .ed-ag__time{ flex:none; width:104px; font-family:var(--ag-font-mono,monospace); font-size:12.5px; font-weight:700; line-height:1.5; color:#966905; }
  .ed-ag__t{ font-weight:600; font-size:15px; color:var(--ag-ink); }
  .ed-ag__b{ font-size:13.5px; line-height:1.65; color:var(--ag-ink-soft,#626a6e); margin-top:4px; white-space:pre-line; }
  .ed-ag__tags{ display:flex; flex-wrap:wrap; gap:6px; margin-top:7px; }
  .ed-ag__tag{ font-size:11px; font-weight:600; padding:3px 9px; border-radius:999px; background:#eef2ee; color:#4a5256; }
  .ed-ag__tag.is-track{ background:#eafaf0; color:#1a6118; }
  .ed-ag__who{ font-size:12.5px; color:#5a6d6f; margin-top:6px; }
  .ed-ag__filter{ display:flex; flex-wrap:wrap; gap:7px; margin-bottom:16px; }
  .ed-ag__fb{ cursor:pointer; font-family:inherit; font-size:12px; font-weight:600; padding:6px 13px; border-radius:999px; border:1px solid rgba(16,41,44,.14); background:#fff; color:#4a5256; }
  .ed-ag__fb.is-on{ background:var(--ag-green); border-color:var(--ag-green); color:#fff; }
  /* the small print an organiser writes once */
  .ed-fine dt{ font-size:12px; font-weight:700; letter-spacing:.05em; text-transform:uppercase; color:var(--ag-ink-soft,#626a6e); margin-top:14px; }
  .ed-fine dt:first-child{ margin-top:0; }
  .ed-fine dd{ margin:5px 0 0; font-size:14px; line-height:1.7; color:#3a4448; white-space:pre-line; }
  .ed-fine a{ color:var(--ag-green); font-weight:600; text-decoration:none; }
  /* ── THE VENDOR CALL ──────────────────────────────────────────────────────
     A different audience from everything else on this page. Attendees are being sold a
     seat in the rail on the right; this is a business being told it can trade here, and
     the two do not compete for the same person's attention — which is exactly why it is
     in the main column and low, rather than a second button beside Register.

     Kale ground, not the page's white card. Not decoration: it is the one block here
     addressed to somebody who did not come for a ticket, and a card identical to "About
     this event" reads as more of the same and is scrolled past. */
  .ed-vend{ position:relative; overflow:hidden; border-radius:20px; padding:clamp(1.4rem,3vw,1.8rem);
    background:linear-gradient(135deg,#10292C,#164a2c); color:#eef5f0; }
  .ed-vend__orb{ position:absolute; inset:auto -60px -90px auto; width:230px; height:230px;
    border-radius:50%; background:radial-gradient(circle at 35% 35%,rgba(127,200,124,.34),transparent 68%);
    pointer-events:none; }
  .ed-vend__in{ position:relative; }
  .ed-vend__kick{ display:block; font-family:var(--ag-font-mono,monospace); font-size:11px;
    font-weight:700; letter-spacing:.16em; text-transform:uppercase; color:#7FC87C; }
  .ed-vend h2{ margin:8px 0 0; font-family:var(--ag-font-display,serif); font-weight:700;
    font-size:1.35rem; line-height:1.25; color:#fff; }
  .ed-vend p{ margin:9px 0 0; font-size:14.5px; line-height:1.7; color:#c9dbd2; white-space:normal; }
  /* The facts, as a row of small statements rather than prose. A vendor is deciding on
     three numbers — how many places, from what price, by when — and a paragraph makes
     them read forty words to find each one. */
  .ed-vend__facts{ display:flex; flex-wrap:wrap; gap:8px; margin:14px 0 0; padding:0; list-style:none; }
  .ed-vend__facts li{ display:inline-flex; align-items:center; gap:7px; padding:6px 12px;
    border:1px solid rgba(255,255,255,.18); border-radius:999px; background:rgba(255,255,255,.06);
    font-size:12.5px; font-weight:600; color:#eef5f0; }
  .ed-vend__facts b{ font-family:var(--ag-font-mono,monospace); font-weight:700; color:#fff; }
  .ed-vend__act{ display:flex; flex-wrap:wrap; align-items:center; gap:12px 16px; margin-top:18px; }
  .ed-vend__cta{ display:inline-flex; align-items:center; gap:8px; padding:12px 22px;
    border-radius:999px; background:#f3b416; color:#3a2800; font-weight:700; font-size:14.5px;
    text-decoration:none; transition:transform .15s, background .15s; }
  .ed-vend__cta:hover{ background:#ffc633; transform:translateY(-1px); }
  .ed-vend__cta:focus-visible{ outline:3px solid #7FC87C; outline-offset:3px; }
  /* #c9dbd2 on this ground measures 8.4:1; the gold used for the CTA fill would be 2.9:1
     as text here, which is why the reassurance line is not gold. */
  .ed-vend__free{ font-size:12.5px; color:#c9dbd2; }
  .ed-vend__free b{ color:#fff; font-weight:600; }
  /* A shut call gets a line, not a card. It is still worth saying — a vendor who arrived
     late is owed the date rather than silence — but it is not worth a gold button. */
  .ed-vend--shut{ background:none; border:1px solid rgba(16,41,44,.12); color:#3a4448;
    padding:14px clamp(1rem,2.4vw,1.25rem); border-radius:16px; }
  .ed-vend--shut .ed-vend__kick{ color:var(--ag-green,#237b22); }
  .ed-vend--shut p{ color:#3a4448; font-size:14px; }
  .ed-vend--shut a{ color:var(--ag-green,#237b22); font-weight:600; }
  /* discount code */
  .ed-disc{ display:flex; gap:8px; margin-top:6px; }
  .ed-disc .ed-input{ text-transform:uppercase; letter-spacing:.04em; }
  .ed-disc button{ flex:none; cursor:pointer; border:1px solid rgba(16,41,44,.16); background:#fff; color:#10292C; font-family:inherit; font-size:13px; font-weight:600; padding:0 15px; border-radius:11px; }
  .ed-disc button:disabled{ opacity:.5; cursor:not-allowed; }
  .ed-disc__ok{ font-size:12.5px; font-weight:600; color:#1a6118; margin-top:7px; }
  .ed-disc__no{ font-size:12.5px; color:#8a5a00; margin-top:7px; }
  .ed-was{ text-decoration:line-through; color:var(--ag-ink-soft,#626a6e); font-weight:500; }
  /* waitlist */
  .ed-wl{ background:#fff8ec; border:1px solid rgba(212,154,14,.28); border-radius:14px; padding:14px 16px; margin-top:14px; }
  .ed-wl__h{ font-weight:700; font-size:13.5px; color:#7a4d00; }
  .ed-wl__p{ font-size:12.5px; line-height:1.6; color:#7a5a1a; margin:5px 0 0; }
  .ed-wl__go{ width:100%; margin-top:10px; cursor:pointer; border:none; background:#a47306; color:#fff; font-family:inherit; font-weight:600; font-size:13.5px; padding:11px; border-radius:999px; }
  .ed-wl__go:disabled{ opacity:.6; cursor:not-allowed; }
  /* tiers + sold bar */
  .ed-sold__top{ display:flex; justify-content:space-between; font-size:12px; color:#5a6d6f; }
  .ed-sold__bar{ height:7px; border-radius:5px; background:#eef2ee; overflow:hidden; margin:7px 0 4px; }
  .ed-sold__fill{ display:block; height:100%; border-radius:5px; background:linear-gradient(90deg,#d49a0e,#fbc329); }
  /* align-items:flex-start, not center: a tier with three perks is a tall card, and a radio
     floating halfway down one reads as belonging to whichever perk it happens to sit beside. */
  /* min-height, not just padding: a one-line tier row came to 43.6px, which clears WCAG
     2.5.8's 24px AA floor but misses 2.5.5's 44px and Android's 48dp guidance. This is a
     row people press three or four times while comparing, on a phone, with a thumb. */
  .ed-tier{ position:relative; width:100%; min-height:48px; text-align:left; border:1.5px solid rgba(16,41,44,.12); background:#fff; border-radius:13px; padding:12px 14px; display:flex; align-items:flex-start; gap:11px; cursor:pointer; margin-top:9px; font-family:inherit;
    /* The tone's own colour, overridden per row from the event's accent ladder. Declared
       here so a row whose hue never arrives still animates in the platform's green rather
       than in `transparent`, which is invisible and reads as the effect being broken. */
    --tier-hue:var(--ag-green,#237b22);
    --tier-ms:950ms;
    --tier-heat:.34;
    transition:border-color var(--ag-dur-fast,.15s) var(--ag-ease,ease),
               background var(--ag-dur-fast,.15s) var(--ag-ease,ease),
               box-shadow var(--ag-dur,.25s) var(--ag-ease,ease); }
  /* The BORDER takes the edge, not the identity: a pale fill as a 1.5px line on white is
     an absence rather than a mark, and a selected-state indicator owes 3:1 (WCAG 1.4.11).
     The colour the organiser chose is what runs the rim as light — see .ed-fx. */
  .ed-tier.is-sel{ border-color:var(--tier-edge); background:#f6fcf5; }
  /* The persistent warm inner light on the chosen row — an INSET rim, not a wash across the
     face. A tinted face would sit behind `.ed-tier__perk` at 11.5px, and that text is
     #626a6e, which is AA on white with little room to spend. The rim carries the same
     "this one is chosen" signal and touches no text. A static value with a transition,
     never a keyframe: box-shadow is the one property here that repaints. */
  .ed-tier.is-sel{ box-shadow:inset 0 0 0 1px color-mix(in srgb, var(--tier-hue) 26%, transparent),
                              inset 0 1px 12px -6px color-mix(in srgb, var(--tier-hue) 60%, transparent); }
  .ed-tier:disabled{ opacity:.5; cursor:not-allowed; }
  /* Focus is drawn on the row, and it has to survive the selected state's border change —
     an outline rather than a border swap, so the two cannot cancel each other out. */
  .ed-tier:focus-visible{ outline:2px solid var(--ag-green,#237b22); outline-offset:2px; }
  .ed-tier__radio{ flex:none; width:18px; height:18px; margin-top:2px; border-radius:50%; border:2px solid rgba(16,41,44,.25); display:flex; align-items:center; justify-content:center; }
  /* `background: fill` inside a `1px solid edge` ring — the printed ticket's `.tk__dot`,
     to the pixel. The organiser picks one colour and sees the same object in the admin
     picker, on this row, and on the door. */
  .ed-tier.is-sel .ed-tier__radio{ border-color:var(--tier-edge); }
  .ed-tier.is-sel .ed-tier__radio::after{ content:''; width:9px; height:9px; border-radius:50%;
    background:var(--tier-hue); box-shadow:0 0 0 1px var(--tier-edge); }
  .ed-tier__name{ font-weight:600; font-size:14px; color:var(--ag-ink); }
  .ed-tier__perk{ font-size:11.5px; color:var(--ag-ink-soft,#626a6e); }
  .ed-tier__price{ flex:none; margin-left:auto; padding-left:8px; font-family:var(--ag-font-mono,monospace); font-size:14px; font-weight:700; line-height:1.4; white-space:nowrap; color:var(--ag-ink); }

  /* ══════════════════════════════════════════════════════════════════════════
     THE SELECTION LIGHT
     ══════════════════════════════════════════════════════════════════════════

     Choosing a tier is COMPARISON, not commitment — people press General, Supporter,
     Patron, then General again. So the press gets light rather than particles, and the
     light travels the card's RIM. Nothing crosses the card's face: an overlay there dims
     the price somebody is in the middle of reading, which is the one thing they came for.

     Everything below animates `transform` or `opacity` and nothing else, so the whole
     effect composites and the sidebar never repaints. The two exceptions are stated where
     they are: the chosen row's inner rim and the card's lift shadow are static box-shadow
     values crossfaded by opacity, because box-shadow as a keyframe repaints every frame.

     ── ON NOT USING DISCS THAT BLEED PAST THE CARD ─────────────────────────

     The design put the bloom on absolutely-positioned discs extending ~22px beyond the
     card. At 390px the sidebar's gutter is not 22px, and an element that wide is a
     horizontal scrollbar on the whole document. `box-shadow` does not contribute to scroll
     width — only element boxes do — so the bloom is a shadow on a layer pinned to the
     card's own bounds. Same light, no geometry outside the card, and the 390px check
     cannot fail by construction rather than by measurement.

     ── AND ON RESTARTING ──────────────────────────────────────────────────

     A finished CSS animation does NOT restart when the same `animation-name` is re-applied.
     Pressing one tier twice would do nothing at all. Every animated thing here therefore
     has two identical keyframe sets under different names, and the card carries `.is-a` or
     `.is-b` by `burst % 2`. The NAME CHANGE is what restarts it. This is the mechanism the
     handoff called out as the one not to simplify, and it is used for every layer rather
     than only the focusable ones — re-keying a subtree in Alpine means an `x-for` over a
     one-item array, which churns the DOM on every press for no gain.
     ══════════════════════════════════════════════════════════════════════════ */

  .ed-rsvp{ position:relative; }
  /* NOT overflow:hidden on the card — it would clip the whole effect. */
  .ed-fx{ position:absolute; inset:0; border-radius:20px; pointer-events:none; z-index:0; }
  .ed-fx > *{ position:absolute; opacity:0; will-change:transform,opacity; }
  /* Everything in the card's own content sits above the light. Scoped to the registration
     card by ID: `.ed-rsvp` is also the class on the share panel and on the fully-booked and
     past-event cards, and giving every child of those a stacking context to solve a problem
     they do not have is how a change to one card turns up as a bug on another. */
  #ed-rsvp > *:not(.ed-fx){ position:relative; z-index:1; }

  /* 1–2 · the lift. A pre-painted shadow crossfaded in, so the card rises without a
     box-shadow keyframe. Two layers: neutral depth, then the tier's own colour. */
  .ed-fx__lift, .ed-fx__lifttint{ inset:0; border-radius:20px; }
  .ed-fx__lift{ box-shadow:0 26px 46px -22px rgba(16,41,44,.44); }
  .ed-fx__lifttint{ box-shadow:0 22px 40px -20px color-mix(in srgb, var(--tier-hue) 70%, transparent); }

  /* 3 · the bloom out from the perimeter */
  .ed-fx__glow{ inset:0; border-radius:20px;
    box-shadow:0 0 0 1.5px color-mix(in srgb, var(--tier-hue) 70%, transparent),
               0 0 18px 2px color-mix(in srgb, var(--tier-hue) 45%, transparent); }

  /* 4 · the strike point, where the light enters at the top edge */
  .ed-fx__impact{ top:-1px; left:50%; width:34%; height:3px; border-radius:999px; transform:translateX(-50%) scaleX(.2);
    background:linear-gradient(90deg,transparent,color-mix(in srgb, var(--tier-hue) 85%, #fff),transparent); }

  /* 5–8 · the arcs. The ring is what confines the rotating conic gradients to the rim: its
     radius stays 2px larger than the card's, and it is the ONE place overflow:hidden is
     correct. The card's own opaque face masks the middle, which is why only the lit edge
     is ever visible. */
  .ed-fx__ring{ position:absolute; inset:-2px; border-radius:22px; overflow:hidden; opacity:1; }
  .ed-fx__ring > *{ position:absolute; inset:-40%; opacity:0; will-change:transform,opacity; }
  .ed-fx__tail{ background:conic-gradient(from -52deg, transparent 0turn, color-mix(in srgb, var(--tier-hue) 40%, transparent) .04turn, transparent .1turn); }
  .ed-fx__head{ background:conic-gradient(from 0deg, transparent 0turn, var(--tier-hue) .035turn, transparent .075turn); }
  .ed-fx__flash{ background:conic-gradient(from 26deg, transparent 0turn, #fff .018turn, transparent .04turn); }
  .ed-fx__flash2{ background:conic-gradient(from 26deg, transparent 0turn, #fff .014turn, transparent .032turn); }

  /* 9 · the border holds after the arc has gone, then cools */
  /* The rim HOLDS after the arc has gone, long enough to read as a border rather than as
     motion — so it is the one effect layer that takes the edge. Everything that moves takes
     the identity. */
  .ed-fx__rim{ inset:0; border-radius:20px; box-shadow:0 0 0 1.5px var(--tier-edge); }

  /* 10 · sparks off the top-right corner. Seven, on the peak tone only.
     They fan up and INWARD rather than out past the right edge. Outward is the obvious
     direction and it is the one that puts a positioned element ~25px beyond the card — at
     390px the sidebar's gutter is 16px, and an element wider than its gutter is a
     horizontal scrollbar on the whole document. Up-and-left sheds off the same corner,
     stays inside the card's width by construction, and only ever bleeds vertically, which
     cannot scroll anything. */
  .ed-fx__spark{ top:7px; right:16px; width:3px; height:3px; border-radius:50%;
    background:color-mix(in srgb, var(--tier-hue) 30%, #fff); }

  /* ── the keyframes, twice each ─────────────────────────────────────────── */
  @keyframes edLiftA{ 0%{opacity:0;transform:translateY(6px)} 30%{opacity:1;transform:translateY(0)} 100%{opacity:0;transform:translateY(0)} }
  @keyframes edLiftB{ 0%{opacity:0;transform:translateY(6px)} 30%{opacity:1;transform:translateY(0)} 100%{opacity:0;transform:translateY(0)} }
  @keyframes edGlowA{ 0%{opacity:0;transform:scale(.985)} 22%{opacity:1;transform:scale(1)} 100%{opacity:0;transform:scale(1)} }
  @keyframes edGlowB{ 0%{opacity:0;transform:scale(.985)} 22%{opacity:1;transform:scale(1)} 100%{opacity:0;transform:scale(1)} }
  @keyframes edImpactA{ 0%{opacity:0;transform:translateX(-50%) scaleX(.2)} 18%{opacity:1;transform:translateX(-50%) scaleX(1)} 100%{opacity:0;transform:translateX(-50%) scaleX(1.15)} }
  @keyframes edImpactB{ 0%{opacity:0;transform:translateX(-50%) scaleX(.2)} 18%{opacity:1;transform:translateX(-50%) scaleX(1)} 100%{opacity:0;transform:translateX(-50%) scaleX(1.15)} }
  /* The head overshoots to 1.055turn and settles — the arc arriving back at the strike
     point and rocking, rather than stopping dead on the number it was aiming at. */
  @keyframes edArcA{ 0%{opacity:0;transform:rotate(0turn)} 8%{opacity:1} 88%{transform:rotate(calc(var(--tier-laps,1) * 1turn + .055turn))} 100%{opacity:0;transform:rotate(calc(var(--tier-laps,1) * 1turn))} }
  @keyframes edArcB{ 0%{opacity:0;transform:rotate(0turn)} 8%{opacity:1} 88%{transform:rotate(calc(var(--tier-laps,1) * 1turn + .055turn))} 100%{opacity:0;transform:rotate(calc(var(--tier-laps,1) * 1turn))} }
  @keyframes edLapA{ 0%{opacity:0;transform:rotate(0turn)} 10%{opacity:1} 100%{opacity:0;transform:rotate(1turn)} }
  @keyframes edLapB{ 0%{opacity:0;transform:rotate(0turn)} 10%{opacity:1} 100%{opacity:0;transform:rotate(1turn)} }
  @keyframes edRimA{ 0%{opacity:0} 12%{opacity:1} 62%{opacity:1} 100%{opacity:0} }
  @keyframes edRimB{ 0%{opacity:0} 12%{opacity:1} 62%{opacity:1} 100%{opacity:0} }
  @keyframes edSparkA{ 0%{opacity:0;transform:translate(0,0) scale(1)} 12%{opacity:1} 100%{opacity:0;transform:translate(var(--sx,10px),var(--sy,-14px)) scale(.3)} }
  @keyframes edSparkB{ 0%{opacity:0;transform:translate(0,0) scale(1)} 12%{opacity:1} 100%{opacity:0;transform:translate(var(--sx,10px),var(--sy,-14px)) scale(.3)} }
  /* Anticipation dip, then lift. 520ms fixed, not scaled by tone: this is the physical
     press and it feels the same whichever row it is. */
  @keyframes edRowA{ 0%{transform:translateY(0)} 12%{transform:translateY(1.5px)} 46%{transform:translateY(-3px)} 100%{transform:translateY(0)} }
  @keyframes edRowB{ 0%{transform:translateY(0)} 12%{transform:translateY(1.5px)} 46%{transform:translateY(-3px)} 100%{transform:translateY(0)} }
  /* Rack focus: the rows you did NOT choose fall back while the light passes. .42 opacity
     on 11.5px body text would fail contrast if it held — it does not hold, and the state
     it returns to is the legible one. */
  @keyframes edDimA{ 0%{opacity:1} 34%{opacity:.42} 100%{opacity:1} }
  @keyframes edDimB{ 0%{opacity:1} 34%{opacity:.42} 100%{opacity:1} }
  /* The total is what actually changed, so it takes a beat as the arc reaches it. */
  @keyframes edTotalA{ 0%{transform:scale(1)} 40%{transform:scale(1.075)} 100%{transform:scale(1)} }
  @keyframes edTotalB{ 0%{transform:scale(1)} 40%{transform:scale(1.075)} 100%{transform:scale(1)} }

  /* ── wiring the names to the A/B flip ─────────────────────────────────────
     `.is-a` / `.is-b` is `burst % 2`, and neither is present until the first press — so
     nothing animates on page load. Each `animation-duration` is the tone's `ms` times the
     multiplier from the design's layer table. */
  .ed-rsvp.is-a .ed-fx__lift{ animation:edLiftA calc(var(--tier-ms) * 1.35) var(--ag-ease,ease) both; }
  .ed-rsvp.is-b .ed-fx__lift{ animation:edLiftB calc(var(--tier-ms) * 1.35) var(--ag-ease,ease) both; }
  .ed-rsvp.is-a .ed-fx__lifttint{ animation:edLiftA calc(var(--tier-ms) * 1.5) var(--ag-ease,ease) both; }
  .ed-rsvp.is-b .ed-fx__lifttint{ animation:edLiftB calc(var(--tier-ms) * 1.5) var(--ag-ease,ease) both; }
  .ed-rsvp.is-a .ed-fx__glow{ animation:edGlowA calc(var(--tier-ms) * 1.2) var(--ag-ease,ease) both; }
  .ed-rsvp.is-b .ed-fx__glow{ animation:edGlowB calc(var(--tier-ms) * 1.2) var(--ag-ease,ease) both; }
  .ed-rsvp.is-a .ed-fx__impact{ animation:edImpactA calc(var(--tier-ms) * .72) var(--ag-ease,ease) both; }
  .ed-rsvp.is-b .ed-fx__impact{ animation:edImpactB calc(var(--tier-ms) * .72) var(--ag-ease,ease) both; }
  .ed-rsvp.is-a .ed-fx__tail{ animation:edArcA calc(var(--tier-ms) * 1.34) var(--ag-ease,ease) both; }
  .ed-rsvp.is-b .ed-fx__tail{ animation:edArcB calc(var(--tier-ms) * 1.34) var(--ag-ease,ease) both; }
  .ed-rsvp.is-a .ed-fx__head{ animation:edArcA var(--tier-ms) var(--ag-ease,ease) both; }
  .ed-rsvp.is-b .ed-fx__head{ animation:edArcB var(--tier-ms) var(--ag-ease,ease) both; }
  .ed-rsvp.is-a .ed-fx__flash{ animation:edArcA calc(var(--tier-ms) * .96) var(--ag-ease,ease) both; }
  .ed-rsvp.is-b .ed-fx__flash{ animation:edArcB calc(var(--tier-ms) * .96) var(--ag-ease,ease) both; }
  /* The second, faster lap. Rendered only on the peak tone — see the markup — so this
     selector matches nothing on the other three. */
  .ed-rsvp.is-a .ed-fx__flash2{ animation:edLapA calc(var(--tier-ms) * .62) var(--ag-ease,ease) calc(var(--tier-ms) * .34) both; }
  .ed-rsvp.is-b .ed-fx__flash2{ animation:edLapB calc(var(--tier-ms) * .62) var(--ag-ease,ease) calc(var(--tier-ms) * .34) both; }
  .ed-rsvp.is-a .ed-fx__rim{ animation:edRimA calc(var(--tier-ms) * 1.5) var(--ag-ease,ease) calc(var(--tier-ms) * .5) both; }
  .ed-rsvp.is-b .ed-fx__rim{ animation:edRimB calc(var(--tier-ms) * 1.5) var(--ag-ease,ease) calc(var(--tier-ms) * .5) both; }
  .ed-rsvp.is-a .ed-fx__spark{ animation:edSparkA calc(var(--tier-ms) * .62) var(--ag-ease,ease) var(--sd,0ms) both; }
  .ed-rsvp.is-b .ed-fx__spark{ animation:edSparkB calc(var(--tier-ms) * .62) var(--ag-ease,ease) var(--sd,0ms) both; }
  .ed-rsvp.is-a .ed-tier.is-sel{ animation:edRowA 520ms var(--ag-ease,ease) both; }
  .ed-rsvp.is-b .ed-tier.is-sel{ animation:edRowB 520ms var(--ag-ease,ease) both; }
  .ed-rsvp.is-a .ed-tier:not(.is-sel){ animation:edDimA calc(var(--tier-ms) * .9) var(--ag-ease,ease) both; }
  .ed-rsvp.is-b .ed-tier:not(.is-sel){ animation:edDimB calc(var(--tier-ms) * .9) var(--ag-ease,ease) both; }
  .ed-rsvp.is-a .ed-total{ animation:edTotalA calc(var(--tier-ms) * .8) var(--ag-ease,ease) both; }
  .ed-rsvp.is-b .ed-total{ animation:edTotalB calc(var(--tier-ms) * .8) var(--ag-ease,ease) both; }
  .ed-total{ display:inline-block; transform-origin:left center; }

  /* The one burst that is not a comparison. Register happens once, and it fires on a
     SUCCESSFUL response — never on submit. A burst followed by a payment error is worse
     than no burst. */
  .ed-rsvp.is-won .ed-fx__glow, .ed-rsvp.is-won .ed-fx__rim{ animation-duration:1400ms; }

  /* ── reduced motion ────────────────────────────────────────────────────────
     Collapsed to .01ms rather than `none`, so `animationend` still fires and nothing is
     left waiting on it. Nothing is lost, because nothing was carried by the animation:
     the border, the background, the inner rim and the filled radio are all static state
     and all still there. */
  @media (prefers-reduced-motion: reduce){
    .ed-fx{ display:none; }
    .ed-rsvp.is-a .ed-tier.is-sel, .ed-rsvp.is-b .ed-tier.is-sel,
    .ed-rsvp.is-a .ed-tier:not(.is-sel), .ed-rsvp.is-b .ed-tier:not(.is-sel),
    .ed-rsvp.is-a .ed-total, .ed-rsvp.is-b .ed-total{ animation-duration:.01ms !important; }
    .ed-tier{ transition:none; }
  }
  /* share / calendar */
  .ed-share{ display:flex; gap:9px; margin-top:4px; }
  .ed-share button{ flex:1; cursor:pointer; border:1px solid rgba(16,41,44,.14); background:#fff; color:#10292C; font-family:inherit; font-size:13px; font-weight:600; padding:10px; border-radius:11px; display:flex; align-items:center; justify-content:center; gap:7px; }
  .ed-share button:hover{ background:#f0f4f0; }
  /* The calendar download. Styled like the share button rather than as a link, because it
     is an action of the same weight — and it is the PRIMARY of the two, since a .ics works
     in every calendar app with no account and no page in the middle. */
  .ed-cal{ flex:1; cursor:pointer; border:1px solid rgba(16,41,44,.14); background:#fff;
    color:#10292C; font-size:13px; font-weight:600; padding:10px; border-radius:11px;
    display:flex; align-items:center; justify-content:center; gap:7px; text-decoration:none; }
  .ed-cal:hover{ background:#f0f4f0; border-color:rgba(16,41,44,.24); }
  .ed-cal__alt{ margin:9px 0 0; font-size:11.5px; color:var(--ag-ink-soft,#626a6e); text-align:center; }
  .ed-cal__alt a{ color:#237b22; font-weight:600; }

  @media (max-width:820px){ .ed-grid{ grid-template-columns:1fr; } .ed-rail{ position:static; } }

  /* ── EARN FROM SHARING ──────────────────────────────────────────────────
     Quiet on purpose. It sits beside the buy button and must not compete with it: a
     supporter who came to buy a ticket and left having read about commission instead
     is a worse outcome than one who never saw this. Hence a bordered card in the
     sidebar rather than a coloured banner in the flow. */
  /* The appeal. Warmer than the referral card beside it and above it, because giving is
     the ask and earning is the aside. */
  .ed-fund{ margin-top:14px; padding:16px; border:1px solid rgba(35,123,34,.22); border-radius:14px;
    background:#f6faf6 }
  .ed-fund__t{ margin:6px 0 0; font-size:16px; font-weight:700; line-height:1.35; color:#10292C }
  .ed-fund__s{ margin:6px 0 0; font-size:13.5px; line-height:1.6; color:#3a4448 }
  .ed-fund__bar{ display:block; margin-top:12px; height:9px; border-radius:99px;
    background:rgba(16,41,44,.1); overflow:hidden }
  .ed-fund__bar span{ display:block; height:100%; background:#237b22; border-radius:99px }
  .ed-fund__n{ margin:8px 0 0; font-size:13px; color:#3a4448 }
  .ed-fund__go{ display:inline-block; margin-top:12px; padding:11px 20px; border-radius:999px;
    background:#237b22; color:#fff; font-weight:650; font-size:14px; text-decoration:none }
  .ed-fund__go:hover{ background:#1a6118 }
  .ed-fund__by{ margin:10px 0 0; font-size:11.5px; line-height:1.55; color:#5a6d6f }

  .ed-earn{ margin-top:14px; padding:16px; border:1px solid rgba(16,41,44,.1); border-radius:14px;
    background:var(--ag-surface,#fff); }
  .ed-earn__k{ margin:0 0 8px; font-size:11px; font-weight:600; letter-spacing:.08em;
    text-transform:uppercase; color:var(--ag-ink-soft,#626a6e); }
  .ed-earn__t{ margin:0 0 12px; font-size:13.5px; line-height:1.6; color:var(--ag-ink,#10292C); }
  .ed-earn__row{ display:flex; gap:6px; }
  .ed-earn__in{ flex:1 1 auto; min-width:0; padding:9px 11px; font-size:12px;
    font-family:var(--ag-font-mono,ui-monospace,monospace); border:1px solid rgba(16,41,44,.14);
    border-radius:9px; background:#f7f9f9; color:var(--ag-ink,#10292C); }
  .ed-earn__btn{ flex:none; padding:9px 14px; font-size:12.5px; font-weight:700; cursor:pointer;
    border:1px solid #1a6118; border-radius:9px; background:#1a6118; color:#fff; }
  .ed-earn__btn:hover{ background:#145012; }
  .ed-earn__n{ margin:10px 0 0; font-size:12px; line-height:1.6; color:var(--ag-ink-soft,#626a6e); }
  .ed-earn__n a{ color:#1a6118; font-weight:600; }
  .ed-earn__cta{ display:inline-block; margin-bottom:4px; font-size:13px; }
</style>
{% endblock %}

{% block content %}
<div class="ed">
  {% if early_bird %}
  <div class="ed-eb">
    <span class="ed-eb__t">🎟 {{ early_bird.text }}</span>
    <a class="ed-eb__cta" href="{{ early_bird.url|default('#ed-rsvp') }}">Register{% if early_bird.deadline %} — ends {{ early_bird.deadline|date('j F') }}{% endif %} →</a>
  </div>
  {% endif %}
  <div class="ed-crumb"><a href="/events">Events</a> · <b>{{ event.title }}</b></div>

  <div class="ed-hero">
    {% if event.cover_image %}<img class="ed-hero__bg" src="{{ event.cover_image }}" alt="" aria-hidden="true">{% endif %}
    <div class="ed-hero__orb" aria-hidden="true"></div>
    <div class="ed-hero__in">
      <span class="ed-hero__badge">{{ is_past ? 'Past event' : 'Upcoming' }} · {{ event.event_date|date('Y') }}</span>
      <h1 class="ed-hero__title">{{ event.title }}</h1>
      <div class="ed-hero__meta">
        <span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#7FC87C" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>{{ event.event_date|date('j F Y') }}</span>
        <span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#7FC87C" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>{{ event.event_date|date('H:i') }}{% if event.end_date %}–{{ event.end_date|date('H:i') }}{% endif %} WAT</span>
        {% if event.location or event.venue %}<span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#7FC87C" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>{{ event.venue|default(event.location) }}</span>{% endif %}
      </div>
    </div>
  </div>

  <div class="ed-grid">
    <div class="ed-main">
      {% if event.description %}
      <div class="ed-card">
        <h2>About this event</h2>
        <p>{{ event.description }}</p>
      </div>
      {% endif %}

      {# ── AGENDA ─────────────────────────────────────────────────────────────
         Sessions are rows now, grouped into days by EventAgenda so no date arithmetic
         happens in a template — an undated session in Twig silently becomes 1 January
         1970. The track filter is offered only when there is more than one track,
         because a filter with one option is a control that cannot do anything. #}
      {% if agenda|default([]) %}
      {% set tracks = [] %}
      {% for d in agenda %}{% for s in d.sessions %}{% if s.track and s.track not in tracks %}{% set tracks = tracks|merge([s.track]) %}{% endif %}{% endfor %}{% endfor %}
      <div class="ed-card" x-data="{ track: '' }">
        <h2>Agenda</h2>
        {% if tracks|length > 1 %}
        <div class="ed-ag__filter">
          <button type="button" class="ed-ag__fb" :class="track === '' ? 'is-on' : ''" @click="track = ''">All tracks</button>
          {% for t in tracks %}
          <button type="button" class="ed-ag__fb" :class="track === {{ t|json_encode }} ? 'is-on' : ''" @click="track = {{ t|json_encode }}">{{ t }}</button>
          {% endfor %}
        </div>
        {% endif %}
        {% for d in agenda %}
        <div class="ed-ag__day">
          {% if agenda|length > 1 or d.key == '' %}<div class="ed-ag__dayh">{{ d.label }}</div>{% endif %}
          {% for s in d.sessions %}
          <div class="ed-ag__row" x-show="track === '' || track === {{ s.track|json_encode }}">
            <span class="ed-ag__time">{{ s.when ?: '—' }}</span>
            <div>
              <div class="ed-ag__t">{{ s.title }}</div>
              {% if s.description %}<div class="ed-ag__b">{{ s.description }}</div>{% endif %}
              {% if s.speakers %}<div class="ed-ag__who">🎤 {{ s.speakers|join(', ') }}</div>{% endif %}
              {% if s.track or s.room %}
              <div class="ed-ag__tags">
                {% if s.track %}<span class="ed-ag__tag is-track">{{ s.track }}</span>{% endif %}
                {% if s.room %}<span class="ed-ag__tag">{{ s.room }}</span>{% endif %}
              </div>
              {% endif %}
            </div>
          </div>
          {% endfor %}
        </div>
        {% endfor %}
      </div>
      {% elseif schedule %}
      {# The old JSON run of show, for an event that never moved to sessions. #}
      <div class="ed-card">
        <h2>Run of show</h2>
        <div class="ed-sched">
          {% for s in schedule %}
          <div class="ed-sched__row">
            {% if s.time %}<span class="ed-sched__time">{{ s.time }}</span>{% endif %}
            <div><div class="ed-sched__t">{{ s.title }}</div>{% if s.body %}<div class="ed-sched__b">{{ s.body }}</div>{% endif %}</div>
          </div>
          {% endfor %}
        </div>
      </div>
      {% endif %}

      {% if event.venue or event.location %}
      <div class="ed-card">
        <h2>Venue</h2>
        <div class="ed-venue__name">{{ event.venue|default(event.location) }}</div>
        {% if event.venue and event.location %}<div class="ed-venue__addr">{{ event.location }}</div>{% endif %}
        {% if event.map_embed %}<a class="ed-maplink" href="{{ event.map_embed }}" target="_blank" rel="noopener">📍 View on map →</a>{% endif %}
      </div>
      {% endif %}

      {# ── THE SMALL PRINT, BEFORE ANYBODY PAYS ───────────────────────────────
         A refund policy discovered after a card has been charged is not a policy, it is a
         complaint waiting to be made — and a question about parking that reaches this
         platform's support desk instead of the organiser is a question nobody can answer. #}
      {% if refund_policy|default('') or attendee_note|default('') or organiser_email|default('') or organiser_phone|default('') %}
      <div class="ed-card">
        <h2>Good to know</h2>
        <dl class="ed-fine">
          {% if attendee_note|default('') %}
          <dt>Before you come</dt><dd>{{ attendee_note }}</dd>
          {% endif %}
          {# The rule first, in one line, then the organiser's own words. The rule is what the
             platform will actually do; the prose is what they mean. #}
          {% if refund_rule|default('') %}
            <p style="font-weight:600">{{ refund_rule }}</p>
          {% endif %}
          {% if refund_policy|default('') %}
          <dt>Refunds &amp; transfers</dt><dd>{{ refund_policy }}</dd>
          {% endif %}
          {% if organiser_email|default('') or organiser_phone|default('') %}
          <dt>Questions about this event</dt>
          <dd>
            {% if organiser_email|default('') %}<a href="mailto:{{ organiser_email }}">{{ organiser_email }}</a>{% endif %}
            {% if organiser_email|default('') and organiser_phone|default('') %} · {% endif %}
            {% if organiser_phone|default('') %}<a href="tel:{{ organiser_phone|replace({' ': ''}) }}">{{ organiser_phone }}</a>{% endif %}
          </dd>
          {% endif %}
        </dl>
      </div>
      {% endif %}

      {# ── TRADE AT THIS EVENT ────────────────────────────────────────────────
         The call for vendor stands lived at /events/{slug}/stands and nothing on this site
         linked to it, so the only businesses applying were the ones the organiser had
         already phoned. That is precisely the outcome a published quota exists to prevent:
         an open call nobody can find is a private invitation with extra steps.

         LAST in the main column on purpose. This page's job is to sell a seat, and the
         person reading it came for one — a vendor pitch above the agenda would be pushing a
         different audience's business in front of the one that is actually here. Whoever
         needs this is looking for it, and the people who are not lose nothing by scrolling
         past it. #}
      {% if stand_call|default(null) %}
        {% if stand_call.state == 'closed' %}
          {# One line, no button. Still said, because a vendor who arrived a fortnight late is
             owed a date and a page rather than silence — and next year they will look earlier. #}
          <div class="ed-vend ed-vend--shut">
            <span class="ed-vend__kick">Vendor stands</span>
            <p>
              {%- if stand_call.closes_at %}Applications closed on
                <b>{{ stand_call.closes_at|date('j F Y') }}</b>.
              {%- else %}This event is not taking stand applications.{% endif %}
              The quotas, the prices and the rules they were judged against are all still
              published — <a href="{{ stand_call.url }}">see what was on offer</a>.
            </p>
          </div>
        {% else %}
          <div class="ed-vend">
            <span class="ed-vend__orb" aria-hidden="true"></span>
            <div class="ed-vend__in">
              <span class="ed-vend__kick">Vendor stands</span>
              <h2>Sell something at {{ event.title }}?</h2>
              <p>Stands here are applied for and allocated against quotas published before
                anyone applies — not sold to whoever pays first. Everything that decides your
                application is on one page, in advance.</p>

              {# Three numbers, as three statements. A vendor decides on how many places are
                 left, what the cheapest one costs and when it shuts; buried in a paragraph
                 each of those takes forty words to find. Any that is unknown is simply not
                 printed — a chip reading "0 stands" or "from ₦0" is worse than no chip. #}
              <ul class="ed-vend__facts">
                {% if stand_call.left > 0 %}
                  <li><b>{{ stand_call.left }}</b> of {{ stand_call.quota }} places open</li>
                {% elseif stand_call.quota > 0 %}
                  <li>All {{ stand_call.quota }} held · waiting list</li>
                {% endif %}
                {% if stand_call.from > 0 %}
                  <li>From <b>₦{{ stand_call.from|number_format }}</b></li>
                {% endif %}
                {% if stand_call.kinds > 1 %}
                  <li>{{ stand_call.kinds }} stand sizes</li>
                {% endif %}
                {% if stand_call.state == 'open' and stand_call.closes_at %}
                  <li>Closes <b>{{ stand_call.closes_at|date('j M') }}</b></li>
                {% elseif stand_call.state == 'soon' and stand_call.opens_at %}
                  <li>Opens <b>{{ stand_call.opens_at|date('j M') }}</b></li>
                {% endif %}
              </ul>

              <div class="ed-vend__act">
                <a class="ed-vend__cta" href="{{ stand_call.url }}">
                  {{ stand_call.state == 'open' ? 'Apply for a stand' : 'See the terms' }}
                  <svg aria-hidden="true" focusable="false" width="15" height="15" viewBox="0 0 20 20" fill="none"><path d="M7.5 4.5 13 10 7.5 15.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
                <span class="ed-vend__free">
                  {%- if stand_call.state == 'open' -%}
                    <b>Applying is free</b> and you do not need an account first — the form
                    makes one.
                  {%- else -%}
                    The terms are published now, so you can decide before it opens.
                  {%- endif -%}
                </span>
              </div>
            </div>
          </div>
        {% endif %}
      {% endif %}
    </div>

    {# ── RSVP rail ── #}
    <aside class="ed-rail">
      {% if is_past %}
        <div class="ed-rsvp">
          <span class="ed-rsvp__eyebrow">Closed</span>
          <h2>This event has ended</h2>
          <p class="ed-past">Thanks to everyone who joined{% if reg_count %} — {{ reg_count }} registered{% endif %}. Catch the next one on the <a href="/events" style="color:var(--ag-green);font-weight:600">events calendar</a>.</p>
        </div>
      {% elseif sales_closed|default('') %}
        {# A cutoff BEFORE the event date, which almost every organiser needs for catering
           and badges. Said with its date rather than as a bare "closed", because the two
           are different amounts of respect for somebody who arrived a day late. #}
        <div class="ed-rsvp">
          <span class="ed-rsvp__eyebrow" style="color:#b42318">Registration closed</span>
          <h2>Bookings have closed</h2>
          <p class="ed-past">{{ sales_closed }} The event itself still goes ahead — if you need to come, please
            {% if organiser_email|default('') %}email <a href="mailto:{{ organiser_email }}" style="color:var(--ag-green);font-weight:600">{{ organiser_email }}</a>{% else %}contact the organisers{% endif %}.</p>
        </div>
      {% elseif is_full %}
        <div class="ed-rsvp">
          <span class="ed-rsvp__eyebrow" style="color:#b42318">Fully booked</span>
          <h2>This event is full</h2>
          <p class="ed-past">All {{ capacity }} places have been reserved. Join the <a href="/community" style="color:var(--ag-green);font-weight:600">community</a> to hear first about the next one — and any released places.</p>
        </div>
      {% else %}
        <div class="ed-rsvp" id="ed-rsvp"
             :class="burst === 0 ? '' : ((burst % 2 ? 'is-a' : 'is-b') + (won ? ' is-won' : ''))"
             :style="'--tier-hue:' + hue + ';--tier-edge:' + edge + ';--tier-ms:' + toneMs + 'ms;--tier-laps:' + toneLaps"
             x-data="evReg('{{ event.slug|e('js') }}', '{{ csrf_token|e('js') }}', {{ reg_count }}, {{ tiers ? 'true' : 'false' }}, {{ access_code|default('')|json_encode }}, {{ waitlist_open|default(false) ? 'true' : 'false' }})">

          {# ── THE SELECTION LIGHT ────────────────────────────────────────
             Ten layers, all `transform`/`opacity`, all confined to the card's own bounds —
             see the stylesheet for why the bloom is a shadow rather than a disc that bleeds
             past the card, and for why every keyframe exists twice.

             `aria-hidden` and `pointer-events:none`: it carries no text, no meaning and no
             target. Everything it says is also said by the border, the background, the
             inner rim and the filled radio, which is what makes it safe to remove entirely
             under `prefers-reduced-motion`. #}
          <span class="ed-fx" aria-hidden="true">
            <span class="ed-fx__lift"></span>
            <span class="ed-fx__lifttint"></span>
            <span class="ed-fx__glow"></span>
            <span class="ed-fx__impact"></span>
            <span class="ed-fx__ring">
              <span class="ed-fx__tail"></span>
              <span class="ed-fx__head"></span>
              <span class="ed-fx__flash"></span>
              {# The second lap, on the peak tone only. Rendered conditionally rather than
                 hidden, so a calm press is four animated elements and not twelve — the
                 budget matters on the mid-range Android this actually runs on. #}
              <template x-if="toneLaps > 1">
                <span class="ed-fx__flash2"></span>
              </template>
            </span>
            <span class="ed-fx__rim"></span>
            {# Seven sparks, peak tone only. The offsets are fixed per index rather than
               random: a random spray differs on every press, and a press people make four
               times in a row should look like the same event happening again.

               `--sx` is negative — up and to the LEFT. See the stylesheet: outward past the
               right edge is what would put a positioned element outside its own gutter. #}
            <template x-for="i in toneSparks" :key="i">
              <span class="ed-fx__spark"
                    :style="'--sx:' + (-2 - i * 3.4) + 'px;--sy:' + (-5 - i * 2.8) + 'px;--sd:' + (i * 26) + 'ms'"></span>
            </template>
          </span>

          <div x-show="step==='form'">
            {# ── THE PANEL NAMES WHAT KIND OF EVENT THIS IS ────────────────
               "Tickets" alone is right for a summit and wrong for a fundraising
               dinner, where the whole point of buying a place is what it pays for.
               The eyebrow follows the event rather than the payment mechanism.

               What it deliberately does NOT say is that the ticket is a donation.
               It is not: the money moves through the ticket flow, with the ticket
               flow's refund terms, and the appeal below is a separate transaction
               with its own. Calling a ₦5,000 admission a gift would be the same
               category error in the other direction — and the one that ends up in
               a dispute. #}
            <div class="ed-rsvp__top">
              <span class="ed-rsvp__eyebrow">
                {%- if is_fundraiser %}Fundraiser · {{ tiers ? 'tickets' : 'free registration' }}
                {%- else %}{{ tiers ? 'Tickets' : 'Free registration' }}{% endif -%}
              </span>
              <span class="ed-rsvp__count" x-text="count + ' registered'"></span>
            </div>
            {% if is_fundraiser %}
              <p class="ed-rsvp__fund">This event raises money.
                {%- if appeal_for %} Your place helps fund <strong>{{ appeal_for }}</strong>.{% endif %}
                Giving directly is separate and welcome on its own — the appeal is further down
                this page.</p>
            {% endif %}
            {% if pct_sold is not null %}
            <div style="margin-top:12px">
              <div class="ed-sold__top"><span>{{ pct_sold >= 80 ? 'Selling fast' : 'Filling up' }}</span><span>{{ pct_sold }}% full</span></div>
              <div class="ed-sold__bar"><span class="ed-sold__fill" style="width:{{ pct_sold }}%"></span></div>
            </div>
            {% endif %}
            {% if tiers %}
            {# Tiers are rows now, each with its OWN attendee limit — so a tier can be sold
               out while the event is not, and it says which of those it is rather than just
               going grey. `state` is the one word the branch reads: open / sold_out / early
               / closed, each a different sentence to somebody who wants to come. #}
            {# ── A RADIO GROUP, NOT A ROW OF TOGGLE BUTTONS ──────────────────
               This was a list of plain `<button>`s whose only selected signal was a CSS
               class. To a screen reader the chosen tier was conveyed by colour alone —
               WCAG 1.4.1 — and there was no name, role or value for the selection at all
               (4.1.2): every row announced as an unremarkable button, none of them as
               chosen, and none as one of a set.

               `role="radiogroup"` with `aria-checked` per row fixes both, and it is also
               the convention: a single-select list of options is a radio group everywhere
               else on the web, so Arrow keys move between rows and Tab leaves the group.
               The handoff specified `aria-pressed` on buttons instead — that announces a
               toggle rather than a choice, and makes Tab visit every tier, which is the
               wrong shape for "pick exactly one of these three".

               Roving tabindex: only the chosen row is tabbable, so the group is one stop.
               `tierId === 0` before anything is chosen makes the FIRST row the stop, or
               the group would be unreachable by keyboard. #}
            <div style="margin-top:8px" role="radiogroup" aria-label="Ticket type"
                 @keydown.arrow-down.prevent="step_(1)" @keydown.arrow-right.prevent="step_(1)"
                 @keydown.arrow-up.prevent="step_(-1)" @keydown.arrow-left.prevent="step_(-1)"
                 @keydown.home.prevent="edge_(0)" @keydown.end.prevent="edge_(-1)">
              {% for t in tiers %}
                {% set gone = (t.state|default('open')) == 'sold_out' %}
                {# A sold-out tier stays PRESSABLE when there is a waiting list, because the
                   thing to do about it is join that list — and a disabled button is a dead
                   end for the most motivated person on the page. Without a list it is
                   disabled, since there is genuinely nothing to press. #}
                {% set shut = (t.state|default('open')) != 'open' and not (gone and waitlist_open|default(false)) %}
                {# Tone and hue come from PHP. Rank is a price question and this list is
                   ordered by `sort_order` — a column the organiser drags rows around with —
                   so `loop.last` is not the dearest tier. See EventTierTone. #}
                {% set tone = tier_tones[t.id]|default('calm') %}
                <button type="button" class="ed-tier" role="radio" data-ed-tier
                        :class="tierId === {{ t.id|default(0) }} ? 'is-sel' : ''"
                        :aria-checked="tierId === {{ t.id|default(0) }} ? 'true' : 'false'"
                        :tabindex="(tierId === {{ t.id|default(0) }} || (tierId === 0 && {{ loop.first ? 'true' : 'false' }})) ? 0 : -1"
                        {# Two values, not one. `--tier-hue` is the colour the organiser set
                           and it drives the light; `--tier-edge` is the palette's darker
                           variant and it draws the border and the filled radio, which are
                           non-text indicators of state and owe 3:1 against white (WCAG
                           1.4.11). It is the same pair the printed ticket's dot draws —
                           `background: fill`, `1px solid edge` — which is what makes the
                           row here and the mark on the door the same object. #}
                        style="--tier-hue:{{ tier_hues[t.id].hue|default('#237b22') }};--tier-edge:{{ tier_hues[t.id].edge|default('#1a6118') }}"
                        {{ shut ? 'disabled' : '' }}
                        @click="pick({{ t.id|default(0) }}, {{ t.price_naira|default(0) }}, {{ t.max|default(10) }}, {{ (t.min|default(1)) }}, {{ gone ? 'true' : 'false' }}, {{ waitlist_counts[t.id]|default(0) }}, '{{ tone }}', '{{ tier_hues[t.id].hue|default('#237b22') }}', '{{ tier_hues[t.id].edge|default('#1a6118') }}')">
                  <span class="ed-tier__radio"></span>
                  <span>
                    <span class="ed-tier__name">{{ t.name }}{% if gone %} · sold out{% endif %}</span>
                    {% if t.description|default('') %}<br><span class="ed-tier__perk">{{ t.description }}</span>{% endif %}
                    {% for p in t.perks|default([]) %}<br><span class="ed-tier__perk">✓ {{ p }}</span>{% endfor %}
                    {% if (t.state|default('open')) != 'open' and t.why|default('') %}<br><span class="ed-tier__perk">{{ t.why }}</span>
                    {% if gone and waitlist_open|default(false) %}<br><span class="ed-tier__perk" style="color:#966905;font-weight:700">Join the waiting list{% if waitlist_counts[t.id]|default(0) %} · {{ waitlist_counts[t.id] }} waiting{% endif %}</span>{% endif %}
                    {# The scarcity line is a FACT read off the tier's own remaining count,
                       not a nudge: it appears when there are few enough left that somebody
                       deciding today deserves to know, and never otherwise. #}
                    {% elseif t.left is not null and t.left <= 10 %}<br><span class="ed-tier__perk" style="color:#8a2020;font-weight:700">Only {{ t.left }} left</span>
                    {% endif %}
                  </span>
                  <span class="ed-tier__price">{{ (t.price_naira|default(0)) > 0 ? '₦' ~ (t.price_naira|number_format) : 'Free' }}</span>
                </button>
              {% endfor %}
            </div>

            {# Seats, only when the chosen tier allows more than one. A quantity box on a
               one-per-person ticket is a question with a single legal answer. #}
            <div x-show="maxQty > 1 && !soldOut" x-cloak style="margin-top:12px">
              <label class="ed-label" for="edQty">How many seats</label>
              <select id="edQty" class="ed-input" x-model.number="qty">
                <template x-for="n in seatOptions()" :key="n">
                  <option :value="n" x-text="n"></option>
                </template>
              </select>
            </div>

            {# ── DISCOUNT CODE ────────────────────────────────────────────────
               A preview and nothing more: EventTicketService::reserve() prices the row
               again from the tier and the code rows, so what is shown here cannot change
               what anybody is charged. Offered only on a paid tier — a code on a free
               ticket is a field with nothing to do. #}
            <div x-show="price > 0 && !soldOut" x-cloak style="margin-top:12px">
              <label class="ed-label" for="edDisc">Discount code <span style="font-weight:400;color:var(--ag-ink-soft,#626a6e)">(optional)</span></label>
              <div class="ed-disc">
                <input id="edDisc" class="ed-input" x-model="discount" placeholder="ALUMNI20"
                       autocomplete="off" @keydown.enter.prevent="checkCode()">
                <button type="button" :disabled="checking || !discount.trim()" @click="checkCode()"
                        x-text="checking ? '…' : 'Apply'"></button>
              </div>
              <p class="ed-disc__ok" x-show="off > 0" x-cloak x-text="codeNote"></p>
              <p class="ed-disc__no" x-show="codeNote && off === 0" x-cloak x-text="codeNote"></p>
            </div>

            <p class="sub" x-show="price > 0 && !soldOut" x-cloak style="margin-top:10px;font-weight:700;color:#10292C">
              Total:
              <span class="ed-was" x-show="off > 0" x-cloak x-text="'₦' + (price * qty).toLocaleString()"></span>
              {# The total is the thing that actually changed when a tier was pressed, so it
                 takes a beat as the arc passes it. `ed-total` is the hook; the scale is in
                 the stylesheet. #}
              <span class="ed-total" x-text="'₦' + Math.max(0, price * qty - off).toLocaleString()"></span>
            </p>

            {# ── THE WAITING LIST ─────────────────────────────────────────────
               Shown when the chosen tier has gone and the organiser has opened a list.
               A seat comes back often enough — a declined card, an expired hold, three
               cancellations the week before — that re-selling them to whoever happens to
               be looking is a lottery dressed as a queue. #}
            <div class="ed-wl" x-show="soldOut" x-cloak>
              <div class="ed-wl__h">This ticket has sold out</div>
              <p class="ed-wl__p">
                Leave your details and you will be emailed the moment a seat comes back — a
                declined card, an expired checkout, a cancellation. You get
                {{ constant('AfricaGates\\Services\\EventWaitlist::OFFER_HOURS') }} hours to take it
                before it passes to the next person.
                <span x-show="wlCount > 0" x-cloak x-text="' ' + wlCount + ' already waiting.'"></span>
              </p>
            </div>
            {% else %}
            <h2>Reserve your place</h2>
            <p class="sub">Register and we’ll email you the details and any updates.</p>
            {% endif %}

            {% if paid_tiers and not gateway_ready %}
              {# Said out loud rather than discovered at the end. A buyer who fills in three
                 fields and then meets "payments are unavailable" has been wasted; and the
                 operator needs to know their own site cannot take money. #}
              {# Hidden in waitlist mode: joining a queue asks for no money, and warning
                 somebody about card payment while they are giving you their name reads as
                 a problem with the thing they are actually doing. #}
              <p class="ed-err" style="margin-top:10px" x-show="!soldOut">Card payment is not
                available on this site right now, so paid tickets cannot be bought here. Please
                contact us and we will register you directly.</p>
            {% endif %}
            {% if spots_left is not null %}<p class="sub" style="color:#1a6118;font-weight:600;margin-top:9px">⚡ Only {{ spots_left }} {{ spots_left == 1 ? 'place' : 'places' }} left</p>{% endif %}
            {% include 'partials/member-autofill.twig' with {
              member: member|default(null),
              maf_fields: [
                {sel: '#edName',  key: 'name'},
                {sel: '#edEmail', key: 'email'},
                {sel: '#edPhone', key: 'phone'},
              ],
            } only %}
            <label class="ed-label" for="edName">Full name</label>
            <input id="edName" class="ed-input" x-model="name" placeholder="Amara Okonkwo" autocomplete="name">
            <label class="ed-label" for="edEmail">Email</label>
            <input id="edEmail" class="ed-input" x-model="email" type="email" placeholder="you@email.com" autocomplete="email" @keydown.enter="submit()">
            <label class="ed-label" for="edPhone">Phone</label>
            <input id="edPhone" class="ed-input" x-model="phone" type="tel" inputmode="tel" placeholder="+234…" autocomplete="tel" @keydown.enter="submit()">
            <p class="ed-err" x-show="error" x-cloak x-text="error"></p>
            <button type="button" class="ed-cta" :disabled="busy || !valid" @click="submit()" x-text="cta"></button>
            <div class="ed-secure"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#5a6d6f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>Your details are kept private</div>
          </div>
          <div class="ed-done" x-show="step==='done'" x-cloak>
            <div class="ed-done__ico"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#237b22" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></div>
            <h2 class="ed-card" style="border:0;padding:0;background:none;font-family:var(--ag-font-display);font-weight:700;font-size:1.2rem"
                x-text="wlPlace ? 'You’re on the list ✓' : 'You’re registered ✓'"></h2>
            <p class="sub" x-text="msg"></p>
            {# The ticket, not just a thank-you. It is the thing they will need at the door,
               and burying it in an email that may not arrive for ten minutes is how somebody
               turns up with nothing to show. #}
            <a class="ed-cta" x-show="ticketUrl" x-cloak :href="ticketUrl" style="margin-top:14px;display:block;text-align:center;text-decoration:none">View your ticket →</a>
            <a class="ed-ext" href="/events" style="margin-top:16px">Back to all events →</a>
          </div>
        </div>
      {% endif %}

      {# ── Share and save the date ────────────────────────────────────────────
         The DOWNLOAD is the primary action, not the Google link. A `.ics` file is understood
         by Apple Calendar, Outlook, Thunderbird, Samsung, Fastmail and Google alike, works
         with no account and no third-party page in the middle, and is the only one of the
         two that a phone can open offline. Google keeps its place because a Google user
         genuinely prefers it — but as the second option, not the only one.

         THE `Z` ON THE GOOGLE DATES IS A BUG FIX. This link previously emitted
         `date('Ymd\THis')` with no zone marker. Google reads a bare timestamp as the
         READER's local time, and stored datetimes here are UTC by convention
         ({@see \AfricaGates\Support\Clock}) — so anybody outside UTC was adding the event at
         the wrong hour, silently, with a perfectly plausible-looking entry in their diary.
         `|date('Ymd\THis\Z')` converts and marks it. The same reasoning is why
         {@see \AfricaGates\Support\Ics} emits UTC throughout. #}
      {% if not is_past %}
      {% set gcal = 'https://calendar.google.com/calendar/render?action=TEMPLATE&text=' ~ event.title|url_encode ~ '&dates=' ~ event.event_date|date('Ymd\\THis\\Z') ~ '/' ~ (event.end_date ?: event.event_date)|date('Ymd\\THis\\Z') ~ '&location=' ~ (event.venue ?: event.location)|default('')|url_encode ~ '&details=' ~ event.tagline|default('')|url_encode %}
      <div class="ed-rsvp" x-data="evShare()">
        <p style="margin:0 0 10px;font-size:11px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--ag-ink-soft,#626a6e)">Share &amp; save the date</p>
        <div class="ed-share">
          <button type="button" @click="share()"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4"/></svg>Share</button>
          <a class="ed-cal" href="/events/{{ event.slug|url_encode }}/calendar.ics"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>Add to calendar</a>
        </div>
        <p class="ed-cal__alt">Uses Google Calendar? <a href="{{ gcal }}" target="_blank" rel="noopener">Add it there instead</a>.</p>
        <span x-show="note" x-cloak x-text="note" style="display:block;text-align:center;margin-top:8px;font-size:12px;color:#1a6118;font-weight:600"></span>
      </div>
      {% endif %}

      {# ── EARN FROM SHARING ────────────────────────────────────────────────
         Directly under Share, deliberately: this is the one moment somebody is already
         thinking about telling a friend, and it is where the offer means anything. The
         referral programme existed and nobody knew — a member had to already know it was
         there, sign in, and find the panel on their account page.

         The rate and the threshold are printed from live values rather than written into
         the copy. An admin can change both, and a page promising 10% after a change to 8%
         is a promise the ledger will not honour. #}
      {# ── WHAT THIS EVENT IS RAISING FOR ──────────────────────────────────
         Above the referral card, because giving is the ask and earning is the aside.

         The total is summed from confirmed gifts every time it is shown rather than
         cached, so it cannot drift from the rows behind it — a fundraising bar that is
         wrong is worse than no bar, and it is the number people screenshot.

         Nothing here is a payment form: it links to the appeal, which is where the money
         actually moves and where the refund terms live. #}
      {% for a in appeals|default([]) %}
      <div class="ed-fund">
        <p class="ed-earn__k">Raising for</p>
        <p class="ed-fund__t">{{ a.campaign.title }}</p>
        {% if a.campaign.summary %}<p class="ed-fund__s">{{ a.campaign.summary }}</p>{% endif %}

        {% if a.progress.target > 0 %}
          <div class="ed-fund__bar" role="img"
               aria-label="₦{{ a.progress.raised|number_format }} raised of a ₦{{ a.progress.target|number_format }} target">
            <span style="width:{{ a.progress.pct }}%"></span>
          </div>
          <p class="ed-fund__n">
            <strong>₦{{ a.progress.raised|number_format }}</strong> of
            ₦{{ a.progress.target|number_format }}
            {%- if a.progress.count %} · {{ a.progress.count }} gift{{ a.progress.count == 1 ? '' : 's' }}{% endif %}
            {%- if a.days_left is not null %} · {{ a.days_left }} day{{ a.days_left == 1 ? '' : 's' }} left{% endif %}
          </p>
        {% elseif a.progress.count %}
          {# No target set. The total still means something; a bar without one does not. #}
          <p class="ed-fund__n"><strong>₦{{ a.progress.raised|number_format }}</strong> raised so far
            · {{ a.progress.count }} gift{{ a.progress.count == 1 ? '' : 's' }}</p>
        {% endif %}

        <a class="ed-fund__go" href="{{ a.url }}">Give to this appeal</a>
        <p class="ed-fund__by">Raised by {{ a.org }}. A ticket is not a donation — this is
          separate, and either is welcome on its own.</p>
      </div>
      {% endfor %}

      {% if referral %}
      <div class="ed-earn">
        <p class="ed-earn__k">Earn from sharing</p>
        {% if referral.link %}
          <p class="ed-earn__t">Share <strong>your</strong> link. When someone buys a ticket
            through it you earn <strong>{{ referral.pct }}%</strong>.</p>
          {# The link leads and is a real input, so it can be selected by hand when the
             clipboard API is refused or the script never loads. The link IS the feature. #}
          <label class="sr-only" for="edRefLink">Your referral link for this event</label>
          <div class="ed-earn__row">
            <input class="ed-earn__in" id="edRefLink" type="text" readonly value="{{ referral.link }}">
            <button type="button" class="ed-earn__btn" data-rf-copy="edRefLink">Copy</button>
          </div>
          <p class="ed-earn__n">
            {% if referral.threshold > 1 %}
              Paid once you have <strong>{{ referral.threshold }}</strong> referrals — and it is
              backdated, so the {{ referral.threshold }}th makes all of them payable.
            {% else %}
              Paid from your first referral.
            {% endif %}
            <a href="/account#me-referral">Your referrals →</a>
          </p>
        {% else %}
          <p class="ed-earn__t">Tell people about this event and earn
            <strong>{{ referral.pct }}%</strong> of every ticket bought through your link.</p>
          {# A link needs an owner: a code with nobody behind it is a code with nobody to
             pay. So the offer is shown to everybody and the account is the next step. #}
          <p class="ed-earn__n"><a class="ed-earn__cta" href="/account/login?next=/events/{{ event.slug|url_encode }}">Sign in to get your link</a>
            <br>Free, and your link works on every event.</p>
        {% endif %}
      </div>
      {% endif %}
    </aside>
  </div>
</div>

<script nonce="{{ csp_nonce }}">
  function evReg(slug, csrf, count, hasTiers, code, wlOpen){
    return {
      step:'form', name:'', email:'', phone:'', busy:false, error:'', msg:'',
      count: count || 0, hasTiers: !!hasTiers, code: code || '',
      /* The tier is chosen by ID now, not by its NAME. A name is display text an organiser
         may edit after somebody has bought against it, and matching on it is also how
         "VIP" and "V.I.P." became two tiers sharing one limit. */
      tierId: 0, price: 0, qty: 1, minQty: 1, maxQty: 1,
      ticketUrl: '',
      /* Discount state. `off` is what the SERVER said this code takes off — never computed
         here, because a total worked out in the browser is a total anybody can edit, and
         confirm() refuses a payment smaller than the amount on the row. */
      discount: '', off: 0, codeNote: '', checking: false,
      /* Sold out, and whether there is a queue to join about it. */
      soldOut: false, wlOpen: !!wlOpen, wlCount: 0, wlPlace: 0,

      /* ── THE SELECTION LIGHT ───────────────────────────────────────────────
         `burst` is a counter, and it is the only thing that makes the effect replay.
         A finished CSS animation does NOT restart when the same `animation-name` is
         re-applied, so pressing one tier twice — which is what people actually do while
         comparing — would do nothing at all. The card carries `is-a` or `is-b` by
         `burst % 2`, and the NAME CHANGE is the restart.

         Zero until the first press, so nothing animates on page load.

         The counter is per CARD, which here means per Alpine component. A page with two
         registration cards on it would otherwise flash both on every press. */
      burst: 0,
      /* Tone and hue arrive from the pressed row rather than being worked out here: rank
         is a price question and PHP already answered it. See EventTierTone. */
      toneMs: 950, toneLaps: 1, toneSparks: 0, hue: '#237b22', edge: '#1a6118',
      /* The one burst that is not a comparison. Set on a SUCCESSFUL registration and
         never on submit — see submit(). */
      won: false,

      init(){
        /* A percentage code against three seats is not the same number as against one, so a
           quantity change re-prices it. Re-asked rather than scaled here, because scaling in
           the browser would reimplement the rounding rule and eventually disagree with the
           server about what somebody owes. */
        this.$watch('qty', () => { if (this.discount.trim() !== '') this.checkCode(); });
      },

      /* The four tones, mirrored from EventTierTone so the numbers exist in exactly two
         places and a test can hold them equal. `hold` is the slowest and dimmest: it is
         what a sold-out tier with a waiting list gets, and joining a queue is not a thing
         to celebrate. */
      TONES: { calm:{ms:950,laps:1,sparks:0}, rise:{ms:820,laps:1,sparks:0},
               peak:{ms:700,laps:2,sparks:7}, hold:{ms:1050,laps:1,sparks:0} },

      pick(id, price, max, min, soldOut, wlCount, tone, hue, edge){
        /* The light first, so the rest of this function cannot return early past it. */
        var t = this.TONES[tone] || this.TONES.calm;
        this.toneMs = t.ms; this.toneLaps = t.laps; this.toneSparks = t.sparks;
        /* `hue` is the colour the organiser set on this tier and it drives the light;
           `edge` is the palette's darker variant, for the rim that HOLDS. Both come from
           the row rather than being derived here — one resolver, in EventTierTone, so the
           card and the printed ticket cannot come to disagree about a tier's colour. */
        this.hue = hue || '#237b22';
        this.edge = edge || '#1a6118';
        /* A fresh selection is a comparison, not an outcome: any previous success glow is
           dropped rather than compounding into it. */
        this.won = false;
        this.burst++;

        this.tierId = id; this.price = price;
        this.minQty = min || 1;
        this.maxQty = Math.max(this.minQty, max || 1);
        /* Clamp rather than reset: somebody who picked 4 of one tier and switches to
           another that allows 2 meant "as many as I can", not "start again". */
        this.qty = Math.min(Math.max(this.qty, this.minQty), this.maxQty);
        this.soldOut = !!soldOut && this.wlOpen;
        this.wlCount = wlCount || 0;
        /* A code priced against the old tier is not priced against this one. Dropping it
           rather than re-checking it silently is the honest move: the number on screen must
           never belong to a ticket they are no longer buying. */
        this.off = 0; this.codeNote = '';
        this.error = '';
      },
      /* ── ARROW KEYS ACROSS THE GROUP ────────────────────────────────────────
         The convention for a radio group, and the reason this is a radiogroup rather than
         a row of toggle buttons: Arrow moves and selects, Tab leaves. Reading the DOM
         rather than the tier list, because a `disabled` row must be skipped and only the
         DOM knows which rows those are — `shut` is computed in Twig from three conditions
         and duplicating that here is how the two come to disagree. */
      rows_(){
        var g = this.$root.querySelector('[role="radiogroup"]');
        if (!g) return [];
        return Array.prototype.filter.call(g.querySelectorAll('[data-ed-tier]'),
                                           function(b){ return !b.disabled; });
      },
      step_(dir){
        var rows = this.rows_();
        if (rows.length === 0) return;
        var at = rows.indexOf(document.activeElement);
        /* Wrapping, which is what a radio group does — and from -1 (focus is on the group
           itself, not a row) a Down lands on the first row rather than nowhere. */
        var next = rows[(((at < 0 ? (dir > 0 ? -1 : 0) : at) + dir) + rows.length) % rows.length];
        if (next) { next.focus(); next.click(); }
      },
      edge_(which){
        var rows = this.rows_();
        var el = which === 0 ? rows[0] : rows[rows.length - 1];
        if (el) { el.focus(); el.click(); }
      },

      seatOptions(){
        var out = [];
        for (var n = this.minQty; n <= this.maxQty; n++) out.push(n);
        return out;
      },
      get valid(){
        return this.name.trim() !== '' && /.+@.+\..+/.test(this.email)
          && this.phone.replace(/\D/g,'').length >= 7 && (!this.hasTiers || this.tierId > 0);
      },
      get cta(){
        if (this.soldOut) return this.busy ? 'Adding you…' : 'Join the waiting list';
        if (this.busy) return this.due > 0 ? 'Taking you to payment…' : 'Registering…';
        if (this.due > 0) return 'Pay ₦' + this.due.toLocaleString();
        if (this.price > 0) return 'Get my ticket — free with code';
        return this.hasTiers ? 'Get my ticket' : 'Register — free';
      },
      get due(){
        return Math.max(0, this.price * this.qty - this.off);
      },

      /* Ask the server what a code does. A preview only — see the panel comment. */
      async checkCode(){
        var typed = this.discount.trim();
        if(typed === '' || this.tierId === 0){ return; }
        this.checking = true;
        try{
          var r = await fetch('/events/'+slug+'/quote', {
            method:'POST', headers:{'Content-Type':'application/x-www-form-urlencoded'},
            body: new URLSearchParams({ _token: csrf, tier_id:this.tierId,
                                        quantity:this.qty, discount:typed, email:this.email })
          });
          var d = await r.json().catch(function(){ return {}; });
          this.off = d.applied ? (d.off || 0) : 0;
          this.codeNote = d.message || (d.applied ? '' : 'That code could not be applied.');
        }catch(e){ this.off = 0; this.codeNote = 'We could not check that code just now.'; }
        finally{ this.checking = false; }
      },

      async submit(){
        if(this.name.trim()===''){ this.error='Please enter your name.'; return; }
        if(!/.+@.+\..+/.test(this.email)){ this.error='Please enter a valid email.'; return; }
        if(this.phone.replace(/\D/g,'').length < 7){ this.error='Please enter a valid phone number.'; return; }
        if(this.hasTiers && this.tierId === 0){ this.error='Please choose a ticket type.'; return; }
        if(this.soldOut){ return this.joinList(); }
        this.busy=true; this.error='';
        try{
          var r = await fetch('/events/'+slug+'/register', {
            method:'POST', headers:{'Content-Type':'application/x-www-form-urlencoded'},
            body: new URLSearchParams({ _token: csrf, name:this.name, email:this.email,
                                        phone:this.phone, tier_id:this.tierId,
                                        quantity:this.qty, code:this.code,
                                        discount:this.discount.trim() })
          });
          var d = await r.json().catch(function(){ return {}; });

          /* A paid tier answers with a hand-off URL instead of a confirmation. The seats
             are already held server-side by then, so leaving the button spinning while the
             browser navigates is honest: nothing more is asked of them here. */
          if(d.success && d.pay){ window.location.href = d.pay; return; }

          if(d.success){
            this.msg = d.message || 'You’re registered.';
            this.ticketUrl = d.ticket_url || '';
            this.count += (this.qty || 1);
            /* ── THE ONE BURST THAT IS NOT A COMPARISON ──────────────────────
               Fired HERE, on a successful response, and nowhere else. Not on submit: a
               burst followed by "that card was declined" is worse than no burst, and the
               paid path above this does not reach here at all — it hands off to the
               gateway, where nothing has succeeded yet.
               Also deliberately not in joinList(): a waiting list is not a win. */
            this.won = true;
            /* Five sparks and a single slow lap, whatever the tier was. This is not the
               tier ladder speaking — it is one outcome, and it is the same outcome for a
               free General seat as for a Patron table. */
            this.toneMs = 1100; this.toneLaps = 1; this.toneSparks = 5;
            this.burst++;
            this.step='done';
          } else {
            /* The seats went while they were filling the form in. If there is a list, offer
               it here rather than making them find the tier button again — the answer to
               "it sold out just now" is the queue, and they are already typed in. */
            if(d.full && d.waitlist){ this.soldOut = true; this.error = d.message || ''; }
            else { this.error = d.message || 'Could not register. Please try again.'; }
          }
        }catch(e){ this.error='Network error. Please try again.'; }
        finally{ this.busy=false; }
      },

      async joinList(){
        this.busy=true; this.error='';
        try{
          var r = await fetch('/events/'+slug+'/waitlist', {
            method:'POST', headers:{'Content-Type':'application/x-www-form-urlencoded'},
            body: new URLSearchParams({ _token: csrf, name:this.name, email:this.email,
                                        phone:this.phone, tier_id:this.tierId })
          });
          var d = await r.json().catch(function(){ return {}; });
          if(d.success){
            this.wlPlace = d.place || 0;
            this.msg = (d.message || 'You are on the list.')
                     + (d.place ? ' You are number ' + d.place + ' in the queue.' : '');
            this.ticketUrl = '';
            this.step='done';
          } else {
            this.error = d.message || 'Could not add you to the list. Please try again.';
          }
        }catch(e){ this.error='Network error. Please try again.'; }
        finally{ this.busy=false; }
      }
    };
  }
{% if referral and referral.link %}
  /* The copy button. Same shape as the account page's referral panel: the field is a real
     input first, so a browser that refuses the clipboard API — or a page whose script never
     arrived — still leaves the link there to select by hand. The link IS the feature.

     Emitted only when there IS a link, so a page with no referral offer does not ship a
     listener with nothing to listen to. */
  (function(){
    var btn = document.querySelector('[data-rf-copy]');
    if (!btn) return;
    var field = document.getElementById(btn.getAttribute('data-rf-copy'));
    if (!field) return;
    var original = btn.textContent;
    btn.addEventListener('click', function(){
      field.select();
      var done = function(ok){
        btn.textContent = ok ? 'Copied' : 'Press Ctrl+C';
        if (window.agAnnounce) window.agAnnounce(ok ? 'Referral link copied' : 'Select and copy the link');
        setTimeout(function(){ btn.textContent = original; }, 2200);
      };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(field.value).then(function(){ done(true); }, function(){ done(false); });
      } else {
        try { done(document.execCommand('copy')); } catch (e) { done(false); }
      }
    });
  })();
{% endif %}

  function evShare(){
    return {
      note:'',
      async share(){
        var url = location.href;
        try{ if(navigator.share){ await navigator.share({ title: document.title, url: url }); return; } }
        catch(e){ if(e && e.name === 'AbortError') return; }
        try{ await navigator.clipboard.writeText(url); }catch(e){}
        this.note = 'Link copied ✓'; clearTimeout(this._t); this._t = setTimeout(function(){}, 0);
        var self = this; this._t = setTimeout(function(){ self.note = ''; }, 2000);
      }
    };
  }
</script>
{% endblock %}
