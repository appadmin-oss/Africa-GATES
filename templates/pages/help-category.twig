{% extends "layout/gates.twig" %}

{#
  ONE TOPIC, EVERY ANSWER IN IT.

  ── WHY THIS PAGE EXISTS ────────────────────────────────────────────────────
  The Help Centre index used to print all 33 answers inline, because a category
  had nowhere to lead. The corpus is deeply uneven — 12 answers under "Results &
  integrity", 2 under "Privacy" — so in a two-column grid each row was as tall
  as its taller card and left a column of empty page beside the shorter one.

  Giving a category its own page fixes the index (five titles per card, then a
  link) and adds something the index never had: a URL for a whole topic, which
  support can paste and a search engine can index.

  ── SUMMARIES, NOT JUST TITLES ──────────────────────────────────────────────
  A category page is a decision point, not a directory. Somebody who has already
  chosen "Payments" is choosing between seven answers that all sound relevant, so
  each one shows the sentence that tells them whether it is theirs. The index
  shows titles only because there it is competing with five other topics for the
  same screen.
#}

{% block head_styles %}
<style nonce="{{ csp_nonce }}">
  body[data-page="help"]{ background:#eef0ec; color:var(--ag-ink); }
  .hcc{ max-width:920px; margin:0 auto; padding:clamp(1.5rem,4vw,2.4rem) var(--ag-gutter,32px) clamp(3rem,6vw,4rem); }

  .hcc-crumb{ font-size:13px; color:var(--ag-ink-soft); }
  .hcc-crumb a{ color:inherit; text-decoration:none; }
  .hcc-crumb a:hover{ color:var(--ag-green); }

  .hcc-hd{ display:flex; align-items:flex-start; gap:16px; margin:14px 0 0; }
  .hcc-hd__ico{ flex:none; width:52px; height:52px; border-radius:15px; display:flex; align-items:center; justify-content:center; }
  .hcc-hd h1{ margin:0; font-family:var(--ag-font-display); font-weight:700; font-size:clamp(1.5rem,3.6vw,2.1rem); letter-spacing:-.02em; }
  .hcc-hd p{ margin:7px 0 0; font-size:14.5px; line-height:1.6; color:#4a5256; max-width:44rem; }

  /* auto-fit with a `min(100%, …)` floor: two columns where there is room for
     two, one where there is not, and never a track wider than the container —
     which is what makes a bare `minmax(20rem,1fr)` overflow a 320px phone. */
  .hcc-list{ display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,20rem),1fr));
    gap:12px; margin-top:clamp(1.5rem,3vw,2rem); }
  .hcc-item{ display:block; background:var(--ag-surface); border:1px solid rgba(16,41,44,.08); border-radius:16px;
    padding:17px 20px; text-decoration:none; transition:border-color .15s, transform .15s, box-shadow .15s; }
  .hcc-item:hover{ border-color:rgba(16,41,44,.2); transform:translateY(-2px); box-shadow:0 12px 26px -18px rgba(16,41,44,.5); }
  .hcc-item__t{ display:block; font-weight:600; font-size:15px; line-height:1.35; color:var(--ag-ink); }
  .hcc-item__d{ display:block; font-size:13px; line-height:1.55; color:var(--ag-ink-soft); margin-top:5px; }

  /* ── the other topics ──────────────────────────────────────────────────── */
  .hcc-other{ margin-top:clamp(2rem,4vw,2.75rem); }
  .hcc-other h2{ margin:0 0 12px; font-family:var(--ag-font-display); font-weight:700; font-size:1.1rem; }
  .hcc-chips{ display:flex; flex-wrap:wrap; gap:9px; }
  .hcc-chip{ display:inline-flex; align-items:center; gap:8px; background:var(--ag-surface);
    border:1px solid rgba(16,41,44,.1); border-radius:999px; padding:9px 15px; font-size:13.5px;
    font-weight:600; color:var(--ag-ink); text-decoration:none; }
  .hcc-chip:hover{ border-color:var(--ag-green); }
  .hcc-chip b{ font-weight:600; color:var(--ag-ink-soft); }

  .hcc-ask{ position:relative; overflow:hidden; background:var(--ag-ink); border-radius:22px;
    padding:clamp(1.4rem,3vw,1.9rem); margin-top:clamp(2rem,4vw,2.75rem);
    display:flex; align-items:center; justify-content:space-between; gap:20px; flex-wrap:wrap; }
  .hcc-ask h2{ margin:0; font-family:var(--ag-font-display); font-weight:700; font-size:1.2rem; color:#fff; }
  .hcc-ask p{ margin:7px 0 0; font-size:13.5px; line-height:1.6; color:rgba(255,255,255,.78); max-width:34rem; }
  .hcc-ask__t{ flex:1 1 18rem; min-width:0; }
  .hcc-btn{ flex:none; font-family:inherit; font-weight:600; font-size:14px; padding:12px 20px;
    border-radius:999px; text-decoration:none; background:var(--ag-green-light); color:var(--ag-ink); }

  @media (max-width:640px){
    .hcc-hd__ico{ width:44px; height:44px; border-radius:13px; }
    .hcc-ask{ flex-direction:column; align-items:flex-start; }
  }
  @media (prefers-reduced-motion:reduce){
    .hcc-item{ transition:none; }
    .hcc-item:hover{ transform:none; }
  }
</style>
{% endblock %}

{% block content %}
<div class="hcc">

  <nav class="hcc-crumb" aria-label="Breadcrumb">
    <a href="/help">Help Centre</a> <span aria-hidden="true">›</span> {{ category.title }}
  </nav>

  <header class="hcc-hd">
    <span class="hcc-hd__ico" style="background:{{ category.tint }};color:{{ category.fg }}" aria-hidden="true">
      <svg width="25" height="25" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">{{ category.icon|raw }}</svg>
    </span>
    <div>
      <h1>{{ category.title }}</h1>
      <p>{{ category.blurb }} {{ articles|length }} answer{{ articles|length == 1 ? '' : 's' }}.</p>
    </div>
  </header>

  <div class="hcc-list">
    {% for a in articles %}
      <a class="hcc-item" href="/help/{{ a.slug }}">
        <span class="hcc-item__t">{{ a.title }}</span>
        <span class="hcc-item__d">{{ a.summary }}</span>
      </a>
    {% endfor %}
  </div>

  {# Sideways, not just back. Somebody who did not find their answer here is far
     more likely to want the next topic than the index again — and the counts are
     shown because "Privacy (2)" sets an honest expectation before the click. #}
  <section class="hcc-other">
    <h2>Other topics</h2>
    <div class="hcc-chips">
      {% for key, c in categories %}
        {% if key != category_key %}
          <a class="hcc-chip" href="/help/c/{{ key }}">{{ c.title }} <b>{{ counts[key] }}</b></a>
        {% endif %}
      {% endfor %}
    </div>
  </section>

  <div class="hcc-ask">
    <div class="hcc-ask__t">
      <h2>Not here?</h2>
      <p>The assistant can look up your own payment, re-check it with the bank and add missing votes on the
         spot — none of which an article can do. If it cannot, a person picks it up.</p>
    </div>
    <a class="hcc-btn" href="/support/assistant">Ask the assistant</a>
  </div>
</div>
{% endblock %}
