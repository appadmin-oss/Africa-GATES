{% extends 'layout/shell.twig' %}

{#
  ══════════════════════════════════════════════════════════════════════════════
  THE ERROR PAGE — 404 · 403 · 405 · 5xx · 503 (planned work) · Handlers\ErrorHandler
  Rebuilt in Phase 9 on the shell (inventory: pages--error.md). No DC draws it; it is
  the house's own parts: a code, a Playfair heading, one paragraph, two ways on.
  ══════════════════════════════════════════════════════════════════════════════

  ── WHAT IT MUST NEVER SAY ──────────────────────────────────────────────────
  "Our team has been notified and is on it." Nobody is notified: the exception goes to a
  log whose only reader is a diagnostics route, on a host with no shell. Telling somebody
  their problem is already being handled is the most effective way to stop them
  reporting it. So a 5xx says plainly that this is ours, that nothing of theirs is lost,
  and gives them something to DO — the reference PublicFault::record() wrote first on the
  log line, so whatever they quote finds the entry. It never prints a stack trace: the
  handler passes the exception's message only when APP_ENV=development.

  ── AND WHERE IT SENDS PEOPLE ───────────────────────────────────────────────
  A 5xx catches somebody mid-something, very often paying, so it offers the Gee help desk
  carrying the reference (`?gee=support&ref=`), which can say what is degraded and repair a
  stuck payment, and /status. A 404 offers home and Discover. A 403 offers sign-in.
  Colour tier 1: the primary button.
#}
{% set colour_tier = '1' %}
{% set app_bar = {variant: 'child', title: 'Africa GATES', back: '/'} %}
{% set _five = code >= 500 and code != 503 %}
{# A site closed for planned work has no tabs to offer: every one of them is the same closed
   page. The flow shell drops the tab bar (MaintenanceGate). #}
{% set flow_page = code == 503 and planned|default(null) is not empty %}

{% if code == 404 %}
  {% set _m = 'The page you’re looking for has moved or never existed. Everything else is still here.'|trans %}
{% elseif code == 403 %}
  {% set _m = 'You may need to sign in, or to have permission for this page. Signing in with the right account usually fixes it.'|trans %}
{% elseif code == 503 %}
  {% set _m = 'Part of the site is paused while we finish some work. Nothing of yours is lost — try again shortly.'|trans %}
  {# The window an operator announced (MaintenanceGate): what, and until when, so nobody is
     sent back forty times by "shortly" about a two-hour job. #}
  {% set _plan = planned|default(null) %}
  {% if _plan %}
    {% set _m = 'The site is closed while we finish planned work. Nothing of yours is lost: votes, entries, tickets and payments made before it started are all kept.'|trans %}
  {% endif %}
{% elseif _five %}
  {% set _m = 'This is our fault, not yours. Your votes, entries and payments are safe. Try again soon; if it happens twice, send us the reference below.'|trans %}
{% else %}
  {% set _m = 'That didn’t work as expected. Let’s get you back on track.'|trans %}
{% endif %}
{# `message` is an empty string for every case the template owns, so test it rather than
   default it — `|default` does not fire on '' and the page would print an empty line. #}
{% set _msg = (message is defined and message) ? message : _m %}

{% block head_styles %}<link rel="stylesheet" href="{{ asset('/assets/css/components/error.css') }}"><meta name="robots" content="noindex">{% endblock %}

{% block content %}
<section class="er" aria-labelledby="er-h">
  <p class="er__code">{{ 'Error %c%'|trans({'%c%': code}) }}</p>
  <h1 class="er__h" id="er-h">{{ heading|trans }}</h1>
  <p class="er__m">{{ _msg }}</p>
  {% if code == 503 and _plan|default(null) %}
    <dl class="er__plan">
      <div><dt>{{ 'What'|trans }}</dt><dd>{{ _plan.title }}</dd></div>
      <div><dt>{{ 'Back by'|trans }}</dt><dd><time datetime="{{ _plan.to|date('c') }}">{{ _plan.to|when('j M, H:i') }}</time> {{ tz_abbr() }}</dd></div>
      {% if _plan.note %}<div><dt>{{ 'What you will notice'|trans }}</dt><dd>{{ _plan.note }}</dd></div>{% endif %}
    </dl>
  {% endif %}

  {# The likeliest answer FIRST: on a phone, below two full-width buttons it was the last
     thing on screen. #}
  {% if code == 404 and suggest|default(null) and suggest.items|default([]) %}
    <section class="er__sug" aria-labelledby="er-sug-h">
      <h2 class="er__sug-h" id="er-sug-h">{{ 'Were you looking for…'|trans }}</h2>
      <ul class="er__sug-l">
        {% for i in suggest.items %}
          <li><a class="er__sug-a" href="{{ i.url }}"><span class="er__sug-t">{{ i.title }}</span>{% if i.meta %}<span class="er__sug-m">{{ i.meta }}</span>{% endif %}</a></li>
        {% endfor %}
      </ul>
    </section>
  {% endif %}

  <div class="er__act">
    {% if code == 503 and _plan|default(null) %}
      <a class="er__btn er__btn--p" href="/status">{{ 'Follow it on the status page'|trans }}</a>
      {# The one way back in for whoever is doing the work: sign-in stays open (MaintenanceGate). #}
      <a class="er__btn" href="/account/login?next=%2Fadmin">{{ 'Staff sign-in'|trans }}</a>
    {% elseif _five or code == 503 %}
      <a class="er__btn er__btn--p" href="{{ request_path|default('/') }}">{{ 'Try again'|trans }}</a>
      <a class="er__btn" href="/status">{{ 'Is it working?'|trans }}</a>
    {% elseif code == 403 %}
      <a class="er__btn er__btn--p" href="/account/login?next={{ request_path|default('/')|url_encode }}">{{ 'Sign in'|trans }}</a>
      <a class="er__btn" href="/">{{ 'Back to home'|trans }}</a>
    {% else %}
      <a class="er__btn er__btn--p" href="/">{{ 'Back to home'|trans }}</a>
      {# Not beside a search box that is already filled in below. #}
      {% if not (code == 404 and suggest|default(null) and suggest.q) %}<a class="er__btn" href="/discover">{{ 'Search Africa GATES'|trans }}</a>{% endif %}
    {% endif %}
  </div>

  {# "Were you looking for …" (NotFoundSuggest): the words in the broken address, searched.
     A broken link usually still holds what somebody wanted — a name, an award. The box is
     filled with those words, for whoever the suggestions above did not answer. #}
  {% if code == 404 and suggest|default(null) and suggest.q %}
    <form class="er__find" method="get" action="/discover" role="search">
      <label class="er__find-l" for="er-q">{{ suggest.items|default([]) ? 'Or search for it'|trans : 'Search for it'|trans }}</label>
      <span class="er__find-row">
        <input class="er__find-i" id="er-q" type="search" name="q" value="{{ suggest.q }}" autocomplete="off" enterkeyhint="search">
        <button class="er__btn er__btn--p" type="submit">{{ 'Search'|trans }}</button>
      </span>
    </form>
  {% endif %}

  {% if error_ref is defined and error_ref %}
    <div class="er__ref">
      <p class="er__ref-l">{{ 'Your reference'|trans }} <code class="er__ref-code">{{ error_ref }}</code></p>
      <p class="er__ref-p">{{ 'Quote it and we can find exactly what failed.'|trans }}
        <a href="/help?{{ {gee: 'support', q: ('Something went wrong. Reference '|trans) ~ error_ref}|url_encode }}">{{ 'Tell Gee'|trans }}</a> {{ 'or'|trans }}
        <a href="/support">{{ 'reach a person'|trans }}</a>.</p>
    </div>
  {% endif %}
</section>
{% endblock %}
