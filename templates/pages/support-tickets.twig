{% extends "layout/gates.twig" %}

{% block head_styles %}
<style nonce="{{ csp_nonce }}">
  body[data-page="support"]{ background:#f4f6f5; }
  body[data-page="support"] [x-cloak]{ display:none !important; }

  .st{ max-width:860px; margin:0 auto; padding:clamp(1.2rem,3.5vw,2rem) var(--ag-gutter,40px) 64px; }
  .st-eyebrow{ margin:0 0 6px; font:700 11.5px/1 var(--ag-font-mono,monospace); letter-spacing:.14em;
               text-transform:uppercase; color:var(--ag-green,#237b22); }
  /* `.st .st-h1`, not `.st-h1`. The layout sets `.ag-scope h1 { font-size: var(--ag-fs-hero) }`,
     which is specificity (0,1,1) and beats a bare class — so every page-level h1
     rule in this codebase is silently overridden unless it is qualified. That is
     why this heading once rendered at 72px with a rule asking for 24px. */
  .st .st-h1{ margin:0; font-family:var(--ag-font-display); font-weight:700;
              font-size:clamp(1.6rem,3.4vw,2.1rem); line-height:1.1; color:var(--ag-ink,#10292c); }
  /* A ticket subject is DERIVED from what someone typed, so it is a sentence and
     not a headline — set at display size it ran to four lines and pushed the
     conversation below the fold, which is the one thing this page exists to show.
     Smaller, tighter, and `anywhere` so a pasted reference cannot widen the page. */
  .st .st-h1--subject{ font-size:clamp(1.15rem,2.2vw,1.5rem); line-height:1.28;
                       overflow-wrap:anywhere; hyphens:auto; }
  .st-sub{ margin:8px 0 0; max-width:60ch; font-size:14.5px; line-height:1.6; color:#5a6d6f; }

  .st-card{ background:#fff; border:1px solid rgba(16,41,44,.09); border-radius:18px;
            padding:16px 18px; margin-top:16px; }
  .st-card > h2{ margin:0 0 4px; font-size:15.5px; font-weight:700; color:var(--ag-ink,#10292c); }

  /* ── list ──────────────────────────────────────────────────────────────── */
  .st-filters{ display:flex; gap:8px; flex-wrap:wrap; margin:18px 0 0; }
  .st-filters button{ border:1px solid rgba(16,41,44,.14); background:#fff; cursor:pointer;
                      font:600 12.5px/1 inherit; color:#3d4c4e; padding:8px 13px; border-radius:999px; }
  .st-filters button[aria-pressed="true"]{ background:var(--ag-ink,#10292c); border-color:var(--ag-ink,#10292c); color:#fff; }
  .st-filters button:focus-visible{ outline:2px solid var(--ag-green,#237b22); outline-offset:2px; }

  .st-list{ list-style:none; margin:12px 0 0; padding:0; display:flex; flex-direction:column; gap:10px; }
  .st-row{ display:flex; align-items:center; gap:12px; padding:13px 15px; background:#fff;
           border:1px solid rgba(16,41,44,.09); border-radius:14px; text-decoration:none; color:inherit; }
  .st-row:hover{ border-color:rgba(16,41,44,.22); }
  .st-row:focus-visible{ outline:2px solid var(--ag-green,#237b22); outline-offset:2px; }
  .st-row__t{ flex:1; min-width:0; }
  .st-row__s{ display:block; font-weight:600; font-size:14.5px; color:var(--ag-ink,#10292c);
              overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .st-row__m{ display:block; margin-top:2px; font:500 12.5px/1.4 var(--ag-font-mono,monospace); color:#8a9a9c; }
  .st-tags{ flex:none; display:flex; gap:6px; align-items:center; }
  .st-tag{ font:700 10.5px/1 var(--ag-font-mono,monospace); letter-spacing:.06em;
           text-transform:uppercase; border-radius:999px; padding:5px 9px; white-space:nowrap; }
  .st-tag--open{ background:#e6f4e6; color:#1c6b1c; border:1px solid #bfe3bf; }
  .st-tag--closed{ background:#f2f5f2; color:#5a6d6f; border:1px solid rgba(16,41,44,.1); }
  .st-tag--urgent{ background:#fdf3f3; color:#a32020; border:1px solid #f0c9c9; }
  .st-tag--high{ background:#fdf6e3; color:#7a611a; border:1px solid #efe0b5; }

  /* ── thread ────────────────────────────────────────────────────────────── */
  .st-msgs{ display:flex; flex-direction:column; gap:16px; margin-top:14px; }
  .st-msg{ display:flex; gap:11px; align-items:flex-start; }
  .st-msg__av{ flex:none; width:30px; height:30px; border-radius:50%; display:flex; align-items:center;
               justify-content:center; font-size:12px; font-weight:800; }
  .st-msg--staff .st-msg__av{ background:#10292C; color:#7FC87C; }
  .st-msg--me    .st-msg__av{ background:#eef6ee; color:#1c6b1c; }
  .st-msg__b{ min-width:0; flex:1; }
  .st-msg__who{ display:flex; align-items:center; gap:7px; flex-wrap:wrap;
                font-size:12.5px; font-weight:700; color:#5a6d6f; }
  .st-msg__when{ font-weight:500; color:#8a9a9c; }
  /* Says what wrote it. A member who is told a person read their ticket and
     later works out it was a machine has been lied to about the one thing
     support cannot lie about — whether anyone is actually looking. */
  .st-bot{ font:700 9.5px/1 var(--ag-font-mono,monospace); letter-spacing:.07em; text-transform:uppercase;
           color:#28536b; background:#eef5fb; border:1px solid #cfe1f0; border-radius:4px; padding:3px 5px; }
  /* A ticket carries whatever a person typed — a pasted reference, a URL, a
     stack trace. `anywhere` is what stops one unbroken run widening the card. */
  .st-msg__x{ margin:3px 0 0; font-size:14.5px; line-height:1.62; color:#2c3a3c;
              white-space:pre-wrap; overflow-wrap:anywhere; }

  .st-form{ margin-top:14px; display:flex; flex-direction:column; gap:10px; }
  .st-in, .st-ta{ width:100%; border:1px solid rgba(16,41,44,.14); border-radius:12px; font:inherit;
                  font-size:15px; padding:11px 13px; color:var(--ag-ink,#10292c); background:#fff; }
  .st-ta{ min-height:112px; resize:vertical; line-height:1.55; }
  .st-in:focus, .st-ta:focus{ outline:2px solid var(--ag-green,#237b22); outline-offset:1px; }
  .st-hint{ margin:6px 0 0; font-size:12.5px; line-height:1.55; color:#8a9a9c; }
  .st-hint a{ color:var(--ag-green,#237b22); font-weight:600; }
  .st-row2{ display:flex; align-items:center; gap:12px; flex-wrap:wrap; }
  .st-go{ border:0; background:var(--ag-green,#237b22); color:#fff; font-weight:700;
          font-size:14px; padding:11px 20px; border-radius:999px; cursor:pointer; }
  .st-go[disabled]{ opacity:.45; cursor:default; }
  .st-count{ font:500 12.5px/1 var(--ag-font-mono,monospace); color:#8a9a9c; }
  .st-note{ margin:0; font-size:13.5px; line-height:1.5; font-weight:600; }
  .st-note--ok{ color:#1c6b1c; } .st-note--err{ color:#a32020; }

  .st-empty{ margin:14px 0 0; padding:22px 18px; text-align:center; background:#fff;
             border:1px dashed rgba(16,41,44,.16); border-radius:14px; }
  .st-empty p{ margin:0; font-size:14px; line-height:1.65; color:#5a6d6f; }
  .st-empty a{ color:var(--ag-green,#237b22); font-weight:700; }
  .st-link{ border:0; background:none; padding:0; cursor:pointer;
            font:700 14px/1.65 inherit; color:var(--ag-green,#237b22); text-decoration:underline; }
  .st-back{ display:inline-block; margin-bottom:12px; font-size:13.5px; font-weight:700;
            color:var(--ag-green,#237b22); text-decoration:none; }
  .st-back:hover{ text-decoration:underline; }
</style>
{% endblock %}

{% block content %}
{# ══════════════════════════════════════════════════════════════════════════
   TICKETS

   The half of support the assistant cannot be. A conversation ends when you
   close the tab; a ticket is a thing with a reference, a state and a reply you
   can come back for — which is what somebody whose money has gone missing
   actually needs.

   Members only, and not as gatekeeping: a ticket is a promise to reply, a reply
   needs an address we have verified, and following it needs an account to
   follow it FROM. A visitor still reaches the same team through the assistant's
   "talk to a human"; they just cannot be promised a thread.
   ══════════════════════════════════════════════════════════════════════════ #}
<section class="ag-scope st" x-data="ticketDesk()">

  {% if thread %}
    <a class="st-back" href="/support/tickets">← All tickets</a>
    <p class="st-eyebrow">Ticket {{ thread.ticket.reference }}</p>
    <h1 class="st-h1 st-h1--subject">{{ thread.ticket.subject }}</h1>
    <p class="st-sub">
      Opened {{ thread.ticket.created_at|date('j M Y, H:i') }} ·
      <span class="st-tag st-tag--{{ thread.ticket.status == 'open' ? 'open' : 'closed' }}">{{ thread.ticket.status }}</span>
      {% if thread.ticket.severity != 'normal' %}
      <span class="st-tag st-tag--{{ thread.ticket.severity }}">{{ thread.ticket.severity }}</span>
      {% endif %}
    </p>

    <div class="st-card">
      <h2>What you told us</h2>
      <p class="st-msg__x">{{ thread.ticket.transcript }}</p>
    </div>

    {% if thread.messages %}
    <div class="st-card">
      <h2>Replies</h2>
      <div class="st-msgs">
        {% for m in thread.messages %}
        <div class="st-msg {{ m.staff ? 'st-msg--staff' : 'st-msg--me' }}">
          <span class="st-msg__av" aria-hidden="true">{{ m.staff ? 'G' : (m.from|first|upper) }}</span>
          <div class="st-msg__b">
            <div class="st-msg__who">
              <span>{{ m.from }}</span>
              {% if m.agent %}<span class="st-bot" title="Written by the support assistant, not by a person">automated</span>{% endif %}
              <span class="st-msg__when">{{ m.created_at|date('j M, H:i') }}</span>
            </div>
            <p class="st-msg__x">{{ m.body }}</p>
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    <div class="st-card">
      <h2>{{ thread.ticket.status == 'open' ? 'Add a reply' : 'Not settled? Reply and it reopens' }}</h2>
      <form class="st-form" @submit.prevent="reply('{{ thread.ticket.reference }}')">
        <label class="sr-only" for="stReply">Your reply</label>
        <textarea class="st-ta" id="stReply" x-model="replyBody" maxlength="5000"
                  placeholder="Anything to add?"></textarea>
        <div class="st-row2">
          <button class="st-go" type="submit" :disabled="busy || !replyBody.trim()">Send reply</button>
          <span class="st-count" x-show="replyBody.length > 4000" x-cloak
                x-text="(5000 - replyBody.length) + ' characters left'"></span>
          <p class="st-note" :class="noteOk ? 'st-note--ok' : 'st-note--err'" x-show="!!note" x-cloak x-text="note"></p>
        </div>
      </form>
      <p class="st-hint">Your reply reaches the team by email, and theirs reaches you the same way.</p>
    </div>

  {% else %}
    <p class="st-eyebrow">Support</p>
    <h1 class="st-h1">Your tickets</h1>
    <p class="st-sub">Everything you have raised, and every reply — from the team or from the assistant.
      Each one reaches you by email as well as appearing here.</p>

    {% if not_found %}
    <div class="st-card"><p class="st-note st-note--err" style="margin:0">No ticket <strong>{{ not_found }}</strong> on this account.</p></div>
    {% endif %}

    <div class="st-card">
      <h2>Raise a ticket</h2>
      <p class="st-hint" style="margin-top:2px">Payments, votes, your account — anything the
        <a href="/support/assistant">assistant</a> could not settle.</p>
      <form class="st-form" @submit.prevent="create()">
        <label class="sr-only" for="stSubject">Subject</label>
        <input class="st-in" id="stSubject" x-model="subject" maxlength="180"
               placeholder="Subject (optional — I will write one from your message)">
        <label class="sr-only" for="stBody">What has gone wrong?</label>
        <textarea class="st-ta" id="stBody" x-model="body" maxlength="5000"
                  placeholder="What has gone wrong? Include a payment reference if you have one."></textarea>
        <div class="st-row2">
          <button class="st-go" type="submit" :disabled="busy || !body.trim()">Open ticket</button>
          <p class="st-note" :class="noteOk ? 'st-note--ok' : 'st-note--err'" x-show="!!note" x-cloak x-text="note"></p>
        </div>
      </form>
      {# Said BEFORE they write, not after. Somebody who knows a reference makes
         the difference will go and find one. #}
      <p class="st-hint">A payment reference is the single most useful thing you can include — it is on the
        payment page, in your bank alert, and in any receipt you did get. With one, the assistant can
        usually put it right before a person even opens this.</p>
    </div>

    {% if tickets %}
    <div class="st-filters" role="group" aria-label="Filter tickets by status">
      <button type="button" @click="filter = 'all'"    :aria-pressed="filter === 'all'">All ({{ tickets|length }})</button>
      <button type="button" @click="filter = 'open'"   :aria-pressed="filter === 'open'">Open</button>
      <button type="button" @click="filter = 'closed'" :aria-pressed="filter === 'closed'">Settled</button>
    </div>

    <ul class="st-list">
      {% for t in tickets %}
      <li x-show="shown('{{ t.status }}')">
        <a class="st-row" href="/support/tickets?ref={{ t.reference|url_encode }}">
          <span class="st-row__t">
            <span class="st-row__s">{{ t.subject }}</span>
            <span class="st-row__m">{{ t.reference }} · {{ t.created_at|date('j M Y') }}</span>
          </span>
          <span class="st-tags">
            {% if t.severity != 'normal' %}<span class="st-tag st-tag--{{ t.severity }}">{{ t.severity }}</span>{% endif %}
            <span class="st-tag st-tag--{{ t.status == 'open' ? 'open' : 'closed' }}">{{ t.status }}</span>
          </span>
        </a>
      </li>
      {% endfor %}
    </ul>

    {# A filter that hides everything has to say so, or it reads as a broken page. #}
    <div class="st-empty" x-show="!anyShown()" x-cloak>
      <p>Nothing <span x-text="filter === 'open' ? 'still open' : 'settled'"></span> right now.
        <button type="button" class="st-link" @click="filter = 'all'">Show all</button></p>
    </div>
    {% else %}
    <div class="st-empty">
      <p>No tickets yet — which is the good outcome.<br>
        If something is wrong, the <a href="/support/assistant">assistant</a> can often fix it on the spot.</p>
    </div>
    {% endif %}
  {% endif %}
</section>

<script nonce="{{ csp_nonce }}">
function ticketDesk(){
  return {
    subject: '', body: '', replyBody: '', busy: false, note: '', noteOk: false,
    filter: 'all',
    /* The rows are rendered server-side and the filter hides them in place, so
       this component needs to know which statuses EXIST to tell an empty filter
       from an empty account. Two different messages, two different fixes. */
    statuses: {{ (tickets|default([]))|map(t => t.status)|json_encode|raw }},

    shown(status){ return this.filter === 'all' || (this.filter === 'open') === (status === 'open'); },
    anyShown(){ return this.statuses.some(s => this.shown(s)); },

    post(url, params){
      this.busy = true; this.note = '';
      return fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
        body: new URLSearchParams(params)
      })
        .then(r => r.json())
        .catch(() => ({ ok: false, message: 'Lost the connection. Please try again.' }))
        .finally(() => { this.busy = false; });
    },

    create(){
      if (!this.body.trim() || this.busy) return;
      this.post('/api/v1/support/ticket', { subject: this.subject, body: this.body, page_url: location.href })
        .then(j => {
          this.noteOk = !!j.ok; this.note = j.message || '';
          // Signed out mid-form — a session can expire while somebody types. Send
          // them where they can act rather than leaving a refusal on screen.
          if (j.code === 'SIGN_IN' && j.login_url) { setTimeout(() => { location.href = j.login_url; }, 1400); return; }
          // Reload so the new ticket appears in the list rather than being
          // described as existing somewhere the reader cannot see.
          if (j.ok) setTimeout(() => location.reload(), 900);
        });
    },

    reply(ref){
      if (!this.replyBody.trim() || this.busy) return;
      this.post('/api/v1/support/reply', { reference: ref, body: this.replyBody })
        .then(j => {
          this.noteOk = !!j.ok; this.note = j.message || '';
          if (j.ok) { this.replyBody = ''; setTimeout(() => location.reload(), 900); }
        });
    }
  };
}
</script>
{% endblock %}
