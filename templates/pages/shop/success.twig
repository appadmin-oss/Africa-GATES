{% extends 'layout/shell.twig' %}
{#
  /shop/success — the order receipt (ShopCheckoutController::success). ShopPage view=done
  (GAPS route map, Phase 7); rebuilt on the shell with the other receipts after the 3 Oct
  destroy left every paid order landing on a 500.

  No celebration: an order is not one of the moments §7.8 names. A confirmed order links to
  its own page (`/shop/order/{ref}`), which a buyer can reopen with the reference alone —
  this page shows once, that one is the order. The unconfirmed state says what is safe:
  nothing taken that we know of, and a re-check that carries the reference.
#}
{% set colour_tier = '2' %}
{% set app_bar = {variant: 'child', share: false, title: confirmed ? 'Order confirmed'|trans : 'Confirming your order'|trans, back: '/shop'} %}
{% set _qty = 0 %}{% for l in items|default([]) %}{% set _qty = _qty + (l.qty|default(0)) %}{% endfor %}

{% block head_styles %}
  <link rel="stylesheet" href="{{ asset('/assets/css/components/receipt.css') }}">
  <meta name="robots" content="noindex, nofollow">
{% endblock %}

{% block content %}
<div class="rc">
  <section class="rc__card" aria-labelledby="rcH">
    {% if confirmed %}
      <div class="rc__verdict rc__verdict--ok" role="status">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
        <div class="rc__verdict-b"><p class="rc__verdict-t">{{ 'Paid'|trans }}</p>
          <p class="rc__verdict-s">{{ 'A receipt and any updates will be emailed to you.'|trans }}</p></div>
      </div>
      <h1 class="rc__h1" id="rcH">{{ 'Order confirmed'|trans }}</h1>
      <p class="rc__p">{{ (_qty == 1 ? 'Your order of %n% item is confirmed and being prepared.' : (_qty > 1 ? 'Your order of %n% items is confirmed and being prepared.' : 'Your order is confirmed and being prepared.'))|trans({'%n%': _qty}) }}</p>
      <dl class="rc__ref"><dt>{{ 'Order'|trans }}</dt><dd>{{ reference }}</dd>
        {%- if subtotal_naira|default(0) > 0 %}<dd class="rc__ref-amount">₦{{ subtotal_naira|number_format }}</dd>{% endif -%}
      </dl>
      <div class="rc__do">
        <a class="ag-btn ag-btn--primary" href="/shop/order/{{ reference|url_encode }}">{{ 'Track this order'|trans }}</a>
        <a class="ag-btn ag-btn--secondary" href="/shop">{{ 'Continue shopping'|trans }}</a>
      </div>
    {% else %}
      <div class="rc__verdict rc__verdict--wait" role="status">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7.5V12l3.2 1.9"/></svg>
        <div class="rc__verdict-b"><p class="rc__verdict-t">{{ 'Not confirmed yet'|trans }}</p>
          <p class="rc__verdict-s">{{ 'No charge is confirmed until you receive an emailed receipt.'|trans }}</p></div>
      </div>
      <h1 class="rc__h1" id="rcH">{{ 'We’re confirming your order'|trans }}</h1>
      <p class="rc__p">{{ 'If you were charged it reconciles automatically and a receipt follows by email. If nothing was charged, nothing was taken.'|trans }}</p>
      {% if reference %}<dl class="rc__ref"><dt>{{ 'Reference'|trans }}</dt><dd>{{ reference }}</dd></dl>{% endif %}
      <div class="rc__do">
        <a class="ag-btn ag-btn--primary" href="/support/assistant?topic=payment{{ reference ? '&ref=' ~ reference|url_encode ~ '&ask=1' : '' }}">{{ 'Re-check this payment'|trans }}</a>
        <a class="ag-btn ag-btn--secondary" href="/shop">{{ 'Back to the shop'|trans }}</a>
      </div>
    {% endif %}
  </section>
</div>
{% endblock %}
