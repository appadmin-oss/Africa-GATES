{% extends "layout/gates.twig" %}

{% block head_styles %}
<style nonce="{{ csp_nonce }}">
  body[data-page="shop"]{ background:#eef0ec; color:var(--ag-ink); }
  body[data-page="shop"] [x-cloak]{ display:none !important; }
  .shop{ max-width:1180px; margin:0 auto; padding:0 var(--ag-gutter,32px) 60px; }

  .sh-hero{ position:relative; overflow:hidden; border-radius:24px; margin-top:24px; background:radial-gradient(130% 130% at 80% 0%,#1d5b2a,#10292C 60%); padding:clamp(2.4rem,5vw,2.75rem) clamp(1.6rem,4vw,2.5rem); color:#fff; }
  .sh-hero__orb{ position:absolute; right:-60px; bottom:-80px; width:320px; height:320px; border-radius:50%; background:radial-gradient(circle,rgba(212,154,14,.28),transparent 68%); }
  .sh-hero__in{ position:relative; max-width:560px; }
  .sh-badge{ display:inline-flex; align-items:center; gap:7px; font-size:11px; font-weight:700; letter-spacing:.1em; text-transform:uppercase; color:#ffd24a; background:rgba(8,26,16,.55); box-shadow:inset 0 0 0 1px rgba(212,154,14,.32); padding:7px 14px; border-radius:999px; }
  .sh-hero h1{ margin:16px 0 0; color:#fff; font-family:var(--ag-font-display); font-weight:800; font-size:clamp(2rem,5vw,2.6rem); line-height:1.04; letter-spacing:-.02em; }
  .sh-hero p{ margin:14px 0 0; font-size:15.5px; line-height:1.6; color:rgba(255,255,255,.85); max-width:460px; }

  /* search + sort — a real form, so it works with JS off and the URL is shareable */
  .sh-find{ display:flex; gap:10px; flex-wrap:wrap; align-items:center; margin-top:22px; }
  .sh-search{ flex:1 1 260px; position:relative; display:flex; }
  .sh-search input{ width:100%; border:1px solid rgba(16,41,44,.14); border-radius:999px; padding:11px 42px 11px 42px; font-family:inherit; font-size:14px; color:var(--ag-ink); background:var(--ag-surface,#fff); outline:none; }
  .sh-search input:focus{ border-color:var(--ag-green); box-shadow:0 0 0 3px rgba(35,123,34,.1); }
  .sh-search__i{ position:absolute; left:15px; top:50%; transform:translateY(-50%); color:var(--ag-ink-soft,#626a6e); pointer-events:none; }
  .sh-search__go{ position:absolute; right:5px; top:5px; bottom:5px; cursor:pointer; border:none; background:var(--ag-ink); color:#fff; font-family:inherit; font-size:12.5px; font-weight:600; padding:0 15px; border-radius:999px; }
  .sh-sort{ display:inline-flex; align-items:center; gap:7px; font-size:13px; color:#4a5256; }
  .sh-sort select{ border:1px solid rgba(16,41,44,.16); border-radius:999px; padding:9px 13px; font-family:inherit; font-size:16px; background:var(--ag-surface,#fff); color:var(--ag-ink); cursor:pointer; }
  .sh-ship{ display:flex; align-items:center; gap:9px; background:#eafaf0; border:1px solid rgba(35,123,34,.2); border-radius:14px; padding:11px 16px; margin-top:16px; font-size:13.5px; color:#10292C; }
  .sh-ship b{ font-weight:700; }

  .sh-bar{ display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap; margin-top:24px; }
  .sh-filters{ display:flex; gap:8px; overflow-x:auto; scrollbar-width:none; }
  .sh-filters::-webkit-scrollbar{ display:none; }
  .sh-chip{ flex:none; cursor:pointer; font-family:inherit; font-size:13px; font-weight:600; padding:9px 16px; border-radius:999px; border:1px solid rgba(16,41,44,.12); background:var(--ag-surface,#fff); color:#4a5256; }
  .sh-chip.is-on{ background:var(--ag-ink); color:#fff; border-color:var(--ag-ink); }
  .sh-count{ font-size:13px; color:#626a6e; }
  .sh-region{ display:inline-flex; align-items:center; gap:6px; font-size:13px; color:#4a5256; }
  .sh-region select{ border:1px solid rgba(16,41,44,.16); border-radius:999px; padding:6px 11px; font-family:inherit; font-size:16px; background:var(--ag-surface,#fff); color:var(--ag-ink); cursor:pointer; }

  .sh-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:20px; margin-top:20px; }
  @media(max-width:860px){ .sh-grid{ grid-template-columns:repeat(2,1fr); } }
  @media(max-width:520px){ .sh-grid{ grid-template-columns:1fr 1fr; gap:12px; } }
  .sh-card{ background:var(--ag-surface,#fff); border:1px solid rgba(16,41,44,.08); border-radius:18px; overflow:hidden; transition:transform .15s, box-shadow .15s, border-color .15s; }
  .sh-card:hover{ transform:translateY(-3px); border-color:rgba(16,41,44,.18); box-shadow:0 18px 36px -24px rgba(16,41,44,.4); }
  .sh-card__cover{ position:relative; display:block; aspect-ratio:1/1; background-size:cover; background-position:center; text-decoration:none; }
  .sh-card__tag{ position:absolute; top:12px; left:12px; font-size:10px; font-weight:600; letter-spacing:.04em; text-transform:uppercase; padding:5px 10px; border-radius:999px; }
  .sh-tag--Bestseller{ background:#fff8df; color:#7a5600; }
  .sh-tag--New{ background:#eef7ee; color:#1a6118; }
  .sh-tag--Limited{ background:#fdeaf0; color:#9c2b48; }
  .sh-card__body{ padding:16px; }
  .sh-card__cat{ font-size:11px; color:#5a6d6f; text-transform:uppercase; letter-spacing:.05em; }
  .sh-card__name{ font-weight:600; font-size:15.5px; color:var(--ag-ink); margin-top:4px; text-decoration:none; display:block; }
  .sh-card__row{ display:flex; align-items:center; justify-content:space-between; margin-top:14px; gap:10px; flex-wrap:wrap; }
  .sh-card__price{ font:700 17px/1 var(--ag-font-mono); color:var(--ag-ink); }
  /* `white-space:nowrap` and `flex:none`, because "Choose colour" was breaking across two
     lines inside the pill and dragging the card's height with it — a grid of cards at four
     different heights reads as a broken layout. The row wraps instead, which puts the price
     on its own line on a narrow card and keeps every button one line. */
  .sh-add{ cursor:pointer; border:none; background:var(--ag-green); color:#fff; font-family:inherit; font-size:13px; font-weight:600; padding:9px 15px; border-radius:999px; display:inline-flex; align-items:center; gap:6px; text-decoration:none; white-space:nowrap; flex:none; }
  .sh-add:hover{ background:var(--ag-green-dark); }
  .sh-add[disabled]{ background:#dfe4e3; color:#5b6669; cursor:not-allowed; }
  /* stock, said out loud on the card — an "Add" button for something sold out is a promise
     the checkout then has to break */
  .sh-card__stock{ font-size:11.5px; font-weight:700; margin-top:6px; }
  .sh-card__stock.is-low{ color:#8a2020; }
  .sh-card__stock.is-gone{ color:#8a5a00; }
  .sh-card__stock.is-opt{ color:#5a6d6f; font-weight:600; }
  .sh-card__sub{ font-size:12.5px; line-height:1.5; color:var(--ag-ink-soft,#626a6e); margin-top:3px; }
  .sh-card--gone .sh-card__cover{ filter:grayscale(.7) opacity(.65); }

  /* paging */
  .sh-pager{ display:flex; align-items:center; justify-content:center; gap:8px; flex-wrap:wrap; margin-top:26px; }
  .sh-pager a, .sh-pager span{ font-size:13px; font-weight:600; padding:9px 14px; border-radius:999px; border:1px solid rgba(16,41,44,.12); background:var(--ag-surface,#fff); color:#4a5256; text-decoration:none; }
  .sh-pager .is-here{ background:var(--ag-ink); border-color:var(--ag-ink); color:#fff; }
  .sh-pager .is-off{ opacity:.4; pointer-events:none; }

  .sh-mission{ background:var(--ag-surface,#fff); border:1px solid rgba(16,41,44,.08); border-radius:20px; padding:24px 28px; display:flex; align-items:center; gap:18px; flex-wrap:wrap; margin-top:28px; }
  .sh-mission__i{ flex:none; width:48px; height:48px; border-radius:13px; background:#effaf0; color:#1a6118; display:flex; align-items:center; justify-content:center; }
  .sh-mission__b{ flex:1; min-width:220px; }
  .sh-mission__b b{ font-size:16px; color:var(--ag-ink); }
  .sh-mission__b div{ font-size:13.5px; color:#626a6e; margin-top:3px; }

  .sh-empty{ background:var(--ag-surface,#fff); border:1px solid rgba(16,41,44,.08); border-radius:20px; padding:clamp(2rem,5vw,3rem); text-align:center; margin-top:20px; }
  .sh-empty h3{ margin:0 0 .4rem; font-family:var(--ag-font-display); font-weight:700; font-size:1.4rem; }
  .sh-empty p{ margin:0; color:#4a5256; }

  /* On a phone the hero was ~460px of the first 900, so the first product sat at 660px —
     below the fold on the page whose entire job is showing products. Trimmed rather than
     removed: it still says whose shop this is and where the money goes, which is the reason
     it exists, in about half the height. */
  @media(max-width:620px){
    .sh-hero{ margin-top:14px; padding:20px 18px 22px; border-radius:18px; }
    .sh-hero h1{ margin-top:11px; font-size:1.6rem; line-height:1.1; }
    /* Two lines, not three. The third line is "across the continent" — the sentence still
       says what the shop is and where the money goes without it, and forty pixels at the top
       of a phone screen are the most expensive forty on the page. */
    .sh-hero p{ margin-top:9px; font-size:14px; line-height:1.5;
      display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:2; overflow:hidden; }
    .sh-hero__orb{ width:200px; height:200px; right:-70px; bottom:-90px; }
    .sh-badge{ font-size:10px; padding:5px 11px; }
    .sh-find{ margin-top:14px; }
    .sh-ship{ margin-top:11px; padding:9px 13px; font-size:12.5px; }
  }

  /* "Not sure what to get?" — a link row, not a chat widget. A floating bubble is a thing
     people close; a line in the flow of the page is a thing they read. */
  .sh-ask{ display:flex; align-items:center; gap:13px; flex-wrap:wrap; margin-top:14px;
    background:var(--ag-surface,#fff); border:1px solid rgba(16,41,44,.08);
    border-radius:16px; padding:14px 17px; }
  .sh-ask__i{ flex:none; width:38px; height:38px; border-radius:11px; background:#eef4ff;
    color:#2b4f8a; display:flex; align-items:center; justify-content:center; }
  .sh-ask__b{ flex:1; min-width:190px; }
  .sh-ask__b b{ display:block; font-size:14.5px; color:var(--ag-ink); }
  .sh-ask__b span{ display:block; font-size:12.5px; color:#626a6e; margin-top:2px; }
  .sh-ask__l{ display:flex; gap:8px; flex-wrap:wrap; }
  .sh-ask__l a{ font-size:12.5px; font-weight:600; text-decoration:none; color:#10292C;
    border:1px solid rgba(16,41,44,.14); border-radius:999px; padding:8px 13px;
    background:var(--ag-surface,#fff); white-space:nowrap; }
  .sh-ask__l a:hover{ border-color:var(--ag-green); color:var(--ag-green); }
  /* ── ON A PHONE, THIS CARD WAS COSTING THE SHOP ITS FIRST SCREEN ──────────
     Measured at 390×844: hero, search, this card at three stacked full-width buttons, the
     delivery banner, the filter and the count came to about 1,200px before the first product.
     Somebody opening a shop scrolled a screen and a half of furniture to see anything for sale.

     The card is worth keeping — the assistant can check real stock and quote a delivered
     total, which is genuinely the thing a hesitant buyer wants. What it is not worth is a
     third of the opening screen. So on a phone the explanatory sentence goes (the heading
     already says it) and the three starting points become one horizontally scrollable strip
     instead of three stacked full-width buttons. About 110px instead of 350. */
  @media(max-width:620px){
    .sh-ask{ margin-top:11px; padding:11px 13px; gap:9px; align-items:center; }
    .sh-ask__i{ width:32px; height:32px; border-radius:9px; }
    .sh-ask__b{ min-width:0; }
    .sh-ask__b b{ font-size:13.5px; }
    .sh-ask__b span{ display:none; }
    /* Its own line, scrolling sideways. Nowrap so the three stay one row; the scrollbar is
       hidden because a 3px bar under three chips reads as damage rather than as a control. */
    .sh-ask__l{ order:3; width:100%; flex-wrap:nowrap; overflow-x:auto; scrollbar-width:none;
      padding-bottom:1px;
      /* The third chip is cut by the card's edge, and a chip sliced clean through reads as a
         rendering fault rather than as "there is more this way". The fade says it scrolls.
         Right-hand only: the strip starts at its left edge, so nothing is ever hidden there
         on arrival, and a symmetric mask would dim the first chip for no reason. */
      -webkit-mask-image:linear-gradient(to right,#000 86%,transparent);
      mask-image:linear-gradient(to right,#000 86%,transparent); }
    .sh-ask__l::-webkit-scrollbar{ display:none; }
    .sh-ask__l a{ flex:none; padding:8px 12px; }
  }

  /* ── THE RAIL, AND THE TWO-COLUMN PAGE ──────────────────────────────────────
     A shop whose only filter was a row of category chips could answer one question at a
     time. The rail answers several at once and keeps them all in the URL, so a filtered
     shop can be bookmarked, sent to somebody, and reopened by the back button.

     It is a PLAIN GET FORM. Not decoration: a rail that needs JavaScript is a rail that
     does not work on the phone where the script did not load, and one the server never
     validates. The `data-ag-do="submit-form"` handlers make it instant where script runs;
     the Apply button is what makes it work where it does not. */
  .sh-layout{ display:grid; grid-template-columns:236px minmax(0,1fr); gap:26px; margin-top:22px;
    align-items:start; }
  @media(max-width:900px){ .sh-layout{ grid-template-columns:minmax(0,1fr); gap:16px; } }

  /* On a phone the rail is a <details> — closed, so it costs one line rather than a screen,
     and still fully usable with no script because <details> is the browser's own. */
  .sh-rail{ background:var(--ag-surface,#fff); border:1px solid rgba(16,41,44,.08);
    border-radius:18px; padding:4px 16px 16px; position:sticky; top:84px; }
  @media(max-width:900px){
    .sh-rail{ position:static; padding:0 14px 14px; }
    /* Closed, the bottom padding pads nothing — it just makes a one-line control into a
       110px card sitting between the delivery banner and the first product. */
    .sh-rail:not([open]){ padding-bottom:0; }
  }
  .sh-rail__sum{ cursor:pointer; list-style:none; display:flex; align-items:center; gap:9px;
    padding:14px 0 12px; font-size:13px; font-weight:700; color:var(--ag-ink); }
  .sh-rail__sum::-webkit-details-marker{ display:none; }
  .sh-rail__sum b{ margin-left:auto; font-size:11px; font-weight:700; letter-spacing:.04em;
    background:#effaf0; color:#1a6118; border-radius:999px; padding:3px 9px; }
  .sh-rail__chev{ transition:transform .18s; }
  .sh-rail[open] .sh-rail__chev{ transform:rotate(180deg); }
  /* ── OPEN ON DESKTOP, CLOSED ON A PHONE, WITHOUT SCRIPT ────────────────────
     `open` is a single boolean attribute, so it cannot be responsive in the markup — and
     rendering it open meant 520px of rail before the first product on a 390px screen
     (measured, not guessed). So the element ships CLOSED and desktop forces it open in CSS.

     Both spellings, because engines implement the hiding differently: `::details-content` is
     the modern one, and overriding `display` on the non-summary children is what works in
     engines that predate it. If neither applies, a desktop visitor gets a collapsed rail with
     a "Filter" button that works — a smaller cost than a phone with no visible products. */
  @media(min-width:901px){
    .sh-rail__sum{ pointer-events:none; }
    .sh-rail__chev{ display:none; }
    .sh-rail::details-content{ content-visibility:visible; block-size:auto; }
    .sh-rail:not([open]) > form{ display:block; }
  }

  .sh-fs{ border:none; margin:0; padding:14px 0 0; border-top:1px solid rgba(16,41,44,.08); }
  .sh-fs__l{ font-size:11px; font-weight:700; letter-spacing:.08em; text-transform:uppercase;
    color:var(--ag-ink-soft,#626a6e); padding:0; margin-bottom:9px; }
  .sh-opt{ display:flex; align-items:center; gap:9px; font-size:13.5px; color:#3a4448;
    padding:5px 0; cursor:pointer; }
  .sh-opt input{ width:auto; flex:none; margin:0; accent-color:var(--ag-green); }
  .sh-opt span{ min-width:0; overflow-wrap:anywhere; }
  .sh-opt__n{ margin-left:auto; font-size:11.5px; color:var(--ag-ink-soft,#626a6e); font-variant-numeric:tabular-nums; }

  .sh-money{ display:flex; align-items:center; gap:7px; }
  .sh-money input{ min-width:0; width:100%; border:1px solid rgba(16,41,44,.16);
    border-radius:10px; padding:8px 10px; font-family:var(--ag-font-mono,monospace);
    font-size:12.5px; color:var(--ag-ink); background:var(--ag-surface,#fff);
    box-sizing:border-box; }
  .sh-money span{ color:var(--ag-ink-soft,#626a6e); font-size:12px; flex:none; }
  .sh-hint{ font-size:11.5px; color:var(--ag-ink-soft,#626a6e); margin:7px 0 0; }

  .sh-apply{ display:flex; gap:8px; margin-top:16px; }
  .sh-apply button{ flex:1; cursor:pointer; border:none; background:var(--ag-ink); color:#fff;
    font-family:inherit; font-size:13px; font-weight:700; padding:11px; border-radius:999px; }
  .sh-apply a{ flex:none; display:inline-flex; align-items:center; padding:0 13px;
    border-radius:999px; border:1px solid rgba(16,41,44,.14); font-size:12.5px;
    font-weight:600; color:#4a5256; text-decoration:none; }
  .sh-apply a:hover{ border-color:rgba(16,41,44,.3); color:var(--ag-ink); }

  /* The bar above the grid: what is on the page, and how it is ordered. Sticky, because
     scrolling three pages of products and then wanting a different order should not mean
     scrolling back up. */
  .sh-top{ position:sticky; top:74px; z-index:2; display:flex; align-items:center;
    justify-content:space-between; gap:14px; flex-wrap:wrap;
    background:rgba(238,240,236,.92); backdrop-filter:blur(8px);
    padding:10px 0; margin-bottom:4px; }
  @media(max-width:900px){
    .sh-top{ position:static; backdrop-filter:none; background:none; padding:6px 0 2px; }
    /* One row rather than two: the count and the sort are both one short line, and stacking
       them costs another 40px above the grid on the screen with least of it to spare.

       The first attempt let the count wrap and capped the select at 46vw, which produced
       "14 items · page 1 of" over two lines beside a select reading "What we are showin" with
       the rest cut off — both halves of the row damaged to fit. The count is the half that can
       give way: the page number is repeated by the pager under the grid, and the search term is
       already shown as a removable pill, so on a phone the count says only how many. */
    .sh-top{ flex-wrap:nowrap; }
    .sh-count{ flex:none; min-width:0; }
    .sh-count__more{ display:none; }
    .sh-sort{ flex:1; min-width:0; justify-content:flex-end; }
    .sh-sort select{ min-width:0; max-width:100%; }
  }

  /* Which filters are on, as removable pills. A rail can be scrolled past; these cannot,
     so nobody wonders why the shop looks half empty. */
  .sh-on{ display:flex; flex-wrap:wrap; gap:7px; margin:0 0 12px; }
  .sh-on__p{ display:inline-flex; align-items:center; gap:6px; font-size:12px; font-weight:600;
    background:#fff; border:1px solid rgba(16,41,44,.14); border-radius:999px;
    padding:5px 7px 5px 11px; color:#3a4448; text-decoration:none; }
  .sh-on__p:hover{ border-color:#8a2020; color:#8a2020; }
  .sh-on__x{ font-size:14px; line-height:1; color:var(--ag-ink-soft,#626a6e); }
  .sh-on__p:hover .sh-on__x{ color:#8a2020; }

  /* ── colour dots on a card ──────────────────────────────────────────────────
     The grid reads the cover image only, so a shirt in four colours looked like one shirt
     and the buyer had to open it to find out. Small, because on a card this is a signal
     rather than a control — the choosing happens on the product page. */
  .sh-dots{ display:flex; align-items:center; gap:5px; margin-top:8px; }
  .sh-dots__d{ width:13px; height:13px; border-radius:50%; flex:none;
    box-shadow:inset 0 0 0 1px rgba(16,41,44,.2); }
  .sh-dots__d.is-gone{ opacity:.4; }
  .sh-dots__m{ font-size:11px; font-weight:700; color:var(--ag-ink-soft,#626a6e); margin-left:2px; }
  .sh-card__from{ font-size:11px; font-weight:600; color:var(--ag-ink-soft,#626a6e); margin-right:4px; }

  /* The alternate colourway, on hover. Free — it is a variant photograph already loaded for
     the stock note, so no extra query. Not on touch, where there is no hover and the image
     would either never show or stick after a tap. */
  .sh-card__alt{ position:absolute; inset:0; width:100%; height:100%; object-fit:cover;
    opacity:0; transition:opacity .22s; }
  @media (hover:hover){ .sh-card:hover .sh-card__alt{ opacity:1; } }

  /* Ad units — clean, labeled, and height-reserved so they never shift the layout. */
  .ad-slot{ margin:28px 0 0; padding:14px; background:var(--ag-surface,#fff); border:1px solid rgba(16,41,44,.08); border-radius:18px; text-align:center; min-height:128px; overflow:hidden; }
  .ad-slot__label{ display:block; font-size:10px; font-weight:600; letter-spacing:.12em; text-transform:uppercase; color:var(--ag-ink-soft,#626a6e); margin-bottom:8px; }
  .ad-slot .adsbygoogle{ display:block; min-height:90px; }
</style>
{% endblock %}

{% block content %}
{% set COV = ['linear-gradient(135deg,#10292C,#1a6118)','linear-gradient(135deg,#a47306,#d49a0e)','linear-gradient(135deg,#1a2629,#5d7374)','linear-gradient(135deg,#237b22,#7FC87C)','linear-gradient(135deg,#2b373d,#4a5b60)','linear-gradient(135deg,#b97a12,#fbc329)'] %}

<div class="shop" x-data="{ filter:'All' }">
  {# Two tones, because not every one of these is a failure. `mismatch` means the gateway
     says money MOVED — wording that red and calling it an error is what turns a debited
     customer into a chargeback (see ShopCheckoutController::callback). #}
  <div class="sh-notice" id="shopNotice" role="alert" style="display:none;margin-top:16px;padding:12px 16px;border-radius:12px;font-size:13.5px;font-weight:500;line-height:1.5"></div>
  <script nonce="{{ csp_nonce }}">(function(){
    /* Every code ShopCheckoutController can emit. Kept in step with it deliberately: a code
       with no entry here used to render an EMPTY box, so `mismatch` — a customer who has been
       debited — was returned to this page and told nothing at all. */
    var m={
      region:      ['err','Please choose a valid delivery region at checkout.'],
      noship:      ['err','Sorry \u2014 an item in your cart can\u2019t be delivered to your selected region. Remove it or choose another region.'],
      unavailable: ['err','That payment method is unavailable right now.'],
      email:       ['err','Please enter a valid email address.'],
      details:     ['err','Please add your name and delivery address.'],
      empty:       ['err','Your cart is empty.'],
      busy:        ['err','Too many attempts \u2014 please wait a moment.'],
      start:       ['err','We couldn\u2019t start checkout. Please try again.'],
      error:       ['err','Something went wrong. Please try again.'],
      failed:      ['err','Payment was not completed.'],
      gone:        ['warn','Sorry \u2014 something in your cart sold out while you were checking out. Your basket has been updated, so please check it before paying.'],
      mismatch:    ['warn','Your payment went through, but the amount doesn\u2019t match this order, so we haven\u2019t confirmed it yet. Our team is already checking it \u2014 please don\u2019t pay again. Quote reference %REF% if you get in touch.']
    };
    var q=new URLSearchParams(location.search), p=q.get('checkout'), row=p&&m[p];
    if(!row) return;
    var ref=(q.get('ref')||'').replace(/[^A-Za-z0-9\-]/g,'').slice(0,40);
    var txt=row[1].replace('%REF%', ref||'your order');
    var el=document.getElementById('shopNotice');
    if(row[0]==='warn'){ el.style.background='#fff8df'; el.style.border='1px solid #ecdca0'; el.style.color='#7a5a08'; }
    else               { el.style.background='#fdeaea'; el.style.border='1px solid rgba(180,35,24,.2)'; el.style.color='#8a1c12'; }
    el.textContent=txt;
    el.style.display='block';
  })();</script>
  <div class="sh-hero">
    <div class="sh-hero__orb" aria-hidden="true"></div>
    <div class="sh-hero__in">
      <span class="sh-badge">🛍️ The GATES Shop</span>
      <h1>Wear the recognition</h1>
      <p>Heritage-grade apparel and keepsakes. Every purchase funds child leadership programmes across the continent.</p>
    </div>
  </div>

  {% set F = found|default({q:'', category:'', sort:'featured', total: products|length, page:1, pages:1}) %}

  {# ── SEARCH ──────────────────────────────────────────────────────────────────
     A real GET form. Filtering happens in SQL, so the URL describes what is on the page —
     which means a search is shareable, the browser's back button works, and the page stops
     carrying the whole catalogue in order to hide most of it.

     The hidden inputs carry the rail's current answers, so searching NARROWS what is on
     screen instead of silently discarding the filters somebody just set. #}
  <form class="sh-find" method="get" action="/shop">
    <label class="sh-search">
      <span class="sh-search__i" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg></span>
      <span class="sr-only">Search the shop</span>
      <input type="search" name="q" value="{{ F.q }}" placeholder="Search the shop…" autocomplete="off">
      <button class="sh-search__go" type="submit">Search</button>
    </label>
    {% if F.category %}<input type="hidden" name="c" value="{{ F.category }}">{% endif %}
    {% if F.min is not null %}<input type="hidden" name="min" value="{{ F.min }}">{% endif %}
    {% if F.max is not null %}<input type="hidden" name="max" value="{{ F.max }}">{% endif %}
    {% if F.in_stock %}<input type="hidden" name="stock" value="1">{% endif %}
    {% if F.featured %}<input type="hidden" name="feat" value="1">{% endif %}
    {% if F.sort != 'featured' %}<input type="hidden" name="sort" value="{{ F.sort }}">{% endif %}
  </form>

  {# ── HELP ME CHOOSE ──────────────────────────────────────────────────────────
     Where somebody who does not know what they want actually is: on the shop, not on the
     help page. The assistant can look up real stock, quote a delivered total and compare two
     products, so this is a shortcut to a useful conversation rather than a chat bubble.

     A plain link with the opening question in the URL — no script, and it survives being
     opened in a new tab. Three starting points rather than one box, because "how can I help"
     is a harder question to answer than it looks and a blank prompt is where people give up. #}
  <div class="sh-ask">
    <span class="sh-ask__i" aria-hidden="true">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H8l-5 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2Z"/><path d="M9.5 9.5a2.5 2.5 0 1 1 3.5 2.3V13"/><path d="M12 16h.01"/></svg>
    </span>
    <div class="sh-ask__b">
      <b>Not sure what to get?</b>
      <span>Ask for a recommendation, check whether your size is in, or get a delivered total.</span>
    </div>
    <div class="sh-ask__l">
      <a href="/support/assistant?q={{ 'Help me choose a gift — what would you suggest?'|url_encode }}">Help me choose</a>
      <a href="/support/assistant?q={{ 'Is my size in stock?'|url_encode }}">Is my size in?</a>
      <a href="/support/assistant?q={{ 'What will delivery cost me?'|url_encode }}">Delivery cost</a>
    </div>
  </div>

  {% if ship_active|default(false) and ship_free_over|default(0) %}
  <div class="sh-ship">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1a6118" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 3h13v13H1zM14 8h4l3 3v5h-7z"/><circle cx="5.5" cy="18.5" r="1.5"/><circle cx="17.5" cy="18.5" r="1.5"/></svg>
    <span><b>Free delivery</b> on orders over ₦{{ ship_free_over|number_format }}.</span>
  </div>
  {% endif %}

  {# How many filters are narrowing the list — the count on the rail's own summary, so a
     phone with the rail collapsed still knows something is being hidden. #}
  {% set onCount = (F.category ? 1 : 0) + (F.in_stock ? 1 : 0) + (F.featured ? 1 : 0)
                 + ((F.min is not null or F.max is not null) ? 1 : 0) %}

  <div class="sh-layout">

    {# ── THE RAIL ─────────────────────────────────────────────────────────────
       One GET form for every filter, so Apply answers all of them at once and the URL that
       results describes the page exactly. `<details open>` on desktop via CSS and closed on
       a phone: on a small screen a rail that occupies the first screenful means the shop
       appears to have no products in it.

       No JavaScript is required for any of it. The selects and checkboxes carry
       `data-ag-do="submit-form"` so it is instant where script runs, and the Apply button is
       what makes it work where it does not. #}
    {# Not `open` in the markup — see the CSS note. Desktop opens it there; a phone keeps it
       one line, with the count of active filters on the summary so nothing is hidden
       silently. #}
    <details class="sh-rail" id="shopRail">
      <summary class="sh-rail__sum">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4"/></svg>
        Filter
        {% if onCount %}<b>{{ onCount }} on</b>{% endif %}
        <svg class="sh-rail__chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
      </summary>

      <form method="get" action="/shop">
        {# Search and sort travel with the filters rather than being reset by them. #}
        {% if F.q %}<input type="hidden" name="q" value="{{ F.q }}">{% endif %}
        {% if F.sort != 'featured' %}<input type="hidden" name="sort" value="{{ F.sort }}">{% endif %}

        <fieldset class="sh-fs">
          <legend class="sh-fs__l">Category</legend>
          {# Radios rather than links: a link would carry only its own value and drop whatever
             else is set. Every category, not only the ones on this page — paging to page 2
             would otherwise make categories disappear. #}
          <label class="sh-opt">
            <input type="radio" name="c" value="" {% if F.category == '' %}checked{% endif %}
                   data-ag-do="submit-form">
            <span>Everything</span>
          </label>
          {% for c in categories %}
          <label class="sh-opt">
            <input type="radio" name="c" value="{{ c }}" {% if F.category == c %}checked{% endif %}
                   data-ag-do="submit-form">
            <span>{{ c }}</span>
          </label>
          {% endfor %}
        </fieldset>

        {% if price_range|default(null) and price_range.max > price_range.min %}
        <fieldset class="sh-fs">
          <legend class="sh-fs__l">Price</legend>
          {# Two boxes rather than a slider. A slider needs script, cannot be typed into, and
             is very hard to operate accurately on a phone — and the two numbers are exactly
             what somebody has in mind. The placeholders are the real bounds of the catalogue,
             so the range widens by itself when a dearer product is added. #}
          <div class="sh-money">
            <span>₦</span>
            <input type="number" name="min" inputmode="numeric" min="0" step="500"
                   value="{{ F.min is not null ? F.min : '' }}"
                   placeholder="{{ price_range.min }}" aria-label="Lowest price">
            <span>–</span>
            <input type="number" name="max" inputmode="numeric" min="0" step="500"
                   value="{{ F.max is not null ? F.max : '' }}"
                   placeholder="{{ price_range.max }}" aria-label="Highest price">
          </div>
          <p class="sh-hint">Leave either blank for no limit.</p>
        </fieldset>
        {% endif %}

        <fieldset class="sh-fs">
          <legend class="sh-fs__l">Show only</legend>
          <label class="sh-opt">
            <input type="checkbox" name="stock" value="1" {% if F.in_stock %}checked{% endif %}
                   data-ag-do="submit-form">
            <span>In stock</span>
          </label>
          <label class="sh-opt">
            <input type="checkbox" name="feat" value="1" {% if F.featured %}checked{% endif %}
                   data-ag-do="submit-form">
            <span>Featured</span>
          </label>
        </fieldset>

        {% if region_priced or currency_enabled %}
        <fieldset class="sh-fs">
          <legend class="sh-fs__l">Prices shown</legend>
          {# Cookies, not query parameters: a region and a currency are how somebody wants to
             be shown the whole site, not a filter on this page — and putting them in the URL
             would mean every shared link carried somebody else's currency. #}
          {% if region_priced %}
          <label class="sh-opt" title="Prices vary by delivery region">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            <select aria-label="Pricing region" data-ag-do="set-cookie-reload" data-cookie="ag_region">
              {% for r in regions %}<option value="{{ r }}" {% if r == region %}selected{% endif %}>{{ r }}</option>{% endfor %}
            </select>
          </label>
          {% endif %}
          {% if currency_enabled %}
          <label class="sh-opt" title="Show prices in your currency">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9.5 9a2.5 2.5 0 0 1 4.6.5M14.5 14.5A2.5 2.5 0 0 1 10 14M12 7v10"/></svg>
            <select aria-label="Display currency" data-ag-do="set-cookie-reload" data-cookie="ag_currency">
              {% for code, sym in currencies %}<option value="{{ code }}" {% if code == currency %}selected{% endif %}>{{ code }}</option>{% endfor %}
            </select>
          </label>
          {% endif %}
        </fieldset>
        {% endif %}

        <div class="sh-apply">
          <button type="submit">Apply</button>
          {% if F.filtered %}<a href="/shop">Clear</a>{% endif %}
        </div>
      </form>
    </details>

    <div>
  {% if products is not empty %}
    <div class="sh-top">
      {# The bracketed part is hidden on a phone — see .sh-count__more. Both facts are said
         again elsewhere on the page (the pager, and the search pill), so nothing is lost. #}
      <span class="sh-count">{{ F.total }} item{{ F.total == 1 ? '' : 's' }}<span class="sh-count__more">{% if F.q %} for “{{ F.q }}”{% endif %}{% if F.pages > 1 %} · page {{ F.page }} of {{ F.pages }}{% endif %}</span></span>
      {# Sort is its own tiny form, carrying every filter as hidden inputs. Re-ordering must
         not silently drop what somebody chose on the left. #}
      <form method="get" action="/shop" class="sh-sort">
        {% if F.q %}<input type="hidden" name="q" value="{{ F.q }}">{% endif %}
        {% if F.category %}<input type="hidden" name="c" value="{{ F.category }}">{% endif %}
        {% if F.min is not null %}<input type="hidden" name="min" value="{{ F.min }}">{% endif %}
        {% if F.max is not null %}<input type="hidden" name="max" value="{{ F.max }}">{% endif %}
        {% if F.in_stock %}<input type="hidden" name="stock" value="1">{% endif %}
        {% if F.featured %}<input type="hidden" name="feat" value="1">{% endif %}
        <label for="shSort">Sort</label>
        <select id="shSort" name="sort" data-ag-do="submit-form">
          {% for key, label in sorts|default({}) %}
          <option value="{{ key }}" {% if key == F.sort %}selected{% endif %}>{{ label }}</option>
          {% endfor %}
        </select>
        <noscript><button type="submit" class="sh-chip">Go</button></noscript>
      </form>
    </div>

    {# What is currently on, as pills that remove themselves. The rail can be scrolled past
       or collapsed, and a shop that looks half empty for a reason nobody can see is a shop
       somebody leaves. Each pill's href is the current URL MINUS that one filter. #}
    {% if F.filtered %}
    {% set keep = {
      q: F.q, c: F.category, sort: (F.sort != 'featured' ? F.sort : ''),
      min: (F.min is not null ? F.min : ''), max: (F.max is not null ? F.max : ''),
      stock: (F.in_stock ? '1' : ''), feat: (F.featured ? '1' : '')
    } %}
    <div class="sh-on">
      {% for k, label in {
        q: (F.q ? '“' ~ F.q ~ '”' : ''),
        c: F.category,
        min: (F.min is not null ? 'From ₦' ~ F.min|number_format : ''),
        max: (F.max is not null ? 'Up to ₦' ~ F.max|number_format : ''),
        stock: (F.in_stock ? 'In stock' : ''),
        feat: (F.featured ? 'Featured' : '')
      } %}
        {% if label %}
          {% set without = [] %}
          {% for kk, vv in keep %}
            {% if kk != k and vv != '' %}{% set without = without|merge([kk ~ '=' ~ vv|url_encode]) %}{% endif %}
          {% endfor %}
          <a class="sh-on__p" href="/shop{{ without ? '?' ~ without|join('&') : '' }}">
            {{ label }}<span class="sh-on__x" aria-hidden="true">×</span>
            <span class="sr-only">— remove this filter</span>
          </a>
        {% endif %}
      {% endfor %}
      <a class="sh-on__p" href="/shop"><b>Clear all</b></a>
    </div>
    {% endif %}

  <div class="sh-grid">
    {% for p in products %}
    <article class="sh-card {{ p.sold_out|default(false) ? 'sh-card--gone' : '' }}">
      {# aria-hidden + tabindex=-1: this cover is a SECOND link to the same product as
         sh-card__name below, and it has no text, so a screen reader announced a
         nameless "link" and keyboard users hit an extra dead stop on every card.
         Hiding the decorative duplicate leaves exactly one named link per product. #}
      <a class="sh-card__cover" aria-hidden="true" tabindex="-1" href="/shop/{{ p.slug }}" style="{% if p.cover_path %}background-image:url('{{ p.cover_path }}'){% else %}background:{{ COV[loop.index0 % COV|length] }}{% endif %}">
        {# The alternate colourway, revealed on hover. Free: it is a variant photograph
           already loaded for the stock note, so there is no extra query — and it answers
           "what else does this come in" without a click. Only where hover exists; on a
           touch screen it would either never appear or stick after a tap. #}
        {% set alt = (p.variants|default([])|filter(v => v.image)|first) %}
        {% if alt %}<img class="sh-card__alt" src="{{ alt.image }}" alt="" loading="lazy"
                         decoding="async" aria-hidden="true">{% endif %}
        {% if p.tag %}<span class="sh-card__tag sh-tag--{{ p.tag }}">{{ p.tag }}</span>{% endif %}
      </a>
      <div class="sh-card__body">
        <div class="sh-card__cat">{{ p.category }}</div>
        <a class="sh-card__name" href="/shop/{{ p.slug }}">{{ p.name }}</a>
        {% if p.subtitle|default('') %}<div class="sh-card__sub">{{ p.subtitle }}</div>{% endif %}
        {% if p.stock_note|default('') %}
        <div class="sh-card__stock {{ p.sold_out|default(false) ? 'is-gone' : (p.choose|default(false) ? 'is-opt' : 'is-low') }}">{{ p.stock_note }}</div>
        {% endif %}
        {# The colours it comes in. Before this, the grid showed one cover image, so a shirt
           in four colours looked like one shirt and the only way to find out was to open it.
           The names are on the dots' own titles and in a hidden list, because a row of
           coloured circles announces nothing to a screen reader. #}
        {% if p.dots|default(null) and p.dots.dots|length %}
        <div class="sh-dots">
          {% for d in p.dots.dots %}
            <span class="sh-dots__d{{ d.gone ? ' is-gone' : '' }}" style="background:{{ d.css }}"
                  title="{{ d.name }}{{ d.gone ? ' — sold out' : '' }}"></span>
          {% endfor %}
          {% if p.dots.more %}<span class="sh-dots__m">+{{ p.dots.more }}</span>{% endif %}
          <span class="sr-only">Colours:
            {% for d in p.dots.dots %}{{ d.name }}{{ d.gone ? ' (sold out)' : '' }}{{ not loop.last ? ', ' : '' }}{% endfor %}
            {%- if p.dots.more %} and {{ p.dots.more }} more{% endif %}.</span>
        </div>
        {% endif %}
        <div class="sh-card__row">
          <span class="sh-card__price">
            {# "from" when the options are priced differently. A single number on a card whose
               XXL costs ₦1,500 more is a number the product page then contradicts. #}
            {% if p.price_from|default(false) %}<span class="sh-card__from">from</span>{% endif %}
            {{ p.price_label|default('₦' ~ (p.display_price|default(p.price_naira)|number_format)) }}</span>
          {% if p.sold_out|default(false) %}
            <button type="button" class="sh-add" disabled>Sold out</button>
          {% elseif p.choose|default(false) %}
            {# A product with sizes cannot be added from a grid: the buyer has not chosen one
               yet, and picking for them is how somebody receives the wrong size. #}
            <a class="sh-add" href="/shop/{{ p.slug }}">Choose {{ (p.variants.0.axis|default('option'))|lower }}</a>
          {% else %}
            <button type="button" class="sh-add" @click='$store.cart.add({slug:{{ p.slug|json_encode(15)|raw }}, name:{{ p.name|json_encode(15)|raw }}, price:{{ p.display_price|default(p.price_naira) }}, cover:{{ p.cover_path|default("")|json_encode(15)|raw }}})'>
              <svg aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>Add
            </button>
          {% endif %}
        </div>
      </div>
    </article>
    {% endfor %}
  </div>

  {% if F.pages > 1 %}
  {% set qs = (F.q ? 'q=' ~ F.q|url_encode ~ '&' : '') ~ (F.category ? 'c=' ~ F.category|url_encode ~ '&' : '') ~ 'sort=' ~ F.sort %}
  <nav class="sh-pager" aria-label="Shop pages">
    <a class="{{ F.page <= 1 ? 'is-off' : '' }}" href="/shop?{{ qs }}&page={{ F.page - 1 }}" rel="prev">← Previous</a>
    {% for n in 1..F.pages %}
      {# Only the pages near where they are, plus the ends. Ninety products is eight pages;
         nine hundred is seventy-five, and a row of seventy-five numbers is not navigation. #}
      {% if n == 1 or n == F.pages or (n >= F.page - 2 and n <= F.page + 2) %}
        <a class="{{ n == F.page ? 'is-here' : '' }}" href="/shop?{{ qs }}&page={{ n }}"
           {% if n == F.page %}aria-current="page"{% endif %}>{{ n }}</a>
      {% elseif n == F.page - 3 or n == F.page + 3 %}
        <span aria-hidden="true">…</span>
      {% endif %}
    {% endfor %}
    <a class="{{ F.page >= F.pages ? 'is-off' : '' }}" href="/shop?{{ qs }}&page={{ F.page + 1 }}" rel="next">Next →</a>
  </nav>
  {% endif %}

  {# Ad — in the natural break below the product grid. #}
  {% include 'partials/ad-slot.twig' %}

  <div class="sh-mission">
    <span class="sh-mission__i"><svg aria-hidden="true" focusable="false" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8Z"/></svg></span>
    <div class="sh-mission__b"><b>Every order gives back</b><div>Proceeds fund child leadership programmes — receipted and transparent.</div></div>
  </div>

  {# Optional second ad (bottom). Renders only if a distinct slot is configured. #}
  {% if adsense_slot_2 %}{% include 'partials/ad-slot.twig' with { slot: adsense_slot_2 } %}{% endif %}

  {% elseif F.filtered %}
  {# Nothing MATCHED is a different thing from nothing existing, and answering a search with
     "the shop is opening soon" tells somebody the site is broken.

     And it says WHICH filters produced nothing, with a way to loosen each one — because "no
     results" with no explanation leaves somebody guessing which of four things to change.
     `F.filtered` rather than a test on q and category alone: a price range or an in-stock tick
     can empty the grid just as easily, and the old wording called that an empty shop. #}
  <div class="sh-empty">
    <h2>Nothing matched</h2>
    <p>
      {% if F.q %}No products match “{{ F.q }}”{% if F.category %} in {{ F.category }}{% endif %}.
      {% elseif F.category %}There is nothing in {{ F.category }} that also matches the rest of your filters.
      {% else %}Nothing in the shop matches all of those filters.{% endif %}
    </p>
    <p style="margin-top:10px;font-size:13.5px;color:#626a6e">
      {% if F.min is not null or F.max is not null %}Try widening the price range{% if F.in_stock or F.featured %}, or{% endif %}{% endif %}
      {%- if F.in_stock %} include out-of-stock items{% if F.featured %}, or{% endif %}{% endif %}
      {%- if F.featured %} include products that are not featured{% endif %}
      {%- if F.min is null and F.max is null and not F.in_stock and not F.featured %}Try a different word, or a wider category{% endif %}.
    </p>
    <p style="margin-top:14px"><a href="/shop" style="color:var(--ag-green);font-weight:600">Clear every filter and see the whole shop →</a></p>
  </div>
  {% else %}
  <div class="sh-empty">
    <h2>The shop is opening soon</h2>
    <p>We’re lining up the first drop of Africa GATES apparel and keepsakes. Check back shortly.</p>
  </div>
  {% endif %}
    </div>{# /grid column #}
  </div>{# /sh-layout #}

  {% include 'partials/shop-cart.twig' %}
</div>
{% endblock %}

{% block foot_scripts %}
{% if adsense_client %}
{# AdSense loader — once per page. #}
<script async crossorigin="anonymous" src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client={{ adsense_client }}"></script>
{# Enterprise ad controller: lazy-load each unit as it nears the viewport, and
   collapse any slot the network leaves unfilled so no blank "Advertisement"
   box is ever shown. Reserved height (CSS) prevents layout shift before load. #}
<script nonce="{{ csp_nonce }}">
(function(){
  function init(){
    var slots = document.querySelectorAll('aside.ad-slot[data-ad-lazy]');
    if(!slots.length) return;
    function load(slot){
      if(slot.dataset.adLoaded) return; slot.dataset.adLoaded='1';
      var ins = slot.querySelector('ins.adsbygoogle');
      try{ (window.adsbygoogle = window.adsbygoogle || []).push({}); }catch(e){}
      if(!ins) return;
      var n=0, t=setInterval(function(){
        n++;
        var st = ins.getAttribute('data-ad-status');
        if(st==='unfilled' || (n>6 && (ins.offsetHeight||0) < 10)){ slot.style.display='none'; clearInterval(t); }
        else if(st==='filled' || n>12){ clearInterval(t); }
      }, 500);
    }
    if(!('IntersectionObserver' in window)){ slots.forEach(load); return; }
    var io = new IntersectionObserver(function(es){
      es.forEach(function(e){ if(e.isIntersecting){ load(e.target); io.unobserve(e.target); } });
    }, { rootMargin:'600px 0px' });
    slots.forEach(function(s){ io.observe(s); });
  }
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded', init); else init();
})();
</script>
{% endif %}
{% endblock %}
