{% extends "layout/gates.twig" %}
{% block content %}

<section class="r26-hero" style="padding-block:clamp(2.5rem,6vw,4.25rem) clamp(1.5rem,3vw,2.5rem);text-align:center">
  <div class="aurora aurora--soft" aria-hidden="true"></div>
  <img class="r26-hero__wm" src="/assets/img/africa-watermark.svg?v={{ asset_version }}" alt="" aria-hidden="true">
  <div class="wrap">
    <div class="r26-hero__inner">
      <p class="r26-eyebrow r26-reveal r26-d1" style="justify-content:center;display:inline-flex">Events · 2026 Cycle</p>
      <h1 class="r26-hl r26-reveal r26-d2" style="font-size:clamp(2.2rem,5.2vw,3.9rem)">Where recognition <em style="color:var(--emerald-600)">happens.</em></h1>
      <p class="r26-sub r26-reveal r26-d3" style="margin-left:auto;margin-right:auto">Ceremonies, webinars and community sessions across the cycle — online and on the ground.</p>
    </div>
  </div>
</section>

<section class="section" style="padding-top:1rem">
  <div class="wrap">
    <div class="r26-head">
      <p class="r26-eyebrow">Upcoming</p>
      <h2 class="r26-h2">Next on the <em>calendar</em></h2>
    </div>
    {% if upcoming is not empty %}
    <div class="r26-mediagrid">
      {% for e in upcoming %}
      <article class="r26-mcard">
        <div class="r26-mcard__media {% if not e.cover_image %}r26-mcard__media--empty{% endif %}">
          {% if e.cover_image %}<img src="{{ e.cover_image }}" alt="{{ e.title }}" loading="lazy" decoding="async">{% endif %}
          <span class="r26-mcard__badge">{{ e.location|default('Africa GATES') }}</span>
        </div>
        <div class="r26-mcard__body">
          <div class="r26-when">
            <span class="r26-when__cal" aria-hidden="true">
              <span class="r26-when__mon">{{ e.event_date|date('M') }}</span>
              <span class="r26-when__day">{{ e.event_date|date('j') }}</span>
            </span>
            <span class="r26-mcard__meta" style="margin:0">{{ e.event_date|date('l, j F Y · H:i') }}</span>
          </div>
          <h3 class="r26-mcard__title">{{ e.title }}</h3>
          <p class="r26-mcard__desc">{{ e.tagline|default(e.description|slice(0,140)) }}</p>
          <div class="r26-mcard__foot">
            <span>{{ e.venue|default(e.location) }}</span>
            {% if e.rsvp_url %}<a class="r26-mcard__link" href="{{ e.rsvp_url }}">Reserve
              <svg viewBox="0 0 20 20" fill="none"><path d="M7.5 4.5 13 10 7.5 15.5" stroke="currentColor" stroke-width="1.75" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></a>{% endif %}
          </div>
        </div>
      </article>
      {% endfor %}
    </div>
    {% else %}
    <div class="r26-empty">
      <img class="r26-empty__icon" src="/assets/img/africa-mark.svg?v={{ asset_version }}" alt="" aria-hidden="true">
      <h3>No upcoming events just yet</h3>
      <p>The next ceremony, webinar or community session will be announced here — and in the community channels first.</p>
      <a class="btn btn--emerald" href="/community">Join the community</a>
    </div>
    {% endif %}
  </div>
</section>

{% if past is not empty %}
<section class="section" style="padding-top:0">
  <div class="wrap">
    <div class="r26-surface">
      <div class="r26-head">
        <p class="r26-eyebrow">Archive</p>
        <h2 class="r26-h2">Past <em>events</em></h2>
      </div>
      <div class="r26-mediagrid">
        {% for e in past %}
        <article class="r26-mcard">
          <div class="r26-mcard__media {% if not e.cover_image %}r26-mcard__media--empty{% endif %}">
            {% if e.cover_image %}<img src="{{ e.cover_image }}" alt="{{ e.title }}" loading="lazy" decoding="async">{% endif %}
          </div>
          <div class="r26-mcard__body">
            <p class="r26-mcard__meta">{{ e.event_date|date('j F Y') }} · {{ e.location }}</p>
            <h3 class="r26-mcard__title">{{ e.title }}</h3>
            <p class="r26-mcard__desc">{{ e.tagline }}</p>
          </div>
        </article>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
{% endif %}

{% endblock %}
