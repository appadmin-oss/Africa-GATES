{% extends "layout/gates.twig" %}

{# This page renders flash_* itself, beside the thing the message is about, so the
   layout rail is suppressed — otherwise every message would appear twice. #}
{% set own_flash = true %}

{% block head_styles %}
<style nonce="{{ csp_nonce }}">
  body[data-page="pulse"]{ background:#fbfbfa; color:var(--ag-ink); }
  body[data-page="pulse"] [x-cloak]{ display:none !important; }
  .pl{ max-width:1180px; margin:0 auto; padding:clamp(1.6rem,4vw,2.5rem) var(--ag-gutter,40px) 90px; }
  .pl-x::-webkit-scrollbar{ height:0; } .pl-x{ scrollbar-width:none; }

  /* header */
  .pl-eyebrow{ margin:0 0 8px; font:700 12px/1 var(--ag-font-mono); letter-spacing:.14em; text-transform:uppercase; color:#e0245e; }
  .pl-h1{ margin:0; font-family:var(--ag-font-display); font-weight:700; font-size:clamp(2rem,4.6vw,2.75rem); line-height:1.02; letter-spacing:-.02em; color:var(--ag-ink); }
  .pl-h1 em{ color:var(--ag-green); font-style:italic; }

  /* tabs */
  .pl-tabs{ display:flex; gap:4px; border-bottom:1px solid rgba(16,41,44,.08); margin:20px 0 26px; overflow-x:auto; }
  .pl-tab{ flex:none; cursor:pointer; border:0; background:none; font-family:inherit; font-size:14.5px; font-weight:600; color:#5a6d6f; padding:12px 16px; border-bottom:2px solid transparent; margin-bottom:-1px; }
  .pl-tab.is-on{ color:var(--ag-green); border-bottom-color:var(--ag-green); }
  .pl-tab__dot{ display:inline-flex; align-items:center; justify-content:center; min-width:17px; height:17px;
                margin-left:6px; padding:0 5px; border-radius:999px; background:#e0245e; color:#fff;
                font:700 10.5px/1 var(--ag-font-mono,monospace); vertical-align:1px; }

  /* ── alerts ────────────────────────────────────────────────────────────
     One row per GROUP, never per event. Forty-three "X cheered your post"
     rows is not a notifications screen, it is a punishment. */
  .pl-alerts{ background:#fff; border:1px solid rgba(16,41,44,.08); border-radius:20px; overflow:hidden; }
  .pl-alerts__hd{ display:flex; align-items:center; gap:12px; padding:16px 18px;
                  border-bottom:1px solid rgba(16,41,44,.07); }
  .pl .pl-alerts__h{ margin:0; font-family:var(--ag-font-display); font-weight:700; font-size:19px;
                     color:var(--ag-ink,#10292c); }
  .pl-alerts__read{ margin-left:auto; border:0; background:none; cursor:pointer;
                    font:600 13px/1 inherit; color:var(--ag-green,#237b22); text-decoration:underline; padding:5px; }
  .pl-alert{ display:flex; align-items:flex-start; gap:12px; padding:14px 18px; text-decoration:none;
             color:inherit; border-bottom:1px solid rgba(16,41,44,.05); }
  .pl-alert:last-child{ border-bottom:0; }
  .pl-alert:hover{ background:#fafbfa; }
  .pl-alert.is-new{ background:#f4faf4; }
  .pl-alert.is-new:hover{ background:#eef6ee; }
  .pl-alert__i{ flex:none; width:34px; height:34px; border-radius:50%; background:#f2f5f2;
                display:flex; align-items:center; justify-content:center; line-height:0; }
  .pl-alert__i svg{ width:17px; height:17px; }
  .pl-alert__b{ flex:1; min-width:0; }
  .pl-alert__t{ display:block; font-size:14.5px; line-height:1.5; color:#2c3a3c; overflow-wrap:anywhere; }
  .pl-alert__m{ display:block; margin-top:3px; font:600 12px/1 var(--ag-font-mono,monospace); color:var(--ag-ink-soft,#626a6e); }
  .pl-alert__n{ flex:none; width:8px; height:8px; border-radius:50%; background:#e0245e; margin-top:6px; }

  /* layout
     The feed column is CAPPED, not fluid. A card whose stage is 4:5 grows its
     height with its width, so a full-width column on a desktop produced a
     1,300px-tall post — one item per screen, and a wall of empty canvas around
     three lines of text. Every feed that has shipped on desktop caps this for
     the same reason. */
  .pl-grid{ display:grid; grid-template-columns:minmax(0,600px) 320px; gap:56px;
            align-items:start; justify-content:center; }
  /* The rail is a sidebar, not a second column of content: quieter type, no
     borders competing with the cards, and it scrolls with you rather than
     sitting in one place looking like an advert. 36px was not enough gutter to
     read as separate — at 56px the eye stops treating them as one grid. */
  .pl-rail{ position:sticky; top:96px; display:flex; flex-direction:column; gap:16px; }

  /* ── composer ──────────────────────────────────────────────────────────
     The one thing that turns Pulse from a wall into a feed. Styled as the first
     card in the column so it reads as "your turn", not as a form bolted on top. */
  .pl-compose{ background:#fff; border:1px solid rgba(16,41,44,.08); border-radius:22px; padding:14px 16px; }
  .pl-compose__row{ display:flex; gap:12px; align-items:flex-start; }
  .pl-compose__av{ flex:none; width:40px; height:40px; border-radius:50%; background:#10292C; color:#7FC87C;
                   display:flex; align-items:center; justify-content:center; font-weight:800; font-size:16px; }
  .pl-compose__ta{ flex:1; min-width:0; border:0; resize:vertical; font:inherit; font-size:15px; line-height:1.5;
                   color:var(--ag-ink,#10292c); background:transparent; padding:9px 0; min-height:46px; }
  .pl-compose__ta:focus{ outline:none; }
  .pl-compose__ta::placeholder{ color:var(--ag-ink-soft,#626a6e); }
  .pl-compose__foot{ display:flex; align-items:center; justify-content:flex-end; gap:12px; margin-top:6px;
                     border-top:1px solid rgba(16,41,44,.07); padding-top:10px; }
  .pl-compose__count{ font:600 12px/1 var(--ag-font-mono,monospace); color:var(--ag-ink-soft,#626a6e); }
  .pl-compose__count.is-full{ color:#a32020; }
  .pl-compose__go{ border:0; background:var(--ag-green,#237b22); color:#fff; font-weight:700; font-size:14px;
                   padding:10px 22px; border-radius:999px; cursor:pointer; text-decoration:none; display:inline-block; }
  .pl-compose__go:hover{ filter:brightness(1.06); }
  .pl-compose--guest{ display:flex; align-items:center; justify-content:space-between; gap:14px; flex-wrap:wrap; }
  .pl-compose__guest{ margin:0; font-size:14px; color:#5a6d6f; }

  /* attach control + pre-send preview */
  .pl-compose__spacer{ flex:1; }
  .pl-attach{ display:inline-flex; align-items:center; gap:8px; cursor:pointer; color:#3d4c4e;
              font-size:13.5px; font-weight:600; padding:8px 12px; border-radius:12px; }
  .pl-attach:hover{ background:#f4f7f4; }
  /* The input is visually hidden but still focusable, so the label lights up from
     the keyboard as well as the mouse — `display:none` would take it out of the
     tab order entirely and make attaching a photo mouse-only. */
  .pl-attach:focus-within{ outline:2px solid var(--ag-green,#237b22); outline-offset:1px; }
  .pl-mediaprev{ position:relative; margin:12px 0 0; border-radius:16px; overflow:hidden;
                 background:#0d1a1b; max-height:420px; display:flex; justify-content:center; }
  .pl-mediaprev__el{ max-width:100%; max-height:420px; display:block; object-fit:contain; }
  .pl-mediaprev__x{ position:absolute; top:8px; right:8px; width:30px; height:30px; border:0; cursor:pointer;
                    border-radius:50%; background:rgba(0,0,0,.6); color:#fff; font-size:19px; line-height:1; }
  .pl-mediaprev__err{ margin:8px 0 0; font-size:13px; font-weight:600; color:#a32020; }

  /* ── THE PHOTO STUDIO ───────────────────────────────────────────────────
     The design's Create screen, minus the music library — that is a licensing
     question, not a code one, and shipping a track list we have no rights to
     would be worse than shipping nothing.

     What is here earns its place twice: it makes a post look composed, AND it
     re-encodes the photo before it leaves the phone. A 6MB camera JPEG becomes
     roughly 300KB, which on a metered Nigerian connection is the difference
     between posting and giving up halfway through an upload. */
  .pl-studio{ margin-top:12px; border:1px solid rgba(16,41,44,.1); border-radius:16px; overflow:hidden; }
  .pl-studio__row{ display:flex; gap:7px; overflow-x:auto; padding:11px 12px;
                   border-top:1px solid rgba(16,41,44,.07); align-items:center; }
  .pl-studio__k{ flex:none; font:700 10px/1 var(--ag-font-mono,monospace); letter-spacing:.12em;
                 text-transform:uppercase; color:var(--ag-ink-soft,#626a6e); margin-right:2px; }
  .pl-studio__c{ flex:none; cursor:pointer; border:1px solid rgba(16,41,44,.14); background:#fff;
                 color:#3d4c4e; font:600 12.5px/1 inherit; padding:8px 12px; border-radius:999px; }
  .pl-studio__c.is-on{ background:var(--ag-ink,#10292c); border-color:var(--ag-ink,#10292c); color:#fff; }
  .pl-studio__c:focus-visible{ outline:2px solid var(--ag-green,#237b22); outline-offset:2px; }
  /* The focus slider only appears when the crop is actually cutting something
     off — offering it on an uncropped photo is a control that does nothing. */
  .pl-studio__focus{ display:flex; align-items:center; gap:10px; padding:4px 12px 12px; }
  .pl-studio__focus input{ flex:1; min-width:0; accent-color:var(--ag-green,#237b22); }
  .pl-studio__note{ padding:0 12px 11px; font-size:12px; color:var(--ag-ink-soft,#626a6e); }
  .pl-studio__note b{ color:#3d4c4e; font-weight:700; }

  .pl-flash{ border-radius:14px; padding:11px 15px; font-size:14px; font-weight:600; }
  .pl-flash--ok{ background:#e6f4e6; color:#1c6b1c; border:1px solid #bfe3bf; }
  .pl-flash--err{ background:#fdf3f3; color:#a32020; border:1px solid #f0c9c9; }

  /* ── THE STAGE ─────────────────────────────────────────────────────────
     The redesign's one structural idea: MEDIA OWNS THE CANVAS and the chrome
     floats over it, rather than a photo boxed inside a white card with a row of
     grey glyphs underneath. Author, channel, caption and every action sit on the
     picture; only the conversation lives below it, on paper.

     Every card gets a stage, including the ones with no picture — a text post
     draws its own canvas. One anatomy for the whole feed is the point: a feed
     where half the cards are one shape and half are another does not read as a
     feed, it reads as two features sharing a page. */
  .pf{ background:#fff; border:1px solid rgba(16,41,44,.08); border-radius:22px; overflow:hidden; }
  /* The rhythm between posts. `.pl-feed` has a gap, but every card lives inside
     ONE of its flex children (the Alpine component), so that gap has never
     reached them — measured at 0px, cards butted edge to edge, which is what
     made the feed feel cramped no matter how much padding went inside a card.
     Whitespace BETWEEN things is what reads as calm; whitespace inside them
     just reads as a big box. */
  .pf + .pf{ margin-top:22px; }
  .pf__stage{ position:relative; width:100%; background:#07100F; overflow:hidden; cursor:pointer;
              /* Kills the 300ms double-tap-to-zoom delay. Without it the second
                 tap of a like lands late enough that the burst feels detached. */
              touch-action:manipulation; -webkit-user-select:none; user-select:none; }
  /* The 4:5 box belongs to PICTURES. A text post given the same box is three
     lines of type floating in 400px of black — the ratio exists to protect a
     photographer's framing, and there is no framing to protect here. So a text
     card is sized by its words and the feed gets a rhythm instead of a march of
     identical rectangles. */
  .pf__stage--media{ aspect-ratio:4/5; max-height:min(70vh,620px); }
  .pf__stage img, .pf__stage video{ display:block; width:100%; height:100%; object-fit:cover; }
  /* Contain, not cover, for video: cropping somebody's framing is one thing on a
     still and another on footage they shot deliberately. */
  .pf__stage video{ object-fit:contain; background:#000; }

  /* A text post's canvas. In flow, so the words set the height. Padded clear of
     the rail on the right and the byline below, and clamped — a stage that
     scrolls is not a stage. */
  /* min-height is not taste, it is the RAIL'S HEIGHT. Five stacked buttons come
     to ~265px and the stage clips its overflow, so a two-line post drew a card
     shorter than its own controls and the top of the rail — the reaction button —
     was cut off the card entirely. Whatever the rail costs, the shortest stage
     has to clear it. */
  .pf__canvas{ position:relative; display:flex; align-items:center; min-height:316px;
               padding:30px 78px 84px 24px;
               background:radial-gradient(125% 95% at 12% 0%,#1E4244 0%,#10292C 46%,#07100F 100%); }
  .pf__canvas p{ margin:0; font-family:var(--ag-font-display); font-weight:700;
                 font-size:clamp(1.3rem,3.2vw,1.85rem); line-height:1.22; letter-spacing:-.015em;
                 color:#fff; overflow-wrap:anywhere;
                 display:-webkit-box; -webkit-line-clamp:7; -webkit-box-orient:vertical; overflow:hidden; }
  .pf__canvas .ag-tag{ color:#7FC87C; text-decoration:none; }
  .pf__canvas .ag-link{ color:#7FC87C; text-decoration:underline; text-underline-offset:2px;
                        overflow-wrap:anywhere; }

  /* Top and bottom scrims. Without them white text lands on whatever the photo
     happens to be, and a bright sky makes the author's name unreadable. */
  .pf__scrim{ position:absolute; inset:0; pointer-events:none;
              background:linear-gradient(180deg,rgba(0,0,0,.52) 0%,rgba(0,0,0,.05) 20%,
                                          rgba(0,0,0,0) 42%,rgba(0,0,0,.48) 72%,rgba(0,0,0,.86) 100%); }

  /* The burst: a heart that scales past its resting size, settles, then floats
     out. Sits in the centre of the post it belongs to, never the viewport. */
  .pf__burst{ position:absolute; inset:0; display:flex; align-items:center; justify-content:center;
              pointer-events:none; opacity:0; z-index:5; }
  .pf__burst svg{ width:112px; height:112px; filter:drop-shadow(0 8px 22px rgba(0,0,0,.5)); }
  @media (prefers-reduced-motion:no-preference){
    .pf__burst.is-on{ animation:pfBurst .95s cubic-bezier(.17,.89,.32,1.28) forwards; }
    @keyframes pfBurst{
      0%   { opacity:0; transform:scale(.2) rotate(-12deg); }
      18%  { opacity:1; transform:scale(1.22) rotate(4deg); }
      34%  { transform:scale(.94) rotate(0deg); }
      50%  { opacity:1; transform:scale(1) rotate(0deg); }
      100% { opacity:0; transform:scale(1.06) translateY(-46px); }
    }
  }
  /* Reduced motion still gets confirmation — it just does not fly. */
  @media (prefers-reduced-motion:reduce){ .pf__burst.is-on{ opacity:1; transition:opacity .2s; } }

  /* ── THE RIGHT-HAND ACTION RAIL ────────────────────────────────────────
     Thumb-reachable on a phone held in one hand, which is the whole reason it
     is a column on the right rather than a row underneath. */
  .pf__rail{ position:absolute; right:6px; bottom:14px; z-index:4;
             display:flex; flex-direction:column; align-items:center; gap:13px; }
  .pf__r{ border:0; background:none; padding:4px; cursor:pointer; font-family:inherit; line-height:1;
          display:flex; flex-direction:column; align-items:center; gap:5px; color:#fff; }
  .pf__r svg{ width:29px; height:29px; fill:none; stroke:#fff; stroke-width:1.6;
              stroke-linecap:round; stroke-linejoin:round;
              filter:drop-shadow(0 2px 7px rgba(0,0,0,.6)); }
  .pf__r span{ font:700 11px/1 var(--ag-font-mono,monospace); color:#fff; text-shadow:0 1px 4px rgba(0,0,0,.65); }
  .pf__r:focus-visible{ outline:2px solid #7FC87C; outline-offset:3px; border-radius:14px; }
  /* The held reaction fills in its own colour — the four are told apart by hue
     as much as by shape, which is what makes the rail readable at a glance. */
  .pf__r[data-held="cheer"] svg{ fill:#E0245E; stroke:#E0245E; }
  .pf__r[data-held="insight"] svg{ fill:#F2C230; stroke:#F2C230; }
  .pf__r[data-held="respect"] svg{ fill:#7FC87C; stroke:#7FC87C; }
  .pf__r[data-held="support"] svg{ fill:#5AB6D9; stroke:#5AB6D9; }
  .pf__r--save[aria-pressed="true"] svg{ fill:#fff; }
  .pf__r--repost[aria-pressed="true"] svg{ stroke:#7FC87C; }
  .pf__r--repost[aria-pressed="true"] span{ color:#7FC87C; }
  @media (prefers-reduced-motion:no-preference){
    .pf__r[data-held] svg{ animation:pfPop .34s ease; }
    @keyframes pfPop{ 0%{transform:scale(1)} 40%{transform:scale(1.3)} 100%{transform:scale(1)} }
  }

  /* The picker. Anchored to the reaction button, opening leftwards into the
     picture rather than off the edge of a 320px screen. */
  .pf__react{ position:relative; }
  .pf__pick{ position:absolute; right:calc(100% + 6px); bottom:0; display:flex; gap:2px; padding:6px;
             border-radius:999px; background:rgba(7,16,15,.94); border:1px solid rgba(255,255,255,.16);
             box-shadow:0 16px 38px rgba(0,0,0,.5); backdrop-filter:blur(6px); }
  .pf__pk{ border:0; background:none; cursor:pointer; padding:6px 7px; border-radius:999px;
           display:flex; flex-direction:column; align-items:center; gap:4px; font-family:inherit; }
  .pf__pk:hover, .pf__pk:focus-visible{ background:rgba(255,255,255,.12); outline:none; }
  .pf__pk svg{ width:24px; height:24px; stroke-width:1.6; stroke-linecap:round; stroke-linejoin:round; }
  .pf__pk small{ font:700 8.5px/1 var(--ag-font-mono,monospace); letter-spacing:.07em;
                 text-transform:uppercase; color:rgba(255,255,255,.72); }
  .pf__pk[data-kind="cheer"] svg{ fill:#E0245E; stroke:#E0245E; }
  .pf__pk[data-kind="insight"] svg{ fill:#F2C230; stroke:#F2C230; }
  .pf__pk[data-kind="respect"] svg{ fill:#7FC87C; stroke:#7FC87C; }
  .pf__pk[data-kind="support"] svg{ fill:#5AB6D9; stroke:#5AB6D9; }
  .pf__pk[aria-pressed="true"]{ background:rgba(255,255,255,.18); }

  /* ── WHAT SITS ON THE PICTURE ──────────────────────────────────────────
     `right` clears the rail, so a long name never runs underneath it. */
  .pf__meta{ position:absolute; left:15px; right:70px; bottom:16px; z-index:3;
             display:flex; flex-direction:column; gap:7px; }
  .pf__chan{ align-self:flex-start; font:700 9.5px/1 var(--ag-font-mono,monospace); letter-spacing:.13em;
             text-transform:uppercase; color:#7FC87C; background:rgba(11,26,27,.55);
             border:1px solid rgba(127,200,124,.4); border-radius:999px; padding:5px 9px;
             text-decoration:none; }
  .pf__whoami{ display:flex; align-items:center; gap:7px; min-width:0; }
  .pf__name{ font-weight:700; font-size:15px; color:#fff; text-shadow:0 1px 6px rgba(0,0,0,.65);
             overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .pf__tick{ flex:none; width:15px; height:15px; line-height:0; }
  .pf__tick svg{ display:block; width:15px; height:15px; }
  .pf__role{ align-self:flex-start; font-size:12px; font-weight:600; color:rgba(255,255,255,.72);
             text-shadow:0 1px 5px rgba(0,0,0,.6); text-decoration:none; margin-top:-3px; }
  .pf__role:hover{ color:#7FC87C; }
  .pf__when{ flex:none; font:600 11.5px/1 var(--ag-font-mono,monospace); color:rgba(255,255,255,.62); }
  .pf__cap{ margin:0; font-size:14px; line-height:1.5; color:rgba(255,255,255,.94);
            text-shadow:0 1px 6px rgba(0,0,0,.7); overflow-wrap:anywhere; }
  .pf__cap.is-clamped{ display:-webkit-box; -webkit-line-clamp:3; -webkit-box-orient:vertical; overflow:hidden; }
  .pf__cap .ag-tag{ color:#7FC87C; font-weight:600; text-decoration:none; }
  .pf__cap .ag-link{ color:#7FC87C; font-weight:600; text-decoration:underline;
                     text-underline-offset:2px; overflow-wrap:anywhere; }
  .pf__more2{ align-self:flex-start; border:0; background:none; padding:2px 0; cursor:pointer;
              font:700 12px/1 inherit; color:rgba(255,255,255,.72); }
  .pf__flag{ position:absolute; top:12px; right:12px; z-index:4; border:0; cursor:pointer; line-height:0;
             width:34px; height:34px; border-radius:50%; color:#fff; background:rgba(7,16,15,.42);
             display:flex; align-items:center; justify-content:center; }
  .pf__flag:hover{ background:rgba(7,16,15,.7); }

  /* ── THE PAPER BELOW ───────────────────────────────────────────────────
     Who reacted and how, then the conversation. Kept off the picture because
     reading is a different posture from reacting. */
  .pf__sum{ display:flex; align-items:center; gap:9px; padding:13px 16px 0; flex-wrap:wrap; }
  .pf__pips{ display:flex; align-items:center; flex:none; }
  .pf__pip{ width:23px; height:23px; border-radius:50%; margin-left:-6px; flex:none;
            display:flex; align-items:center; justify-content:center;
            background:#fff; border:2px solid #fff; box-shadow:0 1px 4px rgba(16,41,44,.22); }
  .pf__pip:first-child{ margin-left:0; }
  .pf__pip svg{ width:13px; height:13px; }
  .pf__sumtx{ font-size:13.5px; font-weight:700; color:var(--ag-ink,#10292c); }
  .pf__sumtx b{ font-weight:700; }
  .pf__reposted{ font-size:12.5px; color:var(--ag-ink-soft,#626a6e); margin-left:auto; }
  .pf__open{ display:block; padding:8px 18px 14px; font-size:13px; font-weight:600;
             color:var(--ag-green,#237b22); text-decoration:none; }

  /* ── CHANNEL CHIPS ─────────────────────────────────────────────────────
     Real programmes, ordered by how much is actually posted in them. */
  .pf-chips{ display:flex; gap:8px; overflow-x:auto; padding:2px 2px 14px; }
  .pf-chip{ flex:none; cursor:pointer; border:1px solid rgba(16,41,44,.14); background:#fff;
            color:#3d4c4e; font:600 13px/1 inherit; padding:9px 15px; border-radius:999px; }
  .pf-chip.is-on{ background:var(--ag-ink,#10292c); border-color:var(--ag-ink,#10292c); color:#fff; }
  .pf-chip small{ font-family:var(--ag-font-mono,monospace); opacity:.6; margin-left:5px; }

  /* ── THE REPOST SHEET ──────────────────────────────────────────────────
     A repost with nothing added is a bookmark with extra steps, so the sheet
     asks for the line before it sends — but never insists on one. */
  .pf-sheet{ position:fixed; inset:0; z-index:70; display:flex; align-items:flex-end;
             justify-content:center; background:rgba(7,16,15,.6); }
  .pf-sheet__c{ width:100%; max-width:540px; background:#fff; border-radius:22px 22px 0 0;
                padding:20px 20px 24px; box-shadow:0 -20px 50px rgba(0,0,0,.3); }
  .pf-sheet__k{ margin:0 0 4px; font:700 11px/1 var(--ag-font-mono,monospace); letter-spacing:.12em;
                text-transform:uppercase; color:#5a6d6f; }
  .pf-sheet__q{ margin:0 0 14px; font-size:14px; line-height:1.5; color:#4a5256; }
  .pf-sheet__q b{ color:var(--ag-ink,#10292c); }
  .pf-sheet__ta{ width:100%; border:1px solid rgba(16,41,44,.14); border-radius:16px; resize:vertical;
                 font:inherit; font-size:15px; line-height:1.55; padding:12px 14px; min-height:88px;
                 color:var(--ag-ink,#10292c); }
  .pf-sheet__ta:focus{ outline:2px solid var(--ag-green,#237b22); outline-offset:1px; }
  .pf-sheet__row{ display:flex; align-items:center; gap:10px; margin-top:14px; }
  .pf-sheet__row .pf__cmgo{ margin-left:auto; }
  .pf-sheet__x{ border:1px solid rgba(16,41,44,.14); background:#fff; color:#3d4c4e;
                font:600 13.5px/1 inherit; padding:11px 18px; border-radius:999px; cursor:pointer; }
  @media (min-width:620px){ .pf-sheet{ align-items:center; } .pf-sheet__c{ border-radius:22px; } }

  /* comments */
  .pf__cm{ border-top:1px solid rgba(16,41,44,.07); padding:12px 16px 14px; }
  .pf__cmrow{ font-size:14px; line-height:1.55; color:#2c3a3c; margin-bottom:7px; overflow-wrap:anywhere; }
  .pf__cmrow b{ font-weight:700; color:var(--ag-ink,#10292c); margin-right:6px; }
  .pf__cmall{ display:inline-block; margin:2px 0 10px; font-size:13px; color:var(--ag-ink-soft,#626a6e); text-decoration:none; }
  .pf__cmform{ display:flex; gap:10px; align-items:flex-start; }
  .pf__cmta{ flex:1; min-width:0; border:1px solid rgba(16,41,44,.12); border-radius:14px; resize:vertical;
             font:inherit; font-size:14px; line-height:1.5; padding:9px 12px; color:var(--ag-ink,#10292c); min-height:40px; }
  .pf__cmta:focus{ outline:2px solid var(--ag-green,#237b22); outline-offset:1px; }
  .pf__cmgo{ flex:none; border:0; background:var(--ag-green,#237b22); color:#fff; font-weight:700; font-size:13.5px;
             padding:10px 16px; border-radius:999px; cursor:pointer; }
  .pf__cmgo[disabled]{ opacity:.45; cursor:default; }
  .pf__note{ margin:8px 0 0; font-size:12.5px; font-weight:600; color:#8a6d1f;
             background:#fdf6e3; border:1px solid #efe0b5; border-radius:12px; padding:8px 11px; }
  .pf__guest{ margin:0; font-size:13.5px; color:#5a6d6f; }
  .pf__guest a{ color:var(--ag-green,#237b22); font-weight:700; }

  /* new-posts pill + infinite scroll */
  .pf-new{ position:sticky; top:84px; z-index:5; display:flex; justify-content:center; margin:0 0 -6px; }
  .pf-new button{ border:0; background:var(--ag-ink,#10292c); color:#fff; font:700 13px/1 inherit; cursor:pointer;
                  padding:11px 20px; border-radius:999px; box-shadow:0 8px 24px rgba(16,41,44,.22); }
  .pf-more{ display:flex; justify-content:center; padding:8px 0 4px; }
  .pf-more button{ border:1px solid rgba(16,41,44,.14); background:#fff; color:#3d4c4e; font:700 13.5px/1 inherit;
                   cursor:pointer; padding:12px 22px; border-radius:999px; }
  .pf-end{ text-align:center; font-size:13px; color:var(--ag-ink-soft,#626a6e); padding:10px 0; }

  /* toast */
  .pf-toast{ position:fixed; left:50%; bottom:26px; transform:translateX(-50%); z-index:60;
             background:var(--ag-ink,#10292c); color:#fff; font-size:13.5px; font-weight:600;
             padding:12px 18px; border-radius:999px; box-shadow:0 10px 30px rgba(0,0,0,.25);
             display:flex; gap:12px; align-items:center; max-width:calc(100vw - 32px); }
  .pf-toast a{ color:#7FC87C; font-weight:700; white-space:nowrap; }

  /* feed
     min-width:0 is load-bearing. `1fr` is `minmax(auto, 1fr)`, and `auto`
     resolves to the item's MIN-CONTENT width — which for this column is about
     417px. On a 390px phone the track grew past the container and, being
     centred, hung off BOTH gutters: the chip row started at −14px with "All"
     half off-screen. Zero is the only floor that lets a grid item actually be
     as narrow as its column. */
  .pl-feed{ display:flex; flex-direction:column; gap:22px; min-width:0; }
  .pl-post{ background:#fff; border:1px solid rgba(16,41,44,.08); border-radius:22px; overflow:hidden; }
  .pl-post__hd{ display:flex; align-items:center; gap:12px; padding:16px 18px; }
  .pl-post__av{ width:44px; height:44px; border-radius:13px; background:var(--ag-green-wash); color:var(--ag-green-dark); display:flex; align-items:center; justify-content:center; font-family:var(--ag-font-display); font-weight:700; font-size:19px; flex:none; }
  .pl-post__au{ font-weight:600; font-size:15px; color:var(--ag-ink); }
  .pl-post__mt{ font-size:12.5px; color:#5a6d6f; margin-top:2px; }
  .pl-post__cover{ display:block; width:100%; aspect-ratio:16/9; background-size:cover; background-position:center; background-color:#10292C; }
  .pl-post__bd{ padding:16px 18px 18px; }
  .pl-post__cat{ font:700 11px/1 var(--ag-font-mono); letter-spacing:.1em; text-transform:uppercase; color:var(--ag-green); }
  .pl-post__t{ margin:8px 0 0; font-family:var(--ag-font-display); font-weight:700; font-size:19px; line-height:1.25; color:var(--ag-ink); text-decoration:none; display:block; }
  .pl-post__x{ margin:8px 0 0; font-size:14px; line-height:1.55; color:#4a5256; }
  .pl-post__a{ display:inline-flex; align-items:center; gap:6px; margin-top:8px; padding:8px 0; min-height:40px; font-size:13.5px; font-weight:600; color:var(--ag-green); text-decoration:none; }

  .pl-empty{ background:#fff; border:1px dashed rgba(16,41,44,.16); border-radius:20px; padding:48px 24px; text-align:center; color:#5a6d6f; font-size:14.5px; }
  .pl-empty a{ color:var(--ag-green); font-weight:600; }
  /* A button that has to read as a link: switching tab is not navigation, so an
     <a href> would be a lie to a screen reader and a broken middle-click. */
  .pl-linkish{ border:0; background:none; padding:0; font:inherit; color:var(--ag-green);
               font-weight:600; cursor:pointer; text-decoration:underline; }
  .pl-linkish:focus-visible{ outline:2px solid var(--ag-ink,#10292c); outline-offset:2px; }

  /* rail cards — borderless by default. Four bordered boxes beside a column of
     bordered cards is eight competing outlines on one screen. */
  .pl-card{ background:transparent; border:0; border-radius:20px; padding:2px 0 18px;
            border-bottom:1px solid rgba(16,41,44,.08); }
  .pl-card:last-child{ border-bottom:0; }
  .pl-card__k{ margin:0 0 14px; font:700 11px/1 var(--ag-font-mono); letter-spacing:.14em; text-transform:uppercase; color:var(--ag-ink-soft,#626a6e); }
  .pl-lead{ display:flex; align-items:center; gap:12px; text-decoration:none; }
  .pl-lead + .pl-lead{ margin-top:14px; }
  .pl-lead__r{ font-family:var(--ag-font-mono); font-weight:700; font-size:14px; color:#5a6d6f; width:18px; flex:none; }
  .pl-lead__av{ width:40px; height:40px; border-radius:12px; background:var(--ag-green-wash); color:var(--ag-green-dark); display:flex; align-items:center; justify-content:center; font-family:var(--ag-font-display); font-weight:700; font-size:16px; flex:none; background-size:cover; background-position:center; }
  .pl-lead__n{ flex:1; min-width:0; font-weight:600; font-size:14px; color:var(--ag-ink); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .pl-lead__c{ font-family:var(--ag-font-mono); font-weight:700; font-size:15px; color:var(--ag-green); flex:none; }
  .pl-dark{ background:#10292C; border-radius:20px; padding:24px; position:relative; overflow:hidden; }
  .pl-dark__orb{ position:absolute; right:-40px; top:-40px; width:150px; height:150px; border-radius:50%; background:radial-gradient(circle,rgba(127,200,124,.22),transparent 70%); }
  .pl-dark__k{ position:relative; margin:0 0 6px; font:700 11px/1 var(--ag-font-mono); letter-spacing:.12em; text-transform:uppercase; color:#fbc329; }
  .pl-dark__t{ position:relative; font-family:var(--ag-font-display); font-weight:700; font-size:20px; color:#fff; }
  .pl-dark__p{ position:relative; margin:8px 0 16px; font-size:13px; line-height:1.5; color:rgba(255,255,255,.68); }
  .pl-dark__btn{ position:relative; display:block; width:100%; text-align:center; cursor:pointer; text-decoration:none; border:0; background:#fff; color:#10292C; font-family:inherit; font-weight:600; font-size:14px; padding:12px; border-radius:999px; }

  /* events */
  .pl-evs{ display:flex; flex-direction:column; gap:14px; }
  .pl-ev{ display:flex; gap:18px; align-items:center; background:#fff; border:1px solid rgba(16,41,44,.08); border-radius:20px; padding:18px 20px; text-decoration:none; transition:border-color .15s; }
  .pl-ev:hover{ border-color:rgba(16,41,44,.2); }
  .pl-ev__d{ flex:none; width:72px; height:78px; border-radius:16px; background:var(--ag-green-wash); color:var(--ag-green-dark); display:flex; flex-direction:column; align-items:center; justify-content:center; }
  .pl-ev__mon{ font-size:11px; font-weight:700; letter-spacing:.08em; text-transform:uppercase; }
  .pl-ev__day{ font-family:var(--ag-font-mono); font-weight:700; font-size:27px; line-height:1; }
  .pl-ev__t{ font-family:var(--ag-font-display); font-weight:700; font-size:20px; color:var(--ag-ink); }
  .pl-ev__m{ margin-top:5px; font-size:13px; color:#5a6d6f; }
  .pl-ev__cta{ flex:none; font-size:14px; font-weight:600; color:var(--ag-green); }

  /* community */
  .pl-chs{ display:grid; grid-template-columns:1fr 1fr; gap:16px; }
  .pl-ch{ background:#fff; border:1px solid rgba(16,41,44,.08); border-radius:20px; padding:22px; text-decoration:none; transition:border-color .15s; }
  .pl-ch:hover{ border-color:rgba(16,41,44,.2); }
  .pl-ch__t{ font-family:var(--ag-font-display); font-weight:700; font-size:18px; color:var(--ag-ink); }
  .pl-ch__x{ margin:8px 0 0; font-size:13.5px; line-height:1.5; color:#5a6d6f; }
  .pl-ch__m{ margin-top:14px; padding-top:14px; border-top:1px solid rgba(16,41,44,.06); font-size:12.5px; color:#5a6d6f; }

  /* The collapsed composer. display:none by default, because on anything with
     room the expanded box IS the right answer — a desktop reader is not paying
     for it with the only screen they have. */
  .pl-openc{ display:none; width:100%; align-items:center; gap:12px; cursor:pointer;
             border:0; background:none; padding:8px 0; font:inherit; color:var(--ag-ink-soft,#626a6e); text-align:left; }
  .pl-openc__t{ flex:1; min-width:0; font-size:15px; }
  .pl-openc svg{ flex:none; color:#3d4c4e; }
  .pl-openc:focus-visible{ outline:2px solid var(--ag-green,#237b22); outline-offset:3px; border-radius:12px; }

  /* `minmax(0,1fr)` and not `1fr` — `1fr` is `minmax(auto, 1fr)`, and `auto` is
     min-content, so the widest thing in the rail set the width of the column, the column
     set the width of the page, and Pulse scrolled sideways by 56px on a 360 phone. The
     DESKTOP rule above already knows this: it says `minmax(0,600px)`. This override threw
     that away at exactly the width where it matters most. `.pl-feed` was protected by its
     own `min-width:0`, which is why the feed looked innocent and the rail took the blame.
     Once the track can be narrower than its content, the tab strip does what it was
     written to do and scrolls inside its own box. */
  @media (max-width:900px){ .pl-grid{ grid-template-columns:minmax(0,1fr); } .pl-rail{ position:static; } }

  /* ── PHONE ───────────────────────────────────────────────────────────────
     Measured, not guessed: before this block there were 614px of chrome above
     the first post on a 390x900 screen — a masthead, a one-avatar stories rail,
     four tabs and a 300px empty textarea. Two thirds of the screen spent before
     any content. What follows removes furniture rather than shrinking it, and
     spends the space it frees on the gap BETWEEN cards, which is what actually
     reads as calm. */
  @media (max-width:700px){
    .pl{ padding-top:14px; padding-bottom:96px; }
    /* The masthead goes; the h1 survives as sr-only for readers and crawlers. */
    .pl-head{ display:none; }

    /* Tabs become app chrome: smaller, tighter, and stuck under the site bar so
       switching surface never costs a scroll back to the top. */
    .pl-tabs{ margin:0 0 18px; gap:0; position:sticky; top:0; z-index:6;
              background:#fbfbfa; box-shadow:0 6px 10px -10px rgba(16,41,44,.5);
              /* Four tabs do not fit 296px of usable width at 320. They scroll —
                 but a scroller with a hard edge looks like a row that simply ends,
                 and the tab that gets hidden is whichever was added last. The fade
                 says "there is more" without costing a pixel of label. */
              -webkit-mask-image:linear-gradient(90deg,#000 calc(100% - 26px),transparent);
              mask-image:linear-gradient(90deg,#000 calc(100% - 26px),transparent); }
    .pl-tab{ padding:11px 12px; font-size:14px; }
    /* No fade once everything fits — a permanent one reads as a rendering fault. */
    @media (min-width:430px){ .pl-tabs{ -webkit-mask-image:none; mask-image:none; } }

    .pl-compose{ padding:10px 14px; border-radius:18px; }
    /* One tap-target instead of a form, until somebody actually wants the form. */
    .pl-compose:not(.is-open) .pl-openc{ display:flex; }
    .pl-compose:not(.is-open) .pl-compose__full{ display:none; }

    .pf-chips{ padding-bottom:14px; }
    /* The whitespace the clutter paid for. */
    .pf + .pf{ margin-top:28px; }
    .pl-feed{ gap:22px; }
    .pl-grid{ gap:26px; }
  }

  @media (max-width:560px){ .pl-chs{ grid-template-columns:1fr; } .pl-ev{ flex-wrap:wrap; } .pl-ev__cta{ width:100%; } }
</style>
{% endblock %}

{% block content %}
{# The page shell owns the tabs AND the alerts, because the unread dot lives on
   a tab and the list lives in a panel — one state, two places on screen. The
   feed keeps its own component; they do not need to know about each other. #}
<div class="pl" x-data="plPage({{ (is_member|default(false))|json_encode }})">

  {# ── THE HEADER ────────────────────────────────────────────────────────
     Present for a reader on a desktop and for every screen reader; visually
     gone on a phone. A feed does not need a masthead: the nav already says
     Pulse, and on a 900px screen this eyebrow and headline were spending 200
     of the 614 pixels that stood between opening the page and seeing a post. #}
  <header class="pl-head">
    <p class="pl-eyebrow">Pulse · the living feed</p>
    <h1 class="pl-h1">What the continent is <em>talking about.</em></h1>
  </header>
  <h1 class="sr-only pl-h1--sr">Pulse — what the continent is talking about</h1>

  {# NO STORIES ROW. It borrowed Instagram's shape without Instagram's content:
     the ring promises something posted today that disappears tomorrow, and what
     it actually linked was the CPI leaderboard — permanent profiles, unchanged
     from one visit to the next. A control that lies about what is behind it gets
     tapped once. The leaderboard is still on the page, in the rail, labelled as
     what it is. #}

  {# Tabs #}
  <div class="pl-tabs">
    <button type="button" class="pl-tab" :class="tab==='foryou' && 'is-on'" @click="tab='foryou'" :aria-pressed="tab==='foryou'">For you</button>
    {# Reels. Advertised in the main navigation, on the home page and on the status
       page — where it was listed as "Operational" — while no such surface existed
       anywhere on the platform. #}
    <button type="button" class="pl-tab" :class="tab==='reels' && 'is-on'" @click="tab='reels'" :aria-pressed="tab==='reels'">Reels</button>
    <button type="button" class="pl-tab" :class="tab==='events' && 'is-on'" @click="tab='events'" :aria-pressed="tab==='events'">Events</button>
    <button type="button" class="pl-tab" :class="tab==='community' && 'is-on'" @click="tab='community'" :aria-pressed="tab==='community'">Community</button>
    {% if is_member %}
    {# Members only. There is nothing to alert a guest about — they have no posts
       to be reacted to and no profile to be followed. #}
    <button type="button" class="pl-tab" :class="tab==='alerts' && 'is-on'" @click="tab='alerts'"
            :aria-pressed="tab==='alerts'">Alerts<span class="pl-tab__dot" x-show="unread > 0" x-cloak
            :aria-label="unread + ' unread'" x-text="unread > 9 ? '9+' : unread"></span></button>
    {% endif %}
  </div>

  {# ── FOR YOU · REELS ──────────────────────────────────────────────────────
     ONE feed, two tabs. The mockup says it in as many words — "VERTICAL FEED
     (Feed + Reels share this)" — and it is also the only honest way to build it:
     Reels is not a different feed, it is this one restricted to video.

     A second plFeed instance would mean duplicating ~250 lines of card markup,
     and every future change to a card would have to be made twice or silently
     apply to only one tab. Switching tabs re-queries with the filter, exactly as
     pressing a channel chip already does. #}
  <div x-show="tab==='foryou' || tab==='reels'">
    <div class="pl-grid">
      <div class="pl-feed">

        {# ── THE COMPOSER ─────────────────────────────────────────────────
           Pulse was a read-only wall: a page of things published AT members, with
           not one form on it. This is what makes it a feed people can use.
           A post here becomes a community thread — same spam filter, same
           moderation verdict, same queue — so it opens with replies and cheers
           when anyone clicks through. #}
        {% if flash_notice %}<div class="pl-flash pl-flash--ok" role="status">{{ flash_notice }}</div>{% endif %}
        {% if flash_error %}<div class="pl-flash pl-flash--err" role="alert">{{ flash_error }}</div>{% endif %}

        {% if is_member %}
        {# enctype is what makes the file field work at all — without it the browser
           urlencodes the form and the server receives the filename as a string. #}
        <form class="pl-compose" method="POST" action="/pulse" enctype="multipart/form-data"
              x-data="plCompose({{ pulse_max|default(600) }}, {{ (media_limit|default('8MB'))|json_encode }})"
              :class="open && 'is-open'" @submit="render($event)">
          <input type="hidden" name="_token" value="{{ csrf_token }}">

          {# ── THE COLLAPSED COMPOSER ──────────────────────────────────────
             Phone only. Expanded, this box is 300px of empty textarea sitting
             between the reader and the feed, every visit, whether or not they
             came here to write. Collapsed it is one 56px row that says what it
             does, and one tap opens the real thing with the caret already in it. #}
          <button type="button" class="pl-openc" @click="expand()">
            <span class="pl-compose__av" aria-hidden="true">{{ (member_name|default('You'))|first|upper }}</span>
            <span class="pl-openc__t">Share something…</span>
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false"><rect x="3" y="4" width="18" height="16" rx="2.5"/><circle cx="8.5" cy="9.5" r="1.6"/><path d="m3.5 17 4.7-4.6a1.8 1.8 0 0 1 2.5 0L15 16.7m2-3.2a1.7 1.7 0 0 1 2.3 0l1.2 1.1" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>

          <div class="pl-compose__full">
          <div class="pl-compose__row">
            <span class="pl-compose__av" aria-hidden="true">{{ (member_name|default('You'))|first|upper }}</span>
            <label for="plBody" class="sr-only">Share something with the community</label>
            {# `required` is gone: a photo with no caption is a post. The server
               enforces "text OR media", which is the rule that actually holds. #}
            <textarea id="plBody" name="body" class="pl-compose__ta" rows="2"
                      :maxlength="max" x-on:input="n = $event.target.value.length"
                      x-ref="ta" placeholder="Share something with the community…"></textarea>
          </div>

          {# The chosen file, before it is sent. Reading it back from the input is
             the only honest preview — it shows the bytes the browser will upload,
             not a guess from the filename. #}
          <div class="pl-mediaprev" x-show="!!preview" x-cloak
               :style="kind === 'image' && crop !== 'free' ? ('aspect-ratio:' + RATIOS[crop]) : null">
            {# object-position carries the focus slider, so a portrait keeps its
               head in frame rather than being centre-cropped through the chin.
               The preview uses CSS for both the crop and the filter — instant,
               and the canvas only runs once, on submit. #}
            <img class="pl-mediaprev__el" x-show="kind === 'image'"
                 :src="kind === 'image' ? preview : null"
                 :style="kind === 'image' ? previewStyle() : null"
                 alt="The photo you are about to post">
            <video class="pl-mediaprev__el" x-show="kind === 'video'"
                   :src="kind === 'video' ? preview : null" controls playsinline muted></video>
            <button type="button" class="pl-mediaprev__x" @click="clear()" aria-label="Remove the attachment">×</button>
          </div>

          {# Photos only. There is no client-side video editing here: trimming
             video in a browser means WebCodecs or ffmpeg.wasm, and neither is a
             reasonable thing to hand a mid-range Android on a metered plan. #}
          <div class="pl-studio" x-show="kind === 'image'" x-cloak>
            <div class="pl-studio__row" role="group" aria-label="Shape">
              <span class="pl-studio__k">Shape</span>
              <template x-for="c in CROPS" :key="c">
                <button type="button" class="pl-studio__c" :class="crop === c && 'is-on'"
                        :aria-pressed="crop === c" @click="crop = c" x-text="CROP_LABEL[c]"></button>
              </template>
            </div>

            <div class="pl-studio__focus" x-show="crop !== 'free'">
              <label class="pl-studio__k" for="plFocus">Focus</label>
              <input type="range" id="plFocus" min="0" max="100" step="1" x-model.number="focus">
            </div>

            <div class="pl-studio__row" role="group" aria-label="Colour">
              <span class="pl-studio__k">Colour</span>
              <template x-for="(css, name) in FILTERS" :key="name">
                <button type="button" class="pl-studio__c" :class="filter === name && 'is-on'"
                        :aria-pressed="filter === name" @click="filter = name" x-text="name"></button>
              </template>
            </div>

            <p class="pl-studio__note" x-show="!!sizeNote" x-html="sizeNote"></p>
          </div>
          <p class="pl-mediaprev__err" x-show="err" x-cloak x-text="err" role="alert"></p>

          <div class="pl-compose__foot">
            <label class="pl-attach">
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false"><rect x="3" y="4" width="18" height="16" rx="2.5"/><circle cx="8.5" cy="9.5" r="1.6"/><path d="m3.5 17 4.7-4.6a1.8 1.8 0 0 1 2.5 0L15 16.7m2-3.2a1.7 1.7 0 0 1 2.3 0l1.2 1.1" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span>Photo or video</span>
              <input type="file" name="media" accept="image/*,video/*" class="sr-only"
                     x-ref="file" @change="pick($event)">
            </label>
            <span class="pl-compose__spacer"></span>
            {# The counter appears only once it starts to matter. A number ticking up
               from zero on an empty box is pressure, not help. #}
            <span class="pl-compose__count" x-show="n > max - 120" x-cloak
                  :class="n >= max ? 'is-full' : ''" x-text="(max - n) + ' left'"></span>
            <button class="pl-compose__go" type="submit" :disabled="busy">Post</button>
          </div>
          </div>
        </form>
        {% else %}
        <div class="pl-compose pl-compose--guest">
          <p class="pl-compose__guest">Anyone can read the Pulse. Sign in to post, reply and cheer.</p>
          <a class="pl-compose__go" href="/account/login?next=%2Fpulse">Sign in to post</a>
        </div>
        {% endif %}

        {# ── THE FEED ─────────────────────────────────────────────────────
           ONE card template, rendered by Alpine from a list seeded with the
           server's first page. The alternative — Twig for page 1 and JS for
           pages 2..n — means two templates for one card, and the day they drift
           the third page silently stops matching the first.

           The seed is inlined as JSON, so the first page needs no fetch: it is
           in the HTML the server already sent. A <noscript> list below keeps the
           posts reachable without JavaScript. #}
        <div x-data="plFeed({{ {
               items:   feed|default([]),
               cursor:  feed_cursor|default(null),
               head:    feed_head|default(0),
               channels: channels|default([]),
               signedIn: is_member|default(false),
               memberName: member_name|default('You')
             }|json_encode }})">

          {# ── CHANNEL CHIPS ──────────────────────────────────────────────
             Only drawn when there is more than one channel to choose between.
             A single chip beside "All" is not a filter, it is a label. #}
          <div class="pf-chips pl-x" x-show="channels.length > 1" x-cloak
               role="group" aria-label="Filter the feed by channel">
            <button type="button" class="pf-chip" :class="channel === 0 && 'is-on'"
                    :aria-pressed="channel === 0" @click="setChannel(0)">All</button>
            <template x-for="c in channels" :key="c.id">
              <button type="button" class="pf-chip" :class="channel === c.id && 'is-on'"
                      :aria-pressed="channel === c.id" @click="setChannel(c.id)">
                <span x-text="c.name"></span><small x-text="c.n"></small>
              </button>
            </template>
          </div>

          {# New posts landed while you were reading. Polled, because shared
             hosting has no persistent process to push from. #}
          <div class="pf-new" x-show="newCount > 0" x-cloak>
            <button type="button" @click="showNew()"
                    x-text="newCount + (newCount === 1 ? ' new post' : ' new posts')"></button>
          </div>

          <template x-for="it in items" :key="it.id">
            <article class="pf">

              {# ── THE STAGE ────────────────────────────────────────────────
                 Media, or a canvas drawn for a post that has none. Double-tap to
                 cheer — the gesture the whole audience already knows — kept off
                 the links inside so tapping a #hashtag still navigates. #}
              <div class="pf__stage" :class="it.media && 'pf__stage--media'" @click="tap(it, $event)"
                   :aria-label="'Post by ' + it.author_name + '. Double tap to cheer.'">

                {# x-show, not x-if. An x-if nested in this x-for is what threw
                   "u is not a function" out of Alpine the moment the list was
                   mutated. `:src` binds to null rather than '' for the hidden
                   branch — Alpine drops a null attribute entirely, whereas src=""
                   resolves to the current page and fetches the whole HTML
                   document again on every single card. #}
                <img x-show="!!it.media && it.media.type === 'image'" x-cloak
                     :src="it.media && it.media.type === 'image' ? it.media.path : null"
                     loading="lazy" decoding="async"
                     :alt="'Photo shared by ' + it.author_name">
                {# Never autoplayed: sound and motion starting by themselves is
                   hostile on a metered connection, which is most of this
                   audience. preload="metadata" fetches the header for the poster
                   frame and the duration, not the file. #}
                <video x-show="!!it.media && it.media.type === 'video'" x-cloak
                       :src="it.media && it.media.type === 'video' ? it.media.path : null"
                       controls playsinline preload="metadata"
                       :aria-label="'Video shared by ' + it.author_name"></video>

                <div class="pf__canvas" x-show="!it.media">
                  <p x-html="rich(it.body || it.title)"></p>
                </div>

                <span class="pf__scrim" aria-hidden="true"></span>
                <span class="pf__burst" :class="it.burst ? 'is-on' : ''" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="#fff"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8Z"/></svg>
                </span>

                <button type="button" class="pf__flag" @click.stop="report(it)"
                        :aria-label="'Report the post by ' + it.author_name">
                  <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><circle cx="5" cy="12" r="1.7"/><circle cx="12" cy="12" r="1.7"/><circle cx="19" cy="12" r="1.7"/></svg>
                </button>

                {# ── who, where, what ── #}
                <div class="pf__meta">
                  <a class="pf__chan" x-show="!!it.channel" x-cloak @click.stop
                     :href="'/pulse?channel=' + it.programme_id" x-text="it.channel"></a>
                  <div class="pf__whoami">
                    <span class="pf__name" x-text="it.author_name"></span>
                    {# FOUR states, not two. A tick that means "has an account"
                       means nothing, and people correctly read it as meaning
                       something — so `none` draws nothing at all. An unearned
                       badge devalues every earned one. #}
                    <span class="pf__tick" x-show="it.author_tier && it.author_tier !== 'none'" x-cloak
                          x-html="badge(it.author_tier)" role="img"
                          :aria-label="it.author_name + ' — ' + TIERS[it.author_tier]"></span>
                    <span class="pf__when" x-text="ago(it.created_at)"></span>
                  </div>
                  {# What this person actually does. The mockup's "professional
                     headline", and the thing that makes a feed of strangers
                     legible — driven by gates_profiles.category, never invented. #}
                  <a class="pf__role" x-show="!!it.author_role" x-cloak @click.stop
                     :href="it.author_slug ? ('/registry/' + it.author_slug) : null"
                     x-text="it.author_role"></a>
                  {# Only for media posts: a text post already IS its canvas, and
                     printing the words twice is the fault we just fixed on the
                     nominee page. #}
                  <p class="pf__cap" x-show="!!it.media && !!it.body" x-cloak
                     :class="it.expanded ? '' : 'is-clamped'" x-html="rich(it.body)"></p>
                  <button type="button" class="pf__more2" x-cloak
                          x-show="(!!it.media && (it.body || '').length > 150) || (!it.media && (it.body || '').length > 320)"
                          @click.stop="it.expanded ? (it.expanded = false) : open(it)"
                          x-text="it.expanded ? 'Show less' : 'Read more'"></button>
                </div>

                {# ── THE RAIL ── #}
                <div class="pf__rail">
                  <div class="pf__react" @mouseenter="hoverPick(it, true)" @mouseleave="hoverPick(it, false)">
                    <div class="pf__pick" x-show="it.pick" x-cloak @click.stop
                         role="group" aria-label="Choose a reaction">
                      <template x-for="k in KINDS" :key="k">
                        <button type="button" class="pf__pk" :data-kind="k"
                                :aria-pressed="it.my_reaction === k ? 'true' : 'false'"
                                @click.stop="react(it, k)" @keydown.escape="it.pick = false"
                                :aria-label="LABELS[k] + ' — react'">
                          <span x-html="glyph(k)"></span>
                          <small x-text="LABELS[k]"></small>
                        </button>
                      </template>
                    </div>
                    {# One press gives the reaction you already hold, or a cheer.
                       Holding, hovering or Arrow-Up opens the four — the same
                       three doors every feed with reactions has settled on. #}
                    <button type="button" class="pf__r pf__r--react" :data-held="it.my_reaction"
                            aria-haspopup="true" :aria-expanded="it.pick ? 'true' : 'false'"
                            @click.stop="react(it, it.my_reaction || 'cheer')"
                            @pointerdown="holdStart(it)" @pointerup="holdEnd(it)"
                            @pointerleave="holdEnd(it)" @contextmenu.prevent="it.pick = true"
                            @keydown.up.prevent="it.pick = true" @keydown.escape="it.pick = false"
                            :aria-label="it.my_reaction ? ('Remove your ' + LABELS[it.my_reaction] + ' from this post') : 'Cheer this post. Press and hold for more reactions.'">
                      <span x-html="glyph(it.my_reaction || 'cheer')"></span>
                      <span x-text="fmt(it.cheer_count)"></span>
                    </button>
                  </div>

                  <button type="button" class="pf__r" @click.stop="openComments(it)"
                          aria-label="Comment on this post">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 9 9 0 0 1-3.6-.7L3 21l1.9-5A8.2 8.2 0 0 1 4 11.5 8.4 8.4 0 0 1 12.5 3 8.4 8.4 0 0 1 21 11.5Z"/></svg>
                    <span x-text="fmt(it.reply_count)"></span>
                  </button>

                  <button type="button" class="pf__r pf__r--repost" :aria-pressed="it.reposted ? 'true' : 'false'"
                          @click.stop="repost(it)"
                          :aria-label="it.reposted ? 'Undo your repost' : 'Repost this, with a line of your own'">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M17 2.5 20.5 6 17 9.5M20.5 6H7a3.5 3.5 0 0 0-3.5 3.5V11M7 21.5 3.5 18 7 14.5M3.5 18H17a3.5 3.5 0 0 0 3.5-3.5V13"/></svg>
                    <span x-text="fmt(it.repost_count)"></span>
                  </button>

                  {# No word under these two. The three above carry a number, and
                     a rail that reads 8 · 3 · 2 · Share · Save mixes two kinds of
                     label in one column — the eye reads "Share" as a count that
                     failed to load. Both are named to a screen reader. #}
                  <button type="button" class="pf__r" @click.stop="shareIt(it)" aria-label="Share this post">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M22 2 11 13"/><path d="M22 2l-7 20-4-9-9-4z"/></svg>
                  </button>

                  <button type="button" class="pf__r pf__r--save" :aria-pressed="it.saved ? 'true' : 'false'"
                          @click.stop="save(it)"
                          :aria-label="(it.saved ? 'Remove this post from' : 'Save this post to') + ' your saved posts'">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 3h12a1 1 0 0 1 1 1v17l-7-4.4L5 21V4a1 1 0 0 1 1-1Z"/></svg>
                  </button>
                </div>
              </div>

              {# ── who reacted, and how ── #}
              <div class="pf__sum" x-show="it.cheer_count > 0 || it.repost_count > 0" x-cloak>
                <span class="pf__pips" aria-hidden="true">
                  <template x-for="k in topKinds(it)" :key="k">
                    <span class="pf__pip" x-html="glyph(k, true)"></span>
                  </template>
                </span>
                <span class="pf__sumtx" x-show="it.cheer_count > 0" x-text="reactionLine(it)"></span>
                <span class="pf__reposted" x-show="it.repost_count > 0"
                      x-text="it.repost_count + (it.repost_count === 1 ? ' repost' : ' reposts')"></span>
              </div>

              <div class="pf__cm" x-show="it.open || it.comments.length > 0" x-cloak>
                {# `it.comments` is guaranteed an array by hydrate(), so no `|| []`
                   guard is needed — and leaving one in would build a fresh array on
                   every evaluation, which keyed x-for has to diff against itself. #}
                <template x-for="c in it.comments" :key="c.id">
                  <p class="pf__cmrow"><b x-text="c.author_name"></b><span x-html="rich(c.body)"></span></p>
                </template>

                <a class="pf__cmall" :href="'/community/' + it.slug"
                   x-show="it.reply_count > it.comments.length"
                   x-text="'View all ' + it.reply_count + ' comments'"></a>

                {# x-show, NOT x-if.
                   An x-if nested inside this outer x-for threw "u is not a function"
                   out of Alpine the moment the outer list was mutated — open a card's
                   comments, scroll to load page 2, and the whole feed stopped
                   responding. x-show has no teardown to get wrong, and `signedIn`
                   cannot change without a page load, so there is nothing here that
                   justified conditional DOM in the first place. #}
                <div x-show="signedIn">
                  <div class="pf__cmform">
                    <label class="sr-only" :for="'pfc' + it.id">Add a comment</label>
                    <textarea class="pf__cmta" :id="'pfc' + it.id" rows="1" x-model="it.draft"
                              placeholder="Add a comment…" maxlength="2000"
                              @keydown.enter.meta.prevent="sendComment(it)"
                              @keydown.enter.ctrl.prevent="sendComment(it)"></textarea>
                    <button type="button" class="pf__cmgo" @click="sendComment(it)"
                            :disabled="!it.draft.trim() || it.posting">Post</button>
                  </div>
                  {# The moderation verdict is shown as it really is. Rendering a
                     quarantined comment as live would tell the author their words
                     are public before a moderator has seen them. #}
                  <p class="pf__note" x-show="it.held" x-cloak>Sent — a moderator will review it before it appears.</p>
                </div>
                <p class="pf__guest" x-show="!signedIn"><a :href="signInUrl">Sign in</a> to cheer and comment.</p>
              </div>

              {# A result announcement's home is the award's own page — the whole
                 standing, both halves of every index, the denominator each share was
                 measured against. Its thread page would show the reader the same
                 summary they just read here, with the working further away. Resolved
                 in PulseFeedService so the feed and the API agree; null for every
                 ordinary post, which falls back to its thread. #}
              <a class="pf__open" :href="it.link || ('/community/' + it.slug)"
                 x-text="it.link ? 'See the full standing →' : 'Open thread →'">Open thread →</a>
            </article>
          </template>

          <div class="pf-more" x-show="!!cursor && !loading" x-cloak>
            {# The sentinel below auto-loads; this stays because auto-load alone
               strands anyone on a keyboard and anyone whose IntersectionObserver
               never fires because the feed is shorter than the viewport. #}
            <button type="button" @click="loadMore()">Load more posts</button>
          </div>
          <div class="pf-more" x-show="loading" x-cloak><span class="pf-end">Loading…</span></div>
          <div class="pf-end" x-show="!cursor && items.length > 0" x-cloak>You are all caught up.</div>

          {# ── AN EMPTY REELS IS THE LIKELY STATE, NOT THE EDGE CASE ────────
             Video is held for review and never machine-inspected on this host, so
             a video-only feed can genuinely have nothing in it for a while. A
             black screen with no explanation would read as broken, and the tab is
             advertised in the main navigation — people will arrive.

             So it says what Reels is and offers the way out, rather than
             apologising. Only shown once the fetch has settled: during loading it
             would flash "nothing here" at somebody whose posts are on the way. #}
          <div class="pl-empty" x-show="media === 'video' && !loading && items.length === 0" x-cloak>
            No reels yet. Reels are the video posts from this community —
            {% if is_member %}record one and post it with the button above,{% else %}
            <a href="{{ '/account/login'|e }}">sign in</a> to post one,{% endif %}
            or <button type="button" class="pl-linkish" @click="tab='foryou'">see everything on the feed</button>.
          </div>
          <div class="pl-empty" x-show="media === '' && !loading && items.length === 0" x-cloak>
            Nothing here yet. Follow the cycle as nominations open — or read the latest on the
            <a href="/blog">journal</a>.
          </div>

          <div x-ref="sentinel" aria-hidden="true"></div>

          <div class="pf-toast" x-show="!!toast.msg" x-cloak role="status">
            <span x-text="toast.msg"></span>
            <a x-show="!!toast.href" :href="toast.href">Sign in →</a>
          </div>

          {# ── THE REPOST SHEET ───────────────────────────────────────────
             Asks for the line before it sends, and never insists on one:
             sometimes passing something along IS the whole remark. #}
          <div class="pf-sheet" x-show="!!sheet.it" x-cloak @click.self="closeSheet()"
               @keydown.escape.window="closeSheet()" role="dialog" aria-modal="true"
               aria-labelledby="pfSheetK">
            <div class="pf-sheet__c">
              <p class="pf-sheet__k" id="pfSheetK">Repost</p>
              <p class="pf-sheet__q">Passing on <b x-text="sheet.it ? sheet.it.author_name : ''"></b>’s post.
                Add a line of your own — or send it as it is.</p>
              <label class="sr-only" for="pfRepostBody">Your line</label>
              <textarea class="pf-sheet__ta" id="pfRepostBody" x-ref="repostBody" x-model="sheet.comment"
                        maxlength="500" placeholder="Why this is worth reading…"></textarea>
              <div class="pf-sheet__row">
                <span class="pl-compose__count" x-show="sheet.comment.length > 380"
                      x-text="(500 - sheet.comment.length) + ' left'"></span>
                <button type="button" class="pf-sheet__x" @click="closeSheet()">Cancel</button>
                <button type="button" class="pf__cmgo" @click="sendRepost()">Repost</button>
              </div>
            </div>
          </div>
        </div>

        {% if feed|default([]) is not empty %}
        <noscript>
          <ul>
            {% for t in feed %}
            <li><a href="/community/{{ t.slug }}">{{ t.author_name }}: {{ t.title }}</a></li>
            {% endfor %}
          </ul>
        </noscript>
        {% endif %}

        {% if posts is not empty %}
          {% for post in posts %}
          {% set cover = post.cover_image|default(post.cover_path|default(post.hero_image|default(''))) %}
          <article class="pl-post">
            <div class="pl-post__hd">
              <span class="pl-post__av">{{ post.author_name|default('Africa GATES')|first|upper }}</span>
              <div><div class="pl-post__au">{{ post.author_name|default('Africa GATES') }}</div><div class="pl-post__mt">{% if post.published_at %}{{ post.published_at|date('M j, Y') }}{% endif %}</div></div>
            </div>
            {% if cover %}<a href="/blog/{{ post.slug }}" class="pl-post__cover" style="background-image:url('{{ cover }}')" aria-label="{{ post.title }}"></a>{% endif %}
            <div class="pl-post__bd">
              {% if post.category is defined and post.category %}<div class="pl-post__cat">{{ post.category }}</div>{% endif %}
              <a class="pl-post__t" href="/blog/{{ post.slug }}">{{ post.title }}</a>
              <p class="pl-post__x">{{ post.excerpt|default(post.body|default('')|striptags)|slice(0,160) }}{% if (post.excerpt|default(post.body|default('')|striptags))|length > 160 %}…{% endif %}</p>
              <a class="pl-post__a" href="/blog/{{ post.slug }}">Read more
                <svg aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 20 20" fill="none"><path d="M7.5 4.5 13 10 7.5 15.5" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
            </div>
          </article>
          {% endfor %}
        {% elseif feed|default([]) is empty %}
          {# Only truly empty when there are no member posts either — otherwise this
             told a member who had just posted that the feed had not started yet. #}
          <div class="pl-empty">The feed is just getting started. Follow the cycle as nominations open — or read the latest on the <a href="/blog">journal</a>.</div>
        {% endif %}
      </div>

      <aside class="pl-rail">
        <div class="pl-card">
          <p class="pl-card__k">Leading the index</p>
          {% if leaders is not empty %}
            {% for p in leaders|slice(0,4) %}
            <a class="pl-lead" href="/registry/{{ p.slug }}">
              <span class="pl-lead__r">{{ loop.index }}</span>
              <span class="pl-lead__av" {% if p.avatar_path %}style="background-image:url('{{ p.avatar_path }}')"{% endif %}>{% if not p.avatar_path %}{{ p.display_name|default('?')|first|upper }}{% endif %}</span>
              <span class="pl-lead__n">{{ p.display_name }}</span>
              <span class="pl-lead__c">{{ p.cpi_score|default(0)|number_format }}</span>
            </a>
            {% endfor %}
          {% else %}
            <p style="margin:0;font-size:13px;color:#5a6d6f">Rankings appear once the first cycle is scored.</p>
          {% endif %}
        </div>
        <div class="pl-dark">
          <div class="pl-dark__orb" aria-hidden="true"></div>
          <p class="pl-dark__k">Your vote moves the index</p>
          <div class="pl-dark__t">One verified vote per category</div>
          <p class="pl-dark__p">Cross-checked, fraud-scored, recomputed every six hours.</p>
          <a class="pl-dark__btn" href="/vote">Cast a vote</a>
        </div>
        <div class="pl-card">
          <p class="pl-card__k">Join the conversation</p>
          <p style="margin:0 0 14px;font-size:13.5px;line-height:1.5;color:#4a5256">Programme channels where the community gathers between cycles — OTP-verified, moderated.</p>
          <a class="pl-post__a" href="/community" style="margin-top:0">Open the community
            <svg aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 20 20" fill="none"><path d="M7.5 4.5 13 10 7.5 15.5" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        </div>
      </aside>
    </div>
  </div>

  {# ── EVENTS ── #}
  <div x-show="tab==='events'" x-cloak>
    {% if events is not empty %}
    <div class="pl-evs">
      {% for e in events %}
      <a class="pl-ev" href="/events">
        <span class="pl-ev__d"><span class="pl-ev__mon">{{ e.event_date|date('M') }}</span><span class="pl-ev__day">{{ e.event_date|date('d') }}</span></span>
        <div style="flex:1;min-width:0">
          <div class="pl-ev__t">{{ e.title }}</div>
          <div class="pl-ev__m">{{ e.event_date|date('D, j M · g:i a') }}{% if e.location %} · {{ e.location }}{% endif %}</div>
        </div>
        <span class="pl-ev__cta">Details →</span>
      </a>
      {% endfor %}
    </div>
    {% else %}
    <div class="pl-empty">No upcoming events are scheduled right now. The calendar fills as the cycle progresses — check <a href="/events">events</a> for the latest.</div>
    {% endif %}
  </div>

  {# ── ALERTS ──────────────────────────────────────────────────────────────
     Derived on read from the tables that already record the events, so an
     alert cannot outlive the thing it is about and there is no backfill for
     the posts that already exist. See AfricaGates\Services\AlertService. #}
  {% if is_member %}
  <div x-show="tab==='alerts'" x-cloak>
    <div class="pl-alerts">
      <div class="pl-alerts__hd">
        <h2 class="pl-alerts__h">Alerts</h2>
        <button type="button" class="pl-alerts__read" @click="markRead()"
                x-show="unread > 0">Mark all read</button>
      </div>

      <div x-show="alertsLoading" class="pf-end">Loading…</div>

      <template x-for="(a, i) in alerts" :key="i">
        <a class="pl-alert" :class="a.unread && 'is-new'" :href="a.href">
          <span class="pl-alert__i" aria-hidden="true" x-html="alertIcon(a.kind)"></span>
          <span class="pl-alert__b">
            <span class="pl-alert__t" x-text="a.text"></span>
            <span class="pl-alert__m" x-text="ago(a.at)"></span>
          </span>
          <span class="pl-alert__n" x-show="a.unread" aria-label="Unread"></span>
        </a>
      </template>

      <div class="pl-empty" x-show="!alertsLoading && alerts.length === 0">
        Nothing yet. When somebody reacts to a post of yours, replies, reposts it
        or follows you, it lands here.
      </div>
    </div>
  </div>
  {% endif %}

  {# ── COMMUNITY ── #}
  <div x-show="tab==='community'" x-cloak>
    {% if threads is not empty %}
    <div class="pl-chs">
      {% for t in threads %}
      <a class="pl-ch" href="/community/{{ t.slug }}">
        <div class="pl-ch__t">{{ t.title }}</div>
        <p class="pl-ch__x">{{ t.body|default('')|striptags|slice(0,120) }}{% if (t.body|default('')|striptags)|length > 120 %}…{% endif %}</p>
        <div class="pl-ch__m">{% if t.created_at %}{{ t.created_at|date('M j, Y') }} · {% endif %}Open thread →</div>
      </a>
      {% endfor %}
    </div>
    <div style="margin-top:18px"><a class="pl-post__a" href="/community">See all community channels
      <svg aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 20 20" fill="none"><path d="M7.5 4.5 13 10 7.5 15.5" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg></a></div>
    {% else %}
    <div class="pl-empty">The community channels are open — be the first to start a thread in the <a href="/community">community</a>.</div>
    {% endif %}
  </div>

</div>

<script nonce="{{ csp_nonce }}">
/**
 * The composer's attachment.
 *
 * Everything here is a COURTESY, not a control: the browser can be told to
 * refuse a 40MB file, and it will, but nothing stops a hand-made POST. The size
 * and type rules that matter are the ones in PulseMediaService, which reads the
 * bytes. This exists so the common case fails in half a second against a local
 * check instead of after a two-minute upload on a phone connection.
 */
function plCompose(max, limitLabel){
  return {
    max: max, n: 0, busy: false, open: false,
    preview: '', kind: '', err: '', sizeNote: '',

    /** Open the real composer and put the caret in it, in that order. */
    expand(){
      this.open = true;
      this.$nextTick(() => { if (this.$refs.ta) this.$refs.ta.focus(); });
    },


    // ── the studio ────────────────────────────────────────────────────────
    // Culturally named rather than "Filter 1..6" — these are the design's, and
    // a name you recognise is a name you can ask for again.
    FILTERS: {
      Original:  'none',
      Harmattan: 'sepia(.28) saturate(1.2) contrast(1.05)',
      Indigo:    'saturate(1.15) hue-rotate(-12deg) contrast(1.1)',
      Ochre:     'sepia(.5) saturate(1.35) brightness(1.04)',
      Ink:       'grayscale(1) contrast(1.15)',
      Sunset:    'saturate(1.4) contrast(1.08) brightness(1.05)'
    },
    CROPS: ['free', 'square', 'portrait', 'wide'],
    CROP_LABEL: { free:'As shot', square:'1:1', portrait:'4:5', wide:'16:9' },
    RATIOS: { square:'1/1', portrait:'4/5', wide:'16/9' },
    crop: 'free', filter: 'Original', focus: 50,
    _file: null,

    /** The longest edge we upload. Beyond this is detail no feed ever shows. */
    MAX_EDGE: 1600,

    // Parsed from the server's own limit string so the two cannot disagree.
    get limitBytes(){ return (parseFloat(limitLabel) || 8) * 1048576; },

    /** CSS does the preview: instant, and no canvas work until submit. */
    previewStyle(){
      var f = this.FILTERS[this.filter] || 'none';
      var s = 'filter:' + f + ';';
      if (this.crop !== 'free'){
        s += 'width:100%;height:100%;max-height:none;object-fit:cover;'
           + 'object-position:50% ' + this.focus + '%;';
      }
      return s;
    },

    pick(e){
      var f = e.target.files && e.target.files[0];
      this.clearPreview();
      this.err = ''; this.sizeNote = '';
      this.crop = 'free'; this.filter = 'Original'; this.focus = 50;
      this._file = f || null;
      if (!f) return;

      var isImg = /^image\//.test(f.type), isVid = /^video\//.test(f.type);
      if (!isImg && !isVid){
        this.err = 'Attach a photo or a video.';
        return this.clear();
      }
      if (f.size > this.limitBytes){
        this.err = 'That file is ' + (f.size / 1048576).toFixed(1) + 'MB — the limit here is ' + limitLabel + '.';
        return this.clear();
      }
      this.kind = isImg ? 'image' : 'video';
      // Stated, not estimated. Promising "this will be 0.3MB" before the
      // encoder has run is a number we would sometimes be wrong about.
      if (isImg && f.size > 900000){
        this.sizeNote = '<b>' + (f.size / 1048576).toFixed(1) + 'MB</b> — '
          + 'resized before it uploads, so it sends faster on mobile data.';
      }
      // An object URL previews the actual bytes rather than a guess from the
      // filename, and costs no upload. Revoked in clearPreview so a member who
      // swaps files ten times does not leak ten blobs.
      this.preview = URL.createObjectURL(f);
    },

    clearPreview(){
      if (this.preview) { try { URL.revokeObjectURL(this.preview); } catch(e){} }
      this.preview = ''; this.kind = '';
    },

    clear(){
      this.clearPreview();
      this._file = null; this.sizeNote = '';
      if (this.$refs.file) this.$refs.file.value = '';
    },

    /**
     * Bake the crop, the filter and the downscale into the bytes, then post.
     *
     * ── WHY THIS IS DONE HERE AND NOT ON THE SERVER ──────────────────────────
     *
     * Because the win is the UPLOAD, not the pixels. A 6MB camera JPEG over a
     * Nigerian mobile connection is a minute of progress bar and a real chance
     * of the tab being backgrounded before it finishes; the same photo at 1600px
     * and q0.82 is a few hundred kilobytes. Doing it on the server saves the
     * disk and none of the waiting, which is the part that makes people give up.
     *
     * EVERY FAILURE PATH POSTS THE ORIGINAL. No canvas, no DataTransfer, a
     * tainted context, an image that will not decode — all of them fall through
     * to the file the browser already has. A studio that can lose somebody's
     * photo is worse than no studio.
     */
    render(ev){
      if (this.busy) { ev.preventDefault(); return; }        // already working
      if (this.kind !== 'image' || !this._file) return;      // text or video: nothing to do

      // Nothing to bake and nothing to save — let the plain POST through.
      var edited = this.crop !== 'free' || this.filter !== 'Original';
      if (!edited && this._file.size <= 900000) return;

      if (typeof DataTransfer === 'undefined' || !document.createElement('canvas').getContext) return;

      ev.preventDefault();
      this.busy = true;
      var form = ev.target, self = this;

      var img = new Image();
      img.onload = function(){
        try {
          var sw = img.naturalWidth, sh = img.naturalHeight;
          var sx = 0, sy = 0, cw = sw, ch = sh;

          // Centre-cover crop to the chosen ratio, offset vertically by focus.
          if (self.crop !== 'free'){
            var r = { square: 1, portrait: 4 / 5, wide: 16 / 9 }[self.crop];
            if (sw / sh > r) { cw = Math.round(sh * r); sx = Math.round((sw - cw) / 2); }
            else             { ch = Math.round(sw / r); sy = Math.round((sh - ch) * (self.focus / 100)); }
          }

          var scale = Math.min(1, self.MAX_EDGE / Math.max(cw, ch));
          var dw = Math.max(1, Math.round(cw * scale)), dh = Math.max(1, Math.round(ch * scale));

          var c = document.createElement('canvas');
          c.width = dw; c.height = dh;
          var ctx = c.getContext('2d');
          // A transparent PNG flattened onto nothing becomes black; JPEG has no
          // alpha, so the background is chosen here rather than by the encoder.
          ctx.fillStyle = '#ffffff'; ctx.fillRect(0, 0, dw, dh);
          var f = self.FILTERS[self.filter];
          if (f && f !== 'none' && 'filter' in ctx) ctx.filter = f;
          ctx.drawImage(img, sx, sy, cw, ch, 0, 0, dw, dh);

          c.toBlob(function(blob){
            if (!blob || blob.size >= self._file.size && !edited) return self.submitOriginal(form);
            try {
              var name = (self._file.name || 'photo').replace(/\.[^.]+$/, '') + '.jpg';
              var dt = new DataTransfer();
              dt.items.add(new File([blob], name, { type: 'image/jpeg' }));
              self.$refs.file.files = dt.files;
            } catch (e) { return self.submitOriginal(form); }
            form.submit();
          }, 'image/jpeg', 0.82);
        } catch (e) {
          self.submitOriginal(form);
        }
      };
      img.onerror = function(){ self.submitOriginal(form); };
      img.src = this.preview;
    },

    /**
     * The fallback every failure path takes: post exactly what was chosen.
     *
     * The input still holds the original — nothing is written to it until the
     * blob is in hand — so this is just "give up and send what we had."
     */
    submitOriginal(form){ form.submit(); }
  };
}

/**
 * The feed.
 *
 * Everything that talks to the server goes through window.agSocial, which the
 * community thread page uses too — so a like behaves identically wherever you
 * press it, and there is one optimistic rollback to keep correct rather than two.
 */
/**
 * The four reactions, drawn once.
 *
 * Kept as path data rather than four <template>s because the rail has to swap
 * the glyph on the SAME button when a reaction changes — four hidden SVGs with
 * x-show would each need their own held/not-held rule, and the button's fill
 * would stop matching the shape the moment a fifth reaction is added.
 */
var PF_ICON = {
  cheer:   '<path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8Z"/>',
  insight: '<path d="M12 2.2l2.3 6.4 6.5 2.3-6.5 2.3L12 19.8l-2.3-6.6L3.2 10.9l6.5-2.3z"/>',
  respect: '<path d="M12 2.4l7.6 2.7v5.8c0 4.7-3.1 8.3-7.6 10-4.5-1.7-7.6-5.3-7.6-10V5.1z"/>',
  support: '<path d="M12 3.2 19 11h-4v6.5a1 1 0 0 1-1 1h-4a1 1 0 0 1-1-1V11H5z"/>'
};
var PF_TINT = { cheer:'#E0245E', insight:'#F2C230', respect:'#7FC87C', support:'#5AB6D9' };

/**
 * The verification badge, at the level that was actually checked.
 *
 * gates_profiles.verification_tier has carried four states all along and the
 * feed was rendering a binary tick, which is the worst of both: it overstates
 * `basic` and understates `premium`. Colour does the work — one shield shape,
 * three fills — so the levels are told apart at 15px without a legend.
 */
var PF_BADGE = {
  basic:   '#8FB3B5',   // ID checked
  verified:'#7FC87C',   // verified nominee
  premium: '#C9A24B',   // official
};

/**
 * The page shell: which tab is showing, and the alerts.
 *
 * Alerts live here rather than in plFeed because the unread count is rendered
 * on a TAB and the list in a PANEL — two places on screen, one piece of state.
 * Putting it in the feed component would mean the tab reaching into a sibling.
 */
function plPage(isMember){
  return {
    tab: 'foryou',
    isMember: !!isMember,
    alerts: [], unread: 0, alertsLoading: false, _loaded: false, _poll: null,

    init(){
      /*
       * DEEP LINK TO A TAB.
       *
       * /pulse/reels and /pulse?tab=reels both have to land on Reels, because the
       * main navigation, the home page and the status page all advertise Reels as
       * a place — and a link that lands on the general feed instead makes the
       * promise look broken rather than the link.
       *
       * Set BEFORE the feed component initialises, so its first fetch is already
       * filtered and nothing flashes the unfiltered list.
       */
      var q = new URLSearchParams(window.location.search).get('tab') || '';
      var path = window.location.pathname.replace(/\/+$/, '');
      var want = path.endsWith('/reels') ? 'reels' : q;
      if (['foryou', 'reels', 'events', 'community'].indexOf(want) !== -1) this.tab = want;
      if (want === 'alerts' && this.isMember) this.tab = 'alerts';

      if (!this.isMember) return;
      this.count();
      // Every 90s, and never while the tab is hidden. A notification count is
      // the classic thing left polling in a forgotten tab for an hour.
      this._poll = setInterval(() => { if (!document.hidden) this.count(); }, 90000);

      // Deep link: /pulse#alerts, which is where the alert emails will point.
      if (location.hash === '#alerts') this.open();
      this.$watch('tab', (t) => { if (t === 'alerts') this.open(); });
    },

    ago(t){ return window.agSocial.timeAgo(t); },

    count(){
      fetch('/api/v1/pulse/alerts/count', { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
        .then(r => r.json())
        .then(d => { if (d && d.success) this.unread = d.unread | 0; })
        .catch(() => {});
    },

    open(){
      this.tab = 'alerts';
      // Fetched once per page load. Re-fetching on every tab switch would make
      // the list flicker for a screen whose contents change by the hour.
      if (this._loaded || this.alertsLoading) return;
      this.alertsLoading = true;
      fetch('/api/v1/pulse/alerts', { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
        .then(r => r.json())
        .then(d => {
          if (!d || !d.success) throw 0;
          this.alerts = d.items || [];
          this.unread = d.unread | 0;
          this._loaded = true;
        })
        .catch(() => {})
        .finally(() => { this.alertsLoading = false; });
    },

    markRead(){
      // Optimistic, and deliberately does NOT re-fetch: the rows stay where
      // they are and simply stop being highlighted. A list that reorders itself
      // under your thumb the moment you press "mark all read" loses your place.
      this.alerts = this.alerts.map(a => Object.assign({}, a, { unread: false }));
      this.unread = 0;
      fetch('/api/v1/pulse/alerts/read', {
        method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' }
      }).catch(() => {});
    },

    /** One glyph per kind, tinted like the reaction it refers to. */
    alertIcon(kind){
      var d = {
        reaction:  ['#E0245E', PF_ICON.cheer],
        reply:     ['#5AB6D9', '<path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 9 9 0 0 1-3.6-.7L3 21l1.9-5A8.2 8.2 0 0 1 4 11.5 8.4 8.4 0 0 1 12.5 3 8.4 8.4 0 0 1 21 11.5Z" fill="none" stroke="#5AB6D9" stroke-width="1.8" stroke-linejoin="round"/>'],
        repost:    ['#7FC87C', '<path d="M17 2.5 20.5 6 17 9.5M20.5 6H7a3.5 3.5 0 0 0-3.5 3.5V11M7 21.5 3.5 18 7 14.5M3.5 18H17a3.5 3.5 0 0 0 3.5-3.5V13" fill="none" stroke="#7FC87C" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>'],
        save:      ['#10292C', '<path d="M6 3h12a1 1 0 0 1 1 1v17l-7-4.4L5 21V4a1 1 0 0 1 1-1Z" fill="#10292C"/>'],
        follow:    ['#237B22', '<path d="M12 12a4.5 4.5 0 1 0 0-9 4.5 4.5 0 0 0 0 9Zm-8 9a8 8 0 0 1 16 0Z" fill="#237B22"/>'],
        milestone: ['#C9A24B', PF_ICON.insight],
      }[kind];
      if (!d) return '';
      return '<svg viewBox="0 0 24 24" style="fill:' + d[0] + '" aria-hidden="true" focusable="false">'
             + d[1] + '</svg>';
    }
  };
}

function plFeed(cfg){
  return {
    items: cfg.items || [],
    cursor: cfg.cursor || null,
    head: cfg.head || 0,          // newest id on screen; the pill counts past it
    channels: cfg.channels || [],
    channel: 0,                   // 0 = every channel
    // '' = every kind of post; 'video' is the Reels tab. Set from config rather
    // than toggled, because a Reels feed and a Feed feed are two instances of this
    // component, not one instance that switches — sharing it would mean one scroll
    // position, one cursor and one "new posts" count across two tabs.
    media: cfg.media || '',
    signedIn: !!cfg.signedIn,
    loading: false,
    newCount: 0,
    toast: { msg: '', href: '' },
    sheet: { it: null, comment: '' },
    KINDS: ['cheer', 'insight', 'respect', 'support'],
    LABELS: { cheer:'Cheer', insight:'Insight', respect:'Respect', support:'Support' },
    TIERS: { basic:'ID verified', verified:'Verified nominee', premium:'Official' },
    _tt: null, _lastTap: {}, _io: null, _poll: null, _hold: null, _pickTimer: null,
    get signInUrl(){ return window.agSocial.signInUrl(); },

    init(){
      // Every item carries its own UI state. Alpine only tracks properties that
      // exist when it starts, so these are seeded here rather than on first use —
      // a property added later never becomes reactive and the card stops updating.
      this.items.forEach(this.hydrate, this);
      // Deep-linked channel: /pulse?channel=3 is what the chip on a card links
      // to, so arriving that way has to select the chip as well as filter.
      var q = new URLSearchParams(window.location.search);
      var c = parseInt(q.get('channel') || '0', 10);
      if (c > 0 && this.channels.some(function(x){ return x.id === c; })) this.setChannel(c);

      // ── REELS ────────────────────────────────────────────────────────────
      // `tab` lives on the parent component; Alpine resolves it up the scope
      // chain, so the feed can follow the tab without the tab having to know a
      // feed exists. Deep links (/pulse/reels and ?tab=reels) set the parent's
      // tab before this runs, so the first fetch is already filtered.
      this.$watch('tab', (v) => this.setMedia(v === 'reels' ? 'video' : ''));
      if (this.tab === 'reels' && this.media !== 'video') this.setMedia('video');

      this.watchSentinel();
      this.watchNew();
    },

    /**
     * Switch what kind of post the feed is showing.
     *
     * Same shape as setChannel(): clear the list, refetch from the top, restart
     * the sentinel. Losing scroll position on a tab switch is expected; silently
     * keeping photos from the previous tab in the list would not be.
     */
    setMedia(kind){
      kind = kind || '';
      if (this.media === kind) return;
      this.media   = kind;
      this.loading = true;
      this.items   = [];
      this.newCount = 0;
      fetch(this._feedUrl(), { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
        .then(r => r.json())
        .then(d => {
          if (!d || !d.success) throw 0;
          this.items  = (d.items || []).map(this.hydrate, this);
          this.cursor = d.next_cursor || null;
          // `head` drives the new-posts pill. Left pointing at a post from the
          // other tab it would count everything published since, on a feed that
          // will not show most of it.
          this.head   = this.items.length ? this.items[0].id : 0;
          if (this.cursor && !this._io) this.watchSentinel();
        })
        .catch(() => this.flash('Could not load that.'))
        .finally(() => { this.loading = false; });
    },

    hydrate(it){
      it.burst = false; it.open = false; it.draft = ''; it.posting = false; it.held = false;
      it.pick = false; it.expanded = false;
      it.comments = it.comments || [];
      // The server sends these; a very old cached page or a partly-migrated
      // database might not, and an undefined breakdown makes the rail render
      // "undefined" instead of a count.
      it.reactions = it.reactions || {};
      it.my_reaction = it.my_reaction || null;
      it.repost_count = it.repost_count | 0;
      it.reposted = !!it.reposted;
      return it;
    },

    // ── display helpers ────────────────────────────────────────────────────
    initial(n){ return (n || '?').trim().charAt(0).toUpperCase(); },
    ago(t){ return window.agSocial.timeAgo(t); },
    rich(t){ return window.agSocial.linkify(t || ''); },

    /** A count small enough to sit under a 29px glyph. */
    fmt(n){
      n = n | 0;
      if (!n) return '';
      if (n < 1000) return String(n);
      if (n < 100000) return (n / 1000).toFixed(n < 10000 ? 1 : 0).replace('.0', '') + 'k';
      return Math.round(n / 1000) + 'k';
    },

    /**
     * One reaction glyph as markup. `tint` colours it inline, for the pips on
     * white paper; the rail leaves it uncoloured and lets the data-held CSS
     * rule decide, so an unheld reaction stays white on the picture.
     */
    glyph(kind, tint){
      var d = PF_ICON[kind] || PF_ICON.cheer;
      var s = tint ? (' style="fill:' + PF_TINT[kind] + ';stroke:' + PF_TINT[kind] + '"') : '';
      return '<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"' + s + '>' + d + '</svg>';
    },

    /** The verification shield, or nothing at all for an unverified author. */
    badge(tier){
      var fill = PF_BADGE[tier];
      if (!fill) return '';
      return '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">'
        + '<path d="M12 1.9l8.1 2.9v6.5c0 5.2-3.3 9.2-8.1 11.2-4.8-2-8.1-6-8.1-11.2V4.8z" fill="' + fill + '"/>'
        + '<path d="M8.7 12.1l2.3 2.3 4.3-4.7" stroke="#0B1A1B" stroke-width="2.4" '
        + 'stroke-linecap="round" stroke-linejoin="round"/></svg>';
    },

    /** The kinds actually present on a post, busiest first, capped at three pips. */
    topKinds(it){
      var bd = it.reactions || {};
      return Object.keys(bd).filter(function(k){ return bd[k] > 0; })
        .sort(function(a, b){ return bd[b] - bd[a]; }).slice(0, 3);
    },

    reactionLine(it){
      var n = it.cheer_count | 0;
      return n + (n === 1 ? ' reaction' : ' reactions');
    },

    flash(msg, href){
      this.toast = { msg: msg, href: href || '' };
      clearTimeout(this._tt);
      this._tt = setTimeout(() => { this.toast = { msg: '', href: '' }; }, 5000);
    },

    askSignIn(){ this.flash('Sign in to join in', this.signInUrl); },
    hooks(){
      return { onSignIn: () => this.askSignIn(), onError: (m) => this.flash(m) };
    },

    // ── reactions ──────────────────────────────────────────────────────────
    /**
     * Set, change or clear a reaction.
     *
     * agSocial owns the optimistic move and the rollback; it mutates a plain
     * state object. Alpine cannot see that object, so the item is synced from it
     * twice: once now (the optimistic change, which has already happened by the
     * time react() returns) and once when the server answers or it rolls back.
     */
    react(it, kind){
      if (it.busy) return;
      it.pick = false;
      var st = { kind: it.my_reaction, n: it.cheer_count, breakdown: it.reactions || {}, busy: false };
      var sync = () => {
        it.my_reaction = st.kind;
        it.cheered     = !!st.kind;         // every caller that only wants the boolean
        it.cheer_count = st.n;
        it.reactions   = st.breakdown;
      };

      var p = window.agSocial.react('thread', it.id, kind, st, Object.assign(this.hooks(), {
        onReacted: () => this.burst(it)
      }));
      it.busy = true;
      sync();
      p.finally(() => { sync(); it.busy = false; });
    },

    /**
     * Press-and-hold opens the four.
     *
     * 420ms, not 250: a scroll on a phone starts with a finger down, and a
     * shorter threshold pops the picker open every time somebody flicks the feed.
     */
    holdStart(it){
      clearTimeout(this._hold);
      this._hold = setTimeout(() => { it.pick = true; }, 420);
    },
    holdEnd(){ clearTimeout(this._hold); },

    /**
     * Hover opens it too, on anything with a pointer. Delayed on the way in so
     * the picker does not flash open while the cursor crosses the rail on its
     * way somewhere else, and delayed on the way out so there is time to reach it.
     */
    hoverPick(it, on){
      if (!window.matchMedia || !window.matchMedia('(hover:hover)').matches) return;
      clearTimeout(this._pickTimer);
      this._pickTimer = setTimeout(() => { it.pick = on; }, on ? 260 : 180);
    },

    burst(it){
      it.burst = false;
      // Force a frame between off and on, or re-liking the same post in one
      // session re-adds a class that is already there and the animation never
      // restarts — the second like looks like nothing happened.
      requestAnimationFrame(() => { requestAnimationFrame(() => { it.burst = true; }); });
      setTimeout(() => { it.burst = false; }, 1000);
    },

    /**
     * Double tap to cheer — never to un-cheer.
     *
     * The gesture only ever ADDS a reaction: a stray second double-tap must not
     * silently take one away, because the gesture is imprecise and the result is
     * invisible if you have already scrolled past. Somebody holding `insight`
     * gets a burst and keeps their insight — the tap does not demote it to a
     * cheer, which would be the gesture quietly overwriting a deliberate choice.
     */
    tap(it, e){
      if (e.target.closest('a, button, video')) return;   // links navigate, controls work
      var now = Date.now(), last = this._lastTap[it.id] || 0;
      this._lastTap[it.id] = now;
      if (now - last > 320) return;
      this._lastTap[it.id] = 0;
      if (it.my_reaction) { this.burst(it); return; }
      this.react(it, 'cheer');
    },

    /**
     * Open the full thread — where a long post is readable in full.
     *
     * `location.assign`, not an assignment to `location`'s href property:
     * SiteLinkIntegrityTest scans templates for that attribute followed by a
     * quoted path and cannot tell an HTML attribute from a JS assignment, so it
     * reports the bare prefix as a dead link. The scanner is right to be blunt
     * about the pattern; this is the call that says "navigate" without looking
     * like markup.
     */
    open(it){ window.location.assign('/community/' + it.slug); },

    // ── repost ─────────────────────────────────────────────────────────────
    /**
     * Reposting asks for a line; un-reposting does not.
     *
     * Putting a sheet in front of an undo would be asking somebody to justify
     * taking something back, and the button already says what it does.
     */
    repost(it){
      if (!this.signedIn) return this.askSignIn();
      if (it.reposted) return this.sendRepost(it, '');
      this.sheet = { it: it, comment: '' };
      this.$nextTick(() => { if (this.$refs.repostBody) this.$refs.repostBody.focus(); });
    },

    closeSheet(){ this.sheet = { it: null, comment: '' }; },

    sendRepost(item, comment){
      var it = item || this.sheet.it;
      if (!it) return;
      var body = comment !== undefined ? comment : this.sheet.comment;
      var st = { on: it.reposted, n: it.repost_count, busy: false };

      var p = window.agSocial.toggle('/repost', { thread_id: it.id, comment: body },
                                     st, 'reposted', this.hooks());
      it.reposted = st.on;                                 // already flipped by toggle()
      this.closeSheet();
      p.then((ok) => {
        it.reposted = st.on;                               // server's answer, or the rollback
        it.repost_count = st.n;
        if (ok) this.flash(st.on ? 'Reposted to your feed' : 'Repost removed');
      });
    },

    // ── channels ───────────────────────────────────────────────────────────
    /**
     * Filtering is a SERVER query, not a client-side filter of what is loaded.
     * Filtering the eight posts already on screen shows "Education (12)" as
     * three posts, and scrolling for more re-runs the unfiltered query — so the
     * channel quietly leaks the other channels back in as you read.
     */
    /*
     * ONE PLACE THAT KNOWS WHAT THE FEED IS CURRENTLY SHOWING.
     *
     * Four call sites used to hand-assemble this query string. That survived one
     * filter; it would not survive two. The failure is specific and quiet: a
     * page-two fetch that forgets `media` returns photos into Reels, so the tab the
     * reader chose stops meaning anything halfway down the scroll. The service warns
     * about precisely this for channels — the answer is to make it impossible to
     * forget rather than to remember in four places.
     */
    _feedUrl(extra){
      var p = new URLSearchParams(extra || {});
      if (this.channel) p.set('channel', this.channel);
      if (this.media)   p.set('media', this.media);
      var s = p.toString();
      return '/api/v1/pulse/feed' + (s ? '?' + s : '');
    },

    setChannel(id){
      if (this.channel === id) return;
      this.channel = id | 0;
      this.loading = true;
      this.items = [];
      fetch(this._feedUrl(), { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
        .then(r => r.json())
        .then(d => {
          if (!d || !d.success) throw 0;
          this.items = (d.items || []).map(this.hydrate, this);
          this.cursor = d.next_cursor || null;
          // The sentinel was disconnected when the last channel ran out; a new
          // channel has its own pages, so it has to start watching again.
          if (this.cursor && !this._io) this.watchSentinel();
        })
        .catch(() => this.flash('Could not load that channel.'))
        .finally(() => { this.loading = false; });
    },

    save(it){
      var st = { on: it.saved, n: 0, busy: false };
      var p = window.agSocial.toggle('/bookmark', { thread_id: it.id }, st, 'bookmarked', this.hooks());
      it.saved = st.on;                                   // already flipped by toggle()
      p.then((ok) => {
        it.saved = st.on;                                 // server's answer, or the rollback
        if (ok) this.flash(st.on ? 'Saved' : 'Removed from saved');
      });
    },

    shareIt(it){
      window.agSocial.share('/community/' + it.slug, it.title, {
        onCopied: () => this.flash('Link copied'),
        onError: (m) => this.flash(m)
      });
    },

    report(it){
      if (!this.signedIn) return this.askSignIn();
      var reason = window.prompt('Report this post — what is wrong with it?');
      if (reason === null) return;
      window.agSocial.report('thread', it.id, reason).then((r) => {
        this.flash(r.ok ? 'Reported — a moderator will look at it.' : (r.message || 'Could not report that.'));
      });
    },

    // ── comments ───────────────────────────────────────────────────────────
    openComments(it){
      it.open = true;
      this.$nextTick(() => {
        var ta = document.getElementById('pfc' + it.id);
        if (ta) ta.focus();
      });
    },

    sendComment(it){
      var body = (it.draft || '').trim();
      if (!body || it.posting) return;
      it.posting = true; it.held = false;

      window.agSocial.comment({ targetType: 'thread', targetId: it.id, body: body })
        .then((r) => {
          it.posting = false;
          if (!r.ok){
            if (r.signIn) this.askSignIn(); else this.flash(r.message);
            return;
          }
          it.draft = '';
          if (r.status === 'quarantined'){
            // Held for review: NOT appended to the thread. Showing it would tell
            // the author their words are already public.
            it.held = true;
            if (window.agAnnounce) window.agAnnounce('Your comment is awaiting review');
            return;
          }
          it.comments.push({ id: r.id || Date.now(), author_name: cfg.memberName, body: body });
          it.reply_count = (it.reply_count | 0) + 1;
          if (window.agAnnounce) window.agAnnounce('Comment posted');
        });
    },

    // ── paging ─────────────────────────────────────────────────────────────
    loadMore(){
      if (this.loading || !this.cursor) return;
      this.loading = true;
      // The channel travels with the cursor. Without it page two arrives
      // unfiltered and the chip you pressed silently stops meaning anything.
      fetch(this._feedUrl({ cursor: this.cursor }), {
          headers: { 'X-Requested-With': 'XMLHttpRequest' } })
        .then(r => r.json())
        .then(d => {
          if (!d || !d.success) throw 0;
          (d.items || []).forEach((it) => { this.items.push(this.hydrate(it)); });
          this.cursor = d.next_cursor || null;
          if (!this.cursor) this.stopSentinel();
        })
        .catch(() => this.flash('Could not load more posts.'))
        .finally(() => { this.loading = false; });
    },

    watchSentinel(){
      if (!('IntersectionObserver' in window)) return;   // the Load more button remains
      this._io = new IntersectionObserver((es) => {
        if (!es.some(e => e.isIntersecting)) return;
        // Once the feed is exhausted the sentinel is permanently on screen, so
        // the observer would keep firing forever against a null cursor. Stop
        // watching instead of relying on loadMore's guard to absorb it.
        if (!this.cursor) { this.stopSentinel(); return; }
        this.loadMore();
      }, { rootMargin: '600px 0px' });                   // fetch before the reader arrives
      this.$nextTick(() => { if (this.$refs.sentinel) this._io.observe(this.$refs.sentinel); });
    },

    stopSentinel(){
      if (this._io) { this._io.disconnect(); this._io = null; }
    },

    /**
     * The "N new posts" pill.
     *
     * Polled every 45s. There is no websocket because the target host is shared
     * cPanel with no persistent process — pretending otherwise would just mean a
     * reconnect loop in production. Polling stops while the tab is hidden, so a
     * forgotten tab is not still asking an hour later.
     */
    watchNew(){
      var tick = () => {
        if (document.hidden || !this.head) return;
        // The SAME filters showNew() will refetch with. Counting unfiltered while
        // fetching filtered is how a pill offers "3 new posts" on Reels — where
        // nearly every new post is a photo — and then delivers none.
        var p = new URLSearchParams({ after: this.head });
        if (this.channel) p.set('channel', this.channel);
        if (this.media)   p.set('media', this.media);
        fetch('/api/v1/pulse/new?' + p.toString(), {
            headers: { 'X-Requested-With': 'XMLHttpRequest' } })
          .then(r => r.json())
          .then(d => { if (d && d.success) this.newCount = d.count | 0; })
          .catch(() => {});
      };
      this._poll = setInterval(tick, 45000);
      document.addEventListener('visibilitychange', () => { if (!document.hidden) tick(); });
    },

    showNew(){
      // Prepend rather than reload: a reader who is three screens down keeps
      // their place, which a full refresh would throw away.
      fetch(this._feedUrl(), { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
        .then(r => r.json())
        .then(d => {
          if (!d || !d.success) throw 0;
          var known = {}; this.items.forEach(i => { known[i.id] = 1; });
          var fresh = (d.items || []).filter(i => !known[i.id]).map(this.hydrate, this);
          this.items = fresh.concat(this.items);
          if (this.items.length) this.head = this.items[0].id;
          this.newCount = 0;
          window.scrollTo({ top: 0, behavior: 'smooth' });
        })
        .catch(() => this.flash('Could not refresh the feed.'));
    }
  };
}
</script>
{% endblock %}
