{% extends "layout/gates.twig" %}

{% block head_styles %}
<style nonce="{{ csp_nonce }}">
  /* ══════════════════════════════════════════════════════════════════════════
     A SUPPORT DESK, NOT A MARKETING PAGE

     Everyone who opens this has a problem, so the page is built around one
     question — what has gone wrong — and answers it with as little furniture as
     possible. Every colour is a token with a literal fallback, because a support
     page that fails to load its theme must still be legible.
     ══════════════════════════════════════════════════════════════════════════ */
  body[data-page="support"]{ background:#f4f6f5; }
  body[data-page="support"] [x-cloak]{ display:none !important; }

  .sa{ max-width:900px; margin:0 auto; padding:clamp(1.2rem,3.5vw,2rem) var(--ag-gutter,40px) 64px; }

  /* ── header ────────────────────────────────────────────────────────────── */
  .sa-top{ display:flex; align-items:flex-start; justify-content:space-between; gap:16px; flex-wrap:wrap; }
  .sa-eyebrow{ margin:0 0 6px; font:700 11.5px/1 var(--ag-font-mono,monospace); letter-spacing:.14em;
               text-transform:uppercase; color:var(--ag-green,#237b22); }
  /* Qualified: `.ag-scope h1` is (0,1,1) and beats any bare page class. */
  .sa .sa-h1{ margin:0; font-family:var(--ag-font-display); font-weight:700;
              font-size:clamp(1.55rem,3.4vw,2.1rem); line-height:1.1; color:var(--ag-ink,#10292c); }
  .sa-sub{ margin:8px 0 0; max-width:56ch; font-size:14.5px; line-height:1.6; color:#5a6d6f; }

  /* Live capability read-out. A support bot that states what it can see is one
     nobody has to guess at — and it makes "I cannot see your payment" read as a
     boundary rather than as a failure. */
  .sa-caps{ display:flex; flex-wrap:wrap; gap:6px; margin:14px 0 0; padding:0; list-style:none; }
  .sa-cap{ display:inline-flex; align-items:center; gap:6px; font:600 12px/1 inherit; color:#3d4c4e;
           background:#fff; border:1px solid rgba(16,41,44,.1); border-radius:999px; padding:6px 11px; }
  .sa-cap svg{ flex:none; }
  .sa-cap--off{ color:var(--ag-ink-soft,#626a6e); background:#f2f4f3; }

  .sa-note{ margin:14px 0 0; padding:11px 14px; border-radius:12px; font-size:13.5px; line-height:1.55;
            background:#fdf6e3; border:1px solid #efe0b5; color:#7a611a; }
  .sa-note a{ color:#7a611a; font-weight:700; }
  .sa-note--info{ background:#eef5fb; border-color:#cfe1f0; color:#28536b; }
  .sa-note--info a{ color:#28536b; }

  /* ── the console ───────────────────────────────────────────────────────── */
  .sa-box{ margin-top:18px; background:#fff; border:1px solid rgba(16,41,44,.09);
           border-radius:20px; display:flex; flex-direction:column; overflow:hidden;
           box-shadow:0 1px 2px rgba(16,41,44,.04), 0 8px 24px -18px rgba(16,41,44,.35); }

  /* The bar that makes this read as a DESK rather than a comment form. It also
     carries the one piece of state the reader needs before typing: whether the
     assistant is actually up. That used to be a separate amber slab above the
     console, which pushed the input below the fold on a phone to say something
     that belongs on the thing it is about. */
  .sa-head{ display:flex; align-items:center; gap:11px; padding:13px 18px;
            border-bottom:1px solid rgba(16,41,44,.08); background:#fbfcfb; }
  .sa-head__av{ flex:none; width:34px; height:34px; border-radius:50%; background:#10292C; color:#7FC87C;
                display:flex; align-items:center; justify-content:center; font-weight:800; font-size:14px; }
  .sa-head__n{ font-weight:700; font-size:14.5px; color:var(--ag-ink,#10292c); line-height:1.3; }
  .sa-head__s{ display:flex; align-items:center; gap:6px; font-size:12.5px; color:#5a6d6f; line-height:1.4; }
  .sa-dot{ width:7px; height:7px; border-radius:50%; background:#3aa03a; flex:none; }
  .sa-dot--off{ background:#c9a24b; }
  .sa-head__t{ margin-left:auto; font-size:12.5px; font-weight:700; color:var(--ag-green,#237b22);
               text-decoration:none; white-space:nowrap; }

  /* min-height is small on purpose. A 300px floor left a blank slab between the
     opening line and the starter chips on first load — an empty console reading
     as a broken one. The box grows with the conversation and only starts
     scrolling at max-height, so the tall version arrives when there is something
     to be tall about. */
  .sa-log{ padding:18px; display:flex; flex-direction:column; gap:16px;
           min-height:96px; max-height:58vh; overflow-y:auto; scroll-behavior:smooth; }
  @media (prefers-reduced-motion:reduce){ .sa-log{ scroll-behavior:auto; } }

  .sa-msg{ display:flex; gap:11px; align-items:flex-start; }
  .sa-msg__av{ flex:none; width:30px; height:30px; border-radius:50%; display:flex; align-items:center;
               justify-content:center; font-size:12px; font-weight:800; }
  .sa-msg--bot .sa-msg__av{ background:#10292C; color:#7FC87C; }
  .sa-msg--me  .sa-msg__av{ background:#eef6ee; color:#1c6b1c; }
  .sa-msg__b{ min-width:0; flex:1; font-size:14.75px; line-height:1.62; color:#2c3a3c; overflow-wrap:anywhere; }
  .sa-msg__b p{ margin:0 0 9px; } .sa-msg__b p:last-child{ margin:0; }
  .sa-msg__b a{ color:var(--ag-green,#237b22); font-weight:600; }
  .sa-msg__b code{ background:#f2f5f2; border-radius:4px; padding:1px 5px; font-size:13px;
                   font-family:var(--ag-font-mono,monospace); }
  .sa-msg__b ul{ margin:0 0 9px; padding-left:20px; } .sa-msg__b li{ margin:0 0 4px; }
  .sa-msg--me .sa-msg__b{ color:var(--ag-ink,#10292c); }

  /* What it looked at. Shown because a support answer you can sanity-check is
     worth more than one you have to take on trust. */
  .sa-used{ margin-top:8px; display:flex; flex-wrap:wrap; gap:6px; }
  .sa-used span{ font:600 10.5px/1 var(--ag-font-mono,monospace); letter-spacing:.05em;
                 text-transform:uppercase; color:#5a6d6f; background:#f2f5f2;
                 border:1px solid rgba(16,41,44,.09); border-radius:5px; padding:4px 7px; }
  .sa-used span.is-act{ color:#1c6b1c; background:#e9f5e9; border-color:#bfe3bf; }

  /* Article previews under a reply. Deliberately quieter than the message
     bubble — a suggestion that shouts louder than the answer is an advert. */
  .sa-arts{ margin-top:11px; display:flex; flex-direction:column; gap:7px; }
  .sa-arts__h{ font:600 10.5px/1 var(--ag-font-body); letter-spacing:.09em; text-transform:uppercase; color:#5a6d6f; margin-bottom:1px; }
  .sa-art{ display:block; background:var(--ag-surface,#fff); border:1px solid rgba(16,41,44,.11);
    border-radius:13px; padding:11px 13px; text-decoration:none; transition:border-color .15s, transform .12s; }
  .sa-art:hover{ border-color:var(--ag-green,#3f9c3c); transform:translateY(-1px); }
  .sa-art__c{ display:inline-block; font:700 9.5px/1 var(--ag-font-body); letter-spacing:.06em;
    text-transform:uppercase; padding:4px 8px; border-radius:999px; }
  .sa-art__t{ display:block; margin-top:7px; font-size:13.5px; font-weight:650; line-height:1.35; color:var(--ag-ink,#10292c); }
  .sa-art__s{ display:block; margin-top:3px; font-size:12px; line-height:1.5; color:#5a6d6f; }
  .sa-art__go{ display:inline-block; margin-top:7px; font-size:11.5px; font-weight:650; color:var(--ag-green-dark,#177015); }

  .sa-ticket{ margin-top:10px; display:inline-flex; align-items:center; gap:8px; font-size:13px; font-weight:700;
              color:#1c6b1c; background:#e6f4e6; border:1px solid #bfe3bf; border-radius:10px; padding:7px 11px;
              text-decoration:none; }
  .sa-ticket:hover{ background:#dcefdc; }

  /* Per-message actions. Copying a reference out of a support reply by hand is
     how a digit gets dropped, and a dropped digit is another failed lookup. */
  .sa-acts{ margin-top:8px; display:flex; gap:12px; flex-wrap:wrap; }
  .sa-acts button{ border:0; background:none; padding:2px 0; cursor:pointer;
                   font:600 12.5px/1 inherit; color:#5a6d6f; text-decoration:underline; }
  .sa-acts button:hover{ color:var(--ag-ink,#10292c); }
  .sa-acts button:focus-visible{ outline:2px solid var(--ag-green,#237b22); outline-offset:2px; border-radius:3px; }

  .sa-typing{ display:inline-flex; gap:4px; align-items:center; padding:5px 0; }
  .sa-typing i{ width:6px; height:6px; border-radius:50%; background:#9bb0b2; display:block; }
  @media (prefers-reduced-motion:no-preference){
    .sa-typing i{ animation:saBlink 1.2s infinite; }
    .sa-typing i:nth-child(2){ animation-delay:.18s } .sa-typing i:nth-child(3){ animation-delay:.36s }
    @keyframes saBlink{ 0%,60%,100%{opacity:.25} 30%{opacity:1} }
  }

  .sa-starters{ display:flex; flex-wrap:wrap; gap:8px; padding:0 18px 6px; }
  .sa-starters button{ border:1px solid rgba(16,41,44,.14); background:#fff; cursor:pointer;
                       font:600 13px/1 inherit; color:#3d4c4e; padding:9px 13px; border-radius:999px; }
  .sa-starters button:hover{ background:#f4f7f4; border-color:rgba(16,41,44,.24); }
  .sa-starters button:focus-visible{ outline:2px solid var(--ag-green,#237b22); outline-offset:2px; }

  /* ── the strip above the composer ──────────────────────────────────────
     Everything the conversation has established, kept in view: which
     reference it is about, and what it can do next. A support console that
     forgets the number it was just given makes the reader paste it twice. */
  .sa-strip{ display:flex; align-items:center; gap:8px; flex-wrap:wrap; padding:0 18px 10px; }
  .sa-ref{ display:inline-flex; align-items:center; gap:7px; font:700 12px/1 var(--ag-font-mono,monospace);
           color:#1c6b1c; background:#e9f5e9; border:1px solid #bfe3bf; border-radius:999px; padding:7px 11px; }
  .sa-ref button{ border:0; background:none; cursor:pointer; color:#1c6b1c; font:inherit;
                  padding:0; line-height:1; opacity:.65; }
  .sa-ref button:hover{ opacity:1; }
  .sa-reset{ margin-left:auto; border:0; background:none; cursor:pointer; font:600 12.5px/1 inherit;
             color:var(--ag-ink-soft,#626a6e); text-decoration:underline; padding:5px; }
  .sa-reset:hover{ color:var(--ag-ink,#10292c); }

  /* The busy line says WHICH kind of work is running. "…" for eight seconds
     is indistinguishable from a hung page, and this desk's slowest answers are
     the ones that talk to a payment gateway. */
  .sa-work{ font-size:13px; color:var(--ag-ink-soft,#626a6e); }

  .sa-form{ display:flex; gap:10px; align-items:flex-end; padding:14px 16px;
            border-top:1px solid rgba(16,41,44,.08); }
  .sa-ta{ flex:1; min-width:0; border:1px solid rgba(16,41,44,.14); border-radius:14px; resize:none;
          font:inherit; font-size:15px; line-height:1.5; padding:11px 13px; color:var(--ag-ink,#10292c);
          min-height:46px; max-height:180px; overflow-y:auto; background:#fff; }
  .sa-ta:focus{ outline:2px solid var(--ag-green,#237b22); outline-offset:1px; }
  .sa-go{ flex:none; border:0; background:var(--ag-green,#237b22); color:#fff; font-weight:700; font-size:14px;
          padding:12px 20px; border-radius:999px; cursor:pointer; }
  .sa-go[disabled]{ opacity:.45; cursor:default; }

  .sa-foot{ display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap;
            padding:0 18px 16px; font-size:12.5px; line-height:1.5; color:var(--ag-ink-soft,#626a6e); }
  .sa-foot p{ margin:0; max-width:52ch; }
  .sa-human{ border:0; background:none; cursor:pointer; font:700 13px/1 inherit;
             color:var(--ag-green,#237b22); text-decoration:underline; padding:5px; }
  .sa-human[disabled]{ opacity:.5; cursor:default; }
  .sa-human:focus-visible{ outline:2px solid var(--ag-green,#237b22); outline-offset:2px; }

  /* ── the shelf under the console ───────────────────────────────────────── */
  .sa-more{ margin-top:20px; display:grid; gap:12px; grid-template-columns:repeat(auto-fit,minmax(230px,1fr)); }
  .sa-more a{ display:block; padding:14px 16px; background:#fff; border:1px solid rgba(16,41,44,.09);
              border-radius:14px; text-decoration:none; color:inherit; }
  .sa-more a:hover{ border-color:rgba(16,41,44,.22); }
  .sa-more strong{ display:block; font-size:14.5px; color:var(--ag-ink,#10292c); }
  .sa-more span{ display:block; margin-top:3px; font-size:13px; line-height:1.5; color:#5a6d6f; }

  @media (max-width:560px){
    .sa-log{ max-height:none; }
    .sa-form{ padding:12px; }
    .sa-go{ padding:12px 16px; }
    /* Room for a placeholder that wraps. grow() takes over the moment anything
       is typed, so this only governs the empty state. */
    .sa-ta{ min-height:58px; }
    .sa-head__t{ font-size:12px; }
  }
</style>
{% endblock %}

{% block content %}
{# ══════════════════════════════════════════════════════════════════════════
   THE SUPPORT DESK

   Gee's engine, a support console's face. The difference is not cosmetic: Gee
   is a guide that volunteers suggestions as you browse; this is a desk you come
   to with a problem. So it opens with an input rather than a greeting, states
   plainly what it can and cannot see, shows which records it consulted, and puts
   "talk to a human" on screen from the first frame instead of behind three
   failed attempts.

   OPEN TO EVERYONE. A guest cannot be shown a LIST of their payments — there is
   no identity to scope one to — but a guest with a reference gets the same
   repair a member does, because most people who buy votes here never make an
   account and they were the ones locked out of the fix built for them.
   ══════════════════════════════════════════════════════════════════════════ #}
{# No `x-init="init()"`. Alpine calls a data object's own `init()` automatically,
   so naming the method AND wiring x-init ran it twice — the greeting appeared
   twice, and because the starter chips are gated on `msgs.length <= 1` they
   never appeared at all. Two bugs, one duplicated call. #}
<section class="ag-scope sa" x-data="supportDesk()">

  <header>
    <div class="sa-top">
      <div>
        <p class="sa-eyebrow">Support assistant</p>
        <h1 class="sa-h1">{% if member_first %}Hello {{ member_first }} — what has gone wrong?{% else %}What has gone wrong?{% endif %}</h1>
      </div>
    </div>
    <p class="sa-sub">Payments, votes, nominations, your account. I can re-check a payment against the
      gateway and put right what it finds — and hand you to a person the moment that is the better answer.</p>

    {# Capabilities as a read-out rather than a paragraph of prose. Two of the
       three are true for everybody; only the third depends on signing in. #}
    <ul class="sa-caps">
      <li class="sa-cap">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#237b22" stroke-width="2.4" aria-hidden="true"><path d="M20 6 9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Repair a stuck payment</li>
      <li class="sa-cap">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#237b22" stroke-width="2.4" aria-hidden="true"><path d="M20 6 9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Resend a receipt</li>
      <li class="sa-cap{% if not can_see_payments %} sa-cap--off{% endif %}">
        {% if can_see_payments %}
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#237b22" stroke-width="2.4" aria-hidden="true"><path d="M20 6 9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Read your own payments and votes
        {% else %}
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" stroke-linecap="round"/></svg>
        Read your payments — needs sign-in
        {% endif %}
      </li>
    </ul>

    {% if not can_see_payments %}
    <p class="sa-note sa-note--info">You are not signed in, so I cannot <em>list</em> what you have paid.
      I can still fix a specific payment — paste its reference and I will re-check it with the gateway.
      <a href="/account/login?next=%2Fsupport%2Fassistant">Sign in</a> if you would rather see the whole list.</p>
    {% endif %}
  </header>

  <div class="sa-box">
    {# Who you are talking to, and whether it is up. The status lives HERE rather
       than in a banner above the console: a warning about the assistant belongs
       on the assistant, and the banner it replaces was pushing the input below
       the fold on a phone. #}
    <div class="sa-head">
      <span class="sa-head__av" aria-hidden="true">G</span>
      <div>
        <div class="sa-head__n">Gee · support</div>
        <div class="sa-head__s">
          <span class="sa-dot{% if not ai_on %} sa-dot--off{% endif %}" aria-hidden="true"></span>
          {# "Offline" alone was true and unhelpful. With no model the assistant
             still quotes the written Help Centre answer for the question asked
             (HelpCentre::writtenAnswer), and a ticket still reaches a person — so
             a flat "Offline" told people to give up on a page that was about to
             answer them. Say what it CAN do. #}
          {% if ai_on %}Online — reading live records{% else %}Answering from the written help — a person still gets your message{% endif %}
        </div>
      </div>
      <a class="sa-head__t" href="/support/tickets">Your tickets →</a>
    </div>

    {# The transcript is a log, announced politely. aria-live sits on a container
       that is always present, so a reply is announced rather than silently
       appearing for anyone using a screen reader. #}
    <div class="sa-log" x-ref="log" role="log" aria-live="polite" aria-label="Support conversation">
      <template x-for="(m, i) in msgs" :key="i">
        <div class="sa-msg" :class="m.role === 'user' ? 'sa-msg--me' : 'sa-msg--bot'">
          <span class="sa-msg__av" aria-hidden="true" x-text="m.role === 'user' ? '{{ (member_first|default('You'))|first|upper }}' : 'G'"></span>
          <div class="sa-msg__b">
            <div x-html="m.html"></div>

            <div class="sa-used" x-show="!!(m.used && m.used.length)" x-cloak>
              <template x-for="u in m.used" :key="u">
                <span :class="acted(u) ? 'is-act' : ''" x-text="label(u)"></span>
              </template>
            </div>

            {#
              SMART PREVIEW. A bare URL inside a paragraph is a blue string nobody
              clicks: no title, no summary, nothing to weigh against leaving the
              conversation. A card is a decision somebody can make at a glance.

              `cited` separates "I used this" from "you might also want", which are
              different claims and must not look identical — the first is part of
              the answer, the second is a guess by a keyword search.
            #}
            <div class="sa-arts" x-show="!!(m.articles && m.articles.length)" x-cloak>
              <div class="sa-arts__h" x-text="m.articles.some(a => a.cited) ? 'From the Help Centre' : 'You might also want'"></div>
              <template x-for="a in m.articles" :key="a.slug">
                <a class="sa-art" :href="a.url">
                  <span class="sa-art__c" :style="'background:'+a.tint+';color:'+a.fg" x-text="a.category"></span>
                  <span class="sa-art__t" x-text="a.title"></span>
                  <span class="sa-art__s" x-text="a.summary"></span>
                  <span class="sa-art__go" aria-hidden="true">Read this &rarr;</span>
                </a>
              </template>
            </div>

            <a class="sa-ticket" x-show="!!m.ticket" x-cloak
               :href="'/support/tickets?ref=' + encodeURIComponent(m.ticket || '')">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><path d="M20 6 9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span x-text="'Ticket ' + m.ticket + ' — follow it here'"></span>
            </a>

            <div class="sa-acts" x-show="m.role === 'assistant' && i > 0" x-cloak>
              <button type="button" @click="copy(m, $event)" x-text="m.copied ? 'Copied' : 'Copy'"></button>
              <button type="button" x-show="!!m.retry" @click="send(m.retry)">Ask again</button>
            </div>
          </div>
        </div>
      </template>

      <div class="sa-msg sa-msg--bot" x-show="busy" x-cloak>
        <span class="sa-msg__av" aria-hidden="true">G</span>
        <div class="sa-msg__b">
          <span class="sa-typing" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="sa-work" x-text="work" x-show="!!work"></span>
        </div>
      </div>
    </div>

    {# The chips do not vanish after the first message. Half of what this desk
       can do is invisible until somebody happens to ask for it, and "what else
       can you do" is not a question people put to a support bot — they leave. #}
    <div class="sa-starters">
      <template x-for="s in (msgs.length <= 1 ? starters : more)" :key="s">
        <button type="button" @click="send(s)" x-text="s"></button>
      </template>
    </div>

    <div class="sa-strip" x-show="!!ref || msgs.length > 1" x-cloak>
      <span class="sa-ref" x-show="!!ref">
        <span x-text="ref"></span>
        <button type="button" @click="ref = ''" aria-label="Forget this reference">×</button>
      </span>
      <button type="button" class="sa-reset" @click="reset()" x-show="msgs.length > 1">Start over</button>
    </div>

    <form class="sa-form" @submit.prevent="send()">
      <label class="sr-only" for="saMsg">Describe the problem</label>
      <textarea class="sa-ta" id="saMsg" rows="1" x-model="draft" maxlength="1500" x-ref="ta"
                {# Short on purpose. The long version wrapped to two lines inside a
                   one-row box on a 390px phone and the second half was clipped,
                   so the first thing this desk showed was a sentence it had cut
                   in half. #}
                placeholder="What happened? Add a reference if you have one"
                @input="grow()" @keydown.enter.exact.prevent="send()"></textarea>
      <button class="sa-go" type="submit" :disabled="busy || !draft.trim()">Send</button>
    </form>

    <div class="sa-foot">
      <p>Answers come from your own records and the live site. I never invent a reference or an amount.</p>
      {# On screen from the first frame. Making someone argue with a robot to
         reach a person is the most resented pattern in support software, and
         this path touches no model — it works when the assistant is down. #}
      <button type="button" class="sa-human" @click="human()" :disabled="busy">Talk to a human</button>
    </div>
  </div>

  <div class="sa-more">
    <a href="/support/tickets">
      <strong>Your tickets</strong>
      <span>Anything already with the team, and every reply — by email and here.</span>
    </a>
    <a href="/help">
      <strong>Help centre</strong>
      <span>How voting, nominations and the index work, written out in full.</span>
    </a>
    <a href="mailto:{{ support_email }}">
      <strong>{{ support_email }}</strong>
      <span>Email the team directly. Include a payment reference if you have one.</span>
    </a>
  </div>
</section>

<script nonce="{{ csp_nonce }}">
function supportDesk(){
  return {
    msgs: [], draft: '', busy: false, work: '', ref: '',
    starters: ['I voted but it is not showing', 'I paid and my votes never arrived',
               'My receipt never came', 'How much are votes?'],
    // Shown once the conversation is under way. Different from the openers on
    // purpose: by then the reader has stated their problem, and what they need
    // next is the things they did not know to ask for.
    more: [{% if can_see_payments %}'What is happening with my ticket?', 'Is my nomination approved?',
            'Show my recent payments', {% endif %}'When does voting close?', 'Is anything broken right now?'],

    /** Where the transcript is kept across an accidental reload. */
    KEY: 'ag_support_desk_v1',

    init(){
      // ── SURVIVE A RELOAD ───────────────────────────────────────────────
      //
      // The single most infuriating thing a support console can do is lose the
      // conversation. People switch to their banking app to find a reference and
      // come back to a mobile browser that has discarded the tab — and every
      // sentence they typed is gone, including the reference they just went to
      // fetch. sessionStorage, so it lives as long as the tab and no longer:
      // this is somebody's payment problem, not something to leave on a shared
      // machine after they close it.
      if (!this.restore()) {
        this.push('assistant',
          {% if can_see_payments %}
          'Ask away. I can see your own payments, votes, nominations and tickets, re-check a payment with the gateway, and tell you what the platform is actually doing right now.'
          {% else %}
          'Ask away. If a payment has not come through, paste its reference and I will re-check it with the gateway — you do not need an account for that.'
          {% endif %});
      }
      this.fromLink();
    },

    /** @return {boolean} true if a previous conversation was put back. */
    restore(){
      try {
        var raw = sessionStorage.getItem(this.KEY);
        if (!raw) return false;
        var saved = JSON.parse(raw);
        if (!saved || !Array.isArray(saved.msgs) || !saved.msgs.length) return false;
        // Re-rendered through fmt() rather than trusting stored HTML: the
        // markup in storage came from this page, but anything that reaches
        // innerHTML should be built here and now, from the text.
        this.msgs = saved.msgs.slice(-40).map((m) => Object.assign({}, m, {
          html: this.fmt(m.text), copied: false
        }));
        this.ref = String(saved.ref || '');
        return true;
      } catch (e) { return false; }
    },

    save(){
      try {
        sessionStorage.setItem(this.KEY, JSON.stringify({
          ref: this.ref,
          // Text, not HTML, and not the per-message UI flags.
          msgs: this.msgs.slice(-40).map(m => ({
            role: m.role, text: m.text, used: m.used || [], articles: m.articles || [], ticket: m.ticket || null
          }))
        }));
      } catch (e) { /* private mode, or the quota — the conversation still works */ }
    },

    reset(){
      try { sessionStorage.removeItem(this.KEY); } catch (e) {}
      this.msgs = []; this.ref = ''; this.draft = ''; this.work = '';
      this.init();
    },

    /**
     * Remember the reference the conversation is about.
     *
     * Pulled out of whatever either side has said, so the reader does not have
     * to paste it a second time when the conversation moves on to the receipt.
     * Only OUR shape is captured — a bank's own transaction number is real but
     * useless here, and pinning one would be pinning a dead end.
     */
    noteRef(text){
      var m = String(text || '').match(/\bAFG-[A-Z]*-?[0-9a-f]{8,}\b/i);
      if (m) this.ref = m[0].toUpperCase();
    },

    /**
     * Arrive from a support prompt with the problem already stated.
     *
     * The pages that link here — a stalled payment page, a checkout, an error —
     * already know the reference and already know what went wrong. Making the
     * person retype it is asking them to copy forty characters by hand, which is
     * where a digit gets dropped and the lookup fails and they conclude nothing
     * works. `?ref=` is validated to the shape a reference actually has, because
     * it lands in a message the assistant then acts on.
     */
    fromLink(){
      var p = new URLSearchParams(location.search);
      var ref = (p.get('ref') || '').trim().slice(0, 120);
      if (ref && !/^[A-Za-z0-9_\-]{6,120}$/.test(ref)) ref = '';
      var topic = p.get('topic') || '';

      // `?q=` — a QUESTION carried over from another page.
      //
      // Four pages were already linking here with it and this function read only
      // `ref` and `topic`, so every one of them landed the reader on an empty
      // composer: the article highlight-to-ask, the "No — ask the assistant"
      // button under each article, a Help Centre search that found nothing, and
      // the repair button on /vote/verify. Nothing errored. The button simply did
      // not do the thing it said, which is worse than a broken link because the
      // reader concludes the assistant is useless rather than that a link is wrong.
      //
      // Free text, so it is only ever a DRAFT: it goes into the composer for the
      // reader to send or edit. Bound through Alpine, so it is text and never
      // markup, and capped because a pasted essay is not a question.
      var q = (p.get('q') || '').replace(/\s+/g, ' ').trim().slice(0, 300);

      if (!ref && !q && topic !== 'payment' && topic !== 'votes') return;

      var text = ref
        ? 'I paid but nothing has come through. The reference is ' + ref
        : (q !== '' ? q
          : (topic === 'votes' ? 'My votes have not arrived.' : 'I paid but nothing has come through.'));

      // Auto-send only when we have something to act on. Firing off a vague
      // question on the reader's behalf spends a turn and teaches them the
      // assistant guesses — with a reference there is a real repair to attempt.
      if (ref && p.get('ask') === '1') { this.send(text); return; }
      this.draft = text;
      this.$nextTick(() => { this.grow(); if (this.$refs.ta) this.$refs.ta.focus(); });
    },

    /** Tool names, in words a person would use. */
    label(t){
      return ({
        fix_payment:      're-checked the payment',
        resend_receipt:   'sent the receipt again',
        check_reference:  'checked the reference',
        free_vote_help:   'checked free voting',
        refund_status:    'checked the refund',
        my_transactions:  'checked your payments',
        my_votes:         'checked your votes',
        my_tickets:       'checked your tickets',
        my_nominations:   'checked your nominations',
        lookup_reference: 'looked up that reference',
        site_state:       'checked the cycle',
        platform_health:  'checked platform health',
        help_search:      'searched the site',
        pricing:          'checked pricing',
        ops_summary:      'checked operations',
      })[t] || t;
    },

    /** Tools that CHANGED something, marked apart from the ones that only read. */
    acted(t){ return t === 'fix_payment' || t === 'resend_receipt'; },

    /**
     * Markdown-ish, ESCAPED FIRST.
     *
     * This renders model output into innerHTML. Escaping before formatting is
     * what stops a model that has been talked into emitting a script tag from
     * having actually emitted one. Only site-relative links are linkified: an
     * absolute URL from a model is a phishing vector, whereas a bad path is at
     * worst a 404 on our own site.
     */
    fmt(s){
      var e = String(s == null ? '' : s)
        .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
        .replace(/"/g,'&quot;').replace(/'/g,'&#39;');
      e = e.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
           .replace(/`([^`]+)`/g, '<code>$1</code>')
           .replace(/\[([^\]]+)\]\((\/[^)\s]*)\)/g, '<a href="$2">$1</a>')
           .replace(/(^|\s)(\/[a-z0-9\-\/]{2,60})(?=[\s.,)]|$)/gi, '$1<a href="$2">$2</a>');
      return e.split(/\n{2,}/).map(function(p){
        // A run of "- " lines is a list. Models write them constantly and a
        // paragraph of dashes reads as broken formatting rather than as prose.
        if (/^-\s+/.test(p) && p.split('\n').every(function(l){ return /^-\s+/.test(l) || !l.trim(); })){
          return '<ul>' + p.split('\n').filter(function(l){ return l.trim(); })
            .map(function(l){ return '<li>' + l.replace(/^-\s+/, '') + '</li>'; }).join('') + '</ul>';
        }
        return '<p>' + p.replace(/\n/g,'<br>') + '</p>';
      }).join('');
    },

    push(role, text, extra){
      this.msgs.push(Object.assign({ role: role, text: text, html: this.fmt(text),
                                     used: [], articles: [], ticket: null, retry: null, copied: false }, extra || {}));
      this.noteRef(text);
      this.save();
      this.$nextTick(() => { var l = this.$refs.log; if (l) l.scrollTop = l.scrollHeight; });
    },

    /**
     * What the wait is FOR.
     *
     * Three dots for eight seconds is indistinguishable from a hung page, and
     * the slowest answers here are the ones that go out to a payment gateway —
     * exactly the ones worth waiting for. The line is chosen from what the
     * reader actually said, so it is a description and not a guess: a message
     * carrying a reference really does go on to re-check a payment.
     */
    workingOn(text){
      var t = String(text || '').toLowerCase();
      if (/afg-|reference|receipt|refund|paid|payment|charged/.test(t)) return 'Checking that with the payment gateway…';
      if (/ticket|replied|nobody|escalat/.test(t))                     return 'Looking up your tickets…';
      if (/nominat/.test(t))                                           return 'Checking your nominations…';
      if (/broken|down|slow|error/.test(t))                            return 'Checking the platform…';
      if (/close|deadline|when/.test(t))                               return 'Checking the cycle…';
      return 'Looking that up…';
    },

    /** What goes back to the server as context: roles and text, nothing else. */
    history(){ return this.msgs.slice(-12).map(m => ({ role: m.role, content: m.text })); },

    /** Grow the composer with the text, up to the CSS max-height. */
    grow(){
      var t = this.$refs.ta; if (!t) return;
      t.style.height = 'auto';
      t.style.height = Math.min(t.scrollHeight, 180) + 'px';
    },

    copy(m, ev){
      var done = () => { m.copied = true; setTimeout(() => { m.copied = false; }, 1600); };
      if (navigator.clipboard && navigator.clipboard.writeText){
        navigator.clipboard.writeText(m.text).then(done).catch(function(){});
        return;
      }
      // No clipboard API (http, or an older browser). Select the text instead —
      // silently doing nothing would look like a broken button.
      try {
        var r = document.createRange(); r.selectNodeContents(ev.target.closest('.sa-msg__b'));
        var s = window.getSelection(); s.removeAllRanges(); s.addRange(r); done();
      } catch (e) {}
    },

    send(preset){
      var text = (preset || this.draft).trim();
      if (!text || this.busy) return;
      var prior = this.history();          // before pushing, so we do not send the new message twice
      this.push('user', text);
      this.draft = ''; this.busy = true; this.work = this.workingOn(text);
      this.$nextTick(() => this.grow());

      fetch('/api/v1/support/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
        body: new URLSearchParams({ message: text, history: JSON.stringify(prior) })
      })
        .then(r => r.json())
        .then(j => this.push('assistant', j.reply || 'I could not answer that just now.',
                             { used: j.used || [], articles: j.articles || [], ticket: j.ticket || null, retry: text }))
        .catch(() => this.push('assistant',
          'I lost the connection. Press “Talk to a human” and the team will pick this up.',
          { retry: text }))
        .finally(() => { this.busy = false; this.work = ""; });
    },

    human(){
      // Sends the whole conversation, so the person does not have to explain
      // themselves a second time to a human who has not read any of it.
      var last = [...this.msgs].reverse().find(m => m.role === 'user');

      // NOTHING SAID YET — ask, do not file.
      //
      // This used to post a placeholder sentence and open a real ticket from it.
      // In a live conversation the reader pressed the button first, got "Passed
      // to the team — your reference is AGS-9B5DE7" before they had typed a word,
      // and then explained their problem to the assistant while a blank ticket
      // sat in the queue carrying that reference. A ticket with no content is a
      // promise to reply to nothing.
      if (!last) {
        this.push('assistant', 'Of course — tell me what has gone wrong first, in a line or two. '
          + 'I will pass the whole thing to the team so you do not have to explain it twice.');
        this.$nextTick(() => { if (this.$refs.ta) this.$refs.ta.focus(); });
        return;
      }

      var text = last.text;
      this.busy = true;

      fetch('/api/v1/support/escalate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
        body: new URLSearchParams({ message: text, history: JSON.stringify(this.history()), page_url: location.href })
      })
        .then(r => r.json())
        .then(j => this.push('assistant', j.message || 'I could not reach the team.', { ticket: j.ticket || null }))
        .catch(() => this.push('assistant', 'I could not reach the team. Please email us directly.'))
        .finally(() => { this.busy = false; this.work = ""; });
    }
  };
}
</script>
{% endblock %}
