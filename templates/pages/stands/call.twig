{% extends "layout/gates.twig" %}

{# ─────────────────────────────────────────────────────────────────────────────
   THE PUBLIC CALL FOR STANDS.

   Everything on this page is a published term, and it is published BEFORE anybody knows
   who applied. That is the whole fairness mechanism — the prices, the quotas, the closing
   date and what a strong application looks like are all readable by every applicant before
   they decide whether to bother.

   It stays up after the deadline on purpose. A vendor who arrives a week late is owed the
   sentence "this closed on the 14th", not a 404 that reads as though the whole thing was
   imaginary.

   ── WHY IT WAS RESTYLED ─────────────────────────────────────────────────────

   It is the page directly before the application form, and the two no longer looked like
   the same process: a radial-gradient hero over rounded white cards, then a paper ground
   with hairline rules. A flow whose visual language changes at the click that matters is a
   flow people distrust at exactly the wrong moment.

   So this is the same system as the form, and the stand rows are laid out identically —
   the same three columns, the same mono meta line, the same tabular price. Somebody who
   reads the offer here meets the same rows when they choose one, in the same order, with
   the same facts in the same places.
   ───────────────────────────────────────────────────────────────────────────── #}

{% block head_styles %}
<style nonce="{{ csp_nonce }}">
  body[data-page="stands"]{
    --sc-paper:#f0f2f2;
    --sc-card:#ffffff;
    --sc-cream:#f6f2e6;
    --sc-ink:#10292C;
    --sc-ink-2:#4a5256;
    --sc-mute:#626a6e;
    --sc-line:rgba(16,41,44,.12);
    --sc-line-2:rgba(16,41,44,.22);
    --sc-gold:#f3b416;
    --sc-gold-ink:#745001;
    --sc-green:#237b22;
    --sc-green-dark:#12481d;
    --sc-r:14px;
    --sc-r-sm:4px;
    --sc-sec:clamp(38px,5vw,60px);

    background:var(--sc-paper); color:var(--sc-ink);
  }
  .sc{ max-width:860px; margin:0 auto;
    padding:clamp(22px,4vw,40px) var(--ag-gutter,32px) clamp(56px,7vw,84px); }

  .sc-kick{ display:block; font-family:var(--ag-font-mono,monospace); font-size:10.5px;
    font-weight:700; letter-spacing:.24em; text-transform:uppercase; color:var(--sc-gold-ink); }

  /* ── the masthead ────────────────────────────────────────────────────────── */
  .sc-head h1{ margin:12px 0 0; font-family:var(--ag-font-display,Georgia,serif);
    font-weight:800; font-size:clamp(2rem,4.6vw,2.8rem); line-height:1.03;
    letter-spacing:-.03em; color:var(--sc-ink); text-wrap:balance; }
  .sc-head p{ margin:16px 0 0; max-width:58ch; font-size:16px; line-height:1.65;
    color:var(--sc-ink-2); text-wrap:pretty; }

  .sc-act{ display:flex; flex-wrap:wrap; align-items:center; gap:16px; margin-top:28px;
    padding-top:24px; border-top:1px solid var(--sc-line-2); }
  .sc-cta{ display:inline-flex; align-items:center; justify-content:center; min-height:52px;
    padding:0 30px; border-radius:var(--ag-r-pill,999px); background:var(--sc-green-dark);
    color:#fff; font-weight:700; font-size:15.5px; text-decoration:none; }
  .sc-cta:hover{ background:#0d3716; }
  .sc-cta:focus-visible{ outline:3px solid var(--sc-green); outline-offset:3px; }
  /* `flex:1 1 26ch`, not a bare max-width. A flex item's hypothetical size is its
     max-content width, so a 120-character sentence asked for more room than the row had
     and wrapped under the button however narrow the cap said it could be. */
  .sc-when{ flex:1 1 26ch; max-width:44ch; font-size:13.5px; line-height:1.6;
    color:var(--sc-ink-2); }
  .sc-when b{ color:var(--sc-ink); font-weight:700; }
  /* A closed call is not an error. It is the sentence somebody arriving late is owed. */
  .sc-closed{ display:flex; align-items:flex-start; gap:11px; padding:16px 18px;
    border-radius:var(--sc-r-sm); background:var(--sc-cream); max-width:62ch;
    font-size:14px; line-height:1.65; color:var(--sc-ink-2); }
  .sc-closed svg{ flex:none; margin-top:2px; color:var(--sc-gold-ink); }
  .sc-closed b{ color:var(--sc-ink); font-weight:700; }

  /* ── sections ────────────────────────────────────────────────────────────── */
  .sc-sec{ margin-top:var(--sc-sec); }
  .sc-sec__h{ padding-bottom:14px; border-bottom:1px solid var(--sc-line-2); }
  .sc-sec__h h2{ margin:10px 0 0; font-family:var(--ag-font-display,Georgia,serif);
    font-weight:700; font-size:clamp(1.3rem,2.6vw,1.65rem); line-height:1.18;
    letter-spacing:-.02em; color:var(--sc-ink); }
  .sc-lead{ margin:14px 0 0; max-width:62ch; font-size:14.5px; line-height:1.7;
    color:var(--sc-ink-2); text-wrap:pretty; }

  /* ── what is on offer ──────────────────────────────────────────────────────
     Deliberately the same three columns as the chooser on the application form.
     A vendor reads the offer here and meets the same rows when they pick one. */
  .sc-stand{ display:grid; grid-template-columns:minmax(0,1fr) auto; column-gap:16px;
    row-gap:8px; align-items:start; padding:20px 0; border-bottom:1px solid var(--sc-line); }
  .sc-stand__n{ font-family:var(--ag-font-display,Georgia,serif); font-weight:700;
    font-size:1.1rem; line-height:1.25; letter-spacing:-.01em; color:var(--sc-ink); }
  /* NOT uppercased. `text-transform` reaches the units too, and this line quotes
     physical dimensions: it rendered `1.8 × 0.75 M` and `9 M²`, and a capital M is
     not the metre. Mono at .1em tracking carries the same micro-label weight in
     sentence case, where the category names are correct English as well. */
  .sc-stand__meta{ display:block; margin-top:5px; font-family:var(--ag-font-mono,monospace);
    font-size:10.5px; font-weight:700; letter-spacing:.1em;
    color:var(--sc-mute); }
  /* Never colour alone: the words say how many are left, or that they are all held. */
  .sc-left{ color:var(--sc-green-dark); }
  .sc-full{ color:#8a2b18; }
  .sc-stand__d{ grid-column:1 / -1; margin:0; max-width:62ch; font-size:13.5px;
    line-height:1.65; color:var(--sc-ink-2); }
  .sc-stand__p{ grid-column:2; grid-row:1; text-align:right; white-space:nowrap;
    font-family:var(--ag-font-mono,monospace); font-weight:700; font-size:1.05rem;
    font-variant-numeric:tabular-nums; color:var(--sc-ink); }
  .sc-stand__dep{ display:block; margin-top:5px; margin-left:auto; max-width:15ch;
    white-space:normal; font-family:var(--ag-font-body,sans-serif); font-size:11.5px;
    font-weight:400; line-height:1.45; letter-spacing:0; color:var(--sc-mute); }
  .sc-list{ margin-top:8px; border-top:1px solid var(--sc-line-2); }

  /* ── how it is decided ─────────────────────────────────────────────────── */
  .sc-steps{ list-style:none; margin:20px 0 0; padding:0;
    border-top:1px solid var(--sc-line-2); }
  .sc-steps li{ display:grid; grid-template-columns:30px minmax(0,1fr); column-gap:14px;
    align-items:baseline; padding:18px 0; border-bottom:1px solid var(--sc-line);
    font-size:14.5px; line-height:1.7; color:var(--sc-ink-2); }
  .sc-steps__n{ font-family:var(--ag-font-mono,monospace); font-size:11px; font-weight:700;
    letter-spacing:.14em; color:var(--sc-gold-ink); }
  .sc-steps strong{ display:block; color:var(--sc-ink); font-weight:700; }

  /* ── who can apply ─────────────────────────────────────────────────────── */
  .sc-who{ list-style:none; margin:20px 0 0; padding:0;
    border-top:1px solid var(--sc-line-2); }
  .sc-who li{ padding:18px 0; border-bottom:1px solid var(--sc-line); max-width:66ch;
    font-size:14.5px; line-height:1.7; color:var(--sc-ink-2); }
  .sc-who strong{ display:block; color:var(--sc-ink); font-weight:700; }

  .sc-end{ margin-top:var(--sc-sec); }

  @media (max-width:560px){
    .sc-stand{ grid-template-columns:minmax(0,1fr); }
    .sc-stand__p{ grid-column:1; grid-row:auto; text-align:left; }
    .sc-stand__dep{ margin-left:0; max-width:none; }
    .sc-cta{ width:100%; }
  }
</style>
{% endblock %}

{% block content %}
<div class="sc">

  <header class="sc-head">
    <span class="sc-kick">Vendor stands</span>
    <h1>Trade at {{ event.title }}</h1>
    {% if call.intro %}
      <p>{{ call.intro }}</p>
    {% else %}
      <p>Stands at Africa GATES events are applied for and allocated against published
        quotas — not sold to whoever pays first. Everything that decides your application is
        on this page.</p>
    {% endif %}

    <div class="sc-act">
      {% if accepting %}
        <a class="sc-cta" href="/events/{{ event.slug }}/stands/apply">Apply for a stand</a>
        <p class="sc-when">Applications close
          <b>{{ call.closes_at|date('l j F Y') }}</b>, at {{ call.closes_at|date('g:i a') }}.
          {% if not signed_in %}You do not need an account first — the form creates one, and
          applying costs nothing.{% else %}Applying costs nothing.{% endif %}</p>
      {% else %}
        <p class="sc-closed">
          <svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
          <span>
            {%- if call.closes_at and call.closes_at|slice(0,10) < "now"|date("Y-m-d") -%}
              <b>Applications closed on {{ call.closes_at|date('j F Y') }}.</b>
            {%- elseif call.opens_at -%}
              <b>Applications open on {{ call.opens_at|date('l j F Y') }}.</b>
            {%- else -%}
              <b>This call is not taking applications.</b>
            {%- endif %}
            Everything below is what was published, so you know what to expect next time.
          </span>
        </p>
      {% endif %}
    </div>
  </header>

  {# ── WHAT IS ON OFFER, WITH THE QUOTA AGAINST IT ───────────────────────── #}
  <section class="sc-sec">
    <div class="sc-sec__h">
      <span class="sc-kick">The offer</span>
      <h2>What is on offer</h2>
    </div>
    <p class="sc-lead">
      The number of places in each category is fixed and published here. It is what stops a
      market becoming twelve jewellery stalls and nothing to eat — and it means nobody is
      deciding your category's size after seeing who applied. Places left over in one
      category do not move into another.
    </p>

    <div class="sc-list">
      {% for c in capacity %}
        <div class="sc-stand">
          <div>
            {# The SIZE first in the meta line, because it is the fact a vendor decides on.
               Somebody with a 6m rail cannot use a 2 × 2, and finding that out on the
               morning is the whole problem this line exists to prevent. #}
            <span class="sc-stand__n">{{ c.type.name }}</span>
            <span class="sc-stand__meta">
              {{ c.size }} · {{ categories[c.type.category]|default(c.type.category) }} ·
              {{ c.each_sqm }} m² ·
              {% if c.left > 0 %}<span class="sc-left">{{ c.left }} of {{ c.quota }} still open</span>
              {%- else %}<span class="sc-full">All {{ c.quota }} held · waiting list</span>{% endif %}
              {%- if c.type.includes_power %} · Power included{% else %} · No power{% endif %}
              {%- if c.type.step_free %} · Step-free{% endif %}
            </span>
          </div>
          <span class="sc-stand__p">₦{{ c.type.price_naira|number_format }}
            {% if c.type.deposit_naira > 0 %}
              <span class="sc-stand__dep">₦{{ c.type.deposit_naira|number_format }} deposit
                on acceptance</span>
            {% endif %}
          </span>
          {% if c.type.description %}<p class="sc-stand__d">{{ c.type.description }}</p>{% endif %}
        </div>
      {% else %}
        <p class="sc-lead" style="margin-top:20px">Nothing has been published for this event
          yet. When it is, the prices and the quotas will be on this page before anybody can
          apply.</p>
      {% endfor %}
    </div>
  </section>

  {# ── HOW IT IS DECIDED ─────────────────────────────────────────────────── #}
  <section class="sc-sec">
    <div class="sc-sec__h">
      <span class="sc-kick">The decision</span>
      <h2>How your application is decided</h2>
    </div>
    <p class="sc-lead">Two stages, and they are different kinds of “no”.</p>
    <ol class="sc-steps">
      <li><span class="sc-steps__n" aria-hidden="true">01</span>
        <div><strong>Eligibility — a rule, not an opinion.</strong>
          Your certificates are on file and in date, and you are not suspended. Nothing is
          weighed here. If you fail it we tell you exactly what is missing, and you can fix
          it while the call is still open.</div></li>
      <li><span class="sc-steps__n" aria-hidden="true">02</span>
        <div><strong>Selection — a judgement, with a reason written down.</strong>
          Within each category, against the published quota. Where applications are otherwise
          equal, the tiebreak is whoever became <em>complete</em> first — not whoever
          submitted first, so filling in an empty form quickly gains you nothing.</div></li>
      <li><span class="sc-steps__n" aria-hidden="true">03</span>
        <div><strong>An outcome either way.</strong>
          Everybody hears, and a refusal comes with the reason. If you are offered a stand
          you have {{ offer_hours }} hours to accept before the place goes to the waiting
          list.</div></li>
    </ol>
  </section>

  {# ── WHO CAN APPLY ─────────────────────────────────────────────────────── #}
  <section class="sc-sec">
    <div class="sc-sec__h">
      <span class="sc-kick">Who can apply</span>
      <h2>You do not need to be a registered company</h2>
    </div>
    <p class="sc-lead">Most of the people who trade at our events are not companies, and the
      requirements say so.</p>
    <ul class="sc-who">
      <li><strong>Applying as an individual or sole trader</strong>
        Your full name, a government photo ID, and public liability insurance. No CAC
        registration is asked for, because you do not have one — and borrowing somebody
        else's number is worse than having none.</li>
      <li><strong>Applying as a registered business</strong>
        Your CAC registration number and registered name, and public liability insurance.</li>
      <li><strong>Either way</strong>
        The bank account we settle to must be in your own name. We check that with your bank
        before anything is paid, and we never store your account number.</li>
    </ul>
  </section>

  {% if accepting %}
    <div class="sc-end">
      <a class="sc-cta" href="/events/{{ event.slug }}/stands/apply">Apply for a stand</a>
    </div>
  {% endif %}
</div>
{% endblock %}
