{% extends "layout/gates.twig" %}

{# ─────────────────────────────────────────────────────────────────────────────
   THE PUBLIC CALL FOR STANDS.

   Everything on this page is a published term, and it is published BEFORE anybody knows
   who applied. That is the whole fairness mechanism — the prices, the quotas, the closing
   date and what a strong application looks like are all readable by every applicant before
   they decide whether to bother.

   It stays up after the deadline on purpose. A vendor who arrives a week late is owed the
   sentence "this closed on the 14th", not a 404 that reads as though the whole thing was
   imaginary.

   ── THE ORDER OF THIS PAGE IS THE DESIGN ────────────────────────────────────

   Masthead, then the deadline and the apply card side by side, then WHAT YOU WILL BE ASKED
   TO UPLOAD, and only then the offer.

   The documents come before the prices because they are the fact that changes what somebody
   does in the next five minutes. Applications are ranked by when they became COMPLETE, so a
   vendor who starts the form without a certificate to hand has not gained a place in a
   queue — they have started a form they cannot finish. Telling them that after the price
   list is telling them too late.

   It also absorbs the old "You do not need to be a registered company" section, which said
   the same thing a second time further down.

   ── AND IT IS THE SAME SYSTEM AS THE FORM ───────────────────────────────────

   The page directly after this one is the application. The two used to look like different
   products — a radial-gradient hero over rounded white cards, then a paper ground with
   hairline rules — and a flow whose visual language changes at the click that matters is a
   flow people distrust at exactly the wrong moment.

   So the stand rows here are laid out identically to the chooser on the form: the same
   name, the same mono meta line, the same tabular price in the same place.
   ───────────────────────────────────────────────────────────────────────────── #}

{% block head_styles %}
<style nonce="{{ csp_nonce }}">
  body[data-page="stands"]{
    --sc-paper:#f0f2f2;
    --sc-card:#ffffff;
    --sc-cream:#f6f2e6;
    --sc-ink:#10292C;
    --sc-ink-2:#4a5256;
    --sc-mute:#626a6e;
    --sc-line:rgba(16,41,44,.07);
    --sc-line-2:rgba(16,41,44,.12);
    --sc-line-3:rgba(16,41,44,.22);
    --sc-gold:#f3b416;
    --sc-gold-ink:#745001;
    --sc-green:#237b22;
    --sc-green-dark:#12481d;
    --sc-full:#8a2b18;
    --sc-r:14px;
    --sc-r-sm:4px;
    --sc-sec:clamp(38px,5vw,56px);

    background:var(--sc-paper); color:var(--sc-ink);
  }
  /* 960, not 860. The masthead now carries a two-column header beneath it, and a 320px
     apply card beside a deadline panel needs the room. Prose inside stays capped near
     62ch regardless — the column got wider, the measure did not. */
  .sc{ max-width:960px; margin:0 auto;
    padding:clamp(22px,4vw,40px) var(--ag-gutter,32px) clamp(56px,7vw,84px); }

  .sc-kick{ display:block; font-family:var(--ag-font-mono,monospace); font-size:10.5px;
    font-weight:700; letter-spacing:.24em; text-transform:uppercase; color:var(--sc-gold-ink); }

  /* ── the masthead ────────────────────────────────────────────────────────── */
  .sc-head h1{ margin:12px 0 0; max-width:20ch; font-family:var(--ag-font-display,Georgia,serif);
    font-weight:800; font-size:clamp(1.9rem,4.4vw,2.8rem); line-height:1.03;
    letter-spacing:-.03em; color:var(--sc-ink); text-wrap:balance; }
  .sc-head > p{ margin:16px 0 0; max-width:58ch; font-size:16px; line-height:1.65;
    color:var(--sc-ink-2); text-wrap:pretty; }

  /* ── the deadline, and the way in ────────────────────────────────────────── */
  .sc-top{ margin-top:28px; display:grid; grid-template-columns:minmax(0,1fr) 320px;
    gap:20px; align-items:start; }
  .sc-panel{ border:1px solid var(--sc-line-2); border-radius:var(--sc-r);
    background:var(--sc-card); padding:18px 20px; }
  .sc-dl__k{ margin:0; font-family:var(--ag-font-mono,monospace); font-size:11px;
    font-weight:700; line-height:1; letter-spacing:.16em; text-transform:uppercase;
    color:var(--sc-mute); }
  .sc-dl__d{ margin:10px 0 0; font-family:var(--ag-font-display,Georgia,serif);
    font-weight:700; font-size:1.5rem; line-height:1.2; letter-spacing:-.02em;
    color:var(--sc-ink); }
  /* Sentence case would lose the shout this line is doing, and it quotes no units, so
     uppercase is safe here in a way it is not on the stand meta line below. */
  .sc-dl__c{ margin:8px 0 0; font-family:var(--ag-font-mono,monospace); font-size:11.5px;
    font-weight:700; line-height:1.5; letter-spacing:.1em; color:var(--sc-green-dark);
    font-variant-numeric:tabular-nums; }
  .sc-dl__n{ margin:12px 0 0; font-size:14px; line-height:1.6; color:var(--sc-ink-2); }

  .sc-apply{ display:flex; flex-direction:column; gap:14px; }
  .sc-cta{ display:inline-flex; align-items:center; justify-content:center; min-height:52px;
    padding:0 24px; border-radius:var(--ag-r-pill,999px); background:var(--sc-green-dark);
    color:#fff; font-weight:700; font-size:15.5px; text-decoration:none; text-align:center; }
  .sc-cta:hover{ background:#0d3716; color:#fff; }
  .sc-cta:focus-visible{ outline:3px solid var(--sc-green); outline-offset:3px; }
  .sc-facts{ list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:9px; }
  .sc-facts li{ display:flex; gap:9px; align-items:flex-start; font-size:13.5px;
    line-height:1.5; color:var(--sc-ink-2); }
  .sc-facts span{ flex:none; color:var(--sc-green); }

  /* A closed call is not an error. It is the sentence somebody arriving late is owed. */
  .sc-closed{ display:flex; align-items:flex-start; gap:11px; padding:16px 18px;
    border-radius:var(--sc-r-sm); background:var(--sc-cream); max-width:62ch;
    font-size:14px; line-height:1.65; color:var(--sc-ink-2); }
  .sc-closed svg{ flex:none; margin-top:2px; color:var(--sc-gold-ink); }
  .sc-closed b{ color:var(--sc-ink); font-weight:700; }

  /* Nothing published yet. Dashed, because the card is a placeholder for terms that do
     not exist — and it still asks something of the most motivated visitor this page will
     ever have, which one grey sentence did not. */
  .sc-notyet{ margin-top:28px; border:2px dashed var(--sc-line-3); border-radius:var(--sc-r);
    background:var(--sc-card); padding:24px; max-width:62ch; }
  .sc-notyet h2{ margin:10px 0 0; font-family:var(--ag-font-display,Georgia,serif);
    font-weight:700; font-size:1.3rem; line-height:1.2; letter-spacing:-.02em; color:var(--sc-ink); }
  .sc-notyet p{ margin:12px 0 0; font-size:14.5px; line-height:1.7; color:var(--sc-ink-2); }
  .sc-notify{ display:flex; flex-wrap:wrap; gap:10px; margin-top:18px; }
  .sc-notify input{ flex:1 1 16rem; min-height:44px; padding:0 14px;
    border:1px solid var(--sc-line-3); border-radius:var(--sc-r-sm); background:#fff;
    font-family:inherit; font-size:15px; color:var(--sc-ink); }
  .sc-notify input:focus-visible{ outline:3px solid var(--sc-green); outline-offset:2px; }
  .sc-notify button{ min-height:44px; padding:0 20px; cursor:pointer; border:none;
    border-radius:var(--ag-r-pill,999px); background:var(--sc-green-dark); color:#fff;
    font-family:inherit; font-weight:700; font-size:14px; }
  .sc-notify button:hover{ background:#0d3716; }
  .sc-notify button:focus-visible{ outline:3px solid var(--sc-green); outline-offset:3px; }
  .sc-notify__say{ margin:10px 0 0; font-size:13.5px; line-height:1.6; color:var(--sc-ink-2); }

  /* ── sections ────────────────────────────────────────────────────────────── */
  .sc-sec{ margin-top:var(--sc-sec); }
  .sc-sec__h{ padding-bottom:14px; border-bottom:1px solid var(--sc-line-3); }
  .sc-sec__h h2{ margin:10px 0 0; font-family:var(--ag-font-display,Georgia,serif);
    font-weight:700; font-size:clamp(1.2rem,2.6vw,1.65rem); line-height:1.18;
    letter-spacing:-.02em; color:var(--sc-ink); }
  .sc-lead{ margin:14px 0 0; max-width:62ch; font-size:14.5px; line-height:1.7;
    color:var(--sc-ink-2); text-wrap:pretty; }
  .sc-lead b{ color:var(--sc-ink); font-weight:700; }

  /* ── what you will be asked to upload ──────────────────────────────────── */
  .sc-routes{ margin-top:20px; display:grid; grid-template-columns:1fr 1fr; gap:16px; }
  .sc-route{ border:1px solid var(--sc-line-2); border-radius:var(--sc-r);
    background:var(--sc-card); padding:20px; }
  .sc-route__k{ margin:0; font-family:var(--ag-font-mono,monospace); font-size:10.5px;
    font-weight:700; line-height:1; letter-spacing:.18em; text-transform:uppercase;
    color:var(--sc-mute); }
  .sc-route__t{ margin:9px 0 0; font-family:var(--ag-font-display,Georgia,serif);
    font-weight:700; font-size:1.1rem; line-height:1.25; color:var(--sc-ink); }
  .sc-route ul{ list-style:none; margin:14px 0 0; padding:0; }
  .sc-route li{ display:grid; grid-template-columns:20px minmax(0,1fr); gap:10px;
    padding:11px 0; border-top:1px solid var(--sc-line); font-size:13.5px; line-height:1.55;
    color:var(--sc-ink-2); }
  .sc-route li b{ color:var(--sc-ink); font-weight:700; }
  .sc-route__y{ color:var(--sc-green); }
  .sc-route__q{ color:var(--sc-gold-ink); }
  /* Never colour alone: the conditional documents say in words who they apply to. */
  .sc-route__tag{ font-family:var(--ag-font-mono,monospace); font-size:10px; font-weight:700;
    line-height:1; letter-spacing:.12em; text-transform:uppercase; color:var(--sc-gold-ink); }
  .sc-route__f{ margin:14px 0 0; font-size:12.5px; line-height:1.6; color:var(--sc-mute); }
  .sc-bank{ margin-top:16px; display:flex; align-items:flex-start; gap:11px;
    padding:16px 18px; border-radius:var(--sc-r-sm); background:var(--sc-cream);
    max-width:74ch; font-size:14px; line-height:1.65; color:var(--sc-ink-2); }
  .sc-bank svg{ flex:none; margin-top:2px; color:var(--sc-gold-ink); }
  .sc-bank b{ color:var(--sc-ink); font-weight:700; }

  /* ── what is on offer ──────────────────────────────────────────────────── */
  .sc-offer{ margin-top:22px; display:flex; flex-direction:column; gap:12px; }
  .sc-card{ border:1px solid var(--sc-line-2); border-radius:var(--sc-r);
    background:var(--sc-card); padding:18px 20px; display:grid;
    grid-template-columns:minmax(0,1fr) 190px; column-gap:24px; row-gap:12px;
    align-items:start; }
  .sc-card__n{ font-family:var(--ag-font-display,Georgia,serif); font-weight:700;
    font-size:1.15rem; line-height:1.25; letter-spacing:-.01em; color:var(--sc-ink); }
  /* NOT uppercased. `text-transform` reaches the units too, and this line quotes
     physical dimensions: it rendered `1.8 × 0.75 M` and `9 M²`, and a capital M is
     not the metre. Mono at .1em tracking carries the same micro-label weight in
     sentence case, where the category names are correct English as well. */
  .sc-card__meta{ display:block; margin-top:6px; font-family:var(--ag-font-mono,monospace);
    font-size:10.5px; font-weight:700; letter-spacing:.1em; color:var(--sc-mute); }
  .sc-card__d{ margin:10px 0 0; max-width:58ch; font-size:13.5px; line-height:1.65;
    color:var(--sc-ink-2); }
  .sc-card__money{ text-align:right; }
  .sc-card__p{ font-family:var(--ag-font-mono,monospace); font-weight:700; font-size:1.15rem;
    font-variant-numeric:tabular-nums; color:var(--sc-ink); }
  .sc-card__dep{ display:block; margin-top:5px; margin-left:auto; max-width:17ch;
    font-size:11.5px; line-height:1.45; color:var(--sc-mute); }

  /* ── the quota meter ──────────────────────────────────────────────────────
     One pip per place, so "2 of 6" is a thing you see before you read it. Held is
     solid ink; open is the green wash with a ring so it reads on a monochrome
     print as well as on a screen — and the words beside it carry the whole fact,
     because a meter alone is a colour signal and this page never uses one. */
  .sc-quota{ grid-column:1 / -1; display:flex; align-items:center; flex-wrap:wrap; gap:14px;
    padding-top:12px; border-top:1px solid var(--sc-line); }
  .sc-pips{ display:flex; gap:4px; }
  .sc-pip{ width:20px; height:8px; border-radius:2px; background:var(--sc-ink); }
  .sc-pip--open{ background:rgba(35,123,34,.22); box-shadow:inset 0 0 0 1px rgba(35,123,34,.5); }
  /* Above ten places a row of pips is a smear. Same wording, proportional track. */
  .sc-bar{ width:140px; height:8px; border-radius:2px; overflow:hidden;
    background:rgba(35,123,34,.22); box-shadow:inset 0 0 0 1px rgba(35,123,34,.5); }
  .sc-bar span{ display:block; height:100%; background:var(--sc-ink); }
  .sc-q{ font-family:var(--ag-font-mono,monospace); font-size:11px; font-weight:700;
    letter-spacing:.1em; color:var(--sc-green-dark); }
  .sc-q--full{ display:inline-flex; align-items:center; gap:8px; color:var(--sc-full); }
  .sc-chip{ display:inline-flex; align-items:center; height:20px; padding:0 8px;
    border-radius:var(--sc-r-sm); background:var(--sc-cream); color:var(--sc-full);
    letter-spacing:.12em; }

  /* ── how it is decided ─────────────────────────────────────────────────── */
  .sc-steps{ list-style:none; margin:20px 0 0; padding:0;
    border-top:1px solid var(--sc-line-3); }
  .sc-steps li{ display:grid; grid-template-columns:30px minmax(0,1fr); column-gap:14px;
    align-items:baseline; padding:18px 0; border-bottom:1px solid var(--sc-line);
    font-size:14.5px; line-height:1.7; color:var(--sc-ink-2); }
  .sc-steps__n{ font-family:var(--ag-font-mono,monospace); font-size:11px; font-weight:700;
    letter-spacing:.14em; color:var(--sc-gold-ink); }
  .sc-steps strong{ display:block; color:var(--sc-ink); font-weight:700; }

  /* ── what we do not do ─────────────────────────────────────────────────── */
  .sc-band{ margin-top:var(--sc-sec); border-radius:var(--sc-r); background:var(--sc-ink);
    color:#fff; padding:34px 40px; display:grid; grid-template-columns:minmax(0,1fr) auto;
    column-gap:40px; row-gap:20px; align-items:center; }
  .sc-band .sc-kick{ color:var(--sc-gold); }
  .sc-band h2{ margin:12px 0 0; max-width:56ch; font-family:var(--ag-font-display,Georgia,serif);
    font-weight:700; font-size:1.4rem; line-height:1.3; letter-spacing:-.02em; color:#fff; }
  .sc-band p{ margin:12px 0 0; max-width:62ch; font-size:14px; line-height:1.7;
    color:rgba(255,255,255,.72); }
  .sc-cta--gold{ background:var(--sc-gold); color:var(--sc-ink); white-space:nowrap;
    padding:0 30px; }
  .sc-cta--gold:hover{ background:#ffc945; color:var(--sc-ink); }
  .sc-cta--gold:focus-visible{ outline:3px solid #fff; outline-offset:3px; }

  @media (max-width:820px){
    .sc-top,
    .sc-routes,
    .sc-band{ grid-template-columns:minmax(0,1fr); }
    .sc-band{ padding:26px 24px; }
  }
  @media (max-width:560px){
    .sc-card{ grid-template-columns:minmax(0,1fr); }
    .sc-card__money{ text-align:left; }
    .sc-card__dep{ margin-left:0; max-width:none; }
    .sc-cta{ width:100%; }
  }
</style>
{% endblock %}

{% block content %}
<div class="sc">

  <header class="sc-head">
    <span class="sc-kick">Vendor stands{% if event.location %} · {{ event.location }}{% endif %}
      {%- if event.event_date %} · {{ event.event_date|date('j F Y') }}{% endif %}</span>
    <h1>Trade at {{ event.title }}</h1>
    {% if call.intro %}
      <p>{{ call.intro }}</p>
    {% else %}
      <p>Stands are applied for and allocated against published quotas — not sold to whoever
        pays first. Everything that decides your application is on this page, and it was
        published before anybody applied.</p>
    {% endif %}
  </header>

  {% if not published %}
    {# ── NOTHING PUBLISHED YET ────────────────────────────────────────────────
       The terms stay private — there are none on this page and none in the source.
       What changes is that the page exists at all: a vendor who followed a link here
       used to be bounced to the event with a flash, which reads as though they asked
       for something that was never there. #}
    <div class="sc-notyet">
      <span class="sc-kick">Not published yet</span>
      <h2>The terms for this event are not published yet</h2>
      <p>Prices, pitch sizes, the number of places in each category and the closing date all
        go up on this page <em>before</em> the call opens, and none of them change afterwards.
        Nothing is allocated first-come, so arriving here on the first morning gains you
        nothing that arriving a week later does not.</p>
      <form class="sc-notify" method="post" action="/api/v1/newsletter/subscribe"
            data-ag-notify="{{ event.slug }}">
        <input type="hidden" name="_token" value="{{ csrf_token }}">
        <input type="hidden" name="source" value="stands:{{ event.slug }}">
        <label class="sr-only" for="scNotify">Your email address</label>
        <input id="scNotify" type="email" name="email" required autocomplete="email"
               placeholder="you@example.com">
        <button type="submit">Email me when it opens</button>
      </form>
      <p class="sc-notify__say" data-ag-notify-say hidden></p>
    </div>
  {% else %}

  {# ── THE DEADLINE, AND THE WAY IN ──────────────────────────────────────── #}
  <div class="sc-top">
    <div class="sc-panel">
      {% if accepting %}
        <p class="sc-dl__k">Applications close</p>
        <p class="sc-dl__d">{{ call.closes_at|date('l j F Y') }},
          {{ call.closes_at|date('g:i') }}&nbsp;{{ call.closes_at|date('a') }}</p>
        {# Server-rendered first, then refined. A countdown that only exists in JavaScript
           is blank for the reader who most needs it. #}
        <p class="sc-dl__c" {% if closing_soon %}data-ag-countdown="{{ closes_iso }}"
           aria-live="off"{% endif %}>{{ days_left is not null
             ? (closing_soon
                 ? (hours_left ~ ' HOURS LEFT')
                 : (days_left ~ ' DAY' ~ (days_left == 1 ? '' : 'S') ~ ' LEFT'))
             : 'OPEN' }} · {{ zone_label }}</p>
        <p class="sc-dl__n">Nothing is decided before then, and nothing is allocated
          first-come. Applying early buys you time to finish, not a better chance — where
          applications are otherwise equal the tiebreak is whoever became <em>complete</em>
          first.</p>
      {% else %}
        <p class="sc-closed" style="background:none;padding:0;max-width:none">
          <svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
          <span>
            {%- if call.closes_at and call.closes_at|slice(0,10) < "now"|date("Y-m-d") -%}
              <b>Applications closed on {{ call.closes_at|date('j F Y') }}.</b>
            {%- elseif call.opens_at -%}
              <b>Applications open on {{ call.opens_at|date('l j F Y') }}.</b>
            {%- else -%}
              <b>This call is not taking applications.</b>
            {%- endif %}
            Everything below is what was published, so you know what to expect next time.
          </span>
        </p>
      {% endif %}
    </div>

    {% if accepting %}
      <div class="sc-panel sc-apply">
        <a class="sc-cta" href="/events/{{ event.slug }}/stands/apply">Apply for a stand</a>
        <ul class="sc-facts">
          <li><span aria-hidden="true">✓</span>Applying costs nothing</li>
          <li><span aria-hidden="true">✓</span>No account needed first — the form creates one</li>
          <li><span aria-hidden="true">✓</span>You can edit it until the call closes</li>
          <li><span aria-hidden="true">✓</span>Everybody hears, with a reason</li>
        </ul>
      </div>
    {% endif %}
  </div>

  {# ── WHAT YOU WILL BE ASKED TO UPLOAD ──────────────────────────────────── #}
  <section class="sc-sec">
    <div class="sc-sec__h">
      <span class="sc-kick">Before you start</span>
      <h2>What you will be asked to upload</h2>
    </div>
    <p class="sc-lead">Applications are ranked by when they became <em>complete</em>, not when
      they were submitted. So this list is the one that decides whether you start the form
      today or go and find a certificate first. You do not need to be a registered company —
      most of the people who trade at our events are not.</p>

    <div class="sc-routes">
      <div class="sc-route">
        <p class="sc-route__k">Route A</p>
        <p class="sc-route__t">Individual or sole trader</p>
        <ul>
          <li><span class="sc-route__y">✓</span><span><b>Your full legal name</b></span></li>
          <li><span class="sc-route__y">✓</span><span><b>Government photo ID</b> — also what the pitch is checked against on the day</span></li>
          <li><span class="sc-route__y">✓</span><span><b>Public liability insurance</b>, in date on event day</span></li>
          <li><span class="sc-route__q" aria-hidden="true">+</span><span><b>Food hygiene certificate</b> — <span class="sc-route__tag">food and drink only</span></span></li>
        </ul>
        <p class="sc-route__f">No CAC registration is asked for, because you do not have one —
          and borrowing somebody else's number is worse than having none.</p>
      </div>

      <div class="sc-route">
        <p class="sc-route__k">Route B</p>
        <p class="sc-route__t">Registered business</p>
        <ul>
          <li><span class="sc-route__y">✓</span><span><b>CAC registration number</b> and the registered name</span></li>
          <li><span class="sc-route__y">✓</span><span><b>CAC certificate</b>, uploaded</span></li>
          <li><span class="sc-route__y">✓</span><span><b>Public liability insurance</b>, in date on event day</span></li>
          <li><span class="sc-route__q" aria-hidden="true">+</span><span><b>NAFDAC registration</b> — <span class="sc-route__tag">packaged food, drink, cosmetics only</span></span></li>
        </ul>
        <p class="sc-route__f">A lapsed certificate blocks confirmation, not the application —
          you are told at the offer, which leaves weeks to renew.</p>
      </div>
    </div>

    <p class="sc-bank">
      <svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="6" width="18" height="13" rx="2"/><path d="M3 10h18"/></svg>
      <span><b>Either way, the bank account we settle to must be in your own name.</b> We check
        that with your bank before anything is paid, we never store your account number, and
        money splits at the gateway — we never hold your takings.</span>
    </p>
  </section>

  {# ── WHAT IS ON OFFER, WITH THE QUOTA AGAINST IT ───────────────────────── #}
  <section class="sc-sec">
    <div class="sc-sec__h">
      <span class="sc-kick">The offer</span>
      <h2>What is on offer, and how much of it is left</h2>
    </div>
    <p class="sc-lead">The number of places in each category is fixed and published here.
      Places left over in one category do not move into another — so what is shown against
      each row is the whole of your competition, not a running total across the market.</p>
    <p class="sc-lead"><b>The price below is the whole price.</b> Pitch, the stated power, and
      the platform fee are in it. Table hire, extra power and anything else is quoted on the
      offer before you commit to a naira — there is nothing added at payment.</p>

    <div class="sc-offer">
      {% for c in capacity %}
        <article class="sc-card">
          <div>
            {# The SIZE first in the meta line, because it is the fact a vendor decides on.
               Somebody with a 6m rail cannot use a 2 × 2, and finding that out on the
               morning is the whole problem this line exists to prevent. #}
            <span class="sc-card__n">{{ c.type.name }}</span>
            <span class="sc-card__meta">{{ c.size }} ·
              {{ categories[c.type.category]|default(c.type.category) }} · {{ c.each_sqm }} m²
              {%- if c.type.includes_power %} · Power included{% else %} · No power{% endif %}
              {%- if c.type.step_free %} · Step-free{% endif %}</span>
            {% if c.type.description %}<p class="sc-card__d">{{ c.type.description }}</p>{% endif %}
          </div>
          <div class="sc-card__money">
            <span class="sc-card__p">₦{{ c.type.price_naira|number_format }}</span>
            <span class="sc-card__dep">
              {%- if c.type.deposit_naira > 0 -%}
                ₦{{ c.type.deposit_naira|number_format }} deposit on acceptance
              {%- else -%}No deposit{% endif -%}
            </span>
          </div>
          <div class="sc-quota">
            {% if c.quota > 0 and c.quota <= 10 %}
              <div class="sc-pips" aria-hidden="true">
                {% for i in 1..c.quota %}
                  <span class="sc-pip{{ i > c.taken ? ' sc-pip--open' : '' }}"></span>
                {% endfor %}
              </div>
            {% elseif c.quota > 10 %}
              <div class="sc-bar" aria-hidden="true">
                <span style="width:{{ (c.taken / c.quota * 100)|round }}%"></span>
              </div>
            {% endif %}
            {% if c.left > 0 %}
              <span class="sc-q">{{ c.left }} of {{ c.quota }} still open</span>
            {% else %}
              <span class="sc-q sc-q--full"><span class="sc-chip">FULL</span>All {{ c.quota }}
                held · you can still join the waiting list</span>
            {% endif %}
          </div>
        </article>
      {% else %}
        <p class="sc-lead" style="margin-top:0">Nothing has been published for this event yet.
          When it is, the prices and the quotas will be on this page before anybody can
          apply.</p>
      {% endfor %}
    </div>
  </section>

  {# ── HOW IT IS DECIDED ─────────────────────────────────────────────────── #}
  <section class="sc-sec">
    <div class="sc-sec__h">
      <span class="sc-kick">The decision</span>
      <h2>How your application is decided</h2>
    </div>
    <p class="sc-lead">Two stages, and they are different kinds of “no”.</p>
    <ol class="sc-steps">
      <li><span class="sc-steps__n" aria-hidden="true">01</span>
        <div><strong>Eligibility — a rule, not an opinion.</strong>
          Your certificates are on file and in date, and you are not suspended. Nothing is
          weighed here. If you fail it we tell you exactly what is missing, and you can fix
          it while the call is still open.</div></li>
      <li><span class="sc-steps__n" aria-hidden="true">02</span>
        <div><strong>Selection — a judgement, with a reason written down.</strong>
          Within each category, against the published quota. Two scorers who do not see each
          other's score. Where applications are otherwise equal, the tiebreak is whoever
          became <em>complete</em> first.</div></li>
      <li><span class="sc-steps__n" aria-hidden="true">03</span>
        <div><strong>An outcome either way.</strong>
          Everybody hears, and a refusal comes with the reason. You may ask for your score.
          If you are offered a stand you have {{ offer_hours }} hours to accept before the
          place goes to the waiting list.</div></li>
    </ol>
  </section>

  {# ── WHAT WE DO NOT DO ─────────────────────────────────────────────────────
     §8.2 verbatim, on the public page, because a limit of liability that only appears
     in a contract somebody signs after they are selected is a limit nobody read. The
     cancellation promise sits beside it deliberately: the same paragraph that says what
     we will not do says what we are bound to. #}
  <section class="sc-band">
    <div>
      <span class="sc-kick">What we do not do</span>
      <h2>Africa GATES is a record-keeper and a gatekeeper, not an auditor or an underwriter.</h2>
      <p>We verify that your documents exist, are in date and name you. We do not verify their
        authenticity and we do not inspect goods. If the event is cancelled, every vendor is
        refunded in full whatever the date — the cancellation ladder binds us the same way it
        binds you.</p>
    </div>
    {% if accepting %}
      <a class="sc-cta sc-cta--gold" href="/events/{{ event.slug }}/stands/apply">Apply for a stand</a>
    {% endif %}
  </section>

  {% endif %}
</div>
{% endblock %}

{% block foot_scripts %}
<script nonce="{{ csp_nonce }}">
(function () {
  'use strict';

  // ── THE COUNTDOWN ────────────────────────────────────────────────────────
  //
  // Only rendered inside the 48-hour window, and only ever a REFINEMENT: the server
  // already printed "9 HOURS LEFT", so a reader with no JavaScript — or one who arrives
  // before this file does — sees a true sentence rather than an empty line.
  //
  // Under prefers-reduced-motion it does not tick. The value is still correct on load
  // and on every navigation; what is suppressed is the second-by-second change, which is
  // motion in the sense that matters to somebody who asked for less of it.
  var el = document.querySelector('[data-ag-countdown]');
  if (el) {
    var ends = Date.parse(el.getAttribute('data-ag-countdown'));
    var zone = (el.textContent.split('·')[1] || '').trim();
    var still = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    var paint = function () {
      var left = Math.floor((ends - Date.now()) / 1000);
      if (!isFinite(left)) return;
      if (left <= 0) { el.textContent = 'CLOSED · ' + zone; return true; }
      var h = Math.floor(left / 3600),
          m = Math.floor((left % 3600) / 60),
          s = left % 60,
          pad = function (n) { return n < 10 ? '0' + n : String(n); };
      el.textContent = pad(h) + ':' + pad(m) + ':' + pad(s) + ' LEFT · ' + zone;
      return false;
    };

    if (paint() === false && !still) {
      var tick = setInterval(function () { if (paint()) clearInterval(tick); }, 1000);
    }
  }

  // ── EMAIL ME WHEN IT OPENS ───────────────────────────────────────────────
  //
  // Posts to the newsletter endpoint with a per-call source, so the row records which
  // event this person asked about rather than "somebody signed up somewhere". The reply
  // is written into the paragraph beneath, which is why the form does not navigate: a
  // full page load here would drop them back at the top of a page that still says the
  // terms are not published.
  var form = document.querySelector('[data-ag-notify]');
  var say  = document.querySelector('[data-ag-notify-say]');
  if (form && say) {
    form.addEventListener('submit', function (ev) {
      ev.preventDefault();
      var btn = form.querySelector('button');
      btn.disabled = true;
      say.hidden = false;
      say.textContent = 'Adding you…';

      fetch(form.getAttribute('action'), {
        method: 'POST',
        headers: { 'Accept': 'application/json' },
        body: new FormData(form)
      })
        .then(function (r) { return r.json(); })
        .then(function (j) {
          if (j && j.ok) {
            form.hidden = true;
            say.textContent = 'Done — we have your address against this event.';
          } else {
            btn.disabled = false;
            say.textContent = (j && j.message) || 'That did not go through. Try again in a moment.';
          }
        })
        .catch(function () {
          btn.disabled = false;
          say.textContent = 'That did not go through. Check your connection and try again.';
        });
    });
  }
})();
</script>
{% endblock %}
