{% extends "layout/gates.twig" %}

{% set topics = [
  {'t':'Voting','d':'How voting & OTP work','href':'/vote','tint':'#eef7ee','fg':'#1a6118','ico':'<path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>'},
  {'t':'Nominations','d':'Submit & track nominations','href':'/nominate','tint':'#fff8df','fg':'#7a5600','ico':'<circle cx="12" cy="8" r="5"/><path d="M8.2 12 7 22l5-3 5 3-1.2-10"/>'},
  {'t':'Profiles & accounts','d':'Claim & manage profiles','href':'/registry','tint':'#e9efef','fg':'#2b373d','ico':'<path d="M20 21a8 8 0 1 0-16 0"/><circle cx="12" cy="7" r="4"/>'},
  {'t':'Tickets & events','d':'Gala & event tickets','href':'/events','tint':'#f3eef7','fg':'#5b3a8a','ico':'<path d="M3 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2z"/><path d="M13 5v14"/>'},
  {'t':'Donations','d':'Donate & bonus votes','href':'/partner','tint':'#fdeaf0','fg':'#b03a5b','ico':'<path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8Z"/>'},
  {'t':'Privacy & security','d':'Data, hashing & cookies','href':'/privacy','tint':'#f0f2f2','fg':'#4a5256','ico':'<rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>'}
] %}
{% set faqs = [
  {'q':'How do I vote?','a':'Open any nominee or category, enter your email, and confirm the 6-digit code we send you. That records one verified vote — you can vote once per category per cycle.'},
  {'q':'Is voting free? Who can vote?','a':'Yes — voting is completely free and open to anyone, anywhere in the world. Voters 16 or older qualify automatically; under-16s may vote if they are in JSS&nbsp;1 or above. Donations and ticket purchases never affect anyone’s score.'},
  {'q':'How is the Cultural Power Index calculated?','a':'The CPI blends verified community votes, expert-jury scoring and documented impact into a single 0–1000 score, recomputed on a fixed schedule each cycle. See the full <a href="/integrity">methodology</a> for the exact weights and audit trail.'},
  {'q':'Can I nominate someone?','a':'Absolutely. Use the Nominate button, tell us who they are and why, and our panel verifies the profile before it joins the registry.'},
  {'q':'How is my email protected?','a':'We hash your email and never store it in plain text. It’s used only to verify you’re a real person voting once per category. See our <a href="/privacy">Privacy Policy</a>.'},
  {'q':'I think a vote count is wrong.','a':'Every recomputation is logged and independently audited. <a href="/support">Contact support</a> with the profile and we’ll replay the math from source for you, or open an appeal.'}
] %}

{% block head_styles %}
<style nonce="{{ csp_nonce }}">
  body[data-page="help"]{ background:#eef0ec; color:var(--ag-ink); }
  .hc{ max-width:920px; margin:0 auto; padding:clamp(2rem,5vw,2.9rem) var(--ag-gutter,32px) clamp(3rem,6vw,4rem); }

  .hc-hero{ text-align:center; }
  .hc-eyebrow{ margin:0 0 10px; font:600 12px/1 var(--ag-font-body); letter-spacing:.14em; text-transform:uppercase; color:var(--ag-green); }
  .hc-hero h1{ margin:0; font-family:var(--ag-font-display); font-weight:700; font-size:clamp(2rem,4.4vw,2.5rem); letter-spacing:-.02em; color:var(--ag-ink); }
  .hc-search{ display:flex; align-items:center; gap:11px; background:var(--ag-surface); border:1px solid rgba(16,41,44,.14); border-radius:14px; padding:14px 18px; margin:22px auto 0; max-width:520px; }
  .hc-search:focus-within{ border-color:var(--ag-green); }
  .hc-search input{ flex:1; border:none; outline:none; font-family:inherit; font-size:15px; color:var(--ag-ink); background:none; }

  .hc-tiles{ display:grid; grid-template-columns:repeat(3,1fr); gap:16px; margin-top:32px; }
  .hc-tile{ background:var(--ag-surface); border:1px solid rgba(16,41,44,.08); border-radius:18px; padding:22px; text-decoration:none; display:block; transition:transform .15s, box-shadow .15s, border-color .15s; }
  .hc-tile:hover{ transform:translateY(-2px); box-shadow:0 12px 28px -16px rgba(16,41,44,.4); border-color:rgba(16,41,44,.14); }
  .hc-tile__ico{ width:42px; height:42px; border-radius:12px; display:flex; align-items:center; justify-content:center; }
  .hc-tile__t{ font-weight:600; font-size:15.5px; color:var(--ag-ink); margin-top:14px; }
  .hc-tile__d{ font-size:12.5px; color:var(--ag-ink-soft); margin-top:4px; }

  .hc-h2{ margin:40px 0 18px; font-family:var(--ag-font-display); font-weight:700; font-size:1.5rem; color:var(--ag-ink); }
  .hc-faqs{ display:flex; flex-direction:column; gap:12px; }
  .hc-faq{ background:var(--ag-surface); border:1px solid rgba(16,41,44,.08); border-radius:16px; overflow:hidden; transition:border-color .15s; }
  .hc-faq.is-open{ border-color:#bfe0bd; }
  .hc-faq__q{ width:100%; cursor:pointer; border:none; background:none; text-align:left; display:flex; align-items:center; justify-content:space-between; gap:16px; padding:18px 22px; font-family:inherit; }
  .hc-faq__q span{ font-weight:600; font-size:15px; color:var(--ag-ink); }
  .hc-faq__plus{ flex:none; width:24px; height:24px; border-radius:50%; background:#f0f2f2; color:var(--ag-ink); display:flex; align-items:center; justify-content:center; font-size:17px; transition:transform .2s, background .2s, color .2s; }
  .hc-faq.is-open .hc-faq__plus{ transform:rotate(45deg); background:var(--ag-green); color:#fff; }
  .hc-faq__a{ margin:0; padding:0 22px 20px; font-size:14px; line-height:1.65; color:#4a5256; }
  .hc-faq__a a{ color:var(--ag-green); }
  .hc-empty{ text-align:center; padding:18px; color:var(--ag-ink-soft); font-size:14px; }

  .hc-contact{ position:relative; overflow:hidden; background:var(--ag-ink); border-radius:22px; padding:clamp(1.6rem,3vw,2.1rem); margin-top:24px;
    display:flex; align-items:center; justify-content:space-between; gap:24px; flex-wrap:wrap; }
  .hc-contact__orb{ position:absolute; right:-50px; top:-50px; width:200px; height:200px; border-radius:50%; background:radial-gradient(circle,rgba(127,200,124,.18),transparent 68%); }
  .hc-contact__txt{ position:relative; }
  .hc-contact__txt h2{ margin:0; font-family:var(--ag-font-display); font-weight:700; font-size:1.4rem; color:#fff; }
  .hc-contact__txt p{ margin:8px 0 0; font-size:14px; color:rgba(255,255,255,.78); }
  .hc-contact__btns{ position:relative; display:flex; gap:11px; flex-wrap:wrap; }
  .hc-btn{ cursor:pointer; border:none; font-family:inherit; font-weight:600; font-size:14.5px; padding:13px 24px; border-radius:999px; text-decoration:none; }
  .hc-btn--p{ background:var(--ag-green-light); color:var(--ag-ink); }
  .hc-btn--g{ border:1px solid rgba(255,255,255,.24); background:none; color:#fff; }

  @media (max-width:760px){ .hc-tiles{ grid-template-columns:1fr 1fr; } }
  @media (max-width:460px){ .hc-tiles{ grid-template-columns:1fr; } }
</style>
{% endblock %}

{% block content %}
<div class="hc" x-data="{ open:0, q:'' }">
  <div class="hc-hero">
    <p class="hc-eyebrow">Help Center</p>
    <h1>How can we help?</h1>
    <div class="hc-search">
      <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#5a6d6f" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
      <input type="search" x-model="q" placeholder="Search the FAQ…" aria-label="Search the FAQ">
    </div>
  </div>

  <div class="hc-tiles" x-show="q===''" x-cloak>
    {% for t in topics %}
      <a class="hc-tile" href="{{ t.href }}">
        <span class="hc-tile__ico" style="background:{{ t.tint }};color:{{ t.fg }}">
          <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{{ t.ico|raw }}</svg>
        </span>
        <div class="hc-tile__t">{{ t.t }}</div>
        <div class="hc-tile__d">{{ t.d }}</div>
      </a>
    {% endfor %}
  </div>

  <h2 class="hc-h2">Frequently asked</h2>
  <div class="hc-faqs">
    {% for f in faqs %}
      {% set i = loop.index0 %}
      <div class="hc-faq" :class="open==={{ i }} && 'is-open'" x-show="q==='' || $el.textContent.toLowerCase().includes(q.toLowerCase())">
        <button type="button" class="hc-faq__q" @click="open = open==={{ i }} ? -1 : {{ i }}" :aria-expanded="open==={{ i }}" aria-controls="hc-faq-a-{{ i }}">
          <span>{{ f.q|raw }}</span>
          <span class="hc-faq__plus" aria-hidden="true">+</span>
        </button>
        <p class="hc-faq__a" id="hc-faq-a-{{ i }}" x-show="open==={{ i }}" x-cloak>{{ f.a|raw }}</p>
      </div>
    {% endfor %}
  </div>

  <div class="hc-contact">
    <div class="hc-contact__orb" aria-hidden="true"></div>
    <div class="hc-contact__txt">
      <h2>Still need help?</h2>
      <p>Most answers are above — if not, our team replies within one business day.</p>
    </div>
    <div class="hc-contact__btns">
      <a class="hc-btn hc-btn--p" href="mailto:{{ support_email }}?subject=GATES%20help">Email support</a>
      <button type="button" class="hc-btn hc-btn--g" data-ag-do="open-gee">Ask Gee</button>
    </div>
  </div>
</div>
{% endblock %}
