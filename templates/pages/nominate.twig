{% extends 'layout/shell.twig' %}

{#
  ══════════════════════════════════════════════════════════════════════════════
  NOMINATE — THE HUB
  design/NominateHub.dc.html · phase §8.16
  ══════════════════════════════════════════════════════════════════════════════

  One question: which award? Everything after it belongs to that award's own page,
  `/nominate/{slug}`, where the words, the categories and the accepted kinds of
  nominee are its own.

  ── WHAT THIS REPLACED, AND WHY NONE OF IT SURVIVED ─────────────────────────

  A 640-line single template holding a five-step Alpine wizard, the award chooser,
  forty-three inline `style` attributes and its own copies of the field labels. It
  worked, and it could not be extended: every award shared one set of nouns, so a
  form under the heading *Carol Awards* asked a choirmaster for a person's full
  name, and there was nowhere to put a second category because the markup assumed
  one.

  Rebuilt rather than patched, which was the instruction and is also the only way
  the per-award wording can exist at all.

  ── EVERY ROW IS A LINK, AND THAT IS THE WHOLE PAGE ─────────────────────────

  No JavaScript runs here. The list is server-rendered from the same
  `getActiveProgrammesWithStatus()` every other award surface reads, so an award
  cannot appear here and be closed there.
#}

{% block head_styles %}
  <link rel="stylesheet" href="{{ asset('/assets/css/components/nominate.css') }}">
{% endblock %}

{# The site header on tablet and desktop, the app bar on the phone. Both are in the
   document and CSS chooses, at one breakpoint, so there is no width with two chromes
   and none with neither. #}
{% block header %}{% include 'partials/site-header.twig' %}{% endblock %}

{% block app_bar %}
  {% include 'partials/app-bar.twig' with { variant: 'root', title: 'Nominate' } %}
{% endblock %}

{% block content %}
<div class="nh">

  {% if share_expired %}
    <p class="nf__err" role="alert">That shared nomination link has expired. You can still
      nominate — choose the award below.</p>
  {% endif %}

  <p class="nh__lede">Put someone forward for continental recognition. Choose the award
    you are nominating for; each one asks its own questions.</p>

  {% if programmes is empty %}
    {# ── NOTHING OPEN, SAID PLAINLY ──────────────────────────────────────
       An empty list with no sentence reads as the page having failed to load. This
       says which state the platform is in and offers the two things that are still
       true. #}
    <section class="ag-empty">
      <p class="ag-empty__t">No award is taking nominations right now.</p>
      <p class="nh__lede">Nominations open for each award on its own dates. The awards
        page lists every edition and when its next window opens.</p>
      <div class="nh__do">
        <a class="ag-btn ag-btn--primary" href="/awards">See every award</a>
        <a class="ag-btn ag-btn--secondary" href="/results">Results already announced</a>
      </div>
    </section>
  {% else %}
    <h2 class="nh__h">Open for nominations</h2>
    <nav class="ag-list nh__list" aria-label="Awards open for nominations">
      {% for p in programmes %}
        <a class="ag-list__row nh__row" href="/nominate/{{ p.slug }}">
          <span class="ag-icon-tile ag-tint--gold" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 16 3 6l5 4 4-6 4 6 5-4-2 10z"></path></svg>
          </span>
          <span class="nh__txt">
            <span class="ag-list__label">{{ p.title }}</span>
            <span class="nh__meta">
              {% if p.subtitle %}{{ p.subtitle }}{% else %}{{ p.categories|length }}
                {{ p.categories|length == 1 ? 'category' : 'categories' }}{% endif %}
              {% if p.nominations_close %}
                · closes {{ p.nominations_close|when('j M') }}
              {% endif %}
            </span>
          </span>
          <span class="ag-list__chev" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m9 6 6 6-6 6"></path></svg>
          </span>
        </a>
      {% endfor %}
    </nav>
  {% endif %}

  {% if closed is not empty %}
    <h2 class="nh__h">Not open right now</h2>
    <nav class="ag-list nh__list" aria-label="Awards not taking nominations">
      {% for p in closed %}
        {# Linked, not greyed out. An award somebody came here for is a page they are
           owed — it says which phase it is in and when the window opens. A row that
           cannot be pressed answers nothing. #}
        <a class="ag-list__row nh__row" href="/nominate/{{ p.slug }}">
          <span class="ag-icon-tile ag-tint--neutral" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 11V8a7 7 0 0 1 14 0v3M4 11h16v10H4z"></path></svg>
          </span>
          <span class="nh__txt">
            <span class="ag-list__label">{{ p.title }}</span>
            <span class="nh__meta">{{ p.phase.label|default(p.cycle_status) }}</span>
          </span>
          <span class="ag-list__chev" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m9 6 6 6-6 6"></path></svg>
          </span>
        </a>
      {% endfor %}
    </nav>
  {% endif %}
</div>
{% endblock %}

{% block bottom_bar %}
  {% include 'partials/tab-bar.twig' with { active: 'nominate' } %}
{% endblock %}
