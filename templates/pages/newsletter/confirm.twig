{% extends "layout/gates.twig" %}
{#
  /email/confirm — the yes. Three states, and each says exactly one thing.

  The GET renders a button rather than confirming, because mail scanners fetch every
  link in a message and would otherwise confirm on the reader's behalf — see
  NewsletterController.
#}

{% block head_styles %}
  <link rel="stylesheet" href="{{ asset('/assets/css/components/newsletter.css') }}">
{% endblock %}

{% block content %}
<div class="nl nl--task">
  <section class="ag-card nl__card">
    {% if done and valid %}
      <p class="nl__kicker">Confirmed</p>
      <h1 class="nl__h1">You are on the list</h1>
      <p class="nl__p">The newsletter will reach <b class="nl__mail">{{ email }}</b>. Every
        issue ends with a one-click unsubscribe.</p>
      <a class="ag-btn ag-btn--secondary" href="/">Back to Africa GATES</a>

    {% elseif valid %}
      <p class="nl__kicker">Newsletter</p>
      <h1 class="nl__h1">Confirm your subscription</h1>
      <p class="nl__p">Send the Africa GATES newsletter to <b class="nl__mail">{{ email }}</b>?</p>
      <form class="ag-form" method="post" action="/email/confirm">
        <input type="hidden" name="_token" value="{{ csrf_token }}">
        <input type="hidden" name="e" value="{{ e }}">
        <input type="hidden" name="t" value="{{ t }}">
        <button type="submit" class="ag-btn ag-btn--primary">Yes, send it to me</button>
      </form>
      <p class="ag-hint">Did not ask for this? Close the page. Nothing is sent to an address
        that has not been confirmed.</p>

    {% else %}
      <p class="nl__kicker">Newsletter</p>
      <h1 class="nl__h1">This link did not work</h1>
      <p class="nl__p">It may have been broken across two lines by your email app. Copy the
        whole link from the email into your browser, or ask for a new one.</p>
      <a class="ag-btn ag-btn--secondary" href="/newsletter">Sign up again</a>
    {% endif %}
  </section>
</div>
{% endblock %}
