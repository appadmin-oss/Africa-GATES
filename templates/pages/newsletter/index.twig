{% extends "layout/gates.twig" %}
{#
  /newsletter — what the newsletter is, and the form to join it.

  Every structural fact on this page is read from the code that acts on it: the day it
  goes out from NewsletterSchedule::describe(), what is in it from
  NewsletterComposer::SECTIONS. A page that types "every Thursday" goes on saying it the
  week somebody moves the send to Monday.

  The form posts. It does not need JavaScript, and the page it lands on says the one thing
  the person has to do next — open the confirmation email — because until they do,
  nothing arrives.
#}
{% import "partials/ui.twig" as ui %}

{% block head_styles %}
  <link rel="stylesheet" href="{{ asset('/assets/css/components/newsletter.css') }}">
{% endblock %}

{% block content %}
<div class="nl">
  <header class="nl__head">
    <p class="nl__kicker">Newsletter</p>
    <h1 class="nl__h1">Africa GATES in your inbox</h1>
    <p class="nl__lede">What is open for nominations, when voting closes, results as they
      are announced, and the events around them. Every line links to the page that states it.</p>
  </header>

  {% if sent %}
    <section class="ag-card nl__card" aria-labelledby="nlSent">
      <h2 id="nlSent" class="nl__h2">Check your inbox</h2>
      <p class="nl__p">We have sent a confirmation email. Press the button in it and you are
        on the list. Nothing else is sent to an address until it is confirmed.</p>
      <p class="ag-hint">Not there in a few minutes? Look in spam or promotions, or try again
        tomorrow — we send one confirmation a day to any address.</p>
    </section>
  {% else %}
    <section class="ag-card nl__card" aria-labelledby="nlJoin">
      <h2 id="nlJoin" class="nl__h2">Join the list</h2>
      <form class="ag-form" method="post" action="/newsletter" data-ag-validate novalidate>
        <input type="hidden" name="_token" value="{{ csrf_token }}">
        <label class="ag-label" for="nlEmail">Email address</label>
        <input id="nlEmail" class="ag-field" type="email" name="email" required maxlength="190"
               value="{{ old }}" inputmode="email" autocomplete="email" enterkeyhint="send"
               {% if email_error %}aria-invalid="true" aria-describedby="nlErr"{% endif %}>
        {% if email_error %}<p id="nlErr" class="ag-err" role="alert">{{ email_error }}</p>{% endif %}
        <button type="submit" class="ag-btn ag-btn--primary">Send me the newsletter</button>
      </form>
      <p class="ag-hint">One confirmation email first. Every issue has a one-click unsubscribe.</p>
    </section>
  {% endif %}

  <section class="nl__sec" aria-labelledby="nlWhen">
    <h2 id="nlWhen" class="nl__h2">When it arrives</h2>
    <p class="nl__p">
      {% if schedule %}{{ schedule }}.{% else %}The first issue has not been scheduled yet. Confirm now and it is the first thing you receive.{% endif %}
      An issue goes out only when there is something new to say — a week with nothing open,
      announced or coming up is a week without an email.
    </p>
    {% if holidays %}
      <p class="nl__p">And a greeting on {{ holidays|slice(0, -1)|join(', ') }}{{ holidays|length > 1 ? ' and ' : '' }}{{ holidays|last }}.</p>
    {% endif %}
  </section>

  <section class="nl__sec" aria-labelledby="nlWhat">
    <h2 id="nlWhat" class="nl__h2">What is in it</h2>
    {{ ui.ticks(sections) }}
  </section>
</div>
{% endblock %}
