{% extends "layout/gates.twig" %}

{# ── THE NOMINEE'S QUESTIONNAIRE, TWO WAYS ────────────────────────────────────

   The first version of this page was a form nearly five thousand pixels tall: eleven
   questions, each with help text, then a works list, then a submit panel. A reasonable form
   and an intimidating one. The person reading it is a teacher with an hour after school, on a
   phone, who has never used this site.

   So there are two modes over ONE saved draft:

     • A CONVERSATION, which is the default. One question at a time, with a follow-up when an
       answer has no number or no place in it. Whatever is said is stored verbatim — the model
       chooses what to ask, never what the answer says.

     • THE FORM, for somebody who would rather see everything at once, or come back and edit
       one line. Switching does not lose anything: both write the same answers.

   Everything else follows from who is reading:

     • PROGRESS IS ALWAYS VISIBLE. "3 of 5 needed" beats a scrollbar as an answer to "how much
       longer is this".
     • THE READINESS CHECK IS HELP, NOT A SCORE. Before sending, it names the answers a judge
       will find thin — "this has no number in it" — so the fix happens now rather than after
       the panel has read it.
     • FAILURE IS EXPLICITLY SAFE, twice, because somebody who thinks an honest answer about
       what went wrong will cost them the award writes nothing useful.
     • AND NOTHING COSTS MONEY, said twice, because a fee demand is the commonest way an
       awards scheme is impersonated and this email lands with exactly the people that is
       aimed at.

   The form works with JavaScript off. The conversation cannot — so the form is always
   reachable, never hidden behind a toggle that needs script to un-toggle. #}

{% block head_styles %}
<style nonce="{{ csp_nonce }}">
  .mw{ max-width:760px; margin:0 auto; padding:34px 20px 80px }
  .mw__kick{ display:inline-flex; align-items:center; gap:7px; font-size:11.5px; font-weight:700;
    letter-spacing:.09em; text-transform:uppercase; color:#1c5f1b; background:#eaf7ea;
    border-radius:999px; padding:6px 13px }
  .mw h1{ margin:14px 0 0; font-size:clamp(1.35rem, 1.1rem + 1.2vw, 1.9rem); letter-spacing:-.015em;
    color:#10292C; line-height:1.25 }
  .mw__lede{ margin:12px 0 0; font-size:15px; line-height:1.75; color:#3d5254 }
  .mw__card{ margin-top:16px; background:#fff; border:1px solid rgba(16,41,44,.1); border-radius:18px;
    padding:22px 20px; box-shadow:0 1px 2px rgba(16,41,44,.04), 0 14px 40px -30px rgba(16,41,44,.3) }
  .mw__card h2{ margin:0 0 4px; font-size:16px; color:#10292C }
  .mw__card p{ margin:9px 0 0; font-size:13.5px; line-height:1.7; color:#5a6d6f }

  /* progress — sticky, because "how much longer" is the question people abandon over */
  .mw__prog{ position:sticky; top:0; z-index:5; margin:16px 0 0; background:#10292c; color:#eaf2ec;
    border-radius:14px; padding:12px 16px; display:flex; align-items:center; gap:12px; flex-wrap:wrap }
  .mw__bar{ flex:1 1 120px; height:7px; border-radius:99px; background:rgba(255,255,255,.18); overflow:hidden }
  .mw__bar i{ display:block; height:100%; background:#8fd48c; border-radius:99px; transition:width .3s }
  .mw__prog b{ font-size:13px; font-weight:700 }
  .mw__prog span{ font-size:12px; color:#a8c4b3 }

  /* mode switch */
  .mw__modes{ display:flex; gap:8px; margin-top:14px }
  .mw__mode{ cursor:pointer; flex:1 1 0; font:650 13.5px/1.3 inherit; padding:12px 10px;
    border-radius:12px; border:1px solid rgba(16,41,44,.16); background:#fff; color:#3d5254 }
  .mw__mode[aria-pressed="true"]{ background:#10292c; color:#fff; border-color:#10292c }
  .mw__mode small{ display:block; font-weight:400; font-size:11.5px; margin-top:3px; opacity:.72 }
  /* On the selected (dark) button the subtitle was washed out to near-invisible. Raised
     rather than removed: it is the line that explains the choice somebody has just made. */
  .mw__mode[aria-pressed="true"] small{ opacity:.92; color:#cfe6d3 }

  /* the conversation */
  .mw__chat{ margin-top:6px; display:flex; flex-direction:column; gap:10px; max-height:58vh;
    overflow-y:auto; padding:4px 2px 2px }
  .mw__msg{ max-width:88%; font-size:14.5px; line-height:1.65; border-radius:14px; padding:12px 14px;
    white-space:pre-wrap; word-break:break-word }
  .mw__msg--ai{ align-self:flex-start; background:#f1f6f1; color:#22332c; border:1px solid rgba(16,41,44,.08) }
  .mw__msg--you{ align-self:flex-end; background:#237b22; color:#fff }
  .mw__typing{ align-self:flex-start; font-size:12.5px; color:#67797b; padding:4px 6px }
  .mw__ask{ display:flex; gap:9px; align-items:flex-end; margin-top:12px }
  .mw__say{ flex:1 1 auto; box-sizing:border-box; font:inherit; font-size:15.5px; line-height:1.55;
    color:#10292C; border:1px solid rgba(16,41,44,.2); border-radius:14px; padding:12px 13px;
    min-height:52px; max-height:180px; resize:none }
  .mw__say:focus{ outline:none; border-color:#237b22; box-shadow:0 0 0 3px rgba(35,123,34,.12) }
  .mw__send{ cursor:pointer; flex:0 0 auto; background:#237b22; color:#fff; border:none;
    border-radius:14px; padding:0 18px; height:52px; font:700 14.5px/1 inherit }
  .mw__send:disabled{ opacity:.5; cursor:default }
  .mw__hint{ margin-top:8px; font-size:12px; color:#8a969a }
  .mw__skip{ cursor:pointer; background:none; border:none; padding:0; font:600 12px/1 inherit;
    color:#237b22; text-decoration:underline }

  /* voice — only rendered when an ElevenLabs key is configured */
  .mw__vbar{ display:flex; align-items:center; gap:10px; flex-wrap:wrap; margin:0 0 12px;
    padding:10px 12px; background:#f6faf6; border:1px solid rgba(16,41,44,.09); border-radius:12px }
  .mw__vsw{ cursor:pointer; display:inline-flex; align-items:center; gap:8px; background:none;
    border:1px solid rgba(16,41,44,.2); border-radius:999px; padding:7px 13px;
    font:650 12.5px/1 inherit; color:#10292C }
  .mw__vsw[aria-pressed="true"]{ background:#10292c; color:#fff; border-color:#10292c }
  .mw__vnote{ font-size:12px; color:#67797b; flex:1 1 160px; min-width:0 }
  /* The speaker sits BESIDE the bubble rather than under it, so a column of ten questions
     does not become a column of ten buttons competing with the words. The row carries the
     alignment now that a message is no longer the flex child of the log. */
  .mw__row{ display:flex; align-items:flex-end; gap:6px; max-width:90% }
  .mw__row--ai{ align-self:flex-start }
  .mw__row--you{ align-self:flex-end }
  .mw__row .mw__msg{ max-width:100% }
  .mw__spk{ cursor:pointer; flex:0 0 auto; background:#fff; border:1px solid rgba(16,41,44,.15);
    border-radius:999px; width:30px; height:30px; padding:0; font-size:13px; line-height:1;
    color:#237b22 }
  .mw__spk[aria-pressed="true"]{ background:#237b22; color:#fff; border-color:#237b22 }
  .mw__mic{ cursor:pointer; flex:0 0 auto; width:52px; height:52px; border-radius:14px;
    background:#fff; border:1px solid rgba(16,41,44,.2); font-size:19px; line-height:1; color:#10292C }
  .mw__mic--on{ background:#b3261e; border-color:#b3261e; color:#fff; animation:mwPulse 1.3s infinite }
  .mw__mic:disabled{ opacity:.5; cursor:default }
  @keyframes mwPulse{ 0%,100%{ box-shadow:0 0 0 0 rgba(179,38,30,.45) }
                      50%{ box-shadow:0 0 0 7px rgba(179,38,30,0) } }
  .mw__rec{ margin-top:8px; font-size:12.5px; font-weight:650; color:#b3261e }
  @media (prefers-reduced-motion: reduce){ .mw__mic--on{ animation:none } }

  /* the spoken introduction */
  .mw__intro{ border-color:rgba(35,123,34,.28) }
  .mw__introrow{ display:flex; gap:12px; align-items:center; margin-top:14px }
  .mw__introhint{ font-size:13px; line-height:1.6; color:#5a6d6f }
  .mw__introtext{ margin:7px 0 0; font-size:14px; line-height:1.7; color:#3d5254;
    background:#f6faf6; border:1px solid rgba(16,41,44,.09); border-radius:12px;
    padding:12px 14px; white-space:pre-wrap }
  .mw__introacts{ display:flex; gap:9px; flex-wrap:wrap; margin-top:12px }
  .mw__consent{ margin-top:14px; background:#fffdf5; border:1px solid #ecd9a0;
    border-radius:12px; padding:14px 16px }
  .mw__consent p{ margin:0; font-size:13px; line-height:1.7; color:#6b5312 }

  /* the form as a sequence */
  .mw__steptop{ margin:0 0 14px }
  .mw__steps{ display:flex; gap:9px; align-items:center; flex-wrap:wrap; margin-top:16px;
    padding-top:14px; border-top:1px solid rgba(16,41,44,.08) }
  .mw__seek{ margin:7px 0 0; font-size:12.5px; line-height:1.6; color:#1c5f1b;
    background:#f2f9f2; border-radius:9px; padding:8px 11px }
  /* Help, never a mark. No number, no percentage, no traffic light with a score behind it. */
  .mw__coach{ margin-top:11px; font-size:12.5px; line-height:1.65; padding:11px 13px;
    border-radius:11px; background:#fffdf5; border:1px solid #ecd9a0; color:#6b5312 }
  .mw__coach--ok{ background:#f0fdf4; border-color:#b6e3b6; color:#1c5f1b }
  .mw__coach b{ display:block; margin-bottom:3px }

  /* the form */
  .mw__q{ padding:18px 0; border-top:1px solid rgba(16,41,44,.08) }
  .mw__q:first-of-type{ border-top:none; padding-top:4px }
  .mw__lab{ display:block; font-size:15px; font-weight:600; line-height:1.5; color:#10292C }
  .mw__req{ color:#8a2020; font-weight:700 }
  .mw__help{ margin:7px 0 0; font-size:13px; line-height:1.65; color:#67797b }
  .mw__crit{ display:inline-block; margin-top:8px; font-size:10.5px; font-weight:700;
    letter-spacing:.06em; text-transform:uppercase; color:#1c5f1b; background:#eaf7ea;
    border-radius:999px; padding:3px 9px }
  .mw__in{ width:100%; box-sizing:border-box; margin-top:10px; font:inherit; font-size:15px;
    line-height:1.6; color:#10292C; border:1px solid rgba(16,41,44,.2); border-radius:12px;
    padding:12px 13px; background:#fff }
  textarea.mw__in{ min-height:104px; resize:vertical }
  .mw__in:focus{ outline:none; border-color:#237b22; box-shadow:0 0 0 3px rgba(35,123,34,.12) }
  .mw__done{ font-size:11.5px; font-weight:700; color:#237b22; margin-top:6px }

  /* works */
  .mw__work{ border:1px solid rgba(16,41,44,.13); border-radius:14px; padding:15px 15px 6px;
    margin-top:12px; background:#fbfdfb }
  .mw__grid{ display:grid; gap:10px; grid-template-columns:repeat(auto-fit,minmax(min(100%,210px),1fr)) }
  .mw__slab{ display:block; font:700 10px/1 var(--ag-font-body,inherit); letter-spacing:.08em;
    text-transform:uppercase; color:#5a6d6f; margin:0 0 5px }
  .mw__file{ margin-top:10px; font-size:12.5px; color:#3d5254; background:#eef4ee;
    border-radius:9px; padding:9px 11px; display:flex; gap:8px; align-items:center; flex-wrap:wrap }
  .mw__drop{ margin-top:9px; font-size:12.5px; color:#67797b }
  .mw__x{ cursor:pointer; background:none; border:none; color:#8a2020; font:600 12.5px/1 inherit;
    text-decoration:underline; padding:6px 0; margin:0 0 8px }
  .mw__add{ margin-top:12px; background:#fff; color:#10292C; border:1px dashed rgba(16,41,44,.3);
    border-radius:12px; padding:12px; width:100%; font:600 13.5px/1 inherit; cursor:pointer }
  .mw__mini{ cursor:pointer; background:#10292C; color:#fff; border:none; border-radius:999px;
    padding:9px 15px; font:600 12.5px/1 inherit }

  .mw__go{ margin-top:18px; width:100%; background:#237b22; color:#fff; border:none;
    border-radius:999px; padding:16px 24px; font:700 15.5px/1 inherit; cursor:pointer; min-height:50px }
  .mw__go:hover{ background:#1c631b }
  .mw__ghost{ margin-top:10px; width:100%; background:none; color:#10292C;
    border:1px solid rgba(16,41,44,.22); border-radius:999px; padding:13px 24px;
    font:600 14px/1 inherit; cursor:pointer; min-height:46px }

  .mw__ok{ background:#f0fdf4; border:1px solid #b6e3b6; border-left:4px solid #237b22;
    border-radius:0 14px 14px 0; padding:15px 17px; margin-top:16px; font-size:14.5px;
    line-height:1.7; color:#22551f }
  .mw__bad{ background:#fdf3f3; border:1px solid #f0c9c9; border-left:4px solid #b3261e;
    border-radius:0 14px 14px 0; padding:15px 17px; margin-top:16px; font-size:14.5px;
    line-height:1.7; color:#8a2020 }
  .mw__bad ul, .mw__tip ul{ margin:9px 0 0; padding-left:20px }
  .mw__tip{ background:#fffdf5; border:1px solid #ecd9a0; border-radius:12px; padding:14px 16px;
    margin-top:14px; font-size:13.5px; line-height:1.7; color:#6b5312 }
  .mw__free{ margin-top:22px; font-size:13px; line-height:1.75; color:#5a6d6f;
    border-top:1px solid rgba(16,41,44,.09); padding-top:18px }
  .mw__free b{ color:#10292c }
  .mw__sent{ background:#f0fdf4; border:1px solid #b6e3b6; border-radius:16px; padding:22px }
  @media (max-width:520px){
    .mw__modes{ flex-direction:column }
    .mw__msg{ max-width:96% }
  }
</style>
{% endblock %}

{% block content %}
<div class="mw">

{% if form is null %}
  <div class="mw__card">
    <h1>This link is not working</h1>
    <p class="mw__lede">It may have been replaced by a newer one, or the questionnaire may have
      closed. Nothing has gone wrong with your nomination.</p>
    <p class="mw__lede">Write to
      <a href="mailto:{{ support_email }}">{{ support_email }}</a> with your name and the award you
      were nominated for, and a person will send you a fresh link.</p>
    <p class="mw__free"><b>Nothing about being nominated costs money.</b> If anybody asks you to
      pay a fee for a nomination, an interview or a result, it is not us.</p>
  </div>

{% else %}
  {% if form.is_test|default(false) %}
    {# On the nominee's own page, not only the admin one. If a test link is ever pasted into a
       message by mistake, the person who opens it must be told what it is rather than spending
       an evening describing work that nobody is going to read. #}
    <div class="mw__tip">
      <strong>This is a test page, not a real questionnaire.</strong> Somebody on the awards team
      created it to check how these questions read. Nothing written here goes to a judging panel,
      and it is not attached to any nomination. If you were expecting your own questionnaire,
      write to <a href="mailto:{{ support_email }}">{{ support_email }}</a> and a person will send
      you the right link.
    </div>
  {% endif %}
  <span class="mw__kick">📝 For the judging panel</span>
  <h1>{{ form.nominee }} — tell the judges about your work</h1>
  <p class="mw__lede">
    You have been nominated{% if form.category %} in <strong>{{ form.category }}</strong>{% endif %}.
    Right now the judges have only what the person who nominated you wrote. This is where you
    describe the work yourself and show them anything that exists.
    {% if form.deadline %}Please send it before <strong>{{ form.deadline }}</strong>.{% endif %}
  </p>

  {% if notice %}<div class="mw__ok">{{ notice }}</div>{% endif %}
  {% if error %}
    <div class="mw__bad">{{ error }}
      {% if missing|length %}<ul>{% for m in missing %}<li>{{ m }}</li>{% endfor %}</ul>{% endif %}
    </div>
  {% endif %}

  {% if form.submitted %}
    <div class="mw__card mw__sent">
      <h2>This has gone to the judging panel</h2>
      <p>Sent on {{ form.submitted_at }}{% if form.declared_name %} by {{ form.declared_name }}{% endif %}.
         The panel can now read your answers and see everything you attached, alongside the
         nomination itself.</p>
      <p>If something needs correcting, write to
        <a href="mailto:{{ support_email }}">{{ support_email }}</a> and we will re-open it for you.
        Nothing you send later is held against the earlier version.</p>
    </div>
    <p class="mw__free"><b>Nothing about this costs money</b>, at any stage.</p>

  {% elseif not intro_ready %}
    {# ══ THE BRIEF ═══════════════════════════════════════════════════════════
         Before the first question, because the questionnaire used to open with a greeting
         and then ask about impact — leaving somebody to guess how long it takes, what a
         usable answer looks like, whether a half-finished draft is safe, and what happens
         to any of it. The people worst served by not knowing are the ones who will never
         ask. It costs twenty seconds and it changes what a panel receives.

         A form POST, not a link: this records that a person read something, and a mail
         scanner following every URL in a message must not be able to record it for them. #}
    <div class="mw__card">
      <h2 style="font-size:19px">Before you start — what this is, and what happens to it</h2>
      {% for p in brief %}
        <p class="mw__lede" style="margin-top:14px">{{ p }}</p>
      {% endfor %}
      <form method="post" action="/my-work/{{ token }}/ready">
        <input type="hidden" name="_token" value="{{ csrf_token }}">
        <button class="mw__go" type="submit">I have read this — let's start</button>
      </form>
      <p class="mw__hint" style="text-align:center">
        You can come back to this link at any time. Nothing is sent to the judges until you
        press the send button yourself.
      </p>
    </div>

  {% else %}
    {# ══ everything below shares ONE Alpine scope: the two modes, the chat, and the works
         list. The form fields themselves are plain inputs with names, so the form still
         submits with JavaScript switched off. ══ #}
    <div x-data='{
      mode: {{ (chat.turns|length > 0 ? "chat" : (readiness.missing|length == 0 and chat.progress.answered|default(0) > 0 ? "form" : "chat"))|json_encode }},
      turns: {{ (chat.turns ?? [])|json_encode }},
      progress: {{ (chat.progress ?? {})|json_encode }},
      done: {{ (chat.done ?? false) ? "true" : "false" }},
      say: "", busy: false, err: "",
      started: {{ (chat.turns|length > 0) ? "true" : "false" }},
      works: {{ (form.works ?: [])|json_encode }},
      maxWorks: {{ form.max_works }},
      /* Readiness is LIVE, not rendered once. The first version printed it server-side at
         page load, so after three answers in the chat the progress bar said "you can send it
         whenever you like" while the panel below still listed those same three as "still
         needed" — the page contradicting itself in two places at once. The chat endpoint
         returns readiness with every turn, so it is bound here and the server-rendered value
         is only the starting point. */
      ready: {{ (readiness ?? {})|json_encode }},

      /* ── voice ────────────────────────────────────────────────────────────
         `voice` is the CAPABILITY (an ElevenLabs key exists); `voiceOn` is what the nominee
         choice. Both false means this whole block is dead weight the browser skips, which
         is the state most deployments will run in. */
      voice: {{ voice ? "true" : "false" }},
      voiceOn: false, canAuto: false, playing: -1, audio: null,
      recording: false, hearing: false, secs: 0, rec: null, chunks: [], tick: null,
      voiceErr: "",

      init(){
        this.$watch("mode", v => { if(v === "chat" && !this.started) this.begin() });
        if(this.mode === "chat" && !this.started) this.begin();
        this.scroll();
      },
      pct(){ const t = this.progress.total || 1; return Math.round((this.progress.answered || 0) / t * 100) },
      async begin(){ this.started = true; await this.post("") },
      async send(){
        const t = this.say.trim(); if(!t || this.busy) return;
        this.turns.push({who:"you", text:t}); this.say = ""; this.scroll();
        await this.post(t);
      },
      async post(text){
        this.busy = true; this.err = "";
        try {
          /* The CSRF token, because this is a same-origin POST from our own page with a
             session behind it — which is precisely the case a synchronizer token protects.
             It is not under /api/, so CsrfMiddleware requires it rather than accepting
             X-Requested-With, and the first version of this got a 403 on every turn. */
          const r = await fetch("/my-work/{{ token }}/chat", {
            method:"POST",
            headers:{"Content-Type":"application/json",
                     "X-CSRF-Token": {{ csrf_token|json_encode }},
                     "X-Requested-With":"XMLHttpRequest"},
            body: JSON.stringify({ say: text })
          });
          const d = await r.json();
          if(!d.ok){ this.err = d.message || "That did not go through."; }
          else {
            if(Array.isArray(d.turns)) this.turns = d.turns.filter(x => x.who !== "meta");
            else (d.reply || []).forEach(x => this.turns.push({who:"ai", text:x}));
            if(d.progress) this.progress = d.progress;
            if(d.readiness) this.ready = d.readiness;
            this.done = !!d.done;
            /* Read the new question out, but only if a play has already succeeded once on
               this page — see toggleVoice(). */
            if(this.voiceOn && this.canAuto){ const i = this.lastAi(); if(i >= 0) this.play(i) }
          }
        } catch(e){ this.err = "No connection. What you have already answered is saved."; }
        this.busy = false; this.scroll();
      },
      scroll(){ this.$nextTick(() => { const b = this.$refs.log; if(b) b.scrollTop = b.scrollHeight }) },

      /* ── reading the questions out ───────────────────────────────────────
         Autoplay is EARNED rather than assumed. Every current browser refuses to play audio
         a person did not ask for, and a page that quietly fails that check would leave a
         nominee waiting in silence for a question they had been promised aloud. So turning
         the switch on plays the question on the spot — that press IS the gesture — and only
         a play that actually succeeded sets `canAuto` for the questions after it. */
      lastAi(){ for(let i = this.turns.length - 1; i >= 0; i--) if(this.turns[i].who === "ai") return i;
                return -1 },
      stopAudio(){ if(this.audio){ try { this.audio.pause() } catch(e){} this.audio = null }
                   this.playing = -1 },
      async toggleVoice(){
        this.voiceOn = !this.voiceOn; this.voiceErr = "";
        if(!this.voiceOn){ this.stopAudio(); return }
        const i = this.lastAi(); if(i >= 0) await this.play(i);
      },
      async play(i){
        if(!this.voice) return;
        if(this.playing === i){ this.stopAudio(); return }   /* pressing it again stops it */
        this.stopAudio(); this.voiceErr = "";
        try {
          /* The turn INDEX, never the text. The endpoint resolves it against this
             own conversation for this submission, so the page cannot ask the platform to speak
             anything a nominee was not already shown. */
          const r = await fetch("/my-work/{{ token }}/speak", {
            method:"POST",
            headers:{"Content-Type":"application/json",
                     "X-CSRF-Token": {{ csrf_token|json_encode }},
                     "X-Requested-With":"XMLHttpRequest"},
            body: JSON.stringify({ turn: i })
          });
          if(!r.ok){
            const d = await r.json().catch(() => ({}));
            this.voiceErr = d.message || "The question could not be read out — but it is written above.";
            this.voiceOn = false; return;
          }
          const url = URL.createObjectURL(await r.blob());
          const a = new Audio(url);
          a.addEventListener("ended", () => { URL.revokeObjectURL(url);
                                              if(this.playing === i) this.playing = -1 });
          this.audio = a; this.playing = i;
          await a.play();
          this.canAuto = true;
        } catch(e){
          this.stopAudio(); this.canAuto = false;
          this.voiceErr = "The question could not be read out — but it is written above.";
        }
      },

      /* ── answering out loud ──────────────────────────────────────────────
         Tap to start, tap to stop — not hold-to-talk. Somebody describing fifteen years of
         work needs both hands and no deadline, and a button that has to stay pressed turns a
         long answer into a physical endurance test. */
      async mic(){
        if(this.recording){ this.stopRec(); return }
        this.voiceErr = "";
        if(!navigator.mediaDevices || !window.MediaRecorder){
          this.voiceErr = "This browser cannot record sound. Type your answer instead."; return;
        }
        try {
          const stream = await navigator.mediaDevices.getUserMedia({ audio:true });
          /* Ask for webm/opus, accept what the browser offers. Safari on iOS answers mp4 and
             supports nothing else, and refusing it would take voice away from a large share
             of the phones this page is actually opened on. */
          const kind = ["audio/webm","audio/mp4","audio/ogg"].find(
            t => window.MediaRecorder.isTypeSupported && MediaRecorder.isTypeSupported(t));
          const rec = new MediaRecorder(stream, kind ? { mimeType: kind } : undefined);
          this.chunks = [];
          rec.addEventListener("dataavailable", e => { if(e.data && e.data.size) this.chunks.push(e.data) });
          rec.addEventListener("stop", () => {
            stream.getTracks().forEach(t => t.stop());
            if(this.tick){ clearInterval(this.tick); this.tick = null }
            this.recording = false;
            this.hear(new Blob(this.chunks, { type: rec.mimeType || "audio/webm" }));
          });
          this.stopAudio();
          this.rec = rec; rec.start(); this.recording = true; this.secs = 0;
          /* Stopped at three minutes rather than left running: a phone in a pocket with the
             recorder still going is a large upload nobody meant to make. */
          this.tick = setInterval(() => { this.secs++; if(this.secs >= 180) this.stopRec() }, 1000);
        } catch(e){
          this.voiceErr = "We could not reach your microphone. Your phone may be asking for "
                        + "permission — allow it, or type the answer instead.";
        }
      },
      stopRec(){ try { if(this.rec && this.rec.state !== "inactive") this.rec.stop() } catch(e){} },
      async hear(blob){
        if(!blob || !blob.size){ this.voiceErr = "That recording was empty."; return }
        this.hearing = true; this.voiceErr = "";
        try {
          const fd = new FormData();
          fd.append("audio", blob, "answer." + ((blob.type || "").indexOf("mp4") >= 0 ? "mp4" : "webm"));
          const r = await fetch("/my-work/{{ token }}/listen", {
            method:"POST",
            headers:{"X-CSRF-Token": {{ csrf_token|json_encode }},
                     "X-Requested-With":"XMLHttpRequest"},
            body: fd
          });
          const d = await r.json();
          if(!d.ok){ this.voiceErr = d.message || "We could not turn that into words."; }
          else {
            /* Into the BOX, never straight into the record. The nominee reads it back, fixes
               whatever was misheard, and presses Send themselves — so the sentence a judge
               eventually quotes is one they approved. Speech recognition on the Englishes
               spoken across this continent is exactly where that matters. */
            this.say = (this.say ? this.say.trim() + " " : "") + d.text;
            this.$nextTick(() => { const el = this.$refs.say;
              if(el){ el.focus(); el.selectionStart = el.selectionEnd = el.value.length } });
          }
        } catch(e){ this.voiceErr = "No connection, so that recording could not be read."; }
        this.hearing = false;
      },
      addWork(){ if(this.works.length < this.maxWorks)
        this.works.push({uid:"w"+Date.now().toString(36),title:"",kind:"",year:"",link:"",
                         description:"",confirm:"",file:"",file_name:""}) },
      dropWork(i){ this.works.splice(i,1) }
    }'>

      {# ── progress ─────────────────────────────────────────────────────── #}
      <div class="mw__prog">
        <b x-text="(progress.answered || 0) + ' of ' + (progress.total || 0) + ' answered'">
          {{ chat.progress.answered|default(0) }} of {{ chat.progress.total|default(0) }} answered</b>
        <div class="mw__bar"><i :style="'width:' + pct() + '%'"></i></div>
        <span x-text="(progress.required_answered || 0) >= (progress.required || 0)
                        ? 'You can send it whenever you like'
                        : ((progress.required || 0) - (progress.required_answered || 0)) + ' still needed before you can send'"></span>
      </div>

      {# ══ A MINUTE IN THEIR OWN VOICE ═════════════════════════════════════
           A dossier has never contained the person. It has a nominator's paragraph, a
           category, a photograph and some typed prose — none of which proves who wrote it.
           This is the one item in it that cannot be ghost-written, and for somebody whose
           work is oral it is the most accurate evidence available.

           Optional, and said to be optional: making it compulsory would exclude anybody
           without a quiet room, which is most people most of the time.

           NOTE this recording is KEPT, unlike a spoken answer, and the card says so
           unprompted. Consent to a panel hearing it is a separate press. #}
      {% if voice %}
      <div class="mw__card mw__intro" x-data='{
        has: {{ (intro.has ?? false) ? "true" : "false" }},
        secs: {{ intro.seconds|default(0) }},
        text: {{ (intro.transcript ?? "")|json_encode }},
        consented: {{ (intro.consented ?? false) ? "true" : "false" }},
        url: {{ (intro.url ?? "")|json_encode }},
        rec: null, chunks: [], tick: null, recording: false, busy: false, err: "", note: "",
        max: {{ intro_max|default(120) }},

        async mic(){
          if(this.recording){ this.stop(); return }
          this.err = ""; this.note = "";
          if(!navigator.mediaDevices || !window.MediaRecorder){
            this.err = "This browser cannot record sound. You can skip this — it is optional."; return }
          try{
            const stream = await navigator.mediaDevices.getUserMedia({ audio:true });
            const kind = ["audio/webm","audio/mp4","audio/ogg"].find(
              t => window.MediaRecorder.isTypeSupported && MediaRecorder.isTypeSupported(t));
            const rec = new MediaRecorder(stream, kind ? { mimeType: kind } : undefined);
            this.chunks = [];
            rec.addEventListener("dataavailable", e => { if(e.data && e.data.size) this.chunks.push(e.data) });
            rec.addEventListener("stop", () => {
              stream.getTracks().forEach(t => t.stop());
              if(this.tick){ clearInterval(this.tick); this.tick = null }
              this.recording = false;
              this.send(new Blob(this.chunks, { type: rec.mimeType || "audio/webm" }));
            });
            this.rec = rec; rec.start(); this.recording = true; this.secs = 0;
            /* Stopped AT the limit rather than letting somebody talk for six minutes and
               then telling them it was too long. */
            this.tick = setInterval(() => { this.secs++; if(this.secs >= this.max) this.stop() }, 1000);
          }catch(e){
            this.err = "We could not reach your microphone. Your phone may be asking for permission — "
                     + "allow it, or skip this.";
          }
        },
        stop(){ try{ if(this.rec && this.rec.state !== "inactive") this.rec.stop() }catch(e){} },

        async send(blob){
          if(!blob || !blob.size){ this.err = "That recording was empty."; return }
          this.busy = true; this.err = "";
          try{
            const fd = new FormData();
            fd.append("audio", blob, "intro." + ((blob.type||"").indexOf("mp4") >= 0 ? "m4a" : "webm"));
            fd.append("seconds", String(this.secs));
            const r = await fetch("/my-work/{{ token }}/intro", {
              method:"POST",
              headers:{"X-CSRF-Token": {{ csrf_token|json_encode }}, "X-Requested-With":"XMLHttpRequest"},
              body: fd });
            const d = await r.json();
            if(!d.ok){ this.err = d.message || "That could not be saved."; }
            else {
              this.has = true; this.note = d.message || "Saved.";
              this.text = (d.state && d.state.transcript) || "";
              this.url = (d.state && d.state.url) || this.url;
              /* Re-recording withdraws the old agreement: a panel agreed to hear one
                 recording, not whichever one happens to be there later. */
              this.consented = false;
            }
          }catch(e){ this.err = "No connection, so that could not be saved."; }
          this.busy = false;
        },

        async act(action){
          this.busy = true; this.err = ""; this.note = "";
          try{
            const r = await fetch("/my-work/{{ token }}/intro", {
              method:"POST",
              headers:{"Content-Type":"application/x-www-form-urlencoded",
                       "X-CSRF-Token": {{ csrf_token|json_encode }}, "X-Requested-With":"XMLHttpRequest"},
              body: new URLSearchParams({ action: action }) });
            const d = await r.json();
            if(!d.ok){ this.err = d.message || "That did not work."; }
            else if(action === "delete"){ this.has = false; this.text = ""; this.consented = false;
                                          this.secs = 0; this.note = d.message; }
            else { this.consented = true; this.note = d.message; }
          }catch(e){ this.err = "No connection."; }
          this.busy = false;
        },
        clock(){ const m = Math.floor(this.secs/60), s = this.secs%60;
                 return m + ":" + (s < 10 ? "0" : "") + s }
      }'>
        <h2>Introduce yourself out loud <small style="font-weight:400;color:#8a969a">— optional</small></h2>
        <p>Up to {{ (intro_max|default(120)) // 60 }} minutes on who you are and what the work is.
          The judges will <strong>hear this in your own voice</strong>, which is the one thing in a
          dossier nobody can write for you. It is fine to skip it and type everything instead.</p>

        <div class="mw__introrow" x-show="!has">
          <button type="button" class="mw__mic" :class="recording ? 'mw__mic--on' : ''"
                  :disabled="busy" @click="mic()"
                  :aria-label="recording ? 'Stop recording' : 'Start recording'"
                  x-text="recording ? '■' : (busy ? '…' : '🎙')"></button>
          <span class="mw__introhint" x-text="recording
                  ? 'Recording… ' + clock() + ' — press the red square when you have finished.'
                  : (busy ? 'Saving…' : 'Press to start. Somewhere quiet, phone close.')"></span>
        </div>

        <div x-show="has" x-cloak>
          <audio controls preload="none" :src="url" style="width:100%;margin-top:12px"></audio>
          <p class="mw__hint" x-show="secs > 0" x-text="'Length: ' + clock() + '.'"></p>

          {# The transcript is shown to the nominee BEFORE a panel sees it, because a
             recogniser mishears names and places and this is the person's own name. #}
          <div x-show="text" x-cloak style="margin-top:12px">
            <span class="mw__slab">What we heard</span>
            <p class="mw__introtext" x-text="text"></p>
            <p class="mw__hint">Written down automatically and not corrected — the judges are told
              that. If it is badly wrong, record it again.</p>
          </div>

          <div class="mw__introacts">
            <button type="button" class="mw__mini" :disabled="busy" @click="act('delete')">Delete and start again</button>
          </div>

          {# Consent is its OWN press. Trying the microphone is not the same decision as
             agreeing that a panel of strangers will listen to it. #}
          <div class="mw__consent" x-show="!consented" x-cloak>
            <p><strong>Shall the judges hear it?</strong> Nothing is shared until you say so, and
              you can delete the recording at any time before you send the questionnaire.</p>
            <button type="button" class="mw__go" style="margin-top:10px" :disabled="busy"
                    @click="act('consent')">Yes — the panel may hear this</button>
          </div>
          <p class="mw__done" x-show="consented" x-cloak>✓ The panel will hear your introduction.</p>
        </div>

        <div class="mw__bad" x-show="err" x-text="err" x-cloak></div>
        <p class="mw__done" x-show="note && !err" x-text="note" x-cloak></p>
      </div>
      {% endif %}

      {# ── mode ─────────────────────────────────────────────────────────── #}
      <div class="mw__modes">
        <button type="button" class="mw__mode" :aria-pressed="mode === 'chat'" @click="mode = 'chat'">
          Answer by chatting
          <small>One question at a time. Easiest on a phone.</small>
        </button>
        <button type="button" class="mw__mode" :aria-pressed="mode === 'form'" @click="mode = 'form'">
          Fill in the whole form
          <small>See everything at once, and edit anything.</small>
        </button>
      </div>
      <p class="mw__hint">Both save to the same place — switch whenever you like, nothing is lost.</p>

      {# ══ THE CONVERSATION ═══════════════════════════════════════════════ #}
      <div class="mw__card" x-show="mode === 'chat'" x-cloak>
        {# ── voice, only when a key is configured ──────────────────────────
           Rendered server-side rather than hidden with a disabled attribute: a nominee should
           never be shown the shape of a feature the operator has not bought. #}
        {% if voice %}
        <div class="mw__vbar">
          <button type="button" class="mw__vsw" :aria-pressed="voiceOn" @click="toggleVoice()">
            <span x-text="voiceOn ? '🔊 Reading aloud' : '🔈 Read the questions to me'"></span>
          </button>
          <span class="mw__vnote">You can also answer by talking — press the microphone, say it in
            your own words, and check what we heard before you send it.</span>
        </div>
        {% endif %}

        <div class="mw__chat" x-ref="log">
          <template x-for="(t, i) in turns" :key="i">
            <div class="mw__row" :class="t.who === 'you' ? 'mw__row--you' : 'mw__row--ai'">
              <div class="mw__msg" :class="t.who === 'you' ? 'mw__msg--you' : 'mw__msg--ai'"
                   x-text="t.text"></div>
              {% if voice %}
                <button type="button" class="mw__spk" x-show="t.who !== 'you'"
                        :aria-pressed="playing === i" @click="play(i)"
                        :aria-label="playing === i ? 'Stop reading this out' : 'Read this out'"
                        x-text="playing === i ? '■' : '▶'"></button>
              {% endif %}
            </div>
          </template>
          <div class="mw__typing" x-show="busy">…</div>
        </div>

        <div class="mw__bad" x-show="err" x-text="err" x-cloak></div>
        {% if voice %}<div class="mw__bad" x-show="voiceErr" x-text="voiceErr" x-cloak></div>{% endif %}

        <div class="mw__ask" x-show="!done">
          {% if voice %}
            <button type="button" class="mw__mic" :class="recording ? 'mw__mic--on' : ''"
                    :disabled="hearing || busy" @click="mic()"
                    :aria-label="recording ? 'Stop recording' : 'Answer by talking'"
                    :aria-pressed="recording"
                    x-text="recording ? '■' : (hearing ? '…' : '🎤')"></button>
          {% endif %}
          <label class="sr-only" for="mwSay">Type your answer</label>
          <textarea class="mw__say" id="mwSay" x-model="say" x-ref="say" rows="1"
                    placeholder="Type your answer…"
                    @keydown.enter.exact.prevent="send()"></textarea>
          <button type="button" class="mw__send" @click="send()" :disabled="busy || !say.trim()">Send</button>
        </div>

        {% if voice %}
          <p class="mw__rec" x-show="recording" x-cloak
             x-text="'Listening… ' + secs + 's. Press the red square when you have finished.'"></p>
          <p class="mw__rec" x-show="hearing" x-cloak>Writing down what you said…</p>
        {% endif %}

        <p class="mw__hint" x-show="!done">
          Enter sends. Not sure about a question?
          <button type="button" class="mw__skip" @click="say = 'skip'; send()">say skip</button>
          — the ones we truly need will be asked again.
        </p>
        <p class="mw__hint" x-show="done" x-cloak>
          All the questions are answered. Add anything you can show the judges below, then send it.
        </p>
      </div>

      {# ══ THE FORM ══════════════════════════════════════════════════════ #}
      <form method="post" action="/my-work/{{ token }}">
        <input type="hidden" name="_token" value="{{ csrf_token }}">

        {# ── THE FORM, AS A SEQUENCE RATHER THAN A WALL ─────────────────────────
             This was eleven questions stacked into a page nearly five thousand pixels tall,
             which is a reasonable form and an intimidating one — and the shape people abandon.
             It is now one question at a time with a step counter, forward and back, and a live
             read on the answer beside the box. Same fields, same names, same POST.

             THE FIELDS ALL STAY IN THE DOM. Only their VISIBILITY changes, so the form still
             submits every answer in one go and still works with JavaScript switched off — a
             stepper that only rendered the current step would have made the no-script path
             submit one answer and silently drop ten. #}
        <div class="mw__card" x-show="mode === 'form'" x-cloak
             x-data='{ step: 0, total: {{ form.questions|length }},
               coach: {}, busy: {},
               go(n){ this.step = Math.max(0, Math.min(this.total - 1, n));
                      this.$nextTick(() => { const el = this.$refs.stepTop;
                                             if(el) el.scrollIntoView({ block: "start" }) }) },
               /* One request per pause in typing, not per keystroke: this reads an answer, and
                  reading it four times a second would be noise for the nominee and a bill for
                  the operator. */
               watch(slug, el){
                 clearTimeout(this.busy[slug]);
                 const text = el.value;
                 this.busy[slug] = setTimeout(() => this.ask(slug, text), 900);
               },
               async ask(slug, text){
                 if(!text || text.trim().length < 3){ this.coach[slug] = null; return }
                 try{
                   const r = await fetch("/my-work/{{ token }}/coach", {
                     method:"POST",
                     headers:{"Content-Type":"application/x-www-form-urlencoded",
                              "X-CSRF-Token": {{ csrf_token|json_encode }},
                              "X-Requested-With":"XMLHttpRequest"},
                     body: new URLSearchParams({ slug: slug, text: text }) });
                   const d = await r.json();
                   this.coach[slug] = d.ok ? d : null;
                 }catch(e){ /* a coach that cannot be reached simply says nothing */ }
               }
             }'>
          <div class="mw__steptop" x-ref="stepTop">
            <span class="mw__slab" x-text="'Question ' + (step + 1) + ' of ' + total"></span>
            <div class="mw__bar" style="margin-top:8px">
              <i :style="'width:' + Math.round((step + 1) / total * 100) + '%'"></i></div>
          </div>
          <p class="mw__hint">Answers marked <span class="mw__req">*</span> are needed before you
            can send. The rest are optional and all of them are read. Nothing is submitted until
            you press the button at the bottom.</p>

          {% for q in form.questions %}
            {% set val = form.answers[q.slug]|default('') %}
            <div class="mw__q" x-show="step === {{ loop.index0 }}" x-cloak>
              <label class="mw__lab" for="q-{{ q.slug }}">
                {{ q.label }}{% if q.is_required %} <span class="mw__req">*</span>{% endif %}
              </label>
              {% if q.help %}<p class="mw__help">{{ q.help }}</p>{% endif %}
              {# What a judge is actually looking for, said under the question rather than
                 discovered afterwards. Static text: it is the same for everybody and must be
                 there with no AI key and no network. #}
              <p class="mw__seek">{{ looking_for[q.slug]|default('') }}</p>
              {% if q.criterion %}<span class="mw__crit">Judged under: {{ q.criterion }}</span>{% endif %}

              {% if q.kind == 'textarea' %}
                <textarea class="mw__in" id="q-{{ q.slug }}" name="a[{{ q.slug }}]"
                          maxlength="{{ q.max_len }}"
                          @input="watch({{ q.slug|json_encode }}, $el)"
                          placeholder="{{ q.placeholder }}">{{ val }}</textarea>
              {% elseif q.kind == 'select' %}
                <select class="mw__in" id="q-{{ q.slug }}" name="a[{{ q.slug }}]">
                  <option value="">Choose…</option>
                  {% for o in q.options %}
                    <option value="{{ o }}" {{ val == o ? 'selected' : '' }}>{{ o }}</option>
                  {% endfor %}
                </select>
              {% else %}
                <input class="mw__in" id="q-{{ q.slug }}" name="a[{{ q.slug }}]"
                       type="{{ q.kind == 'url' ? 'url' : (q.kind == 'number' ? 'number' : (q.kind == 'date' ? 'date' : 'text')) }}"
                       maxlength="{{ q.max_len }}" value="{{ val }}"
                       placeholder="{{ q.placeholder ?: (q.kind == 'url' ? 'https://…' : '') }}">
              {% endif %}
              {% if val %}<div class="mw__done">✓ answered</div>{% endif %}

              {# The live read. Help, never a mark: there is no score in it, no percentage and
                 no traffic light with a number behind it. A nominee being graded by the
                 platform running the award, on the page they are typing into, would be the
                 platform pre-judging the entry. #}
              <template x-if="coach[{{ q.slug|json_encode }}]">
                <div class="mw__coach"
                     :class="coach[{{ q.slug|json_encode }}].state === 'good' ? 'mw__coach--ok' : ''">
                  <b x-text="coach[{{ q.slug|json_encode }}].note"></b>
                  <span x-show="coach[{{ q.slug|json_encode }}].nudge"
                        x-text="coach[{{ q.slug|json_encode }}].nudge"></span>
                </div>
              </template>

              <div class="mw__steps">
                <button type="button" class="mw__mini" x-show="step > 0" @click="go(step - 1)">← Back</button>
                <button type="button" class="mw__mini" x-show="step < total - 1"
                        @click="go(step + 1)">{{ q.is_required ? 'Next' : 'Next — or skip' }} →</button>
                <span class="mw__hint" x-show="step === total - 1" x-cloak
                      style="margin:0">That is the last question.</span>
              </div>
            </div>
          {% endfor %}
        </div>

        {# ── works: shown in BOTH modes, because this is the part a judge trusts most ── #}
        <div class="mw__card">
          <h2>Your works and evidence</h2>
          <p>Anything that exists and can be looked at: a project, a report, an award, a news
            article, a photograph of the work, a letter from a school or ministry.
            <strong>A judge trusts something they can check far more than a description of it.</strong>
            Up to {{ form.max_works }} items, and up to {{ form.max_files }} files of
            {{ form.max_file_mb }}MB each — use links for anything larger.</p>

          <template x-for="(w, i) in works" :key="w.uid">
            <div class="mw__work">
              <input type="hidden" :name="'w['+i+'][uid]'" :value="w.uid">
              <input type="hidden" :name="'w['+i+'][file_name]'" :value="w.file_name">
              <div class="mw__grid">
                <div>
                  <label class="mw__slab" :for="'wt'+i">What is it called?</label>
                  <input class="mw__in" style="margin-top:0" :id="'wt'+i" :name="'w['+i+'][title]'"
                         type="text" maxlength="200" x-model="w.title"
                         placeholder="e.g. Saturday Science Club">
                </div>
                <div>
                  <label class="mw__slab" :for="'wk'+i">What kind of thing is it?</label>
                  <select class="mw__in" style="margin-top:0" :id="'wk'+i" :name="'w['+i+'][kind]'" x-model="w.kind">
                    <option value="">Choose…</option>
                    <option value="document">A document or report</option>
                    <option value="link">A website or page</option>
                    <option value="media">A photograph or video</option>
                    <option value="award">An award or prize</option>
                    <option value="press">News or press coverage</option>
                  </select>
                </div>
                <div>
                  <label class="mw__slab" :for="'wy'+i">When?</label>
                  <input class="mw__in" style="margin-top:0" :id="'wy'+i" :name="'w['+i+'][year]'"
                         type="text" maxlength="40" x-model="w.year" placeholder="e.g. 2024, or 2019–now">
                </div>
                <div>
                  <label class="mw__slab" :for="'wl'+i">A link, if there is one</label>
                  <input class="mw__in" style="margin-top:0" :id="'wl'+i" :name="'w['+i+'][link]'"
                         type="text" maxlength="600" x-model="w.link" placeholder="https://…">
                </div>
              </div>
              <div style="margin-top:10px">
                <label class="mw__slab" :for="'wd'+i">What is it, in a sentence or two?</label>
                <textarea class="mw__in" style="margin-top:0; min-height:66px" :id="'wd'+i"
                          :name="'w['+i+'][description]'" maxlength="1500" x-model="w.description"></textarea>
              </div>
              <div style="margin-top:10px">
                <label class="mw__slab" :for="'wc'+i">Who could confirm it?</label>
                <input class="mw__in" style="margin-top:0" :id="'wc'+i" :name="'w['+i+'][confirm]'"
                       type="text" maxlength="300" x-model="w.confirm"
                       placeholder="A name and role — we only contact them if the panel asks">
              </div>
              <div class="mw__file" x-show="w.file" x-cloak>
                <span>📎</span><span x-text="w.file_name || 'File attached'"></span>
              </div>
              <div class="mw__drop" x-show="!w.file">Save this page, then attach a file below.</div>
              <button type="button" class="mw__x" @click="dropWork(i)">Remove this item</button>
            </div>
          </template>

          <button type="button" class="mw__add" @click="addWork()"
                  x-text="works.length ? '+ Add another item' : '+ Add your first item'">+ Add your first item</button>
        </div>

        {# ── the readiness check, then send ───────────────────────────── #}
        <div class="mw__card">
          <h2>Send it to the judges</h2>

          <div class="mw__tip" x-show="(ready.missing || []).length" x-cloak>
            <strong>Still needed before you can send:</strong>
            <ul><template x-for="m in (ready.missing || [])" :key="m"><li x-text="m"></li></template></ul>
          </div>

          {# Help, not a score. Naming what a judge will find thin BEFORE they send is the
             difference between a fixable gap and a wasted claim. #}
          <div class="mw__tip" x-show="(ready.thin || []).length" x-cloak>
            <strong>These would carry more weight with a small addition:</strong>
            <ul><template x-for="(t, i) in (ready.thin || [])" :key="i"><li x-text="t.why"></li></template></ul>
            You can send it as it is — this is a suggestion, not a requirement.
          </div>

          <div class="mw__tip" x-show="!(ready.works > 0)" x-cloak>You have not added anything the
            judges can look at yet. One document, photograph or link is worth more to a panel than
            another paragraph.</div>

          <p>Type your name to confirm these are your own words and that what you have attached is
            yours to share.</p>

          <label class="mw__slab" for="dn" style="margin-top:14px">Your name</label>
          <input class="mw__in" style="margin-top:0" id="dn" name="declared_name" type="text"
                 maxlength="160" autocomplete="name" value="{{ form.declared_name }}"
                 placeholder="Type your full name">

          <button class="mw__go" type="submit" name="action" value="submit">Send to the judges</button>
          <button class="mw__ghost" type="submit" name="action" value="save">Save and finish later</button>

          <p class="mw__free">
            <b>Nothing here costs money.</b> We will never ask you to pay for a nomination, an
            interview, a result or an award, and we will never ask for your bank details. If
            anybody does, it is not us — tell us at
            <a href="mailto:{{ support_email }}">{{ support_email }}</a>.<br><br>
            <b>Answering honestly about what has not worked has never cost anybody an award.</b>
            The panel is looking for real work, not a perfect record.
          </p>
        </div>
      </form>

      {# ── uploads: their own form, so a rejected file never costs a page of typing ── #}
      <div class="mw__card">
        <h2>Attach a file</h2>
        <p>Save the page first so your items exist, then attach a file to one of them.
          Documents, PDFs and photographs, up to {{ form.max_file_mb }}MB each.</p>
        <form method="post" action="/my-work/{{ token }}/upload" enctype="multipart/form-data">
          <input type="hidden" name="_token" value="{{ csrf_token }}">
          <div class="mw__grid" style="margin-top:12px">
            <div>
              <label class="mw__slab" for="uid">Attach it to</label>
              <select class="mw__in" style="margin-top:0" id="uid" name="uid">
                {% for w in form.works %}
                  <option value="{{ w.uid }}">{{ w.title ?: 'Item ' ~ loop.index }}{{ w.file ? ' (replace the current file)' : '' }}</option>
                {% else %}
                  <option value="">Add an item above and save first</option>
                {% endfor %}
              </select>
            </div>
            <div>
              <label class="mw__slab" for="file">Choose the file</label>
              <input class="mw__in" style="margin-top:0" id="file" name="file" type="file"
                     accept=".pdf,.doc,.docx,.jpg,.jpeg,.png,.webp">
            </div>
          </div>
          <button class="mw__mini" style="margin-top:12px" type="submit">Upload</button>
        </form>
      </div>
    </div>
  {% endif %}
{% endif %}

</div>
{% endblock %}
