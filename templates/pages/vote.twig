{% extends "layout/gates.twig" %}

{% block head_styles %}
<style>
  /* Page-scoped: this block only loads on /vote. */
  body{ background:#eef0ec; }
  [x-cloak]{ display:none !important; }

  .vh{ max-width:1100px; margin:0 auto; padding:24px var(--ag-gutter,32px) 64px; }

  /* hero */
  .vh-hero{ position:relative; overflow:hidden; border-radius:24px; background:radial-gradient(130% 130% at 82% 0%,#1d5b2a,#10292C 62%); padding:clamp(1.8rem,4vw,2.4rem); color:#fff; }
  .vh-hero__orb{ position:absolute; right:-60px; top:-70px; width:300px; height:300px; border-radius:50%; background:radial-gradient(circle,rgba(212,154,14,.28),transparent 68%); }
  .vh-hero__row{ position:relative; display:flex; align-items:flex-end; justify-content:space-between; gap:28px; flex-wrap:wrap; }
  .vh-hero__badge{ display:inline-flex; align-items:center; gap:8px; font-size:11.5px; font-weight:600; letter-spacing:.06em; color:#fbc329; background:rgba(212,154,14,.18); padding:7px 14px; border-radius:999px; }
  .vh-hero__badge::before{ content:""; width:8px; height:8px; border-radius:50%; background:var(--ag-green-light,#7FC87C); box-shadow:0 0 0 4px rgba(127,200,124,.22); }
  .vh-hero h1{ margin:16px 0 0; font-family:var(--ag-font-display); font-weight:800; font-size:clamp(2rem,4.4vw,2.6rem); line-height:1.04; letter-spacing:-.02em; color:#fff; }
  .vh-hero p{ margin:14px 0 0; max-width:560px; font-size:15px; line-height:1.6; color:rgba(255,255,255,.82); }
  .vh-stats{ display:flex; gap:14px; }
  .vh-stat{ background:rgba(255,255,255,.08); border:1px solid rgba(255,255,255,.14); border-radius:16px; padding:16px 20px; text-align:center; }
  .vh-stat__n{ font-family:var(--ag-font-mono); font-weight:700; font-size:28px; line-height:1; }
  .vh-stat__n--g{ color:var(--ag-green-light,#7FC87C); }
  .vh-stat__l{ font-size:10px; letter-spacing:.06em; text-transform:uppercase; color:rgba(255,255,255,.6); margin-top:5px; }

  .vh-grid{ margin-top:26px; display:grid; grid-template-columns:1fr 320px; gap:28px; align-items:start; }

  /* filter chips */
  .vh-filters{ display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap; margin-bottom:18px; }
  .vh-chips{ display:flex; gap:8px; overflow-x:auto; scrollbar-width:none; }
  .vh-chips::-webkit-scrollbar{ display:none; }
  .vh-chip{ flex:none; cursor:pointer; font-family:inherit; font-size:13px; font-weight:600; padding:9px 16px; border-radius:999px; border:1px solid rgba(16,41,44,.12); background:var(--ag-surface,#fff); color:#4a5256; }
  .vh-chip.is-active{ background:var(--ag-ink,#10292C); color:#fff; border-color:var(--ag-ink,#10292C); }
  .vh-count{ font-size:13px; color:#5f7273; }

  /* programme cards */
  .vh-cards{ display:grid; grid-template-columns:1fr 1fr; gap:16px; }
  .vh-card{ background:var(--ag-surface,#fff); border:1px solid rgba(16,41,44,.08); border-radius:18px; padding:20px; display:flex; flex-direction:column; transition:border-color .18s,box-shadow .18s; animation:vhRise .3s ease both; }
  .vh-card:hover{ border-color:rgba(16,41,44,.18); box-shadow:0 18px 36px -26px rgba(16,41,44,.45); }
  .vh-card__top{ display:flex; align-items:center; justify-content:space-between; gap:10px; }
  .vh-tag{ font-size:10px; font-weight:700; letter-spacing:.06em; text-transform:uppercase; padding:5px 11px; border-radius:999px; }
  .vh-tag--live{ background:#effaf0; color:#1a6118; }
  .vh-tag--gold{ background:#fff8df; color:#8a6005; }
  .vh-tag--soft{ background:#e6f0f4; color:#27607a; }
  .vh-tag--mute{ background:#eef2ef; color:#5a6d6f; }
  .vh-card__votes{ font-family:var(--ag-font-mono); font-size:12px; font-weight:600; color:#5f7273; }
  .vh-card h3{ margin:13px 0 0; font-family:var(--ag-font-display); font-weight:700; font-size:20px; color:var(--ag-ink,#10292C); }
  .vh-lead{ display:flex; align-items:center; gap:11px; margin-top:14px; }
  .vh-lead__av{ flex:none; width:44px; height:44px; border-radius:12px; background:#fff8df; color:#7a5600; display:flex; align-items:center; justify-content:center; font-family:var(--ag-font-display); font-weight:700; font-size:18px; }
  .vh-lead__l{ font-size:10px; letter-spacing:.05em; text-transform:uppercase; color:#5f7273; }
  .vh-lead__name{ font-weight:600; font-size:14px; color:var(--ag-ink,#10292C); }
  .vh-lead--empty{ font-size:13px; color:#5f7273; }
  .vh-bar{ margin-top:14px; height:7px; border-radius:999px; background:#eef2ef; overflow:hidden; display:flex; }
  .vh-bar i{ display:block; height:100%; }
  .vh-card__foot{ display:flex; align-items:center; justify-content:space-between; gap:10px; margin-top:16px; }
  .vh-card__noms{ font-size:12.5px; color:#5f6d6f; }
  .vh-act{ flex:none; cursor:pointer; text-decoration:none; font-family:inherit; font-size:13px; font-weight:600; padding:9px 20px; border-radius:999px; border:1px solid transparent; }
  .vh-act--p{ background:var(--ag-green,#237b22); color:#fff; }
  .vh-act--p:hover{ background:var(--ag-green-dark,#1a6118); }
  .vh-act--g{ background:var(--ag-surface,#fff); border-color:rgba(16,41,44,.16); color:var(--ag-ink,#10292C); }
  .vh-act--off{ background:#eef1ee; color:#5f7273; cursor:default; }

  /* right rail */
  .vh-rail{ position:sticky; top:96px; display:flex; flex-direction:column; gap:16px; }
  .vh-ballot{ background:var(--ag-surface,#fff); border:1px solid rgba(16,41,44,.08); border-radius:20px; padding:24px; box-shadow:0 12px 36px -22px rgba(16,41,44,.3); }
  .vh-ballot h2{ margin:0; font-family:var(--ag-font-display); font-weight:700; font-size:19px; color:var(--ag-ink,#10292C); }
  .vh-ballot p{ margin:8px 0 0; font-size:13px; line-height:1.5; color:#5f6d6f; }
  .vh-prog{ margin-top:16px; height:9px; border-radius:999px; background:#eef2ef; overflow:hidden; }
  .vh-prog i{ display:block; height:100%; background:var(--ag-green,#237b22); transition:width .4s ease; }
  .vh-secure{ display:flex; align-items:center; gap:9px; margin-top:18px; padding:13px; border-radius:13px; background:#f4f7f4; font-size:12px; line-height:1.45; color:#4a5256; }
  .vh-ballot__cta{ display:block; text-align:center; text-decoration:none; width:100%; margin-top:16px; cursor:pointer; border:none; background:var(--ag-green,#237b22); color:#fff; font-family:inherit; font-weight:600; font-size:14.5px; padding:13px; border-radius:999px; }
  .vh-ballot__cta--off{ background:#5f7273; }
  .vh-closing{ background:var(--ag-ink,#10292C); border-radius:20px; padding:22px; color:#fff; }
  .vh-closing__k{ margin:0; font-size:11px; font-weight:600; letter-spacing:.1em; text-transform:uppercase; color:#fbc329; }
  .vh-closing h3{ margin:9px 0 0; font-family:var(--ag-font-display); font-weight:700; font-size:18px; color:#fff; }
  .vh-closing p{ margin:8px 0 0; font-size:13px; line-height:1.55; color:rgba(255,255,255,.72); }
  .vh-closing a{ display:inline-block; margin-top:14px; text-decoration:none; font-size:13px; font-weight:600; color:var(--ag-green-light,#7FC87C); }

  .vh-empty{ background:var(--ag-surface,#fff); border:1px solid rgba(16,41,44,.08); border-radius:22px; padding:clamp(2rem,5vw,3rem); text-align:center; }
  .vh-empty h3{ margin:0 0 .4rem; font-family:var(--ag-font-display); font-weight:700; font-size:1.4rem; color:var(--ag-ink,#10292C); }
  .vh-empty p{ margin:0 auto 1.4rem; max-width:34rem; color:#4a5256; line-height:1.6; }
  .vh-btns{ display:flex; gap:.75rem; flex-wrap:wrap; justify-content:center; }

  :focus-visible{ outline:2px solid var(--ag-green,#237b22); outline-offset:2px; }
  @keyframes vhRise{ from{opacity:0;transform:translateY(8px)} to{opacity:1;transform:translateY(0)} }
  @media (max-width:860px){ .vh-grid{ grid-template-columns:1fr; } .vh-rail{ position:static; } .vh-cards{ grid-template-columns:1fr; } }
</style>
{% endblock %}

{% block content %}
{% set FLAGS = {'NG':'🇳🇬','GH':'🇬🇭','ZA':'🇿🇦','KE':'🇰🇪','ET':'🇪🇹','EG':'🇪🇬','MA':'🇲🇦','TZ':'🇹🇿','UG':'🇺🇬','CI':'🇨🇮','CM':'🇨🇲','SN':'🇸🇳','ML':'🇲🇱','AO':'🇦🇴','CD':'🇨🇩','RW':'🇷🇼','ZM':'🇿🇲','ZW':'🇿🇼','BF':'🇧🇫','NE':'🇳🇪','BW':'🇧🇼'} %}
{# Chip colour per phase. The LABEL comes from the phase view-model
   (CyclePolicy), never from a second copy here — that is how the badge and the
   countdown used to drift apart. 'shortlisting' was missing entirely. #}
{% set PHASE_CLS = {
  'voting': 'live', 'nominations': 'soft', 'shortlisting': 'soft',
  'judging': 'mute', 'results': 'gold', 'upcoming': 'mute', 'archived': 'mute'
} %}
{% set hub = hub|default([]) %}
{% set votingIds = hub|filter(p => p.cycle_status == 'voting')|map(p => p.id)|join(',') %}

<div class="vh" x-data="voteHub()" x-init="init()" data-prog-ids="{{ votingIds }}">

  <!-- HERO -->
  <section class="vh-hero">
    <div class="vh-hero__orb" aria-hidden="true"></div>
    <div class="vh-hero__row">
      <div>
        <span class="vh-hero__badge">{% if meta.voting_count > 0 %}Voting open · {{ meta.year }} cycle{% else %}Between cycles{% endif %}</span>
        {% if meta.voting_count > 0 %}
          <h1>Cast your vote across<br>{{ meta.voting_count }} live programme{{ meta.voting_count == 1 ? '' : 's' }}</h1>
          <p>One verified vote per category. Every ballot is OTP-secured and fully audited. Tallies refresh every 6 hours.</p>
        {% else %}
          <h1>Voting opens<br>again soon</h1>
          <p>Cycles run across the continent through the year. While this one’s between stages, explore the live rankings or put someone forward.</p>
        {% endif %}
      </div>
      <div class="vh-stats">
        {# The deadline stat. `meta.soonest` is the phase view-model of the next
           ballot to close, so this figure can never disagree with the badge
           above or the rail below. When nothing is closing it says so, rather
           than clamping a negative remainder to a misleading "0 Days left". #}
        <div class="vh-stat">
          {% if meta.soonest %}
            <div class="vh-stat__n vh-stat__n--g" style="font-size:19px;line-height:1.2">{{ meta.soonest.closes_at|date('j M') }}</div>
            <div class="vh-stat__l">Closes first</div>
          {% else %}
            <div class="vh-stat__n vh-stat__n--g">—</div>
            <div class="vh-stat__l">No open ballot</div>
          {% endif %}
        </div>
        <div class="vh-stat"><div class="vh-stat__n">{{ meta.votes_total|number_format }}</div><div class="vh-stat__l">Votes cast</div></div>
      </div>
    </div>
  </section>

  {% if hub|length == 0 %}
    <div class="vh-empty" style="margin-top:26px">
      <h2>No programmes yet</h2>
      <p>Programmes appear here as soon as a cycle goes live. In the meantime, explore the rankings or nominate someone.</p>
      <div class="vh-btns">
        <a href="/leaderboard" class="vh-act vh-act--p">See the leaderboard</a>
        <a href="/nominate" class="vh-act vh-act--g">Submit a nomination</a>
      </div>
    </div>
  {% else %}
  <div class="vh-grid">

    <!-- LEFT -->
    <div>
      <div class="vh-filters">
        <div class="vh-chips" role="group" aria-label="Filter programmes">
          <button type="button" class="vh-chip" :class="filter==='all' && 'is-active'" @click="filter='all'" :aria-pressed="filter==='all'">All</button>
          {% set seen = [] %}
          {% for p in hub %}
            {% set st = p.phase.phase|default(p.cycle_status|default('upcoming')) %}
            {% if st not in seen %}
              {% set seen = seen|merge([st]) %}
              <button type="button" class="vh-chip" :class="filter==='{{ st }}' && 'is-active'" @click="filter='{{ st }}'" :aria-pressed="filter==='{{ st }}'">{{ p.phase.label|default(st|capitalize) }}</button>
            {% endif %}
          {% endfor %}
        </div>
        <span class="vh-count"><span x-text="shown"></span> of {{ hub|length }} shown</span>
      </div>

      <h2 class="sr-only">Live programmes</h2>
      <div class="vh-cards">
        {% for p in hub %}
          {% set st = p.phase.phase|default(p.cycle_status|default('upcoming')) %}
          {% set tag = {'label': p.phase.label|default(st|capitalize), 'cls': PHASE_CLS[st]|default('mute')} %}
          {% set leader = p.leader %}
          {% set flag = leader ? (FLAGS[leader.country_code|default('')]|default('🌍')) : '' %}
          <article class="vh-card" data-status="{{ st }}" x-show="filter==='all' || filter==='{{ st }}'" x-cloak>
            <div class="vh-card__top">
              <span class="vh-tag vh-tag--{{ tag.cls }}">{{ tag.label }}</span>
              {% if p.total_votes > 0 %}<span class="vh-card__votes">{{ p.total_votes|number_format }} votes</span>{% endif %}
            </div>
            <h3>{{ p.icon_emoji|default('') }} {{ p.title }}</h3>

            {% if leader and p.total_votes > 0 %}
              <div class="vh-lead">
                <span class="vh-lead__av">{{ leader.name|first|upper }}</span>
                <div style="min-width:0">
                  <div class="vh-lead__l">Leading</div>
                  <div class="vh-lead__name">{{ flag }} {{ leader.name }}</div>
                </div>
              </div>
              <div class="vh-bar" aria-hidden="true">
                {% set cols = ['#237b22','#7FC87C','#cfe6ce'] %}
                {% for w in p.bars|default([]) %}<i style="width:{{ w }}%;background:{{ cols[loop.index0]|default('#cfe6ce') }}"></i>{% endfor %}
              </div>
            {% else %}
              <div class="vh-lead"><span class="vh-lead--empty">
                {%- if st == 'nominations' -%}Open for nominations
                {%- elseif st == 'voting' -%}Be the first to vote
                {%- elseif st == 'shortlisting' -%}Shortlist being finalised
                {%- elseif st == 'results' or st == 'judging' -%}Awaiting results
                {%- else -%}Nominees coming soon
                {%- endif -%}
              </span></div>
            {% endif %}

            <div class="vh-card__foot">
              <span class="vh-card__noms">{{ p.nominee_count|default(0) }} nominee{{ p.nominee_count == 1 ? '' : 's' }}</span>
              {% if st == 'voting' and leader %}
                <a class="vh-act vh-act--p" href="/vote/{{ p.slug }}">Vote →</a>
              {% elseif st == 'voting' %}
                <span class="vh-act vh-act--off">Coming soon</span>
              {% elseif st == 'nominations' %}
                <a class="vh-act vh-act--g" href="/nominate">Nominate</a>
              {% elseif st == 'results' %}
                <a class="vh-act vh-act--g" href="/leaderboard">See results</a>
              {% elseif st == 'judging' or st == 'shortlisting' %}
                <a class="vh-act vh-act--g" href="/vote/{{ p.slug }}">View nominees</a>
              {% else %}
                <span class="vh-act vh-act--off">Opens soon</span>
              {% endif %}
              {% if p.phase and p.phase.detail %}
              {# The deadline in words, from the same object as the chip. #}
              <span class="sr-only">{{ p.phase.label }} — {{ p.phase.detail }}</span>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    </div>

    <!-- RIGHT · ballot tracker -->
    <div class="vh-rail">
      {% if meta.voting_count > 0 %}
      <div class="vh-ballot">
        <h2>Your ballot</h2>
        <p><span x-text="votedCount"></span> of {{ meta.voting_count }} live programme{{ meta.voting_count == 1 ? '' : 's' }} voted <span style="color:#5f7273">· on this device</span></p>
        <div class="vh-prog" role="progressbar" :aria-valuenow="votedCount" aria-valuemin="0" aria-valuemax="{{ meta.voting_count }}"><i :style="'width:' + Math.round(votedCount/{{ meta.voting_count }}*100) + '%'"></i></div>
        <div class="vh-secure">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#237b22" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          <span>Verified by email OTP — one vote per category, never duplicated.</span>
        </div>
        {% set firstVoting = (hub|filter(p => p.cycle_status == 'voting' and p.leader)|first) %}
        {% if firstVoting %}<a class="vh-ballot__cta" href="/vote/{{ firstVoting.slug }}" x-text="votedCount > 0 ? 'Keep voting' : 'Start voting'">Start voting</a>{% endif %}
      </div>
      {% endif %}

      <div class="vh-closing">
        {# Both the kicker and the body come from ONE phase object, so "Closing
           soon" can no longer sit above a date that has already passed. #}
        {% if meta.soonest %}
          <p class="vh-closing__k">{{ meta.soonest.closing_soon ? 'Closing soon' : 'Next deadline' }}</p>
          <h3>Voting closes {{ meta.soonest.closes_at|date('j M Y') }}</h3>
          <p>{{ meta.soonest.detail }}. After it closes, judges review the top nominees per category before the Awards Gala — community votes are 45% of the final score.</p>
        {% else %}
          <p class="vh-closing__k">How it works</p>
          <h3>Community votes count for 45%</h3>
          <p>Public votes blend with an expert judging panel (55%) to set each Cultural Power Index score. Popularity alone never decides a winner.</p>
        {% endif %}
        <a href="/integrity">How scoring works →</a>
      </div>
    </div>
  </div>
  {% endif %}
</div>
{% endblock %}

{% block foot_scripts %}
<script>
function voteHub(){
  return {
    filter: 'all',
    voted: {},
    init(){
      try {
        (this.$root.dataset.progIds || '').split(',').filter(Boolean).forEach(id => {
          if (localStorage.getItem('afg_voted_prog_' + id)) this.voted[id] = true;
        });
      } catch(e){}
    },
    get votedCount(){ return Object.keys(this.voted).length; },
    get shown(){
      const cards = this.$root.querySelectorAll('.vh-card');
      let n = 0; cards.forEach(c => { if (this.filter === 'all' || c.dataset.status === this.filter) n++; });
      return n;
    },
  };
}
</script>
{% endblock %}
