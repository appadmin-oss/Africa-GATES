{% extends "layout/gates.twig" %}

{% block head_styles %}
<style>
  body[data-page="signin"]{ background:#eef0ec; }
  body[data-page="signin"] .main-wrapper{ padding:0; margin:0; max-width:none; min-height:100vh; }
  body[data-page="signin"] [x-cloak]{ display:none !important; }

  .si{ min-height:100vh; display:flex; background:#eef0ec; font-family:var(--ag-font-body); color:var(--ag-ink); }

  /* ── Left brand panel ── */
  .si__brand{ flex:1; position:relative; overflow:hidden; display:flex; flex-direction:column; justify-content:space-between;
    padding:44px 48px; background:radial-gradient(130% 120% at 25% 10%,#1d5b2a,#10292C 62%); }
  .si__orb{ position:absolute; right:-80px; bottom:-100px; width:420px; height:420px; border-radius:50%;
    background:radial-gradient(circle,rgba(212,154,14,.26),transparent 68%); }
  .si__logo{ display:flex; align-items:center; gap:11px; position:relative; }
  .si__logo-glyph{ width:38px; height:38px; border-radius:10px; background:rgba(127,200,124,.16);
    display:flex; align-items:center; justify-content:center; font-family:var(--ag-font-display); font-weight:700; font-size:20px; color:#7FC87C; }
  .si__logo-word{ display:flex; flex-direction:column; line-height:1; }
  .si__logo-word b{ font-family:var(--ag-font-display); font-weight:700; font-size:17px; color:#fff; }
  .si__logo-word span{ font-size:10px; font-weight:700; letter-spacing:.26em; color:#9ad698; }
  .si__pitch{ position:relative; }
  .si__pitch h1{ margin:0; font-family:var(--ag-font-display); font-weight:800; font-size:42px; line-height:1.05; letter-spacing:-.02em; color:#fff; }
  .si__pitch p{ margin:18px 0 0; font-size:15.5px; line-height:1.6; color:rgba(255,255,255,.78); max-width:380px; }
  .si__stats{ display:flex; align-items:center; gap:20px; margin-top:30px; flex-wrap:wrap; }
  .si__stat-n{ font-family:var(--ag-font-mono); font-weight:700; font-size:22px; color:#fff; }
  .si__stat-n.is-g{ color:#7FC87C; }
  .si__stat-l{ font-size:11px; color:rgba(255,255,255,.82); margin-top:2px; }
  .si__stat-div{ width:1px; height:32px; background:rgba(255,255,255,.18); }
  .si__copy{ position:relative; margin:0; font-size:12px; color:rgba(255,255,255,.45); }

  /* ── Right form panel ── */
  .si__panel{ flex:none; width:520px; background:var(--ag-bg); display:flex; align-items:center; justify-content:center; padding:40px; }
  .si__form{ width:360px; max-width:100%; }
  .si-step{ animation:siUp .3s ease both; }
  .si-h2{ margin:0; font-family:var(--ag-font-display); font-weight:700; font-size:28px; color:var(--ag-ink); }
  .si-sub{ margin:9px 0 0; font-size:14px; line-height:1.5; color:var(--ag-ink-soft); }
  .si-sub strong{ color:var(--ag-ink); }
  .si-oauth{ width:100%; margin-top:24px; cursor:pointer; border:1px solid rgba(16,41,44,.16); background:#fff; color:var(--ag-ink);
    font-family:inherit; font-weight:600; font-size:14.5px; padding:13px; border-radius:12px; display:flex; align-items:center; justify-content:center; gap:10px; }
  .si-oauth:hover{ border-color:rgba(16,41,44,.3); }
  .si-or{ display:flex; align-items:center; gap:12px; margin:20px 0; }
  .si-or i{ flex:1; height:1px; background:rgba(16,41,44,.1); }
  .si-or span{ font-size:12px; color:#5a6d6f; }
  .si-label{ display:block; font-size:12px; font-weight:600; color:#4a5256; margin-bottom:7px; }
  .si-input{ width:100%; border:1px solid rgba(16,41,44,.16); border-radius:12px; padding:13px 15px;
    font-family:inherit; font-size:14.5px; color:var(--ag-ink); outline:none; transition:border-color .15s; }
  .si-input:focus{ border-color:var(--ag-green); }
  .si-input.is-valid{ border-color:var(--ag-green); }
  .si-input--otp{ text-align:center; font-family:var(--ag-font-mono); font-size:30px; font-weight:700; letter-spacing:.34em; padding:16px; margin-top:22px; }
  .si-cta{ width:100%; margin-top:14px; cursor:pointer; border:none; color:#fff; font-family:inherit; font-weight:600; font-size:15px;
    padding:14px; border-radius:12px; background:var(--ag-green); transition:opacity .15s, background .15s; }
  .si-cta:hover{ background:var(--ag-green-dark); }
  .si-cta:disabled{ background:#dfe4e3; color:#5b6669; opacity:1; cursor:not-allowed; }
  .si-fine{ margin:18px 0 0; font-size:11.5px; line-height:1.55; color:#5a6d6f; text-align:center; }
  .si-fine a{ color:var(--ag-green); }
  .si-back{ cursor:pointer; border:none; background:none; font-family:inherit; font-size:13px; font-weight:600; color:#5a6d6f; padding:0; margin-bottom:16px; }
  .si-resend{ margin:16px 0 0; text-align:center; font-size:12.5px; color:#5a6d6f; }
  .si-resend button{ color:var(--ag-green); font-weight:500; background:none; border:none; cursor:pointer; font-family:inherit; font-size:inherit; }
  .si-center{ text-align:center; }
  .si-spin{ width:48px; height:48px; margin:0 auto; border-radius:50%; border:4px solid #e8ece9; border-top-color:var(--ag-green); animation:siSpin .8s linear infinite; }
  .si-check{ width:64px; height:64px; margin:0 auto; border-radius:50%; background:#effaf0; display:flex; align-items:center; justify-content:center; }
  .si-startover{ margin-top:20px; cursor:pointer; border:1px solid rgba(16,41,44,.14); background:#fff; color:var(--ag-ink);
    font-family:inherit; font-weight:600; font-size:14px; padding:12px 24px; border-radius:999px; }

  @keyframes siUp{ from{opacity:0; transform:translateY(12px)} to{opacity:1; transform:translateY(0)} }
  @keyframes siSpin{ to{ transform:rotate(360deg) } }

  /* ── Responsive: stack panels ── */
  @media (max-width:860px){
    .si{ flex-direction:column; }
    .si__brand{ padding:30px 24px 26px; }
    .si__pitch h1{ font-size:30px; }
    .si__pitch p{ margin-top:12px; }
    .si__stats{ margin-top:20px; gap:14px; }
    .si__copy{ display:none; }
    .si__panel{ width:100%; flex:1; padding:32px 24px 48px; align-items:flex-start; }
  }
</style>
{% endblock %}

{% block content %}
<div class="si" x-data="signInFlow()">

  {# ── Left: brand panel ── #}
  <aside class="si__brand">
    <div class="si__orb" aria-hidden="true"></div>
    <a href="/" class="si__logo" aria-label="Africa GATES — home">
      <span class="si__logo-glyph" aria-hidden="true">G</span>
      <span class="si__logo-word"><b>Africa</b><span>GATES</span></span>
    </a>
    <div class="si__pitch">
      <h1>Recognition,<br>counted in the open.</h1>
      <p>Sign in to your Africa GATES account — for our independent judges, partners, and verified profiles.</p>
      <div class="si__stats">
        <div><div class="si__stat-n is-g">54</div><div class="si__stat-l">nations in scope</div></div>
        <div class="si__stat-div" aria-hidden="true"></div>
        <div><div class="si__stat-n">OTP</div><div class="si__stat-l">passwordless · secure</div></div>
        <div class="si__stat-div" aria-hidden="true"></div>
        <div><div class="si__stat-n">100%</div><div class="si__stat-l">audited results</div></div>
      </div>
    </div>
    <p class="si__copy">© <span x-text="year"></span> Africa GATES · An Afrovanguard initiative</p>
  </aside>

  {# ── Right: form panel ── #}
  <div class="si__panel">
    <div class="si__form">

      {# Step: email #}
      <div class="si-step" x-show="step==='email'" x-cloak>
        <h2 class="si-h2">Welcome back</h2>
        <p class="si-sub">Sign in with the email linked to your verified account. We'll send you a secure code — no password needed.</p>

        <label class="si-label" for="siEmail" style="margin-top:24px">Email address</label>
        <input id="siEmail" class="si-input" :class="validEmail && 'is-valid'" x-model="email" type="email" placeholder="you@email.com" autocomplete="email" @keydown.enter="sendCode()">
        <button type="button" class="si-cta" :disabled="!validEmail" @click="sendCode()">Continue with email</button>
        <p class="si-fine">By continuing you agree to our <a href="/terms">Terms</a> and <a href="/privacy">Privacy Policy</a>. Your email is hashed, never stored in plain text.</p>
        <p class="si-fine" style="margin-top:12px">Judge or administrator? <a href="/judge/login">Judge sign-in</a> · <a href="/admin/login">Admin sign-in</a></p>
      </div>

      {# Step: OTP #}
      <div class="si-step" x-show="step==='otp'" x-cloak>
        <button type="button" class="si-back" @click="step='email'">← Back</button>
        <h2 class="si-h2">Check your email</h2>
        <p class="si-sub">We sent a 6-digit code to <strong x-text="email"></strong>. It expires in 10 minutes.</p>
        <input class="si-input si-input--otp" aria-label="6-digit code" x-model="otp" inputmode="numeric" maxlength="6" placeholder="······"
               @input="otp = otp.replace(/\D/g,'').slice(0,6)" @keydown.enter="verify()">
        <button type="button" class="si-cta" :disabled="!validOtp" @click="verify()">Verify &amp; sign in</button>
        <p class="si-resend">Didn't get it? <button type="button" @click="step='email'">Resend code</button></p>
      </div>

      {# Step: loading #}
      <div class="si-center" x-show="step==='loading'" x-cloak style="padding:40px 0">
        <div class="si-spin" aria-hidden="true"></div>
        <p style="margin:20px 0 0;font-size:14.5px;font-weight:600;color:var(--ag-ink)">Signing you in…</p>
      </div>

      {# Step: done #}
      <div class="si-step si-center" x-show="step==='done'" x-cloak>
        <div class="si-check" aria-hidden="true"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#237b22" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></div>
        <h2 class="si-h2" style="margin-top:16px">You're in 🎉</h2>
        <p class="si-sub">Welcome back to Africa GATES.</p>
        <a href="/" class="si-cta" style="display:block;text-decoration:none;text-align:center;margin-top:18px">Continue</a>
        <button type="button" class="si-startover" @click="reset()">Start over</button>
      </div>

    </div>
  </div>
</div>

<script>
  function signInFlow(){
    return {
      step:'email', email:'', otp:'', year:new Date().getFullYear(),
      get validEmail(){ return /.+@.+\..+/.test(this.email); },
      get validOtp(){ return this.otp.replace(/\D/g,'').length===6; },
      sendCode(){ if(this.validEmail) this.step='otp'; },
      google(){ this.step='loading'; setTimeout(()=>{ this.step='done'; },1400); },
      verify(){ if(this.validOtp){ this.step='loading'; setTimeout(()=>{ this.step='done'; },1400); } },
      reset(){ this.step='email'; this.email=''; this.otp=''; }
    };
  }
</script>
{% endblock %}
