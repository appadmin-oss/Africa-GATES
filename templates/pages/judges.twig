{% extends "layout/gates.twig" %}

{% block head_styles %}
<style>
  body[data-page="judges"]{ background:#eef0ec; color:var(--ag-ink); }
  .jg{ max-width:1180px; margin:0 auto; padding:0 var(--ag-gutter,32px) 64px; }

  .jg-hero{ position:relative; overflow:hidden; border-radius:24px; margin-top:24px; background:radial-gradient(130% 130% at 80% 0%,#1d5b2a,#10292C 60%); padding:clamp(2.6rem,6vw,3.4rem) clamp(1.6rem,4vw,2.8rem); color:#fff; }
  .jg-hero__orb{ position:absolute; right:-60px; bottom:-80px; width:340px; height:340px; border-radius:50%; background:radial-gradient(circle,rgba(212,154,14,.28),transparent 68%); }
  .jg-hero__in{ position:relative; max-width:640px; }
  .jg-badge{ display:inline-flex; align-items:center; gap:7px; font-size:11px; font-weight:700; letter-spacing:.1em; text-transform:uppercase; color:#ffd24a; background:rgba(8,26,16,.55); box-shadow:inset 0 0 0 1px rgba(212,154,14,.32); padding:7px 14px; border-radius:999px; }
  .jg-hero h1{ margin:16px 0 0; color:#fff; font-family:var(--ag-font-display); font-weight:800; font-size:clamp(2.1rem,5.4vw,3rem); line-height:1.03; letter-spacing:-.02em; }
  .jg-hero p{ margin:14px 0 0; font-size:15.5px; line-height:1.65; color:rgba(255,255,255,.85); max-width:540px; }
  .jg-hero__meta{ position:relative; display:flex; gap:14px; margin-top:24px; flex-wrap:wrap; }
  .jg-chip{ display:inline-flex; align-items:center; gap:8px; font-size:12.5px; font-weight:600; color:rgba(255,255,255,.92); background:rgba(255,255,255,.08); box-shadow:inset 0 0 0 1px rgba(255,255,255,.14); padding:9px 15px; border-radius:999px; }
  .jg-chip b{ font-family:var(--ag-font-mono,monospace); color:#7FC87C; }

  .jg-filters{ display:flex; gap:8px; overflow-x:auto; scrollbar-width:none; margin-top:26px; padding-bottom:2px; }
  .jg-filters::-webkit-scrollbar{ display:none; }
  .jg-chip{ flex:none; cursor:pointer; font-family:inherit; font-size:13px; font-weight:600; padding:9px 16px; border-radius:999px; border:1px solid rgba(16,41,44,.12); background:var(--ag-surface,#fff); color:#4a5256; white-space:nowrap; }
  .jg-chip.is-on{ background:var(--ag-ink,#10292C); color:#fff; border-color:var(--ag-ink,#10292C); }
  .jg-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:20px; margin-top:18px; }
  .jg-card__arrow{ margin-top:auto; padding-top:12px; font-size:12.5px; font-weight:600; color:var(--ag-green,#237b22); display:inline-flex; align-items:center; gap:6px; }
  @media(max-width:860px){ .jg-grid{ grid-template-columns:repeat(2,1fr); gap:14px; } }
  @media(max-width:560px){ .jg-grid{ grid-template-columns:1fr 1fr; gap:12px; } }
  .jg-card{ background:var(--ag-surface,#fff); border:1px solid rgba(16,41,44,.08); border-radius:18px; overflow:hidden; display:flex; flex-direction:column; text-decoration:none; color:inherit; transition:transform .15s, box-shadow .15s, border-color .15s; }
  .jg-card:hover{ transform:translateY(-3px); border-color:rgba(16,41,44,.16); box-shadow:0 20px 40px -26px rgba(16,41,44,.45); }
  .jg-card__media{ position:relative; aspect-ratio:4/5; background-size:cover; background-position:center top; background-color:#10292C; }
  .jg-card__mono{ width:100%; height:100%; display:flex; align-items:center; justify-content:center; background:radial-gradient(120% 120% at 75% 0%,#1d5b2a,#10292C); color:#7FC87C; font-family:var(--ag-font-display,serif); font-weight:800; font-size:clamp(40px,9vw,64px); }
  .jg-card__cc{ position:absolute; top:12px; left:12px; font:700 10px/1 var(--ag-font-mono,monospace); letter-spacing:.08em; color:#10292C; background:rgba(255,255,255,.92); padding:6px 9px; border-radius:8px; }
  .jg-card__body{ padding:15px 17px 19px; flex:1; display:flex; flex-direction:column; }
  .jg-card__name{ font-family:var(--ag-font-display,serif); font-weight:700; font-size:17.5px; color:var(--ag-ink); line-height:1.15; }
  .jg-card__role{ margin-top:5px; font-size:13px; color:#1a6118; font-weight:600; }
  .jg-card__org{ font-size:12.5px; color:#5a6d6f; margin-top:1px; }
  .jg-card__bio{ margin-top:11px; font-size:13px; line-height:1.55; color:#4a5256; display:-webkit-box; -webkit-line-clamp:4; -webkit-box-orient:vertical; overflow:hidden; }

  .jg-empty{ background:var(--ag-surface,#fff); border:1px solid rgba(16,41,44,.08); border-radius:20px; padding:clamp(2rem,5vw,3rem); text-align:center; margin-top:24px; }
  .jg-empty h3{ margin:0 0 .4rem; font-family:var(--ag-font-display); font-weight:700; font-size:1.4rem; }
  .jg-empty p{ margin:0 auto; color:#4a5256; max-width:440px; }

  .jg-strip{ margin-top:30px; background:var(--ag-surface,#fff); border:1px solid rgba(16,41,44,.08); border-radius:20px; padding:24px 28px; display:flex; align-items:center; gap:18px; flex-wrap:wrap; }
  .jg-strip__i{ flex:none; width:48px; height:48px; border-radius:13px; background:#effaf0; color:#1a6118; display:flex; align-items:center; justify-content:center; }
  .jg-strip__b{ flex:1; min-width:220px; }
  .jg-strip__b b{ font-size:16px; color:var(--ag-ink); }
  .jg-strip__b div{ font-size:13.5px; color:#626a6e; margin-top:3px; }
  .jg-strip__cta{ flex:none; display:inline-flex; align-items:center; gap:7px; background:var(--ag-green,#237b22); color:#fff; font-weight:600; font-size:14px; padding:11px 20px; border-radius:999px; text-decoration:none; }
  .jg-strip__cta:hover{ background:var(--ag-green-dark,#1a6118); }
</style>
{% endblock %}

{% block content %}
<div class="jg">
  <div class="jg-hero">
    <div class="jg-hero__orb" aria-hidden="true"></div>
    <div class="jg-hero__in">
      <span class="jg-badge">⚖️ The Panel</span>
      <h1>Meet the judges</h1>
      <p>Independent experts who score every shortlisted nominee against a published rubric — judging documented impact, not popularity. Their confidential scores combine with verified community votes to form the Cultural Power Index.</p>
      {% if judges is not empty %}
      <div class="jg-hero__meta">
        <span class="jg-chip"><b>{{ judges|length }}</b> {{ judges|length == 1 ? 'judge' : 'judges' }} on the panel</span>
        <span class="jg-chip">Independent &amp; confidential</span>
        <span class="jg-chip">Scored on documented impact</span>
      </div>
      {% endif %}
    </div>
  </div>

  {% if judges is not empty %}
  <div x-data="{ filter: 'all' }">
    {% if filters is not empty %}
    <div class="jg-filters" role="tablist" aria-label="Filter judges by programme">
      <button type="button" class="jg-chip" :class="filter==='all' ? 'is-on' : ''" @click="filter='all'" :aria-pressed="filter==='all'">All judges</button>
      {% for slug, title in filters %}<button type="button" class="jg-chip" :class="filter==='{{ slug }}' ? 'is-on' : ''" @click="filter='{{ slug }}'" :aria-pressed="filter==='{{ slug }}'">{{ title }}</button>{% endfor %}
    </div>
    {% endif %}
    <div class="jg-grid">
      {% for j in judges %}
      <a class="jg-card" href="/judges/{{ j.slug }}" x-show="filter==='all' || ['{{ j.programmes|column('slug')|join("','")|raw }}'].includes(filter)" x-transition.opacity>
        <div class="jg-card__media" {% if j.avatar_path %}style="background-image:url('{{ j.avatar_path }}')"{% endif %}>
          {% if not j.avatar_path %}<div class="jg-card__mono" aria-hidden="true">{{ j.name|first|upper }}</div>{% endif %}
          {% if j.country_code %}<span class="jg-card__cc">{{ j.country_code }}</span>{% endif %}
        </div>
        <div class="jg-card__body">
          <div class="jg-card__name">{{ j.name }}</div>
          {% if j.title %}<div class="jg-card__role">{{ j.title }}</div>{% endif %}
          {% if j.organisation %}<div class="jg-card__org">{{ j.organisation }}</div>{% endif %}
          {% if j.bio %}<p class="jg-card__bio">{{ j.bio }}</p>{% endif %}
          <span class="jg-card__arrow">View profile
            <svg aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 20 20" fill="none"><path d="M7.5 4.5 13 10 7.5 15.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        </div>
      </a>
      {% endfor %}
    </div>
  </div>
  {% else %}
  <div class="jg-empty">
    <h3>Our panel is being assembled</h3>
    <p>The independent judges for this cycle are being confirmed. Check back soon — or read how scoring works in the meantime.</p>
  </div>
  {% endif %}

  <div class="jg-strip">
    <span class="jg-strip__i"><svg aria-hidden="true" focusable="false" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4 7v5c0 4.4 3.4 7.6 8 9 4.6-1.4 8-4.6 8-9V7l-8-4Z"/><path d="m9 12 2 2 4-4"/></svg></span>
    <div class="jg-strip__b"><b>Judging you can trust</b><div>Confidential ballots, a published rubric, conflict-of-interest recusal and quorum rules — see the full methodology.</div></div>
    <a class="jg-strip__cta" href="/integrity">How scoring works
      <svg aria-hidden="true" focusable="false" width="15" height="15" viewBox="0 0 20 20" fill="none"><path d="M7.5 4.5 13 10 7.5 15.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
  </div>
</div>
{% endblock %}
