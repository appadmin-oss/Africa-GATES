{% extends "layout/gates.twig" %}
{% block content %}
<section class="r26-hero" style="padding-block:clamp(3rem,7vw,5rem) clamp(2rem,4vw,3rem);text-align:center">
  <img class="r26-hero__wm" src="/assets/img/africa-watermark.svg?v={{ asset_version }}" alt="" aria-hidden="true">
  <div class="wrap">
    <div class="r26-hero__inner">
      {% if confirmed %}
      <span class="r26-reveal r26-d1" aria-hidden="true" style="display:inline-flex;align-items:center;justify-content:center;width:66px;height:66px;border-radius:50%;background:var(--emerald-50,#effaf0);color:var(--emerald-600,#1f9d55);margin:0 auto 1.4rem">
        <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
      </span>
      <p class="r26-eyebrow r26-reveal r26-d2" style="justify-content:center;display:inline-flex">Payment confirmed</p>
      <h1 class="r26-hl r26-reveal r26-d3" style="font-size:clamp(2.2rem,5.2vw,3.9rem)">Thank you — you're <em style="color:var(--emerald-600)">in.</em></h1>
      <p class="r26-sub r26-reveal r26-d4" style="margin-left:auto;margin-right:auto">
        We received <strong>₦{{ amount_naira|number_format }}</strong>.{% if bonus_votes > 0 %} Your <strong>{{ bonus_votes }} vote{{ bonus_votes == 1 ? '' : 's' }}</strong> are credited to <strong>this email</strong> — head to the voting page to cast them across any open category.{% else %} A receipt is on its way to your email.{% endif %}
      </p>
      {% if reference %}<p class="r26-reveal r26-d4" style="font-size:.8125rem;color:var(--neutral-500);margin-top:.5rem">Reference: {{ reference }}</p>{% endif %}
      <div class="r26-reveal r26-d5" style="display:flex;gap:.75rem;justify-content:center;flex-wrap:wrap;margin-top:1.9rem">
        {% if bonus_votes > 0 %}<a href="/vote" class="btn btn--emerald">Cast your votes <svg class="btn__arrow" viewBox="0 0 20 20" fill="none"><path d="M7.5 4.5 13 10 7.5 15.5" stroke="currentColor" stroke-width="1.75" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></a>{% endif %}
        <a href="/" class="btn {{ bonus_votes > 0 ? 'btn--ghost' : 'btn--emerald' }}">Back home</a>
      </div>
      {% else %}
      <span class="r26-reveal r26-d1" aria-hidden="true" style="display:inline-flex;align-items:center;justify-content:center;width:66px;height:66px;border-radius:50%;background:#fef2f2;color:#b91c1c;margin:0 auto 1.4rem">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16.5h.01"/></svg>
      </span>
      <p class="r26-eyebrow r26-reveal r26-d2" style="justify-content:center;display:inline-flex">Awaiting confirmation</p>
      <h1 class="r26-hl r26-reveal r26-d3" style="font-size:clamp(2.2rem,5.2vw,3.9rem)">We're <em style="color:var(--emerald-600)">checking</em> your payment.</h1>
      <p class="r26-sub r26-reveal r26-d4" style="margin-left:auto;margin-right:auto">If you completed payment, confirmation can take a moment — you'll get an email once it clears. If something went wrong, please reach out through the enquiry form.</p>
      <div class="r26-reveal r26-d5" style="display:flex;gap:.75rem;justify-content:center;flex-wrap:wrap;margin-top:1.9rem">
        <a href="/partner#enquiry" class="btn btn--emerald">Contact the team</a>
        <a href="/" class="btn btn--ghost">Back home</a>
      </div>
      {% endif %}
    </div>
  </div>
</section>
{% endblock %}
