{% extends "layout/gates.twig" %}
{% block content %}
{% if confirmed %}
{% set _bonus = bonus_votes|default(0) %}
{% include 'partials/success.twig' with {
  sc_accent: 'green',
  sc_art: 'gold',
  sc_glyph: _bonus > 0 ? 'ballot' : 'check',
  sc_kicker: 'Payment confirmed',
  sc_heading: _bonus > 0 ? 'Your votes are in' : 'Payment confirmed',
  sc_body: _bonus > 0
    ? 'We received your payment. Your ' ~ _bonus ~ ' vote' ~ (_bonus == 1 ? '' : 's') ~ ' are credited to this email — cast them across any open category.'
    : 'We’ve received your contribution. A receipt is on its way to your inbox.',
  sc_receipt: { label: 'Reference', code: reference, amount: '₦' ~ (amount_naira|number_format) },
  sc_primary: _bonus > 0 ? { label: 'Cast your votes', href: '/vote' } : { label: 'See the leaderboard', href: '/leaderboard' },
  sc_secondary: { label: 'Back home', href: '/' },
  sc_email_note: 'A receipt has been emailed to you.',
  sc_confetti: true,
  sc_next_label: 'Keep the momentum',
  sc_steps: _bonus > 0
    ? ['Open the voting page and choose a category.', 'Cast your verified votes — one per category.', 'Share your picks to rally more support.']
    : ['Your receipt is on its way by email.', 'Follow the leaderboard as the cycle builds.', 'Share Africa GATES to grow the movement.']
} only %}
{% else %}
{% include 'partials/success.twig' with {
  sc_accent: 'slate',
  sc_art: 'slate',
  sc_glyph: 'clock',
  sc_kicker: 'Awaiting confirmation',
  sc_heading: 'We’re checking your payment',
  sc_body: 'If you completed payment, confirmation can take a moment — you’ll get an email once it clears. If something went wrong, our team is happy to help.',
  sc_receipt: reference ? { label: 'Reference', code: reference } : null,
  sc_primary: { label: 'Contact support', href: '/support' },
  sc_secondary: { label: 'Back home', href: '/' },
  sc_email_note: 'No charge is confirmed until you receive an emailed receipt.',
  sc_confetti: false
} only %}
{% endif %}
{% endblock %}
