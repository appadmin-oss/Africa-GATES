{% extends "layout/gates.twig" %}

{#
  ══ /challenges/{slug} — BUILT FROM `ChallengePage.dc.html` ON THE SHARED LIBRARY ══

  ── HOW THIS PAGE IS PUT TOGETHER ───────────────────────────────────────────────

    partials/ui.twig    steps · ticks · notice · faq · row · meter · pill · tile
    components.css      what each of those looks like, on every page
    challenge.css       the hero, the rail and the theme — the three things only a
                        challenge has

  ── NOT ONE SENTENCE IS WRITTEN HERE ────────────────────────────────────────────

  Every word a reader sees comes out of `copy`, which is `ChallengeCopy::for()` — the
  comp's own `derive()`, ported. A string typed into this file would be a second place
  a challenge's terms are written, and the two would disagree the first time somebody
  raised a cap. The headings are the comp's, and are the same for every challenge.

  ── THE THEME IS A NAME ─────────────────────────────────────────────────────────

  `data-theme` on the root, resolved to tokens in challenge.css. The comp carries three
  hexes per challenge; storing them would let an admin pick a gold at 1.65:1 that reads
  as nothing on paper.

  ── DEPARTURES FROM THE COMP, EACH DELIBERATE ───────────────────────────────────

  1. "Included" is built. §3 of the handoff lists it; the comp does not draw it.
  2. The FAQ is `<details>`, opened on the first question as the comp rests. A
     disclosure that needs a script to open is a question some people never read.
  3. The root is a `<div>`. The layout already owns `<main id="main">`, and this page
     used to open a second one with the same id — two main landmarks, and a skip link
     with two targets.
#}

{% block content %}
{% import "partials/ui.twig" as ui %}
{% import "partials/icons.twig" as gi %}

{# The meter is drawn twice — the phone card and the rail — from this one count, so
   the two cannot disagree about how many places are gone. #}
{% set claimed_n = copy.has_meter ? (spots|filter(t => t)|length) : 0 %}

<div class="ch" data-theme="{{ c.theme }}">

  {# ══ HERO ═══════════════════════════════════════════════════════════════════ #}
  <section class="ch-hero" aria-labelledby="ch-h1">
    <div class="ch-hero__in">
      {% if c.art_url %}
        <img class="ch-hero__art" src="{{ c.art_url }}" alt="{{ c.art_alt|default('') }}"
             width="420" height="420" fetchpriority="high" decoding="async">
      {% else %}
        <span class="ch-hero__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
               stroke-linecap="round" stroke-linejoin="round">
            <path d="{{ c.icon|default('M6 4h12v4a6 6 0 0 1-12 0zM9 20h6M12 14v6') }}"/>
          </svg>
        </span>
      {% endif %}

      <div class="ch-hero__b">
        <p class="ch-hero__k">
          {# The flag is drawn, not an emoji: 🇳🇬 renders as two letters "NG" on
             Windows, which has no flag glyphs at all. #}
          {% if c.flag %}<span class="ch-flag" aria-hidden="true"><span></span><span></span><span></span></span>{% endif %}
          {{ c.kicker }}
          <span class="ch-state" data-state="{{ copy.state }}">{{ copy.state_label }}</span>
        </p>
        <h1 class="ch-hero__h" id="ch-h1">{{ c.title }}</h1>
        <p class="ch-hero__p">{{ copy.promise }}</p>

        {# WHO RUNS THIS AWARD. Resolved through the scope chain by ProgrammeHost, never
           stored on the challenge — two copies of a host's name is one copy nobody
           updates. Only when a host is NAMED: a logo alone is an unexplained picture. #}
        {% if host %}
        <p class="ch-host">
          {% if host.logo %}<img src="{{ host.logo }}" alt="" height="28" loading="lazy" decoding="async">{% endif %}
          <span>Hosted by {% if host.url %}<a href="{{ host.url }}" rel="noopener">{{ host.name }}</a>{% else %}<b>{{ host.name }}</b>{% endif %}</span>
        </p>
        {% endif %}

        {{ ui.facts(copy.facts) }}
      </div>
    </div>
  </section>

  {# ══ BODY ═══════════════════════════════════════════════════════════════════ #}
  <div class="ch-body">
    <div class="ch-main">

      {# The meter, phone only — from 600px the rail carries it. #}
      <div class="ch-meter ch-meter--phone ag-card">
        <span class="ag-between"><b>{{ copy.meter_title }}</b><span class="ag-list__value">{{ copy.time_left }}</span></span>
        {% if copy.has_meter and spots|length %}{{ ui.meter(claimed_n, spots|length, copy.meter_aria, 'outline') }}{% endif %}
        {% if entry %}<span class="ch-mine"><b>You:</b> {{ copy.mine }}</span>{% endif %}
      </div>

      {% if copy.steps|length %}
      <section class="ch-sec" aria-labelledby="h-how">
        <h2 class="ch-h2" id="h-how">How to take part</h2>
        {{ ui.steps(copy.steps, true) }}
      </section>
      {% endif %}

      <section class="ch-sec" aria-labelledby="h-count">
        <h2 class="ch-h2" id="h-count">{{ copy.count_title }}</h2>
        {{ ui.ticks(copy.rules) }}
      </section>

      <section class="ch-sec" aria-labelledby="h-win">
        <div class="ag-between">
          <h2 class="ch-h2" id="h-win">{{ copy.win_title }}</h2>
          <span class="ag-list__value">{{ copy.win_sub }}</span>
        </div>
        {% if winners|length %}
          <ol class="ch-winners">
            {% for w in winners %}
            <li>
              <span class="ch-winners__n">#{{ w.standing }}</span>
              {# Area and time only. A full name beside a published cash amount is an
                 invitation addressed to whoever reads it; ChallengeService::winners()
                 enforces it. #}
              <span class="ch-winners__b"><b>{{ w.name }}</b><span>{{ w.where }}</span></span>
              <span class="ch-winners__t">{{ w.when }}</span>
            </li>
            {% endfor %}
          </ol>
        {% else %}
          {{ ui.notice('trophy', copy.empty_title, copy.empty_sub) }}
        {% endif %}
      </section>

      {% if included|length %}
      <section class="ch-sec" aria-labelledby="h-inc">
        <h2 class="ch-h2" id="h-inc">Included</h2>
        <p class="ag-hint">Only what you do inside these counts towards this challenge.</p>
        <div class="ag-list">
          {% for i in included %}{{ ui.row({label: i.name, sub: i.kind, href: i.href}) }}{% endfor %}
        </div>
      </section>
      {% endif %}

      <section class="ch-sec" aria-labelledby="h-faq">
        <h2 class="ch-h2" id="h-faq">Questions</h2>
        {{ ui.faq(copy.faq, true) }}
        {% if copy.terms_version %}
          <a class="ch-terms" href="/terms">Full challenge terms · {{ copy.terms_version }}</a>
        {% endif %}
      </section>

      {% if others|length %}
      <section class="ch-sec" aria-labelledby="h-more">
        <h2 class="ch-h2" id="h-more">More challenges</h2>
        <div class="ch-more">
          {% for o in others %}
            {{ ui.row({icon: 'trophy', tone: {'green':'green','blue':'info','gold':'gold','rose':'live'}[o.theme]|default('green'),
                       label: o.title, sub: o.line, href: '/challenges/' ~ o.slug,
                       pill: {label: o.state_label, tone: o.state == 'open' ? 'ok' : (o.state == 'full' ? 'warn' : '')}}) }}
          {% endfor %}
        </div>
      </section>
      {% endif %}
    </div>

    {# ══ THE RAIL — from 600px; beside the column from 1024 ══════════════════ #}
    <aside class="ch-rail" aria-label="Take part">
      <span class="ch-rail__k">Prize</span>
      <b class="ch-rail__prize">{{ copy.prize_big }} <span>{{ copy.prize_unit }}</span></b>

      <div class="ch-meter">
        <span class="ag-between"><b>{{ copy.meter_title }}</b><span class="ag-list__value">{{ copy.time_left }}</span></span>
        {% if copy.has_meter and spots|length %}{{ ui.meter(claimed_n, spots|length, copy.meter_aria, 'outline') }}{% endif %}
      </div>

      {% if entry %}
      <div class="ch-rail__mine">
        <span><b>You:</b> {{ copy.mine }}</span>
        {{ ui.bar(copy.mine_pct, copy.mine) }}
      </div>
      {% endif %}

      <a class="ag-btn {{ copy.cta_primary ? 'ch-cta' : 'ag-btn--secondary' }} ag-btn--block" href="{{ copy.cta_href }}">{{ copy.cta }}</a>
      <p class="ag-hint">{{ copy.cta_note }}</p>

      {# The flier is a file rather than a share sheet: it is posted to WhatsApp and
         Instagram, where a link preview is not the point. #}
      <div class="ch-rail__acts">
        <button class="ag-btn ag-btn--secondary ag-btn--sm" type="button"
                data-ag-share data-share-url="/challenges/{{ c.slug }}"
                data-share-title="{{ c.title }}">Share</button>
        <a class="ag-btn ag-btn--secondary ag-btn--sm" href="/challenges/{{ c.slug }}/flier.png" download>Get the flier</a>
      </div>
    </aside>
  </div>

  {# ══ THE PHONE'S ACTION BAR ═══════════════════════════════════════════════
     The shared bar, fixed by the stylesheet so it is there on first paint: a bar
     placed from a measured property is missing for anybody whose script did not run,
     which this codebase shipped once on the nomination form. #}
  <div class="ag-actionbar ch-bar">
    <span class="ag-actionbar__sum">
      <b>{{ copy.prize_big }} {{ copy.prize_unit }}</b>
      <span>{{ copy.bar_sub }}</span>
    </span>
    <a class="ag-btn {{ copy.cta_primary ? 'ch-cta' : 'ag-btn--secondary' }}" href="{{ copy.cta_href }}">{{ copy.cta }}</a>
  </div>
</div>
{% endblock %}
