{% extends 'layout/shell.twig' %}
{#
  /my-work/{token} when the programme answers by INTERVIEW (MyWorkController::renderInterview).
  Destroyed on 3 Oct with the old pages and never rebuilt, so every nominee on an interview
  programme opened their invitation onto a 500. Rules carried from the inventory
  (docs/handoff/inventory/pages--my-work--interview.md):

    · NOTHING IS SENT until they press the button with their own name typed — said in the
      header and again on review;
    · THE AI NEVER WRITES THEIR ANSWERS — every summary is labelled as ours and carries the
      quote it came from, and each can be corrected or taken out;
    · PROGRESS IS APPROXIMATE AND SAYS SO;
    · the way out to the form is a plain POST on every screen, so a nominee whose script has
      failed can still finish (`switch` is deliberately not JSON);
    · a degraded conversation says what happened in the service's own sentence
      (`iv.degraded_message`) and offers the form — nothing they said is lost.

  The first paint is the whole state, drawn here; my-work-interview.js redraws the same
  regions from the state every endpoint returns, so a refresh and a turn cannot disagree.
  No site chrome (the controller's hide_chrome): a pinned composer cannot share a screen with
  a tab bar, and this page has one job.
#}
{% set colour_tier = '2' %}
{# A flow in the shell's own terms: no tab bar (the composer would sit under it) and a child
   app bar — the controller's hide_chrome drops the footer and the guide, not these. #}
{% set flow_page = true %}
{% set app_bar = {variant: 'child', title: 'Your interview'|trans} %}
{% set _who = persona ?: 'Interviewer'|trans %}
{% set _stopped = iv.degraded in ['no_ai', 'ceiling', 'off', 'unknown'] %}
{% set _status = {met: 'Covered'|trans, partial: 'Partly covered'|trans, unmet: 'Not yet'|trans} %}

{% block head_styles %}
  <link rel="stylesheet" href="{{ asset('/assets/css/components/my-work.css') }}">
{% endblock %}

{% block content %}
<div class="mw iv" data-iv data-token="{{ token }}" data-say-max="{{ say_max }}" data-phase="{{ iv.phase }}" data-who="{{ _who }}"{% if voice %} data-voice{% endif %}>

  {% if form.is_test %}<p class="mw__test" role="status">{{ 'This is a test link. Nothing said here reaches a judge.'|trans }}</p>{% endif %}

  <header class="mw__head">
    <p class="mw__kicker">{{ form.programme }}{% if form.category %} · {{ form.category }}{% endif %}</p>
    <h1 class="mw__h1">{{ '%n% — tell the judges about your work'|trans({'%n%': form.nominee}) }}</h1>
    <p class="mw__p">{{ 'Nothing is sent until you press Send with your name typed.'|trans }}{% if deadline %} {{ 'Please send it by %d%.'|trans({'%d%': deadline}) }}{% endif %}</p>
  </header>

  {% if notice %}<p class="mw__flash mw__flash--ok" role="status">{{ notice }}</p>{% endif %}
  {% if error %}<p class="mw__flash mw__flash--err" role="alert">{{ error }}</p>{% endif %}

  {% if iv.submitted %}
    <section class="mw__card" aria-labelledby="iv-sent">
      <h2 class="mw__h2" id="iv-sent">{{ 'This has been sent.'|trans }}</h2>
      <p class="mw__p">{{ 'Thank you%n%. It went to the judging panel%d%. You do not need to do anything else; we will email you if the panel has a question.'|trans({'%n%': iv.declared ? ', ' ~ iv.declared : '', '%d%': iv.submitted_at ? ' on ' ~ iv.submitted_at|date('j M Y') : ''}) }}</p>
    </section>
  {% else %}

  <div class="iv__prog" data-iv-prog>
    <p class="mw__ready">{{ 'About %m% of %t% things the panel asks about are covered so far. This is approximate.'|trans({'%m%': iv.progress.met, '%t%': iv.progress.total}) }}</p>
    {% set _pc = iv.progress.total > 0 ? (100 * iv.progress.met / iv.progress.total)|round : 0 %}
    <span class="iv__bar"><span class="iv__fill" aria-hidden="true" style="width:{{ _pc }}%"></span><span class="ag-sr" data-iv-pc>{{ '%p%% covered'|trans({'%p%': _pc}) }}</span></span>
  </div>

  {% if _stopped %}
    <section class="mw__card" aria-labelledby="iv-lost">
      <h2 class="mw__h2" id="iv-lost">{{ 'Nothing you said is lost.'|trans }}</h2>
      <p class="mw__p">{{ iv.degraded_message }}</p>
      <form method="post" action="/my-work/{{ token }}/interview/switch" class="mw__do">
        <input type="hidden" name="_token" value="{{ csrf_token }}">
        <button type="submit" class="ag-btn ag-btn--primary">{{ 'Carry on in the form'|trans }}</button>
      </form>
    </section>
  {% else %}

  <nav class="iv__tabs" aria-label="{{ 'Parts of the interview'|trans }}" data-iv-tabs>
    {% for p, l in {talk: 'Talk'|trans, show: 'Show the work'|trans, review: 'Read it back'|trans} %}
      <a class="iv__tab" href="#iv-{{ p }}" data-iv-tab="{{ p }}"{% if iv.phase == p %} aria-current="step"{% endif %}>{{ l }}</a>
    {% endfor %}
  </nav>

  <section class="mw__card iv__phase" id="iv-talk" data-iv-pane="talk" aria-labelledby="iv-talk-h">
    <h2 class="mw__h2" id="iv-talk-h">{{ 'Your words'|trans }}</h2>
    <p class="mw__help">{{ 'Answer in your own words. What you say is kept exactly as you said it — you can change or remove any of it.'|trans }}</p>
    <ol class="iv__log" data-iv-log aria-live="polite">
      {% for t in iv.turns %}
        <li class="iv__turn iv__turn--{{ t.role == 'nominee' ? 'me' : 'them' }}" data-i="{{ t.i }}">
          <p class="iv__who">{{ t.role == 'nominee' ? 'You'|trans : _who }}{% if t.amended %} · {{ 'changed'|trans }}{% endif %}</p>
          <p class="iv__text">{{ t.text }}</p>
        </li>
      {% endfor %}
    </ol>
    {% if iv.degraded == 'turns' %}
      <p class="mw__flash mw__flash--err" role="status">{{ iv.degraded_message }}</p>
    {% else %}
      <form class="iv__say" data-iv-say hidden>
        <label class="mw__lbl" for="iv-say-in">{{ 'Your answer'|trans }}</label>
        <textarea class="mw__in" id="iv-say-in" name="say" rows="4" maxlength="{{ say_max }}" enterkeyhint="send"></textarea>
        <p class="iv__status" data-iv-status role="status"></p>
        <div class="mw__do">
          {% if voice %}<button type="button" class="ag-btn ag-btn--secondary" data-iv-mic aria-pressed="false">{{ 'Say it instead of typing'|trans }}</button>{% endif %}
          <button type="submit" class="ag-btn ag-btn--primary">{{ 'Send'|trans }}</button>
        </div>
      </form>
      <noscript><p class="mw__help">{{ 'The conversation needs JavaScript, which is off in this browser. The form asks the same things — use the button at the bottom of the page.'|trans }}</p></noscript>
    {% endif %}
  </section>

  <section class="mw__card iv__phase" id="iv-show" data-iv-pane="show" aria-labelledby="iv-show-h">
    <h2 class="mw__h2" id="iv-show-h">{{ 'Show them the work.'|trans }}</h2>
    <p class="mw__help">{{ 'A document, a photo, a link — anything a judge can open. PDF or an image, up to %mb% MB each and %n% files in all.'|trans({'%mb%': form.max_file_mb, '%n%': form.max_files}) }}</p>
    {% if form.works %}
      <ul class="iv__works">
        {% for w in form.works %}<li><b>{{ w.title ?: w.file_name ?: 'Untitled'|trans }}</b>{% if w.file_name ?? '' %} · {{ 'file attached'|trans }}{% endif %}{% if w.link ?? '' %} · <a href="{{ w.link }}" rel="noopener nofollow" target="_blank">{{ 'link'|trans }}</a>{% endif %}</li>{% endfor %}
      </ul>
    {% endif %}
    <form method="post" action="/my-work/{{ token }}/upload" enctype="multipart/form-data" class="mw__up">
      <input type="hidden" name="_token" value="{{ csrf_token }}">
      <input type="hidden" name="uid" value="w{{ form.works|length + 1 }}">
      <label class="mw__lbl">{{ 'File'|trans }}<input class="mw__in" type="file" name="file" accept="application/pdf,image/*" required></label>
      <button type="submit" class="ag-btn ag-btn--secondary">{{ 'Upload'|trans }}</button>
    </form>
  </section>

  <section class="mw__card iv__phase" id="iv-review" data-iv-pane="review" aria-labelledby="iv-review-h">
    <h2 class="mw__h2" id="iv-review-h">{{ 'Read it before it goes.'|trans }}</h2>
    <p class="mw__help">{{ 'Each line is our summary of something you said, with your own words underneath. The summary is ours, not yours — correct it or take it out if it is wrong.'|trans }}</p>
    <div data-iv-ledger>
      {% set _left = iv.ledger|filter(o => o.required and o.status != 'met') %}
      {% if _left %}
        <h3 class="iv__h3">{{ 'What\'s left'|trans }}</h3>
        <ul class="iv__left">{% for o in _left %}<li>{{ o.label }}</li>{% endfor %}</ul>
      {% endif %}
      <ul class="iv__ledger">
        {% for o in iv.ledger|filter(o => o.status != 'unmet') %}
          <li class="iv__out" data-slug="{{ o.slug }}">
            <p class="iv__who">{{ o.label }} · {{ _status[o.status] ?? o.status }}{% if o.edited %} · {{ 'corrected by you'|trans }}{% endif %}</p>
            <p class="iv__text">{{ o.summary }}</p>
            {% if o.quote %}<blockquote class="iv__quote"><span class="ag-sr">{{ 'Your words:'|trans }}</span>{{ o.quote }}</blockquote>{% endif %}
            <div class="mw__do" data-iv-out-act hidden>
              <button type="button" class="ag-btn ag-btn--secondary" data-iv-correct="{{ o.slug }}">{{ 'Correct this'|trans }}</button>
              <button type="button" class="ag-btn ag-btn--secondary" data-iv-drop="{{ o.slug }}">{{ 'Take this out'|trans }}</button>
            </div>
          </li>
        {% else %}
          <li class="mw__help">{{ 'Nothing recorded yet. Talk first, then read it back here.'|trans }}</li>
        {% endfor %}
      </ul>
    </div>
    {% if iv.closing %}<p class="mw__p">{{ iv.closing }}</p>{% endif %}
    <form method="post" action="/my-work/{{ token }}" class="iv__send">
      <input type="hidden" name="_token" value="{{ csrf_token }}">
      <input type="hidden" name="action" value="submit">
      <label class="mw__lbl" for="iv-name">{{ 'Your full name'|trans }}</label>
      <input class="mw__in" id="iv-name" name="declared_name" value="{{ iv.declared }}" maxlength="200" autocomplete="name" required>
      <p class="mw__help">{{ 'Typing your name confirms that what you said is true. Nothing is sent until you press the button.'|trans }}</p>
      <button type="submit" class="ag-btn ag-btn--primary">{{ 'Send this to the judges'|trans }}</button>
    </form>
  </section>
  {% endif %}

  <form method="post" action="/my-work/{{ token }}/interview/switch" class="mw__resume">
    <input type="hidden" name="_token" value="{{ csrf_token }}">
    <button type="submit" class="ag-btn ag-btn--secondary">{{ 'Use the form instead'|trans }}</button>
  </form>
  {% endif %}
</div>
{% endblock %}

{% block foot_scripts %}<script defer src="{{ asset('/assets/js/my-work-interview.js') }}"></script>{% endblock %}
