{% extends "layout/gates.twig" %}

{# ── THE LIVE INTERVIEW ───────────────────────────────────────────────────────

   A conversation instead of a form, for the same person the form was built for: a teacher with
   an hour after school, on a phone, who has never used this site. Built to the mobile design at
   390px and allowed to grow from there — every value here traces to that handoff or to the
   site's own tokens.

   ── WHAT THE SCREEN HAS TO KEEP SAYING ──────────────────────────────────────

     • NOTHING IS SENT until they press the button with their own name typed. Said on the
       welcome screen, in the header, and again on review.
     • THE AI NEVER WRITES THEIR ANSWERS. Every machine-derived value on this page is labelled
       as such and carries the quote it came from.
     • PROGRESS IS APPROXIMATE AND SAYS SO. The rail comes from the outcome ledger, so it can
       jump by three in one turn. There is deliberately no percentage anywhere.
     • THE FORM IS ALWAYS ONE TAP AWAY, on every screen, as a real form post that works with
       the script broken.
     • AND NOTHING COSTS MONEY, because a fee demand is the commonest way an awards scheme is
       impersonated and this link lands with exactly the people that is aimed at.

   ── AND WHAT IT REFUSES TO DO ───────────────────────────────────────────────

   Lose anything. A failed turn keeps its text and retries in place — re-entry of data already
   supplied is a WCAG 3.3.7 failure as well as a betrayal. Voice transcription lands in the
   composer for correction and never straight into the record. Every way this can degrade ends
   in the form with the answers carried across. #}

{% block head_styles %}
<style nonce="{{ csp_nonce }}">
  /* The app surface. Full-bleed white below the site nav, so the composer can be pinned to
     the bottom of the conversation rather than to the bottom of a card. */
  /* ── THE SITE'S OWN FURNITURE IS PART OF THE LAYOUT ─────────────────────
     A fixed bottom tab bar appears below 900px (.ag-mobnav). A composer pinned to the bottom
     of the viewport therefore sits UNDERNEATH it — the send button unreachable and the row of
     escape hatches under it invisible, on exactly the viewport this screen was designed for.
     So the bar's height is reserved rather than discovered, and the same value keeps the
     conversation from ending behind it. */
  .iv{ --iv-bar:env(safe-area-inset-bottom, 0px); --iv-top:0px;
    background:#fff; color:#10292c; font-family:var(--ag-font-body, "DM Sans", system-ui, sans-serif);
    min-height:calc(100dvh - var(--ag-nav-h, 72px)); display:flex; flex-direction:column;
    max-width:640px; margin:0 auto; width:100%; box-sizing:border-box }
  /* The page renders with `hide_chrome`, so there is no site nav above and no tab bar below
     to reserve room for — only the phone's own home-indicator inset. The two variables stay
     rather than being inlined as zero, because the offsets are the thing a future change to
     this page would get wrong, and a named zero is easier to notice than an absent one. */

  /* ── THE CONVERSATION OWNS THE VIEWPORT; NOTHING ELSE DOES ───────────────
     A message log with a pinned composer cannot live in an ordinary scrolling document. It
     did, and the result was exactly what that arrangement always produces: scrolling to the
     end of the page left the composer behind and landed on the site footer, so the way to
     send a message was to scroll back UP. A sticky element only sticks while its container is
     on screen, and the container ended above 900px of footer.
     So the talk screen alone becomes a fixed surface between the two navs, with the log as
     the only scroller. Welcome, the files phase, review and the degraded screen stay ordinary
     pages — they are page-shaped, they end, and a footer under them is correct. */
  .iv--app{ position:fixed; left:0; right:0; top:var(--iv-top); bottom:var(--iv-bar);
    max-width:640px; margin:0 auto; min-height:0; z-index:5 }
  .iv--app .iv__head{ position:static; top:auto }
  /* `min-height:0` on BOTH, and the wrapper is the one that is easy to forget. An x-if block
     sits between the surface and the log, so the log is not a flex child of the fixed element
     — and a flex item defaults to min-height:auto, which means "never smaller than my
     content". Without it here the log grew to its full 920px inside a 774px surface and
     pushed the composer off the screen entirely. */
  .iv__talk{ display:flex; flex-direction:column; flex:1; min-height:0 }
  .iv--app .iv__log{ flex:1; min-height:0; overflow-y:auto; overscroll-behavior:contain }
  .iv--app .iv__composer{ position:static }
  /* The document behind must not scroll under it — two scrollers on a phone is how a thumb
     ends up moving the wrong one. */
  html.iv-locked, html.iv-locked body{ overflow:hidden }
  .iv *{ box-sizing:border-box }
  .iv__mono{ font-family:var(--ag-font-mono, ui-monospace, "JetBrains Mono", monospace) }

  /* ── shared type ───────────────────────────────────────────────────────── */
  .iv__eyebrow{ font:600 10px/1 var(--ag-font-mono, ui-monospace, monospace); letter-spacing:.22em;
    text-transform:uppercase; color:#237b22; margin:0 }
  .iv__h1{ font-family:var(--ag-font-display, "Playfair Display", Georgia, serif); font-weight:600;
    font-size:clamp(28px, 7.5vw, 34px); line-height:1.08; letter-spacing:-.025em; color:#10292c;
    margin:20px 0 0 }
  .iv__lede{ font-size:15.5px; line-height:1.7; color:#3d5254; margin:14px 0 0 }
  .iv__cap{ font-size:12.5px; line-height:1.6; color:#626a6e; margin:8px 0 0 }
  .iv__free{ font:500 11px/1.5 var(--ag-font-mono, ui-monospace, monospace); letter-spacing:.1em;
    text-transform:uppercase; color:#626a6e; text-align:center; margin:26px 0 0 }

  /* ── buttons ───────────────────────────────────────────────────────────── */
  .iv__go{ display:flex; align-items:center; justify-content:center; width:100%; min-height:56px;
    border:none; border-radius:16px; background:#10292c; color:#fff; cursor:pointer;
    font:600 15.5px/1 inherit; letter-spacing:-.01em; padding:0 20px; text-decoration:none }
  .iv__go:hover{ background:#1a3c40 }
  .iv__go--green{ background:#237b22 } .iv__go--green:hover{ background:#1a6118 }
  .iv__go[disabled]{ background:rgba(16,41,44,.16); cursor:default }
  .iv__quiet{ display:flex; align-items:center; justify-content:center; width:100%; min-height:50px;
    border:none; border-radius:14px; background:#f6f7f6; color:#3d5254; cursor:pointer;
    font:600 14px/1 inherit; padding:0 16px; text-decoration:none }
  .iv__quiet:hover{ background:#eceeec; color:#10292c }
  .iv__text{ display:inline-flex; align-items:center; justify-content:center; min-height:48px;
    background:none; border:none; cursor:pointer; font:600 14px/1 inherit; color:#3d5254;
    padding:0 8px; text-decoration:none }
  .iv__text:hover{ color:#10292c }
  .iv__2up{ display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-top:10px }
  .iv :focus-visible{ outline:2px solid #237b22; outline-offset:2px; border-radius:4px }

  /* ── 06 · welcome ──────────────────────────────────────────────────────── */
  .iv__welcome{ padding:30px 24px calc(32px + var(--iv-bar)) }
  .iv__facts{ margin:26px 0 0 }
  .iv__fact{ display:grid; grid-template-columns:auto 1fr; gap:14px; padding:15px 0;
    border-top:1px solid rgba(16,41,44,.09) }
  .iv__fact:last-child{ border-bottom:1px solid rgba(16,41,44,.09) }
  .iv__fact b{ color:#10292c; font-weight:600 }
  .iv__fact span{ font:600 10px/1.6 var(--ag-font-mono, ui-monospace, monospace); color:#626a6e }
  .iv__fact p{ margin:0; font-size:14px; line-height:1.6; color:#3d5254 }

  /* ── 07 · the conversation ─────────────────────────────────────────────── */
  .iv__head{ padding:8px 20px 14px; background:#fff; border-bottom:1px solid rgba(16,41,44,.08);
    position:sticky; top:var(--ag-nav-h, 72px); z-index:4 }
  .iv__headrow{ display:flex; align-items:center; gap:12px }
  .iv__title{ font:600 14.5px/1.2 inherit; color:#10292c; margin:0 }
  .iv__status{ font:500 10px/1.4 var(--ag-font-mono, ui-monospace, monospace); letter-spacing:.14em;
    text-transform:uppercase; color:#626a6e; margin:3px 0 0 }
  .iv__count{ margin-left:auto; display:inline-flex; align-items:center; gap:8px; height:44px;
    padding:0 15px; border:none; border-radius:999px; background:#f6f7f6; color:#10292c;
    font:600 13px/1 inherit; cursor:pointer }
  .iv__count:hover{ background:#eceeec }
  .iv__dot{ width:7px; height:7px; border-radius:50%; background:#237b22; flex:none }

  /* The rail is derived from the outcome ledger, never from a question index — it can jump
     by three in one turn, and there is deliberately no percentage. */
  .iv__rail{ display:flex; gap:3px; margin-top:12px }
  .iv__seg{ flex:1; height:3px; border-radius:99px; background:rgba(16,41,44,.1) }
  .iv__seg--met{ background:#237b22 }
  .iv__seg--part{ background:linear-gradient(90deg,#c9a24b 50%,rgba(16,41,44,.1) 50%) }

  /* ── THE LOG STARTS AT THE TOP, NOT AT THE BOTTOM ─────────────────────────
     `justify-content:flex-end` pins the messages to the bottom of a flex:1 column, which is
     right for a full conversation and wrong for the first one: the greeting appeared alone,
     a full screen below the header, under an expanse of nothing. The interview opened
     looking broken.

     `margin-top:auto` on the LAST turn does the same job only when there is room to spare —
     a short conversation sits under the header where it belongs, a long one still keeps its
     newest message at the bottom of the view. */
  .iv__log{ flex:1; padding:22px 20px; display:flex; flex-direction:column;
    justify-content:flex-start; gap:16px }
  .iv__turn{ display:flex; flex-direction:column }
  .iv__bub{ padding:14px 17px; font-size:15px; line-height:1.6; max-width:86%;
    white-space:pre-wrap; overflow-wrap:anywhere; border:none; text-align:left;
    font-family:inherit; margin:0 }
  .iv__bub--ai{ align-self:flex-start; background:#f1f6f1; color:#22332c;
    border-radius:22px 22px 22px 6px }
  .iv__bub--me{ align-self:flex-end; background:#10292c; color:#f2f6f3;
    border-radius:22px 22px 6px 22px; cursor:pointer }
  .iv__bub--sel{ box-shadow:0 0 0 3px #fff, 0 0 0 5px #237b22 }
  .iv__bub--fail{ align-self:flex-end; background:#fff; color:#3d5254;
    border:1.5px solid rgba(179,38,30,.35); border-radius:22px 22px 6px 22px }
  .iv__mine{ font:500 9.5px/1 var(--ag-font-mono, ui-monospace, monospace); letter-spacing:.14em;
    text-transform:uppercase; color:#626a6e; align-self:flex-end; margin-top:6px }
  .iv__failnote{ font:500 9.5px/1 var(--ag-font-mono, ui-monospace, monospace); letter-spacing:.14em;
    text-transform:uppercase; color:#b3261e; align-self:flex-end; margin-top:8px }

  /* Every machine-derived value carries this label and the quote behind it, wherever it
     appears. It is the difference between a record a panel can read and one it cannot. */
  .iv__noted{ align-self:flex-start; border-left:2px solid #237b22; padding-left:14px;
    max-width:92% }
  .iv__noted-k{ font:600 9.5px/1 var(--ag-font-mono, ui-monospace, monospace); letter-spacing:.14em;
    text-transform:uppercase; color:#237b22; margin:0 }
  .iv__noted-b{ font-size:13.5px; line-height:1.6; color:#3d5254; margin:6px 0 0 }
  .iv__noted-b b{ color:#10292c; font-weight:600 }
  .iv__noted-c{ font-size:12px; line-height:1.55; color:#626a6e; margin:6px 0 0 }

  .iv__typing{ align-self:flex-start; display:flex; gap:5px; padding:4px 2px }
  .iv__typing i{ width:5px; height:5px; border-radius:50%; background:#237b22; display:block;
    animation:ivDot 1.1s infinite }
  .iv__typing i:nth-child(2){ animation-delay:.15s }
  .iv__typing i:nth-child(3){ animation-delay:.3s }
  @keyframes ivDot{ 0%,80%,100%{ transform:translateY(0); opacity:.3 } 40%{ transform:translateY(-3px); opacity:1 } }

  /* ── the composer ──────────────────────────────────────────────────────── */
  .iv__composer{ position:sticky; bottom:var(--iv-bar); background:#fff; padding:14px 16px 26px;
    border-top:1px solid rgba(16,41,44,.08); z-index:3 }
  .iv__crow{ display:flex; align-items:flex-end; gap:10px }
  .iv__mic{ width:52px; height:52px; flex:none; border:none; border-radius:50%; background:#f6f7f6;
    cursor:pointer; display:flex; align-items:center; justify-content:center; position:relative }
  .iv__mic:hover{ background:#eceeec }
  .iv__mic i{ display:block; width:11px; height:19px; border-radius:6px; background:#10292c }
  .iv__mic--on{ background:#b3261e }
  .iv__mic--on i{ width:14px; height:14px; border-radius:3px; background:#fff }
  .iv__mic--on::after{ content:""; position:absolute; inset:-5px; border-radius:50%;
    border:2px solid rgba(179,38,30,.45); animation:ivHalo 1.4s ease-in-out infinite }
  @keyframes ivHalo{ 0%,100%{ opacity:.35 } 50%{ opacity:.9 } }
  .iv__field{ flex:1; display:flex; align-items:flex-end; gap:8px; background:#f6f7f6;
    border-radius:26px; min-height:52px; padding:0 8px 0 18px }
  .iv__field--armed{ border:1.5px solid #10292c }
  .iv__say{ flex:1; border:none; background:none; resize:none; font:400 15.5px/1.45 inherit;
    color:#10292c; padding:15px 0; max-height:40vh; overflow-y:auto }
  .iv__say:focus{ outline:none }
  .iv__say::placeholder{ color:#626a6e }
  .iv__send{ width:38px; height:38px; flex:none; margin-bottom:7px; border:none; border-radius:50%;
    background:rgba(16,41,44,.14); cursor:pointer; display:flex; align-items:center;
    justify-content:center }
  .iv__send--on{ background:#237b22 }
  .iv__send i{ display:block; width:9px; height:9px; border-top:2px solid #fff;
    border-right:2px solid #fff; transform:rotate(-45deg); margin-left:-2px }
  .iv__under{ display:flex; gap:18px; margin-top:12px; align-items:center; flex-wrap:wrap }
  .iv__under button, .iv__under a{ background:none; border:none; padding:0; cursor:pointer;
    font:600 12px/1 inherit; color:#3d5254; text-decoration:none; min-height:24px;
    display:inline-flex; align-items:center }
  .iv__under .iv__green{ color:#237b22 }
  .iv__rec{ font-size:12px; line-height:1.55; color:#b3261e; margin:10px 0 0 }

  /* ── 07e · the voice read-back ─────────────────────────────────────────── */
  .iv__heard{ border-top:1px solid rgba(16,41,44,.08); padding:16px 16px 0; margin:0 -16px 14px;
    padding-bottom:2px }
  .iv__heard-k{ display:flex; align-items:center; gap:8px; font:600 10px/1
    var(--ag-font-mono, ui-monospace, monospace); letter-spacing:.16em; text-transform:uppercase;
    color:#8a6a1c; margin:0 }
  .iv__heard-k b{ width:7px; height:7px; border-radius:50%; background:#c9a24b; display:block }
  .iv__heard-box{ border:1.5px solid #10292c; border-radius:20px; padding:14px 16px; margin-top:10px;
    font-size:15.5px; line-height:1.6; color:#10292c; white-space:pre-wrap }
  .iv__heard-acts{ display:flex; gap:10px; align-items:center; margin-top:12px }

  /* ── bottom sheets: 07c and 07d ────────────────────────────────────────── */
  .iv__scrim{ position:fixed; inset:0; background:rgba(8,17,15,.5); z-index:60 }
  /* Above the tab bar, not behind it: a sheet whose primary button is under the site's own
     navigation is a sheet with no way to close it on a phone. */
  .iv__sheet{ position:fixed; left:0; right:0; bottom:0; z-index:61; background:#fff;
    border-radius:32px 32px 0 0; padding:12px 24px calc(30px + var(--iv-bar));
    max-height:80dvh; overflow-y:auto; max-width:640px; margin:0 auto }
  .iv__grab{ width:38px; height:4px; border-radius:99px; background:rgba(16,41,44,.16);
    margin:0 auto 14px }
  .iv__sheet h2{ font-family:var(--ag-font-display, "Playfair Display", Georgia, serif);
    font-weight:600; font-size:24px; margin:0; color:#10292c; line-height:1.15 }
  .iv__sheet-head{ display:flex; align-items:baseline; gap:12px }
  .iv__sheet-n{ margin-left:auto; font:600 12px/1 var(--ag-font-mono, ui-monospace, monospace);
    letter-spacing:.14em; color:#237b22 }

  .iv__out{ display:grid; grid-template-columns:auto 1fr; gap:13px; padding:13px 0;
    border-top:1px solid rgba(16,41,44,.09); align-items:start }
  .iv__out:last-of-type{ border-bottom:1px solid rgba(16,41,44,.09) }
  .iv__out--part{ background:#fbfaf5 }
  .iv__mark{ width:16px; height:16px; border-radius:50%; margin-top:3px; flex:none;
    display:flex; align-items:center; justify-content:center }
  .iv__mark--met{ background:#237b22 }
  .iv__mark--met::after{ content:""; width:4px; height:7px; border-right:2px solid #fff;
    border-bottom:2px solid #fff; transform:rotate(42deg) translate(-1px,-1px) }
  .iv__mark--part{ border:2px solid #c9a24b }
  .iv__mark--unmet{ border:2px solid rgba(16,41,44,.2) }
  .iv__mark--opt{ border:2px dashed rgba(16,41,44,.25) }
  .iv__out-l{ font:600 14.5px/1.4 inherit; color:#10292c; margin:0 }
  .iv__out-l--soft{ color:#3d5254; font-weight:500 }
  .iv__out-s{ font-size:12.5px; line-height:1.55; color:#626a6e; margin:4px 0 0 }
  .iv__out-s--part{ color:#8a6a1c }

  .iv__opt{ display:block; width:100%; text-align:left; background:#f6f7f6; border:none;
    border-radius:16px; min-height:56px; padding:13px 16px; margin-top:10px; cursor:pointer;
    font-family:inherit }
  .iv__opt:hover{ background:#eceeec }
  .iv__opt b{ display:block; font:600 15px/1.35 inherit; color:#10292c }
  .iv__opt span{ display:block; font-size:12.5px; line-height:1.5; color:#3d5254; margin-top:3px }
  .iv__opt--bad{ background:#fff; border:1px solid rgba(179,38,30,.3) }
  .iv__opt--bad b{ color:#b3261e } .iv__opt--bad span{ color:#8a2020 }

  /* ── 07g · the files phase ─────────────────────────────────────────────── */
  .iv__phase{ padding:18px 20px 0 }
  .iv__phaserail{ display:flex; gap:4px; margin:10px 0 8px }
  .iv__phaserail i{ flex:1; height:3px; border-radius:99px; background:rgba(16,41,44,.1) }
  .iv__phaserail i.on{ background:#237b22 }
  .iv__phasewords{ display:flex; gap:8px; font:600 10px/1 var(--ag-font-mono, ui-monospace, monospace);
    letter-spacing:.16em; text-transform:uppercase; color:#626a6e }
  .iv__phasewords b{ color:#10292c }
  .iv__file{ display:flex; align-items:center; gap:11px; background:#f6f7f6; border-radius:12px;
    padding:10px 12px; margin-top:9px }
  .iv__file--bad{ background:#fff; border:1px solid rgba(179,38,30,.35) }
  .iv__badge{ width:32px; height:32px; flex:none; border-radius:8px; background:#e6ebe6;
    display:flex; align-items:center; justify-content:center;
    font:600 9px/1 var(--ag-font-mono, ui-monospace, monospace); color:#3d5254 }
  .iv__filename{ flex:1; min-width:0; font:600 13.5px/1.35 inherit; color:#10292c;
    overflow-wrap:anywhere }
  .iv__filemeta{ font-size:11.5px; color:#626a6e; margin-top:2px }
  .iv__x{ width:32px; height:32px; flex:none; border:none; border-radius:8px; background:none;
    cursor:pointer; color:#3d5254; font-size:16px; line-height:1 }
  .iv__x:hover{ background:rgba(16,41,44,.07); color:#10292c }
  .iv__drop{ border:1px dashed rgba(16,41,44,.25); border-radius:16px; padding:20px 16px;
    text-align:center; margin-top:12px }
  .iv__track{ height:4px; border-radius:99px; background:rgba(16,41,44,.1); margin-top:8px }
  .iv__track i{ display:block; height:100%; border-radius:99px; background:#237b22 }
  .iv__in{ width:100%; font-family:inherit; font-size:15px; line-height:1.5; color:#10292c;
    background:#f6f7f6; border:none; border-radius:14px; padding:13px 15px; min-height:50px }
  .iv__in:focus-visible{ outline:2px solid #237b22; outline-offset:1px }
  textarea.iv__in{ min-height:96px; resize:vertical }
  .iv__lab{ display:block; font:600 12px/1 inherit; color:#3d5254; margin:14px 0 6px }
  .iv__chips{ display:flex; flex-wrap:wrap; gap:8px; margin-top:6px }
  .iv__chip{ min-height:44px; padding:0 14px; border-radius:999px; border:1px solid rgba(16,41,44,.16);
    background:#fff; color:#3d5254; font:600 13px/1 inherit; cursor:pointer;
    display:inline-flex; align-items:center }
  .iv__chip[aria-pressed="true"]{ background:#10292c; border-color:#10292c; color:#fff }

  /* ── 08 · review ───────────────────────────────────────────────────────── */
  .iv__review{ padding:28px 20px calc(40px + var(--iv-bar)) }
  .iv__claim{ padding:20px 0; border-top:1px solid rgba(16,41,44,.09) }
  .iv__claim-h{ display:flex; align-items:center; gap:10px }
  .iv__claim-l{ font:600 15px/1.3 inherit; color:#10292c; margin:0 }
  .iv__tag{ font:600 9.5px/1 var(--ag-font-mono, ui-monospace, monospace); letter-spacing:.14em;
    text-transform:uppercase; color:#8a6a1c; background:#fbfaf5; border-radius:999px;
    padding:5px 8px }
  /* The nominee's sentence is the only editorial type on this screen, which is the correct
     hierarchy for a record whose whole promise is that the words are theirs. */
  .iv__quote{ font-family:var(--ag-font-display, "Playfair Display", Georgia, serif);
    font-size:17px; line-height:1.55; color:#10292c; margin:12px 0 0 }
  .iv__claim-acts{ display:flex; gap:16px; align-items:center; margin-top:6px; flex-wrap:wrap }
  .iv__claim-acts button{ background:none; border:none; cursor:pointer; padding:0;
    font:600 13.5px/1 inherit; min-height:44px; display:inline-flex; align-items:center }
  /* A full-width text button inside a claim block reads as a link on that block, not as a
     centred call to action — so it starts where the text above it starts. */
  .iv__claim .iv__text{ justify-content:flex-start; padding:0 }
  .iv__sub{ margin-top:26px; padding-top:22px; border-top:1px solid rgba(16,41,44,.09) }

  /* ── 09 · degraded ─────────────────────────────────────────────────────── */
  .iv__bad{ padding:22px 20px calc(30px + var(--iv-bar)) }
  .iv__state{ display:flex; gap:12px; padding:16px 0; border-top:1px solid rgba(16,41,44,.09) }
  .iv__state i{ width:9px; height:9px; border-radius:50%; margin-top:5px; flex:none }
  .iv__state-k{ font:600 10px/1 var(--ag-font-mono, ui-monospace, monospace); letter-spacing:.16em;
    text-transform:uppercase; margin:0 }
  .iv__state p{ font-size:13.5px; line-height:1.6; color:#3d5254; margin:7px 0 0 }

  .iv__ok{ margin:14px 20px 0; background:#eef7ee; border:1px solid rgba(35,123,34,.25);
    border-radius:12px; padding:12px 14px; font-size:13.5px; line-height:1.6; color:#22452a }
  .iv__err{ margin:14px 20px 0; background:#fdf4f3; border:1px solid rgba(179,38,30,.28);
    border-radius:12px; padding:12px 14px; font-size:13.5px; line-height:1.6; color:#7a1f19 }

  [x-cloak]{ display:none !important }

  /* The caret, the dots and the halo are decoration. Under reduced motion they stop; the
     information they carry is also written in words, which is why they can. */
  @media (prefers-reduced-motion: reduce){
    .iv__typing i, .iv__mic--on::after{ animation:none }
  }
</style>
{% endblock %}

{% block content %}
<div class="iv" :class="screen === 'talk' && 'iv--app'" x-data="ivApp()" x-cloak>

  {% if notice %}<div class="iv__ok">{{ notice }}</div>{% endif %}
  {% if error %}<div class="iv__err">{{ error }}</div>{% endif %}

  {# ══ 06 · welcome, and 06b · coming back ═══════════════════════════════ #}
  <div class="iv__welcome" x-show="screen === 'welcome'">
    <p class="iv__eyebrow" x-text="returning ? ('Saved · ' + savedWhen) : 'Your interview'"></p>
    <h1 class="iv__h1" x-text="returning ? 'Where we stopped.' : 'Tell us about your work.'"></h1>

    <template x-if="!returning">
      <div>
        <p class="iv__lede">This is a conversation rather than a form. It goes at your pace, in
          your own words, and you can stop and come back whenever you like.</p>

        <div class="iv__facts">
          <div class="iv__fact"><span>01</span>
            <p><b>You're talking to an AI.</b> It asks. It never writes your answers for you.</p></div>
          <div class="iv__fact"><span>02</span>
            <p><b>About 15 minutes.</b> Saved after every message — close it and come back.</p></div>
          <div class="iv__fact"><span>03</span>
            <p><b>Nothing reaches the judges</b> until you read it and send it.</p></div>
          <div class="iv__fact"><span>04</span>
            <p><b>Switch to the form whenever you like</b> — nothing is lost either way.</p></div>
        </div>
      </div>
    </template>

    <template x-if="returning">
      <div>
        <div class="iv__rail" style="margin-top:18px" aria-hidden="true">
          <template x-for="o in ledger" :key="o.slug">
            <i class="iv__seg" :class="o.status === 'met' ? 'iv__seg--met'
              : (o.status === 'partial' ? 'iv__seg--part' : '')"></i>
          </template>
        </div>
        <p class="iv__cap" x-text="progressWords"></p>

        <p class="iv__eyebrow" style="margin-top:24px; color:#626a6e">The last thing I asked</p>
        <div class="iv__bub iv__bub--ai" style="margin-top:10px; max-width:100%"
             x-text="lastAsk"></div>
      </div>
    </template>

    <button class="iv__go" style="margin-top:28px" type="button" @click="begin()"
            x-text="returning ? 'Pick up where we left off' : 'Start the conversation'"></button>

    <template x-if="returning">
      <div class="iv__2up">
        <button class="iv__quiet" type="button" @click="open()">See what's left</button>
        <button class="iv__quiet" type="button" @click="go('review')">Read it back</button>
      </div>
    </template>

    <form method="post" action="/my-work/{{ token }}/interview/switch" style="margin-top:10px">
      <input type="hidden" name="_token" value="{{ csrf_token }}">
      <button class="iv__text" type="submit" style="width:100%">Fill in the form instead</button>
    </form>

    {% if deadline %}
      <p class="iv__cap" style="text-align:center">Still nothing sent. The deadline is
        {{ deadline }}.</p>
    {% endif %}
    <p class="iv__free">Nothing about this costs money</p>
  </div>

  {# ══ 07 · the conversation ═════════════════════════════════════════════ #}
  <template x-if="screen === 'talk'">
    <div class="iv__talk">

      <div class="iv__head">
        <div class="iv__headrow">
          <div>
            <p class="iv__title">Interview</p>
            <p class="iv__status" x-text="statusLine"></p>
          </div>
          <button class="iv__count" type="button" @click="open()"
                  :aria-label="'What is left — ' + progressWords">
            <span class="iv__dot" aria-hidden="true"></span>
            <span x-text="metCount + ' of ' + ledger.length"></span>
          </button>
        </div>
        <div class="iv__rail" aria-hidden="true">
          <template x-for="o in ledger" :key="o.slug">
            <i class="iv__seg" :class="o.status === 'met' ? 'iv__seg--met'
              : (o.status === 'partial' ? 'iv__seg--part' : '')"></i>
          </template>
        </div>
      </div>

      <div class="iv__log" x-ref="log" aria-live="polite" aria-atomic="false">
        <template x-for="t in turns" :key="t.i">
          <div class="iv__turn">
            <template x-if="t.role !== 'nominee'">
              <p class="iv__bub iv__bub--ai" x-text="t.text"></p>
            </template>
            <template x-if="t.role === 'nominee'">
              <button type="button" class="iv__bub iv__bub--me"
                      :class="picked === t.i && 'iv__bub--sel'"
                      @click="pick(t)" :aria-label="'Your message. Tap to change or remove it.'"
                      x-text="t.text"></button>
            </template>
            <p class="iv__mine" x-show="picked === t.i" x-cloak
               x-text="'Your words · turn ' + (t.i + 1)"></p>
          </div>
        </template>

        <template x-if="failed">
          <div class="iv__turn">
            <p class="iv__bub iv__bub--fail" x-text="failed"></p>
            <p class="iv__failnote">Not sent · saved here</p>
            <button class="iv__quiet" type="button" style="width:auto; margin-top:8px;
              align-self:flex-end; min-height:44px; padding:0 18px" @click="retry()">Try again</button>
          </div>
        </template>

        <div class="iv__typing" x-show="busy" aria-hidden="true"><i></i><i></i><i></i></div>
      </div>

      <div class="iv__composer">

        {# 07e · check what we heard — transcription lands HERE, never in the record #}
        <template x-if="heard !== null">
          <div class="iv__heard">
            <p class="iv__heard-k"><b aria-hidden="true"></b> Check before you send</p>
            <p class="iv__cap" style="margin-top:8px">Names and places are the words most often
              misheard. Fix anything wrong before this becomes your answer.</p>
            <p class="iv__heard-box" x-text="heard"></p>
            <div class="iv__heard-acts">
              <button class="iv__mic" type="button" @click="record()"
                      aria-label="Record it again"><i aria-hidden="true"></i></button>
              <button class="iv__go iv__go--green" type="button" style="min-height:52px;
                border-radius:26px" @click="useHeard()">Use these words</button>
            </div>
            <button class="iv__text" type="button" @click="heard = null">Discard and type it
              instead</button>
          </div>
        </template>

        <div class="iv__crow">
          {% if voice %}
            <button class="iv__mic" type="button" :class="recording && 'iv__mic--on'"
                    @click="record()"
                    :aria-label="recording ? 'Stop recording' : 'Answer by talking'">
              <i aria-hidden="true"></i></button>
          {% endif %}
          <div class="iv__field" :class="recording && 'iv__field--armed'">
            <label class="sr-only" for="ivSay">Your answer</label>
            {# maxlength matches QuestionnaireInterview::MAX_SAY_CHARS. The server truncates at
               the same number, silently — so without this a nominee pasting three thousand
               words loses the tail with nothing to tell them, and the answer a panel reads
               stops mid-sentence. The browser stopping them is the only version they can see. #}
            <textarea class="iv__say" id="ivSay" x-model="say" x-ref="say" rows="1"
                      maxlength="{{ say_max }}"
                      @input="grow()" @keydown.enter.exact.prevent="send()"
                      placeholder="Type your answer…"></textarea>
            <button class="iv__send" type="button" :class="say.trim() && 'iv__send--on'"
                    :disabled="busy || !say.trim()" @click="send()"
                    aria-label="Send"><i aria-hidden="true"></i></button>
          </div>
        </div>

        <p class="iv__rec" x-show="recording" x-cloak
           x-text="'Listening · ' + clock + ' — press the square to stop. You will read it back before it sends.'"></p>
        <p class="iv__rec" x-show="hearing" x-cloak style="color:#8a6a1c">Writing down what you
          said…</p>
        <p class="iv__rec" x-show="err" x-cloak x-text="err"></p>
        <p class="iv__rec" x-show="say.length > {{ say_max - 400 }}" x-cloak style="color:#8a6a1c"
           x-text="({{ say_max }} - say.length) + ' characters left in this message. Send it and '
                 + 'carry on in the next one — there is no limit on how much you say overall.'"></p>

        <div class="iv__under">
          <button type="button" @click="go('show')">Show them your work</button>
          <form method="post" action="/my-work/{{ token }}/interview/switch" style="margin:0">
            <input type="hidden" name="_token" value="{{ csrf_token }}">
            <button type="submit" class="iv__green">Use the form instead</button>
          </form>
          <button type="button" x-show="proposed || ready" x-cloak class="iv__green"
                  @click="go('review')">Read it back</button>
        </div>
      </div>
    </div>
  </template>

  {# ══ 07g · show them the work ══════════════════════════════════════════ #}
  <template x-if="screen === 'show'">
    <div class="iv__phase" style="padding-bottom:calc(40px + var(--iv-bar))">
      <p class="iv__eyebrow">Step 2 of 3</p>
      <div class="iv__phaserail" aria-hidden="true"><i class="on"></i><i class="on"></i><i></i></div>
      <p class="iv__phasewords">Talk · <b>Show</b> · Send</p>

      <h1 class="iv__h1" style="font-size:28px">Show them the work.</h1>
      <p class="iv__lede">Anything a judge could look at: a report, a photograph, a page about
        it, a piece of coverage. Up to {{ form.max_works }} items and {{ form.max_files }} files
        of {{ form.max_file_mb }}MB each — for anything larger, a link is just as good.</p>

      <template x-if="suggestions.length">
        <div style="border-left:2px solid #237b22; padding-left:14px; margin-top:22px">
          <p class="iv__noted-k">From what you told me</p>
          <p class="iv__noted-c" style="margin-top:6px">Suggested · machine-derived · nothing is
            added until you tap it.</p>
          <template x-for="(s, si) in suggestions" :key="si">
            <button type="button" class="iv__opt" @click="takeSuggestion(si)">
              <b x-text="s.title"></b>
              <span x-text="'“' + s.quote + '”'"></span>
            </button>
          </template>
        </div>
      </template>

      <template x-for="(w, wi) in works" :key="w.uid">
        <div style="border-top:1px solid rgba(16,41,44,.09); padding-top:18px; margin-top:18px">
          <div style="display:flex; align-items:center; gap:10px">
            <p class="iv__eyebrow" style="color:#626a6e" x-text="'Item ' + (wi + 1)"></p>
            <button class="iv__x" type="button" style="margin-left:auto" @click="dropWork(wi)"
                    :aria-label="'Remove item ' + (wi + 1)">&times;</button>
          </div>

          <label class="iv__lab" :for="'wt' + w.uid">What is it called?</label>
          <input class="iv__in" :id="'wt' + w.uid" type="text" x-model="w.title" maxlength="200">

          <p class="iv__lab" id="wkind-label" x-show="wi === 0">What kind of thing is it?</p>
          <div class="iv__chips" role="group" aria-labelledby="wkind-label">
            <template x-for="k in kinds" :key="k.v">
              <button type="button" class="iv__chip" :aria-pressed="w.kind === k.v"
                      @click="w.kind = k.v" x-text="k.l"></button>
            </template>
          </div>

          <label class="iv__lab" :for="'wl' + w.uid">A link to it, if there is one</label>
          <input class="iv__in" :id="'wl' + w.uid" type="url" x-model="w.link"
                 placeholder="https://">

          <label class="iv__lab" :for="'wd' + w.uid">What should a judge understand about it?</label>
          <textarea class="iv__in" :id="'wd' + w.uid" x-model="w.description"
                    maxlength="600"></textarea>

          <template x-if="w.file">
            <div class="iv__file">
              <span class="iv__badge" x-text="ext(w.file)"></span>
              <div class="iv__filename"><span x-text="shortName(w.file)"></span>
                <p class="iv__filemeta">Attached</p></div>
              <button class="iv__x" type="button" @click="w.file = ''"
                      aria-label="Remove this file">&times;</button>
            </div>
          </template>

          <template x-if="uploads[w.uid]">
            <div class="iv__file" :class="uploads[w.uid].error && 'iv__file--bad'">
              <span class="iv__badge" x-text="uploads[w.uid].ext"></span>
              <div class="iv__filename"><span x-text="uploads[w.uid].name"></span>
                <p class="iv__filemeta" x-text="uploads[w.uid].note"></p>
                <template x-if="!uploads[w.uid].error">
                  <div class="iv__track"><i :style="'width:' + uploads[w.uid].pct + '%'"></i></div>
                </template>
              </div>
            </div>
          </template>

          <template x-if="uploads[w.uid] && uploads[w.uid].error">
            <button class="iv__quiet" type="button" style="margin-top:10px"
                    @click="focusLink(w)">Paste a link instead</button>
          </template>

          <template x-if="!w.file && !uploads[w.uid]">
            <div class="iv__drop">
              <p class="iv__cap" style="margin:0">A document, an image, a PDF — up to
                {{ form.max_file_mb }}MB.</p>
              <label class="iv__quiet" style="margin-top:10px; cursor:pointer"
                     :for="'wf' + w.uid">Choose from your phone</label>
              <input type="file" class="sr-only" :id="'wf' + w.uid"
                     @change="upload(w, $event.target.files[0])">
            </div>
          </template>
        </div>
      </template>

      <button class="iv__quiet" type="button" style="margin-top:18px" @click="addWork()"
              x-show="works.length < {{ form.max_works }}">Add another item</button>

      <div style="margin-top:26px">
        <p class="iv__rec" x-show="err" x-cloak x-text="err" style="margin:0 0 12px"></p>
        <button class="iv__go" type="button" :disabled="busy" @click="saveWorks(true)"
                x-text="busy ? 'Saving…' : 'Done — read it back'"></button>
        <button class="iv__text" type="button" style="width:100%; margin-top:6px"
                @click="skipWorks()">I have nothing to show — skip this</button>
        <p class="iv__cap" style="text-align:center">Skipping is allowed and is not held against
          you. Plenty of good work leaves no paper.</p>
      </div>

      <button class="iv__text" type="button" style="width:100%; margin-top:10px"
              @click="go('talk')">Back to the conversation</button>
    </div>
  </template>

  {# ══ 08 · review and submit ════════════════════════════════════════════ #}
  <template x-if="screen === 'review'">
    <div class="iv__review">
      <p class="iv__eyebrow">Nothing sent yet</p>
      <h1 class="iv__h1" style="font-size:32px">Read it before it goes.</h1>
      <p class="iv__lede">The headings are the interviewer's. The words underneath are yours,
        exactly as you said them. Change anything that is not right.</p>
      {% if iv.closing %}<p class="iv__lede">{{ iv.closing }}</p>{% endif %}

      <template x-for="o in ledger.filter(x => x.status !== 'unmet')" :key="o.slug">
        <div class="iv__claim">
          <div class="iv__claim-h">
            <span class="iv__mark" :class="o.status === 'met' ? 'iv__mark--met' : 'iv__mark--part'"
                  aria-hidden="true"></span>
            <p class="iv__claim-l" x-text="o.label"></p>
            <template x-if="o.status === 'partial'">
              <span class="iv__tag">Part-answered</span>
            </template>
          </div>

          <p class="iv__quote" x-text="'“' + o.quote + '”'"></p>

          <template x-if="editing === o.slug">
            <div style="margin-top:10px">
              <label class="sr-only" :for="'ed' + o.slug">Your words for this</label>
              <textarea class="iv__in" :id="'ed' + o.slug" x-model="editText"></textarea>
              <div class="iv__2up">
                <button class="iv__go iv__go--green" style="min-height:48px" type="button"
                        @click="saveEdit(o)">Save my words</button>
                <button class="iv__quiet" type="button" @click="editing = null">Cancel</button>
              </div>
            </div>
          </template>

          <template x-if="editing !== o.slug">
            <div class="iv__claim-acts">
              <button style="color:#237b22" type="button" @click="startEdit(o)">Edit these
                words</button>
              <button style="color:#3d5254" type="button" @click="dropClaim(o)">Not what I
                meant</button>
            </div>
          </template>

          <p class="iv__noted-c" x-show="!o.edited">Heading machine-derived ·
            <button type="button" style="background:none;border:none;padding:0;cursor:pointer;
              color:#237b22;font:600 12px/1 inherit;min-height:24px" @click="seeTurn(o)">See it in
              the conversation</button></p>
          <p class="iv__noted-c" x-show="o.edited" x-cloak>Your correction · the heading is no
            longer the machine's.</p>
        </div>
      </template>

      <div class="iv__claim" x-show="works.length">
        <p class="iv__claim-l" x-text="'What you are showing them · ' + works.length + ' item'
          + (works.length === 1 ? '' : 's')"></p>
        <template x-for="w in works" :key="w.uid">
          <div class="iv__file">
            <span class="iv__badge" x-text="w.file ? ext(w.file) : 'LINK'"></span>
            <div class="iv__filename"><span x-text="w.title || 'Untitled'"></span>
              <p class="iv__filemeta" x-text="w.kind || ''"></p></div>
          </div>
        </template>
        <button class="iv__text" type="button" style="width:100%" @click="go('show')">Add or
          change items</button>
      </div>

      <div class="iv__claim">
        <p class="iv__claim-l" x-text="'Full transcript · ' + turns.length + ' messages'"></p>
        <button class="iv__text" type="button" style="width:100%" @click="go('talk')">Read
          it</button>
      </div>

      {# The submit is a REAL FORM POST to the questionnaire's own submit path, so the model
         cannot reach it and neither can a broken script. propose_complete opens this screen
         and nothing more.
         Hidden once it has gone: a second "Send this to the judges" on a submission already
         with the panel invites somebody to press it and be told no. #}
      <form class="iv__sub" method="post" action="/my-work/{{ token }}" x-show="!submitted">
        <input type="hidden" name="_token" value="{{ csrf_token }}">
        <input type="hidden" name="action" value="submit">
        <label class="iv__lab" for="ivName">Type your full name to send it</label>
        <p class="iv__cap" style="margin:0 0 8px">This is your act, not the interviewer's. It
          cannot send for you.</p>
        <input class="iv__in" id="ivName" name="declared_name" type="text" autocomplete="name"
               maxlength="160" required>
        <button class="iv__go iv__go--green" type="submit" style="margin-top:14px">Send this to
          the judges</button>
      </form>

      <button class="iv__text" type="button" style="width:100%; margin-top:12px"
              @click="go(submitted ? 'done' : 'talk')"
              x-text="submitted ? 'Back' : 'Not yet — back to the conversation'"></button>
      <p class="iv__free">Nothing about this costs money</p>
    </div>
  </template>

  {# ══ ALREADY SENT ══════════════════════════════════════════════════════

     Not in the design pack, and needed: without it a nominee reopening their link after
     submitting was shown "Where we stopped" and a button into a conversation that then
     refused every turn — which reads as the submission having been lost. The guided form has
     said "Sent on …" since it shipped. #}
  <template x-if="screen === 'done'">
    <div class="iv__welcome">
      <p class="iv__eyebrow">With the judges</p>
      <h1 class="iv__h1">This has been sent.</h1>
      <p class="iv__lede">
        <span x-show="submittedAt" x-cloak x-text="'Sent on ' + submittedAt + '.'"></span>
        <span x-show="declared" x-cloak x-text="' Confirmed by ' + declared + '.'"></span>
        There is nothing else you need to do.
      </p>
      <p class="iv__cap">You can still read back what went, and the panel can ask us to reopen
        it if something needs correcting — write to us and say so rather than starting again.</p>

      <div class="iv__facts">
        <div class="iv__fact"><span>01</span>
          <p><b>Nobody will ask you for money.</b> Not for a shortlisting, not for a place, not
            at any stage. If anybody does, it is not us.</p></div>
        <div class="iv__fact"><span>02</span>
          <p><b>Your words were sent as you wrote them.</b> Nothing was rewritten on the way.</p></div>
      </div>

      <button class="iv__go" style="margin-top:26px" type="button" @click="go('review')">
        Read what was sent</button>
      <p class="iv__free">Nothing about this costs money</p>
    </div>
  </template>

  {# ══ 09 · when it cannot run ═══════════════════════════════════════════ #}
  <template x-if="screen === 'degraded'">
    <div class="iv__bad">
      <p class="iv__eyebrow" style="color:#b3261e">The conversation has stopped</p>
      <h1 class="iv__h1" style="font-size:28px">Nothing you said is lost.</h1>

      <div class="iv__state">
        <i :style="'background:' + (degraded === 'ceiling' || degraded === 'turns'
          ? '#626a6e' : '#b3261e')" aria-hidden="true"></i>
        <div>
          <p class="iv__state-k" :style="'color:' + (degraded === 'ceiling' || degraded === 'turns'
            ? '#626a6e' : '#b3261e')" x-text="degradedLabel"></p>
          <p x-text="degradedNote"></p>
        </div>
      </div>

      <form method="post" action="/my-work/{{ token }}/interview/switch" style="margin-top:18px">
        <input type="hidden" name="_token" value="{{ csrf_token }}">
        <button class="iv__go" type="submit">Carry on in the form</button>
      </form>
      <button class="iv__quiet" type="button" style="margin-top:10px" x-show="ready"
              @click="go('review')">Read back what we have and send it</button>
      <p class="iv__cap">Everything you have already said is carried across, and the form asks
        the same things.</p>
      <p class="iv__free">Nothing about this costs money</p>
    </div>
  </template>

  {# ══ 07c · what's left ═════════════════════════════════════════════════ #}
  <template x-if="drawer">
    <div>
      <div class="iv__scrim" @click="shut()"></div>
      <div class="iv__sheet" role="dialog" aria-modal="true" aria-labelledby="ivLeftH" tabindex="-1"
           x-ref="sheet" x-init="grab()" @keydown.tab="cycle($event)"
           @keydown.escape.window="shut()">
        <div class="iv__grab" aria-hidden="true"></div>
        <div class="iv__sheet-head">
          <h2 id="ivLeftH">What's left</h2>
          <span class="iv__sheet-n" x-text="metCount + ' of ' + ledger.length"></span>
        </div>
        <p class="iv__cap">It moves in jumps — one answer often settles several. A guide, not a
          score.</p>

        <template x-for="o in ledger" :key="o.slug">
          <div class="iv__out" :class="o.status === 'partial' && 'iv__out--part'">
            <span class="iv__mark" aria-hidden="true"
              :class="o.status === 'met' ? 'iv__mark--met'
                : (o.status === 'partial' ? 'iv__mark--part'
                : (o.required ? 'iv__mark--unmet' : 'iv__mark--opt'))"></span>
            <div>
              <p class="iv__out-l" :class="o.status === 'unmet' && 'iv__out-l--soft'"
                 x-text="o.label"></p>
              {# Status is never signalled by colour alone — every row carries the word. #}
              <p class="iv__out-s" :class="o.status === 'partial' && 'iv__out-s--part'"
                 x-text="rowNote(o)"></p>
            </div>
          </div>
        </template>

        <button class="iv__go" type="button" style="margin-top:20px; min-height:54px"
                @click="shut()">Back to the conversation</button>
      </div>
    </div>
  </template>

  {# ══ 07d · taking something back ═══════════════════════════════════════ #}
  <template x-if="picked !== null">
    <div>
      <div class="iv__scrim" @click="unpick()"></div>
      <div class="iv__sheet" role="dialog" aria-modal="true" aria-labelledby="ivBackH" tabindex="-1"
           x-ref="sheet" x-init="grab()" @keydown.tab="cycle($event)"
           @keydown.escape.window="unpick()">
        <div class="iv__grab" aria-hidden="true"></div>
        <h2 id="ivBackH">Your words</h2>
        <p class="iv__cap">Whatever you choose, anything the interviewer noted from this message
          is removed with it.</p>

        <template x-if="amending === null">
          <div>
            <button class="iv__opt" type="button" @click="amending = 'edit'">
              <b>Edit these words</b><span>The old version is not kept.</span></button>
            <button class="iv__opt" type="button" @click="amending = 'again'">
              <b>Say it again instead</b><span>Adds a new answer; the interviewer uses the newer
                one.</span></button>
            <button class="iv__opt iv__opt--bad" type="button" @click="amend('remove')">
              <b>Remove it from the record</b><span>The judges will never see it. Cannot be
                undone.</span></button>
            <button class="iv__text" type="button" style="width:100%; margin-top:10px"
                    @click="unpick()">Leave it as it is</button>
          </div>
        </template>

        <template x-if="amending !== null">
          <div style="margin-top:14px">
            <label class="sr-only" for="ivAmend">Your words</label>
            <textarea class="iv__in" id="ivAmend" x-model="amendText" x-ref="amend"></textarea>
            <button class="iv__go" type="button" style="margin-top:12px"
                    @click="amend(amending)"
                    x-text="amending === 'edit' ? 'Save the change' : 'Say it again'"></button>
            <button class="iv__text" type="button" style="width:100%"
                    @click="amending = null">Back</button>
          </div>
        </template>
      </div>
    </div>
  </template>
</div>

<script nonce="{{ csp_nonce }}">
/* ── THE INTERVIEW, CLIENT SIDE ────────────────────────────────────────────────
 *
 * One Alpine scope for the whole screen. It holds no truth of its own: every state-changing
 * call returns the server's `state()` and this replaces its copy wholesale, so a second tab,
 * a retried turn and a refresh can never disagree about what has been recorded.
 *
 * THE THREE RULES THE CODE HAS TO KEEP:
 *
 *   1. A failed turn keeps its text. `failed` holds it and `retry()` sends it again. Asking
 *      somebody to retype a paragraph they already typed is a WCAG 3.3.7 failure before it is
 *      anything else.
 *   2. Transcription lands in `heard` for correction, never in the record. The nominee presses
 *      send on words they have read.
 *   3. The bubble is the SAME component whether a reply arrives token by token, in chunks or
 *      all at once. There is no streaming here yet — the host is LiteSpeed behind cPanel and
 *      that is unproven — so the typing indicator is the honest interim and nothing about the
 *      layout has to change if streaming lands later. */
function ivApp(){
  const TOKEN = {{ token|json_encode(JSON_SAFE)|raw }};
  const CSRF  = {{ csrf_token|json_encode(JSON_SAFE)|raw }};
  const seed  = {{ iv|json_encode(JSON_SAFE)|raw }};
  const works = {{ (form.works ?: [])|json_encode(JSON_SAFE)|raw }};
  let uid = 0;

  return {
    /* ── server truth ───────────────────────────────────────────────────── */
    turns: seed.turns || [],
    ledger: seed.ledger || [],
    progress: seed.progress || {},
    phase: seed.phase || 'talk',
    proposed: !!seed.proposed,
    degraded: seed.degraded || '',
    submitted: !!seed.submitted,
    submittedAt: (seed.submitted_at || '').slice(0, 16).replace('T', ' '),
    declared: seed.declared || '',
    savedWhen: (seed.saved_at || '').slice(0, 16).replace('T', ' '),

    /* ── screen state ───────────────────────────────────────────────────── */
    started: (seed.turns || []).length > 1,
    screen: 'welcome',
    say: '', busy: false, err: '', failed: '',
    drawer: false, picked: null, amending: null, amendText: '',
    editing: null, editText: '',
    heard: null, recording: false, hearing: false, clock: '0:00',
    pending: 0,
    works: (works || []).map(w => Object.assign({ uid: 'w' + (++uid) }, w)),
    uploads: {}, suggestions: [],
    kinds: [
      { v: 'document', l: 'A document or report' },
      { v: 'link',     l: 'A website or page' },
      { v: 'media',    l: 'A photograph or video' },
      { v: 'award',    l: 'An award or prize' },
      { v: 'press',    l: 'News or press coverage' }
    ],

    init(){
      /* Sent is checked FIRST and is not a degraded state. Every other value of `degraded`
         means "something is stopping you, here is the way out"; this one means the work is
         done. Treating them alike is what put a resume button in front of somebody whose
         submission had already been filed. */
      if (this.submitted) { this.screen = 'done'; }
      else if (this.degraded) { this.screen = 'degraded'; }
      else if (this.phase === 'show')   { this.screen = 'show'; }
      else if (this.phase === 'review') { this.screen = 'review'; }
      // Everyone else lands on the welcome screen — first-timers to be told what this is,
      // returners to be shown that their draft survived. `returning` picks which.
      this.$watch('screen', v => this.lock(v === 'talk'));
      this.lock(this.screen === 'talk');
      this.$nextTick(() => this.scroll());
    },

    /* The document behind the conversation must not scroll. Toggled rather than set once,
       because every other screen here is an ordinary page and locking those would strand a
       nominee halfway down the files phase. */
    lock(on){
      document.documentElement.classList.toggle('iv-locked', !!on);
      // Back to the top FIRST. The surface is positioned from the viewport, so entering it
      // from a page the nominee had scrolled would show whatever was above it — on the first
      // build, the site footer — wedged over the header.
      if (on) window.scrollTo(0, 0);
    },

    /* ── derived ────────────────────────────────────────────────────────── */
    get returning(){ return this.started },
    get metCount(){ return this.ledger.filter(o => o.status === 'met').length },
    get ready(){ return !!(this.progress && this.progress.ready) },
    get lastAsk(){
      for (let i = this.turns.length - 1; i >= 0; i--) {
        if (this.turns[i].role !== 'nominee') return this.turns[i].text;
      }
      return '';
    },
    get progressWords(){
      const left = (this.progress && this.progress.required_left) || 0;
      if (!this.ledger.length) return 'Nothing recorded yet.';
      return left === 0
        ? 'Everything the panel needs is here. You can read it back whenever you like.'
        : left + ' thing' + (left === 1 ? '' : 's') + ' still to cover.';
    },
    get statusLine(){ return this.busy ? 'Thinking' : 'Saving as you go' },
    get degradedLabel(){
      return ({ no_ai: 'Interviewer unavailable', ceiling: 'Allowance reached',
                turns: 'This interview has run its length', sent: 'Already sent',
                off: 'Answered in the form' })[this.degraded] || 'Stopped';
    },
    get degradedNote(){
      return ({
        no_ai:   'The interviewer is not answering right now. Everything you have said is saved.',
        ceiling: 'This conversation has reached its length allowance. Nothing is lost.',
        turns:   'We have talked as long as this interview runs for.',
        sent:    'This has already gone to the judges.',
        off:     'This questionnaire is answered in the form.'
      })[this.degraded] || 'Your answers are saved.';
    },
    rowNote(o){
      if (o.status === 'met')     return 'Done · “' + (o.quote || '').slice(0, 70) + '”';
      if (o.status === 'partial') return "Part-answered · we're on this now";
      return o.required ? 'Not yet'
        : 'Optional · saying so has never cost anyone an award.';
    },

    /* ── navigation ─────────────────────────────────────────────────────── */
    go(where){
      this.screen = where;
      /* The proposals used to be generated only on the turn where propose_complete moved the
         phase. Anybody who reached the files phase by pressing "Show them your work" — which
         is on the composer of every screen — got no suggestions at all, and the block the
         design calls "From what you told me" simply never appeared for them. */
      if (where === 'show') this.suggest();
      if (where === 'talk' || where === 'show' || where === 'review') {
        this.post('/interview/phase', { phase: where === 'talk' ? 'talk' : where });
      }
      if (where === 'talk') this.$nextTick(() => this.scroll());
    },
    begin(){ this.started = true; this.screen = 'talk'; this.$nextTick(() => this.scroll()) },

    /* ── the turn ───────────────────────────────────────────────────────── */
    async send(){
      const t = this.say.trim();
      if (!t || this.busy) return;
      this.say = ''; this.grow();
      await this.turn(t);
    },
    async retry(){
      const t = this.failed;
      // The busy guard is on send() and was missing here. Two fast taps on "Try again" ran
      // two turns, each pushing an optimistic bubble — and two bubbles sharing a :key is the
      // exact ambiguity that breaks Alpine's x-for bookkeeping. The unique key below makes
      // that harmless; this makes it not happen.
      if (!t || this.busy) return;
      this.failed = '';
      await this.turn(t);
    },
    async turn(text){
      this.busy = true; this.err = ''; this.failed = '';
      /* Shown immediately so the conversation does not appear to swallow what was typed. The
         server's copy replaces it the moment the reply lands, which is also what gives the
         bubble its real turn index.
         The placeholder key COUNTS DOWN rather than being a fixed -1: two optimistic bubbles
         sharing one :key makes Alpine's x-for bookkeeping ambiguous, and the next splice
         throws — the same defect that made Copy silently do nothing in the admin builder.
         Negative, so it can never collide with a real transcript index. */
      const key = --this.pending;
      this.turns.push({ i: key, role: 'nominee', text });
      this.$nextTick(() => this.scroll());

      const d = await this.post('/interview', { say: text });
      this.busy = false;

      if (!d || !d.ok) {
        /* The typed words are never lost. They come out of the optimistic list and into
           `failed`, which renders as an unsent bubble with a retry beside it. */
        this.turns = this.turns.filter(x => x.i >= 0);
        this.failed = text;
        this.err = (d && d.message) || 'That did not get through.';
        if (d && d.degraded && d.degraded !== 'turn_failed') {
          this.degraded = d.degraded; this.screen = 'degraded';
        }
        return;
      }
      this.absorb(d);
      if (d.phase === 'show' && this.screen === 'talk') {
        this.suggest();
        this.screen = 'show';
      }
      this.$nextTick(() => this.scroll());
    },

    absorb(d){
      if (Array.isArray(d.turns))  this.turns = d.turns;
      if (Array.isArray(d.ledger)) this.ledger = d.ledger;
      if (d.progress) this.progress = d.progress;
      if (d.phase)    this.phase = d.phase;
      this.proposed = !!d.proposed;
      this.degraded = d.degraded || '';
      if (d.saved_at) this.savedWhen = String(d.saved_at).slice(0, 16).replace('T', ' ');
    },

    async post(path, body){
      try {
        /* The CSRF token, because this is a same-origin POST from our own page. These routes
           are not under /api/, so CsrfMiddleware requires the header rather than accepting
           X-Requested-With. */
        const r = await fetch('/my-work/' + TOKEN + path, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF,
                     'X-Requested-With': 'XMLHttpRequest' },
          body: JSON.stringify(body || {})
        });
        return await r.json();
      } catch (e) { return null; }
    },

    /* ── the bottom sheets ──────────────────────────────────────────────────
     *
     * A hand-rolled focus trap, because no Alpine focus plugin is loaded here and `x-trap`
     * would be an attribute nothing reads — the worst kind of accessibility code, the sort
     * that looks present in the markup and does nothing at all.
     *
     * Three obligations, all of them real for somebody on a keyboard or a screen reader: the
     * sheet takes focus when it opens, Tab cannot leave it while it is open, and focus goes
     * back to whatever opened it. Without the third, closing the drawer drops the caret at the
     * top of the document and a keyboard user has to walk the whole conversation again. */
    returnTo: null,

    open(){ this.returnTo = document.activeElement; this.drawer = true },
    shut(){
      this.drawer = false;
      if (this.returnTo && this.returnTo.focus) this.returnTo.focus();
      this.returnTo = null;
    },
    grab(){
      this.$nextTick(() => {
        // The DIALOG takes focus, not its first control. Focusing the first button scrolled
        // the sheet down to reach it — past its own heading and standfirst — so the panel
        // opened mid-list with no indication of what it was. Focusing the container announces
        // the label, leaves the sheet at the top, and Tab still walks into it.
        if (this.$refs.sheet) this.$refs.sheet.focus({ preventScroll: true });
      });
    },
    focusables(){
      const el = this.$refs.sheet;
      if (!el) return [];
      return Array.from(el.querySelectorAll(
        'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
      )).filter(n => !n.disabled && n.offsetParent !== null);
    },
    cycle(e){
      const f = this.focusables();
      if (!f.length) return;
      const first = f[0], last = f[f.length - 1];
      // Focus is on the sheet itself on open, which is neither end of the list — Tab from
      // there must land on the first control rather than escaping to the page behind.
      if (document.activeElement === this.$refs.sheet) {
        e.preventDefault();
        (e.shiftKey ? last : first).focus();
        return;
      }
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    },

    /* ── taking a turn back ─────────────────────────────────────────────── */
    pick(t){
      // Not while it is still in flight: there is no turn on the server to amend yet.
      if (t.i < 0) return;
      this.returnTo = document.activeElement;
      this.picked = t.i; this.amending = null; this.amendText = t.text;
    },
    unpick(){
      this.picked = null; this.amending = null;
      if (this.returnTo && this.returnTo.focus) this.returnTo.focus();
      this.returnTo = null;
    },
    async amend(how){
      /* "Say it again instead" is an ORDINARY TURN, not an amendment.
         The server can append one — and appending is all it did, so the nominee was left
         looking at their own new message with no reply, which reads as the interview having
         stopped working. Sending it through turn() appends the same verbatim text AND gets an
         answer, which is what "say it again" means to the person doing it. */
      if (how === 'again') {
        const text = this.amendText;
        this.unpick();
        await this.turn(text);
        return;
      }
      const d = await this.post('/interview/amend',
        { turn: this.picked, how, text: this.amendText });
      if (d && d.ok) { this.absorb(d); this.unpick(); }
      else this.err = (d && d.message) || 'That did not go through.';
    },

    /* ── review ─────────────────────────────────────────────────────────── */
    startEdit(o){ this.editing = o.slug; this.editText = o.quote },
    async saveEdit(o){
      const d = await this.post('/interview/outcome',
        { slug: o.slug, action: 'correct', text: this.editText });
      if (d && d.ok) { this.absorb(d); this.editing = null; }
    },
    async dropClaim(o){
      const d = await this.post('/interview/outcome', { slug: o.slug, action: 'drop' });
      if (d && d.ok) this.absorb(d);
    },
    seeTurn(o){
      this.screen = 'talk';
      this.$nextTick(() => {
        const log = this.$refs.log;
        if (!log) return;
        // By position in the RENDERED list, which skips withdrawn turns — the stored
        // turn_index is the transcript's, and the two stop matching the moment somebody takes
        // a message back.
        const at = this.turns.findIndex(t => t.i === o.turn);
        const el = at >= 0 ? log.children[at] : null;
        if (el) log.scrollTop = el.offsetTop - log.clientHeight / 2;
      });
    },

    /* ── the works ──────────────────────────────────────────────────────── */
    addWork(){
      this.works.push({ uid: 'w' + (++uid), title: '', kind: 'document', year: '',
                        link: '', description: '', file: '' });
    },
    dropWork(i){ this.works.splice(i, 1) },
    takeSuggestion(i){
      const s = this.suggestions[i];
      this.works.push({ uid: 'w' + (++uid), title: s.title, kind: s.kind || 'document',
                        year: '', link: '', description: s.quote, file: '' });
      this.suggestions.splice(i, 1);
    },
    focusLink(w){
      delete this.uploads[w.uid];
      this.$nextTick(() => { const el = document.getElementById('wl' + w.uid); if (el) el.focus(); });
    },
    ext(name){ const m = String(name).match(/\.([a-z0-9]{1,5})$/i); return m ? m[1].toUpperCase() : 'FILE' },
    shortName(p){ return String(p).split('/').pop() },

    async upload(w, file){
      if (!file) return;
      const max = {{ form.max_file_mb }} * 1024 * 1024;
      const mb  = (file.size / 1048576).toFixed(1);
      if (file.size > max) {
        /* Never a bare refusal. The size that was actually sent, against the limit that
           actually applies, and the route that always works instead. */
        this.uploads[w.uid] = { name: file.name, ext: this.ext(file.name), pct: 0, error: true,
          note: mb + 'MB — the limit is {{ form.max_file_mb }}MB. A link works just as well.' };
        return;
      }
      this.uploads[w.uid] = { name: file.name, ext: this.ext(file.name), pct: 0, error: false,
        note: 'Uploading… keep this page open. You can carry on typing.' };

      /* The work row is saved FIRST so the upload has a uid to attach to. The old form made
         the nominee do that themselves — "save this page, then attach a file below" — which
         is a step nobody should have to understand. */
      await this.saveWorks(false);

      const fd = new FormData();
      fd.append('_token', CSRF);
      fd.append('uid', w.uid);
      fd.append('file', file);
      try {
        const r = await fetch('/my-work/' + TOKEN + '/upload', {
          method: 'POST', body: fd, headers: { 'X-CSRF-Token': CSRF } });
        if (!r.ok) throw new Error('upload');
        this.uploads[w.uid] = { name: file.name, ext: this.ext(file.name), pct: 100,
          error: false, note: 'Attached' };
        w.file = file.name;
      } catch (e) {
        this.uploads[w.uid] = { name: file.name, ext: this.ext(file.name), pct: 0, error: true,
          note: 'That did not upload. A link works just as well.' };
      }
    },

    async saveWorks(advance){
      this.busy = true; this.err = '';
      const fd = new FormData();
      fd.append('_token', CSRF);
      this.works.forEach((w, i) => {
        ['uid','title','kind','year','link','description','file'].forEach(k => {
          fd.append('w[' + i + '][' + k + ']', w[k] || '');
        });
      });
      /* A FAILURE HERE IS A REAL LOSS AND MUST STOP THE FLOW.
         This used to swallow the error on the reasoning that "the draft is also saved on every
         turn" — which is false: a turn saves the TRANSCRIPT, and nothing else writes the works
         list. So a dropped connection here lost every item the nominee had just described, and
         then moved them on to a review screen that listed them from memory and a submit button
         that would file none of them. */
      let ok = false;
      try {
        const r = await fetch('/my-work/' + TOKEN, { method: 'POST', body: fd,
          headers: { 'X-CSRF-Token': CSRF, 'X-Requested-With': 'XMLHttpRequest' } });
        ok = r.ok;
      } catch (e) { ok = false; }
      this.busy = false;

      if (!ok) {
        this.err = 'Those items could not be saved just now — nothing has been lost from this '
                 + 'page. Try again in a moment.';
        return;
      }
      if (advance) this.go('review');
    },
    skipWorks(){ this.go('review') },

    /* Proposals are DERIVED FROM QUOTES, so each one carries the sentence it came from and
       nothing is ever created without a tap. A heuristic rather than another model call: the
       nominee is standing here waiting, and a second round trip to suggest a title they will
       retype anyway is not worth their time. */
    suggest(){
      const seen = new Set(this.works.map(w => (w.title || '').toLowerCase()));
      const out  = [];
      this.turns.filter(t => t.role === 'nominee').forEach(t => {
        const m = String(t.text).match(
          /\b(report|study|film|video|documentary|photograph|album|website|article|award|prize|certificate|book|curriculum|handbook|register|record)s?\b/gi);
        (m || []).forEach(word => {
          const key = word.toLowerCase();
          if (seen.has(key) || out.some(o => o.title.toLowerCase() === key)) return;
          out.push({ title: word.charAt(0).toUpperCase() + word.slice(1),
                     quote: String(t.text).slice(0, 140),
                     kind: /award|prize|certificate/i.test(word) ? 'award'
                         : /film|video|photograph|documentary/i.test(word) ? 'media'
                         : /website|article/i.test(word) ? 'link' : 'document' });
        });
      });
      this.suggestions = out.slice(0, 4);
    },

    /* ── the composer ───────────────────────────────────────────────────── */
    grow(){
      const el = this.$refs.say;
      if (!el) return;
      el.style.height = 'auto';
      el.style.height = Math.min(el.scrollHeight, window.innerHeight * 0.4) + 'px';
    },
    scroll(){
      const el = this.$refs.log;
      if (el) el.scrollTop = el.scrollHeight;
    },
    useHeard(){ this.say = this.heard; this.heard = null; this.$nextTick(() => this.grow()) },

    /* ── voice ──────────────────────────────────────────────────────────── */
    async record(){
      if (this.recording) { this.stopRec(); return; }
      if (!navigator.mediaDevices || !window.MediaRecorder) {
        this.err = 'This browser cannot record. You can type your answer instead.'; return;
      }
      try {
        const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
        this.chunks = [];
        this.rec = new MediaRecorder(stream);
        this.rec.ondataavailable = e => { if (e.data.size) this.chunks.push(e.data) };
        this.rec.onstop = () => { stream.getTracks().forEach(t => t.stop()); this.hear() };
        this.rec.start();
        this.recording = true;
        let s = 0;
        this.tick = setInterval(() => {
          s++;
          this.clock = Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0');
          if (s >= 180) this.stopRec();     // the same three-minute cap the form uses
        }, 1000);
      } catch (e) {
        this.err = 'The microphone is not available. You can type your answer instead.';
      }
    },
    stopRec(){
      if (this.tick) { clearInterval(this.tick); this.tick = null; }
      this.recording = false; this.clock = '0:00';
      if (this.rec && this.rec.state !== 'inactive') this.rec.stop();
    },
    async hear(){
      this.hearing = true; this.err = '';
      const fd = new FormData();
      fd.append('_token', CSRF);
      fd.append('audio', new Blob(this.chunks, { type: 'audio/webm' }), 'answer.webm');
      try {
        const r = await fetch('/my-work/' + TOKEN + '/listen', {
          method: 'POST', body: fd, headers: { 'X-CSRF-Token': CSRF } });
        const d = await r.json();
        /* Into the read-back panel, NEVER straight into the record. The nominee corrects what
           was misheard and then presses send on words they have read. */
        if (d.ok && d.text) this.heard = d.text;
        else this.err = d.message || 'We could not make that out. Try again, or type it.';
      } catch (e) {
        this.err = 'That recording did not get through. You can type your answer instead.';
      }
      this.hearing = false;
    }
  };
}
</script>
{% endblock %}
