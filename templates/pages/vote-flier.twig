{% extends 'layout/shell.twig' %}

{#
  `/vote/{programme}/{id-name}/flier` — THE NOMINEE'S SHAREABLE FLIER. Phase 5, rebuilt after
  the old page was destroyed (inventory: docs/handoff/inventory/pages--vote-flier.md).

  The image is rendered ONCE, on the server (FlierService / FlierLayout via GD) — the PNG
  shown here is byte-identical to the download and to the link preview; there is no second
  renderer in the browser to drift (StandingsAndFlierTest). Both downloads are plain links
  that work with JavaScript off. vote.js adds the one thing only a browser can do: hand the
  real FILE to the OS share sheet (on WhatsApp, attaching the image rather than pasting a
  URL), and only where `navigator.canShare({files})` says it will work.

  An AI-drafted rally line is LABELLED: a nominee is about to post it under their own name.
#}

{% set colour_tier = '1' %}
{% set app_bar = {variant: 'child', title: 'Share kit'|trans, sub: f.name, back: f.url} %}

{% block head_styles %}<link rel="stylesheet" href="{{ asset('/assets/css/components/vote-pages.css') }}">{% endblock %}

{% block content %}
<div class="fl">
  <header class="fl-head">
    <h1 class="vs-h1">{{ 'Share kit for %n%'|trans({'%n%': f.name}) }}</h1>
    <p class="vs-p">{{ 'Pick a size and a style, download, and post it where your people already are. Every nominee gets the same kit.'|trans }}</p>
  </header>
  <div class="fl-grid">
    <figure class="fl-fig">
      <img class="fl-img fl-img--{{ card.format }}" src="{{ png_url }}" width="{{ card.W }}" height="{{ card.H }}" alt="{{ 'Share card for %n% in %c%. %h%. Vote at %u%.'|trans({'%n%': f.name, '%c%': f.category, '%h%': f.headline, '%u%': f.short_url}) }}">
      <figcaption class="vs-fine">{{ '%w% × %h%'|trans({'%w%': card.W, '%h%': card.H}) }}</figcaption>
    </figure>
    <div class="fl-side">
      {# The nominee's choices. Each is a plain link to this page with one parameter
         changed, so the kit works with JavaScript off and every preview is the real PNG. #}
      <nav class="fl-pick" aria-label="{{ 'Card options'|trans }}">
        <p class="fl-pick__k" id="fl-pick-size">{{ 'Size'|trans }}</p>
        <ul class="fl-pick__sizes" aria-labelledby="fl-pick-size">
          {% for c in choices.size %}<li><a class="fl-pick__size" href="{{ c.href }}"{% if c.on %} aria-current="true"{% endif %}><span class="fl-pick__l">{{ c.label|trans }}</span><span class="fl-pick__h">{{ c.hint|trans }}</span></a></li>{% endfor %}
        </ul>
        <p class="fl-pick__k" id="fl-pick-style">{{ 'Style'|trans }}</p>
        <ul class="fl-pick__row" aria-labelledby="fl-pick-style">
          {% for c in choices.style %}<li><a class="fl-pick__chip" href="{{ c.href }}"{% if c.on %} aria-current="true"{% endif %}>{{ c.label|trans }}</a></li>{% endfor %}
        </ul>
        {# Its own row: in one row with the style, "Photo" and "Bold" read as two answers to
           one question (docs/SHARE-KIT.md names it Ground). #}
        <p class="fl-pick__k" id="fl-pick-mode">{{ 'Ground'|trans }}</p>
        <ul class="fl-pick__row" aria-labelledby="fl-pick-mode">
          {% for c in choices.mode %}<li><a class="fl-pick__chip" href="{{ c.href }}"{% if c.on %} aria-current="true"{% endif %}>{{ c.label|trans }}</a></li>{% endfor %}
        </ul>
        <p class="fl-pick__k" id="fl-pick-tone">{{ 'Colour'|trans }}</p>
        <ul class="fl-pick__row" aria-labelledby="fl-pick-tone">
          {% for c in choices.tone %}<li><a class="fl-pick__sw fl-pick__sw--{{ c.value }}" href="{{ c.href }}"{% if c.on %} aria-current="true"{% endif %}><span class="ag-sr">{{ c.label|trans }}{% if c.value == default_tone %} {{ '(your award’s colour)'|trans }}{% endif %}</span></a></li>{% endfor %}
        </ul>
        {% if card.statement %}<p class="vs-fine">{{ 'The Statement style shows the line from your nominee profile.'|trans }}</p>{% endif %}
      </nav>
      <div class="fl-stat">
        <p class="fl-stat__h">{{ f.headline }}</p>
        {% if f.standing.field >= 2 %}
          <span class="fl-bar" role="img" aria-label="{{ '%v% votes, %p% per cent of the leader’s total'|trans({'%v%': f.standing.votes, '%p%': f.standing.progress_pct}) }}"><i aria-hidden="true" style="width:{{ f.standing.progress_pct }}%"></i><span class="ag-sr">{{ '%p% per cent of the leader’s total'|trans({'%p%': f.standing.progress_pct}) }}</span></span>
        {% endif %}
        <p class="vs-p">{{ f.cta }}</p>
      </div>
      <div class="fl-copy">
        <p class="fl-copy__k">{{ 'The line on the flier'|trans }}</p>
        <p class="fl-copy__t">{{ f.rally }}</p>
        {% if f.ai %}<p class="vs-fine">{{ 'Drafted with AI from the current standing. Check it before sharing.'|trans }}</p>{% endif %}
      </div>
      <div class="fl-acts">
        <a class="ag-btn ag-btn--primary ag-btn--pill" href="{{ png_url }}" download="{{ file_name }}">{{ 'Download image (PNG)'|trans }}</a>
        <a class="ag-btn ag-btn--secondary ag-btn--pill" href="{{ svg_url }}" download>{{ 'Vector for print (SVG)'|trans }}</a>
        <button type="button" class="ag-btn ag-btn--secondary ag-btn--pill" data-fl-share hidden
                data-png="{{ png_url }}" data-file="{{ file_name }}" data-title="{{ 'Vote for %n%'|trans({'%n%': f.name}) }}" data-text="{{ f.rally ~ ' ' ~ f.url }}"
                data-busy="{{ 'Preparing…'|trans }}" data-done="{{ 'Shared.'|trans }}" data-failed="{{ 'Sharing is unavailable — use a download instead.'|trans }}">{{ 'Share…'|trans }}</button>
        <a class="ag-btn ag-btn--secondary ag-btn--pill" href="{{ f.url }}">{{ 'Back to the ballot'|trans }}</a>
      </div>
      <p class="fl-status" data-fl-status role="status" aria-live="polite"></p>
      <p class="vs-fine">{{ 'Votes are only part of the score, so a flier asks for support, not a win.'|trans }}</p>
    </div>
  </div>

  {# The rest of the kit (ShareKit): ready-made messages, the QR code for a printed poster, and
     the video. Identical for every nominee — built from their name, category, award and link
     and nothing else (D32) — because the site does not carry every nominee, so this is how
     every nominee is promoted: by the people who already know them. #}
  <section class="fl-kit" aria-labelledby="fl-kit-h">
    <h2 class="fl-kit__h" id="fl-kit-h">{{ 'Send it'|trans }}</h2>
    <div class="fl-kit__grid">
      <div class="fl-kit__msg">
        <label class="fl-copy__k" for="fl-kit-text">{{ 'Message'|trans }}</label>
        <textarea class="fl-kit__text" id="fl-kit-text" rows="4" readonly data-kit-text>{{ kit.text }}</textarea>
        <div class="fl-kit__go">
          <button type="button" class="ag-btn ag-btn--secondary ag-btn--pill" data-kit-copy data-done="{{ 'Copied'|trans }}">{{ 'Copy message'|trans }}</button>
          {% for l in kit.links %}<a class="ag-btn ag-btn--secondary ag-btn--pill" href="{{ l.href }}" target="_blank" rel="noopener noreferrer">{{ l.label }}</a>{% endfor %}
        </div>
      </div>
      {% if kit.qr %}
      <figure class="fl-kit__qr">
        <span class="fl-kit__qr-i" role="img" aria-label="{{ 'QR code for %u%'|trans({'%u%': kit.link}) }}">{{ kit.qr|raw }}</span>
        <figcaption class="vs-fine">{{ 'For posters and print. Scans to the voting page.'|trans }}</figcaption>
      </figure>
      {% endif %}
    </div>
    <a class="fl-kit__more" href="{{ video_url }}">{{ 'Make a share video'|trans }} <span class="ag-ico-dir" aria-hidden="true">→</span></a>
  </section>
</div>
{% endblock %}

{% block foot_scripts %}<script defer src="{{ asset('/assets/js/vote.js') }}" data-nav="rerun"></script>{% endblock %}
