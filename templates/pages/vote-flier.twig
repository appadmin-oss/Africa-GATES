{% extends "layout/gates.twig" %}

{# ═══════════════════════════════════════════════════════════════════════════
   The nominee's shareable flier.

   THE SVG IS THE FEATURE, not the fallback. It is embedded below as a real
   <img> pointing at …/flier.svg, so with JavaScript switched off a nominee can
   still see it, right-click-save it, share it and print it. The download
   buttons only add convenience.

   THE PNG IS DRAWN HERE, IN THE BROWSER, and that is deliberate. See
   FlierService for the full reasoning; the short version is that GD on a shared
   host frequently has no TrueType font at all, so a server-rendered PNG would
   silently degrade to a bitmap face on exactly the deployment nobody can
   inspect. The browser has something the server does not: Montserrat and
   Playfair Display, already loaded and ready. `document.fonts.ready` makes that
   deterministic.

   Converting the SVG through a canvas was considered and rejected — an
   <img>-loaded SVG cannot see the document's fonts, so it renders in a fallback
   face and comes out worse than the SVG it started from. The canvas is drawn
   from the DATA instead.
   ═══════════════════════════════════════════════════════════════════════════ #}

{% block content %}
<section class="ag-scope fl" aria-labelledby="flHeading">
  <div class="fl__wrap">

    <header class="fl__head">
      <p class="fl__kicker">Rally your community</p>
      <h1 id="flHeading" class="fl__title">A flier for {{ f.name }}</h1>
      <p class="fl__sub">Ready to post to WhatsApp, Instagram or a group chat. It carries
        {{ f.name }}'s real standing, so it gives people a reason to vote today rather than
        eventually.</p>
    </header>

    <div class="fl__grid">

      <figure class="fl__preview">
        {# Width and height are declared so the space is reserved before the image
           arrives — no layout shift on a slow connection, which is most of them. #}
        <img class="fl__img" src="{{ svg_url }}" width="{{ 1080 }}" height="{{ 1350 }}"
             alt="Flier for {{ f.name }} in {{ f.category }}. {{ f.headline }}. {{ f.rally }} Vote at {{ f.short_url }}.">
        <figcaption class="fl__cap">1080 × 1350 — the largest crop Instagram and WhatsApp both keep.</figcaption>
      </figure>

      <div class="fl__side">

        <div class="fl__stat">
          <p class="fl__stat-line">{{ f.headline }}</p>
          {% if f.standing.field >= 2 %}
            <div class="fl__bar" role="img"
                 aria-label="{{ f.standing.votes }} votes, {{ f.standing.progress_pct }} percent of the leader's total">
              <span class="fl__bar-fill" style="width:{{ f.standing.progress_pct }}%"></span>
            </div>
          {% endif %}
          <p class="fl__cta">{{ f.cta }}</p>
        </div>

        <div class="fl__copy">
          <p class="fl__copy-label" id="flCopyLabel">The line on the flier</p>
          <p class="fl__copy-text">{{ f.rally }}</p>
          {% if f.ai %}
            {# Labelled, because a nominee is about to post this under their own name
               and is entitled to know a model drafted it. #}
            <p class="fl__note">Drafted with AI from your category and current standing. Read it before you share it.</p>
          {% endif %}
        </div>

        {# Real links first. Both work with no JavaScript. #}
        <div class="fl__acts">
          <a class="fl__btn fl__btn--primary" href="{{ svg_url }}" download>Download the flier (SVG)</a>
          <button class="fl__btn" type="button" id="flPng" hidden>Download as image (PNG)</button>
          <button class="fl__btn" type="button" id="flShare" hidden>Share…</button>
          <a class="fl__btn fl__btn--ghost" href="{{ f.url }}">Back to the ballot</a>
        </div>
        <p class="fl__status" role="status" aria-live="polite" id="flStatus"></p>

        <p class="fl__fine">Public votes are one part of the score. An independent jury decides
          the award, so a flier is a call for support — not a claim to have won.</p>
      </div>

    </div>
  </div>
</section>

<style nonce="{{ csp_nonce }}">
  .fl { padding: 26px 0 70px; }
  .fl__wrap { max-width: 1120px; margin: 0 auto; padding: 0 18px; }
  .fl__kicker { font-size: .78rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase;
    color: var(--ag-accent, #1a6118); margin: 0 0 6px; }
  .fl__title { font-size: clamp(1.5rem, 4vw, 2.1rem); margin: 0 0 8px; }
  .fl__sub { color: var(--ag-text-soft, #566); margin: 0 0 24px; max-width: 62ch; }

  .fl__grid { display: grid; gap: 28px; grid-template-columns: minmax(0, 1fr); align-items: start; }
  @media (min-width: 900px) { .fl__grid { grid-template-columns: minmax(0, 420px) minmax(0, 1fr); } }

  .fl__preview { margin: 0; }
  .fl__img { display: block; width: 100%; height: auto; border-radius: 14px;
    box-shadow: 0 10px 34px rgba(8, 32, 28, .22); background: #0d2a24; }
  .fl__cap { font-size: .78rem; color: var(--ag-text-mute, #7b8a88); margin: 8px 0 0; }

  .fl__stat { border: 1px solid var(--ag-line, #dfe7e4); border-radius: 12px; padding: 14px 16px; margin: 0 0 16px; }
  .fl__stat-line { font-weight: 700; margin: 0 0 10px; }
  .fl__bar { height: 12px; border-radius: 6px; background: var(--ag-bg-soft, #eef2f1); overflow: hidden; }
  .fl__bar-fill { display: block; height: 100%; background: var(--ag-accent, #1a6118); border-radius: 6px; }
  .fl__cta { font-size: .9rem; color: var(--ag-text-soft, #566); margin: 10px 0 0; }

  .fl__copy { border-left: 3px solid var(--ag-gold, #c9a227); padding: 2px 0 2px 14px; margin: 0 0 18px; }
  .fl__copy-label { font-size: .74rem; font-weight: 700; letter-spacing: .09em; text-transform: uppercase;
    color: var(--ag-text-mute, #7b8a88); margin: 0 0 4px; }
  .fl__copy-text { font-size: 1.06rem; line-height: 1.5; margin: 0; }
  .fl__note { font-size: .78rem; color: var(--ag-text-mute, #7b8a88); margin: 8px 0 0; }

  .fl__acts { display: flex; flex-wrap: wrap; gap: 10px; }
  .fl__btn {
    /* 46px, above the WCAG 2.5.8 minimum — these are the two buttons the whole page
       exists for and they are pressed on a phone. */
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 46px; padding: 0 18px; border-radius: 10px; font-weight: 600; font-size: .95rem;
    cursor: pointer; text-decoration: none; border: 1.5px solid var(--ag-line, #d7e0de);
    background: #fff; color: inherit;
  }
  .fl__btn--primary { background: var(--ag-accent, #1a6118); border-color: var(--ag-accent, #1a6118); color: #fff; }
  .fl__btn--ghost { border-style: dashed; }
  .fl__btn:focus-visible, .fl__img:focus-visible {
    outline: 3px solid var(--ag-accent, #1a6118); outline-offset: 2px;
  }
  .fl__btn[aria-busy="true"] { opacity: .65; cursor: progress; }
  .fl__status:empty { display: none; }
  .fl__status { font-size: .86rem; font-weight: 600; margin: 12px 0 0; }
  .fl__fine { font-size: .78rem; color: var(--ag-text-mute, #7b8a88); margin: 18px 0 0; max-width: 52ch; }
</style>

<script nonce="{{ csp_nonce }}">
/* PNG rendering, drawn from the data with the page's own fonts.
   Everything here is additive — the SVG download above is a plain link. */
(function () {
  var pngBtn   = document.getElementById('flPng');
  var shareBtn = document.getElementById('flShare');
  var status   = document.getElementById('flStatus');
  if (!pngBtn || !status) return;

  var W = 1080, H = 1350;
  var F = {{ {
    name: f.name, category: f.category, programme: f.programme, country: f.country,
    photo: f.photo, rally: f.rally, headline: f.headline, url: f.url, short_url: f.short_url,
    rank: f.standing.rank, field: f.standing.field, pct: f.standing.progress_pct,
    momentum: (f.standing.momentum_available and f.standing.momentum_24h > 0) ? f.standing.momentum_24h : 0,
    filename: 'vote-' ~ f.name|lower|replace({' ': '-'})|slice(0, 48)
  }|json_encode(JSON_SAFE)|raw }};

  /* Canvas has no text wrapping, same as SVG. Measured wrapping, not character
     counting, because Playfair at 96px is nothing like Montserrat at 30px. */
  function wrap(ctx, text, maxW, maxLines) {
    var words = String(text || '').split(/\s+/), lines = [], cur = '';
    for (var i = 0; i < words.length; i++) {
      var t = cur ? cur + ' ' + words[i] : words[i];
      if (ctx.measureText(t).width <= maxW || !cur) { cur = t; continue; }
      if (lines.length + 1 >= maxLines) {
        while (cur && ctx.measureText(cur + '…').width > maxW) cur = cur.slice(0, -1);
        cur += '…'; break;
      }
      lines.push(cur); cur = words[i];
    }
    if (cur) lines.push(cur);
    return lines;
  }

  function rounded(ctx, x, y, w, h, r) {
    ctx.beginPath();
    ctx.moveTo(x + r, y);
    ctx.arcTo(x + w, y,     x + w, y + h, r);
    ctx.arcTo(x + w, y + h, x,     y + h, r);
    ctx.arcTo(x,     y + h, x,     y,     r);
    ctx.arcTo(x,     y,     x + w, y,     r);
    ctx.closePath(); ctx.fill();
  }

  function loadPhoto() {
    return new Promise(function (resolve) {
      if (!F.photo) return resolve(null);
      var img = new Image();
      /* Same-origin uploads, but crossOrigin is set so a CDN-hosted photo with
         permissive CORS does not TAINT the canvas — a tainted canvas makes
         toBlob() throw and the whole download fails rather than degrading. */
      img.crossOrigin = 'anonymous';
      img.onload  = function () { resolve(img); };
      img.onerror = function () { resolve(null); };   // fall back to the monogram
      img.src = F.photo;
    });
  }

  function draw(ctx, photo) {
    var PH = 820;

    var g = ctx.createLinearGradient(0, 0, 0, H);
    g.addColorStop(0, '#123b2f'); g.addColorStop(0.55, '#0d2a24'); g.addColorStop(1, '#08201c');
    ctx.fillStyle = g; ctx.fillRect(0, 0, W, H);

    if (photo) {
      /* Cover, not stretch. A squashed face is the single most obvious tell that a
         graphic was generated. */
      var s = Math.max(W / photo.width, PH / photo.height);
      var dw = photo.width * s, dh = photo.height * s;
      ctx.save(); ctx.beginPath(); ctx.rect(0, 0, W, PH); ctx.clip();
      ctx.drawImage(photo, (W - dw) / 2, (PH - dh) / 2, dw, dh);
      ctx.restore();
    } else {
      ctx.fillStyle = '#0f3329'; ctx.fillRect(0, 0, W, PH);
      /* LETTERS only, and matched to FlierService::initials() — the SVG and the PNG
         are two renderings of one design, so a rule fixed in one and not the other
         means the graphic a nominee downloads differs from the one they previewed.
         "Nominee 48 Surname" produced "N4" here after the SVG side was corrected. */
      var ini = String(F.name || '').trim().split(/\s+/)
        .map(function (w) { return w.charAt(0); })
        .filter(function (c) { return /\p{L}/u.test(c); })
        .join('').slice(0, 2).toUpperCase() || '?';
      ctx.font = '700 260px "Playfair Display", Georgia, serif';
      ctx.fillStyle = 'rgba(127,200,124,0.28)'; ctx.textAlign = 'center';
      ctx.fillText(ini, W / 2, 500); ctx.textAlign = 'left';
    }

    var scrim = ctx.createLinearGradient(0, 0, 0, PH);
    scrim.addColorStop(0, 'rgba(8,32,28,0)');
    scrim.addColorStop(0.62, 'rgba(8,32,28,0.55)');
    scrim.addColorStop(1, 'rgba(8,32,28,0.97)');
    ctx.fillStyle = scrim; ctx.fillRect(0, 0, W, PH);

    ctx.fillStyle = '#c9a227'; ctx.fillRect(64, 64, 6, 52);
    ctx.font = '700 26px Montserrat, system-ui, sans-serif'; ctx.fillStyle = '#f3f7f4';
    ctx.fillText('VOTE NOW', 88, 92);
    ctx.font = '22px Montserrat, system-ui, sans-serif'; ctx.fillStyle = '#a9c7bd';
    ctx.fillText(F.programme, 88, 126);

    if (F.field >= 2) {
      var chip = '#' + F.rank + ' of ' + F.field;
      ctx.font = '700 28px Montserrat, system-ui, sans-serif';
      var cw = ctx.measureText(chip).width + 44;
      ctx.fillStyle = '#c9a227'; rounded(ctx, W - 64 - cw, 62, cw, 58, 29);
      ctx.fillStyle = '#1a1204'; ctx.textAlign = 'center';
      ctx.fillText(chip, W - 64 - cw / 2, 100); ctx.textAlign = 'left';
    }

    var len = String(F.name).length;
    var size = len <= 14 ? 96 : (len <= 22 ? 78 : (len <= 32 ? 62 : 50));
    ctx.font = '700 ' + size + 'px "Playfair Display", Georgia, serif';
    var nameLines = wrap(ctx, F.name, W - 128, 2);
    var y = 700 - (nameLines.length - 1) * (size + 8);
    ctx.fillStyle = '#ffffff';
    nameLines.forEach(function (l) { ctx.fillText(l, 64, y); y += size + 8; });

    ctx.font = '30px Montserrat, system-ui, sans-serif'; ctx.fillStyle = '#7fc87c';
    ctx.fillText(F.category + (F.country ? '  ·  ' + F.country : ''), 64, y + 14);

    var py = 880;
    if (F.field >= 2) {
      ctx.font = '600 30px Montserrat, system-ui, sans-serif'; ctx.fillStyle = '#e8f2ec';
      ctx.fillText(F.headline, 64, py);
      ctx.fillStyle = 'rgba(255,255,255,0.14)'; rounded(ctx, 64, py + 24, W - 128, 14, 7);
      ctx.fillStyle = '#7fc87c'; rounded(ctx, 64, py + 24, Math.max(14, (W - 128) * F.pct / 100), 14, 7);
      py += 74;
    }
    if (F.momentum > 0) {
      ctx.font = '26px Montserrat, system-ui, sans-serif'; ctx.fillStyle = '#c9a227';
      ctx.fillText(F.momentum + ' vote' + (F.momentum === 1 ? '' : 's') + ' in the last 24 hours', 64, py);
      py += 48;
    }

    py = Math.max(py, 1010);
    ctx.font = '34px Montserrat, system-ui, sans-serif'; ctx.fillStyle = 'rgba(255,255,255,0.94)';
    wrap(ctx, F.rally, W - 128, 3).forEach(function (l) { ctx.fillText(l, 64, py); py += 46; });

    ctx.fillStyle = '#ffffff'; rounded(ctx, 64, H - 150, W - 128, 86, 43);
    ctx.font = '700 30px Montserrat, system-ui, sans-serif'; ctx.fillStyle = '#0d2a24';
    ctx.textAlign = 'center'; ctx.fillText(F.short_url, W / 2, H - 96);

    ctx.font = '20px Montserrat, system-ui, sans-serif'; ctx.fillStyle = '#7fa295';
    ctx.fillText('Public votes are one part of the score. An independent jury decides the award.', W / 2, H - 28);
    ctx.textAlign = 'left';
  }

  var cached = null;
  function render() {
    if (cached) return Promise.resolve(cached);
    var c = document.createElement('canvas');
    c.width = W; c.height = H;
    var ctx = c.getContext('2d');
    /* Fonts BEFORE drawing. Without this the first render lands in a fallback face
       on a cold cache — the exact case a nominee hits, since they arrive on this
       page once. */
    var ready = (document.fonts && document.fonts.ready) ? document.fonts.ready : Promise.resolve();
    return ready.then(loadPhoto).then(function (photo) {
      draw(ctx, photo);
      return new Promise(function (resolve, reject) {
        c.toBlob(function (blob) { blob ? resolve(cached = blob) : reject(new Error('no blob')); }, 'image/png');
      });
    });
  }

  /* Only revealed once we know the browser can do it. A button that fails is worse
     than a button that was never offered — the SVG link above always works. */
  var canvasOk = (function () {
    try { var c = document.createElement('canvas'); return !!(c.getContext && c.getContext('2d') && c.toBlob); }
    catch (e) { return false; }
  })();
  if (canvasOk) pngBtn.hidden = false;

  function busy(btn, on, msg) {
    btn.setAttribute('aria-busy', on ? 'true' : 'false');
    btn.disabled = !!on;
    status.textContent = msg || '';
  }

  pngBtn.addEventListener('click', function () {
    busy(pngBtn, true, 'Rendering the image…');
    render().then(function (blob) {
      var url = URL.createObjectURL(blob);
      var a = document.createElement('a');
      a.href = url; a.download = F.filename + '.png';
      document.body.appendChild(a); a.click(); a.remove();
      setTimeout(function () { URL.revokeObjectURL(url); }, 4000);
      busy(pngBtn, false, 'Saved. Post it with the link — ' + F.short_url);
    }).catch(function () {
      busy(pngBtn, false, 'Could not build the image here. Use “Download the flier (SVG)” — it works everywhere.');
    });
  });

  /* Native share, where it exists AND accepts files. Both checks are needed: iOS
     Safari has navigator.share without canShare, and Android Chrome has canShare
     but refuses some types. On WhatsApp this is the difference between attaching
     the image and pasting a URL. */
  var canShareFiles = !!(navigator.canShare && navigator.share && window.File);
  if (canShareFiles && shareBtn) {
    shareBtn.hidden = false;
    shareBtn.addEventListener('click', function () {
      busy(shareBtn, true, 'Preparing…');
      render().then(function (blob) {
        var file = new File([blob], F.filename + '.png', { type: 'image/png' });
        if (!navigator.canShare({ files: [file] })) throw new Error('files unsupported');
        return navigator.share({
          files: [file],
          title: 'Vote for ' + F.name,
          text: F.rally + ' ' + F.url
        });
      }).then(function () {
        busy(shareBtn, false, 'Shared.');
      }).catch(function (e) {
        /* A user dismissing the share sheet is an AbortError, not a failure — saying
           "could not share" when they simply changed their mind is a lie. */
        busy(shareBtn, false, (e && e.name === 'AbortError') ? '' : 'Sharing is unavailable — download instead.');
      });
    });
  }
})();
</script>
{% endblock %}
