{% extends "layout/gates.twig" %}

{#
  ── THIS PAGE IS A MEASUREMENT, NOT A REASSURANCE ─────────────────────────────

  The version this replaced hard-coded its OWN fallback component list in Twig
  defaults, so even when the route passed nothing the page still printed six
  green rows. Two independent places were therefore asserting health that
  neither of them had checked.

  There are no defaults here on purpose. If the route stops passing a report the
  page says so instead of inventing one.

  Colour is never the only carrier of state: every row prints the state in
  words, and the mark beside it differs in FILL as well as hue so it survives
  monochrome, colour-blindness and a bad phone screen in daylight.
#}

{% set report_ok = components is defined and components is not empty %}

{% block head_styles %}
<style nonce="{{ csp_nonce }}">
  body[data-page="status"]{ background:#f0f2f2; }

  .stx{ max-width:820px; margin:0 auto; padding:clamp(2rem,5vw,3.25rem) var(--ag-gutter,32px) clamp(3rem,6vw,4rem); }

  .stx-kick{ font-family:var(--ag-font-mono); font-size:var(--ag-fs-label); letter-spacing:var(--ag-tracking-label);
    text-transform:uppercase; color:var(--ag-ink-soft); margin:0 0 14px; }

  .stx-verdict{ font-family:var(--ag-font-display); font-weight:700; letter-spacing:-.015em;
    font-size:clamp(1.9rem,4.6vw,2.9rem); line-height:1.1; margin:0; color:var(--ag-ink); }
  .stx-verdict em{ font-style:normal; box-shadow:inset 0 -.34em 0 rgba(243,180,22,.34); }

  .stx-note{ margin:16px 0 0; font-size:1.0125rem; line-height:1.6; color:#3c4649; max-width:56ch; }

  .stx-stamp{ margin:22px 0 0; padding-top:16px; border-top:1px solid rgba(16,41,44,.12);
    font-family:var(--ag-font-mono); font-size:12px; color:var(--ag-ink-soft);
    display:flex; flex-wrap:wrap; gap:6px 18px; }

  .stx-h2{ margin:44px 0 0; padding-bottom:12px; border-bottom:1px solid rgba(16,41,44,.16);
    font-family:var(--ag-font-mono); font-size:var(--ag-fs-label); letter-spacing:var(--ag-tracking-label);
    text-transform:uppercase; color:var(--ag-ink); }

  .stx-rows{ list-style:none; margin:0; padding:0; }
  .stx-row{ display:flex; align-items:flex-start; gap:16px; padding:18px 2px;
    border-bottom:1px solid rgba(16,41,44,.09); }

  /* The mark differs in FILL, not only in colour, so the four states stay
     distinguishable with no colour perception at all. */
  .stx-mark{ flex:none; width:13px; height:13px; margin-top:4px; border-radius:3px;
    border:1.5px solid var(--ag-ink-soft); background:transparent; }
  .stx-mark--operational{ background:#237b22; border-color:#237b22; }
  .stx-mark--degraded{ border-color:#a4761a; background:linear-gradient(180deg,#f3b416 0 50%,transparent 50% 100%); }
  .stx-mark--down{ border-color:#a32b1c; background:repeating-linear-gradient(45deg,#a32b1c 0 2px,transparent 2px 4px); }
  .stx-mark--unknown{ border-style:dashed; border-color:#8a9294; }

  .stx-row__main{ flex:1; min-width:0; }
  .stx-row__name{ font-weight:600; font-size:1.0125rem; color:var(--ag-ink); }
  .stx-row__what{ margin-top:3px; font-size:.875rem; color:var(--ag-ink-soft); }
  .stx-row__detail{ margin:9px 0 0; font-size:.9125rem; line-height:1.55; color:#3c4649; max-width:54ch; }

  .stx-row__state{ flex:none; text-align:right; min-width:8.5rem; }
  .stx-state{ font-size:.9125rem; font-weight:600; color:#1a6118; }
  .stx-state--degraded{ color:#7a5600; }
  .stx-state--down{ color:#a32b1c; }
  .stx-state--unknown{ color:#5f676a; }
  .stx-metric{ margin-top:4px; font-family:var(--ag-font-mono); font-size:11.5px; color:var(--ag-ink-soft); }

  /* ── THE HISTORY STRIP ────────────────────────────────────────────────────
     One square per day, worst-state-wins. Worst wins because a day with one broken hour is
     not a good day, and an average would turn a real outage into a pale shade of green.

     A day with no recorded snapshot is DASHED, not blank and not green: on this deployment
     that usually means the scheduled task was not running, which is itself the outage. */
  .stx-days{ display:flex; gap:5px; margin:16px 0 0; flex-wrap:wrap }
  .stx-day{ flex:1 1 14px; min-width:14px; height:34px; border-radius:3px;
    border:1.5px solid var(--ag-ink-soft,#8a9294); background:transparent }
  .stx-day--operational{ background:#237b22; border-color:#237b22 }
  .stx-day--degraded{ border-color:#a4761a; background:linear-gradient(180deg,#f3b416 0 50%,transparent 50% 100%) }
  .stx-day--down{ border-color:#a32b1c; background:repeating-linear-gradient(45deg,#a32b1c 0 2px,transparent 2px 4px) }
  .stx-day--unknown{ border-style:dashed; border-color:#b3b9ba }
  .stx-daysfoot{ display:flex; justify-content:space-between; gap:12px; margin-top:8px;
    font-family:var(--ag-font-mono); font-size:11px; color:var(--ag-ink-soft) }
  .stx-daysnote{ margin:12px 0 0; font-size:.9125rem; line-height:1.6; color:#3c4649; max-width:58ch }

  .stx-scope{ margin:34px 0 0; padding:20px 22px; background:#fff;
    border:1px solid rgba(16,41,44,.1); border-radius:var(--ag-r-sm,10px); }
  .stx-scope p{ margin:0; font-size:.9125rem; line-height:1.65; color:#3c4649; }
  .stx-scope p + p{ margin-top:11px; }
  .stx-scope strong{ font-weight:600; color:var(--ag-ink); }

  .stx-broken{ margin:24px 0 0; padding:20px 22px; border:1px solid rgba(163,43,28,.28);
    border-radius:var(--ag-r-sm,10px); background:#fff; font-size:.9375rem; line-height:1.6; color:#3c4649; }

  @media (max-width:560px){
    .stx-row{ flex-wrap:wrap; }
    .stx-row__state{ width:100%; text-align:left; padding-left:29px; min-width:0; }
    .stx-metric{ display:inline; margin-left:10px; }
  }
</style>
{% endblock %}

{% block content %}
<div class="stx">

  <p class="stx-kick">Live check</p>

  {% if not report_ok %}
    {# No report reached the page. Saying nothing is the honest output; the old
       template printed six green rows in exactly this situation. #}
    <h1 class="stx-verdict">We could not check just now</h1>
    <p class="stx-note">This page reads the platform directly every time you load it, and that read did not come back. Reload in a moment. If the rest of the site is working for you, it is working.</p>
  {% else %}

    {% set v = overall|default('unknown') %}
    {% set headline = v == 'operational' ? 'Everything we can check is <em>working</em>'
                    : (v == 'degraded'  ? 'Some things are <em>slower than usual</em>'
                    : (v == 'down'      ? 'Something is <em>not working</em>'
                    :                     'Some things are <em>not checked</em>')) %}

    <h1 class="stx-verdict">{{ headline|raw }}</h1>
    {% if note is defined and note %}<p class="stx-note">{{ note }}</p>{% endif %}

    <div class="stx-stamp">
      <span>Checked {{ checked_at }}</span>
      <span>Measured on load, not cached</span>
      <span>Reload to check again</span>
    </div>

    <h2 class="stx-h2">What we checked</h2>
    <ul class="stx-rows">
      {% for c in components %}
        {% set s = c.status|default('unknown') %}
        <li class="stx-row">
          <span class="stx-mark stx-mark--{{ s }}" aria-hidden="true"></span>
          <div class="stx-row__main">
            <div class="stx-row__name">{{ c.name }}</div>
            <div class="stx-row__what">{{ c.what }}</div>
            {% if c.detail %}<p class="stx-row__detail">{{ c.detail }}</p>{% endif %}
          </div>
          <div class="stx-row__state">
            <div class="stx-state stx-state--{{ s }}">{{ c.label }}</div>
            {% if c.metric %}<div class="stx-metric">{{ c.metric }}</div>{% endif %}
          </div>
        </li>
      {% endfor %}
    </ul>

  {% endif %}

  {# ── WAS IT BROKEN EARLIER? ────────────────────────────────────────────────
     The live check is honest and blind: it says what is true this second and nothing about
     the two hours somebody could not check out. Without this, a supporter whose payment
     failed at nine and who loads a green page at noon concludes the fault was theirs.

     Only rendered when there is a record. An empty strip of fourteen grey squares on a fresh
     installation says "we have been broken for a fortnight", which is the opposite of true. #}
  {% if history is defined and history is not empty %}
    <h2 class="stx-h2">The last {{ history_days|default(14) }} days</h2>

    <div class="stx-days" role="img"
         aria-label="{{ history_note }}">
      {% for d in history %}
        <span class="stx-day stx-day--{{ d.status }}"
              title="{{ d.label }} — {{ d.state_label }}"></span>
      {% endfor %}
    </div>
    <div class="stx-daysfoot">
      <span>{{ history|first.label }}</span>
      <span>Today</span>
    </div>
    {% if history_note %}<p class="stx-daysnote">{{ history_note }}</p>{% endif %}
  {% endif %}

  <h2 class="stx-h2">What this page can and cannot tell you</h2>
  <div class="stx-scope">
    <p>Every line above is measured when you load the page — a real query, a real count, a real recent success rate. Nothing here is a setting somebody typed in, and nothing says <strong>Working</strong> because a key exists somewhere in a configuration file.</p>
    <p><strong>Not checked</strong> means exactly that. It is not a quiet way of saying fine, and we would rather show it than round it up.</p>
    <p>This page reports the platform. It cannot see your network, your inbox provider or your bank — so if everything here reads as working and something is still wrong for you, that is worth telling us, not shrugging off.</p>
  </div>

  {# This page answers "is it me or is it them". It does not answer "so where is
     my money", and that is what most people came to ask — a green board and a
     missing payment is the most frustrating combination on the site. The
     assistant can check the same services by PROBING them, not by reading a
     configuration flag, and can repair the payment while it is there. #}
  {% include 'partials/support-prompt.twig' with {
    sp_kind: 'general',
    sp_title: 'Reads as working but something is still wrong?',
    sp_body: 'This board reports the platform. The assistant can check your specific problem — and re-check a payment against the gateway if that is what is stuck.'
  } %}
</div>
{% endblock %}
