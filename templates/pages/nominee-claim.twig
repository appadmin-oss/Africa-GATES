{% extends "layout/gates.twig" %}

{#
  The claim page. docs/CLAIM-FAIRNESS-AND-FRAUD.md §2 and §7.

  THE WORDING IS PART OF THE DESIGN, not decoration on top of it. §7.2 requires that a
  held claim reads as "we need one more thing", never as a refusal — so there is no
  "denied" state in this template at all, and the held panel is styled as information
  rather than as an error. §7.1 requires that nothing here can be paid for, and §7.5
  requires plain, translatable language, which is why every sentence is short and none of
  them contains a term of art.

  A channel that is not independent is still OFFERED, and labelled before it is chosen.
  Hiding it would leave Baba Sule — whose customer filled the form in with her own
  address — with no way through at all, and springing the hold on him afterwards would be
  worse than telling him now.
#}

{% block head_styles %}
<style nonce="{{ csp_nonce }}">
  body[data-page="awards"]{ background:#eef0ec; color:var(--ag-ink); }
  [x-cloak]{ display:none !important; }
  .cl{ max-width:640px; margin:0 auto; padding:34px var(--ag-gutter,24px) 72px; }
  .cl-crumb{ font-size:12.5px; color:#5a6d6f; margin-bottom:16px; }
  .cl-crumb a{ color:#5a6d6f; text-decoration:none; }
  .cl-crumb a:hover{ color:var(--ag-ink); }
  .cl-card{ background:#fff; border:1px solid rgba(16,41,44,.08); border-radius:22px; padding:clamp(22px,4vw,34px); box-shadow:0 18px 46px -30px rgba(16,41,44,.5); }
  .cl-eyebrow{ font-size:10.5px; font-weight:700; letter-spacing:.15em; text-transform:uppercase; color:#8b9a9b; }
  .cl-h1{ font-family:var(--ag-font-display,'Playfair Display',Georgia,serif); font-weight:700; font-size:clamp(1.5rem,4.4vw,2rem); line-height:1.18; margin:9px 0 0; letter-spacing:-.015em; }
  .cl-lead{ margin:12px 0 0; font-size:15px; line-height:1.65; color:#4a5256; }
  .cl-note{ margin:14px 0 0; font-size:13px; line-height:1.6; color:#6a767a; }
  .cl-hr{ height:1px; background:rgba(16,41,44,.08); margin:24px 0; border:0; }

  .cl-opt{ display:flex; align-items:flex-start; gap:13px; width:100%; text-align:left; padding:15px 16px; border:1.5px solid rgba(16,41,44,.12); border-radius:15px; background:#fbfcfb; cursor:pointer; font:inherit; color:inherit; transition:border-color .14s, background .14s; }
  .cl-opt + .cl-opt{ margin-top:11px; }
  .cl-opt:hover{ border-color:rgba(35,123,34,.45); background:#f6faf6; }
  .cl-opt[aria-pressed="true"]{ border-color:#237b22; background:#f1f8f1; }
  .cl-opt__ico{ flex:0 0 auto; width:36px; height:36px; border-radius:11px; background:rgba(35,123,34,.1); display:grid; place-items:center; color:#237b22; }
  .cl-opt__to{ font-family:var(--ag-font-mono,ui-monospace,monospace); font-size:14.5px; font-weight:600; color:var(--ag-ink); word-break:break-all; }
  .cl-opt__why{ margin:4px 0 0; font-size:12.5px; line-height:1.55; color:#6a767a; }
  .cl-flag{ display:inline-block; margin-top:6px; font-size:11.5px; font-weight:600; padding:4px 10px; border-radius:999px; background:#fff6e2; color:#8a6005; }

  .cl-go{ display:block; width:100%; margin-top:20px; padding:15px 20px; border:0; border-radius:999px; background:var(--ag-ink,#10292C); color:#fff; font-weight:600; font-size:15.5px; cursor:pointer; }
  .cl-go:disabled{ opacity:.45; cursor:not-allowed; }
  .cl-ghost{ display:block; width:100%; margin-top:11px; padding:12px; border:0; background:none; color:#237b22; font:inherit; font-size:13.5px; font-weight:500; cursor:pointer; }

  .cl-otp{ width:100%; margin-top:18px; padding:16px; border:1.5px solid rgba(16,41,44,.16); border-radius:14px; background:#fbfcfb; font-family:var(--ag-font-mono,ui-monospace,monospace); font-size:26px; font-weight:700; letter-spacing:.3em; text-align:center; color:var(--ag-ink); }
  .cl-otp:focus{ outline:none; border-color:#237b22; }

  .cl-msg{ margin-top:16px; padding:14px 16px; border-radius:13px; font-size:14px; line-height:1.6; }
  /* Information, deliberately NOT an error colour. A hold is not a refusal (§7.2). */
  .cl-msg--hold{ background:#fff8e6; border-left:4px solid #d49a0e; color:#7a5605; }
  .cl-msg--ok{ background:#eef8ee; border-left:4px solid #237b22; color:#155a13; }
  .cl-msg--try{ background:#f4f6f6; border-left:4px solid #8b9a9b; color:#44514f; }
  .cl-ref{ font-family:var(--ag-font-mono,ui-monospace,monospace); font-weight:700; }
  .cl-free{ margin-top:22px; display:flex; align-items:center; gap:9px; font-size:12.5px; color:#5a6d6f; }
</style>
{% endblock %}

{% block content %}
<div class="cl">
  <div class="cl-crumb"><a href="/vote">Awards</a> · Claim a page</div>

  {% if nominee is null %}
    <div class="cl-card">
      <div class="cl-eyebrow">Not found</div>
      <h1 class="cl-h1">We could not find that page</h1>
      <p class="cl-lead">The link may be out of date, or the nominee may not be on a published
        shortlist yet. If you were told this is your page, write to
        <a href="mailto:{{ support_email }}">{{ support_email }}</a> and a person will help.
        There is nothing to pay.</p>
    </div>

  {% elseif already %}
    <div class="cl-card">
      <div class="cl-eyebrow">Already claimed</div>
      <h1 class="cl-h1">This page has been claimed</h1>
      <p class="cl-lead">Somebody has already confirmed a code for
        <strong>{{ nominee.name }}</strong>.</p>
      <p class="cl-lead">If that was not you and this is your page, write to
        <a href="mailto:{{ support_email }}">{{ support_email }}</a> quoting
        <span class="cl-ref">{{ already }}</span>. A person will look into it, and a claim can
        be undone. There is nothing to pay.</p>
    </div>

  {% elseif channels is empty %}
    <div class="cl-card">
      <div class="cl-eyebrow">Claim this page</div>
      <h1 class="cl-h1">We need to do this one with a person</h1>
      <p class="cl-lead">We do not hold a contact for <strong>{{ nominee.name }}</strong> that we
        can send a code to right now. That is our side of it, not yours.</p>
      <p class="cl-lead">Write to <a href="mailto:{{ support_email }}">{{ support_email }}</a> and
        say which page you are claiming. We can confirm it another way — the person who
        nominated you, the organisation on the nomination, or a short phone call. There is
        nothing to pay, and you do not need any document.</p>
    </div>

  {% else %}
    <div class="cl-card" x-data="claimFlow()">
      {# ── step 1: pick a channel ─────────────────────────────────────────── #}
      <div x-show="step === 'pick'">
        <div class="cl-eyebrow">Claim this page</div>
        <h1 class="cl-h1">Is this you, {{ nominee.name }}?</h1>
        <p class="cl-lead">We will send a 6-digit code to one of the contacts on your nomination.
          We only show part of each, because this page is public.</p>

        <hr class="cl-hr">

        {% for c in channels %}
          <button type="button" class="cl-opt" :aria-pressed="channel === '{{ c.key }}'"
                  @click="channel = '{{ c.key }}'">
            <span class="cl-opt__ico">
              {% if c.channel == 'email' %}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
              {% else %}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h4l2 5-3 2a12 12 0 0 0 5 5l2-3 5 2v4a1 1 0 0 1-1 1A16 16 0 0 1 4 5a1 1 0 0 1 1-1Z"/></svg>
              {% endif %}
            </span>
            <span style="min-width:0">
              <span class="cl-opt__to">{{ c.hint }}</span>
              {% if c.independent %}
                <p class="cl-opt__why">{{ c.channel == 'email' ? 'An email address' : 'A phone number' }} on your nomination.</p>
              {% else %}
                {# Said BEFORE the wait, not sprung afterwards. §2. #}
                <p class="cl-opt__why">This is also the contact the person who nominated you gave
                  for themselves — usually because they filled the form in for you.</p>
                <span class="cl-flag">A person will confirm this one with you</span>
              {% endif %}
            </span>
          </button>
        {% endfor %}

        <button type="button" class="cl-go" :disabled="busy || !channel" @click="sendCode()"
                x-text="busy ? 'Sending…' : 'Send me a code'"></button>

        <p class="cl-msg cl-msg--try" x-show="error" x-cloak x-text="error"></p>

        <div class="cl-free">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#237b22" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
          Claiming is free. We will never ask you to pay to prove who you are.
        </div>
      </div>

      {# ── step 2: enter the code ──────────────────────────────────────────── #}
      <div x-show="step === 'code'" x-cloak>
        <div class="cl-eyebrow">Step 2 of 2</div>
        <h1 class="cl-h1">Enter your code</h1>
        <p class="cl-lead">We sent a 6-digit code to <strong x-text="hint"></strong>.
          It expires in 10 minutes.</p>

        <p class="cl-msg cl-msg--hold" x-show="willHold" x-cloak>
          Once you confirm this code, a person on our team will check one more thing with you —
          because this contact is the same one the person who nominated you gave for themselves.
          That usually just means they filled the form in for you. There is nothing to pay.
        </p>

        <input class="cl-otp" x-model="code" inputmode="numeric" maxlength="6" placeholder="······"
               aria-label="6-digit code" @keyup.enter="confirmCode()">

        <button type="button" class="cl-go" :disabled="busy || code.length !== 6"
                @click="confirmCode()" x-text="busy ? 'Checking…' : 'Confirm'"></button>
        <button type="button" class="cl-ghost" @click="step = 'pick'; error = ''">
          Use a different contact
        </button>

        <p class="cl-msg cl-msg--try" x-show="error" x-cloak x-text="error"></p>
      </div>

      {# ── step 3a: it is yours ────────────────────────────────────────────── #}
      <div x-show="step === 'active'" x-cloak>
        <div class="cl-eyebrow">Claimed</div>
        <h1 class="cl-h1">This page is yours ✓</h1>
        <p class="cl-lead" x-text="message"></p>
        <p class="cl-note">Your claim reference is <span class="cl-ref" x-text="reference"></span>.
          Keep it — quote it if you ever need to talk to us about this page.</p>
        <a class="cl-go" style="text-align:center;text-decoration:none"
           href="/vote/{{ nominee.id }}">See the page</a>
      </div>

      {# ── step 3b: held. NOT a refusal (§7.2). ────────────────────────────── #}
      <div x-show="step === 'held'" x-cloak>
        <div class="cl-eyebrow">One more thing</div>
        <h1 class="cl-h1">Nearly there</h1>
        <p class="cl-msg cl-msg--hold" x-text="message"></p>
        <p class="cl-lead">Any one of these finishes it, and you only need one:</p>
        <ul class="cl-lead" style="padding-left:20px">
          <li>the person who nominated you confirms it from their own address;</li>
          <li>the school, church, troupe or business on your nomination vouches for you;</li>
          <li>a social account of yours posts a code we give you;</li>
          <li>a short video or phone call, on the number we already have.</li>
        </ul>
        <p class="cl-note">We have opened a conversation about it — reference
          <span class="cl-ref" x-text="reference"></span><span x-show="ticket" x-cloak>, ticket
          <span class="cl-ref" x-text="ticket"></span></span>. You do not need an account to
          reply, and there is nothing to pay. If you would rather write to us directly,
          use <a href="mailto:{{ support_email }}">{{ support_email }}</a>.</p>
      </div>
    </div>
  {% endif %}
</div>
{% endblock %}

{% block foot_scripts %}
{% if nominee and not already and channels is not empty %}
<script nonce="{{ csp_nonce }}">
function claimFlow() {
  return {
    nomineeId: {{ nominee.id|e('js') }},
    step: 'pick', channel: '', code: '', hint: '', busy: false,
    error: '', message: '', reference: '', ticket: '', claimId: 0, willHold: false,

    csrf() {
      return (document.querySelector('meta[name="csrf-token"]') || {}).content || '';
    },

    post(url, data) {
      return fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-CSRF-Token': this.csrf() },
        body: new URLSearchParams(data),
      }).then(function (r) { return r.json(); });
    },

    sendCode() {
      if (this.busy || !this.channel) return;
      this.busy = true; this.error = '';
      var self = this;
      this.post('/claim/' + this.nomineeId + '/code', { channel: this.channel })
        .then(function (d) {
          self.busy = false;
          if (!d.ok) { self.error = d.message || 'We could not send a code just now.'; return; }
          self.claimId  = d.claim_id;
          self.hint     = d.hint || '';
          self.willHold = !!d.will_hold;
          self.code     = '';
          self.step     = 'code';
        })
        .catch(function () { self.busy = false; self.error = 'Network problem. Please try again.'; });
    },

    confirmCode() {
      if (this.busy || this.code.length !== 6) return;
      this.busy = true; this.error = '';
      var self = this;
      this.post('/claim/' + this.nomineeId + '/confirm', { claim_id: this.claimId, code: this.code })
        .then(function (d) {
          self.busy = false;
          // A wrong code is the only thing that keeps you on this step. Both real
          // outcomes — active and held — move forward, because both are answers.
          if (!d.ok) { self.error = d.message || 'That did not work. Please try again.'; return; }
          self.message   = d.message || '';
          self.reference = d.reference || '';
          self.ticket    = d.ticket || '';
          self.step      = d.status === 'active' ? 'active' : 'held';
        })
        .catch(function () { self.busy = false; self.error = 'Network problem. Please try again.'; });
    },
  };
}
</script>
{% endif %}
{% endblock %}
