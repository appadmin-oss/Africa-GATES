{% extends "layout/gates.twig" %}

{#
  ══ /awards/{slug} — BUILT FROM `AwardsPage.dc.html` (view: detail) ══════════════

  ── HOW THIS PAGE IS PUT TOGETHER ───────────────────────────────────────────────

    partials/ui.twig     subnav · facts · pill · row · empty
    components.css       what those look like everywhere
    components/awards.css  the hero, the edition card and the category race — the
                         three things only an award page has

  ── EVERY FACT IS WORKED OUT, NOT WRITTEN ───────────────────────────────────────

  The phase, its dates, the one action a reader can take and the scoring split come
  from `AwardOverview`, which reads `CyclePolicy` and `RuleEngine`. A percentage typed
  here would be the 157-points-out settings screen again.

  ── DEPARTURES FROM THE COMP, EACH DELIBERATE ───────────────────────────────────

  1. Sponsors are NAMES in the comp's cards, not logos. A logo wall hands the visual
     weight to whoever sent the biggest file, and the line under the list — sponsors
     fund the award and do not judge it — is this platform's actual guarantee, kept
     where somebody is looking at the thing that raises the question.
  2. The edition is text, not a select. The comp draws a picker; switching edition needs
     each past edition's standing, which this page does not hold. A select that changes
     nothing is worse than a label.
  3. No "Judges · names published" fact. The comp asserts it; nothing here can state
     that truthfully for every programme, so it is not printed.
  4. No "Become a sponsor" link: there is no page for it to go to.
  5. No stock photo. The old page hotlinked one for every award; with no cover the hero
     is text alone.
#}

{% block head_styles %}
<link rel="stylesheet" href="{{ asset('/assets/css/components/awards.css') }}">
{% endblock %}

{% block content %}
{% import "partials/ui.twig" as ui %}
{% set a = programme %}
{% set phase = a.phase|default(null) %}

{# The promo band (§4), scoped to this programme by the controller. #}
{% include "partials/promo-carousel.twig" with { promos: promos|default([]) } only %}

<div class="aw-page"><div class="aw">
  <a class="aw-back" href="/awards">← All awards</a>

  {# ══ HERO ═══════════════════════════════════════════════════════════════════ #}
  <header class="aw-hero{{ a.cover ? ' aw-hero--art' : '' }}">
    <div class="aw-hero__b">
      {# WHO RUNS IT, beside its mark — the October handoff's "Hosted by", on every view
         of the page. Its own line and never a row in the sponsor list: the guarantee
         under that list is a promise about the people in it, and a host does run the
         award. No `sponsored` on the link, because nobody paid for it; `nofollow`, as
         for any outbound link this site has not vouched for. The logo is `alt=""` —
         the sentence beside it names the host. #}
      {% if host %}
      <p class="aw-hero__k">
        {% if host.logo %}<img src="{{ host.logo }}" alt="" height="28" decoding="async">{% endif %}
        <span>Hosted by {% if host.url %}<a href="{{ host.url }}" target="_blank" rel="noopener noreferrer nofollow">{{ host.name }}</a>{% else %}<b>{{ host.name }}</b>{% endif %}</span>
      </p>
      {% endif %}
      <h1 class="aw-hero__h">{{ a.title }}</h1>
      {% if a.subtitle or a.description %}<p class="aw-hero__p">{{ a.subtitle ?: a.description }}</p>{% endif %}
    </div>
    {% if a.cover %}
      <img class="aw-hero__art" src="{{ a.cover }}" alt="" width="520" height="390"
           fetchpriority="high" decoding="async">
    {% endif %}
  </header>

  {# Which challenge this award counts inside — the prompt's "every scoped award page
     gets a compact one-line strip". Above the views, so it is on every one of them. #}
  {% include 'partials/challenge-strip.twig' with { strip: challenge_strip } only %}

  {% set nav = [] %}
  {% for k, l in views %}{% set nav = nav|merge([{key: k, label: l, href: '?tab=' ~ k}]) %}{% endfor %}
  {{ ui.subnav(nav, tab, 'About this award') }}

  {% if tab == 'details' %}
  {# ══ AWARD DETAILS ════════════════════════════════════════════════════════ #}
  <section class="aw-sec" aria-labelledby="h-det">
    <h2 class="aw-h2" id="h-det">About the award</h2>
    {% if a.description %}<div class="aw-prose">{{ a.description|nl2br }}</div>{% endif %}
    {% if facts|length %}{{ ui.facts(facts, 'text') }}{% endif %}
  </section>


  {% elseif tab == 'terms' %}
  {# ══ TERMS ═══════════════════════════════════════════════════════════════ #}
  <section class="aw-sec" aria-labelledby="h-terms">
    <h2 class="aw-h2" id="h-terms">Terms</h2>
    <div class="aw-prose">{{ a.terms|nl2br }}</div>
  </section>

  {% else %}
  {# ══ OVERVIEW ════════════════════════════════════════════════════════════ #}

  {% if a.cycle %}
  <section class="aw-edition ag-card" aria-labelledby="h-ed">
    <div class="ag-between">
      {# "11th Edition · 2026" — and the year once, where a label already is the year
         (several editions are labelled "2026" and nothing else). #}
      {% set ed = a.cycle.edition_label|default('')|trim %}
      <h2 class="aw-edition__h" id="h-ed"><span>Edition</span>
        {{ ed ?: a.year }}{% if ed and a.year and (a.year ~ '') not in ed %} · {{ a.year }}{% endif %}</h2>
      {# Live for any open phase — a nomination window is happening now as much as a
         vote is — so the pill and the step bar under it speak with one colour. #}
      {% if phase %}{{ ui.pill(phase.label, phase.is_open ? 'live' : (phase.is_finished ? 'ok' : '')) }}{% endif %}
    </div>

    {# Four steps, each a bar over its name and its date. The step that is happening is
       the live colour; the ones behind it are done. Said in words as well: the bars
       carry no meaning a reader without colour would miss, because the sub-line says
       "Closed", "Until 1 Oct", "After voting". #}
    <ol class="aw-steps">
      {% for st in timeline %}
      <li class="aw-steps__i" data-state="{{ st.state }}"{{ st.state == 'now' ? ' aria-current="step"' }}>
        <b>{{ st.label }}</b><span>{{ st.sub }}</span>
      </li>
      {% endfor %}
    </ol>

    {% if phase and phase.detail %}<p class="ag-hint aw-edition__d">{{ phase.detail }}</p>{% endif %}
    {% if action %}<a class="ag-btn ag-btn--primary ag-btn--pill aw-edition__cta" href="{{ action.href }}">{{ action.label }}</a>{% endif %}
  </section>
  {% endif %}

  <section class="aw-sec" aria-labelledby="h-cats">
    <h2 class="aw-h2" id="h-cats">Categories</h2>
    {% if a.categories|default([])|length %}
      {# Ordered by the race once there is one — the strongest lead first — and by the
         organiser's own order until then. Said, because an order a reader cannot
         explain reads as no order. #}
      {% if a.categories|first.leader %}<p class="ag-hint">Strongest lead first.</p>{% endif %}
      <ul class="aw-cats">
        {% for c in a.categories %}
        <li class="aw-cats__i">
          <span class="aw-cats__b">
            <b>{{ c.title }}</b>
            {% if c.leader %}
              {# A nominee on zero votes is not leading anything: the service returns no
                 leader until somebody has voted. #}
              <span class="aw-cats__lead">
                {% if c.leader.photo_path %}
                  <img src="{{ c.leader.photo_path }}" alt="" width="24" height="24" loading="lazy" decoding="async">
                {% else %}{{ ui.avatar(c.leader.name, 24) }}{% endif %}
                Leading: {{ c.leader.name }}
              </span>
            {% else %}
              <span class="aw-cats__lead">{{ c.nominee_count|default(0) }} nominee{{ c.nominee_count == 1 ? '' : 's' }}</span>
            {% endif %}
          </span>
          {% if c.total_votes|default(0) %}<span class="aw-cats__n">{{ c.total_votes|number_format }} votes</span>{% endif %}
        </li>
        {% endfor %}
      </ul>
    {% else %}
      <div class="ag-card">{{ ui.empty('Categories are not published yet',
        'They appear here when the edition opens for nominations.') }}</div>
    {% endif %}
  </section>

  {% if facts|length %}
  <section class="aw-sec" aria-labelledby="h-about">
    <h2 class="aw-h2" id="h-about">About the award</h2>
    {{ ui.facts(facts, 'text') }}
    <a class="aw-more" href="?tab=details">Read the full award details →</a>
  </section>
  {% endif %}

  {#
    WHO BACKS THIS AWARD — published, and below the categories, never above: a sponsor
    band at the top of a page about an award reads as the sponsor's page.

    `rel="nofollow sponsored"` because that is what these links ARE, and the line under
    the cards is the actual guarantee. The schema has no column attaching a sponsor to
    a category, a nominee or a judge, so it is a claim the code cannot quietly break.
  #}
  {% if sponsors %}
  <section class="aw-sec" aria-labelledby="h-spon">
    <h2 class="aw-h2" id="h-spon">Backed by</h2>
    <ul class="aw-spon">
      {% for s in sponsors %}
      <li class="aw-spon__i{{ s.tier == 'headline' ? ' aw-spon__i--headline' : '' }}">
        {% if s.website %}
          <a class="aw-spon__n" href="{{ s.website }}" target="_blank" rel="noopener noreferrer nofollow sponsored">{{ s.name }}</a>
        {% else %}<b class="aw-spon__n">{{ s.name }}</b>{% endif %}
        <span class="aw-spon__t">{{ tiers[s.tier]|default('Sponsor') }}</span>
        {% if s.blurb %}<span class="aw-spon__d">{{ s.blurb }}</span>{% endif %}
      </li>
      {% endfor %}
    </ul>
    <p class="ag-hint aw-spon__rule">
      Sponsors fund the programme. They do not judge it, are never shown to the panel, and
      cannot be attached to a category, a nominee or a judge &mdash; there is no way to
      record that, by design. The scoring method is published in full in the
      <a href="/integrity">Integrity Center</a>.
    </p>
  </section>
  {% endif %}
  {% endif %}
</div></div>
{% endblock %}
