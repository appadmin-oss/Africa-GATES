{% extends "layout/gates.twig" %}
{% block head_styles %}
<style nonce="{{ csp_nonce }}">
  /* ── THE SPONSOR LIST ───────────────────────────────────────────────────────
     Hairline rules and mono micro-labels, the house pattern. Deliberately NOT a logo
     wall: a row of uploaded images at whatever resolution each sponsor sent is the
     single fastest way to make an awards page look like a trade show, and it hands the
     visual weight to whoever supplied the biggest PNG. Names set in the page's own type
     read as the platform naming its backers, which is what this is. */
  .spon{ list-style:none; margin:0; padding:0; border-top:1px solid rgba(16,41,44,.12) }
  .spon__i{ padding:14px 0; border-bottom:1px solid rgba(16,41,44,.12) }
  .spon__b{ display:flex; align-items:baseline; gap:10px; flex-wrap:wrap }
  .spon__n{ font-weight:700; font-size:17px; color:var(--ag-ink,#10292C); text-decoration:none }
  .spon__n[href]{ text-decoration:underline; text-underline-offset:3px;
    text-decoration-color:rgba(16,41,44,.28) }
  .spon__n[href]:hover{ text-decoration-color:currentColor }
  .spon__t{ font-family:var(--ag-font-mono,monospace); font-size:10.5px; font-weight:700;
    letter-spacing:.1em; text-transform:uppercase; color:#5a6d6f }
  /* The headline sponsor is the one thing given weight, and it is given ONE thing —
     a gold rule, not a size, a background and a badge. A highlight almost everything
     qualifies for is a background. */
  .spon__i--headline{ border-left:3px solid #f3b416; padding-left:14px }
  .spon__i--headline .spon__n{ font-size:19px }
  .spon__d{ margin:6px 0 0; font-size:13.5px; line-height:1.6; color:#5a6d6f; max-width:62ch }
  .spon__rule{ margin:16px 0 0; font-size:12.5px; line-height:1.7; color:#5a6d6f;
    max-width:72ch }
</style>
{% endblock %}

{% block content %}

{% set a = programme %}
{# The COMPUTED phase — see AfricaGates\Services\CyclePolicy. `a.cycle_status`
   used to be read here while the service never returned it, so `status` was
   permanently 'upcoming' and every CTA on this page was unreachable in every
   phase. Read `phase` for anything the user sees. #}
{% set phase = a.phase|default(null) %}
{% set status = phase.phase|default(a.cycle_status|default('upcoming')) %}

<section class="p-hero p-hero--image" style="--p-hero-image: url('{{ a.cover|default('https://images.unsplash.com/photo-1492684223066-81342ee5ff30?auto=format&fit=crop&w=2000&q=82') }}')">
  <div class="aurora aurora--dark" aria-hidden="true"></div>
  <div class="wrap">
    <p class="eyebrow" data-anim>{{ a.icon_emoji|default('🏆') }} Programme{% if a.year %} · {{ a.year }} Cycle{% endif %}</p>
    <h1 data-text-anim>{{ a.title }}</h1>
    <p data-anim data-anim-delay="1">{{ a.description }}</p>
    {% if phase %}
    {# One line of state, always present. Absolute dates are the accessible
       primary: no live ticker here, so nothing to announce repeatedly. #}
    <p class="p-hero__state" data-anim data-anim-delay="1"
       style="margin:14px 0 0;font-size:14px;font-weight:600;letter-spacing:.01em">
      <span style="display:inline-flex;align-items:center;gap:8px;padding:7px 15px;border-radius:999px;background:rgba(255,255,255,.14);box-shadow:inset 0 0 0 1px rgba(255,255,255,.2)">
        {% if phase.is_open %}<span aria-hidden="true" style="width:8px;height:8px;border-radius:50%;background:#7FC87C"></span>{% endif %}
        {{ phase.label }}
      </span>
      <span style="margin-left:10px;font-weight:400;opacity:.85">{{ phase.detail }}</span>
    </p>
    {% endif %}
    <div class="p-hero__cta" data-anim data-anim-delay="2">
      {# Deep-link to THIS programme, not the hub. The old links went to /vote
         and to a /vote#{slug} anchor that no page defines. #}
      {% if status == 'voting' %}
        <a href="/vote/{{ a.slug }}" class="btn btn--gold">Cast a vote <svg aria-hidden="true" focusable="false" class="btn__arrow" viewBox="0 0 20 20" fill="none"><path d="M7.5 4.5 13 10 7.5 15.5" stroke="currentColor" stroke-width="1.75" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
      {% elseif status == 'nominations' %}
        <a href="/nominate" class="btn btn--gold">Submit a nomination <svg aria-hidden="true" focusable="false" class="btn__arrow" viewBox="0 0 20 20" fill="none"><path d="M7.5 4.5 13 10 7.5 15.5" stroke="currentColor" stroke-width="1.75" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
      {% elseif status == 'results' %}
        <a href="/leaderboard" class="btn btn--gold">See the results <svg aria-hidden="true" focusable="false" class="btn__arrow" viewBox="0 0 20 20" fill="none"><path d="M7.5 4.5 13 10 7.5 15.5" stroke="currentColor" stroke-width="1.75" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
      {% elseif status == 'shortlisting' or status == 'judging' %}
        {# No action is available, so offer the nearest useful one rather than a
           disabled control or a dead end. #}
        <a href="/vote/{{ a.slug }}" class="btn btn--gold">See the nominees <svg aria-hidden="true" focusable="false" class="btn__arrow" viewBox="0 0 20 20" fill="none"><path d="M7.5 4.5 13 10 7.5 15.5" stroke="currentColor" stroke-width="1.75" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
      {% endif %}
      <a href="/awards" class="btn btn--white">All programmes <svg aria-hidden="true" focusable="false" class="btn__arrow" viewBox="0 0 20 20" fill="none"><path d="M7.5 4.5 13 10 7.5 15.5" stroke="currentColor" stroke-width="1.75" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="text-center mx-auto max-w-xl mb-8" data-anim>
      <p class="eyebrow">Categories</p>
      <h2 data-text-anim>This cycle's <em>shortlist</em></h2>
      {# Say why the order is what it is. An order a reader cannot explain reads as
         no order at all, and they go back to scanning every card. Only shown once
         there is a real race to have ordered by. #}
      {% if a.categories|default([])|length and a.categories|first.leader %}
      <p class="text-sm text-soft" style="margin-top:10px">Ordered by the race — the category with the strongest lead comes first.</p>
      {% endif %}
    </div>
    {% if a.categories is iterable and a.categories|length %}
    <div class="card-grid">
      {% for c in a.categories %}
      <div class="card">
        {% if c.leader and loop.first %}<p class="eyebrow" style="color:#e0245e;margin:0 0 6px">Hottest race</p>{% endif %}
        <h3 class="card__title">{{ c.title }}</h3>
        <p class="card__deck">{{ c.description|default('Recognition for outstanding contribution in this category.') }}</p>

        {# The leader is what the ordering is BASED on, so it has to be visible or
           the sequence looks arbitrary. Absent entirely until the first vote
           lands: a nominee on zero votes is not leading anything. #}
        {% if c.leader %}
        <div style="display:flex;align-items:center;gap:10px;margin:14px 0 0;padding:10px 12px;background:#f4f9f4;border:1px solid #cfe6cf;border-radius:14px">
          <span aria-hidden="true" style="flex:none;width:34px;height:34px;border-radius:50%;background:#237b22;color:#fff;display:inline-flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;background-size:cover;background-position:center{% if c.leader.photo_path %};background-image:url('{{ c.leader.photo_path }}'){% endif %}">{% if not c.leader.photo_path %}{{ c.leader.name|slice(0,1)|upper }}{% endif %}</span>
          <span style="min-width:0">
            <span style="display:block;font-size:10.5px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:#5a6d6f">Out in front</span>
            <strong style="display:block;font-size:14px;color:#10292c;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{ c.leader.name }}</strong>
            {% if c.leader.organisation %}<span style="display:block;font-size:12px;color:#5a6d6f;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{ c.leader.organisation }}</span>{% endif %}
          </span>
        </div>
        {% endif %}

        <div class="card__foot">
          <span class="text-sm text-soft">{{ c.nominee_count|default(0) }} nominees{% if c.total_votes|default(0) %} · {{ c.total_votes|number_format }} votes cast{% endif %}</span>
          {% if status == 'voting' %}
            <a href="/vote/{{ a.slug }}" class="btn btn--emerald btn--sm">Vote <svg aria-hidden="true" focusable="false" class="btn__arrow" viewBox="0 0 20 20" fill="none"><path d="M7.5 4.5 13 10 7.5 15.5" stroke="currentColor" stroke-width="1.75" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
          {% endif %}
        </div>
      </div>
      {% endfor %}
    </div>
    {% else %}
    <div class="empty-rich" data-anim>
      <div class="empty-rich__icon">🌱</div>
      <h3>Categories open soon</h3>
      <p>The {{ a.title }} cycle is being finalised. Subscribe to be notified the moment nominations open.</p>
      <a href="/" class="btn btn--primary">Back to home <svg aria-hidden="true" focusable="false" class="btn__arrow" viewBox="0 0 20 20" fill="none"><path d="M7.5 4.5 13 10 7.5 15.5" stroke="currentColor" stroke-width="1.75" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
    </div>
    {% endif %}
  </div>
</section>

{#
  ══ WHO BACKS THIS AWARD ══════════════════════════════════════════════════════

  Published, and that is the point. A sponsorship nobody can see is the arrangement people
  reasonably suspect; one printed under the award is one they can weigh. The whole claim of
  this platform is that an award cannot be bought, and the way to hold that claim beside
  money changing hands is disclosure rather than silence.

  BELOW the categories, never above them. A sponsor band at the top of a page about an
  award reads as the sponsor's page, and the first thing a nominee's family should see is
  the award.

  The line under the list is not decoration — it is the actual guarantee, stated where
  somebody is looking at the thing that raises the question. The schema has no column
  attaching a sponsor to a category, a nominee or a judge, so this is a claim the code
  cannot quietly stop honouring.

  `rel="nofollow sponsored"` because that is what these links ARE: `sponsored` is the value
  Google defines for a paid link, and omitting it on links somebody paid for is the thing
  that costs a site its ranking.
#}
{% if sponsors %}
<section class="sec sec--tight" aria-labelledby="spon-h">
  <div class="wrap">
    <span class="eyebrow">Supported by</span>
    <h2 id="spon-h" class="sec__h">Who backs this programme</h2>
    <ul class="spon">
      {% for s in sponsors %}
        <li class="spon__i spon__i--{{ s.tier }}">
          <div class="spon__b">
            {% if s.website %}
              <a class="spon__n" href="{{ s.website }}" target="_blank"
                 rel="noopener noreferrer nofollow sponsored">{{ s.name }}</a>
            {% else %}
              <span class="spon__n">{{ s.name }}</span>
            {% endif %}
            <span class="spon__t">{{ tiers[s.tier]|default('Sponsor') }}</span>
          </div>
          {% if s.blurb %}<p class="spon__d">{{ s.blurb }}</p>{% endif %}
        </li>
      {% endfor %}
    </ul>
    <p class="spon__rule">
      Sponsors fund the programme. They do not judge it, are never shown to the panel, and
      cannot be attached to a category, a nominee or a judge &mdash; there is no way to
      record that, by design. The scoring method is published in full in the
      <a href="/integrity">Integrity Center</a>.
    </p>
  </div>
</section>
{% endif %}

{% endblock %}
