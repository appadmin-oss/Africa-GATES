{% extends 'layout/shell.twig' %}

{#
  ══════════════════════════════════════════════════════════════════════════════
  `/awards` — EVERY AWARD · Phase 5 · AwardsPage.dc.html (view: index) · §8.3
  ══════════════════════════════════════════════════════════════════════════════

  Written from the DC after the old page was destroyed (inventory:
  docs/handoff/inventory/pages--awards--index.md). Every fact from AwardsFront::index().

  · The collapsing sticky search (§9.2) is the shared `.ag-sticky[data-cs]` block, driven by
    shell.js. Here it is a GET FORM: the query and the phase chip are URL parameters, so the
    list works with no script, survives Back and can be sent to somebody.
  · The phase chips carry a dot coloured by the phase AND the phase's name — colour is never
    the only signal (ColourIsNeverAloneTest). The DC's mono counts are DM Sans (Q5: mono is
    for references and codes only).
  · Phone: the root app bar's large title is the <h1> (§7.2); the page's own head shows from
    600px, where the app bar does not.
#}

{% set colour_tier = '2' %}
{% set app_bar = {variant: 'root', title: 'Awards'|trans, search: false} %}
{% set _v = front.view %}
{% set _chips = [{key: 'all', label: 'All', dot: 'ink', n: front.total}] %}
{% for k, p in phases %}{% set _chips = _chips|merge([{key: k, label: p[0], dot: p[1], n: front.counts[k]}]) %}{% endfor %}

{% block head_styles %}<link rel="stylesheet" href="{{ asset('/assets/css/components/photo.css') }}"><link rel="stylesheet" href="{{ asset('/assets/css/components/awards.css') }}">{% endblock %}

{% block content %}
<div class="aw">
  <div class="aw__head">
    <h1 class="aw__h1">{{ 'Awards across Africa'|trans }}</h1>
    <p class="aw__lede">{{ 'Every award on Africa GATES runs in editions, with public nominations, community voting and an independent jury.'|trans }}</p>
  </div>
  <p class="aw__lede aw__lede--phone">{{ 'Every award on Africa GATES runs in editions, with public nominations, community voting and an independent jury.'|trans }}</p>

  <form class="ag-sticky aw-tools" data-cs method="get" action="/awards" role="search" aria-label="{{ 'Find an award'|trans }}">
    <div class="ag-cs__row">
      <div>
        <label class="ag-field ag-field--search aw-search">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.6-3.6" stroke-linecap="round"/></svg>
          <input type="search" name="q" value="{{ _v.q }}" data-cs-input enterkeyhint="search" autocomplete="off"
                 aria-label="{{ 'Search awards'|trans }}" placeholder="{{ 'Search awards, hosts or countries'|trans }}">
        </label>
        {% if _v.ph != 'all' %}<input type="hidden" name="ph" value="{{ _v.ph }}">{% endif %}
      </div>
    </div>
    <nav class="ag-chip-row" aria-label="{{ 'Filter by phase'|trans }}">
      <span class="ag-cs__btn">
        <button type="button" class="ag-cs__go" data-cs-btn aria-label="{{ 'Search awards'|trans }}">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.6-3.6" stroke-linecap="round"/></svg>
        </button>
      </span>
      {% for c in _chips %}
        <a class="ag-chip aw-chip" href="/awards{{ (c.key != 'all' or _v.q) ? '?' }}{{ c.key != 'all' ? 'ph=' ~ c.key }}{{ (c.key != 'all' and _v.q) ? '&' }}{{ _v.q ? 'q=' ~ _v.q|url_encode }}"
           {% if _v.ph == c.key %}aria-current="page"{% endif %}>
          <span class="ag-chip__dot" style="--ag-dot:var(--ag-{{ c.dot }})"></span>{{ c.label|trans }}<span class="ag-chip__n">{{ c.n }}</span>
        </a>
      {% endfor %}
    </nav>
  </form>

  {% if front.cards|length %}
    <ul class="aw-grid">
      {% for a in front.cards %}
        <li>
          <a class="aw-card" href="{{ a.url }}">
            <span class="aw-card__cover">
              {% include 'partials/photo.twig' with {kind: 'thing', src: a.cover, name: a.title, tone: a.tone, title: not a.cover, eager: loop.index <= 3} only %}
              <span class="aw-badge"><span class="aw-badge__dot" style="--ag-dot:var(--ag-{{ a.dot }})"></span>{{ a.badge|trans }}</span>
            </span>
            <span class="aw-card__body">
              <span class="aw-card__host">{{ a.host ? a.host ~ ' · ' }}{{ a.where|trans }}</span>
              <span class="aw-card__t">{{ a.title }}</span>
              <span class="aw-card__meta">
                {% if a.edition %}<span>{{ a.edition }}</span>{% endif %}
                {% if a.cats %}<span>{{ a.cats == 1 ? '1 category'|trans : '%n% categories'|trans({'%n%': a.cats}) }}</span>{% endif %}
                {% if a.next %}<span>{{ a.next }}</span>{% endif %}
              </span>
            </span>
          </a>
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <div class="aw-empty">
      <p class="aw-empty__t">{{ (_v.q or _v.ph != 'all') ? 'No award matches that.'|trans : 'No awards are listed yet.'|trans }}</p>
      {% if _v.q or _v.ph != 'all' %}<a class="ag-btn ag-btn--secondary ag-btn--pill" href="/awards">{{ 'Show every award'|trans }}</a>{% endif %}
    </div>
  {% endif %}
</div>
{% endblock %}
