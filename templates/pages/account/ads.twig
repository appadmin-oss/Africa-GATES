{% extends 'layout/shell.twig' %}
{#
  /account/ads — THE ADS MANAGER (Services\Ads\AdCampaigns)

  Meta's campaigns table, cut to what an advertiser here acts on: the state (derived, never
  stored), views, clicks, click rate, spend. The trial's size is read from AdRules.
#}
{% set colour_tier = '1' %}

{% block head_styles %}<link rel="stylesheet" href="{{ asset('/assets/css/components/ads.css') }}">{% endblock %}

{% block content %}
<div class="am">
  <header class="am-head">
    <h1 class="am-h1">{{ 'Ads'|trans }}</h1>
    {% if trial_left %}
    <p class="am-p">{{ 'Your free trial: up to %v% views over %d% days.'|trans({'%v%': rules.views|number_format, '%d%': rules.days}) }}</p>
    <a class="ag-btn ag-btn--primary ag-btn--pill" href="/account/ads/new">{{ 'Create campaign'|trans }}</a>
    {% else %}
    <p class="am-p">{{ 'Your free trial is used. Paid campaigns open soon.'|trans }}</p>
    {% endif %}
    <p class="am-note"><a class="am-link" href="/advertise">{{ 'Places and prices'|trans }}</a></p>
  </header>

  {% if campaigns %}
  <ul class="am-list">
    {% for c in campaigns %}
    <li class="am-row">
      <a class="am-row__a" href="/account/ads/{{ c.id }}">
        <span class="am-row__n">{{ c.name }}{% if c.trial %} <span class="am-row__s">· {{ 'Free trial'|trans }}</span>{% endif %}</span>
        <span class="am-state am-state--{{ c.delivery }}">{{ c.delivery_label|trans }}</span>
        <span class="am-row__m">
          <span><b>{{ c.views|number_format }}</b> {{ 'views'|trans }}</span>
          <span><b>{{ c.clicks|number_format }}</b> {{ 'clicks'|trans }}</span>
          <span><b>{{ c.ctr is null ? '–' : c.ctr ~ '%' }}</b> {{ 'click rate'|trans }}</span>
          <span><b>{{ c.trial ? 'Free'|trans : c.spent_label }}</b> {{ 'spent'|trans }}</span>
        </span>
      </a>
    </li>
    {% endfor %}
  </ul>
  {% else %}
  <p class="am-p">{{ 'No campaigns yet.'|trans }}</p>
  {% endif %}
</div>
{% endblock %}
