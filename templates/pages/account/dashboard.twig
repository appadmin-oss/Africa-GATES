{% extends "layout/gates.twig" %}

{# This page renders flash_* itself, beside the thing the message is about, so the
   layout rail is suppressed — otherwise every message would appear twice. #}
{% set own_flash = true %}

{# Tier 2, transactional: it asks a reader to redeem points and to withdraw money,
   and `ColourBudgetTest` allows two colour events for that. Every tint on this
   screen is an ICON tile, which the sweep does not charge and should not — a 16px
   stroke is a word, not an area. #}
{% set colour_tier = '2' %}

{#
  ══ /account — BUILT FROM `AccountPage.dc.html` ON THE SHARED LIBRARY ════════════

  ── HOW THIS PAGE IS PUT TOGETHER ───────────────────────────────────────────────

    components.css      what a card, a row and a tile LOOK like
    components/library  what a table and a pill look like (moved out in Phase 1)
    partials/ui.twig    what they are MADE of — the macros below call these
    components/account  this page's layout model and the four things only it has

  The page itself is content. If a block below looks like it is describing
  presentation, it is in the wrong file.

  ── THE FOUR THINGS THAT HAVE TO AGREE ──────────────────────────────────────────

  A section is visible only when all of these line up, and this file has twice
  shipped a fully-built section nobody could reach because one was missed — the
  referral panel, then the stall:

    1. an entry in `me_tabs`, or the head script falls back to 'overview'
    2. a rail row, or there is nothing to click
    3. the generated reveal rule, because `[data-me] .me-sec` hides everything
    4. a section whose id is exactly `me-<tab>`

  Everything below loops ONE array, so (2), (3) and (4) cannot drift from (1).

  ── WHAT SURVIVES WITH NO JAVASCRIPT ────────────────────────────────────────────

  All of it. Rail rows are real `<a href="#me-…">` and `:target` reveals the
  section; the forms post; the links navigate. The script adds the highlight, the
  search, the filters and the balance toggle — so the worst case is a stale
  highlight, never tabs that do nothing.
#}

{% set me_tabs = ['overview','points','referral','challenges','purchases','vendor','activity','saved','security','settings'] %}

{% block head_styles %}
{# Synchronous and FIRST — it decides what is painted, so it cannot be deferred. #}
<script nonce="{{ csp_nonce }}">
  (function () {
    var ok = {{ me_tabs|json_encode|raw }};
    // The hash is the SECTION ID (`#me-referral`), because that is what makes
    // `:target` work with no JavaScript. The bare form is accepted so links shared
    // before this change keep working.
    var h = (location.hash || '').replace('#','').replace(/^me-/,'');
    document.documentElement.setAttribute('data-me', ok.indexOf(h) >= 0 ? h : 'overview');

    // The balance answer, HERE rather than at the foot: applied after layout it
    // would show the figure a member asked us to hide for a frame on every load —
    // on a slow connection, a second — which is the whole of what it was for.
    //
    // Wrapped, because `localStorage` THROWS rather than returning null in a
    // private window, and an exception here would abort the section choice above
    // it and leave every tab dead.
    try {
      if (localStorage.getItem('ag-hide-bal') === '1') {
        document.documentElement.setAttribute('data-bal', 'hidden');
      }
    } catch (e) {}
  })();
</script>
<style nonce="{{ csp_nonce }}">
  /* GENERATED from `me_tabs`, and it has to be: this is the third place a section
     id is spelled, and the two hand-written ones each shipped a section nobody
     could reach. */
  {% for t in me_tabs %}
  [data-me="{{ t }}"] #me-{{ t }}{{ loop.last ? '' : ',' }}
  {% endfor %}
  { display:flex; }
  {% for t in me_tabs %}
  [data-me="{{ t }}"] .me-ph__t[data-me-title="{{ t }}"]{{ loop.last ? '' : ',' }}
  {% endfor %}
  { display:block; }
  {% for t in me_tabs %}
  [data-me="{{ t }}"] .me-rail__i[data-me-go="{{ t }}"],
  {% endfor %}
  .me-rail__i[aria-current]{ background:var(--ag-surface); font-weight:700;
    box-shadow:0 1px 2px rgba(16,41,44,.06); }
</style>
{% endblock %}

{% block content %}
{% import "partials/ui.twig" as ui %}
{% import "partials/icons.twig" as gi %}
{# The site's one chart component — see partials/viz.twig for what interaction is
   for, and why every value it shows is also in a table. #}
{% import "partials/viz.twig" as viz %}

{% set first_name = user.name|default('')|split(' ')|first %}
{% set open_steps = checklist|default([])|filter(s => not s.done) %}

{# The rail. `on` gates a row — the stall appears only for a member linked to a
   vendor account, because a rail entry for a section that is not rendered is a door
   onto nothing. `warm` marks a count that wants attention rather than one that is a
   total.

   A Twig comment cannot sit INSIDE the array literal: it closes the brace, and
   doing that once answered 500 on the whole dashboard. #}
{% set rail = [
  {'id':'overview',  'label':'Overview',   'ico':'overview', 'tone':'neutral', 'n':null},
  {'id':'points',    'label':'Points',     'ico':'points',   'tone':'green',   'n':points|default(0)},
  {'id':'referral',  'label':'Referrals',  'ico':'refer',    'tone':'live',    'n':referral.referrals|default(0)},
  {'id':'challenges','label':'Challenges', 'ico':'trophy',   'tone':'gold',    'n':(my_challenges|default([]))|length},
  {'id':'purchases', 'label':'Purchases',  'ico':'bag',      'tone':'info',    'n':counts.purchases|default(0)},
  {'id':'vendor',    'label':'Your stall', 'ico':'stand',    'tone':'info',
   'n':(vendor ? (vendor.live_offers|length ?: (vendor.applications|length ?: null)) : null),
   'on':(vendor is not null), 'warm':true},
  {'id':'activity',  'label':'Activity',   'ico':'activity', 'tone':'green',   'n':counts.activity|default(0), 'warm':true},
  {'id':'saved',     'label':'Saved',      'ico':'saved',    'tone':'gold',    'n':counts.saved|default(0)},
  {'id':'security',  'label':'Security',   'ico':'shield',   'tone':'neutral', 'n':null},
  {'id':'settings',  'label':'Settings',   'ico':'settings', 'tone':'neutral', 'n':null}
] %}

{# The DC's own per-tab leads, character for character. #}
{% set leads = {
  'points':     'Earn points when you buy, book or give. Spend them as votes.',
  'referral':   'Share events. Once ' ~ referral.threshold|default(5) ~ ' people buy through your link, you earn ' ~ referral.rate_pct|default(10) ~ '% of everything they pay.',
  'challenges': 'Your entries, what’s coming up, and past results.',
  'purchases':  'Tickets, shop orders and gifts in one place.',
  'activity':   'Your votes and nominations, and anything that needs you.',
  'saved':      'People, awards, events and items you saved.',
  'security':   'How you sign in, and where you’re signed in.',
  'settings':   'Your details, preferences and data.',
  'vendor':     'Your pitch, what you sell, and what is owing.'
} %}

{# ── ONE WORD PER STATE, DECIDED ONCE ───────────────────────────────────────────
   Three screens show a nomination's state and two show a purchase's, and before
   this each spelled its own sentence — which is how one row came to read "Checking"
   in one place and "In review" in another. `group` is what the filter chips key on,
   so a chip and a pill can never disagree about which rows they mean.

   The DEFAULT is the raw status title-cased rather than a guess: a state this map
   has not met should look obviously unaccounted for, not quietly wear the nearest
   colour. #}
{% set NOM_STATE = {
  'needs_details': {'label':'Needs you',  'tone':'warn', 'group':'needs'},
  'draft':         {'label':'Draft',      'tone':'',     'group':'needs'},
  'submitted':     {'label':'Submitted',  'tone':'wait', 'group':'checking'},
  'checking':      {'label':'Checking',   'tone':'wait', 'group':'checking'},
  'verified':      {'label':'Verified',   'tone':'ok',   'group':'done'},
  'approved':      {'label':'Approved',   'tone':'ok',   'group':'done'},
  'rejected':      {'label':'Not taken',  'tone':'bad',  'group':'done'}
} %}
{% set BUY_STATE = {
  'confirmed': {'label':'Confirmed',   'tone':'ok'},
  'delivered': {'label':'Delivered',   'tone':'ok'},
  'paid':      {'label':'Paid',        'tone':'ok'},
  'shipped':   {'label':'On its way',  'tone':'wait'},
  'offered':   {'label':'Seat held',   'tone':'wait'},
  'waiting':   {'label':'Waiting list','tone':'wait'},
  'pending':   {'label':'Pending',     'tone':'wait'},
  'unpaid':    {'label':'Not paid',    'tone':'warn'},
  'refunded':  {'label':'Refunded',    'tone':'bad'},
  'cancelled': {'label':'Cancelled',   'tone':'bad'}
} %}

{# What a ledger row's `reason` is called on screen. #}
{% set labels = {
  'earn.shop_order':'Shop order', 'earn.donation':'Donation',
  'earn.event_ticket':'Event ticket', 'earn.referral':'Referral bonus',
  'earn.nomination':'Nomination bonus', 'earn.welcome':'Welcome bonus',
  'spend.vote':'Redeemed for votes', 'adjust.admin':'Adjustment by the team'
} %}

<div class="me" id="me">

  {# ══ THE PHONE HUB ═════════════════════════════════════════════════════════
     Below 600 this is a HOME (greeting, balance, eight tiles, a list of everywhere
     else) and a set of CHILD VIEWS you are pushed into. Which bar is showing is
     decided by CSS from the same `data-me` the head script wrote before first
     paint — not by a second script and not by a server-side guess at a viewport,
     so there is no frame in which the wrong bar is up.

     With no script `data-me` is absent, every section is visible, and this resolves
     to the greeting bar over a long page. That is why the selectors key off
     `:not([data-me="overview"])` rather than assuming the attribute exists. #}
  <div class="me-ph">
    <div class="me-ph__home">
      {# Not a link: this site has no public member profile to open, and a 404
         behind an avatar is worse than an avatar that does nothing. #}
      {{ ui.avatar(user.name, 44) }}
      <span class="me-ph__who">
        <b>Hi, {{ first_name }}</b>
        {# Read off `gates_users.email_verified`, the only verification this
           platform records for a member. Absent rather than reworded when it is not
           set: "Unverified member" is an accusation on somebody's own home screen,
           and the checklist already asks for the thing that fixes it. #}
        {% if user.email_verified %}
          <span class="me-ph__vf">{{ gi.ui('shield-tick', 13) }}Verified member</span>
        {% endif %}
      </span>
      <button type="button" class="me-ph__ico" id="mePhFind"
              aria-controls="meFind" aria-expanded="false"
              aria-label="Search your account">{{ gi.ui('search', 21) }}</button>
      <a class="me-ph__ico" href="#me-settings" data-me-go="settings"
         aria-label="Settings">{{ gi.ui('gear', 21) }}</a>
    </div>

    {# Every title is in the document and CSS reveals the one matching `data-me`.
       The alternative is the controller passing it, which it cannot: the section is
       chosen by the HASH, which never reaches the server. `role="heading"` and not
       an `<h2>`, because ten hidden `<h2>`s would sit in the page outline for a
       reader walking headings — `display:none` keeps them out of both. #}
    <div class="me-ph__child">
      <a class="me-ph__ico" href="#me-overview" data-me-go="overview"
         aria-label="Back to your account">{{ gi.ui('back', 22) }}</a>
      {% for r in rail %}
        <span class="me-ph__t" data-me-title="{{ r.id }}" role="heading" aria-level="2">{{ r.label }}</span>
      {% endfor %}
    </div>
  </div>

  <div class="me-body">

    {# ══ THE RAIL — profile, search and nine rows as ONE column ═════════════ #}
    <aside class="me-rail" aria-label="Your account">
      <span class="me-rail__me">
        {{ ui.avatar(user.name, 46) }}
        <span class="me-rail__who">
          <b>{{ user.name }}</b>
          <span>{{ user.email_verified ? 'Verified member' : 'Member' }}</span>
        </span>
      </span>

      {# One field, filtering everything. No `/` shortcut and no key hint: the site
         binds `/` to its own search overlay on every page, and a second field
         claiming it would advertise a shortcut that opens somebody else's box. #}
      <label class="me-find">
        {{ gi.ui('search', 15) }}
        <input id="meFind" type="search" autocomplete="off" spellcheck="false"
               placeholder="Search your account"
               aria-label="Search your orders, tickets, votes and points"
               aria-describedby="meFindNote">
      </label>

      <nav class="me-rail__nav" id="meRail" aria-label="Account sections">
        {% for r in rail %}
          {% if r.on is not defined or r.on %}
          {# `aria-current`, NOT `aria-selected`: ARIA permits aria-selected only on
             gridcell, option, row, tab, columnheader, rowheader and treeitem. A
             link is none of those, so readers were handed an attribute they are
             specified to ignore and the rail announced nine identical links. Not
             hardcoded either — the hash decides and the server cannot see it, so
             the stylesheet carries the visual until the script runs. #}
          <a class="me-rail__i" href="#me-{{ r.id }}" data-me-go="{{ r.id }}">
            {{ ui.tile(r.ico, r.tone, 28) }}
            <span class="me-rail__n">{{ r.label }}</span>
            {% if r.n %}<span class="me-rail__c{{ r.warm|default(false) ? ' me-rail__c--warm' : '' }}">{{ r.n|number_format }}</span>{% endif %}
          </a>
          {% endif %}
        {% endfor %}
      </nav>
    </aside>

    <div class="me-pane">

      {% if flash_ok %}<div class="ag-flash ag-flash--ok" role="status">{{ flash_ok }}</div>{% endif %}
      {% if flash_error %}<div class="ag-flash ag-flash--error" role="alert">{{ flash_error }}</div>{% endif %}
      <p id="meFindNote" class="ag-hint" role="status" aria-live="polite"></p>

      {# ══ OVERVIEW ══════════════════════════════════════════════════════════ #}
      <section class="me-sec" id="me-overview" aria-labelledby="me-overview-h">
        {# The page's one `<h1>`, and it is on Overview rather than repeated per
           section: the others are pushed CHILD views and head themselves. Below 600
           it is the phone hub's greeting instead, so this is hidden there with the
           rest of `.ag-pagehead`. #}
        <div class="ag-pagehead">
          <div class="ag-pagehead__b"><h1 id="me-overview-h">Your account</h1></div>
        </div>

        {# A first-run screen, not six empty sections: a dashboard where every panel
           says "nothing yet" reads as a product that is not working, and it is the
           first thing a new member sees. #}
        {% if is_new|default(false) %}
        <div class="ag-card">
          {{ ui.empty('Welcome, ' ~ first_name,
             'Nothing has happened on this account yet. Points arrive from what you buy, the events you book and what you give — and they convert into votes you can cast in the awards.',
             'See the ballot', '/vote') }}
        </div>
        {% endif %}

        <div class="me-top">
          {# ── THE BALANCE CARD ─────────────────────────────────────────────── #}
          <section class="me-bal" aria-labelledby="h-bal" data-find="points balance voting points">
            <div class="me-bal__h">
              <h2 id="h-bal">Voting points
                {# Hiding a balance is a JS-ONLY feature, deliberately: the answer
                   lives in `localStorage`, and a control that forgets what you told
                   it is worse than no control — you hide the number, open Points,
                   and it is back. The button ships `hidden`; the script reveals it. #}
                <button type="button" class="me-eye" id="meEye" hidden
                        aria-pressed="false" aria-label="Hide balances">
                  <span class="me-eye__on">{{ gi.ui('eye', 18) }}</span>
                  <span class="me-eye__off">{{ gi.ui('eye-off', 18) }}</span>
                </button>
              </h2>
              <a class="ag-btn ag-btn--text" href="#me-points" data-me-go="points">History</a>
            </div>

            <div class="me-bal__n">
              <b><span class="me-cash">{{ points|number_format }}</span><span class="me-dots" aria-hidden="true">••••</span></b>
              <span class="me-bal__u">pts</span>
            </div>

            <span class="me-bal__l">
              {%- if points_enabled -%}
                Worth {{ redeemable }} vote{{ redeemable == 1 ? '' : 's' }}{% if redeemable > 0 %} · {{ points_per_vote - points % points_per_vote }} more for the next{% endif %}
              {%- else -%}
                Points are being collected now. Redemption opens with the ballot.
              {%- endif -%}
            </span>

            <div class="me-bal__cta">
              {% if points_enabled and redeemable > 0 %}
                <a class="ag-btn ag-btn--primary" href="/vote">Redeem for votes</a>
              {% else %}
                <span class="ag-btn ag-btn--secondary" aria-disabled="true">Redeem for votes</span>
              {% endif %}
              <a class="ag-btn ag-btn--secondary" href="#me-points" data-me-go="points">Earn more</a>
            </div>

            {# Referral earnings in the foot of the balance card, because it is the
               one number on this account that is MONEY: a member who has earned it
               and never opens that section never learns it is there. `payout_can`
               answers "can they" AND "why not" together, so this either offers the
               withdrawal or says what is in the way — never a button that refuses. #}
            {% if referral.accrued_naira|default(0) > 0 %}
            <div class="me-bal__foot" data-find="referral earnings withdraw">
              <span>
                <span class="ag-hint" style="margin:0">Referral earnings</span><br>
                {# `accrued_naira`, not `payable_naira`: what has been EARNED is the
                   figure a member recognises, and the payable one is zero until the
                   threshold unlocks it — ₦0 beside "Referral earnings" on an account
                   that has earned four thousand is the panel contradicting itself. #}
                <b><span class="me-cash">₦{{ referral.accrued_naira|number_format }}</span><span class="me-dots" aria-hidden="true">₦••••</span></b>
              </span>
              {% if payout_can %}
                <a class="ag-btn ag-btn--secondary ag-btn--sm" href="#me-referral" data-me-go="referral">Withdraw</a>
              {% else %}
                <span class="ag-hint" style="margin:0;max-width:30ch">{{ payout_why }}</span>
              {% endif %}
            </div>
            {% endif %}
          </section>

          {# ── EIGHT TILES ─────────────────────────────────────────────────────
             The destinations somebody came here to reach, where a thumb reaches
             them. Four are `#me-…` links into this page and four leave it, and that
             mixture is the point: this is the answer to "what now", not a second
             rail. EVERY BADGE COUNTS THIS MEMBER'S OWN THINGS — a badge counting
             other people's opportunities never goes down, and one that never goes
             down is one people stop reading. #}
          {% set quick = [
            {'to':'/vote',          'label':'Vote',         'ico':'vote',   'tone':'green'},
            {'to':'/nominate',      'label':'Nominate',     'ico':'plus',   'tone':'green'},
            {'to':'#me-purchases',  'label':'Tickets',      'ico':'ticket', 'tone':'info',
             'n':(my_tickets|default([]))|length},
            {'to':'#me-referral',   'label':'Refer & earn', 'ico':'refer',  'tone':'live'},
            {'to':'#me-challenges', 'label':'Challenges',   'ico':'trophy', 'tone':'gold',
             'n':(my_challenges|default([]))|length},
            {'to':'/shop',          'label':'Orders',       'ico':'bag',    'tone':'info'},
            {'to':'/giving',        'label':'Giving',       'ico':'heart',  'tone':'live'},
            {'to':'/help',          'label':'Help',         'ico':'help',   'tone':'neutral'}
          ] %}
          <nav class="me-quick" aria-label="Quick actions">
            {% for a in quick %}
            <a class="me-quick__i" href="{{ a.to }}"{% if a.to starts with '#me-' %} data-me-go="{{ a.to|slice(4) }}"{% endif %}>
              <span class="ag-icon-tile ag-tint--{{ a.tone }}" aria-hidden="true">
                {{ gi.ui(a.ico, 21) }}
                {% if a.n|default(0) > 0 %}<span class="me-quick__d">{{ a.n > 9 ? '9+' : a.n }}</span>{% endif %}
              </span>
              <span class="me-quick__l">{{ a.label }}</span>
              {# The badge is a glyph on a tile and `aria-hidden`; the count it
                 carries still has to reach a reader who cannot see it, so it is
                 said in words in the link's own name. #}
              {% if a.n|default(0) > 0 %}<span class="ag-sr">, {{ a.n }}</span>{% endif %}
            </a>
            {% endfor %}
          </nav>
        </div>

        {# The promo band (§4). `PromoService` decides what appears; zero promos
           render nothing at all. It belongs to the HOME — a pushed child view hides
           it. #}
        {% include "partials/promo-carousel.twig" with { promos: promos|default([]) } only %}

        <div class="me-ov">
          <div class="me-col">

            {# `backed_winners` is only non-empty for a nominee `CycleMaterialiser`
               actually promoted — the same transaction that crowns the cycle and
               seals the standing — so this cannot congratulate anybody on an award
               nobody has been told about. The celebration key includes every id, so
               a member who backs a second winner next month gets a second
               celebration rather than one that already counts as seen. #}
            {% for w in backed_winners|default([]) %}
            <section class="me-won" data-find="{{ w.nominee }} {{ w.category|default('') }} winner"
                     {% if loop.first %}data-celebrate="backed-{{ backed_winners|map(x => x.id)|join('-') }}"{% endif %}>
              {{ ui.tile('trophy', 'gold', 44) }}
              <span class="ag-list__b" {% if loop.first %}data-celebrate-anchor{% endif %}>
                <b>Someone you backed {{ w.kind == 'winner' ? 'won' : 'was named' }}</b>
                <span class="ag-list__sub">{{ w.nominee }}{% if w.category %} · {{ w.category }}{% endif %}</span>
              </span>
              <a class="ag-btn ag-btn--text" href="/results">See</a>
            </section>
            {% endfor %}

            {# Segments and not a percentage bar: a count is what somebody is
               working towards, and "6 of 10" is a sentence a bar cannot say. #}
            {# THREE STATES, NOT ONE. `verified` is done, `checking` is with us, and
               `needs` is work only this member can do — and that last one is the whole
               point of the card: flattened into one colour it reads as our delay.
               The three counts are `minePublic()`'s own, not re-derived here. #}
            {% for c in my_challenges|default([])|filter(c => c.state == 'open' or c.state == 'full')|slice(0,1) %}
            {% set tgt = c.target|default(10) %}
            <section class="ag-card me-ch" aria-labelledby="h-ch" data-find="{{ c.title }} challenge">
              <div class="ag-between">
                <b id="h-ch">{{ c.title }}</b>
                <span class="ag-list__value">{{ c.time_left }}</span>
              </div>
              {{ ui.meter(
                [{n: c.verified|default(0)},
                 {n: c.checking|default(0), tone: 'wait'},
                 {n: c.needs|default(0),    tone: 'need'}],
                tgt,
                c.verified|default(0) ~ ' of ' ~ tgt ~ ' verified'
                  ~ (c.checking ? ', ' ~ c.checking ~ ' being checked' : '')
                  ~ (c.needs    ? ', ' ~ c.needs ~ ' needing more detail' : '')
              ) }}
              {# Said in words as well as in colour: the segments are `aria-hidden`
                 inside one `role="img"`, and colour is never the only signal (§16). #}
              <span class="me-bal__l">
                <b>{{ c.verified|default(0) }} of {{ tgt }} verified</b>
                {%- if c.checking %} · {{ c.checking }} checking{% endif -%}
                {%- if c.needs %} · {{ c.needs }} need{{ c.needs == 1 ? 's' : '' }} details{% endif -%}
              </span>
              <span class="me-bal__l">{{ c.next }}</span>
              <div class="ag-between">
                {% if c.needs %}
                  <a class="ag-btn ag-btn--secondary ag-btn--sm" href="#me-activity" data-me-go="activity">Fix {{ c.needs }} nomination{{ c.needs == 1 ? '' : 's' }}</a>
                {% endif %}
                <a class="ag-btn ag-btn--text" href="/challenges/{{ c.slug }}">Challenge details</a>
              </div>
            </section>
            {% endfor %}

            {# The last five things that happened. "See all" rather than a longer
               list: this is a summary and Activity is the record. #}
            {% set recent = my_nominations|default([])|slice(0,5) %}
            {% if recent|length %}
            <section class="ag-group" aria-labelledby="h-act">
              <div class="ag-between">
                <h2 id="h-act" class="ag-h2">Recent activity</h2>
                <a class="ag-btn ag-btn--text" href="#me-activity" data-me-go="activity">See all</a>
              </div>
              <div class="ag-list">
                {% for n in recent %}
                {% set st = NOM_STATE[n.status]|default({'label':n.status|replace({'_':' '})|capitalize,'tone':''}) %}
                {{ ui.row({
                  icon: 'activity', tone: 'green',
                  label: n.nominee,
                  sub: (n.created_at ? n.created_at|when : '') ~ (n.reference ? ' · ' ~ n.reference : ''),
                  pill: st,
                  find: n.nominee ~ ' nomination ' ~ n.status
                }) }}
                {% endfor %}
              </div>
            </section>
            {% endif %}
          </div>

          <div class="me-col">
            {# The bar and the count are the same fact in two registers, which the
               DC does on purpose: the number is the answer and the bar is the
               glance. Dropped entirely at 100% — a full bar is not news, and it
               used to sit beside "3 things left", two true statements reading as a
               contradiction because the meter measures the PROFILE and the list
               counts things to do. #}
            {% if open_steps is not empty %}
            <section class="ag-card" aria-labelledby="h-setup">
              <div class="ag-between">
                <b id="h-setup">Finish setting up</b>
                <span class="ag-list__value">{{ checklist|length - open_steps|length }} of {{ checklist|length }}</span>
              </div>
              {{ ui.bar(completeness.pct|default(0), 'Profile ' ~ completeness.pct|default(0) ~ '% complete') }}
              {% for s in checklist %}
              <a class="me-setup__i{{ s.done ? ' me-setup__i--done' : '' }}" href="{{ s.href }}">
                <span class="me-setup__n" aria-hidden="true">{% if s.done %}{{ gi.ui('tick', 12) }}{% else %}{{ loop.index }}{% endif %}</span>
                <span>{{ s.label }}{% if s.done %} <span class="ag-sr">— done</span>{% endif %}</span>
              </a>
              {% endfor %}
            </section>
            {% endif %}

            {# The next thing in the diary, which on this site is a ticket. #}
            {% for t in my_tickets|default([])|filter(t => t.state == 'confirmed')|slice(0,1) %}
            <a class="ag-card ag-list__row" href="{{ t.url }}" data-find="{{ t.event }} ticket">
              <span class="ag-date" aria-hidden="true">
                <span>{{ t.when|date('M')|upper }}</span><b>{{ t.when|date('d') }}</b>
              </span>
              <span class="ag-list__b">
                <span class="ag-list__label">{{ t.event }}{% if t.seats > 1 %} · {{ t.seats }} tickets{% endif %}</span>
                <span class="ag-list__sub">{{ t.tier|default('Ticket') }}{% if t.where %} · {{ t.where }}{% endif %}</span>
              </span>
              <span class="me-go">Ticket</span>
            </a>
            {% endfor %}
          </div>
        </div>

        {# ── "YOUR ACCOUNT" — and it IS the navigation ───────────────────────────
           Phone only. The rail is hidden below 600, so this list is how you get
           anywhere: a ten-item horizontal strip on a 390px screen hides six behind
           a scroll nobody is told about. Looped from the SAME `rail` array with the
           same gate — a hand-written copy here would be the fourth list in this
           file, and the first three each shipped a section nobody could reach. #}
        <section class="ag-group me-more" aria-label="Your account">
          <h2>Your account</h2>
          <div class="ag-list">
            {% for r in rail %}
              {% if r.id != 'overview' and (r.on is not defined or r.on) %}
              {{ ui.row({
                icon: r.ico, tone: r.tone, label: r.label,
                value: r.n ? r.n|number_format : '',
                href: '#me-' ~ r.id,
                attrs: 'data-me-go="' ~ r.id ~ '"'
              }) }}
              {% endif %}
            {% endfor %}
          </div>
        </section>
      </section>

      {# ══ POINTS ════════════════════════════════════════════════════════════ #}
      <section class="me-sec" id="me-points" aria-labelledby="me-points-h">
        <div class="ag-pagehead">
          <div class="ag-pagehead__b">
            <h1 id="me-points-h">Points</h1>
            <p>{{ leads.points }}</p>
          </div>
          {# A points ledger is the one thing on this account somebody has a reason
             to take away — for a tax return, or to check our arithmetic. The route
             already existed and nothing linked to it. #}
          <a class="ag-btn ag-btn--secondary ag-btn--sm" href="/account/points.csv" download>Download CSV</a>
        </div>
        <p class="ag-lead">{{ leads.points }}</p>

        <div class="me-split">
          <section class="ag-card" aria-labelledby="h-pb">
            <h2 id="h-pb" class="ag-hint" style="margin:0 0 14px">Balance</h2>
            <div class="me-bal__n">
              <b style="font-size:44px"><span class="me-cash">{{ points|number_format }}</span><span class="me-dots" aria-hidden="true">••••</span></b>
              <span class="me-bal__u">pts{% if points_enabled %} · worth {{ redeemable }} vote{{ redeemable == 1 ? '' : 's' }}{% endif %}</span>
            </div>

            {# The site's ONE chart component. An earlier cut drew a bare decorative
               `<svg>` here and that was an accessibility regression rather than a
               simplification: this renders the path on the SERVER (so it prints and
               survives a script that never loads), makes the plot keyboard
               reachable, and puts every value the hover shows into a table —
               because a number only reachable by pointing at it is a number some
               people cannot reach. #}
            {% if points_chart.ok|default(false) %}
              {{ viz.chart(points_chart) }}
            {% else %}
              {# A graph of nothing is the worst first screen there is, and the title
                 alone is enough to make one. #}
              <p class="ag-hint">Nothing to chart yet. This fills in as points arrive.</p>
            {% endif %}

            {{ ui.facts([
              {k: 'Earned', v: '+' ~ summary.earned|number_format, tone: 'ok'},
              {k: 'Spent',  v: '−' ~ summary.spent|number_format,  tone: 'bad'},
              {k: 'Next vote', v: points_enabled ? (points_per_vote - points % points_per_vote) ~ ' pts' : '—'}
            ]) }}
          </section>

          <div class="me-col">
            <section class="me-redeem">
              <b>Turn points into votes</b>
              <span>{{ points_per_vote }} points make one vote. Points never expire while your account is active.</span>
              {% if points_enabled and redeemable > 0 %}
                <a class="ag-btn ag-btn--primary" href="/vote">Redeem {{ redeemable }} vote{{ redeemable == 1 ? '' : 's' }}</a>
              {% else %}
                <span class="ag-btn ag-btn--secondary" aria-disabled="true">Redemption opens with the ballot</span>
              {% endif %}
            </section>

            <section class="ag-group" aria-labelledby="h-earn">
              <h2 id="h-earn">Ways to earn</h2>
              <div class="ag-list">
                {% for w in [
                  {'t':'Shop orders',   'r':'1 per ₦100', 'ico':'bag',    'tone':'info'},
                  {'t':'Event tickets', 'r':'1 per ₦100', 'ico':'ticket', 'tone':'green'},
                  {'t':'Donations',     'r':'1 per ₦50',  'ico':'heart',  'tone':'live'},
                  {'t':'Referrals',     'r':'50 each',    'ico':'refer',  'tone':'gold'}
                ] %}
                  {{ ui.row({icon: w.ico, tone: w.tone, label: w.t, value: w.r}) }}
                {% endfor %}
              </div>
            </section>
          </div>
        </div>

        {# ── HISTORY ──────────────────────────────────────────────────────────
           A real table on a desk and a stacked row on a phone, from one row of
           markup. Grouped by month, and the band is STICKY on phone — scrolling a
           long ledger without it means losing track of which month you are in. #}
        <section class="ag-group" aria-labelledby="h-hist">
          <div class="ag-between">
            <h2 id="h-hist" class="ag-h2">History</h2>
            {{ ui.chips('me-filter', [
              {key:'all', label:'All'}, {key:'earn', label:'Earned'}, {key:'spend', label:'Spent'}
            ], 'all', 'Filter the points history') }}
          </div>

          <div class="ag-tbl me-led" id="meLedger">
            <div class="ag-tbl__h" aria-hidden="true">
              <span>Date</span><span>Activity</span><span>Source</span><span style="text-align:right">Points</span>
            </div>
            {% set month = '' %}
            {% for e in ledger %}
              {% if e.created_at|date('F') != month %}
                {% set month = e.created_at|date('F') %}
                <div class="ag-tbl__g">{{ month }}</div>
              {% endif %}
              <div class="ag-tbl__r" data-me-sign="{{ e.delta >= 0 ? 'earn' : 'spend' }}"
                   data-find="{{ labels[e.reason]|default(e.reason) }} {{ e.note|default('') }} points">
                <span class="ag-cell--d ag-cell__p">{{ e.created_at|date('j M') }}</span>
                {{ ui.cell(labels[e.reason]|default(e.reason),
                           e.created_at|date('j M') ~ (e.note ? ' · ' ~ e.note : '')) }}
                <span class="ag-cell--d ag-cell__p">{{ e.note|default('—') }}</span>
                <span class="ag-cell__n ag-facts--{{ e.delta >= 0 ? 'ok' : 'bad' }}">{{ e.delta >= 0 ? '+' : '−' }}{{ (e.delta < 0 ? -e.delta : e.delta)|number_format }}</span>
              </div>
            {% else %}
              {{ ui.empty('No points yet',
                 'Points arrive from what you buy, the events you book and what you give.') }}
            {% endfor %}
            <div id="meLedgerNone" hidden>{{ ui.empty('Nothing in that filter', '') }}</div>
          </div>
        </section>
      </section>

      {# ══ REFERRALS ═════════════════════════════════════════════════════════ #}
      <section class="me-sec" id="me-referral" aria-labelledby="me-ref-h">
        {{ ui.head('Refer people to events', leads.referral, 'me-ref-h') }}
        <p class="ag-lead">{{ leads.referral }}</p>

        <div class="me-split">
          <div class="me-col">
            <section class="ag-card">
              {% if referral.code %}
                <label class="ag-label" for="rfLink">Your referral link</label>
                {# The input stays readonly-and-VISIBLE rather than hidden behind the
                   button, so with no JS — or a clipboard API the browser refuses —
                   the link is still there to select by hand. That matters more here
                   than anywhere else on this page: the link IS the feature. #}
                <div class="ag-inline">
                  <input id="rfLink" class="ag-input ag-input--mono" readonly
                         value="{{ referral_site }}/events?ref={{ referral.code }}">
                  <button type="button" class="ag-btn ag-btn--primary" data-rf-copy="rfLink">Copy</button>
                </div>
                <p class="ag-hint">Code <b>{{ referral.code }}</b> works in the discount box too.</p>
              {% else %}
                <form method="post" action="/account/referral/code">
                  <input type="hidden" name="_token" value="{{ csrf_token }}">
                  <b>Get your referral link</b>
                  <p class="ag-hint">A code is minted when you ask for one, so visiting this
                    page does not create a row for every account.</p>
                  <button class="ag-btn ag-btn--primary" type="submit">Get my link</button>
                </form>
              {% endif %}
            </section>

            <section class="ag-card" aria-labelledby="h-unl">
              <div class="ag-between">
                <h2 id="h-unl" class="ag-h2">Earnings unlocked</h2>
                {{ ui.pill(referral.referrals ~ ' of ' ~ referral.threshold ~ ' paid', 'ok') }}
              </div>
              {{ ui.meter(referral.referrals, referral.threshold,
                 referral.referrals ~ ' of ' ~ referral.threshold ~ ' paid bookings') }}
              {{ ui.facts([
                {k:'Paid referrals', v: referral.referrals ~ ' / ' ~ referral.threshold},
                {k:'Earned',    v: '₦' ~ referral.accrued_naira|number_format},
                {k:'Withdrawn', v: '₦' ~ referral.paid_out_naira|number_format}
              ]) }}
              {% include "partials/account-payout.twig" with {
                payout_open: payout_open, payout_can: payout_can, payout_amount: payout_amount,
                payout_why: payout_why, payout_bank: payout_bank, payout_history: payout_history,
                csrf_token: csrf_token
              } only %}
              <p class="ag-hint">Paid to an account in your name. A referral counts once the
                ticket is paid; refunds remove it.</p>
            </section>
          </div>

          <div class="me-col">
            <section class="ag-card" aria-labelledby="h-hiw">
              <h2 id="h-hiw" class="ag-h2">How it works</h2>
              {{ ui.steps([
                {s: 'Share your link or code with friends, family and colleagues.'},
                {s: 'They buy event tickets through it.'},
                {s: 'After ' ~ referral.threshold ~ ' paid bookings you earn ' ~ referral.rate_pct ~ '% of everything they paid, including the first ' ~ referral.threshold ~ '.'}
              ]) }}
            </section>

            {% if my_links|default([])|length %}
            <section class="ag-group" aria-labelledby="h-links">
              <h2 id="h-links">Links you made</h2>
              <div class="ag-list">
                {% for l in my_links %}
                <span class="ag-list__row" data-find="{{ l.nominee }} share link">
                  <span class="ag-list__b">
                    <span class="ag-list__label">{{ l.nominee }}</span>
                    <span class="ag-list__sub">{{ l.hits }} open{{ l.hits == 1 ? '' : 's' }}{% if l.expired %} · expired{% elseif l.expires_at %} · until {{ l.expires_at|when }}{% endif %}</span>
                  </span>
                  <button type="button" class="ag-btn ag-btn--secondary ag-btn--sm" data-me-copy="{{ l.url }}"
                          aria-label="Copy the link for {{ l.nominee }}">Copy</button>
                </span>
                {% endfor %}
              </div>
            </section>
            {% endif %}
          </div>
        </div>
      </section>

      {# ══ CHALLENGES ════════════════════════════════════════════════════════ #}
      <section class="me-sec" id="me-challenges" aria-labelledby="me-ch-h">
        {{ ui.head('Challenges', leads.challenges, 'me-ch-h') }}
        <p class="ag-lead">{{ leads.challenges }}</p>

        {% if my_challenges|default([])|length %}
        {% set tone = {'open':'green','full':'gold','ended':'neutral','upcoming':'info'} %}
        <div class="me-cards">
          {% for c in my_challenges %}
          <a class="ag-card ag-card--link" href="/challenges/{{ c.slug }}"
             data-find="{{ c.title }} {{ c.kicker }} challenge">
            <div class="ag-between">
              {{ ui.tile('trophy', tone[c.state]|default('gold'), 44) }}
              {{ ui.pill(c.state_label, c.state == 'open' ? 'ok' : (c.state == 'full' ? 'warn' : '')) }}
            </div>
            <b class="ag-h2">{{ c.title }}</b>
            <span class="ag-list__sub" style="white-space:normal">{{ c.next }}</span>
            {% if c.pct is not null and c.state == 'open' %}
              {{ ui.bar(c.pct, c.pct ~ '% of the way') }}
            {% endif %}
          </a>
          {% endfor %}
        </div>
        {% else %}
        <div class="ag-card">
          {{ ui.empty('You are not in a challenge yet',
             'A challenge is a run of nominations or referrals with a prize at the end of it.',
             'See what is running', '/challenges') }}
        </div>
        {% endif %}
      </section>

      {# ══ PURCHASES ═════════════════════════════════════════════════════════ #}
      <section class="me-sec" id="me-purchases" aria-labelledby="me-buy-h">
        {{ ui.head('Purchases', leads.purchases, 'me-buy-h') }}
        <p class="ag-lead">{{ leads.purchases }}</p>

        {% set buys = [] %}
        {% for t in my_tickets|default([]) %}
          {% set buys = buys|merge([{
            'kind':'ticket', 'title':t.event, 'meta':'Ticket' ~ (t.tier ? ' · ' ~ t.tier : ''),
            'when':t.when, 'amount':null, 'state':t.state, 'url':t.url, 'code':t.code,
            'act':(t.state == 'confirmed' ? 'View ticket' : 'Details')
          }]) %}
        {% endfor %}
        {% for o in my_orders|default([]) %}
          {% set buys = buys|merge([{
            'kind':'order', 'title':o.what, 'meta':o.items ~ ' item' ~ (o.items == 1 ? '' : 's'),
            'when':o.placed, 'amount':o.total, 'state':o.status, 'url':o.url, 'code':null,
            'act':(o.tracking ? 'Track' : 'Details')
          }]) %}
        {% endfor %}

        {% if buys|length %}
        {{ ui.chips('me-buy', [
          {key:'all', label:'All'}, {key:'ticket', label:'Tickets'}, {key:'order', label:'Orders'}
        ], 'all', 'Filter purchases') }}

        <div class="ag-tbl me-buy" id="meBuys">
          <div class="ag-tbl__h" aria-hidden="true">
            <span></span><span>Item</span><span>Date</span>
            <span style="text-align:right">Amount</span><span>Status</span><span></span>
          </div>
          {% for b in buys %}
          {% set st = BUY_STATE[b.state]|default({'label':b.state|replace({'_':' '})|capitalize,'tone':''}) %}
          <a class="ag-tbl__r" href="{{ b.url }}" data-me-kind="{{ b.kind }}"
             data-find="{{ b.title }} {{ b.meta }} {{ b.code|default('') }} {{ b.kind }}">
            {{ ui.tile(b.kind == 'ticket' ? 'ticket' : 'bag', b.kind == 'ticket' ? 'green' : 'info', 40) }}
            {{ ui.cell(b.title, b.meta ~ (b.code ? ' · ' ~ b.code : '')) }}
            <span class="ag-cell--d ag-cell__p">{% if b.when %}{{ b.when|date('j M') }}{% endif %}</span>
            <span class="me-amt">
              <b>{% if b.amount %}₦{{ b.amount|number_format }}{% else %}—{% endif %}</b>
              <span class="ag-cell--m ag-cell__s">{{ st.label }}</span>
            </span>
            <span class="ag-cell--d">{{ ui.pill(st.label, st.tone) }}</span>
            <span class="ag-cell--d me-go">{{ b.act }}</span>
          </a>
          {% endfor %}
          <div id="meBuysNone" hidden>{{ ui.empty('Nothing in that filter', '') }}</div>
        </div>
        {% else %}
        <div class="ag-card">
          {{ ui.empty('Nothing bought yet',
             'Orders from the shop and tickets to events show up here, with their status and the code that gets you in.',
             'See what is coming up', '/events') }}
        </div>
        {% endif %}
      </section>

      {# ══ YOUR STALL ════════════════════════════════════════════════════════
         Not in the DC — a stand vendor is this platform's own, and `/org` was built
         for a DONATION partner who has none of what a trader needs. Built from the
         same library as everything else rather than keeping its old shapes. #}
      {% if vendor %}
      <section class="me-sec" id="me-vendor" aria-labelledby="me-vendor-h">
        {{ ui.head('Your stall', leads.vendor, 'me-vendor-h') }}
        <p class="ag-lead">{{ leads.vendor }}</p>

        {{ ui.facts([
          {k:'Pitches live',  v: vendor.live_offers|length},
          {k:'Applications',  v: vendor.applications|length},
          {k:'Owing',         v: '₦' ~ vendor.owed|default(0)|number_format,
           tone: vendor.owed|default(0) > 0 ? 'warn' : ''}
        ]) }}

        {% if vendor.missing_docs|default([])|length %}
        <div class="ag-flash ag-flash--error" role="status">
          Still needed before a pitch can be confirmed: {{ vendor.missing_docs|join(', ') }}.
        </div>
        {% endif %}

        {% for group in [{'t':'Live pitches','rows':vendor.live_offers},{'t':'Applications','rows':vendor.applications}] %}
          {% if group.rows|length %}
          <section class="ag-group">
            <h2>{{ group.t }}</h2>
            <div class="ag-list">
              {% for a in group.rows %}
                {{ ui.row({
                  icon: 'stand', tone: 'info', label: a.event,
                  sub: (a.label|default(a.type)) ~ (a.expires_at ? ' · take it by ' ~ a.expires_at|when : ''),
                  pill: a.owing ? {label: '₦' ~ a.owing|number_format ~ ' owing', tone: 'warn'} : null,
                  find: a.event ~ ' stall pitch'
                }) }}
              {% endfor %}
            </div>
          </section>
          {% endif %}
        {% endfor %}

        {% if vendor.items|default([])|length %}
        <section class="ag-group">
          <h2>What you sell</h2>
          <div class="ag-list">
            {% for i in vendor.items %}
              {{ ui.row({
                label: i.name,
                sub: i.category ~ (i.price_naira ? ' · ₦' ~ i.price_naira|number_format : '') ~ (i.price_note ? ' · ' ~ i.price_note : ''),
                pill: {label: i.is_available ? 'On sale' : 'Hidden', tone: i.is_available ? 'ok' : ''},
                find: i.name ~ ' ' ~ i.category ~ ' stall item'
              }) }}
            {% endfor %}
          </div>
          <p class="ag-hint">Up to {{ vendor_max }} items.</p>
        </section>
        {% endif %}
      </section>
      {% endif %}

      {# ══ ACTIVITY ══════════════════════════════════════════════════════════ #}
      <section class="me-sec" id="me-activity" aria-labelledby="me-act-h">
        {{ ui.head('Activity', leads.activity, 'me-act-h') }}
        <p class="ag-lead">{{ leads.activity }}</p>

        {% if my_nominations|length %}
        {{ ui.chips('me-nom', [
          {key:'all', label:'All'}, {key:'needs', label:'Needs you'},
          {key:'checking', label:'Checking'}, {key:'done', label:'Done'}
        ], 'all', 'Filter activity') }}

        <div class="ag-tbl me-act" id="meNoms">
          <div class="ag-tbl__h" aria-hidden="true">
            <span></span><span>Who</span><span>What</span><span>Status</span><span></span>
          </div>
          {% for n in my_nominations %}
          {% set st = NOM_STATE[n.status]|default({'label':n.status|replace({'_':' '})|capitalize,'tone':'','group':'other'}) %}
          {% set meta = (n.created_at ? n.created_at|when : '') ~ (n.reference ? ' · ' ~ n.reference : '') %}
          <div class="ag-tbl__r" data-me-nomstate="{{ st.group }}"
               data-find="{{ n.nominee }} nomination {{ n.status }} {{ n.reference|default('') }}">
            {{ ui.avatar(n.nominee, 40) }}
            {{ ui.cell(n.nominee, meta) }}
            <span class="ag-cell--d ag-cell__p">{{ meta }}</span>
            <span>{{ ui.pill(st.label, st.tone) }}</span>
            <span class="ag-cell--d me-go">{{ st.group == 'needs' ? 'Fix' : '' }}</span>
          </div>
          {% endfor %}
          <div id="meNomsNone" hidden>{{ ui.empty('Nothing in that filter', '') }}</div>
        </div>
        {% endif %}

        {% if my_votes|length %}
        <section class="ag-group" aria-labelledby="h-votes">
          <h2 id="h-votes">Votes you cast</h2>
          <div class="ag-list">
            {% for v in my_votes %}
              {{ ui.row({
                icon: 'vote', tone: 'green', label: v.nominee,
                sub: v.category ~ (v.voted_at ? ' · ' ~ v.voted_at|when : ''),
                find: v.nominee ~ ' ' ~ v.category ~ ' vote'
              }) }}
            {% endfor %}
          </div>
        </section>
        {% endif %}

        {% if my_nominations is empty and my_votes is empty %}
        <div class="ag-card">
          {{ ui.empty('Nothing yet',
             'Your votes and the people you put forward show up here, with what each one is waiting on.',
             'Nominate someone', '/nominate') }}
        </div>
        {% endif %}
      </section>

      {# ══ SAVED ═════════════════════════════════════════════════════════════ #}
      <section class="me-sec" id="me-saved" aria-labelledby="me-saved-h">
        {{ ui.head('Saved', leads.saved, 'me-saved-h') }}
        <p class="ag-lead">{{ leads.saved }}</p>

        {% if bookmarks|length %}
        <div class="me-saved">
          {% for bm in bookmarks %}
          <a class="me-saved__i" href="/community/{{ bm.slug }}" data-find="{{ bm.title }} saved thread">
            <span class="me-saved__img" aria-hidden="true"></span>
            <span class="me-saved__b">
              <b>{{ bm.title }}</b>
              <span>{{ bm.reply_count }} repl{{ bm.reply_count == 1 ? 'y' : 'ies' }} · {{ bm.cheer_count }} cheer{{ bm.cheer_count == 1 ? '' : 's' }}</span>
            </span>
          </a>
          {% endfor %}
        </div>
        {% endif %}
      </section>

      {# ══ SECURITY ══════════════════════════════════════════════════════════ #}
      <section class="me-sec" id="me-security" aria-labelledby="me-sec-h">
        {{ ui.head('Security', leads.security, 'me-sec-h') }}

        <div class="me-set">
          <section class="ag-group">
            <h2>Signing in</h2>
            <div class="ag-list">
              {{ ui.row({label: 'Email',
                 pill: {label: user.email_verified ? 'Verified' : 'Not verified',
                        tone: user.email_verified ? 'ok' : 'warn'}}) }}
              {{ ui.row({label: 'Phone number', value: user.phone|default('Not added')}) }}
              {{ ui.row({label: 'Passkeys', value: (passkeys|default([]))|length ~ ' saved'}) }}
            </div>
            {# Revealed only when this browser can actually run the ceremony, and
               EVERY outcome is shown: a cancelled prompt rejects a promise, and a
               page that catches and drops it is a button that does nothing — the
               shape of the camera and autoplay faults this codebase has paid for. #}
            {% if passkeys_available %}
            <div id="meKeyAdd" hidden>
              <button type="button" class="ag-btn ag-btn--secondary ag-btn--sm" id="meKeyBtn">Add a passkey</button>
              <p id="meKeyNote" class="ag-hint" hidden></p>
            </div>
            {% endif %}
          </section>

          {% if passkeys|default([])|length %}
          <section class="ag-group">
            <h2>Passkeys on this account</h2>
            <div class="ag-list">
              {% for k in passkeys %}
              <span class="ag-list__row">
                <span class="ag-list__b">
                  <span class="ag-list__label">{{ k.label }}</span>
                  <span class="ag-list__sub">Added {{ k.created_at ? k.created_at|when : 'recently' }}{% if k.last_used_at %} · last used {{ k.last_used_at|when }}{% else %} · not used yet{% endif %}</span>
                </span>
                <form method="post" action="/account/passkey/{{ k.id }}/delete" data-confirm="Remove this passkey?">
                  <input type="hidden" name="_token" value="{{ csrf_token }}">
                  <button class="ag-btn ag-btn--secondary ag-btn--sm" type="submit">Remove</button>
                </form>
              </span>
              {% endfor %}
            </div>
          </section>
          {% endif %}
        </div>
      </section>

      {# ══ SETTINGS ══════════════════════════════════════════════════════════ #}
      <section class="me-sec" id="me-settings" aria-labelledby="me-set-h">
        {{ ui.head('Settings', leads.settings, 'me-set-h') }}

        <div class="me-set">
          {% for g in [
            {'t':'You','rows':[
              {'l':'Personal details','v':user.name,'to':'/account/profile'},
              {'l':'Email','v':user.email,'to':'/account/profile'},
              {'l':'Member since','v':(member_since ? member_since|date('F Y') : '—'),'to':null}
            ]},
            {'t':'Preferences','rows':[
              {'l':'Display & reading','v':'Standard','to':'/display'},
              {'l':'Language','v':'English','to':'/display'}
            ]},
            {'t':'Privacy','rows':[
              {'l':'Cookie settings','v':'','to':'/cookies'},
              {'l':'How we use your data','v':'','to':'/privacy'}
            ]}
          ] %}
          <section class="ag-group">
            <h2>{{ g.t }}</h2>
            <div class="ag-list">
              {% for r in g.rows %}
                {{ ui.row({label: r.l, value: r.v, href: r.to}) }}
              {% endfor %}
            </div>
          </section>
          {% endfor %}
        </div>

        <a class="ag-btn ag-btn--danger" href="/account/logout">Sign out</a>
      </section>

    </div>
  </div>
</div>

{{ viz.assets(csp_nonce) }}
<script nonce="{{ csp_nonce }}" src="{{ asset('/assets/js/account.js') }}" defer></script>
{% if backed_winners|default([])|length %}{% include 'partials/celebrate.twig' only %}{% endif %}
{% if passkeys_available %}<script nonce="{{ csp_nonce }}" src="{{ asset('/assets/js/passkeys.js') }}" defer></script>{% endif %}
{% endblock %}
