{#
  The eye: hides every figure on a wallet page. wallet.js binds every [data-wl-eye], so the
  phone's app-bar icon and the desktop's pill are one control in two places. Hidden until
  the script runs, because without it the button would do nothing.
  `pill` draws the labelled desktop pill; otherwise an icon button.
#}
<button type="button" class="{{ pill|default(false) ? 'wl-eyepill' : 'ag-appbar__icon wl-eyeico' }}" data-wl-eye aria-pressed="false" hidden>
  <svg class="wl-eye__on" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><path d="M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6z"/></svg>
  <svg class="wl-eye__off" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3l18 18M10.6 5.1A10 10 0 0 1 12 5c6.4 0 10 7 10 7a17 17 0 0 1-3.2 4M6.6 6.6A17 17 0 0 0 2 12s3.6 7 10 7a9.6 9.6 0 0 0 5.4-1.6M9.9 9.9a3 3 0 0 0 4.2 4.2"/></svg>
  <span class="{{ pill|default(false) ? 'wl-eyepill__l' : 'ag-sr' }}" data-wl-eye-l>{{ 'Hide balance'|trans }}</span>
</button>
