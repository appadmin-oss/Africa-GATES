{% extends 'pages/account/_frame.twig' %}
{#
  NOTIFICATIONS — /account/notifications · Phase 8 (no DC; built on the shell, base list rows)

  What happened to this member's things while they were away, from AlertService — DERIVED
  on read from the tables that already record each event, so an alert cannot outlive what
  it is about. Grouped ("Amaka and 42 others cheered your post"). The unread state is a WORD
  ("New"), never the dot alone. "Mark all as read" is a plain form that posts; the Pulse
  bell reads the same watermark, so the two cannot disagree.
#}
{% set acc_tab = 'activity' %}
{% set colour_tier = '1' %}
{% block acc_body %}
  <div class="acc__top">
    <h2 class="acc__h2">{{ 'Notifications'|trans }}</h2>
    {% if unread %}
      <form method="post" action="/account/notifications/read">
        <input type="hidden" name="_token" value="{{ csrf_token }}">
        <button class="ag-btn ag-btn--secondary ag-btn--pill" type="submit">{{ 'Mark all as read'|trans }}</button>
      </form>
    {% endif %}
  </div>
  {% if items|length %}
    <div class="ag-list">
      {% for a in items %}
        <a class="ag-list__row acc__alert{{ a.unread ? ' acc__alert--new' }}" href="{{ a.href }}">
          <span class="ag-list__b">
            <span class="ag-list__label acc__wrap">{{ a.text }}</span>
            <span class="ag-list__sub"><time datetime="{{ a.at|date('c') }}">{{ a.at|date('j M Y, H:i') }}</time></span>
          </span>
          {% if a.unread %}<span class="acc__new">{{ 'New'|trans }}</span>{% endif %}
          <span class="ag-list__chev" aria-hidden="true"><svg class="ag-ico-dir" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"></path></svg></span>
        </a>
      {% endfor %}
    </div>
  {% else %}
    <div class="ag-empty acc__empty">
      <p class="ag-empty__t">{{ 'Nothing yet.'|trans }}</p>
      <p>{{ 'When people cheer, reply to or follow what you post, it shows up here.'|trans }}</p>
      <a class="ag-btn ag-btn--secondary ag-btn--pill" href="/pulse">{{ 'Go to Pulse'|trans }}</a>
    </div>
  {% endif %}
  {% if my_nominations|length %}
    <section class="acc__sec" aria-labelledby="acc-nom-h">
      <h2 class="acc__h2" id="acc-nom-h">{{ 'Your nominations'|trans }}</h2>
      <ul class="ag-list acc__plain">
        {% for n in my_nominations %}
          <li class="ag-list__row"><span class="ag-list__b"><span class="ag-list__label">{{ n.nominee }}</span><span class="ag-list__sub">{{ n.created_at|date('j M Y') }}{% if n.reference %} · <span class="acc__ref">{{ n.reference }}</span>{% endif %}</span></span><span class="ag-list__value">{{ n.status|replace({'_': ' '})|trans }}</span></li>
        {% endfor %}
      </ul>
    </section>
  {% endif %}

  {% if my_votes|length %}
    <section class="acc__sec" aria-labelledby="acc-vote-h">
      <h2 class="acc__h2" id="acc-vote-h">{{ 'Your votes'|trans }}</h2>
      <ul class="ag-list acc__plain">
        {% for v in my_votes %}
          <li class="ag-list__row"><span class="ag-list__b"><span class="ag-list__label">{{ v.nominee }}</span><span class="ag-list__sub">{{ v.category }}</span></span><span class="ag-list__value">{{ v.voted_at|date('j M Y') }}</span></li>
        {% endfor %}
      </ul>
    </section>
  {% endif %}

  {% if my_links|length %}
    <section class="acc__sec" aria-labelledby="acc-links-h">
      <h2 class="acc__h2" id="acc-links-h">{{ 'Links you shared'|trans }}</h2>
      <ul class="ag-list acc__plain">
        {% for l in my_links %}
          <li class="ag-list__row"><span class="ag-list__b"><span class="ag-list__label">{{ l.nominee }}</span><span class="ag-list__sub">{{ l.expired ? 'Expired'|trans : ('Open until %d%'|trans({'%d%': l.expires_at|date('j M Y')})) }}</span></span><span class="ag-list__value">{{ l.hits == 1 ? '1 visit'|trans : '%n% visits'|trans({'%n%': l.hits}) }}</span></li>
        {% endfor %}
      </ul>
    </section>
  {% endif %}

{% endblock %}
