{% extends 'layout/shell.twig' %}
{#
  /advertise — PLACES, PRICES AND RULES, BEFORE ANYBODY SIGNS UP (Services\Ads)

  The shape of every self-serve ad platform's front page (Meta for Business, LinkedIn, Reddit):
  what you get, an example of the format, how it works, the prices, and the rules, with the
  one action repeated. The example is the real card (partials/ad-slot.twig, preview mode), so
  what an advertiser is shown here is exactly what will run. The places and their prices are
  the market's (AdMarket); a place with no price says so rather than show one nobody set.
#}
{# Tier 2, transactional: it asks for something (a campaign, a fix, a review). #}
{% set colour_tier = '2' %}

{% block head_styles %}<link rel="stylesheet" href="{{ asset('/assets/css/components/ads.css') }}"><link rel="stylesheet" href="{{ asset('/assets/css/components/ad-slot.css') }}">{% endblock %}

{% block content %}
<div class="am">
  <section class="am-hero">
    <div class="am-hero__words">
      <span class="am-beta">{{ 'Beta'|trans }}</span>
      <h1 class="am-h1">{{ 'Advertise on Africa GATES'|trans }}</h1>
      <p class="am-lead">{{ 'Put your business, product or event in front of the people who come here to celebrate, vote and attend.'|trans }}</p>
      {#- One main action, and the second answers the question every first advertiser has:
          "what will it cost to reach people?" (the planner below). -#}
      <div class="am-hero__acts">
        <a class="ag-btn ag-btn--primary ag-btn--pill" href="/account/ads/new">{{ 'Start your free trial'|trans }}</a>
        <a class="ag-btn ag-btn--secondary ag-btn--pill" href="#plan">{{ 'Plan a campaign'|trans }}</a>
      </div>
      <p class="am-note">{{ 'Free trial: up to %v% views over %d% days. No card needed.'|trans({'%v%': trial.views|number_format, '%d%': trial.days}) }}</p>
    </div>
    <figure class="am-hero__ex">
      {% include 'partials/ad-slot.twig' with {ad: sample, preview: true} only %}
      <figcaption class="am-note">{{ 'An example of how your ad looks.'|trans }}</figcaption>
    </figure>
  </section>

  {#
    THE SITE IN NUMBERS, MEASURED (AdMarket::reach). An advertiser's first question is "who
    will see it", and every "advertise with us" page that converts answers it with figures.
    Only figures this platform has measured are printed; with none yet, the band says what
    the trial costs instead of inventing an audience.
  #}
  <section class="am-figs" aria-label="{{ 'Africa GATES in numbers'|trans }}">
    {% if reach.daily %}<div class="am-fig"><b>{{ reach.daily|number_format }}</b><span>{{ 'ads seen a day, across the site'|trans }}</span></div>{% endif %}
    {% if reach.ctr_pct %}<div class="am-fig"><b>{{ reach.ctr_pct }}%</b><span>{{ 'of people who see an ad here tap it'|trans }}</span></div>{% endif %}
    <div class="am-fig"><b>{{ reach.places }}</b><span>{{ 'places your ad can run, from the homepage to event pages'|trans }}</span></div>
    <div class="am-fig"><b>{{ trial.views|number_format }}</b><span>{{ 'views free on your first campaign'|trans }}</span></div>
  </section>

  <section class="am-sec" aria-labelledby="adv-how">
    <h2 class="am-h2" id="adv-how">{{ 'How it works'|trans }}</h2>
    <ol class="am-steps">
      <li><b>{{ 'Make your ad'|trans }}</b><span>{{ 'A square image, a line of text, a headline and a button.'|trans }}</span></li>
      <li><b>{{ 'Choose where it runs'|trans }}</b><span>{{ 'One place or all of them.'|trans }}</span></li>
      <li><b>{{ 'A person checks it'|trans }}</b><span>{{ 'Then it runs, labelled Sponsored.'|trans }}</span></li>
      <li><b>{{ 'See what it did'|trans }}</b><span>{{ 'Views and clicks, every day, in your Ads Manager.'|trans }}</span></li>
    </ol>
  </section>

  {#
    PLACES AND PRICES, BY WHAT EACH ONE DELIVERS (AdMarket::card). Ordered by what people do
    with an ad there, so the place most likely to reach somebody is read first. Every figure
    is measured or says it is not: a tier is "New" until the place has enough views to
    measure, and its price is then exactly the starting rate.
  #}
  <section class="am-sec" aria-labelledby="adv-rates">
    <h2 class="am-h2" id="adv-rates">{{ 'Places and prices'|trans }}</h2>
    <ul class="am-places">
      {% for c in market %}
      <li class="am-place">
        <div class="am-place__top">
          <b class="am-place__n">{{ c.label|trans }}</b>
          <span class="am-tier am-tier--{{ c.tier }}">{{ c.tier_label|trans }}</span>
        </div>
        <p class="am-place__w">{{ c.where|trans }} · {{ c.who|trans }}</p>
        <p class="am-place__p">
          {% if c.paid_only %}<span class="am-rates__s">{{ 'Paid campaigns only — the free trial runs on the other places.'|trans }}</span> {% endif %}
          {% if c.price %}<b>₦{{ c.price|number_format }}</b> {{ 'per 1,000 views today'|trans }}{% if c.per_visit_kobo %} · {{ 'about %v% a visit'|trans({'%v%': '₦' ~ (c.per_visit_kobo / 100)|number_format(c.per_visit_kobo < 10000 ? 2 : 0)}) }}{% endif %}
          {% else %}{{ c.paid_only ? 'Not on sale yet'|trans : 'Free trial only for now'|trans }}{% endif %}
        </p>
        <p class="am-place__s">
          {% if c.price or c.measured %}{{ c.tier_note|trans }}{% endif %}
          {% if c.measured %}{{ '%r% of people who see an ad here tap it.'|trans({'%r%': c.ctr_pct ~ '%'}) }}{% endif %}
          {% if c.daily %}{{ 'About %n% views a day.'|trans({'%n%': c.daily|number_format}) }}{% endif %}
        </p>
      </li>
      {% endfor %}
    </ul>
    <p class="am-note">
      {% if pricing.dynamic %}
        {{ 'Prices are set each day. A place where people act on ads more costs more, and one that is nearly booked for the next %h% days costs more than one with room — never below %f%% or above %c%% of its starting rate.'|trans({'%h%': pricing.horizon, '%f%': pricing.floor, '%c%': pricing.ceil}) }}
      {% endif %}
      {{ 'Everyone booking on the same day pays the same price, and your campaign keeps the price it was booked at. You pay only for views delivered, and what a campaign does not spend goes back to you.'|trans }}
    </p>
  </section>

  {#
    THE PLANNER (AdPlanner): a result in, a plan out. A GET form, so it works with no script
    and a plan has an address. It fills the goal from the place that gets a result for the
    least money first, and says when the site cannot deliver it in the time asked.
  #}
  <section class="am-sec" aria-labelledby="adv-plan" id="plan">
    <h2 class="am-h2" id="adv-plan">{{ 'Plan for a result'|trans }}</h2>
    <form class="am-plan" method="get" action="/advertise#plan">
      <div class="am-field">
        <label class="ag-label" for="pl-goal">{{ 'What you want'|trans }}</label>
        <select class="am-input" id="pl-goal" name="goal">
          {% for k, label in goals %}<option value="{{ k }}"{% if plan_in.goal == k %} selected{% endif %}>{{ label|trans }}</option>{% endfor %}
        </select>
      </div>
      <div class="am-field">
        <label class="ag-label" for="pl-n">{{ 'How many'|trans }}</label>
        <input class="am-input" id="pl-n" name="n" type="number" min="1" max="10000000" inputmode="numeric" required value="{{ plan_in.n }}" enterkeyhint="go">
      </div>
      <div class="am-field">
        <label class="ag-label" for="pl-days">{{ 'Over how many days'|trans }}</label>
        <input class="am-input" id="pl-days" name="days" type="number" min="1" max="{{ max_days }}" inputmode="numeric" value="{{ plan_in.days }}">
      </div>
      <button class="ag-btn ag-btn--primary ag-btn--pill" type="submit">{{ 'Work it out'|trans }}</button>
    </form>
    {% if plan %}
      {% if plan.rows %}
      <table class="am-rates am-plan__t">
        <thead><tr><th scope="col">{{ 'Place'|trans }}</th><th scope="col">{{ 'Views'|trans }}</th><th scope="col">{{ plan.goal == 'views' ? 'Views'|trans : 'Visits'|trans }}</th><th scope="col">{{ 'Cost'|trans }}</th></tr></thead>
        <tbody>
          {% for r in plan.rows %}
          <tr><th scope="row">{{ r.label|trans }}</th><td>{{ r.views|number_format }}</td><td>{{ r.results|number_format }}</td><td>₦{{ (r.cost_kobo / 100)|number_format }}</td></tr>
          {% endfor %}
        </tbody>
      </table>
      <p class="am-est">
        {% if plan.feasible %}
          {{ 'About %r% %g% for about %c%, over %d% days.'|trans({'%r%': plan.results|number_format, '%g%': (plan.goal == 'views' ? 'views' : 'visits')|trans, '%c%': '₦' ~ (plan.cost_kobo / 100)|number_format, '%d%': plan.days}) }}
        {% else %}
          {{ 'The places on sale can deliver about %r% of the %t% you asked for in %d% days.'|trans({'%r%': plan.results|number_format, '%t%': plan.target|number_format, '%d%': plan.days}) }}
          {% if plan.days_needed %}{{ 'Over %n% days it would reach it.'|trans({'%n%': plan.days_needed}) }}{% endif %}
        {% endif %}
        {% if plan.assumed %}{{ 'Some places are too new to measure, so their visits assume %a% of viewers tap.'|trans({'%a%': pricing.assumed_ctr ~ '%'}) }}{% endif %}
        {% if plan.unknown_supply %}{{ 'How many views a new place can deliver is not known yet.'|trans }}{% endif %}
      </p>
      {% else %}
      <p class="am-est">{{ 'No place is on sale yet, so there is nothing to plan with. The free trial runs everywhere.'|trans }}</p>
      {% endif %}
    {% endif %}
  </section>

  {#
    THE QUESTIONS A FIRST ADVERTISER ASKS, answered with the rules' own figures (`facts`,
    read from AdCheckout and AdRules), so an answer here cannot outlive the rule it states.
  #}
  <section class="am-sec" aria-labelledby="adv-faq">
    <h2 class="am-h2" id="adv-faq">{{ 'Questions advertisers ask'|trans }}</h2>
    <div class="am-faq">
      <details><summary>{{ 'What does it cost?'|trans }}</summary>
        <p>{{ 'You choose a budget from ₦%m% and how many days it runs. You pay only for views delivered, at the day’s price for each place.'|trans({'%m%': facts.min_budget|number_format}) }}{% if facts.vat_pct > 0 %} {{ 'VAT at %v%% is added at checkout, as its own line on the receipt.'|trans({'%v%': facts.vat_pct}) }}{% endif %}</p></details>
      <details><summary>{{ 'What if my budget is not all spent?'|trans }}</summary>
        <p>{{ 'What a campaign does not spend goes back to the card or account you paid with, with its VAT, when it ends or you cancel it.'|trans }}</p></details>
      <details><summary>{{ 'How soon does it start?'|trans }}</summary>
        <p>{{ 'A person checks every ad first. It starts when it is both paid for and approved, and runs the days you bought from then, up to %d% days.'|trans({'%d%': facts.max_days}) }}</p></details>
      <details><summary>{{ 'I sell on WhatsApp, not a website. Can I still advertise?'|trans }}</summary>
        <p>{{ 'Yes. Choose the Chat on WhatsApp button and give your number: a tap opens a chat with you, with “%g%” typed in, so you know where the customer came from.'|trans({'%g%': facts.wa_greeting}) }}</p></details>
      <details><summary>{{ 'Can I run a video, or a picture that is not square?'|trans }}</summary>
        <p>{{ 'Yes. Choose square, upright (4:5, which fills more of a phone) or wide (16:9). Add a video of up to %s% seconds: it plays by itself without sound as people scroll past, and they can turn the sound on or pause it. Your picture shows first, and stays the ad for anyone on a data saver.'|trans({'%s%': facts.video_max}) }}</p></details>
      <details><summary>{{ 'How will I know if my ad is any good?'|trans }}</summary>
        <p>{{ 'As you write it, the builder scores it and says what would make it stronger, and shows what your budget should reach before you pay. Once it runs, your campaign page shows its results by day and by place, whether it is spending on pace, and what to try next.'|trans }}</p></details>
      <details><summary>{{ 'Will the same people see it again and again?'|trans }}</summary>
        <p>{{ 'One person sees the same ad at most %n% times a day, so your budget reaches more people instead of the same few.'|trans({'%n%': facts.freq}) }}</p></details>
      <details><summary>{{ 'What can I not advertise?'|trans }}</summary>
        <p>{% for s in facts.standards %}{{ s[0]|trans }}{% if not loop.last %} · {% endif %}{% endfor %}. <a class="am-link" href="/legal/advertising">{{ 'The full policy'|trans }}</a></p></details>
      <details><summary>{{ 'I am a nominee. Can I advertise?'|trans }}</summary>
        <p>{{ 'Yes, for your business, never your nomination. While your award is open, your ads stay off the vote page and the homepage.'|trans }}</p></details>
    </div>
  </section>

  <section class="am-sec" aria-labelledby="adv-trust">
    <h2 class="am-h2" id="adv-trust">{{ 'Why people trust the ads here'|trans }}</h2>
    <ul class="am-points">
      <li><b>{{ 'Checked by a person'|trans }}</b><span>{{ 'Every ad, before it runs.'|trans }}</span></li>
      <li><b>{{ 'Always labelled'|trans }}</b><span>{{ 'Sponsored, with who paid for it.'|trans }}</span></li>
      <li><b>{{ 'Nothing about the reader'|trans }}</b><span>{{ 'Ads are chosen by the page, never by what someone did.'|trans }}</span></li>
      <li><b>{{ 'Counted honestly'|trans }}</b><span>{{ 'A view is half the ad on screen for a second. Bots are not counted.'|trans }}</span></li>
      <li><b>{{ 'Never beside a vote'|trans }}</b><span>{{ 'No ad on a ballot, a nominee or a result.'|trans }}</span></li>
      <li><b>{{ 'Open to see'|trans }}</b><span>{{ 'Every running ad is in the public ad library.'|trans }}</span></li>
    </ul>
    <p class="am-note"><a class="am-link" href="/advertise/library">{{ 'See the ad library'|trans }}</a> · <a class="am-link" href="/legal/advertising">{{ 'Advertising policy'|trans }}</a></p>
  </section>

  <section class="am-cta">
    <h2 class="am-h2">{{ 'Try it free'|trans }}</h2>
    <p class="am-p">{{ 'One trial per account. A person checks your ad, then it runs for %d% days.'|trans({'%d%': trial.days}) }}</p>
    <a class="ag-btn ag-btn--primary ag-btn--pill" href="/account/ads/new">{{ 'Start your free trial'|trans }}</a>
  </section>
</div>
{% endblock %}
