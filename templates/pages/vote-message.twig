{% extends "layout/gates.twig" %}

{# ── ONE MESSAGE, ON ITS OWN PAGE ─────────────────────────────────────────────

   This page exists because of what a link preview does. A supporter who shares
   their message as a link to the ballot gets the ballot's card — "Vote for X" —
   the same card fifty other supporters get, with their own words nowhere in it.
   Here the words ARE the page, so the card carries them.

   And because the words are the page, the page has to earn the tap that follows:
   the CTA below the quote is the ballot, and the other messages under it are the
   argument for adding one.

   Rendered from data prepared by VoteMessageService::byToken(), which resolves the
   display name against the voter's consent BEFORE it reaches here — a template
   with the real name in scope is one edit away from printing it. #}

{% block head_styles %}
<style nonce="{{ csp_nonce }}">
  .vm{ max-width:720px; margin:0 auto; padding:44px 20px 72px; }
  .vm__kicker{ display:inline-flex; align-items:center; gap:7px; font-size:11.5px; font-weight:700; letter-spacing:.09em; text-transform:uppercase; color:#237b22; background:#e8f3e7; border-radius:999px; padding:6px 13px; }
  .vm__card{ margin-top:18px; background:#fff; border:1px solid rgba(16,41,44,.1); border-radius:20px; padding:32px 30px; box-shadow:0 1px 2px rgba(16,41,44,.04), 0 14px 40px -28px rgba(16,41,44,.3); }
  .vm__quote{ margin:0; font-size:clamp(1.28rem, 1.05rem + 1vw, 1.7rem); line-height:1.5; font-weight:500; color:#10292C; letter-spacing:-.01em; }
  .vm__quote::before{ content:'“'; color:#7FC87C; font-size:1.4em; line-height:0; vertical-align:-.28em; margin-right:2px; }
  .vm__quote::after{ content:'”'; color:#7FC87C; font-size:1.4em; line-height:0; vertical-align:-.28em; margin-left:1px; }
  .vm__by{ margin:22px 0 0; display:flex; align-items:center; gap:12px; }
  .vm__ava{ width:42px; height:42px; border-radius:50%; object-fit:cover; background:#e8ece8; flex:none; }
  .vm__by-t{ font-size:14px; line-height:1.45; color:#3d5254; }
  .vm__by-t strong{ color:#10292C; }
  .vm__actions{ margin-top:26px; padding-top:22px; border-top:1px solid rgba(16,41,44,.09); display:flex; flex-direction:column; gap:16px; }
  .vm__cheer{ display:inline-flex; align-items:center; gap:8px; align-self:flex-start; border:1px solid rgba(16,41,44,.16); background:#fff; color:#10292C; border-radius:999px; padding:9px 15px; font:600 13.5px/1 inherit; cursor:pointer; }
  .vm__cheer:hover{ border-color:#237b22; color:#237b22; }
  .vm__cheer[data-on="1"]{ background:#e8f3e7; border-color:#7FC87C; color:#1a6118; }
  /* 40px of hit area, same reason as .vmi__act: it was 23px tall, next to a control
     that does something entirely different, on a page people reach from a chat app. */
  .vm__report{ background:none; border:none; padding:4px 6px; min-height:40px; display:inline-flex;
               align-items:center; font:500 12.5px/1.4 inherit; color:var(--ag-ink-soft,#626a6e); cursor:pointer; }
  .vm__report:hover{ color:#b3261e; text-decoration:underline; }
  .vm__reported{ font-size:12.5px; color:var(--ag-ink-soft,#626a6e); min-height:40px; display:inline-flex; align-items:center; }
  .vm__cta{ margin-top:26px; background:#10292C; border-radius:18px; padding:26px 28px; color:#eef3ee; }
  .vm__cta h2{ margin:0 0 8px; font-size:1.12rem; color:#fff; letter-spacing:-.01em; }
  .vm__cta p{ margin:0 0 18px; font-size:14px; line-height:1.7; color:#b9c9bd; }
  .vm__cta a.vm__go{ display:inline-block; background:#7FC87C; color:#0b1f21; font-weight:700; font-size:14.5px; padding:12px 24px; border-radius:999px; text-decoration:none; }
  .vm__cta a.vm__go:hover{ background:#9ad897; }
  .vm__more{ margin-top:44px; }
  .vm__more h2{ font-size:1.02rem; margin:0 0 4px; letter-spacing:-.01em; }
  .vm__more p.vm__more-sub{ margin:0 0 18px; font-size:13px; color:#5a6d6f; }
  /* The item styles live in partials/vote-message-assets.twig, beside the markup. */
  .vm__legal{ margin-top:30px; font-size:12px; line-height:1.7; color:#7b8b8c; }
  .vm__legal a{ color:#5f7273; }
</style>
{% endblock %}

{% block content %}
<div class="vm">

  <span class="vm__kicker">
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2Z"/></svg>
    A message of support
  </span>

  <article class="vm__card">
    <blockquote class="vm__quote">{{ msg.body }}</blockquote>
    <div class="vm__by">
      {# media_url, not the raw column: the same filter every other page uses to turn a
         stored path into a served, size-variant URL. #}
      {% if msg.nominee_photo %}<img class="vm__ava" src="{{ msg.nominee_photo|media_url('avatar') }}" alt="" width="42" height="42" loading="lazy">{% endif %}
      <p class="vm__by-t">
        <strong>{{ msg.name }}</strong> on <strong>{{ msg.nominee_name }}</strong>
        {% if msg.when %}<br><span style="color:var(--ag-ink-soft,#626a6e)">{{ msg.when|date('j F Y') }}</span>{% endif %}
      </p>
    </div>

    {# vmItem, the same component the wall items use — one implementation of "cheer"
       and "report" on the platform, defined in partials/vote-message-assets.twig. #}
    <div class="vm__actions" x-data="vmItem('{{ msg.token|e('js') }}', {{ msg.cheers|default(0) }})">
      <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap">
        <button type="button" class="vm__cheer" :data-on="mine ? '1' : '0'" @click="cheer()" :disabled="busy">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3ZM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"/></svg>
          <span x-text="n > 0 ? (mine ? 'You and ' + (n - 1) + ' others' : n + (n === 1 ? ' cheer' : ' cheers')) : 'Cheer this'">Cheer this</span>
        </button>
        {# One tap, no form. A reason field is another screen between noticing something
           about a real person and saying so, and the moderator reads the message either
           way. Anyone can use it — see VoteMessageController::report(). #}
        <button type="button" class="vm__report" @click="report()" x-show="!reported" x-cloak>Report this message</button>
        <span class="vm__reported" x-show="reported" x-cloak>Reported — thank you. A moderator will look at it.</span>
      </div>
      {# The same share row the whole platform uses. The text is the message itself,
         because that is what the reader is passing on. #}
      {% include 'partials/share.twig' with {
        share_url: share_url,
        share_text: '“' ~ msg.body ~ '” — supporting ' ~ msg.nominee_name ~ ' at Africa GATES',
        share_label: 'Pass it on'
      } only %}
    </div>
  </article>

  {% if ballot_url %}
  <div class="vm__cta">
    <h2>Back {{ msg.nominee_name }} too</h2>
    <p>One verified vote per category, and you can leave your own message when you cast it. Community votes are part of the score — the independent jury is the rest. <a href="/philosophy" style="color:#9ad897;font-weight:600">Why voting works this way</a>.</p>
    <a class="vm__go" href="{{ ballot_url }}">Vote for {{ msg.nominee_name }} →</a>
  </div>
  {% endif %}

  {% if wall %}
  <section class="vm__more">
    <h2>What others are saying</h2>
    <p class="vm__more-sub">{{ wall_total }} {{ wall_total == 1 ? 'message' : 'messages' }} for {{ msg.nominee_name }}.</p>
    {# The same item partial the ballot and the full messages page use, so a reader who
       arrives here from Facebook gets the same cheer and report controls they would
       anywhere else on the platform. #}
    <ul class="vmi-list">
      {% for m in wall %}{% include 'partials/vote-message.twig' with { m: m } only %}{% endfor %}
    </ul>
    {% if wall_total > (wall|length + 1) and ballot_url %}
    <p style="margin:16px 0 0;font-size:13px">
      <a href="{{ ballot_url }}/messages" style="color:#237b22;font-weight:600;text-decoration:none">
        Read all {{ wall_total }} messages for {{ msg.nominee_name }} →
      </a>
    </p>
    {% endif %}
  </section>
  {% endif %}
  {% include 'partials/vote-message-assets.twig' %}

  <p class="vm__legal">
    Messages are written by voters, not by Africa GATES, and are checked before they appear.
    See something that should not be here? <a href="/support">Report it</a> — we act on reports about
    real people quickly. Read the <a href="/terms">terms</a> and the <a href="/privacy">privacy notice</a>.
  </p>
</div>
{% endblock %}
