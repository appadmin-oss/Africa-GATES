{% extends "layout/gates.twig" %}

{# ── EVERY MESSAGE FOR ONE NOMINEE ────────────────────────────────────────────

   The ballot shows the newest few and links here. This page exists rather than a
   "load more" button because everything past the first page would otherwise be
   invisible to crawlers and to any reader without JavaScript, the wall would need a
   second renderer that will drift from the first, and "all the messages about me" —
   which is a thing a nominee sends to their family — would have no URL.

   Server-paginated, one renderer (partials/vote-message.twig, the same one the ballot
   uses), and shareable. #}

{% block head_styles %}
<style nonce="{{ csp_nonce }}">
  .vms{ max-width:760px; margin:0 auto; padding:38px 20px 72px; }
  .vms__crumb{ font-size:12.5px; color:#5a6d6f; margin:0 0 14px; }
  .vms__crumb a{ color:#237b22; font-weight:600; text-decoration:none; }
  .vms__head{ display:flex; align-items:center; gap:16px; }
  .vms__ava{ width:56px; height:56px; border-radius:50%; object-fit:cover; background:#e8ece8; flex:none; }
  .vms__mono{ width:56px; height:56px; border-radius:50%; background:#237b22; color:#fff; flex:none;
              display:flex; align-items:center; justify-content:center; font:700 22px/1 inherit; }
  .vms__h{ margin:0; font-size:clamp(1.24rem, 1.05rem + .8vw, 1.7rem); letter-spacing:-.015em; color:#10292C; }
  .vms__sub{ margin:5px 0 0; font-size:13.5px; line-height:1.6; color:#5a6d6f; }
  .vms__note{ margin:22px 0 0; background:#f7faf7; border:1px solid #dfeade; border-radius:12px;
              padding:13px 15px; font-size:12.5px; line-height:1.7; color:#4a5f61; }
  .vms__note a{ color:#237b22; font-weight:600; }
  .vms__share{ margin:22px 0 0; padding-top:18px; border-top:1px solid rgba(16,41,44,.09); }
  .vms__empty{ margin:26px 0 0; text-align:center; padding:40px 24px; background:#f7faf7;
               border:1px dashed #cfe0cf; border-radius:16px; }
  .vms__empty p{ margin:0 0 16px; font-size:14.5px; line-height:1.7; color:#4a5f61; }
  .vms__cta{ display:inline-block; background:#10292C; color:#fff; font-weight:700; font-size:14.5px;
             padding:12px 26px; border-radius:999px; text-decoration:none; }
  .vms__cta:hover{ background:#1a3f43; }
  .vms__pager{ margin:28px 0 0; display:flex; align-items:center; justify-content:space-between; gap:14px;
               font-size:13.5px; }
  .vms__pager a{ color:#237b22; font-weight:600; text-decoration:none; }
  .vms__pager span{ color:#8a9a9c; }
</style>
{% endblock %}

{% block content %}
<div class="vms">

  <p class="vms__crumb"><a href="{{ ballot_url }}">← {{ nom.name }}’s ballot</a></p>

  <header class="vms__head">
    {% if nom.photo_path %}
      <img class="vms__ava" src="{{ nom.photo_path|media_url('avatar') }}" alt="" width="56" height="56">
    {% else %}
      <span class="vms__mono" aria-hidden="true">{{ nom.name|slice(0,1)|upper }}</span>
    {% endif %}
    <div>
      <h1 class="vms__h">Messages for {{ nom.name }}</h1>
      <p class="vms__sub">
        {% if total %}{{ total }} {{ total == 1 ? 'message' : 'messages' }} from verified voters{% else %}No messages yet{% endif %}
        · {{ nom.category }}
      </p>
    </div>
  </header>

  {% if messages|length %}
    <ul class="vmi-list">
      {% for m in messages %}{% include 'partials/vote-message.twig' with { m: m } only %}{% endfor %}
    </ul>

    {% if pages > 1 %}
    <nav class="vms__pager" aria-label="Pages of messages">
      {% if page > 1 %}<a href="?page={{ page - 1 }}" rel="prev">← Newer</a>{% else %}<span>← Newer</span>{% endif %}
      <span>Page {{ page }} of {{ pages }}</span>
      {% if page < pages %}<a href="?page={{ page + 1 }}" rel="next">Older →</a>{% else %}<span>Older →</span>{% endif %}
    </nav>
    {% endif %}

    <div class="vms__share">
      {% include 'partials/share.twig' with {
        share_url: share_url,
        share_text: 'What voters are saying about ' ~ nom.name ~ ' at Africa GATES:',
        share_label: 'Share this page'
      } only %}
    </div>
  {% else %}
    {# No empty-state scolding. The honest reading of zero messages is "nobody has been
       asked yet", not "nobody backed this nominee" — the feature is new and most votes
       predate it — so this is an invitation, not a verdict. #}
    <div class="vms__empty">
      <p>Nobody has written anything yet. If you have voted for {{ nom.name }}, or are about to,
         you can leave a message on the ballot — it is the part of a vote a person can keep.</p>
      <a class="vms__cta" href="{{ ballot_url }}">Go to the ballot →</a>
    </div>
  {% endif %}

  <p class="vms__note">
    Messages are written by voters, not by Africa GATES, and every one is checked before it appears.
    A name is shown only where its owner asked for it; everyone else appears as “A supporter”.
    Something here that should not be? Use <strong>Report</strong> on the message, or
    <a href="/support">contact us</a> — we act quickly on reports about real people.
  </p>

  {% include 'partials/vote-message-assets.twig' %}
</div>
{% endblock %}
