{% extends "layout/gates.twig" %}

{% block head_styles %}
<style>
  body[data-page="partner"]{ background:#eef0ec; color:var(--ag-ink); }
  .pt{ max-width:1100px; margin:0 auto; padding:24px var(--ag-gutter,32px) 60px; }

  /* hero */
  .pt-hero{ position:relative; overflow:hidden; border-radius:26px; background:radial-gradient(130% 130% at 80% 0%,#1d5b2a,#10292C 60%); padding:clamp(2.6rem,5vw,3.4rem) clamp(1.6rem,4vw,3rem); display:flex; align-items:center; gap:36px; }
  .pt-hero__orb{ position:absolute; right:-60px; bottom:-80px; width:340px; height:340px; border-radius:50%; background:radial-gradient(circle,rgba(212,154,14,.28),transparent 68%); }
  .pt-hero__in{ position:relative; flex:1; min-width:0; }
  .pt-badge{ display:inline-flex; align-items:center; gap:7px; font-size:11px; font-weight:700; letter-spacing:.1em; text-transform:uppercase; color:#ffd24a; background:rgba(8,26,16,.55); box-shadow:inset 0 0 0 1px rgba(212,154,14,.32); padding:7px 14px; border-radius:999px; }
  .pt-hero h1{ margin:18px 0 0; color:#fff; font-family:var(--ag-font-display); font-weight:800; font-size:clamp(2.1rem,5vw,2.9rem); line-height:1.03; letter-spacing:-.02em; }
  .pt-hero p{ margin:16px 0 0; font-size:16px; line-height:1.6; color:rgba(255,255,255,.84); max-width:480px; }
  .pt-hero__cta{ display:flex; gap:12px; margin-top:28px; flex-wrap:wrap; }
  .pt-btn{ cursor:pointer; text-decoration:none; font-family:inherit; font-weight:600; font-size:15px; padding:14px 26px; border-radius:999px; display:inline-flex; align-items:center; gap:8px; border:1px solid transparent; }
  .pt-btn--light{ background:#fff; color:#10292C; }
  .pt-btn--ghost{ background:none; border-color:rgba(255,255,255,.3); color:#fff; }
  .pt-btn--ghost:hover{ background:rgba(255,255,255,.1); }
  .pt-hero__card{ position:relative; flex:none; width:300px; align-self:stretch; background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.12); border-radius:20px; padding:26px; display:flex; flex-direction:column; justify-content:center; gap:14px; }
  .pt-hero__card svg{ color:var(--ag-green-light); }
  .pt-hero__card b{ color:#fff; font-family:var(--ag-font-display); font-size:17px; }
  .pt-hero__card small{ color:rgba(255,255,255,.7); font-size:12.5px; line-height:1.5; }

  /* real stat row */
  .pt-stats{ display:grid; grid-template-columns:repeat(4,1fr); gap:16px; margin-top:18px; }
  .pt-stat{ background:#fff; border:1px solid rgba(16,41,44,.08); border-radius:16px; padding:22px; text-align:center; }
  .pt-stat__n{ font-family:var(--ag-font-mono); font-weight:700; font-size:clamp(22px,3vw,30px); color:var(--ag-green); }
  .pt-stat__l{ font-size:12.5px; color:#626a6e; margin-top:4px; }

  /* section heads */
  .pt-sec{ margin-top:42px; }
  .pt-sec__h{ margin:0 0 4px; font-family:var(--ag-font-display); font-weight:700; font-size:clamp(1.5rem,3.4vw,1.65rem); color:var(--ag-ink); }
  .pt-sec__sub{ margin:0 0 20px; font-size:14px; color:#626a6e; }

  .pt-grid3{ display:grid; grid-template-columns:repeat(3,1fr); gap:16px; }
  .pt-card{ background:#fff; border:1px solid rgba(16,41,44,.08); border-radius:18px; padding:24px; }
  .pt-card__ic{ width:44px; height:44px; border-radius:13px; display:flex; align-items:center; justify-content:center; }
  .pt-card__t{ font-weight:600; font-size:16px; color:var(--ag-ink); margin-top:16px; }
  .pt-card__b{ margin:8px 0 0; font-size:13.5px; line-height:1.6; color:#626a6e; }

  /* steps */
  .pt-steps{ display:grid; grid-template-columns:repeat(4,1fr); background:#fff; border:1px solid rgba(16,41,44,.08); border-radius:20px; overflow:hidden; }
  .pt-step{ padding:24px; border-right:1px solid rgba(16,41,44,.06); }
  .pt-step:last-child{ border-right:0; }
  .pt-step__n{ width:30px; height:30px; border-radius:9px; background:var(--ag-ink); color:var(--ag-green-light); display:flex; align-items:center; justify-content:center; font-family:var(--ag-font-mono); font-weight:700; font-size:13px; }
  .pt-step__t{ font-weight:600; font-size:15px; color:var(--ag-ink); margin-top:14px; }
  .pt-step__b{ margin:6px 0 0; font-size:13px; line-height:1.55; color:#626a6e; }

  /* tiers */
  .pt-tiers{ display:grid; grid-template-columns:repeat(3,1fr); gap:16px; align-items:start; }
  .pt-tier{ background:#fff; border:1.5px solid rgba(16,41,44,.1); border-radius:20px; padding:26px; position:relative; }
  .pt-tier--feat{ border-color:var(--ag-green); box-shadow:0 18px 40px -26px rgba(35,123,34,.5); }
  .pt-tier__tag{ position:absolute; top:16px; right:16px; font-size:10px; font-weight:700; letter-spacing:.06em; text-transform:uppercase; padding:5px 11px; border-radius:999px; background:#ffd24a; color:#10292C; }
  .pt-tier__k{ font-size:12px; font-weight:600; letter-spacing:.08em; text-transform:uppercase; color:var(--ag-green); }
  .pt-tier__n{ font-family:var(--ag-font-display); font-weight:700; font-size:23px; color:var(--ag-ink); margin-top:6px; }
  .pt-tier__price{ margin-top:10px; font-family:var(--ag-font-mono); font-weight:700; font-size:20px; color:var(--ag-ink); }
  .pt-tier__price small{ font-family:var(--ag-font-body); font-weight:500; font-size:12.5px; color:#626a6e; }
  .pt-tier__rule{ height:1px; background:rgba(16,41,44,.08); margin:18px 0; }
  .pt-perks{ display:flex; flex-direction:column; gap:11px; }
  .pt-perk{ display:flex; align-items:flex-start; gap:9px; font-size:13.5px; line-height:1.45; color:#3a4448; }
  .pt-perk svg{ flex:none; color:var(--ag-green); margin-top:1px; }
  .pt-tier__btn{ display:block; width:100%; margin-top:22px; text-align:center; cursor:pointer; text-decoration:none; font-family:inherit; font-weight:600; font-size:14.5px; padding:13px; border-radius:999px; border:1px solid var(--ag-green); background:#fff; color:var(--ag-green); }
  .pt-tier--feat .pt-tier__btn{ background:var(--ag-green); color:#fff; border-color:var(--ag-green); }
  .pt-tier__btn:hover{ background:var(--ag-green); color:#fff; }

  /* enquiry */
  .pt-enq{ margin-top:44px; background:var(--ag-ink); border-radius:24px; padding:clamp(1.8rem,4vw,2.6rem); display:grid; grid-template-columns:1fr 1fr; gap:36px; align-items:center; position:relative; overflow:hidden; }
  .pt-enq__orb{ position:absolute; right:-50px; top:-50px; width:240px; height:240px; border-radius:50%; background:radial-gradient(circle,rgba(127,200,124,.18),transparent 68%); }
  .pt-enq__l{ position:relative; }
  .pt-enq__l h2{ margin:0; font-family:var(--ag-font-display); font-weight:700; font-size:clamp(1.5rem,3.4vw,1.75rem); color:#fff; }
  .pt-enq__l p{ margin:12px 0 0; font-size:15px; line-height:1.6; color:rgba(255,255,255,.8); }
  .pt-enq__mail{ display:inline-flex; align-items:center; gap:9px; margin-top:18px; color:rgba(255,255,255,.85); font-size:13.5px; text-decoration:none; }
  .pt-enq__mail svg{ color:var(--ag-green-light); }
  .pt-form{ position:relative; background:var(--ag-surface); border-radius:18px; padding:22px; }
  .pt-field{ margin-bottom:11px; }
  .pt-field input, .pt-field select, .pt-field textarea{ width:100%; border:1px solid rgba(16,41,44,.16); border-radius:11px; padding:12px 14px; font-family:inherit; font-size:14px; color:var(--ag-ink); outline:none; background:#fff; transition:border-color .12s; }
  .pt-field textarea{ min-height:76px; resize:vertical; line-height:1.5; }
  .pt-field input:focus, .pt-field select:focus, .pt-field textarea:focus{ border-color:var(--ag-green); }
  .pt-row{ display:flex; gap:11px; }
  .pt-row .pt-field{ flex:1; }
  .pt-submit{ width:100%; margin-top:6px; cursor:pointer; border:none; background:var(--ag-green); color:#fff; font-family:inherit; font-weight:600; font-size:15px; padding:14px; border-radius:999px; }
  .pt-submit:hover{ background:var(--ag-green-dark); }
  .pt-err{ font-size:13px; color:#b42318; background:#fdecec; border:1px solid rgba(180,35,24,.18); border-radius:11px; padding:10px 13px; margin-bottom:12px; }
  .pt-note{ margin-top:10px; font-size:11.5px; color:#5a6d6f; text-align:center; }

  @media (max-width:880px){
    .pt-hero{ flex-direction:column; align-items:stretch; }
    .pt-hero__card{ width:auto; }
    .pt-stats{ grid-template-columns:1fr 1fr; }
    .pt-grid3{ grid-template-columns:1fr; }
    .pt-steps{ grid-template-columns:1fr 1fr; }
    .pt-tiers{ grid-template-columns:1fr; }
    .pt-enq{ grid-template-columns:1fr; }
  }
  @media (max-width:460px){
    .pt-steps{ grid-template-columns:1fr; }
    .pt-step{ border-right:0; border-bottom:1px solid rgba(16,41,44,.06); }
    .pt-row{ flex-direction:column; gap:0; }
  }
</style>
{% endblock %}

{% block content %}
{% set BEN = [
  {'t':'A verified, prestige audience','b':'Reach the people and organisations being recognised across the continent — a community that is identity-verified, not bought.','tint':'#eef7ee','fg':'#1a6118','ico':'<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18 15 15 0 0 1 0-18Z"/>'},
  {'t':'Association with excellence','b':'Stand beside a transparent, independently-audited honour — prestige by association, earned not advertised.','tint':'#fff8df','fg':'#7a5600','ico':'<path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0V4ZM17 5h3v2a3 3 0 0 1-3 3M7 5H4v2a3 3 0 0 0 3 3"/>'},
  {'t':'Measurable social impact','b':'Your partnership funds child leadership programmes — and you receive impact reporting you can take to your board.','tint':'#fdeaf0','fg':'#b03a5b','ico':'<path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8Z"/>'}
] %}
{% set STEPS = [
  {'n':'1','t':'Introduction','b':'Tell us your goals through the form below; a partnerships lead reaches out.'},
  {'n':'2','t':'Tailored proposal','b':'We shape a package around your objectives, audience and budget.'},
  {'n':'3','t':'Agreement','b':'We align on scope, recognition and the impact you’ll fund.'},
  {'n':'4','t':'Launch','b':'Your partnership goes live across the cycle, with reporting throughout.'}
] %}
{% set TIERS = [
  {'k':'Entry','n':'Cultural Ally','feat':false,'perks':['Recognition within a programme','Logo on the partners wall','End-of-cycle impact summary']},
  {'k':'Most chosen','n':'Continental Patron','feat':true,'perks':['Category sponsorship & naming','Presence at the awards gala','Co-branded content moments','Quarterly impact reporting']},
  {'k':'Headline','n':'Title Sponsor','feat':false,'perks':['Headline cycle naming rights','Full-cycle presence & activation','Bespoke partnership build','Board-ready impact reporting']}
] %}
{% set TIER_NAMES = ['Cultural Ally','Continental Patron','Title Sponsor','Not sure yet'] %}

<div class="pt">

  {# ── Hero ── #}
  <div class="pt-hero">
    <div class="pt-hero__orb" aria-hidden="true"></div>
    <div class="pt-hero__in">
      <span class="pt-badge">Partnerships</span>
      <h1>Power the continent’s register of excellence</h1>
      <p>Stand beside Africa’s most recognised. Partner with Africa GATES to reach a verified, prestige audience — and fund child leadership while you do it.</p>
      <div class="pt-hero__cta">
        <a class="pt-btn pt-btn--light" href="#enquiry">Become a partner</a>
        <a class="pt-btn pt-btn--ghost" href="#how">How it works</a>
      </div>
    </div>
    <div class="pt-hero__card">
      <svg aria-hidden="true" focusable="false" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 4 5v6c0 5 3.4 9.7 8 11 4.6-1.3 8-6 8-11V5l-8-3Z"/><path d="m9 12 2 2 4-4"/></svg>
      <div><b>A partnership built to last</b><br><small>Lasting alliances, measurable impact, transparent reporting throughout the cycle.</small></div>
    </div>
  </div>

  {# ── Real reach stats (DB-derived; never fabricated) ── #}
  <div class="pt-stats">
    <div class="pt-stat"><div class="pt-stat__n">{{ stats.total_profiles|default(0)|number_format }}</div><div class="pt-stat__l">Verified profiles</div></div>
    <div class="pt-stat"><div class="pt-stat__n">{{ stats.total_votes|default(0)|number_format }}</div><div class="pt-stat__l">Votes cast</div></div>
    <div class="pt-stat"><div class="pt-stat__n">{{ stats.nations_live|default(0)|number_format }}</div><div class="pt-stat__l">Nation{{ stats.nations_live == 1 ? '' : 's' }} live</div></div>
    <div class="pt-stat"><div class="pt-stat__n">{{ stats.categories|default(0)|number_format }}</div><div class="pt-stat__l">Award categories</div></div>
  </div>

  {# ── Why partner ── #}
  <div class="pt-sec">
    <h2 class="pt-sec__h">Why partner with us</h2>
    <p class="pt-sec__sub">Prestige, reach, and measurable social impact — in one programme.</p>
    <div class="pt-grid3">
      {% for b in BEN %}
      <div class="pt-card">
        <span class="pt-card__ic" style="background:{{ b.tint }};color:{{ b.fg }}"><svg aria-hidden="true" focusable="false" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">{{ b.ico|raw }}</svg></span>
        <div class="pt-card__t">{{ b.t }}</div>
        <p class="pt-card__b">{{ b.b }}</p>
      </div>
      {% endfor %}
    </div>
  </div>

  {# ── How it works ── #}
  <div class="pt-sec" id="how">
    <h2 class="pt-sec__h">How partnership works</h2>
    <p class="pt-sec__sub">From first conversation to launch, with a partnerships lead alongside you.</p>
    <div class="pt-steps">
      {% for s in STEPS %}
      <div class="pt-step">
        <span class="pt-step__n">{{ s.n }}</span>
        <div class="pt-step__t">{{ s.t }}</div>
        <p class="pt-step__b">{{ s.b }}</p>
      </div>
      {% endfor %}
    </div>
  </div>

  {# ── Tiers (descriptive; pricing is tailored, never a fabricated figure) ── #}
  <div class="pt-sec">
    <h2 class="pt-sec__h">Partnership tiers</h2>
    <p class="pt-sec__sub">Every partnership is shaped around your goals — pricing is tailored to scope.</p>
    <div class="pt-tiers">
      {% for t in TIERS %}
      <div class="pt-tier {{ t.feat ? 'pt-tier--feat' : '' }}">
        {% if t.feat %}<span class="pt-tier__tag">Most chosen</span>{% endif %}
        <div class="pt-tier__k">{{ t.k }}</div>
        <div class="pt-tier__n">{{ t.n }}</div>
        <div class="pt-tier__price">Tailored <small>· to scope</small></div>
        <div class="pt-tier__rule"></div>
        <div class="pt-perks">
          {% for p in t.perks %}
          <div class="pt-perk"><svg aria-hidden="true" focusable="false" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>{{ p }}</div>
          {% endfor %}
        </div>
        <a class="pt-tier__btn" href="#enquiry" data-tier="{{ t.n }}">Start the conversation</a>
      </div>
      {% endfor %}
    </div>
  </div>

  {# ── Enquiry (real form → gates_partner_enquiries) ── #}
  <div class="pt-enq" id="enquiry">
    <div class="pt-enq__orb" aria-hidden="true"></div>
    <div class="pt-enq__l">
      <h2>Let’s build something lasting</h2>
      <p>Tell us about your organisation and a partnerships lead will reach out within two business days with a tailored proposal.</p>
      <a class="pt-enq__mail" href="mailto:support@afrovanguard.org.ng?subject=Partnership%20enquiry"><svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><rect x="2" y="4" width="20" height="16" rx="3"/><path d="m3 6 9 7 9-7"/></svg>support@afrovanguard.org.ng</a>
    </div>
    <form class="pt-form" method="post" action="/partner">
      <input type="hidden" name="_token" value="{{ csrf_token }}">
      {% if error %}<div class="pt-err" role="alert">{{ error }}</div>{% endif %}
      <div class="pt-field"><input type="text" name="organisation" required placeholder="Organisation name" aria-label="Organisation name" value="{{ old.organisation|default('') }}"></div>
      <div class="pt-row">
        <div class="pt-field"><input type="text" name="contact_name" required placeholder="Your name" aria-label="Your name" autocomplete="name" value="{{ old.contact_name|default('') }}"></div>
        <div class="pt-field"><input type="email" name="contact_email" required placeholder="Work email" aria-label="Work email" autocomplete="email" value="{{ old.contact_email|default('') }}"></div>
      </div>
      <div class="pt-row">
        <div class="pt-field"><input type="tel" name="contact_phone" placeholder="Phone (optional)" aria-label="Phone (optional)" autocomplete="tel" value="{{ old.contact_phone|default('') }}"></div>
        <div class="pt-field">
          <select name="tier" id="ptTier" aria-label="Interested tier">
            <option value="" {% if not old.tier|default('') %}selected{% endif %} disabled hidden>Interested tier…</option>
            {% for n in TIER_NAMES %}<option value="{{ n }}" {% if old.tier|default('') == n %}selected{% endif %}>{{ n }}</option>{% endfor %}
          </select>
        </div>
      </div>
      <div class="pt-field"><textarea name="message" required placeholder="What would you like to achieve?" aria-label="What would you like to achieve?">{{ old.message|default('') }}</textarea></div>
      <button type="submit" class="pt-submit">Request a proposal</button>
      <p class="pt-note">We reply within two business days. Your details are used only to respond to this enquiry.</p>
    </form>
  </div>

</div>
{% endblock %}

{% block foot_scripts %}
<script>
  // Pre-select the tier in the enquiry form when a tier card's CTA is used.
  document.querySelectorAll('.pt-tier__btn[data-tier]').forEach(function(a){
    a.addEventListener('click', function(){
      var sel = document.getElementById('ptTier');
      if(sel){ sel.value = a.getAttribute('data-tier'); }
    });
  });
</script>
{% endblock %}
