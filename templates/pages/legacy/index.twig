{% extends "layout/gates.twig" %}
{% block content %}

{% set rows = (events|default([])|length > 0) ? events : [] %}

<section class="r26-hero" style="padding-block:clamp(2.5rem,6vw,4.25rem) clamp(1.5rem,3vw,2.5rem);text-align:center">
  <div class="aurora aurora--soft" aria-hidden="true"></div>
  <img class="r26-hero__wm" src="/assets/img/africa-watermark.svg?v={{ asset_version }}" alt="" aria-hidden="true">
  <div class="wrap">
    <div class="r26-hero__inner">
      <p class="r26-eyebrow r26-reveal r26-d1" style="justify-content:center;display:inline-flex">The legacy vault</p>
      <h1 class="r26-hl r26-reveal r26-d2" style="font-size:clamp(2.2rem,5.2vw,3.9rem)">Every cycle, <em style="color:var(--emerald-600)">archived.</em></h1>
      <p class="r26-sub r26-reveal r26-d3" style="margin-left:auto;margin-right:auto">Recognition is a record, not a moment. Each cycle becomes part of the permanent vault — searchable, dated, and forever credited.</p>
    </div>
  </div>
</section>

<section class="section" style="padding-top:1rem">
  <div class="wrap">
    {% if rows is not empty %}
    <div class="r26-head r26-head--center">
      <p class="r26-eyebrow">By the numbers</p>
      <h2 class="r26-h2">A continent of recognition, <em>preserved</em></h2>
    </div>

    <div class="r26-metrics" style="margin-bottom:clamp(2rem,5vw,3.5rem)" data-anim>
      <div class="r26-metric">
        <div class="r26-metric__num"><span data-count="{{ rows|length }}">{{ rows|length }}</span></div>
        <div class="r26-metric__lbl">editions held across the continent</div>
      </div>
      <div class="r26-metric">
        <div class="r26-metric__num"><span data-count="{{ rows|reduce((carry, e) => carry + e.award_count, 0) }}">{{ rows|reduce((carry, e) => carry + e.award_count, 0) }}</span></div>
        <div class="r26-metric__lbl">awards conferred to date</div>
      </div>
      <div class="r26-metric">
        <div class="r26-metric__num"><span data-count="{{ rows|reduce((carry, e) => carry + e.attendee_count, 0) }}">{{ rows|reduce((carry, e) => carry + e.attendee_count, 0)|number_format }}</span></div>
        <div class="r26-metric__lbl">delegates across all editions</div>
      </div>
    </div>

    <div class="r26-head">
      <p class="r26-eyebrow">Editions</p>
      <h2 class="r26-h2">The <em>archive</em></h2>
    </div>
    <div class="r26-mediagrid">
      {% for L in rows %}
      <a href="/legacy/{{ L.slug }}" class="r26-mcard">
        <div class="r26-mcard__media {% if not L.cover_path %}r26-mcard__media--empty{% endif %}">
          {% if L.cover_path %}<img src="{{ L.cover_path }}" alt="{{ L.title }}" loading="lazy" decoding="async">{% endif %}
          <span class="r26-mcard__badge">{{ L.event_date|date('M Y') }}</span>
        </div>
        <div class="r26-mcard__body">
          <p class="r26-mcard__meta">{{ L.location }}</p>
          <h3 class="r26-mcard__title">{{ L.title }}</h3>
          <div class="r26-mcard__foot">
            <span>{{ L.attendee_count|number_format }} delegates · {{ L.award_count }} awards</span>
            <span class="r26-mcard__link">View edition
              <svg aria-hidden="true" focusable="false" viewBox="0 0 20 20" fill="none"><path d="M7.5 4.5 13 10 7.5 15.5" stroke="currentColor" stroke-width="1.75" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          </div>
        </div>
      </a>
      {% endfor %}
    </div>
    {% else %}
    <div class="r26-empty">
      <img class="r26-empty__icon" src="/assets/img/africa-mark.svg?v={{ asset_version }}" alt="" aria-hidden="true">
      <h2>The vault opens after the first cycle</h2>
      <p>Once an edition closes, its winners, jury rationales and full attribution are archived here permanently.</p>
      <a class="btn btn--emerald" href="/events">See upcoming events</a>
    </div>
    {% endif %}
  </div>
</section>

{# Quote/manifesto block — keeps the page rich even on slim content #}
<section class="section" style="padding-top:0">
  <div class="wrap">
    <div class="r26-surface" style="text-align:center">
      <div style="max-width:48rem;margin:0 auto" data-anim>
        <p class="r26-eyebrow" style="justify-content:center;display:inline-flex">Manifesto, 2024</p>
        <p class="r26-h2" style="margin-top:0.75rem">Africa's excellence has always existed. <em>Africa GATES</em> makes sure the world sees it — and that the credit stays attributed.</p>
      </div>
    </div>
  </div>
</section>

{% endblock %}
