  .jc-sum__f{ margin:14px 0 0; padding-top:11px; border-top:1px dashed rgba(35,123,34,.25);
    max-width:70ch; font-size:12px; line-height:1.6; color:#5a6d6f; }

  /* The dossier map. Set apart from the evidence rather than styled like it: a judge
     must be able to tell at a glance which part of this screen is the record and which
     part is a machine's reading of it. Cool grey against the dossier's paper. */
  .jc-map{ padding:18px 28px; border-bottom:1px solid rgba(16,41,44,.07); background:#f7f8fa; }
  .jc-map__top{ display:flex; align-items:center; justify-content:space-between; gap:12px;
    flex-wrap:wrap; }
  .jc-map__go{ cursor:pointer; font:650 12px/1 inherit; border:1px solid rgba(16,41,44,.2);
    background:#fff; color:#10292C; border-radius:999px; padding:9px 15px; min-height:34px; }
  .jc-map__go:hover{ border-color:#237b22; color:#237b22; }
  .jc-map__go:focus-visible{ outline:3px solid #237b22; outline-offset:2px; }
