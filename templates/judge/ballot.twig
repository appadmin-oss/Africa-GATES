{% extends "judge/layout.twig" %}
{% block content %}

{# The whole ballot shares one Alpine component so the progress strip stays in
   sync with scores saved live (it used to freeze at the page-load count until
   a full reload). The payload is parsed from the JSON island below. #}
<script nonce="{{ csp_nonce }}" id="ballotData" type="application/json">{ "criteria": {{ ballot.criteria|json_encode(JSON_SAFE)|raw }}, "nominees": {{ ballot.categories|json_encode(JSON_SAFE)|raw }}, "judgingOpen": {{ ballot.judging_open ? 'true' : 'false' }}, "lockReason": {{ ballot.lock_reason|default('')|json_encode(JSON_SAFE)|raw }} }</script>

<div x-data="ballotApp(JSON.parse(document.getElementById('ballotData').textContent))">

{# ── Progress strip ── #}
<div class="jc-strip">
  <div class="wrap jc-strip__in">
    <div>
      <div class="jc-strip__title">{{ programme.icon_emoji }} {{ programme.title }}</div>
      <div class="jc-strip__sub">Score each nominee across {{ ballot.criteria|length }} criteria · {{ ballot.cycle.year }}</div>
    </div>
    <div class="jc-strip__prog">
      {% set pct = ballot.progress.total > 0 ? (ballot.progress.scored / ballot.progress.total * 100)|round : 0 %}
      <div class="jc-strip__count"><b x-text="scoredCount + ' / ' + totalCount">{{ ballot.progress.scored }} / {{ ballot.progress.total }}</b><span>scored</span></div>
      <div class="jc-strip__bar"><span :style="'width:'+progressPct+'%'" style="width:{{ pct }}%"></span></div>
    </div>
  </div>
</div>

<section class="wrap" style="padding-top:18px">
  {% if programmes|length > 1 %}
  <div class="jd-tabs" style="margin-bottom:18px">
    {% for p in programmes %}
    <a class="jd-tab {% if p.id == programme.id %}is-active{% endif %}" href="/judge/ballot/{{ p.id }}">{{ p.icon_emoji }} {{ p.title|split(' ')|first }}</a>
    {% endfor %}
  </div>
  {% endif %}

  {# Conflict of interest declaration — per programme. Only shown when no COI is on record. #}
  {% if not ballot.coi %}
  <div class="jd-conflict"
       x-data="{declared: sessionStorage.getItem('coi_declared_{{ programme.id }}') === '1', step:'ask'}"
       x-show="!declared" x-cloak>

    {# Step 1 — the check #}
    <template x-if="step==='ask'">
      <div class="jd-conflict__row">
        <div class="jd-conflict__body">
          <strong>⚖️ Conflict of interest check</strong>
          <p>Do you have a personal, financial, or professional relationship with any nominee here that could affect your impartiality?</p>
        </div>
        <div class="jd-conflict__actions">
          <button class="jd-conflict__btn jd-conflict__btn--yes" type="button" @click="step='confirm'">Yes — I have a conflict</button>
          <button class="jd-conflict__btn jd-conflict__btn--no" type="button"
                  @click="declared=true; sessionStorage.setItem('coi_declared_{{ programme.id }}','1')">No conflict — proceed</button>
        </div>
      </div>
    </template>

    {# Step 2 — confirm the recusal (destructive & disables scoring) #}
    <template x-if="step==='confirm'">
      <form method="post" action="/judge/conflict/{{ programme.id }}" class="jd-conflict__form">
        <input type="hidden" name="_token" value="{{ csrf_token }}">
        <strong>Recuse yourself from this programme?</strong>
        <p>This locks your ballot for <b>{{ programme.title }}</b> and removes you from its scoring. You can withdraw a recusal made in error afterwards.</p>
        <label class="jd-conflict__lbl" for="coi_reason">Reason <span>(optional — shared with administrators only)</span></label>
        <textarea id="coi_reason" name="reason" class="jd-conflict__ta" maxlength="500" rows="3"
                  placeholder="e.g. I mentor one of the nominees."></textarea>
        <div class="jd-conflict__actions">
          <button class="jd-conflict__btn jd-conflict__btn--no" type="button" @click="step='ask'">← Back</button>
          <button class="jd-conflict__btn jd-conflict__btn--yes" type="submit">Confirm recusal</button>
        </div>
      </form>
    </template>
  </div>
  {% endif %}

  {% if not ballot.judging_open %}
  <div class="jc-lock" role="status">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
    <p>{{ ballot.lock_reason ?: 'Scoring is currently closed for this programme.' }}</p>
    {% if ballot.coi %}
    <form method="post" action="/judge/conflict/{{ programme.id }}/withdraw" class="jc-lock__act"
          x-data @submit="return confirm('Withdraw your conflict-of-interest recusal for this programme and re-open scoring?')">
      <input type="hidden" name="_token" value="{{ csrf_token }}">
      <button type="submit" class="jc-lock__btn">Withdraw recusal</button>
    </form>
    {% endif %}
  </div>
  {% endif %}

  <div class="jc" x-cloak>
    <div x-show="!queue.length" class="jd-empty">No nominees yet for this programme's current cycle.</div>

    <div class="jc-grid" x-show="queue.length">
      {# ── Queue ── #}
      <aside class="jc-queue">
        <div class="jc-queue__card">
          <div class="jc-queue__head">Nominees</div>
          <div class="jc-scroll">
            <template x-for="(n, i) in queue" :key="n.id">
              <button type="button" class="jc-qrow" :class="active===i && 'is-active'" @click="pick(i)">
                <span class="jc-qrow__av" x-text="(n.name||'?').charAt(0).toUpperCase()"></span>
                <span class="jc-qrow__who">
                  <span class="jc-qrow__name" x-text="flag(n.country_code) + ' ' + n.name"></span>
                  <span class="jc-qrow__status" x-text="n.complete ? ('Scored · ' + n.avg.toFixed(1)) : 'Awaiting score'"></span>
                </span>
                <svg class="jc-qrow__tick" :style="n.complete ? 'color:#237b22' : 'color:#dbe3dd'" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
              </button>
            </template>
          </div>
        </div>
      </aside>

      {# ── Scoring panel ── #}
      <div class="jc-panel" x-show="cur">
        <div class="jc-card">
          <div class="jc-hero">
            <div class="jc-hero__orb" aria-hidden="true"></div>
            <span class="jc-hero__av" x-text="(cur?.name||'?').charAt(0).toUpperCase()"></span>
            <div class="jc-hero__body">
              <h2 x-text="flag(cur?.country_code) + ' ' + (cur?.name||'')"></h2>
              <p x-text="cur?.category + (cur?.country_code ? (' · ' + cur.country_code) : '')"></p>
            </div>
            <div class="jc-hero__score">
              <div class="jc-hero__n" x-text="curScore"></div>
              <div class="jc-hero__l">Your score · /<span x-text="maxScore"></span></div>
            </div>
          </div>

          {#
            THE DOSSIER. Four criteria out of ten used to be scored against a name and a
            one-line tagline; this is the evidence the platform actually holds.

            Two rules the markup has to keep, both of them EvidenceService's:
              • every item states WHO is asserting it — a nominator's case is advocacy and
                is usually the best-written thing here, so it must not read like a checked
                record;
              • what is MISSING is printed as plainly as what is present, because a thin
                dossier reflects our reach and the nominee's access to a camera, not the
                quality of their work.
          #}
          {# ── IN THE NOMINEE'S OWN SUBMISSION, AND CONFIRMED BY THEM ───────
             First, above our own map, because it is the only thing on this screen the
             nominee themselves read and agreed to before sending. Shown whichever way
             they answered — the conversation had a read-back and the form had nothing,
             so half the entries arrived with nobody having checked they were understood.

             Confirmed-only. A draft summary nobody approved must never sit at the top of
             somebody's entry. #}
          <div class="jc-sum" x-show="cur?.summary" x-cloak>
            <p class="jc-klabel">The entry in short &mdash; checked by the nominee</p>
            <p class="jc-sum__t" x-text="cur?.summary?.summary"></p>
            <template x-if="(cur?.summary?.points || []).length">
              <ul class="jc-sum__l">
                <template x-for="(p, i) in cur.summary.points" :key="'sp'+i">
                  <li x-text="p"></li></template>
              </ul>
            </template>
            <p class="jc-sum__f">Written from their answers and shown to them before they
              sent it. <strong>Their own words below are the record</strong> &mdash; this is
              where to start, not what to judge.</p>
          </div>

          {# ── A MAP OF THE DOSSIER, BEFORE THE DOSSIER ─────────────────────
             Above the evidence because it is a map OF it, and a map read afterwards is
             a summary — which is the version that replaces reading rather than
             directing it.

             It is generated on request and never on render: a ballot of forty must not
             start forty model calls by scrolling, and a page that spends money when you
             look at it spends it again on every refresh.

             It states no score, makes no comparison, and has not been shown any other
             nominee — that last one is a property of the request, not a promise in a
             prompt. See JudgeAssist. #}
          <div class="jc-map" x-show="cur">
            <div class="jc-map__top">
              <p class="jc-klabel">Before you read this</p>
              <template x-if="!cur?.map && !mapBusy">
                <button class="jc-map__go" type="button" @click="orient()">
                  Map this dossier</button>
              </template>
              <span class="jc-map__wait" x-show="mapBusy">Reading the dossier…</span>
            </div>

            <template x-if="!cur?.map && !mapBusy && !mapErr">
              <p class="jc-map__hint">
                A short map of what is in this entry — what the case rests on, which claims
                have something behind them, and what is worth checking. It never gives a
                score and it has not seen any other nominee. Read the dossier itself either
                way; this only tells you where to start.
              </p>
            </template>

            <p class="jc-cover" x-show="mapErr" x-text="mapErr"></p>

            <template x-if="cur?.map">
              <div>
                <p class="jc-map__rests" x-text="cur.map.rests_on"></p>

                <div class="jc-map__cols">
                  <template x-if="(cur.map.evidenced||[]).length">
                    <div>
                      <p class="jc-klabel">Has something behind it</p>
                      <ul class="jc-map__l">
                        <template x-for="(t,i) in cur.map.evidenced" :key="'e'+i">
                          <li x-text="t"></li></template>
                      </ul>
                    </div>
                  </template>
                  <template x-if="(cur.map.asserted||[]).length">
                    <div>
                      {# Neutral wording, chosen over the obvious alternative that frames
                         an assertion as a deficiency. An assertion is not a fault: most
                         good work is described before it is documented, and a nominee
                         without a filing cabinet is not a weaker nominee. A judge needs
                         the distinction without the insinuation. #}
                      <p class="jc-klabel">Stated, with nothing attached</p>
                      <ul class="jc-map__l">
                        <template x-for="(t,i) in cur.map.asserted" :key="'a'+i">
                          <li x-text="t"></li></template>
                      </ul>
                    </div>
                  </template>
                </div>

                <template x-if="(cur.map.gaps||[]).length">
                  <div class="jc-map__grp">
                    <p class="jc-klabel">Not in the paperwork</p>
                    <ul class="jc-map__l">
                      <template x-for="(t,i) in cur.map.gaps" :key="'g'+i">
                        <li x-text="t"></li></template>
                    </ul>
                  </div>
                </template>

                <template x-if="(cur.map.check||[]).length">
                  <div class="jc-map__grp">
                    <p class="jc-klabel">Worth looking at yourself</p>
                    <ul class="jc-map__l">
                      <template x-for="(t,i) in cur.map.check" :key="'c'+i">
                        <li x-text="t"></li></template>
                    </ul>
                  </div>
                </template>

                <p class="jc-map__foot">
                  Written by a model from this entry alone. It has seen no scores, no vote
                  counts, no scoring criteria and no other nominee.
                  <strong>It is not a judgement, and nobody has checked it</strong> —
                  the dossier below is the record.
                </p>
              </div>
            </template>
          </div>

          <div class="jc-dossier" x-show="cur?.tagline || cur?.evidence">
            <p class="jc-klabel">Evidence dossier</p>
            <p class="jc-dossier__txt" x-show="cur?.tagline" x-text="cur?.tagline"></p>

            <p class="jc-cover" x-show="cur?.evidence?.coverage?.missing?.length"
               x-text="cur?.evidence?.coverage?.note"></p>

            <template x-for="(it, i) in (cur?.evidence?.items || [])" :key="'ev'+i">
              <div class="jc-ev">
                <div class="jc-ev__top">
                  <span class="jc-ev__title" x-text="it.title"></span>
                  <span class="jc-prov"
                        :class="it.provenance === 'platform_verified' ? 'jc-prov--ok'
                              : (it.provenance === 'nominator_claim' ? 'jc-prov--claim' : '')"
                        x-text="it.provenance_label"></span>
                </div>
                <p class="jc-ev__body" x-show="it.body" x-text="it.body"></p>
                <a class="jc-ev__src" x-show="it.source_url" :href="it.source_url"
                   target="_blank" rel="noopener noreferrer nofollow"
                   x-text="it.source_label || 'Source'"></a>
                <span class="jc-ev__src" x-show="!it.source_url && !it.file_url && it.source_label"
                      x-text="it.source_label"></span>

                {# ── AN UPLOADED FILE, SHOWN RATHER THAN LINKED ──────────────────
                   This was rendered as `<a :href="it.source_url">` against a RELATIVE
                   stored path, so from /judge/ballot the browser asked for
                   /judge/uploads/… and got a 404. Only Cloudinary images worked, because
                   those are absolute — which is why it looked like "only images save".

                   Now it previews in place. A judge scoring a dossier should not have to
                   open a tab per document and lose their place on the ballot; the whole
                   point of the panel is reading the evidence beside the criteria. The
                   download link stays for anything the frame cannot render. #}
                <template x-if="it.file_url">
                  <div class="jc-ev__file">
                    <template x-if="it.file_kind === 'image'">
                      <a :href="it.file_url" target="_blank" rel="noopener">
                        <img class="jc-ev__img" :src="it.file_url" :alt="it.title" loading="lazy">
                      </a>
                    </template>
                    <template x-if="it.file_kind === 'pdf'">
                      {# `object` rather than `iframe`: it degrades to its own children when
                         the browser has no PDF viewer, which is the common case on Android
                         — an empty iframe there looks like a missing document. #}
                      <object class="jc-ev__pdf" :data="it.file_url" type="application/pdf">
                        <p class="jc-ev__body">
                          This browser cannot show the PDF inline.
                          <a :href="it.file_url + '?download=1'">Download it instead</a>.
                        </p>
                      </object>
                    </template>
                    <a class="jc-ev__src" :href="it.file_url + '?download=1'"
                       x-text="'Download ' + (it.source_label || 'the file')"></a>
                  </div>
                </template>

                {# ── WHAT A MODEL MADE OF THE DOCUMENT ────────────────────────────
                   BELOW the document and never instead of it. A judge who reads a
                   summary first has already been told what to see, and the summary is
                   the one thing on this card that no person has checked.

                   It carries its own label saying so, is collapsed by default, and
                   states no score and no verdict — the capability is declared advisory
                   and the registry enforces it. Present only when an administrator has
                   already run the analysis; nothing here calls a provider. #}
                <template x-if="it.analysis">
                  <details class="jc-ai">
                    <summary class="jc-ai__sum">
                      <span class="jc-prov jc-prov--ai">Machine reading &mdash; not checked by a person</span>
                      <span class="jc-ai__type" x-text="it.analysis.doc_type"></span>
                    </summary>
                    <p class="jc-ev__body" x-text="it.analysis.summary"></p>

                    <template x-if="(it.analysis.claims || []).length">
                      <div class="jc-ai__grp">
                        <p class="jc-klabel">What the document states</p>
                        <ul class="jc-ai__list">
                          <template x-for="(c, ci) in it.analysis.claims" :key="'c'+ci">
                            <li x-text="c"></li>
                          </template>
                        </ul>
                      </div>
                    </template>

                    <template x-if="(it.analysis.concerns || []).length">
                      <div class="jc-ai__grp">
                        <p class="jc-klabel">Worth looking at yourself</p>
                        <ul class="jc-ai__list jc-ai__list--warn">
                          <template x-for="(c, ci) in it.analysis.concerns" :key="'w'+ci">
                            <li x-text="c"></li>
                          </template>
                        </ul>
                      </div>
                    </template>

                    <span class="jc-ev__src"
                          x-text="'Read by ' + it.analysis.model
                                + (it.analysis.legibility !== null
                                    ? ' · scan ' + it.analysis.legibility + '% legible' : '')"></span>
                  </details>
                </template>
              </div>
            </template>

            <template x-for="(iv, i) in (cur?.evidence?.interviews || [])" :key="'iv'+i">
              <div class="jc-ev jc-ev--iv">
                <div class="jc-ev__top">
                  <span class="jc-ev__title">Interview — the nominee's own words</span>
                  <span class="jc-prov" x-text="iv.medium + ' · ' + iv.language"></span>
                </div>
                {# The caveat sits ABOVE the transcript deliberately: a judge who reads the
                   words first has already formed the impression it is meant to qualify. #}
                <p class="jc-cover" x-text="iv.caveat"></p>
                <p class="jc-ev__body jc-ev__tx" x-text="iv.transcript"></p>
                <span class="jc-ev__src"
                      x-text="(iv.interviewer ? iv.interviewer : 'Programme team')
                            + (iv.interviewed_at ? ' · ' + iv.interviewed_at.slice(0,10) : '')"></span>
              </div>
            </template>

            <p class="jc-ev__none"
               x-show="!(cur?.evidence?.items||[]).length && !(cur?.evidence?.interviews||[]).length">
              Nothing has been gathered for this nominee yet. Score only what you can see,
              and say so in your notes.
            </p>
          </div>

          <div class="jc-crits">
            <p class="jc-klabel">Score the criteria · 0–10 each</p>
            <template x-for="c in criteria" :key="c.id">
              <div class="jc-crit">
                <div class="jc-crit__top">
                  <div><div class="jc-crit__label" x-text="c.label"></div><div class="jc-crit__hint" x-text="c.description || ('Weighted ' + (c.weight||25) + '%')"></div></div>
                  <span class="jc-crit__val" x-text="cur.scores[c.id] !== undefined ? cur.scores[c.id] : '–'"></span>
                </div>
                <input class="jc-range" type="range" min="0" max="10" step="1"
                       :value="cur.scores[c.id] !== undefined ? cur.scores[c.id] : 0"
                       :aria-label="c.label + ' score'"
                       :disabled="locked"
                       @input="setScore(c.id, $event.target.value)">
              </div>
            </template>

            <div class="jc-note">
              <label for="jcNote">Panel note (optional)</label>
              <textarea id="jcNote" x-model="cur.notes" :disabled="locked" placeholder="Why this score? Notes are shared with the panel, never public."></textarea>
            </div>

            <div class="jc-actions">
              <div class="jc-save" :class="cur._state" x-text="saveLabel"></div>
              <div style="flex:1"></div>
              <button type="button" class="jc-btn jc-btn--ghost" @click="advance()">Skip</button>
              <button type="button" class="jc-btn jc-btn--p" @click="submit()" :disabled="locked || cur._state==='saving'">
                <span x-text="cur.complete ? 'Update score' : 'Submit score'"></span>
                <svg width="15" height="15" viewBox="0 0 20 20" fill="none"><path d="M7.5 4.5 13 10 7.5 15.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
            </div>
          </div>
        </div>

        <div class="jc-guide">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1a6118" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 16v-4M12 8h.01"/></svg>
          <p>Judge on documented impact, not popularity — public votes are scored separately. Your scores are confidential and combine with other judges’ before contributing to the CPI.</p>
        </div>
      </div>
    </div>
  </div>
</section>
</div>{# /x-data ballotApp #}
{% endblock %}

{% block foot_scripts %}
<style nonce="{{ csp_nonce }}">
  .jc-strip{ background:#10292C; }
  .jc-strip__in{ display:flex; align-items:center; justify-content:space-between; gap:20px; flex-wrap:wrap; padding-top:16px; padding-bottom:16px; }
  .jc-strip__title{ font-family:var(--font-display,'Playfair Display',serif); font-weight:700; font-size:19px; color:#fff; }
  .jc-strip__sub{ font-size:12.5px; color:rgba(255,255,255,.6); margin-top:2px; }
  .jc-strip__prog{ display:flex; align-items:center; gap:16px; }
  .jc-strip__count b{ font-family:var(--font-mono,monospace); font-weight:700; font-size:18px; color:#7FC87C; display:block; text-align:right; }
  .jc-strip__count span{ font-size:10.5px; color:rgba(255,255,255,.5); }
  .jc-strip__bar{ width:150px; height:8px; border-radius:5px; background:rgba(255,255,255,.14); overflow:hidden; }
  .jc-strip__bar span{ display:block; height:100%; border-radius:5px; background:linear-gradient(90deg,#7FC87C,#fbc329); }

  .jc-grid{ display:grid; grid-template-columns:300px 1fr; gap:24px; align-items:start; }
  .jc-queue{ position:sticky; top:84px; }
  .jc-queue__card{ background:#fff; border:1px solid rgba(16,41,44,.08); border-radius:16px; overflow:hidden; }
  .jc-queue__head{ padding:14px 16px; border-bottom:1px solid rgba(16,41,44,.07); font:600 11px/1 var(--font-body,sans-serif); letter-spacing:.06em; text-transform:uppercase; color:#5a6d6f; }
  .jc-scroll{ max-height:560px; overflow-y:auto; }
  .jc-qrow{ width:100%; cursor:pointer; border:none; text-align:left; display:flex; align-items:center; gap:12px; padding:13px 16px; background:#fff; border-left:3px solid transparent; border-bottom:1px solid rgba(16,41,44,.05); }
  .jc-qrow.is-active{ background:#f6fcf5; border-left-color:#237b22; }
  .jc-qrow__av{ flex:none; width:38px; height:38px; border-radius:11px; background:#fff8df; color:#7a5600; display:flex; align-items:center; justify-content:center; font-family:var(--font-display,serif); font-weight:700; font-size:15px; }
  .jc-qrow__who{ flex:1; min-width:0; display:flex; flex-direction:column; }
  .jc-qrow__name{ font-weight:600; font-size:13.5px; color:#10292C; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .jc-qrow__status{ font-size:11.5px; color:#5a6d6f; }
  .jc-qrow__tick{ flex:none; }

  .jc-card{ background:#fff; border:1px solid rgba(16,41,44,.08); border-radius:18px; overflow:hidden; }
  .jc-hero{ position:relative; overflow:hidden; background:radial-gradient(130% 130% at 82% 0%,#1d5b2a,#10292C 60%); padding:26px 28px; display:flex; align-items:center; gap:20px; }
  .jc-hero__orb{ position:absolute; right:-40px; bottom:-50px; width:200px; height:200px; border-radius:50%; background:radial-gradient(circle,rgba(212,154,14,.26),transparent 68%); }
  .jc-hero__av{ position:relative; flex:none; width:72px; height:72px; border-radius:18px; background:rgba(127,200,124,.18); color:#7FC87C; display:flex; align-items:center; justify-content:center; font-family:var(--font-display,serif); font-weight:700; font-size:30px; border:3px solid rgba(255,255,255,.2); }
  .jc-hero__body{ position:relative; flex:1; min-width:0; }
  .jc-hero__body h2{ margin:0; font-family:var(--font-display,serif); font-weight:700; font-size:24px; color:#fff; }
  .jc-hero__body p{ margin:6px 0 0; font-size:13.5px; color:rgba(255,255,255,.78); }
  .jc-hero__score{ position:relative; text-align:right; }
  .jc-hero__n{ font-family:var(--font-mono,monospace); font-weight:700; font-size:30px; color:#7FC87C; line-height:1; }
  .jc-hero__l{ font-size:10px; letter-spacing:.06em; text-transform:uppercase; color:rgba(255,255,255,.55); margin-top:3px; }

  .jc-klabel{ margin:0; font:600 11px/1 var(--font-body,sans-serif); letter-spacing:.08em; text-transform:uppercase; color:#5a6d6f; }
  .jc-dossier{ padding:22px 28px; border-bottom:1px solid rgba(16,41,44,.07); }
  .jc-dossier__txt{ margin:10px 0 0; font-size:14.5px; line-height:1.65; color:#3a4448; }
  /* Evidence dossier. Provenance is a chip rather than body text so a judge can see
     at a glance which lines are checked and which are somebody's case. */
  .jc-cover{ margin:12px 0 0; padding:10px 13px; border-left:3px solid #d49a0e; background:#fffaf0;
             border-radius:0 8px 8px 0; font-size:13px; line-height:1.6; color:#7a5605; }
  .jc-ev{ margin:14px 0 0; padding:14px 16px; border:1px solid rgba(16,41,44,.1); border-radius:12px; background:#fbfcfb; }
  .jc-ev--iv{ background:#f6faf6; border-color:rgba(35,123,34,.22); }
  .jc-ev__top{ display:flex; align-items:baseline; justify-content:space-between; gap:12px; flex-wrap:wrap; }
  .jc-ev__title{ font-weight:650; font-size:14px; color:var(--ag-ink,#10292C); }
  .jc-prov{ font-size:11px; font-weight:600; padding:3px 9px; border-radius:999px;
            background:#eceeed; color:#5a6d6f; }
