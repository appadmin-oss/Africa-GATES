  /* The nominee's own confirmed summary. Warmer than the machine-reading panels and
     above them, because it is the one thing here a person signed off. */
  .jc-sum{ padding:18px 28px; border-bottom:1px solid rgba(16,41,44,.07); background:#f8faf6; }
  .jc-sum__t{ margin:10px 0 0; font-size:15.5px; line-height:1.65; color:#10292C; max-width:70ch; }
  .jc-sum__l{ margin:12px 0 0; padding-left:19px; font-size:13.5px; line-height:1.7; color:#3a4448; }
