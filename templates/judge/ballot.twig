  .jc-map__cols{ display:grid; gap:18px; margin-top:14px;
    grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); }
  .jc-map__grp{ margin-top:14px; }
  .jc-map__l{ margin:6px 0 0; padding-left:19px; font-size:13.5px; line-height:1.65; color:#3a4448; }
  .jc-map__l li{ margin:3px 0 0; }
  .jc-map__foot{ margin:16px 0 0; padding-top:12px; border-top:1px dashed rgba(16,41,44,.14);
    max-width:70ch; font-size:12px; line-height:1.6; color:#5a6d6f; }

  /* Machine reading. Deliberately the quietest thing on the card and deliberately
     collapsed: it sits below the document it describes so the judge meets the
     evidence first, and it is styled as an aside rather than as a finding because
     nobody has checked it. */
  .jc-ai{ margin:11px 0 0; padding:0; border-top:1px dashed rgba(16,41,44,.16); }
  .jc-ai__sum{ display:flex; align-items:center; gap:9px; flex-wrap:wrap;
    padding:10px 0 0; cursor:pointer; list-style:none; }
  .jc-ai__sum::-webkit-details-marker{ display:none; }
  .jc-ai__sum::after{ content:'show'; font-size:11.5px; color:#5a6d6f; text-decoration:underline; }
  .jc-ai[open] .jc-ai__sum::after{ content:'hide'; }
  .jc-prov--ai{ background:#eef1f6; color:#4a5568; }
  .jc-ai__type{ font-size:12.5px; color:#5a6d6f; font-style:italic; }
  .jc-ai__grp{ margin:12px 0 0; }
  .jc-ai__list{ margin:6px 0 0; padding-left:19px; font-size:13.5px; line-height:1.65; color:#3a4448; }
  .jc-ai__list li{ margin:3px 0 0; }
  .jc-ai__list--warn li{ color:#7a5605; }

  /* ── AN UPLOADED FILE, PREVIEWED IN PLACE ────────────────────────────────
     Sized so the document is readable beside the criteria rather than replacing
     them: a judge who has to open a tab per document loses their place on the
     ballot, which is the one thing this screen exists to hold. Capped by vh so a
     long PDF cannot push the score inputs off-screen on a laptop. */
  .jc-ev__file{ margin:11px 0 0; }
  .jc-ev__img{ display:block; width:100%; max-width:520px; height:auto;
    border:1px solid rgba(16,41,44,.14); border-radius:8px; background:#fff; }
  .jc-ev__pdf{ display:block; width:100%; height:min(60vh,520px);
    border:1px solid rgba(16,41,44,.14); border-radius:8px; background:#fff; }
  /* On a phone the frame is too small to read a document in, so it becomes a
     download rather than a postage stamp of page one. */
  @media (max-width:640px){
    .jc-ev__pdf{ height:220px; }
  }
  .jc-ev__none{ margin:12px 0 0; font-size:13.5px; line-height:1.6; color:#6a767a; }

  .jc-crits{ padding:22px 28px; }
  .jc-crits .jc-klabel{ margin-bottom:18px; }
  .jc-crit{ margin-bottom:22px; }
  .jc-crit__top{ display:flex; align-items:center; justify-content:space-between; margin-bottom:10px; }
  .jc-crit__label{ font-weight:600; font-size:14.5px; color:#10292C; }
  .jc-crit__hint{ font-size:12px; color:#5a6d6f; margin-top:2px; }
  .jc-crit__val{ font-family:var(--font-mono,monospace); font-weight:700; font-size:18px; color:#237b22; min-width:34px; text-align:right; }
  .jc-range{ -webkit-appearance:none; appearance:none; width:100%; height:6px; border-radius:5px; background:#dde6df; outline:none; }
  .jc-range::-webkit-slider-thumb{ -webkit-appearance:none; width:22px; height:22px; border-radius:50%; background:#237b22; cursor:pointer; border:3px solid #fff; box-shadow:0 2px 6px rgba(16,41,44,.3); }
  .jc-range::-moz-range-thumb{ width:22px; height:22px; border-radius:50%; background:#237b22; cursor:pointer; border:3px solid #fff; }
  .jc-note{ margin-top:24px; }
  .jc-note label{ display:block; font-size:12px; font-weight:600; color:#4a5256; margin-bottom:8px; }
  .jc-note textarea{ width:100%; min-height:84px; resize:vertical; border:1px solid rgba(16,41,44,.16); border-radius:12px; padding:13px 15px; font-family:inherit; font-size:16px; line-height:1.5; color:#10292C; outline:none; }
  .jc-note textarea:focus{ border-color:#237b22; }
  .jc-actions{ display:flex; align-items:center; gap:12px; margin-top:20px; }
  .jc-save{ font-size:12.5px; color:#5a6d6f; }
  .jc-save.ok{ color:#237b22; } .jc-save.err{ color:#c0392b; } .jc-save.saving{ color:#7a5600; }
  .jc-btn{ cursor:pointer; font-family:inherit; font-size:14px; font-weight:600; padding:13px 22px; border-radius:999px; display:inline-flex; align-items:center; gap:8px; }
  .jc-btn--ghost{ border:1px solid rgba(16,41,44,.16); background:#fff; color:#10292C; }
  .jc-btn--p{ border:none; background:#237b22; color:#fff; }
  .jc-btn--p:hover{ background:#1a6118; }
  .jc-btn--p:disabled{ opacity:.6; cursor:not-allowed; }
  .jc-guide{ background:#f4f7f4; border:1px solid #d6e8d3; border-radius:14px; padding:16px 18px; margin-top:16px; display:flex; align-items:flex-start; gap:12px; }
  .jc-guide svg{ flex:none; margin-top:1px; }
  .jc-guide p{ margin:0; font-size:12.5px; line-height:1.6; color:#1a6118; }

  .jc-lock{ display:flex; align-items:center; gap:12px; background:#fff8e6; border:1px solid #f2d68a; color:#7a5600; border-radius:14px; padding:14px 18px; margin-bottom:18px; }
  .jc-lock svg{ flex:none; }
  .jc-lock p{ margin:0; font-size:13.5px; font-weight:500; line-height:1.5; }
  .jc-lock__act{ margin-left:auto; }
  .jc-lock__btn{ cursor:pointer; font-family:inherit; font-size:12.5px; font-weight:600; color:#7a5600; background:#fff; border:1px solid #e2c477; border-radius:999px; padding:8px 16px; white-space:nowrap; }
  .jc-lock__btn:hover{ background:#fffdf5; border-color:#d4a90e; }

  /* Conflict-of-interest declaration card */
  .jd-conflict{ background:#fff; border:1px solid rgba(16,41,44,.1); border-left:4px solid #d49a0e; border-radius:14px; padding:18px 20px; margin-bottom:20px; }
  .jd-conflict__row{ display:flex; align-items:center; justify-content:space-between; gap:20px; flex-wrap:wrap; }
  .jd-conflict__body strong, .jd-conflict__form strong{ display:block; font-family:var(--font-display,serif); font-weight:700; font-size:16px; color:#10292C; }
  .jd-conflict__body p, .jd-conflict__form p{ margin:5px 0 0; font-size:13.5px; line-height:1.55; color:#5a6d6f; max-width:52ch; }
  .jd-conflict__actions{ display:flex; gap:10px; flex-wrap:wrap; flex:none; }
  .jd-conflict__form .jd-conflict__actions{ margin-top:14px; }
  .jd-conflict__btn{ cursor:pointer; font-family:inherit; font-size:13px; font-weight:600; padding:10px 18px; border-radius:999px; border:1px solid transparent; }
  .jd-conflict__btn--yes{ background:#fff4f2; color:#c0392b; border-color:#f0c4bd; }
  .jd-conflict__btn--yes:hover{ background:#fdeae7; border-color:#e2a79d; }
  .jd-conflict__btn--yes[type=submit]{ background:#c0392b; color:#fff; border-color:#c0392b; }
  .jd-conflict__btn--yes[type=submit]:hover{ background:#a5301f; }
  .jd-conflict__btn--no{ background:#f4f7f4; color:#1a6118; border-color:#d6e8d3; }
  .jd-conflict__btn--no:hover{ background:#ecf3ea; }
  .jd-conflict__lbl{ display:block; margin:14px 0 6px; font-size:12.5px; font-weight:600; color:#4a5256; }
  .jd-conflict__lbl span{ font-weight:400; color:#8a9698; }
  .jd-conflict__ta{ width:100%; resize:vertical; border:1px solid rgba(16,41,44,.16); border-radius:10px; padding:11px 13px; font-family:inherit; font-size:13.5px; line-height:1.5; color:#10292C; outline:none; }
  .jd-conflict__ta:focus{ border-color:#d49a0e; }

  @media (max-width:860px){ .jc-grid{ grid-template-columns:1fr; } .jc-queue{ position:static; } .jc-scroll{ max-height:280px; } }
</style>
<script nonce="{{ csp_nonce }}">
function ballotApp(initial){
  var crit = initial.criteria || [];
  var queue = [];
  (initial.nominees || []).forEach(function(g){
    (g.nominees || []).forEach(function(n){ queue.push(Object.assign({}, n, { _state:'', category: g.category.title })); });
  });
  return {
    criteria: crit,
    queue: queue,
    active: 0,
    _timers: {},
    locked: initial.judgingOpen === false,
    lockReason: initial.lockReason || '',
    get cur(){ return this.queue[this.active] || null; },
    get scoredCount(){ return this.queue.filter(function(n){ return n.complete; }).length; },
    get totalCount(){ return this.queue.length; },
    get progressPct(){ return this.totalCount > 0 ? Math.round(this.scoredCount / this.totalCount * 100) : 0; },
    get maxScore(){ return this.criteria.length * 10; },
    get curScore(){ var n=this.cur; if(!n) return 0; return this.criteria.reduce(function(s,c){ return s + (n.scores[c.id]||0); },0); },
    get saveLabel(){ var n=this.cur; if(!n) return ''; return n._state==='saving'?'Saving…':(n._state==='ok'?'✓ Saved':(n._state==='err'?('✗ '+(n._err||'Could not save')):(n.complete?'Fully scored':'Not yet scored'))); },

    mapBusy: false,
    mapErr: '',

    flag(cc){ cc=(cc||'').toUpperCase(); if(cc.length!==2) return '🌍'; return String.fromCodePoint.apply(null,[].map.call(cc,function(c){return 127397+c.charCodeAt(0);})); },
    // Clearing the map error on every move, not just on a new request: the message is
    // about the nominee that failed, and carrying it to the next one makes a working
    // dossier look broken.
    pick(i){ this.active = i; this.mapErr = ''; this.mapBusy = false; },

    // ── ONE REQUEST AT A TIME, AND ONLY WHEN ASKED ────────────────────────
    //
    // POST rather than GET: this may spend money, and a GET is prefetched by browsers
    // and link scanners — a summary generated by somebody hovering is a bill with no
    // reader. The result is cached per nominee server-side, so a second judge on the
    // same panel gets it free and, more importantly, gets the SAME map.
    orient(){
      var n = this.cur;
      if(!n || this.mapBusy) return;
      this.mapBusy = true; this.mapErr = '';
      var self = this, id = n.id;
      // The same CSRF mechanism saveScore() uses — the meta tag — rather than a second
      // one. Two ways of proving the same thing is how one of them quietly stops working.
      fetch('/judge/orient/' + id, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/x-www-form-urlencoded',
          'X-CSRF-Token': (document.querySelector('meta[name=csrf-token]')||{}).content || ''
        },
        body: ''
      }).then(function(r){
        if(r.status === 401){
          window.location = '/judge/login?next=' + encodeURIComponent(location.pathname);
          return {};
        }
        return r.json().catch(function(){ return {}; });
      }).then(function(d){
        self.mapBusy = false;
        if(d && d.ok && d.map){
          // Written onto the queue entry, so switching away and back does not ask again.
          var q = self.queue.filter(function(x){ return x.id === id; })[0];
          if(q) q.map = d.map;
        } else {
          self.mapErr = (d && d.message) || 'That could not be done just now.';
        }
      }).catch(function(){
        self.mapBusy = false;
        self.mapErr = 'That could not be done just now. The dossier below is unaffected.';
      });
    },

    setScore(critId, val){
      var n=this.cur; if(!n || this.locked) return;
      var sc = Object.assign({}, n.scores); sc[critId] = parseInt(val); n.scores = sc;
      // `[].every()` is TRUE, so with no rubric every nominee marked itself complete on a
      // ballot with no score inputs. Same guard as JudgeService::ballot().
      n.complete = this.criteria.length > 0 && this.criteria.every(function(c){ return n.scores[c.id] !== undefined; });
      n.avg = this._avg(n.scores);
      this._debouncedSave(n);
    },

    _avg(scores){
      var weights = {}; this.criteria.forEach(function(c){ weights[c.id] = c.weight || 25; });
      var ws=0, wt=0;
      Object.keys(scores).forEach(function(cid){ var w = weights[cid]||25; ws += scores[cid]*w; wt += w; });
      return wt>0 ? Math.round(ws/wt*10)/10 : 0;
    },

    advance(){
      var t=this.queue.length, nx=this.active;
      for(var k=1;k<=t;k++){ var c=(this.active+k)%t; if(!this.queue[c].complete){ nx=c; break; } }
      this.active = nx;
    },

    _debouncedSave(n){
      n._state='saving';
      clearTimeout(this._timers[n.id]);
      var self=this; this._timers[n.id] = setTimeout(function(){ self._save(n); }, 800);
    },

    submit(){ var n=this.cur; if(!n || this.locked) return; var self=this; this._save(n).then(function(ok){ if(ok) self.advance(); }); },

    async _save(n){
      if(this.locked){ n._state='err'; n._err = this.lockReason || 'Scoring is closed'; return false; }
      try{
        n._state='saving';
        var params = new URLSearchParams({ notes: n.notes || '' });
        Object.keys(n.scores).forEach(function(k){ params.append('scores['+k+']', n.scores[k]); });
        var r = await fetch('/judge/score/' + n.id, {
          method:'POST',
          headers:{ 'Content-Type':'application/x-www-form-urlencoded', 'X-CSRF-Token': (document.querySelector('meta[name=csrf-token]')||{}).content || '' },
          body: params,
        });
        if(r.status===401){ n._err='Your session expired — redirecting to sign in…'; n._state='err'; window.location='/judge/login?next=' + encodeURIComponent(location.pathname); return false; }
        var d = await r.json().catch(function(){ return {}; });
        if(r.ok && d.ok){ n._state='ok'; n._err=''; setTimeout(function(){ if(n._state==='ok') n._state=''; },2500); return true; }
        n._err = (d && d.message) || (r.status===403 ? 'Scoring is closed for this cycle' : ('Save failed (' + r.status + ')'));
        n._state='err';
        return false;
      }catch(e){ n._err='Network error — check your connection'; n._state='err'; return false; }
    },
  };
}
</script>
