<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ page_title|default('Judges — Africa GATES') }}</title>
<meta name="csrf-token" content="{{ csrf_token }}">
<link rel="icon" type="image/svg+xml" href="/assets/img/logo-mark.svg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;0,800;1,500;1,700&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ asset('/assets/css/main.css') }}">
<link rel="stylesheet" href="{{ asset('/assets/css/judge.css') }}">
<link rel="stylesheet" href="{{ asset('/assets/css/aurora.css') }}">
<link rel="stylesheet" href="https://unpkg.com/tippy.js@6.3.7/dist/tippy.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/nprogress@0.2.0/nprogress.css">
</head>
<body class="jd-body">

<header class="jd-top">
  <div class="wrap jd-top__inner">
    <a class="jd-brand" href="/judge/ballot">
      <span class="jd-brand__mark"><img src="{{ asset('/assets/img/gates-logo-240.png') }}" alt="" width="34" height="34"></span>
      <span class="jd-brand__label">Africa GATES <small>Judges Panel</small></span>
    </a>
    {% if judge_id %}
    <div class="jd-who">
      <span class="jd-who__avatar">{{ (judge_name|default('J'))|first|upper }}</span>
      <div>
        <div class="jd-who__name">{{ judge_name|default('Judge') }}</div>
        <div class="jd-who__email">{{ judge_email|default('') }}</div>
      </div>
      <a class="jd-out" href="/judge/logout" data-tip="Sign out" aria-label="Sign out">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
      </a>
    </div>
    {% endif %}
  </div>
</header>

<main class="jd-main">
  {% if flash_ok %}<div class="jd-flash jd-flash--ok">{{ flash_ok }}</div>{% endif %}
  {% if flash_error %}<div class="jd-flash jd-flash--err">{{ flash_error }}</div>{% endif %}
  {% if flash_notice %}<div class="jd-flash jd-flash--note">{{ flash_notice }}</div>{% endif %}
  {% block content %}{% endblock %}
</main>

<script defer src="https://unpkg.com/lucide@1.28.0"></script>
<script defer src="/assets/js/vendor/popper-2.11.8.min.js"></script>
<script defer src="/assets/js/vendor/tippy-6.3.7.umd.min.js"></script>
<script defer src="https://cdn.jsdelivr.net/npm/nprogress@0.2.0/nprogress.min.js"></script>
{# Alpine.js — the ballot's reactive scoring app (x-data/x-show/@click) needs it;
   the public layout loads it separately, so the judge layout must too. #}
<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.13.5/dist/cdn.min.js"></script>
<script nonce="{{ csp_nonce }}">window.addEventListener('load',function(){if(window.lucide&&lucide.createIcons)lucide.createIcons();});</script>
<script defer src="{{ asset('/assets/js/main.js') }}"></script>
{% block foot_scripts %}{% endblock %}
</body>
</html>
