<script nonce="{{ csp_nonce }}">
(function(){
  function init(){
    var wraps = Array.prototype.slice.call(document.querySelectorAll('.ag-mega-wrap'));
    function closeMegas(except){ wraps.forEach(function(o){ if(o!==except){ o.classList.remove('is-open'); var b=o.querySelector('[data-ag-mega-trigger]'); if(b) b.setAttribute('aria-expanded','false'); } }); }
    // Megas — direct per-trigger handlers bound (after DOMContentLoaded) to the
    // FINAL elements, with stopPropagation so no other document click handler can
    // immediately re-close the panel. A click outside any wrap closes all.
    wraps.forEach(function(w){
      var btn=w.querySelector('[data-ag-mega-trigger]'); if(!btn) return;
      btn.addEventListener('click', function(e){
        e.preventDefault(); e.stopPropagation();
        var willOpen=!w.classList.contains('is-open');
        closeMegas(w);
        w.classList.toggle('is-open', willOpen);
        btn.setAttribute('aria-expanded', willOpen?'true':'false');
      });
      // Hover-to-open on desktop (fine pointer only) — click still works everywhere,
      // and touch devices fall through to click since they don't fire hover.
      if (window.matchMedia && window.matchMedia('(hover:hover) and (pointer:fine)').matches){
        var hideT;
        w.addEventListener('mouseenter', function(){ clearTimeout(hideT); closeMegas(w); w.classList.add('is-open'); btn.setAttribute('aria-expanded','true'); });
        w.addEventListener('mouseleave', function(){ hideT=setTimeout(function(){ w.classList.remove('is-open'); btn.setAttribute('aria-expanded','false'); }, 140); });
      }
    });
    document.addEventListener('click', function(e){ if(!(e.target.closest && e.target.closest('.ag-mega-wrap'))) closeMegas(null); });
    // ── Mobile overlay menu ──────────────────────────────────────────────────
    //
    // This carries role="dialog" aria-modal="true", which is a claim about three things.
    // Only the class toggle was here, so: focus stayed on the Menu BUTTON — which the
    // open overlay has just hidden from assistive tech, leaving the caret on something a
    // screen reader will not announce — Tab walked straight out into that hidden page, and
    // closing dropped focus at the top of the document.
    var menu = document.getElementById('agMenu'), openB = document.getElementById('agMenuOpen'), closeB = document.getElementById('agMenuClose');
    function menuFocusables(){
      if(!menu) return [];
      return Array.prototype.slice.call(menu.querySelectorAll('a[href], button, [tabindex]:not([tabindex="-1"])'))
        .filter(function(n){ return !n.disabled && n.offsetParent !== null; });
    }
    function setMenu(on){
      if(!menu) return;
      menu.classList.toggle('is-open', on);
      document.documentElement.classList.toggle('ag-menu-open', on);
      if(openB) openB.setAttribute('aria-expanded', on?'true':'false');
      if(on){
        // The close button, not the first link: it is the thing somebody who opened this by
        // accident is looking for, and Tab from there walks the menu in reading order.
        if(closeB) closeB.focus();
      } else if(openB && typeof openB.focus === 'function'){
        openB.focus();
      }
    }
    if(openB) openB.addEventListener('click', function(){ setMenu(true); });
    if(closeB) closeB.addEventListener('click', function(){ setMenu(false); });
    // Tab cannot leave the menu while it is open.
    if(menu) menu.addEventListener('keydown', function(e){
      if(e.key !== 'Tab' || !menu.classList.contains('is-open')) return;
      var f = menuFocusables(); if(!f.length) return;
      var first = f[0], last = f[f.length-1];
      if(e.shiftKey && document.activeElement === first){ e.preventDefault(); last.focus(); }
      else if(!e.shiftKey && document.activeElement === last){ e.preventDefault(); first.focus(); }
    });
    document.addEventListener('keydown', function(e){
      if(e.key!=='Escape') return;
      if(menu && menu.classList.contains('is-open')) setMenu(false);
      closeMegas(null);
    });
  }
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded', init); else init();
})();
</script>
