{# ═══════════════════════════════════════════════════════════════
   Africa GATES — Navigation (new design system: components/nav.css)
   Desktop: sticky nav + Participate/Explore megas.
   Mobile: no top nav → bottom bar (Home · Pulse · Nominate · Ranks ·
   Menu) + full-screen overlay menu.
   ═══════════════════════════════════════════════════════════════ #}
{% set _p = gates_page|default('') %}

{% if announcement_text %}
<div class="ag-announce ag-scope" role="region" aria-label="Announcement">
  <span class="ag-announce__dot" aria-hidden="true"></span>
  <span>{{ announcement_text }}</span>
  {% if announcement_url %}<a href="{{ announcement_url }}">{{ announcement_cta|default('Learn more →') }}</a>{% endif %}
  <button class="ag-announce__x" type="button" aria-label="Dismiss" data-ag-do="dismiss-parent">×</button>
</div>
{% endif %}

{# ════ DESKTOP NAV ════ #}
