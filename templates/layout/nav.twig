{# ═══ ANNOUNCE BAR ═══════════════════════════════════════════ #}
{% if announcement_text %}
<div class="announce" id="announceBar" role="region" aria-label="Announcement">
  <span class="announce__dot" aria-hidden="true"></span>
  <span>{{ announcement_text }}</span>
  {% if announcement_url %}<a href="{{ announcement_url }}">{{ announcement_cta|default('Learn more →') }}</a>{% endif %}
  <button class="announce__close" type="button" aria-label="Dismiss"
          onclick="this.parentElement.style.display='none'">×</button>
</div>
{% endif %}

{# ═══ AFG · PRIMARY NAV ═══════════════════════════════════════ #}
<header class="afg-nav" id="afgNav" role="banner">
  <div class="wrap afg-nav__row">
    <a class="afg-brand" href="/" aria-label="Africa GATES home">
      <span class="afg-brand__mark" aria-hidden="true">
        <img src="/assets/img/gates-logo-240.png?v={{ asset_version }}" alt="" width="44" height="44" class="afg-brand__mark-light">
        <img src="/assets/img/gates-logo-240.png?v={{ asset_version }}" alt="" width="44" height="44" class="afg-brand__mark-scrolled">
      </span>
      <span class="afg-brand__words">
        <span class="afg-brand__name">Africa</span>
        <span class="afg-brand__tag">GATES</span>
      </span>
    </a>

    <nav class="afg-links" aria-label="Primary">
      <div class="afg-mega-wrap" data-mega>
        <button type="button" class="afg-link afg-link--toggle {% if gates_page in ['awards','nominate','vote','leaderboard'] %}is-active{% endif %}" data-mega-trigger aria-haspopup="true" aria-expanded="false">
          Participate
          <svg width="11" height="11" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M13.825 7.16L10 10.977 6.175 7.16 5 8.335l5 5 5-5-1.175-1.175z" fill="currentColor"/></svg>
        </button>
        <div class="afg-mega" data-mega-panel>
          <div class="afg-mega__col">
            <p class="afg-mega__hd">Take part</p>
            <a href="/nominate" class="afg-mega__link {% if gates_page == 'nominate' %}is-active{% endif %}">
              <span class="afg-mega__txt"><strong>Nominate</strong><small>Surface a profile in under 90 seconds</small></span>
            </a>
            <a href="/vote" class="afg-mega__link {% if gates_page == 'vote' %}is-active{% endif %}">
              <span class="afg-mega__txt"><strong>Vote</strong><small>One verified voter, one vote per category</small></span>
            </a>
            <a href="/register" class="afg-mega__link">
              <span class="afg-mega__txt"><strong>Register a profile</strong><small>Join the continental registry, free</small></span>
            </a>
          </div>
          <div class="afg-mega__col">
            <p class="afg-mega__hd">Recognition</p>
            <a href="/awards" class="afg-mega__link {% if gates_page == 'awards' %}is-active{% endif %}">
              <span class="afg-mega__txt"><strong>Awards</strong><small>Education, integrity, choral &amp; business programmes</small></span>
            </a>
            <a href="/leaderboard" class="afg-mega__link {% if gates_page == 'leaderboard' %}is-active{% endif %}">
              <span class="afg-mega__txt"><strong>Leaderboard</strong><small>Live CPI rankings, refreshed every 6 hours</small></span>
            </a>
            <a href="/integrity" class="afg-mega__link">
              <span class="afg-mega__txt"><strong>Integrity Center</strong><small>How voting, scoring and audits work</small></span>
            </a>
          </div>
          <div class="afg-mega__col">
            <p class="afg-mega__hd">Support</p>
            <a href="/partner" class="afg-mega__link {% if gates_page == 'partner' %}is-active{% endif %}">
              <span class="afg-mega__txt"><strong>Become a partner</strong><small>Voting packs, tickets, sponsorships</small></span>
            </a>
            <a href="https://afrovanguard.org.ng/donate.html" class="afg-mega__link">
              <span class="afg-mega__txt"><strong>Donate</strong><small>Fund child leadership programmes</small></span>
            </a>
          </div>
        </div>
      </div>

      <div class="afg-mega-wrap" data-mega>
        <button type="button" class="afg-link afg-link--toggle {% if gates_page in ['registry','legacy','community'] %}is-active{% endif %}" data-mega-trigger aria-haspopup="true" aria-expanded="false">
          Explore
          <svg width="11" height="11" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M13.825 7.16L10 10.977 6.175 7.16 5 8.335l5 5 5-5-1.175-1.175z" fill="currentColor"/></svg>
        </button>
        <div class="afg-mega" data-mega-panel>
          <div class="afg-mega__col">
            <p class="afg-mega__hd">Discover</p>
            <a href="/registry" class="afg-mega__link {% if gates_page == 'registry' %}is-active{% endif %}">
              <span class="afg-mega__txt"><strong>Registry</strong><small>Browse verified African profiles</small></span>
            </a>
            <a href="/legacy" class="afg-mega__link {% if gates_page == 'legacy' %}is-active{% endif %}">
              <span class="afg-mega__txt"><strong>Legacy Vault</strong><small>Every edition, permanently archived</small></span>
            </a>
            <a href="/events" class="afg-mega__link {% if gates_page == 'events' %}is-active{% endif %}">
              <span class="afg-mega__txt"><strong>Events</strong><small>Ceremonies, webinars and sessions</small></span>
            </a>
          </div>
          <div class="afg-mega__col">
            <p class="afg-mega__hd">Engage</p>
            <a href="/community" class="afg-mega__link {% if gates_page == 'community' %}is-active{% endif %}">
              <span class="afg-mega__txt"><strong>Community</strong><small>Programme channels, OTP-verified</small></span>
            </a>
            <a href="/opportunities" class="afg-mega__link {% if gates_page == 'opportunities' %}is-active{% endif %}">
              <span class="afg-mega__txt"><strong>Opportunities</strong><small>Grants, residencies and fellowships</small></span>
            </a>
            <a href="/blog" class="afg-mega__link {% if gates_page == 'blog' %}is-active{% endif %}">
              <span class="afg-mega__txt"><strong>Blog</strong><small>Announcements and methodology notes</small></span>
            </a>
          </div>
          <div class="afg-mega__col">
            <p class="afg-mega__hd">Help</p>
            <button type="button" class="afg-mega__link" style="text-align:left;width:100%;border:0;background:none;cursor:pointer" onclick="(window.openAiAssistant||(()=>document.getElementById('aiAssistantFab')?.click()))()">
              <span class="afg-mega__txt"><strong>GATES Guide</strong><small>Quick pointers for CPI, voting &amp; more</small></span>
            </button>
            <a href="https://afrovanguard.org.ng/about/" class="afg-mega__link">
              <span class="afg-mega__txt"><strong>About Afrovanguard</strong><small>The initiative behind Africa GATES</small></span>
            </a>
          </div>
        </div>
      </div>
    </nav>

    <div class="afg-cta">
      <a href="/partner"  class="btn btn--ghost btn--sm afg-partner">Partner</a>
      <a href="/register" class="btn btn--emerald btn--sm">
