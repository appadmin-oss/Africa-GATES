  {# Cinema band — Amplitude-style bottom wordmark, as a looping video with an
     "Afrovanguard" text fallback shown until /assets/video/afrovanguard-footer.mp4 exists. #}
  <div class="ftr-cinema" aria-label="Afrovanguard">
    <span class="ftr-cinema__label">An Afrovanguard initiative</span>
    <span class="ftr-cinema__word">Afrovanguard</span>
    <video class="ftr-cinema__video" autoplay muted loop playsinline preload="none" aria-hidden="true">
      <source src="/assets/video/afrovanguard-footer.mp4" type="video/mp4">
    </video>
  </div>
  <script>(function(){var v=document.querySelector('.ftr-cinema__video');if(v)v.addEventListener('playing',function(){v.classList.add('is-playing')});})();</script>
  <script>
  /* Cinematic reveal — the band sits at the footer's base (absolute); once the card's
     bottom edge reaches the viewport floor we pin the band (fixed) so the card scrolls
     up and UNCOVERS it. Pinning only in that window means it never bleeds mid-page. */
  (function(){
    var band=document.querySelector('.ftr-cinema'),
        ftr=document.querySelector('.ftr'),
        card=document.querySelector('.ftr__card');
    if(!band||!ftr||!card) return;
    var threshold=0;
    function measure(){ threshold = ftr.offsetTop + card.offsetHeight; }
    function update(){
      band.classList.toggle('is-pinned', (window.scrollY + window.innerHeight) >= threshold - 1);
    }
    measure(); update();
    window.addEventListener('scroll', update, {passive:true});
    window.addEventListener('resize', function(){ measure(); update(); }, {passive:true});
    window.addEventListener('load', function(){ measure(); update(); });
  })();
  </script>
