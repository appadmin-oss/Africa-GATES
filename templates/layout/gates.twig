        <set attributeName="opacity" to="1" begin="0.55s"/>
        <animate attributeName="stroke-dashoffset" from="1000" to="0" dur="1.5s" begin="0.55s" fill="freeze" calcMode="spline" keySplines="0.65 0 0.35 1"/>
        <animate attributeName="fill-opacity" from="0" to="1" dur="0.6s" begin="2.1s" fill="freeze"/>
        <animate attributeName="stroke-width" from="6" to="0" dur="0.6s" begin="2.1s" fill="freeze"/>
      </path>
      {# Madagascar #}
      <path pathLength="1000" fill="#7fc87c" fill-opacity="0" stroke="#7fc87c" stroke-width="6" stroke-linejoin="round" stroke-linecap="round" stroke-dasharray="1000" stroke-dashoffset="1000" opacity="0" d="M 1274.0,1000.0 L 1270.0,1000.0 L 1260.0,1013.0 L 1249.0,1021.0 L 1247.0,1026.0 L 1247.0,1034.0 L 1245.0,1040.0 L 1227.0,1059.0 L 1208.0,1061.0 L 1197.0,1068.0 L 1188.0,1076.0 L 1188.0,1083.0 L 1190.0,1090.0 L 1190.0,1106.0 L 1186.0,1127.0 L 1178.0,1147.0 L 1177.0,1154.0 L 1179.0,1162.0 L 1180.0,1198.0 L 1190.0,1211.0 L 1197.0,1223.0 L 1200.0,1223.0 L 1215.0,1215.0 L 1224.0,1214.0 L 1230.0,1211.0 L 1234.0,1195.0 L 1241.0,1181.0 L 1245.0,1169.0 L 1247.0,1146.0 L 1248.0,1145.0 L 1248.0,1135.0 L 1250.0,1129.0 L 1261.0,1117.0 L 1269.0,1104.0 L 1273.0,1083.0 L 1278.0,1069.0 L 1278.0,1058.0 L 1285.0,1057.0 L 1287.0,1055.0 L 1287.0,1046.0 L 1285.0,1041.0 L 1285.0,1037.0 L 1277.0,1005.0 Z">
        <set attributeName="opacity" to="1" begin="1.7s"/>
        <animate attributeName="stroke-dashoffset" from="1000" to="0" dur="0.6s" begin="1.7s" fill="freeze" calcMode="spline" keySplines="0.65 0 0.35 1"/>
        <animate attributeName="fill-opacity" from="0" to="1" dur="0.5s" begin="2.35s" fill="freeze"/>
        <animate attributeName="stroke-width" from="6" to="0" dur="0.5s" begin="2.35s" fill="freeze"/>
      </path>
    </g>
  </svg>
  <div class="ag-loader__word">Africa <span>GATES</span></div>
</div>

