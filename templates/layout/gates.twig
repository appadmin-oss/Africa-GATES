      <animate attributeName="r" values="756.2;784;756.2" keyTimes="0;0.45;1" dur="0.8s" begin="2.5s" fill="freeze" calcMode="spline" keySplines="0.4 0 0.2 1;0.4 0 0.2 1"/>
