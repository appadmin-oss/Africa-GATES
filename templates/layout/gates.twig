<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1.0,viewport-fit=cover">
  <title>{{ page_title|default('Africa GATES | Continental Cultural Recognition | Afrovanguard') }}</title>
  <meta name="description" content="{{ meta_description|default('Africa GATES — the Cultural Power Index recognising African excellence. Live in Nigeria, building toward ' ~ nations_count ~ ' nations. An Afrovanguard initiative.') }}">
  <meta name="theme-color" content="#10292C">

  <meta name="csrf-token" content="{{ csrf_token }}">
  <meta name="robots" content="index, follow, max-image-preview:large">
  <meta name="author" content="Africa GATES — an Afrovanguard initiative">
  <meta name="keywords" content="{{ meta_keywords|default('Africa GATES, African awards, Cultural Power Index, CPI, Afrovanguard, African excellence, continental awards, African creatives, African nominations, African leaderboard, African cultural recognition') }}">

  {% set _site_url = site_url|default('https://africagates.org') %}
  {% set _canonical = canonical_url|default(_site_url ~ (request_path|default('/'))) %}
  <link rel="canonical" href="{{ _canonical }}">

  <meta property="og:type" content="{{ og_type|default('website') }}">
  <meta property="og:site_name" content="Africa GATES">
  <meta property="og:url" content="{{ _canonical }}">
  <meta property="og:title" content="{{ og_title|default(page_title|default('Africa GATES — Continental Cultural Recognition')) }}">
  <meta property="og:description" content="{{ meta_description|default('Vote, nominate, and celebrate African excellence through the Cultural Power Index.') }}">
  <meta property="og:image" content="{{ og_image }}">
  <meta property="og:image:alt" content="{{ og_image_alt|default('Africa GATES — continental cultural recognition') }}">
  {# Dimensions and type let WhatsApp, Facebook and X reserve the right box and render
     the preview on the FIRST fetch. Without them a crawler has to download the image
     before it knows the shape, and several will show a small square — or nothing — on a
     first share, which is the share that matters. Only emitted when a page knows them,
     which the nominee ballot and the flier page do. #}
  {% if og_image_w and og_image_h %}
  <meta property="og:image:width" content="{{ og_image_w }}">
  <meta property="og:image:height" content="{{ og_image_h }}">
  <meta property="og:image:type" content="{{ og_image_type|default('image/png') }}">
  {% endif %}
  <meta property="og:locale" content="en_NG">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ og_title|default(page_title|default('Africa GATES')) }}">
  <meta name="twitter:description" content="{{ meta_description|default('Vote, nominate, and celebrate African excellence.') }}">
  <meta name="twitter:image" content="{{ og_image }}">

  {# Structured data — Organization + WebSite for richer SERP cards #}
  <script nonce="{{ csp_nonce }}" type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "{{ _site_url }}#org",
        "name": "Africa GATES",
        "alternateName": "AGATES",
        "url": "{{ _site_url }}",
        "logo": {
          "@type": "ImageObject",
          "url": "{{ _site_url }}/africa-gates-logo.svg"
        },
        "description": "Africa GATES — the Cultural Power Index recognising African excellence. Live in Nigeria, building toward {{ nations_count }} nations. An Afrovanguard initiative.",
        "parentOrganization": {
          "@type": "Organization",
          "name": "Afrovanguard",
          "url": "https://afrovanguard.org.ng"
        },
        "areaServed": "Africa",
        "sameAs": [
          "https://afrovanguard.org.ng"
        ]
      },
      {
        "@type": "WebSite",
        "@id": "{{ _site_url }}#website",
        "url": "{{ _site_url }}",
        "name": "Africa GATES",
        "description": "Vote, nominate, and celebrate African excellence through the Cultural Power Index.",
        "publisher": { "@id": "{{ _site_url }}#org" },
        "inLanguage": "en",
        "potentialAction": {
          "@type": "SearchAction",
          "target": "{{ _site_url }}/registry?q={search_term_string}",
          "query-input": "required name=search_term_string"
        }
      }
    ]
  }
  </script>
  {# Per-page structured data (Event, Article, Person…) injected by page templates. #}
  {% block structured_data %}{% endblock %}
  {% if breadcrumbs is defined and breadcrumbs %}
  <script nonce="{{ csp_nonce }}" type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{% for b in breadcrumbs %}{"@type":"ListItem","position":{{ loop.index }},"name":{{ b.label|json_encode|raw }}{% if b.url %},"item":{{ (_site_url ~ b.url)|json_encode|raw }}{% endif %}}{% if not loop.last %},{% endif %}{% endfor %}]}</script>
  {% endif %}

  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%2310292C'/%3E%3Ctext x='32' y='44' text-anchor='middle' font-family='Georgia,serif' font-size='34' font-weight='700' fill='%237FC87C'%3EG%3C/text%3E%3C/svg%3E">

  {# ── PRECONNECT BUDGET ──────────────────────────────────────────────────────
     Seven preconnects were declared and Lighthouse warned about it explicitly: each
     one opens a TCP + TLS connection immediately and eagerly, competing with the
     requests that actually block the first paint. Beyond about four they cost more in
     contention on a mobile connection than they save in handshake time.

     Kept: the two font hosts (the stylesheet is render-blocking and gstatic serves the
     font files it references, so both are on the critical path).

     Demoted to dns-prefetch: everything whose request is `defer`red or conditional —
     the script CDNs and the media hosts. DNS resolution is the slow part on a mobile
     network and prefetching it is nearly free; the connection itself can wait until
     something actually needs it. #}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="dns-prefetch" href="https://images.unsplash.com">
  <link rel="dns-prefetch" href="https://r2.vidzflow.com">
  {% if gates_page == 'home' or gates_page is empty %}
  <link rel="preload" as="image"
        href="https://images.unsplash.com/photo-1492684223066-81342ee5ff30?auto=format&fit=crop&w=1200&q=78"
        imagesrcset="https://images.unsplash.com/photo-1492684223066-81342ee5ff30?auto=format&fit=crop&w=800&q=72 800w,
                     https://images.unsplash.com/photo-1492684223066-81342ee5ff30?auto=format&fit=crop&w=1200&q=78 1200w"
        imagesizes="(max-width: 768px) 100vw, 1240px"
        fetchpriority="high">
  {% endif %}
  {# Script/CSS CDNs. Every request to these is `defer` or non-blocking (below), so a
     resolved DNS entry is all they need before the page has painted. #}
  <link rel="dns-prefetch" href="https://unpkg.com">

  {# Heritage typography (Playfair Display + DM Sans + JetBrains Mono).
     One stylesheet with `display=swap` — no extra WebFont loader script. #}
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;0,8..60,700;1,8..60,400;1,8..60,600&family=DM+Sans:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">

  {# ── THIRD-PARTY COMPONENT CSS — deliberately NOT render-blocking ───────────
     Four cross-origin stylesheets, on three separate hosts, each needing its own DNS +
     TCP + TLS before the browser may paint. They style four JS-initialised widgets —
     a carousel, a marquee, a video player, a map — none of which exists above the fold
     on most pages, and none of which functions at all without its JavaScript.

     `media="print"` is what makes them non-blocking: the browser fetches them at the
     lowest priority and does not wait for them to paint. The nonce'd script below
     promotes them to `media="all"` once the main thread is idle.

     WHY NOT `onload="this.media='all'"`, which is the usual recipe: that is an inline
     event handler, and this site's CSP is nonce-based with no `script-src-attr
     'unsafe-inline'`. The browser would refuse to run it and the styles would never
     apply — a CSP-correct site has to do this with a nonce'd script.

     THE TRADE: with JavaScript disabled these four stylesheets never apply. That costs
     nothing real, because the widgets they style are inert without JavaScript anyway —
     the markup is already a plain list or an empty container. The no-JS paths this
     platform genuinely supports (voting, nomination, the activity search) use none of
     them. #}
  {# Swiper 8 CSS — for talent slider + case-study mobile #}
  <link rel="stylesheet" href="{{ asset('/assets/css/vendor/swiper-8.4.7.bundle.min.css') }}" media="print" data-lazy-css>
  {# Splide CSS — for the partner marquee #}
  <link rel="stylesheet" href="{{ asset('/assets/css/vendor/splide-4.1.4.min.css') }}" media="print" data-lazy-css>
  {# Plyr — accessible HTML5/YouTube player for video testimonials #}
  <link rel="stylesheet" href="{{ asset('/assets/css/vendor/plyr-3.7.8.css') }}" media="print" data-lazy-css>
  {# Leaflet — continental CPI map on /registry and dashboards #}
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" media="print" data-lazy-css
        integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">
  <script nonce="{{ csp_nonce }}">
  (function () {
    var promote = function () {
      var links = document.querySelectorAll('link[data-lazy-css]');
      for (var i = 0; i < links.length; i++) { links[i].media = 'all'; }
    };
    // Idle if the browser can tell us, with a timeout so a busy main thread cannot
    // starve it; a plain timeout otherwise. Either way it is after the first paint,
    // which is the entire point.
    if ('requestIdleCallback' in window) { requestIdleCallback(promote, { timeout: 1500 }); }
    else { setTimeout(promote, 0); }
  })();
  </script>

  {# ── GLOBAL CSS ─────────────────────────────────────────────────────────────
     One minified bundle when `bin/console assets:build` has run, the fifteen
     individual files when it has not. Lighthouse measured the unbundled version at
     2,360ms of render-blocking requests on a Moto G Power, which is most of a 4.4s LCP.

     The fallback is not a nicety: AssetBundle::url() returns null the instant any
     source is newer than the build, so an un-rebuilt CSS edit degrades to correct-but-
     slow rather than serving stale styling. The order below is the SAME list, in the
     same order, as AssetBundle::STYLESHEETS — a11y.css last so its WCAG corrections
     win — and AssetBundleTest asserts the two agree, because a divergence would show
     up only on deployments that ran the build. #}
  {% if css_bundle %}
  <link rel="stylesheet" href="{{ css_bundle }}">
  {% else %}
  {# Motion design tokens (Phase 2 seed — see resources/motion/motion.ts) #}
  <link rel="stylesheet" href="{{ asset('/assets/css/tokens.motion.css') }}">
  {# The layer that actually uses those tokens. Loaded right after them and
     before main.css, so a page stylesheet can still override any of it. Hides
     nothing on its own — every rule is scoped under `.ag-motion`, which
     ag-motion.js adds. #}
  <link rel="stylesheet" href="{{ asset('/assets/css/motion.css') }}">
  <link rel="stylesheet" href="{{ asset('/assets/css/main.css') }}">
  <link rel="stylesheet" href="{{ asset('/assets/css/ui-overhaul.css') }}">
  <link rel="stylesheet" href="{{ asset('/assets/css/professional.css') }}">
  <link rel="stylesheet" href="{{ asset('/assets/css/redesign-2026.css') }}">
  <link rel="stylesheet" href="{{ asset('/assets/css/aurora.css') }}">

  {# ── New modular design system (built alongside legacy; migrated per-page) ── #}
  <link rel="stylesheet" href="{{ asset('/assets/css/base/tokens.css') }}">
  <link rel="stylesheet" href="{{ asset('/assets/css/base/reset.css') }}">
  <link rel="stylesheet" href="{{ asset('/assets/css/base/typography.css') }}">
  <link rel="stylesheet" href="{{ asset('/assets/css/components/loader.css') }}">
  <link rel="stylesheet" href="{{ asset('/assets/css/components/nav.css') }}">
  <link rel="stylesheet" href="{{ asset('/assets/css/components/footer.css') }}">
  <link rel="stylesheet" href="{{ asset('/assets/css/components/gee.css') }}">
  <link rel="stylesheet" href="{{ asset('/assets/css/components/community-modal.css') }}">
  <link rel="stylesheet" href="{{ asset('/assets/css/components/site-search.css') }}">
  <link rel="stylesheet" href="{{ asset('/assets/css/components/pulse-immersive.css') }}">
  {# Accessibility layer — loaded LAST so its corrections win (WCAG 2.2 AA) #}
  <link rel="stylesheet" href="{{ asset('/assets/css/a11y.css') }}">
  {% endif %}

  {# Hide animated elements until JS prepares them (anti-FOUC) #}
  <style nonce="{{ csp_nonce }}">
    html.wf-loading [data-anim],
    html.wf-loading [text-anime],
    html.wf-loading .scroll-highlight,
    html.wf-loading [data-text-anim] { visibility: hidden; }
  </style>

  {% block head_styles %}{% endblock %}

  {# ── Mobile entrance loader ────────────────────────────────────────────────
     Decided BEFORE paint so content never flashes. Mobile · once per session ·
     motion-safe · and NOT on a page somebody arrived at with a problem.

     MEASURED, BEFORE THE FIX: the splash covered the page for 5.4 SECONDS on the
     first mobile view of every session. Not a network stall — a deliberate
     timeline: ~3.7s of reveal, a 1.2s hold, then a 0.7s fade. And it played
     everywhere, including /vote/verify and /support/assistant, so a supporter
     tapping a link from an email about their missing money watched a logo
     animation for five seconds before they could read anything.

     Two changes. The reveal is compressed to ~1s (see the SMIL timings in the
     SVG below and loader.css), and the exit is now driven by PAGE READINESS
     rather than a fixed delay — so a fast page exits as soon as it is drawn, and
     the floor exists only so it does not flash.

     TASK PAGES ARE EXEMPT. A brand moment is for somebody arriving at the front
     door. Support, help, the account area, a payment and the proof page are
     places people arrive at BECAUSE something is wrong or something is owed, and
     an animation there is an obstacle wearing a logo. #}
  <script nonce="{{ csp_nonce }}">
  (function(){try{
    var TASK = ['support','help','account','verify','pay','checkout','form','status'];
    var page = {{ (gates_page|default(''))|json_encode|raw }};
    var mobile = window.matchMedia('(max-width:879px)').matches;
    var motion = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;
    var first  = !sessionStorage.getItem('ag_intro');
    if (mobile && motion && first && TASK.indexOf(page) === -1) {
      document.documentElement.classList.add('ag-loading');
    }
    /* Stamped whatever we decided, so a task page does not merely postpone the
       intro to the next page somebody opens. */
    if (first) sessionStorage.setItem('ag_intro','1');
  }catch(e){}})();
  </script>
</head>
<body data-page="{{ gates_page|default('') }}">

{# ── Mobile entrance loader (visible only when html.ag-loading) ── #}
<div class="ag-loader" id="agLoader" role="status" aria-label="Loading Africa GATES">
  <svg class="ag-loader__logo" viewBox="0 0 1563 1563" role="img" aria-label="Africa GATES logo">
    <defs><clipPath id="agDiscClip"><circle cx="781.1" cy="781.4" r="756.2"/></clipPath></defs>
    {# Disc — SMIL (Safari-safe; animate r to avoid SVG transform-origin issues) #}
    {# One clock only. Every animation on this splash is now CSS, keyed on
       `.ag-loader.is-playing`, which the script adds on the first rendered frame.

       SMIL used to drive the reveal, and SMIL's timeline starts on DOCUMENT LOAD —
       after every subresource. Measured here: svg.getCurrentTime() was still 0.00
       when the CSS clock had already passed 1.0s. That skew is the real reason the
       original hold was 4.9 seconds, and it cannot be fixed from the SVG side:
       pauseAnimations() before the timeline has begun is a no-op, so the reveal
       always started whenever the page finished loading. #}
    <circle class="ag-loader__disc" cx="781.1" cy="781.4" r="756.2" fill="#10292c"/>
    <g clip-path="url(#agDiscClip)">
      {# Mainland — stroke draws on, then floods to fill #}
      <path class="ag-loader__land" pathLength="1000" fill="#7fc87c" fill-opacity="0" stroke="#7fc87c" stroke-width="6" stroke-linejoin="round" stroke-linecap="round" stroke-dasharray="1000" stroke-dashoffset="1000" opacity="0" d="M 427.0,237.0 L 368.0,307.0 L 354.0,351.0 L 326.0,370.0 L 256.0,468.0 L 275.0,535.0 L 254.0,593.0 L 260.0,633.0 L 325.0,709.0 L 384.0,753.0 L 505.0,744.0 L 574.0,718.0 L 610.0,757.0 L 655.0,759.0 L 665.0,789.0 L 652.0,842.0 L 707.0,912.0 L 727.0,982.0 L 702.0,1023.0 L 695.0,1074.0 L 733.0,1157.0 L 755.0,1256.0 L 789.0,1311.0 L 789.0,1353.0 L 828.0,1388.0 L 857.0,1377.0 L 925.0,1375.0 L 963.0,1344.0 L 1015.0,1274.0 L 1026.0,1223.0 L 1060.0,1199.0 L 1058.0,1140.0 L 1069.0,1113.0 L 1144.0,1050.0 L 1142.0,980.0 L 1122.0,955.0 L 1128.0,927.0 L 1117.0,910.0 L 1130.0,868.0 L 1181.0,813.0 L 1243.0,767.0 L 1294.0,694.0 L 1306.0,643.0 L 1217.0,657.0 L 1193.0,652.0 L 1174.0,617.0 L 1125.0,572.0 L 1119.0,549.0 L 1096.0,527.0 L 1086.0,479.0 L 1065.0,456.0 L 1016.0,356.0 L 1025.0,351.0 L 1047.0,374.0 L 1063.0,362.0 L 1065.0,351.0 L 1039.0,314.0 L 899.0,315.0 L 842.0,285.0 L 823.0,301.0 L 817.0,331.0 L 764.0,321.0 L 759.0,301.0 L 687.0,277.0 L 680.0,215.0 L 667.0,202.0 L 623.0,213.0 L 563.0,208.0 L 488.0,245.0 Z"/>
      {# Madagascar #}
      <path class="ag-loader__isle" pathLength="1000" fill="#7fc87c" fill-opacity="0" stroke="#7fc87c" stroke-width="6" stroke-linejoin="round" stroke-linecap="round" stroke-dasharray="1000" stroke-dashoffset="1000" opacity="0" d="M 1274.0,1000.0 L 1270.0,1000.0 L 1260.0,1013.0 L 1249.0,1021.0 L 1247.0,1026.0 L 1247.0,1034.0 L 1245.0,1040.0 L 1227.0,1059.0 L 1208.0,1061.0 L 1197.0,1068.0 L 1188.0,1076.0 L 1188.0,1083.0 L 1190.0,1090.0 L 1190.0,1106.0 L 1186.0,1127.0 L 1178.0,1147.0 L 1177.0,1154.0 L 1179.0,1162.0 L 1180.0,1198.0 L 1190.0,1211.0 L 1197.0,1223.0 L 1200.0,1223.0 L 1215.0,1215.0 L 1224.0,1214.0 L 1230.0,1211.0 L 1234.0,1195.0 L 1241.0,1181.0 L 1245.0,1169.0 L 1247.0,1146.0 L 1248.0,1145.0 L 1248.0,1135.0 L 1250.0,1129.0 L 1261.0,1117.0 L 1269.0,1104.0 L 1273.0,1083.0 L 1278.0,1069.0 L 1278.0,1058.0 L 1285.0,1057.0 L 1287.0,1055.0 L 1287.0,1046.0 L 1285.0,1041.0 L 1285.0,1037.0 L 1277.0,1005.0 Z"/>
    </g>
  </svg>
  <div class="ag-loader__word">Africa <span>GATES</span></div>
</div>

<div id="scrollProg" class="scroll-prog" aria-hidden="true"></div>
