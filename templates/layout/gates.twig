{# Always-on Community shortcut #}
<a href="/community" class="community-fab" aria-label="Community channels">
  <span class="community-fab__pulse" aria-hidden="true"></span>
  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
</a>

{# ── Gee — the page-aware Africa GATES guide ──────────────────────────
   Launcher + resizable panel (a draggable bottom-sheet on mobile). Driven
   by /assets/js/gee.js, which talks to /api/guide. data-gee-page/-title
   give the client the current-page context for a tailored welcome.
   Suppressed for signed-in MEMBERS on community pages — AI assistance is
   built into the community UI there, so the fab would be redundant. #}
{# Also suppressed on the SUPPORT pages — but no longer because Gee is the
   lesser assistant. Gee now hands a stuck person to the SAME support agent,
   with the same tools and the same session-scoped identity (see
   GuideController and SupportIntent), so two launchers would be two doors onto
   one brain: the reader would have to choose between them with no way to know
   they are the same thing. The desk keeps its own page because that is where
   the ticket list and the forms live. #}
{% set gee_suppressed = (gates_page|default('') == 'community' and is_member|default(false))
                        or gates_page|default('') == 'support' %}
{% if not gee_suppressed %}
<div class="gee" id="gee"
     data-gee-page="{{ gates_page|default('') }}"
     data-gee-title="{{ page_title|default('Africa GATES')|e('html_attr') }}">

  {# Dimmer behind the mobile bottom-sheet (click to dismiss) #}
  <button type="button" class="gee-scrim" tabindex="-1" aria-hidden="true"></button>

  {# Launcher #}
  <button type="button" class="gee-fab" id="geeFab"
          aria-controls="geePanel" aria-expanded="false"
          aria-label="Open Gee, the Africa GATES guide">
    <span class="gee-fab__orb" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 3l2.1 5.4L19.5 10l-5.4 2.1L12 17l-2.1-4.9L4.5 10l5.4-1.6z"/>
        <path d="M18.6 14.6l.9 2.3 2.3.9-2.3.9-.9 2.3-.9-2.3-2.3-.9 2.3-.9z"/>
      </svg>
    </span>
    <span class="gee-fab__dot" aria-hidden="true"></span>
    <span class="gee-fab__tip">Ask Gee</span>
  </button>

  {# Panel #}
  <section class="gee-panel" id="geePanel" role="dialog" aria-modal="false"
           aria-label="Gee — the Africa GATES guide" hidden>
    <span class="gee-resize" id="geeResize" title="Drag to resize" aria-hidden="true"></span>

    <header class="gee-head">
      <div class="gee-head__id">
        <span class="gee-avatar" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3l2.1 5.4L19.5 10l-5.4 2.1L12 17l-2.1-4.9L4.5 10l5.4-1.6z"/>
          </svg>
        </span>
        <span class="gee-head__txt">
          <strong>Gee</strong>
          <small id="geeStatus">Your Africa GATES guide</small>
        </span>
      </div>
      <div class="gee-head__actions">
        <button type="button" class="gee-icon" id="geeClear" title="New chat" aria-label="Start a new chat">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 2v6h6"/><path d="M3.5 8a9 9 0 1 1-.9 5"/></svg>
        </button>
        <button type="button" class="gee-icon" id="geeClose" title="Close" aria-label="Close Gee">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
        </button>
      </div>
    </header>

    <div class="gee-log" id="geeLog" role="log" aria-live="polite"></div>

    <div class="gee-suggest" id="geeSuggest" aria-label="Suggested questions"></div>

    <form class="gee-form" id="geeForm" autocomplete="off">
      <textarea id="geeInput" class="gee-input" rows="1" maxlength="1000"
                placeholder="Ask Gee anything…" aria-label="Message Gee"></textarea>
      <button type="submit" class="gee-send" id="geeSend" aria-label="Send message">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2L11 13"/><path d="M22 2l-7 20-4-9-9-4 20-7z"/></svg>
      </button>
    </form>

    <p class="gee-foot">Gee can make mistakes — check important details.</p>
  </section>
</div>
{% endif %}

<a href="#main" id="backToTop" aria-label="Back to top" title="Back to top">
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
</a>
{% endif %}

{# Join-our-community modal — present site-wide; opened once/session after a vote or nomination #}
{% include 'partials/community-modal.twig' %}
{# Site-wide search. Included on every page because the header button is, and a
   button whose dialog is missing is worse than no button. #}
{% include 'partials/site-search.twig' %}

{# ── Library stack — deferred where safe ────────────────────────── #}
{# jQuery — kept lightweight as a vendor compatibility shim #}
<script defer src="https://code.jquery.com/jquery-3.7.1.slim.min.js"
        integrity="sha256-kmHvs0B+OpCW5GVHUNjv9rOmY0IvSIRcf7zGUDTDQM8=" crossorigin="anonymous"></script>
{# Shared social primitives (like / comment / save / share), used by the Pulse
   feed, the community thread page and the registry profiles.

   ORDER MATTERS: this must come BEFORE Alpine. Deferred scripts run in document
   order, and Alpine starts as soon as its own script executes — not on
   DOMContentLoaded — so anything loaded after it initialises components that
   call window.agSocial before it exists. Loading it second threw
   "Cannot read properties of undefined" on every card in the feed. #}
{# Scroll entrances, staggers and counters. `defer`, and it opts the page IN
   rather than the stylesheet hiding things — if this never runs, the page is
   simply not animated instead of being blank. #}
<script defer src="{{ asset('/assets/js/ag-motion.js') }}"></script>
<script defer src="{{ asset('/assets/js/ag-social.js') }}"></script>
{# Site-wide search overlay. Plain JS, no Alpine — it has to work on every page
   including the ones that never load Alpine, and it enhances a form that already
   submits without it. #}
<script defer src="{{ asset('/assets/js/ag-search.js') }}"></script>
{# Alpine.js — reactive bindings on /vote, /community, /pulse, admin tables #}
<script defer src="{{ asset('/assets/js/vendor/alpine-3.13.5.min.js') }}"></script>
{# Community modal — self-contained; loaded site-wide (outside the lite_page gate) #}
<script defer src="{{ asset('/assets/js/community-modal.js') }}"></script>
{% if not lite_page|default(false) %}
{# GSAP + ScrollTrigger — cinematic scroll animations #}
<script defer src="{{ asset('/assets/js/vendor/gsap-3.12.5.min.js') }}"></script>
<script defer src="{{ asset('/assets/js/vendor/gsap-scrolltrigger-3.12.5.min.js') }}"></script>
<script defer src="{{ asset('/assets/js/vendor/split-type-0.3.4.min.js') }}"></script>
{# Spline viewer is loaded lazily, desktop-only, from main.js (bindSpline) #}
{# Tippy.js — micro-interactions for hover-tip UX polish #}
{# Popper + Tippy are SELF-HOSTED. Both files have been committed under
   public/assets/js/vendor/ all along and the layout loaded them from unpkg anyway —
   so the site paid a cross-origin DNS/TCP/TLS round trip for bytes already on disk,
   and made itself dependent on `script-src` listing unpkg for a dependency that did
   not need to be remote at all. `'self'` is permitted by every policy this site has
   ever served, including the stale one still live in production, so these two now
   work regardless of which CSP is in force.

   Unpinned CDN URLs too: `@popperjs/core@2` and `tippy.js@6` resolve to whatever
   those majors currently point at, which is a third party silently changing the code
   this site executes. The vendored copies are pinned to 2.11.8 and 6.3.7. #}
<script defer src="{{ asset('/assets/js/vendor/popper-2.11.8.min.js') }}"></script>
<script defer src="{{ asset('/assets/js/vendor/tippy-6.3.7.umd.min.js') }}"></script>
{# Leaflet — continental map #}
<script defer src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script defer src="{{ asset('/assets/js/vendor/swiper-8.4.7.bundle.min.js') }}"></script>
<script defer src="{{ asset('/assets/js/vendor/splide-4.1.4.min.js') }}"></script>
<script defer src="{{ asset('/assets/js/vendor/plyr-3.7.8.polyfilled.js') }}"></script>

<script nonce="{{ csp_nonce }}">
  // Plyr — initialize any embedded player on the page.
  document.addEventListener('DOMContentLoaded', function () {
    if (!window.Plyr) return;
    document.querySelectorAll('.plyr__video-embed').forEach(function (el) {
      try { new Plyr(el, { youtube: { noCookie: true, rel: 0 } }); }
      catch (e) { /* ignore — fall back to native iframe */ }
    });
  });
</script>
<script defer src="{{ asset('/assets/js/afg-features.js') }}"></script>
<script defer src="{{ asset('/assets/js/main.js') }}"></script>
{# Gee — the page-aware guide (self-contained; no lite_page gating). Not
   loaded when the widget is suppressed (members on community pages). #}
{% if not gee_suppressed|default(false) %}
<script defer src="{{ asset('/assets/js/gee.js') }}"></script>
{% endif %}

{# ── Aurora — the real Stripe WebGL liquid-mesh gradient ──────────── #}
{# Loads stripe-gradient (Gradient + MiniGl WebGL mesh) via jsDelivr's
   ESM endpoint and initialises every <canvas class="aurora-canvas">.
   If WebGL or the module is unavailable, the section keeps its static
   CSS gradient fallback so nothing ever looks empty. #}
<script nonce="{{ csp_nonce }}" type="module">
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const canvases = Array.from(document.querySelectorAll('canvas.aurora-canvas'));
  if (canvases.length) {
    try {
      const { Gradient } = await import('/assets/js/vendor/stripe-gradient-1.0.1/index.js');
      document.documentElement.classList.add('has-aurora');
      canvases.forEach((cv) => {
        try {
          const g = new Gradient();
          g.initGradient('#' + cv.id);
          if (reduce && typeof g.pause === 'function') {
            // Render one static frame, then freeze for reduced-motion users.
            setTimeout(() => { try { g.pause(); } catch (e) {} }, 60);
          }
        } catch (e) { /* per-canvas failure — fallback CSS remains */ }
      });
    } catch (e) {
      /* module load failed — static CSS gradient fallback remains */
    }
  }
</script>
{% endif %}
<script nonce="{{ csp_nonce }}">
/* Site-wide scroll reveal — sections rise in as they enter the viewport.
   Only below-fold sections are pre-hidden, so content can never be stranded
   if JS halts; reduced-motion users see everything immediately. */
(function(){
  if(!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  var els=document.querySelectorAll('main .section, main > section');
  var io=new IntersectionObserver(function(entries){
    entries.forEach(function(en){ if(en.isIntersecting){ en.target.classList.add('io-in'); io.unobserve(en.target); } });
  },{rootMargin:'0px 0px -7% 0px',threshold:.05});
  els.forEach(function(el){
    if(el.getBoundingClientRect().top > innerHeight*0.85) el.classList.add('io-pre');
    io.observe(el);
  });
})();
/* Island nav — round off the capsule's bottom while a mega sheet is open */
(function(){
  var nav=document.getElementById('afgNav'); if(!nav) return;
  var sync=function(){ nav.classList.toggle('is-mega-open', !!nav.querySelector('.afg-mega-wrap.is-open')); };
  nav.addEventListener('click', function(){ setTimeout(sync,0); });
  document.addEventListener('click', function(){ setTimeout(sync,0); });
  document.addEventListener('keydown', function(e){ if(e.key==='Escape') setTimeout(sync,0); });
})();
</script>
{# ── Mobile entrance loader: the exit ──────────────────────────────────────────
   The fade used to be a CSS animation with a hard-coded 4.9s delay, and this
   script just deleted the node at 5900ms. So the page was covered for 5.4s no
   matter how fast it had loaded — the splash was a timer, not a loader.

   Now the exit is driven by READINESS. It leaves as soon as the document is
   parsed, with a floor of MIN so it does not flash into and out of existence on
   a fast connection, and a hard cap so it can never hold the page.

   performance.now() is milliseconds since navigation start, so the floor is
   measured from when the visitor actually asked for the page — not from when
   this script happened to run, which is already after the HTML arrived. ── #}
<script nonce="{{ csp_nonce }}">
(function(){
  var h=document.documentElement;
  if(!h.classList.contains('ag-loading')) return;
  var l=document.getElementById('agLoader');
  /* REVEAL is the length of the CSS reveal (see loader.css). The wait is measured
     from when the reveal actually STARTS, so it can never be cut off half-drawn;
     CAP is measured from navigation start, so however slow the page turns out to
     be, the splash is never the thing somebody is waiting on. */
  var REVEAL=980, FADE=340, CAP=2600;
  var gone=false, playing=false;
  function rm(){ if(gone) return; gone=true; try{ if(l) l.remove(); }catch(e){} h.classList.remove('ag-loading'); }
  function out(){
    if(gone) return;
    if(!l){ rm(); return; }
    l.classList.add('is-out');
    setTimeout(rm, FADE+60);
  }
  function play(){
    if(playing) return;
    playing = true;
    if(l) l.classList.add('is-playing');
    setTimeout(out, REVEAL);
  }
  /* Two frames in: the first is the paint we are decorating, the second is the one
     the animation can actually start on without being skipped. */
  if(window.requestAnimationFrame) requestAnimationFrame(function(){ requestAnimationFrame(play); });
  else play();
  setTimeout(out, CAP);
})();
</script>
{# ── Screen-reader announcer: any script can say something without visual
     noise — window.agAnnounce('Vote recorded'). Cleared-then-set so repeat
     messages re-announce; 'polite' never interrupts what's being read. ── #}
<div id="ag-announcer" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></div>
<script nonce="{{ csp_nonce }}">
window.agAnnounce = function (msg) {
  var el = document.getElementById('ag-announcer');
  if (!el) return;
  el.textContent = '';
  setTimeout(function () { el.textContent = String(msg || ''); }, 60);
};
</script>
{# ── Delegated handlers, replacing inline on*= attributes ──────────────────────
   A CSP that permits inline event handlers must ship 'unsafe-inline' in
   script-src, and 'unsafe-inline' means an injected <script> runs too — so ten
   small onclick= attributes were the reason the whole policy protected nothing.
   They are now declarative data-ag-do values handled here, once, in a nonce'd
   block. Delegated from document so it works for markup added later, and so no
   page needs its own copy. #}
<script nonce="{{ csp_nonce }}">
(function () {
  function openGee() {
    if (window.openGee) return window.openGee();
    var f = document.getElementById('geeFab');
    if (f) f.click();
  }
  document.addEventListener('click', function (e) {
    var el = e.target.closest('[data-ag-do]');
    if (!el) return;
    switch (el.getAttribute('data-ag-do')) {
      case 'select-all':     el.select && el.select(); break;
      case 'dismiss-parent': if (el.parentElement) el.parentElement.style.display = 'none'; break;
      case 'open-gee':       openGee(); break;
      case 'reload':         location.reload(); break;
      case 'member-fill':    if (window.agMemberFill) window.agMemberFill(el); break;
      case 'copy-url':
        if (navigator.clipboard && el.dataset.url) navigator.clipboard.writeText(el.dataset.url);
        var was = el.textContent;
        el.textContent = 'Copied \u2713';
        setTimeout(function () { el.textContent = was; }, 1600);
        break;
    }
  });
  // `change`, not `click`, for the shop's region/currency selects.
  document.addEventListener('change', function (e) {
    var el = e.target.closest('[data-ag-do="set-cookie-reload"]');
    if (!el || !el.dataset.cookie) return;
    document.cookie = el.dataset.cookie + '=' + encodeURIComponent(el.value) + ';path=/;max-age=31536000';
    location.reload();
  });
})();
</script>
{% block foot_scripts %}{% endblock %}
</body>
</html>
