<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1.0,viewport-fit=cover">
  <title>{{ page_title|default('Africa GATES | Continental Cultural Recognition | Afrovanguard') }}</title>
  <meta name="description" content="{{ meta_description|default('Africa GATES — the Cultural Power Index recognising African excellence. Live in Nigeria, building toward ' ~ nations_count ~ ' nations. An Afrovanguard initiative.') }}">
  <meta name="theme-color" content="#10292C">

  <meta name="csrf-token" content="{{ csrf_token }}">
  <meta name="robots" content="index, follow, max-image-preview:large">
  <meta name="author" content="Africa GATES — an Afrovanguard initiative">
  <meta name="keywords" content="{{ meta_keywords|default('Africa GATES, African awards, Cultural Power Index, CPI, Afrovanguard, African excellence, continental awards, African creatives, African nominations, African leaderboard, African cultural recognition') }}">

  {% set _site_url = site_url|default('https://africagates.org') %}
  {% set _canonical = canonical_url|default(_site_url ~ (request_path|default('/'))) %}
  <link rel="canonical" href="{{ _canonical }}">

  <meta property="og:type" content="{{ og_type|default('website') }}">
  <meta property="og:site_name" content="Africa GATES">
  <meta property="og:url" content="{{ _canonical }}">
  <meta property="og:title" content="{{ og_title|default(page_title|default('Africa GATES — Continental Cultural Recognition')) }}">
  <meta property="og:description" content="{{ meta_description|default('Vote, nominate, and celebrate African excellence through the Cultural Power Index.') }}">
  <meta property="og:image" content="{{ og_image }}">
  <meta property="og:image:alt" content="{{ og_image_alt|default('Africa GATES — continental cultural recognition') }}">
  <meta property="og:locale" content="en_NG">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ og_title|default(page_title|default('Africa GATES')) }}">
  <meta name="twitter:description" content="{{ meta_description|default('Vote, nominate, and celebrate African excellence.') }}">
  <meta name="twitter:image" content="{{ og_image }}">

  {# Structured data — Organization + WebSite for richer SERP cards #}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "{{ _site_url }}#org",
        "name": "Africa GATES",
        "alternateName": "AGATES",
        "url": "{{ _site_url }}",
        "logo": {
          "@type": "ImageObject",
          "url": "{{ _site_url }}/africa-gates-logo.svg"
        },
        "description": "Africa GATES — the Cultural Power Index recognising African excellence. Live in Nigeria, building toward {{ nations_count }} nations. An Afrovanguard initiative.",
        "parentOrganization": {
          "@type": "Organization",
          "name": "Afrovanguard",
          "url": "https://afrovanguard.org.ng"
        },
        "areaServed": "Africa",
        "sameAs": [
          "https://afrovanguard.org.ng"
        ]
      },
      {
        "@type": "WebSite",
        "@id": "{{ _site_url }}#website",
        "url": "{{ _site_url }}",
        "name": "Africa GATES",
        "description": "Vote, nominate, and celebrate African excellence through the Cultural Power Index.",
        "publisher": { "@id": "{{ _site_url }}#org" },
        "inLanguage": "en",
        "potentialAction": {
          "@type": "SearchAction",
          "target": "{{ _site_url }}/registry?q={search_term_string}",
          "query-input": "required name=search_term_string"
        }
      }
    ]
  }
  </script>
  {# Per-page structured data (Event, Article, Person…) injected by page templates. #}
  {% block structured_data %}{% endblock %}
  {% if breadcrumbs is defined and breadcrumbs %}
  <script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{% for b in breadcrumbs %}{"@type":"ListItem","position":{{ loop.index }},"name":{{ b.label|json_encode|raw }}{% if b.url %},"item":{{ (_site_url ~ b.url)|json_encode|raw }}{% endif %}}{% if not loop.last %},{% endif %}{% endfor %}]}</script>
  {% endif %}

  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%2310292C'/%3E%3Ctext x='32' y='44' text-anchor='middle' font-family='Georgia,serif' font-size='34' font-weight='700' fill='%237FC87C'%3EG%3C/text%3E%3C/svg%3E">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://images.unsplash.com" crossorigin>
  <link rel="preconnect" href="https://r2.vidzflow.com" crossorigin>
  {% if gates_page == 'home' or gates_page is empty %}
  <link rel="preload" as="image"
        href="https://images.unsplash.com/photo-1492684223066-81342ee5ff30?auto=format&fit=crop&w=1200&q=78"
        imagesrcset="https://images.unsplash.com/photo-1492684223066-81342ee5ff30?auto=format&fit=crop&w=800&q=72 800w,
                     https://images.unsplash.com/photo-1492684223066-81342ee5ff30?auto=format&fit=crop&w=1200&q=78 1200w"
        imagesizes="(max-width: 768px) 100vw, 1240px"
        fetchpriority="high">
  {% endif %}
  <link rel="preconnect" href="https://cdn.jsdelivr.net">
  <link rel="preconnect" href="https://unpkg.com">
  <link rel="preconnect" href="https://cdn.plyr.io">

  {# Heritage typography (Playfair Display + DM Sans + JetBrains Mono).
     One stylesheet with `display=swap` — no extra WebFont loader script. #}
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;0,8..60,700;1,8..60,400;1,8..60,600&family=DM+Sans:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">

  {# Swiper 8 CSS — for talent slider + case-study mobile #}
  <link rel="stylesheet" href="https://unpkg.com/swiper@8/swiper-bundle.min.css">
  {# Splide CSS — for the partner marquee #}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/css/splide.min.css">
  {# Plyr — accessible HTML5/YouTube player for video testimonials #}
  <link rel="stylesheet" href="https://cdn.plyr.io/3.7.8/plyr.css">
  {# Leaflet — continental CPI map on /registry and dashboards #}
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
        integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">

  {# Motion design tokens (Phase 2 seed — see resources/motion/motion.ts) #}
  <link rel="stylesheet" href="/assets/css/tokens.motion.css?v={{ asset_version }}">
  <link rel="stylesheet" href="/assets/css/main.css?v={{ asset_version }}">
  <link rel="stylesheet" href="/assets/css/ui-overhaul.css?v={{ asset_version }}">
  <link rel="stylesheet" href="/assets/css/professional.css?v={{ asset_version }}">
  <link rel="stylesheet" href="/assets/css/redesign-2026.css?v={{ asset_version }}">
  <link rel="stylesheet" href="/assets/css/aurora.css?v={{ asset_version }}">

  {# ── New modular design system (built alongside legacy; migrated per-page) ── #}
  <link rel="stylesheet" href="/assets/css/base/tokens.css?v={{ asset_version }}">
  <link rel="stylesheet" href="/assets/css/base/reset.css?v={{ asset_version }}">
  <link rel="stylesheet" href="/assets/css/base/typography.css?v={{ asset_version }}">
  <link rel="stylesheet" href="/assets/css/components/loader.css?v={{ asset_version }}">
  <link rel="stylesheet" href="/assets/css/components/nav.css?v={{ asset_version }}">
  <link rel="stylesheet" href="/assets/css/components/footer.css?v={{ asset_version }}">
  <link rel="stylesheet" href="/assets/css/components/gee.css?v={{ asset_version }}">
  <link rel="stylesheet" href="/assets/css/components/community-modal.css?v={{ asset_version }}">
  {# Accessibility layer — loaded LAST so its corrections win (WCAG 2.2 AA) #}
  <link rel="stylesheet" href="/assets/css/a11y.css?v={{ asset_version }}">

  {# Hide animated elements until JS prepares them (anti-FOUC) #}
  <style>
    html.wf-loading [data-anim],
    html.wf-loading [text-anime],
    html.wf-loading .scroll-highlight,
    html.wf-loading [data-text-anim] { visibility: hidden; }
  </style>

  {% block head_styles %}{% endblock %}

  {# Mobile entrance loader: decide BEFORE paint so content never flashes.
     Mobile only · once per session · motion-safe. #}
  <script>
  (function(){try{
    var mobile = window.matchMedia('(max-width:879px)').matches;
    var motion = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;
    var first  = !sessionStorage.getItem('ag_intro');
    if (mobile && motion && first) {
      document.documentElement.classList.add('ag-loading');
      sessionStorage.setItem('ag_intro','1');
    }
  }catch(e){}})();
  </script>
</head>
<body data-page="{{ gates_page|default('') }}">

{# ── Mobile entrance loader (visible only when html.ag-loading) ── #}
