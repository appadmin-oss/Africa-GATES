{#
  THE v7 SECTION KINDS (README §2.3, §2.5, §2.7) — rows, cards, stats, steps, note, and the
  hi-fi kinds hero, agenda, chart, table, form, article. One macro per kind and nothing else
  draws a section, so a page cannot invent a sixth layout. A row's action is a link or a
  small form that posts; the action never fires the row's own link (it sits outside it).
#}

{% macro icon(name) %}{% set P = {
  home: 'M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1z',
  cal: 'M7 3v3M17 3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z',
  list: 'M9 6h11M9 12h11M9 18h11M4 6h.01M4 12h.01M4 18h.01',
  clock: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM12 7v5l3 2',
  book: 'M4 19.5A2.5 2.5 0 0 1 6.5 17H20V3H6.5A2.5 2.5 0 0 0 4 5.5zM4 19.5A2.5 2.5 0 0 0 6.5 22H20v-5',
  star: 'M12 3l2.7 5.6 6.3.9-4.5 4.4 1 6.1L12 17l-5.5 3 1-6.1L3 9.5l6.3-.9z',
  users: 'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM22 21v-2a4 4 0 0 0-3-3.9M16 3.1a4 4 0 0 1 0 7.8',
  gear: 'M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM19.4 15a1.6 1.6 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.6 1.6 0 0 0-2.7 1.1V21a2 2 0 0 1-4 0v-.1a1.6 1.6 0 0 0-2.7-1.1l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.6 1.6 0 0 0-1.1-2.7H3a2 2 0 0 1 0-4h.1a1.6 1.6 0 0 0 1.1-2.7l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.6 1.6 0 0 0 2.7-1.1V3a2 2 0 0 1 4 0v.1a1.6 1.6 0 0 0 2.7 1.1l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.6 1.6 0 0 0 1.1 2.7H21a2 2 0 0 1 0 4h-.1a1.6 1.6 0 0 0-1.5 1.3z',
  trophy: 'M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0zM7 6H4v1a3 3 0 0 0 3 3M17 6h3v1a3 3 0 0 1-3 3',
  ticket: 'M4 7h16v3a2 2 0 0 0 0 4v3H4v-3a2 2 0 0 0 0-4zM14 7v10',
  noms: 'M9 12l2 2 4-4M5 4h14a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1z',
  vote: 'M4 12h16v8H4z M8 12V4h8v8 M10 8l1.5 1.5L14 7',
  shield: 'M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z',
  lock: 'M5 11h14v10H5zM8 11V7a4 4 0 0 1 8 0v4',
  flag: 'M5 21V4h11l-1.5 4L16 12H5',
  bell: 'M6 8a6 6 0 1 1 12 0c0 7 3 9 3 9H3s3-2 3-9M10.3 21a1.94 1.94 0 0 0 3.4 0',
  doc: 'M14 3H6a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8zM14 3v5h5M9 13h6M9 17h6',
  more: 'M5 12h.01M12 12h.01M19 12h.01',
  back: 'M15 6l-6 6 6 6',
  chev: 'M9 6l6 6-6 6',
  msg: 'M21 12a8 8 0 0 1-11.6 7.1L4 21l1.9-5.4A8 8 0 1 1 21 12z',
  night: 'M21 13A9 9 0 1 1 11 3a7 7 0 0 0 10 10z',
  grow: 'M3 17l6-6 4 4 8-8M15 7h6v6',
  rep: 'M14 3H6a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8zM14 3v5h5M8 17v-3M12 17v-6M16 17v-2',
  inbox: 'M22 12h-6l-2 3h-4l-2-3H2M5.5 5h13l3.5 7v6a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1v-6z',
  card: 'M3 6h18v12H3zM3 10h18M7 15h4',
  chart: 'M4 20V10M10 20V4M16 20v-7M22 20H2',
  user: 'M20 21a8 8 0 1 0-16 0M12 13a5 5 0 1 0 0-10 5 5 0 0 0 0 10z'
} %}<svg class="sh7-ico" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"><path d="{{ P[name]|default(P.list) }}"/></svg>{% endmacro %}

{# A row's or a header's action: a link, or a one-button form that posts. #}
{#
  A button or link. `ctx` is the thing it acts on, read to a screen reader after the label and
  hidden on screen, so a list is "Check, N-12 · Halima Bello" and never "Check, Check, Check"
  (WCAG 2.4.4, link purpose in context; 2.5.3, the visible label starts the accessible name).
#}
{% macro action(a, here, quiet, act, ctx) %}
  {% set _ctx = ctx|default('') %}
  {% if a.post is defined %}
    <form class="sh7-inline" method="post" action="{{ act ?: '/volunteer/act' }}">
      <input type="hidden" name="_token" value="{{ csrf_token }}"><input type="hidden" name="back" value="{{ here }}">
      {% for k, v in a.post %}<input type="hidden" name="{{ k }}" value="{{ v }}">{% endfor %}
      <button class="sh7-btn{{ a.primary|default(false) ? ' sh7-btn--primary' }}{{ a.danger|default(false) ? ' sh7-btn--danger' }}{{ quiet ? ' sh7-btn--sm' }}" type="submit"{% if a.confirm is defined %} data-sh7-confirm="{{ a.confirm }}"{% endif %}>{{ a.label }}{% if _ctx %}<span class="sh7-sr">, {{ _ctx }}</span>{% endif %}</button>
    </form>
  {% else %}
    <a class="sh7-btn{{ a.primary|default(false) ? ' sh7-btn--primary' }}{{ quiet ? ' sh7-btn--sm' }}" href="{{ a.href }}">{{ a.label }}{% if _ctx %}<span class="sh7-sr">, {{ _ctx }}</span>{% endif %}</a>
  {% endif %}
{% endmacro %}

{#
  The account menu's "Switch to" list (Account\Roles::menu via `account_switch()`): one POST per
  role, because switching starts that role's session — never a link a prefetch can follow.
  `current` is the kind this surface is; it is marked, not offered.
#}
{% macro acctSwitch(items, current) %}
  {% import _self as M %}
  {% set ic = {member: 'user', volunteer: 'users', admin: 'shield', judge: 'trophy', org: 'flag'} %}
  <ul class="sh7-prod__list">
    {% for m in items %}
      <li>
        {% if m.kind == current %}
          <span class="sh7-prod__i is-on" role="menuitem" aria-current="true"><span class="sh7-prod__ic" aria-hidden="true">{{ M.icon(ic[m.kind]) }}</span><span class="sh7-prod__t"><span class="sh7-prod__n">{{ m.label }}</span><span class="sh7-prod__s">{{ m.sub }}</span></span><span class="sh7-prod__tick" aria-hidden="true">✓</span></span>
        {% elseif m.live %}
          <form method="post" action="/account/switch">
            <input type="hidden" name="_token" value="{{ csrf_token }}"><input type="hidden" name="kind" value="{{ m.kind }}">
            <button class="sh7-prod__i" type="submit" role="menuitem"><span class="sh7-prod__ic" aria-hidden="true">{{ M.icon(ic[m.kind]) }}</span><span class="sh7-prod__t"><span class="sh7-prod__n">{{ m.label }}</span><span class="sh7-prod__s">{{ m.sub }}</span></span></button>
          </form>
        {% endif %}
      </li>
    {% endfor %}
  </ul>
{% endmacro %}

{% macro chip(c) %}{% if c %}<span class="sh7-chip sh7-chip--{{ c[1]|default('mute') }}">{{ c[0] }}</span>{% endif %}{% endmacro %}

{% macro bar(pct, label) %}<span class="sh7-meter"><span class="sh7-meter__track"><span class="sh7-meter__fill" style="width:{{ min(100, max(0, pct)) }}%"></span></span>{% if label %}<span class="sh7-meter__label">{{ label }}</span>{% endif %}</span>{% endmacro %}

{% macro field(f) %}
  {% set id = 'f_' ~ f.name|replace({'[': '_', ']': ''}) %}
  {% if f.type == 'radio' %}
    <fieldset class="sh7-field sh7-field--choice"><legend class="sh7-field__label">{{ f.label }}</legend>
      {% for k, l in f.options %}<label class="sh7-choice"><input type="radio" name="{{ f.name }}" value="{{ k }}"{{ f.required|default(false) ? ' required' }}> {{ l }}</label>{% endfor %}
    </fieldset>
  {% elseif f.type == 'segmented' %}
    <fieldset class="sh7-field"><legend class="sh7-field__label sh7-sr">{{ f.label }}</legend>
      <span class="sh7-seg">{% for k, l in f.options %}<label class="sh7-seg__opt"><input type="radio" name="{{ f.name }}" value="{{ k }}"{{ (f.value|default('')) == k ? ' checked' }}><span>{{ l }}</span></label>{% endfor %}</span>
    </fieldset>
  {% elseif f.type == 'switch' %}
    <label class="sh7-switch"><input type="checkbox" name="{{ f.name }}" value="1"{{ f.value|default('0') == '1' ? ' checked' }}><span class="sh7-switch__track" aria-hidden="true"></span><span>{{ f.label }}</span></label>
  {% elseif f.type == 'select' %}
    <label class="sh7-field" for="{{ id }}"><span class="sh7-field__label">{{ f.label }}</span>
      <select class="sh7-input" id="{{ id }}" name="{{ f.name }}"{{ f.required|default(false) ? ' required' }}>{% for k, l in f.options %}<option value="{{ k }}"{{ (f.value|default('')) == k ? ' selected' }}>{{ l }}</option>{% endfor %}</select></label>
  {% elseif f.type == 'textarea' %}
    <label class="sh7-field" for="{{ id }}"><span class="sh7-field__label">{{ f.label }}</span>
      <textarea class="sh7-input" id="{{ id }}" name="{{ f.name }}" rows="4"{{ f.required|default(false) ? ' required' }}>{{ f.value|default('') }}</textarea></label>
  {% else %}
    <label class="sh7-field" for="{{ id }}"><span class="sh7-field__label">{{ f.label }}</span>
      <input class="sh7-input" id="{{ id }}" type="{{ f.type }}" name="{{ f.name }}" value="{{ f.value|default('') }}"
        {%- if f.placeholder is defined %} placeholder="{{ f.placeholder }}"{% endif %}
        {%- if f.min is defined %} min="{{ f.min }}"{% endif %}{% if f.max is defined %} max="{{ f.max }}"{% endif %}{% if f.step is defined %} step="{{ f.step }}"{% endif %}
        {{- f.required|default(false) ? ' required' }}></label>
  {% endif %}
{% endmacro %}

{% macro section(s, here, act) %}
{% import _self as M %}
{% set act = act ?: '/volunteer/act' %}
<section class="sh7-sec sh7-sec--{{ s.k }}{{ s.box|default(false) ? ' is-boxed' }}">
  {% if s.h is defined and s.h and s.k != 'hero' %}<h2 class="sh7-sec__h">{{ s.h }}</h2>{% endif %}

  {% if s.k == 'rows' %}
    <ul class="sh7-rows">
      {% for r in s.items %}
        <li class="sh7-row{{ r.href is defined and r.href ? ' is-link' }}">
          {# A dot is never the only signal (WCAG 1.4.1): a reader hears the word it stands for. #}
          {% if r.dot is defined and r.dot %}<span class="sh7-dot sh7-dot--{{ r.dot }}" aria-hidden="true"></span><span class="sh7-sr">{{ {ok: 'Fine', warn: 'Check', bad: 'Problem', info: 'Note'}[r.dot]|default('') }}: </span>{% endif %}
          {% if r.ini is defined and r.ini %}<span class="sh7-tile sh7-tile--sm" aria-hidden="true">{{ r.ini }}</span>{% endif %}
          <span class="sh7-row__words">
            {% if r.href is defined and r.href %}<a class="sh7-row__t" href="{{ r.href }}">{{ r.t }}</a>{% else %}<span class="sh7-row__t">{{ r.t }}</span>{% endif %}
            {% if r.sub %}<span class="sh7-row__sub">{{ r.sub }}</span>{% endif %}
            {% if r.pct is defined %}{{ M.bar(r.pct, r.barT|default('')) }}{% endif %}
            {% if r.inline is defined and r.inline %}
              <form class="sh7-rowform" method="post" action="{{ act }}">
                <input type="hidden" name="_token" value="{{ csrf_token }}"><input type="hidden" name="back" value="{{ here }}">
                <input type="hidden" name="do" value="{{ r.inline.do }}"><input type="hidden" name="hour" value="{{ r.inline.hour }}">
                <label class="sh7-sr" for="p{{ r.inline.hour }}">{{ r.inline.label }}</label>
                <input class="sh7-input" id="p{{ r.inline.hour }}" type="url" name="{{ r.inline.name }}" placeholder="{{ r.inline.placeholder }}" required>
                <button class="sh7-btn sh7-btn--sm" type="submit">{{ r.inline.submit }}</button>
              </form>
            {% endif %}
            {% if r.decide is defined and r.decide %}
              <form class="sh7-rowform" method="post" action="{{ act }}">
                <input type="hidden" name="_token" value="{{ csrf_token }}"><input type="hidden" name="back" value="{{ here }}">
                <input type="hidden" name="do" value="hours_confirm"><input type="hidden" name="hour" value="{{ r.decide.hour }}">
                <label class="sh7-sr" for="r{{ r.decide.hour }}">Reason, if you decline</label>
                <input class="sh7-input" id="r{{ r.decide.hour }}" type="text" name="reason" placeholder="Reason, if you decline">
                <button class="sh7-btn sh7-btn--sm sh7-btn--primary" type="submit" name="verdict" value="yes">Confirm</button>
                <button class="sh7-btn sh7-btn--sm" type="submit" name="verdict" value="no">Decline</button>
              </form>
            {% endif %}
            {% if r.form is defined and r.form %}
              <form class="sh7-rowform" method="post" action="{{ act }}">
                <input type="hidden" name="_token" value="{{ csrf_token }}"><input type="hidden" name="back" value="{{ here }}"><input type="hidden" name="do" value="{{ r.form.do }}">
                {% for k, v in r.form.hidden|default({}) %}<input type="hidden" name="{{ k }}" value="{{ v }}">{% endfor %}
                {% for f in r.form.fields %}{% set fid = 'rf' ~ r.form.id ~ f.name %}
                  <label class="sh7-sr" for="{{ fid }}">{{ f.label }}</label>
                  {% if f.type|default('text') == 'select' %}<select class="sh7-input" id="{{ fid }}" name="{{ f.name }}">{% for k, l in f.options %}<option value="{{ k }}"{{ (f.value|default('')) == k ? ' selected' }}>{{ l }}</option>{% endfor %}</select>
                  {% else %}<input class="sh7-input" id="{{ fid }}" type="{{ f.type|default('text') }}" name="{{ f.name }}" value="{{ f.value|default('') }}" placeholder="{{ f.placeholder|default(f.label) }}"{{ f.required|default(false) ? ' required' }}>{% endif %}
                {% endfor %}
                <button class="sh7-btn sh7-btn--sm" type="submit">{{ r.form.submit }}</button>
              </form>
            {% endif %}
            {% if r.pause is defined and r.pause %}
              <form class="sh7-rowform" method="post" action="{{ act }}">
                <input type="hidden" name="_token" value="{{ csrf_token }}"><input type="hidden" name="back" value="{{ here }}"><input type="hidden" name="do" value="pause">
                {% for w in [2, 4, 8] %}<button class="sh7-btn sh7-btn--sm" type="submit" name="weeks" value="{{ w }}">{{ w }} weeks</button>{% endfor %}
              </form>
            {% endif %}
          </span>
          {% if r.meta is defined and r.meta %}<span class="sh7-row__time">{{ r.meta }}</span>{% endif %}
          {{ M.chip(r.chip|default(null)) }}
          {% if r.cta is defined and r.cta %}<span class="sh7-row__cta">{{ M.action(r.cta, here, true, act, r.t) }}</span>{% endif %}
          {% if r.href is defined and r.href and not (r.cta is defined and r.cta) %}<span class="sh7-row__chev" aria-hidden="true">{{ M.icon('chev') }}</span>{% endif %}
        </li>
      {% endfor %}
    </ul>
    {% if s.link is defined and s.link %}<p class="sh7-sec__more"><a href="{{ s.link.href }}">{{ s.link.label }}</a></p>{% endif %}

  {% elseif s.k == 'cards' %}
    <div class="sh7-cards">
      {% for c in s.items %}
        <a class="sh7-card" href="{{ c.href }}">
          <span class="sh7-card__top"><span class="sh7-tile sh7-tile--{{ c.tone|default('mute') }}" aria-hidden="true">{{ c.ini }}</span>
            <span class="sh7-card__words"><span class="sh7-card__t">{{ c.t }}</span><span class="sh7-card__meta">{{ c.meta }}</span></span>{{ M.chip(c.chip|default(null)) }}</span>
          {% if c.sub %}<span class="sh7-card__sub">{{ c.sub }}</span>{% endif %}
          {% if c.pct is defined %}{{ M.bar(c.pct, c.barT|default('')) }}{% endif %}
        </a>
      {% endfor %}
    </div>

  {% elseif s.k == 'stats' %}
    <dl class="sh7-stats">
      {% for x in s.items %}
        <div class="sh7-stat"><dt class="sh7-stat__l">{{ x.l }}</dt><dd class="sh7-stat__v">{{ x.v }}</dd>
          {% if x.pct is defined %}{{ M.bar(x.pct, '') }}{% endif %}{% if x.s is defined and x.s %}<dd class="sh7-stat__s">{{ x.s }}</dd>{% endif %}</div>
      {% endfor %}
    </dl>

  {% elseif s.k == 'steps' %}
    <ol class="sh7-steps">
      {% for x in s.items %}
        <li class="sh7-step sh7-step--{{ x.st ?: 'next' }}"{% if x.st == 'now' %} aria-current="step"{% endif %}>
          <span class="sh7-step__n" aria-hidden="true">{{ x.st == 'done' ? '✓' : loop.index }}</span>
          <span class="sh7-step__words"><span class="sh7-step__t">{{ x.t }}</span><span class="sh7-step__sub">{{ x.sub }}</span></span>
        </li>
      {% endfor %}
    </ol>

  {% elseif s.k == 'note' %}
    <p class="sh7-note sh7-note--{{ s.tone|default('mute') }}">{{ s.text }}{% if s.cta is defined %} {{ M.action(s.cta, here, true, act) }}{% endif %}</p>

  {% elseif s.k == 'hero' %}
    <div class="sh7-hero">
      <div class="sh7-hero__top">
        <span class="sh7-tile sh7-tile--lg sh7-tile--{{ s.tone|default('ok') }}" aria-hidden="true">{{ s.ini }}</span>
        <div class="sh7-hero__words">
          <p class="sh7-hero__chips">{% for c in s.chips %}{{ M.chip(c) }}{% endfor %}</p>
          <h1 class="sh7-hero__t">{{ s.t }}</h1>
          {% if s.sub %}<p class="sh7-hero__sub">{{ s.sub }}</p>{% endif %}
        </div>
      </div>
      {% if s.facts %}<dl class="sh7-facts">{% for f in s.facts %}<div><dt>{{ f[0] }}</dt><dd>{{ f[1] }}</dd></div>{% endfor %}</dl>{% endif %}
      {% if s.acts %}<div class="sh7-hero__acts">{% for a in s.acts %}{{ M.action(a, here, false, act) }}{% endfor %}</div>{% endif %}
    </div>

  {% elseif s.k == 'agenda' %}
    <ol class="sh7-agenda">
      {% for x in s.items %}
        <li class="sh7-ag sh7-ag--{{ x.st ?: 'next' }}"><span class="sh7-ag__time">{{ x.time }}</span><span class="sh7-ag__dot" aria-hidden="true"></span>
          <span class="sh7-ag__words"><span class="sh7-ag__t">{{ x.t }}</span>{% if x.d %}<span class="sh7-ag__d">{{ x.d }}</span>{% endif %}</span></li>
      {% endfor %}
    </ol>

  {% elseif s.k == 'chart' %}
    {% set most = 0 %}{% for b in s.bars %}{% set tot = 0 %}{% for v in b.v %}{% set tot = tot + v %}{% endfor %}{% set most = max(most, tot) %}{% endfor %}
    <div class="sh7-chart">
      <dl class="sh7-kpis">{% for k in s.kpis %}<div class="sh7-kpi"><dt>{{ k.l }}</dt><dd class="sh7-kpi__v">{{ k.v }}</dd>{% if k.d is defined %}<dd class="sh7-kpi__d">{{ k.d }}</dd>{% endif %}</div>{% endfor %}</dl>
      {% if most > 0 %}
        <div class="sh7-bars" role="img" aria-label="Verified hours by week">
          {% for b in s.bars %}
            <span class="sh7-bars__col" title="{{ b.l }}">
              <span class="sh7-bars__stack">{% for v in b.v|reverse %}{% if v > 0 %}<span class="sh7-bars__seg sh7-bars__seg--{{ b.v|length - loop.index0 }}" style="height:{{ (v / most * 100)|round(1) }}%"></span>{% endif %}{% endfor %}</span>
              <span class="sh7-bars__time">{{ loop.first or loop.last or loop.index == (s.bars|length // 2) ? b.l : '' }}</span>
            </span>
          {% endfor %}
        </div>
        <ul class="sh7-legend">{% for l in s.legend %}<li><span class="sh7-legend__sw sh7-bars__seg--{{ loop.index }}" aria-hidden="true"></span>{{ l }}</li>{% endfor %}</ul>
      {% else %}
        <p class="sh7-chart__empty">No verified hours in these weeks yet.</p>
      {% endif %}
    </div>

  {% elseif s.k == 'table' %}
    <div class="sh7-table">
      {% if s.rows %}
        <table>
          <thead><tr>{% for c in s.cols %}<th scope="col"{% if c.t0 is defined %} class="sh7-t0"{% endif %}>{{ c.l }}</th>{% endfor %}</tr></thead>
          <tbody>
            {% for r in s.rows %}
              <tr>{% for c in r.cells %}<td{% if s.cols[loop.index0].t0 is defined %} class="sh7-t0"{% endif %}>
                {% if c.chip is defined %}{{ M.chip(c.chip) }}{% elseif loop.first and r.href is defined %}<a class="sh7-table__link" href="{{ r.href }}">{{ c.t }}</a>{% if c.sub is defined and c.sub %}<span class="sh7-table__sub">{{ c.sub }}</span>{% endif %}
                {% else %}<span{% if c.mono is defined and c.mono %} class="sh7-table__time"{% endif %}>{{ c.t }}</span>{% if c.sub is defined and c.sub %}<span class="sh7-table__sub">{{ c.sub }}</span>{% endif %}{% endif %}
              </td>{% endfor %}</tr>
            {% endfor %}
          </tbody>
        </table>
      {% else %}
        <p class="sh7-table__empty">{{ s.empty }}</p>
      {% endif %}
      {% if s.foot %}<p class="sh7-table__foot">{{ s.foot }}</p>{% endif %}
    </div>

  {% elseif s.k == 'form' %}
    {% if s.chips is defined %}<p class="sh7-typechips">{% for c in s.chips %}<a class="sh7-chip sh7-chip--{{ c.current ? 'ok' : 'mute' }}" href="{{ c.href }}"{% if c.current %} aria-current="true"{% endif %}>{{ c.label }}</a>{% endfor %}</p>{% endif %}
    <form class="sh7-form" method="post" action="{{ act }}">
      <input type="hidden" name="_token" value="{{ csrf_token }}"><input type="hidden" name="back" value="{{ here }}"><input type="hidden" name="do" value="{{ s.do }}">
      {% for k, v in s.hidden|default({}) %}<input type="hidden" name="{{ k }}" value="{{ v }}">{% endfor %}
      {% for g in s.groups %}
        <div class="sh7-form__block">
          <div class="sh7-form__label"><p class="sh7-form__name">{{ g.label }}</p>{% if g.help is defined and g.help %}<p class="sh7-form__help">{{ g.help }}</p>{% endif %}</div>
          <div class="sh7-form__fields">{% for f in g.fields %}{{ M.field(f) }}{% endfor %}</div>
        </div>
      {% endfor %}
      {% if s.route is defined and s.route %}<p class="sh7-form__route">{{ s.route }}</p>{% endif %}
      <p class="sh7-form__submit"><button class="sh7-btn sh7-btn--primary" type="submit">{{ s.submit }}</button></p>
    </form>

  {% elseif s.k == 'article' %}
    <div class="sh7-article">{% for p in s.paras %}<p>{{ p }}</p>{% endfor %}</div>

  {% elseif s.k == 'decide' %}
    <form class="sh7-form sh7-decide" method="post" action="{{ act }}">
      <input type="hidden" name="_token" value="{{ csrf_token }}"><input type="hidden" name="back" value="{{ here }}">
      <input type="hidden" name="do" value="request_act"><input type="hidden" name="request" value="{{ s.request }}">
      <label class="sh7-field" for="rqNote"><span class="sh7-field__label">Note for the log</span><textarea class="sh7-input" id="rqNote" name="note" rows="3"></textarea></label>
      {% if s.note %}<p class="sh7-form__help">{{ s.note }}</p>{% endif %}
      <p class="sh7-form__submit">{% for o in s.opts %}<button class="sh7-btn{{ o[2] ? ' sh7-btn--primary' }}" type="submit" name="action" value="{{ o[0] }}">{{ o[1] }}</button>{% endfor %}</p>
    </form>
  {% endif %}
</section>
{% endmacro %}
