{#
  ══════════════════════════════════════════════════════════════════════════════
  "WHO RECOGNISES" — the homepage's section 3 · HomePageV3.dc.html · §8.1 · Phase 6
  ══════════════════════════════════════════════════════════════════════════════

  Four audiences in a tablist (communities, organisations, businesses, governments), each
  with what Africa GATES does for them and ONE record card — a real recognition from a
  verified issuer, out of Services\Recognitions (GAPS §3.1). The DC's cards are samples
  ("National Honours Office", "Soko Bank"); none is drawn. An audience with no verified
  issuer yet says so in words instead of showing a card it does not have.

  Args (with … only): recognitions — Recognitions::recent()
  Without script every panel is shown, one under the other; who-recognises.js makes the
  list a tablist (arrow keys move between tabs, as WAI-ARIA's tabs pattern).
#}
{%- set _recs = recognitions|default([]) -%}
{%- set _win = _recs|filter(r => r.standing == 'winner')|first -%}
{%- set _hosted = _recs|filter(r => r.issuer.host)|first -%}
{%- set _aud = [
  {key: 'communities', label: 'Communities', title: 'Nominate the people your community already celebrates', body: 'Anyone can nominate a teacher, a nurse, a choir or a local business into an open award, then vote for them.', cta: 'Nominate someone', href: '/nominate', rec: _win ?: (_recs|first)},
  {key: 'organisations', label: 'Organisations', title: 'Run your award every year, without starting from scratch', body: 'Foundations, associations, schools and media houses set up an award once, then open a new edition each year.', cta: 'Host an award', href: '/partner', rec: _hosted ?: (_recs|length > 1 ? _recs[1] : (_recs|first))},
  {key: 'businesses', label: 'Businesses', title: 'Recognise staff, partners and suppliers in public', body: 'Long service, team awards and partner honours stay on each person’s profile, so the credit follows them through their career.', cta: 'Recognise your team', href: '/partner', rec: _recs|filter(r => r.issuer.type == 'business')|first},
  {key: 'governments', label: 'Governments', title: 'Honour citizens with a record anyone can check', body: 'Ministries, states and councils publish honours, commendations and civic awards. A government issuer is verified by hand before its first honour appears.', cta: 'Talk to us', href: '/partner', rec: _recs|filter(r => r.issuer.type == 'government')|first}
] -%}
{%- set _words = {winner: 'Winner', runner_up: 'Runner-up', finalist: 'Finalist'} -%}
<section class="who" aria-labelledby="who-h" data-who>
  <h2 class="who__h" id="who-h">{{ 'One place to recognise people, whoever you are'|trans }}</h2>
  <div class="who__tabs" role="tablist" aria-label="{{ 'Who is recognising'|trans }}" hidden data-who-tabs>
    {% for a in _aud %}
      <button type="button" class="who__tab" role="tab" id="who-t-{{ a.key }}" aria-controls="who-p-{{ a.key }}" aria-selected="{{ loop.first ? 'true' : 'false' }}" tabindex="{{ loop.first ? '0' : '-1' }}">{{ a.label|trans }}</button>
    {% endfor %}
  </div>
  {% for a in _aud %}
    <div class="who__panel" role="tabpanel" id="who-p-{{ a.key }}" aria-labelledby="who-t-{{ a.key }}" data-who-panel>
      <div class="who__stage">
        {% if a.rec %}
          {% set r = a.rec %}
          <span class="who__img">{% include 'partials/photo.twig' with r.recipient.photo ? {kind: 'person', src: r.recipient.photo|media_url, name: r.recipient.name} : {kind: 'thing', subject: 'award', src: '', name: r.award.programme} only %}</span>
          <a class="who__rec" href="{{ r.recipient.url ?: r.award.url }}">
            <span class="who__iss">
              <span class="who__ini" aria-hidden="true">{{ r.issuer.name|first|upper }}</span>
              <span class="who__iss-t">
                <span class="who__iss-n">{{ r.issuer.name }}{% if r.issuer.verified %}<svg width="14" height="14" viewBox="0 0 24 24" role="img" aria-label="{{ 'Verified issuer'|trans }}"><path d="M12 2l2.4 2.1 3.2-.3.9 3.1 2.8 1.6-1.2 3 1.2 3-2.8 1.6-.9 3.1-3.2-.3L12 22l-2.4-2.1-3.2.3-.9-3.1L2.7 15.5l1.2-3-1.2-3 2.8-1.6.9-3.1 3.2.3z" fill="var(--ag-green)"/><path d="m8 12.2 2.6 2.6L16 9.4" stroke="var(--ag-surface)" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>{% endif %}</span>
                <span class="who__iss-k">{{ 'Award'|trans }}{% if r.award.edition %} · {{ r.award.edition }}{% endif %}{% if r.issuer.host %} · {{ 'hosted by %h%'|trans({'%h%': r.issuer.host.name}) }}{% endif %}</span>
              </span>
            </span>
            <span class="who__rec-t">{{ (_words[r.standing]|default('Recognised'))|trans }} · {{ r.award.category }}</span>
            <span class="who__rec-f"><span class="who__who">{{ r.recipient.name }}</span><span class="who__meta">{{ r.issued_at ? 'Issued %d%'|trans({'%d%': r.issued_at|date('j M Y')}) ~ ' · ' }}<span class="who__ref">{{ r.reference }}</span></span></span>
          </a>
        {% else %}
          <span class="who__img">{% include 'partials/photo.twig' with {kind: 'thing', subject: 'award', src: '', name: a.label|trans} only %}</span>
          <p class="who__none">{{ a.key in ['businesses', 'governments'] ? 'No %who% issuer has been verified on Africa GATES yet. The first one’s recognitions will appear here.'|trans({'%who%': (a.key == 'businesses' ? 'business' : 'government')|trans}) : 'Recognitions appear here once an award is announced.'|trans }}</p>
        {% endif %}
      </div>
      <div class="who__bar">
        <div class="who__bar-t"><span class="who__t">{{ a.title|trans }}</span><span class="who__b">{{ a.body|trans }}</span></div>
        <a class="who__cta" href="{{ a.href }}">{{ a.cta|trans }}</a>
      </div>
    </div>
  {% endfor %}
</section>
