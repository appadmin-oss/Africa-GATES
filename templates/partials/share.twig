{# Reusable social share row. Optional context: share_url (default canonical), share_text. #}
{% set _su = share_url|default(canonical_url|default((site_url|default('')) ~ (request_path|default('/')))) %}
{% set _st = share_text|default(og_title|default(page_title|default('Africa GATES'))) %}
<div class="ag-share" x-data="agShare()" data-url="{{ _su }}" data-text="{{ _st }}">
  <span class="ag-share__label">Share</span>
  <a class="ag-share__btn ag-share__btn--x" href="https://twitter.com/intent/tweet?url={{ _su|url_encode }}&text={{ _st|url_encode }}" target="_blank" rel="noopener" aria-label="Share on X (Twitter)"><svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24h-6.66l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231 5.45-6.231Zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77Z"/></svg></a>
  <a class="ag-share__btn ag-share__btn--wa" href="https://wa.me/?text={{ (_st ~ ' — ' ~ _su)|url_encode }}" target="_blank" rel="noopener" aria-label="Share on WhatsApp"><svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.9-4.45 9.9-9.91C21.95 6.45 17.5 2 12.04 2Zm5.8 14.16c-.25.69-1.43 1.32-1.97 1.36-.5.07-1.14.1-1.84-.12-.42-.13-.97-.31-1.66-.61-2.92-1.26-4.83-4.2-4.98-4.4-.14-.2-1.18-1.57-1.18-3s.75-2.13 1.02-2.42c.27-.29.58-.36.77-.36l.55.01c.18.01.42-.07.65.5.25.6.84 2.07.91 2.22.07.15.12.32.02.52-.1.2-.15.32-.29.5-.15.17-.31.39-.44.52-.15.15-.3.31-.13.6.17.29.76 1.25 1.63 2.02 1.12.99 2.06 1.3 2.35 1.45.29.15.46.12.63-.07.17-.2.73-.85.92-1.14.2-.29.39-.24.66-.15.27.1 1.7.8 1.99.95.29.15.49.22.56.34.07.12.07.69-.18 1.38Z"/></svg></a>
  <a class="ag-share__btn ag-share__btn--fb" href="https://www.facebook.com/sharer/sharer.php?u={{ _su|url_encode }}" target="_blank" rel="noopener" aria-label="Share on Facebook"><svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5 3.66 9.15 8.44 9.94v-7.03H7.9v-2.9h2.54V9.85c0-2.51 1.49-3.9 3.78-3.9 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.78-1.63 1.57v1.88h2.78l-.44 2.9h-2.34V22c4.78-.79 8.43-4.94 8.43-9.94Z"/></svg></a>
  <a class="ag-share__btn ag-share__btn--li" href="https://www.linkedin.com/sharing/share-offsite/?url={{ _su|url_encode }}" target="_blank" rel="noopener" aria-label="Share on LinkedIn"><svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.8 0 0 .78 0 1.74v20.52C0 23.22.8 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.74V1.74C24 .78 23.2 0 22.22 0Z"/></svg></a>
  <button type="button" class="ag-share__btn ag-share__btn--copy" @click="copy()" aria-label="Copy link or share"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4"/></svg><span x-text="copied ? 'Copied ✓' : 'Copy'"></span></button>
</div>
<style>
  .ag-share{ display:inline-flex; align-items:center; gap:8px; flex-wrap:wrap; }
  .ag-share__label{ font-size:12px; font-weight:600; letter-spacing:.04em; text-transform:uppercase; color:#5f7273; }
  .ag-share__btn{ display:inline-flex; align-items:center; gap:6px; border:1px solid rgba(16,41,44,.14); background:var(--ag-surface,#fff); color:var(--ag-ink,#10292C); border-radius:999px; padding:8px 12px; font:600 13px/1 inherit; cursor:pointer; text-decoration:none; transition:border-color .15s, color .15s, background .15s; }
  .ag-share__btn:hover{ border-color:var(--ag-green,#237b22); color:var(--ag-green,#237b22); }
  .ag-share__btn--x:hover{ border-color:#111; color:#111; }
  .ag-share__btn--wa:hover{ border-color:#25d366; color:#1ba84f; }
  .ag-share__btn--fb:hover{ border-color:#1877f2; color:#1877f2; }
  .ag-share__btn--li:hover{ border-color:#0a66c2; color:#0a66c2; }
</style>
<script nonce="{{ csp_nonce }}">
if (!window.agShare) window.agShare = function(){
  return {
    copied:false, _t:null,
    async copy(){
      var url = this.$root.dataset.url, text = this.$root.dataset.text;
      try { if (navigator.share){ await navigator.share({ title:text, url:url }); return; } } catch(e){ if(e && e.name==='AbortError') return; }
      try { await navigator.clipboard.writeText(url); } catch(e){}
      this.copied = true; var self=this; clearTimeout(this._t); this._t = setTimeout(function(){ self.copied=false; }, 2000);
    }
  };
};
</script>
