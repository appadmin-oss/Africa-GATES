{# A bounced checkout's own values, merged over a complete blank shape so every key
   exists whatever the caller passed. `pages/shop/item.twig` includes this partial without
   a `checkout_retry` at all (nothing bounces to a product page), and this way that include
   needs no special case — and the template keeps working if `strict_variables` is ever
   turned on. #}
{% set retry = {'name':'','email':'','phone':'','address':'','region':'','provider':'','discount':'','any':false}
               |merge(checkout_retry|default({})) %}
{# Shared shop cart — FAB + drawer + checkout modal. Uses the global Alpine
   $store.cart (registered below). Caller must render this INSIDE an x-data scope
   and provide `providers` (array of {id,label}) + csrf_token. #}
<style nonce="{{ csp_nonce }}">
  /* Anchored bottom-LEFT so it never collides with the sitewide right-edge
     FAB stack (Gee · Community · Back-to-top). */
  .sc-fab{ position:fixed; left:22px; bottom:22px; z-index:80; width:56px; height:56px; border-radius:50%; border:none; cursor:pointer; background:#10292C; color:#fff; display:flex; align-items:center; justify-content:center; box-shadow:0 14px 30px -12px rgba(16,41,44,.6); }
  .sc-fab__n{ position:absolute; top:-3px; right:-3px; min-width:20px; height:20px; padding:0 5px; border-radius:999px; background:#e0245e; color:#fff; font:700 11px/20px var(--ag-font-mono,monospace); }
  .sc-ov{ position:fixed; inset:0; z-index:90; background:rgba(5,12,13,.5); backdrop-filter:blur(3px); }
  .sc-drawer{ position:absolute; top:0; right:0; bottom:0; width:400px; max-width:92vw; background:#fbfbfa; display:flex; flex-direction:column; box-shadow:-20px 0 50px -20px rgba(0,0,0,.4); }
  .sc-hd{ display:flex; align-items:center; justify-content:space-between; padding:20px 22px; border-bottom:1px solid rgba(16,41,44,.08); }
  .sc-hd h2{ margin:0; font-family:var(--ag-font-display,serif); font-weight:700; font-size:19px; color:#10292C; }
  .sc-x{ cursor:pointer; border:1px solid rgba(16,41,44,.12); background:#fff; width:34px; height:34px; border-radius:50%; font-size:18px; color:#10292C; }
  .sc-lines{ flex:1; overflow-y:auto; padding:16px 22px; display:flex; flex-direction:column; gap:13px; }
  .sc-line{ display:flex; gap:12px; align-items:center; }
  .sc-line__img{ flex:none; width:56px; height:56px; border-radius:11px; background-size:cover; background-position:center; }
  .sc-line__b{ flex:1; min-width:0; }
  .sc-line__n{ font-weight:600; font-size:13.5px; color:#10292C; }
  .sc-line__p{ font-size:12px; color:#5a6d6f; }
  .sc-qty{ display:flex; align-items:center; gap:8px; }
  /* 40px on touch: these change what somebody is about to buy, and a mis-tap on the
     minus at quantity 1 used to delete the line outright. 26px cleared WCAG 2.5.8's
     24px floor by two pixels and nothing else. */
  .sc-qty button{ cursor:pointer; width:32px; height:32px; border-radius:9px; border:1px solid rgba(16,41,44,.14); background:#fff; font-size:16px; color:#10292C; }
  @media (hover:none){ .sc-qty button{ width:40px; height:40px; font-size:18px; } }
  .sc-qty span{ font:700 13px var(--ag-font-mono,monospace); min-width:14px; text-align:center; }
  .sc-empty{ text-align:center; padding:50px 20px; color:#5a6d6f; font-size:14px; }
  .sc-ft{ padding:18px 22px; border-top:1px solid rgba(16,41,44,.08); }
  .sc-sub{ display:flex; align-items:center; justify-content:space-between; margin-bottom:13px; }
  .sc-sub span:first-child{ font-size:14px; color:#4a5256; }
  .sc-sub b{ font:700 18px var(--ag-font-mono,monospace); color:#10292C; }
  .sc-go{ display:block; width:100%; text-align:center; cursor:pointer; border:none; background:#237b22; color:#fff; font-family:inherit; font-weight:600; font-size:15px; padding:14px; border-radius:999px; }
  .sc-go:hover{ background:#1a6118; }
  .sc-modal{ position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); width:460px; max-width:94vw; max-height:92vh; overflow-y:auto; background:#fbfbfa; border-radius:22px; box-shadow:0 40px 90px -30px rgba(0,0,0,.6); }
  .sc-co{ padding:22px; }
  .sc-co h2{ margin:0 0 14px; font-family:var(--ag-font-display,serif); font-weight:700; font-size:20px; color:#10292C; }
  .sc-card{ background:#fff; border:1px solid rgba(16,41,44,.08); border-radius:14px; padding:15px; }
  .sc-srow{ display:flex; justify-content:space-between; font-size:13.5px; color:#4a5256; }
  .sc-srow + .sc-srow{ margin-top:8px; }
  .sc-srow.tot{ font-size:15px; font-weight:600; color:#10292C; padding-top:12px; margin-top:12px; border-top:1px solid rgba(16,41,44,.08); }
  .sc-mono{ font-family:var(--ag-font-mono,monospace); font-weight:700; }
  .sc-field{ margin-top:11px; }
  .sc-field label{ display:block; font-size:12px; font-weight:600; color:#4a5256; margin-bottom:5px; }
  /* 16px, not 14: below 16 Safari on iOS zooms the viewport on focus, and it does it on
     every field of a checkout that is mostly used on a phone. */
  .sc-field input, .sc-field select, .sc-field textarea{ width:100%; border:1px solid rgba(16,41,44,.16); border-radius:11px; padding:12px 14px; font-family:inherit; font-size:16px; color:#10292C; outline:none; background:#fff; }
  .sc-field input:focus, .sc-field select:focus, .sc-field textarea:focus{ border-color:#237b22; box-shadow:0 0 0 3px rgba(35,123,34,.1); }
  .sc-prov{ display:flex; gap:9px; flex-wrap:wrap; margin-top:6px; }
  .sc-prov label{ flex:1; min-width:120px; display:flex; align-items:center; justify-content:flex-start; gap:9px; border:1.5px solid rgba(16,41,44,.14); border-radius:11px; padding:11px 13px; cursor:pointer; font-size:13.5px; font-weight:600; color:#10292C; }
  /* `width:auto`, because `.sc-field input` sets width:100% and a radio button matched it —
     the control stretched across the row and pushed its own label to the far right. */
  .sc-prov input{ accent-color:#237b22; width:auto; flex:none; margin:0; }
  .sc-soon{ background:#fff8df; border:1px solid #ecdca0; color:#7a5a08; border-radius:12px; padding:14px 16px; font-size:13.5px; line-height:1.5; }
  .sc-soon a{ color:#237b22; font-weight:600; }
  .sc-toast{ position:fixed; left:50%; bottom:90px; transform:translateX(-50%); z-index:95; background:#10292C; color:#fff; font-size:13.5px; font-weight:500; padding:12px 20px; border-radius:999px; box-shadow:0 16px 40px -12px rgba(0,0,0,.5); display:flex; align-items:center; gap:12px; max-width:92vw; }
  .sc-toast__undo{ flex:none; cursor:pointer; border:1px solid rgba(255,255,255,.34); background:transparent; color:#fff; font-family:inherit; font-size:13px; font-weight:700; padding:6px 13px; border-radius:999px; }
  .sc-toast__undo:hover{ background:rgba(255,255,255,.12); }
  /* The focused dialog itself must show a ring — it takes focus on open, and without this
     a keyboard user is given no indication of where they landed. */
  .sc-drawer:focus-visible, .sc-modal:focus-visible{ outline:3px solid #237b22; outline-offset:-3px; }
  /* the variant a line is for — the difference between two cart rows that look identical */
  .sc-line__v{ display:inline-block; margin-top:3px; font-size:11px; font-weight:700; letter-spacing:.04em; text-transform:uppercase; color:#4a5256; background:#eef2ee; padding:2px 8px; border-radius:999px; }
  /* discount code */
  .sc-code{ display:flex; gap:8px; margin-top:6px; }
  .sc-code input{ flex:1; min-width:0; text-transform:uppercase; letter-spacing:.04em; }
  .sc-code button{ flex:none; cursor:pointer; border:1px solid rgba(16,41,44,.16); background:#fff; color:#10292C; font-family:inherit; font-size:13px; font-weight:600; padding:0 15px; border-radius:11px; }
  .sc-code button:disabled{ opacity:.5; cursor:not-allowed; }
  .sc-note{ font-size:12.5px; font-weight:600; margin-top:7px; }
  .sc-note--ok{ color:#1a6118; }
  .sc-note--no{ color:#8a5a00; }
  .sc-warn{ background:#fff8df; border:1px solid #ecdca0; color:#7a5a08; border-radius:11px; padding:10px 13px; font-size:12.5px; line-height:1.55; margin-bottom:12px; }
  .sc-warn ul{ margin:5px 0 0; padding-left:18px; }
  .sc-nudge{ font-size:12px; color:#5a6d6f; margin-top:6px; }
  /* clear the full-width mobile bottom nav (same offset as the Gee launcher) */
  @media(max-width:560px){ .sc-fab{ left:18px; bottom:calc(84px + env(safe-area-inset-bottom,0px)); } }
</style>

{# FAB #}
<button class="sc-fab" x-show="$store.cart.count > 0" x-cloak @click="$store.cart.open = true" aria-label="Open cart">
  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="9" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2 3h3l2.4 12.4a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 2-1.6L23 7H6"/></svg>
  <span class="sc-fab__n" x-text="$store.cart.count"></span>
</button>

{# Drawer #}
<div class="sc-ov" x-show="$store.cart.open" x-cloak
     x-data="scDialog('open')" x-effect="sync()"
     @keydown.escape.window="close()" @click="close()">
  <aside class="sc-drawer" x-ref="panel" tabindex="-1" @click.stop @keydown.tab="cycle($event)"
         role="dialog" aria-modal="true" aria-labelledby="scCartTitle">
    <div class="sc-hd"><h2 id="scCartTitle">Your cart</h2><button class="sc-x" @click="close()" aria-label="Close cart">×</button></div>
    <div class="sc-lines">
      {# Keyed by `key`, not `slug`. A shirt in M and the same shirt in XL are two lines,
         and keying on the slug made the second choice overwrite the first. #}
      <template x-for="l in $store.cart.lines" :key="l.key">
        <div class="sc-line">
          <span class="sc-line__img" :style="l.cover ? 'background-image:url('+l.cover+')' : 'background:linear-gradient(135deg,#10292C,#1a6118)'"></span>
          <div class="sc-line__b">
            <div class="sc-line__n" x-text="l.name"></div>
            <span class="sc-line__v" x-show="l.variant" x-cloak x-text="l.variant"></span>
            <div class="sc-line__p" x-text="$store.cart.ngn(l.price)"></div>
          </div>
          <div class="sc-qty">
            <button @click="$store.cart.dec(l.key)"
                    :aria-label="l.qty > 1 ? ('Decrease quantity of ' + l.name) : ('Remove ' + l.name + ' from cart')">−</button>
            <span x-text="l.qty"></span>
            <button @click="$store.cart.inc(l.key)" :aria-label="'Increase quantity of ' + l.name">+</button>
          </div>
        </div>
      </template>
      <div class="sc-empty" x-show="$store.cart.count===0">Your cart is empty.</div>
    </div>
    <div class="sc-ft" x-show="$store.cart.count>0" x-cloak>
      <div class="sc-sub"><span>Subtotal</span><b x-text="$store.cart.ngn($store.cart.subtotal)"></b></div>
      {% if ship_active|default(false) and ship_free_over|default(0) %}
      {# The number that turns a delivery charge into a reason to add one more thing. Shown
         from the cart's own subtotal so it updates as they change their mind, and the server
         re-quotes it for real at checkout. #}
      <p class="sc-nudge" x-show="$store.cart.subtotal < {{ ship_free_over }}" x-cloak
         x-text="'Spend ' + $store.cart.ngn({{ ship_free_over }} - $store.cart.subtotal) + ' more for free delivery.'"></p>
      <p class="sc-nudge" style="color:#1a6118;font-weight:600" x-show="$store.cart.subtotal >= {{ ship_free_over }}" x-cloak>✓ Free delivery on this order.</p>
      {% endif %}
      <button class="sc-go" @click="$store.cart.toCheckout()">Checkout →</button>
    </div>
  </aside>
</div>

{# Checkout modal #}
<div class="sc-ov" x-show="$store.cart.checkoutOpen" x-cloak
     x-data="scDialog('checkoutOpen')" x-effect="sync()"
     @keydown.escape.window="close()" @click="close()">
  <div class="sc-modal" x-ref="panel" tabindex="-1" @click.stop @keydown.tab="cycle($event)"
       role="dialog" aria-modal="true" aria-labelledby="scCheckoutTitle">
    <div class="sc-hd"><h2 id="scCheckoutTitle">Checkout</h2><button class="sc-x" @click="close()" aria-label="Close checkout">×</button></div>
    <div class="sc-co">
      {# What we changed while pricing it — a sold-out line dropped, a quantity trimmed.
         Silence here is how a total stops matching the last screen somebody saw. #}
      <div class="sc-warn" x-show="$store.cart.adjusted.length" x-cloak>
        <strong>Your basket changed:</strong>
        <ul><template x-for="a in $store.cart.adjusted" :key="a"><li x-text="a"></li></template></ul>
      </div>

      <div class="sc-card" style="margin-bottom:14px">
        <template x-for="l in $store.cart.lines" :key="l.key">
          <div class="sc-srow">
            <span><span x-text="l.name"></span><span x-show="l.variant" x-text="' (' + l.variant + ')'"></span> × <span x-text="l.qty"></span></span>
            <span class="sc-mono" x-text="$store.cart.ngn(l.price*l.qty)"></span>
          </div>
        </template>
        {# The server's own breakdown once it has answered. Before that the goods line is the
           browser's arithmetic, which is a preview — the charged figure is decided server-side
           in ShopCheckoutController::totals() and re-decided there at checkout. #}
        <div class="sc-srow" style="padding-top:10px;margin-top:10px;border-top:1px solid rgba(16,41,44,.08)">
          <span>Goods</span><span class="sc-mono" x-text="$store.cart.ngn($store.cart.q.goods ?? $store.cart.subtotal)"></span>
        </div>
        <div class="sc-srow" x-show="($store.cart.q.discount || 0) > 0" x-cloak style="color:#1a6118">
          <span>Discount<span x-show="$store.cart.q.code" x-text="' (' + $store.cart.q.code + ')'"></span></span>
          <span class="sc-mono" x-text="'−' + $store.cart.ngn($store.cart.q.discount)"></span>
        </div>
        <div class="sc-srow" x-show="$store.cart.q.charged !== undefined" x-cloak>
          <span>Delivery <span style="color:var(--ag-ink-soft,#626a6e)" x-text="$store.cart.q.shipping_why || ''"></span></span>
          <span class="sc-mono" x-text="($store.cart.q.shipping || 0) > 0 ? $store.cart.ngn($store.cart.q.shipping) : 'Free'"></span>
        </div>
        <div class="sc-srow tot"><span>Total</span><span class="sc-mono" x-text="$store.cart.ngn($store.cart.due)"></span></div>
        {% if currency is defined and currency != 'NGN' %}<div class="sc-srow" style="margin-top:8px;font-size:12px;color:#5a6d6f"><span>Charged in Naira</span><span class="sc-mono" x-text="$store.cart.ngnRaw($store.cart.due)"></span></div>{% endif %}
        <p class="sc-nudge" x-show="($store.cart.q.short_by || 0) > 0" x-cloak
           x-text="'Add ' + $store.cart.ngn($store.cart.q.short_by) + ' more and delivery is free.'"></p>
      </div>

      {% if providers is empty %}
        <div class="sc-soon">Online checkout is being set up. To order now, <a href="/partner">contact our team</a> and we’ll arrange payment & delivery.</div>
      {% else %}
        <form method="post" action="/shop/checkout">
          <input type="hidden" name="_token" value="{{ csrf_token }}">
          <input type="hidden" name="cart" :value="JSON.stringify($store.cart.items)">
          <input type="hidden" name="discount" :value="$store.cart.code">
          {# ── AUTOFILL ──────────────────────────────────────────────────────
             `autocomplete` on every field that describes the buyer. These had none, so a
             phone that already knows this person's name, email and address could not offer
             any of it, and all five fields were typed by hand on the smallest screen we
             serve. The free-vote ballot already does this correctly; the shop did not. #}
          <div class="sc-field"><label for="scCoName">Full name</label><input id="scCoName" type="text" name="name" required autocomplete="name" placeholder="Your name" value="{{ retry.name }}"></div>
          <div class="sc-field"><label for="scCoEmail">Email</label><input id="scCoEmail" type="email" name="email" required autocomplete="email" placeholder="you@email.com" x-model="$store.cart.email" @change="$store.cart.quote()"></div>
          <div class="sc-field"><label for="scCoPhone">Phone</label><input id="scCoPhone" type="tel" name="phone" required autocomplete="tel" placeholder="+234…" value="{{ retry.phone }}"></div>

          {# Region BEFORE the address, because it is what delivery is priced from — and the
             address no longer asks for the state and country a second time. It used to say
             "Street, city, state, country" with this select sitting under it, so the zone was
             entered twice: once as prose the courier reads, once as the field the price comes
             from, with no way to see when the two disagreed. #}
          <div class="sc-field"><label for="scCoRegion">Delivery region <span style="font-weight:400;color:var(--ag-ink-soft,#626a6e)">(sets your delivery cost)</span></label>
            <select id="scCoRegion" name="region" required autocomplete="address-level1" x-model="$store.cart.region" @change="$store.cart.quote()">
              <option value="" disabled>Select your region…</option>
              {% for r in shop_regions %}<option value="{{ r }}">{{ r }}</option>{% endfor %}
            </select>
          </div>
          {# Kept as one freeform line on purpose: postcodes are unreliable across much of the
             continent and informal directions are normal, so a rigid split-field address form
             would lose detail a courier actually needs. `street-address` lets it autofill
             anyway. #}
          <div class="sc-field"><label for="scCoAddress">Delivery address</label><textarea id="scCoAddress" name="address" rows="2" required autocomplete="street-address" placeholder="Street, area and city — plus any landmark that helps the courier find you">{{ retry.address }}</textarea></div>
          {# ── DISCOUNT CODE ───────────────────────────────────────────────────
             A preview only: ShopCheckoutController::totals() prices it again from the code
             row at checkout, so what is shown here cannot change what anybody is charged. #}
          <div class="sc-field">
            <label for="scCoCode">Discount code <span style="font-weight:400;color:var(--ag-ink-soft,#626a6e)">(optional)</span></label>
            <div class="sc-code">
              <input id="scCoCode" x-model="$store.cart.code" placeholder="GATES10" autocomplete="off"
                     @keydown.enter.prevent="$store.cart.quote()">
              <button type="button" :disabled="$store.cart.quoting || !$store.cart.code.trim()"
                      @click="$store.cart.quote()" x-text="$store.cart.quoting ? '…' : 'Apply'"></button>
            </div>
            <p class="sc-note sc-note--ok" x-show="$store.cart.q.applied" x-cloak x-text="$store.cart.q.note"></p>
            <p class="sc-note sc-note--no" x-show="$store.cart.q.note && !$store.cart.q.applied" x-cloak x-text="$store.cart.q.note"></p>
          </div>
          <div class="sc-field"><label>Pay with</label>
            <div class="sc-prov">
              {% for pv in providers %}
              <label><input type="radio" name="provider" value="{{ pv.id }}" {% if retry.provider == pv.id or (retry.provider == '' and loop.first) %}checked{% endif %}> {{ pv.label }}</label>
              {% endfor %}
            </div>
          </div>
          <button type="submit" class="sc-go" style="margin-top:16px" :disabled="$store.cart.count===0">
            Pay <span x-text="$store.cart.ngn($store.cart.due)"></span> securely →
          </button>
          <p style="margin:10px 0 0;text-align:center;font-size:11.5px;color:#5a6d6f">Secure payment via the gateway — your card details never touch our servers.</p>
        </form>
      {% endif %}
    </div>
  </div>
</div>

{# role="status" on the wrapper, so the message is announced without the Undo button being
   read as part of it. The button is a real control, not a second reading of the text. #}
<div class="sc-toast" x-show="$store.cart.toast" x-cloak>
  <span role="status" x-text="$store.cart.toast"></span>
  <button type="button" class="sc-toast__undo" x-show="$store.cart.undoable" x-cloak
          @click="$store.cart.undo()">Undo</button>
</div>

<script nonce="{{ csp_nonce }}">
window.AG_FX = {{ {cur: currency|default('NGN'), rate: fx_rate|default(1), sym: fx_symbol|default('₦')}|json_encode|raw }};
/* ── Dialog behaviour for the cart drawer and the checkout modal ───────────────
 *
 * Both carry role="dialog" aria-modal="true". They previously had none of the three things
 * that makes that markup true: nothing moved focus in, Tab walked straight out into the page
 * behind — a page aria-modal has just told a screen reader is not there — and Escape did
 * nothing, leaving a backdrop click as the only way out. Every other dialog in this codebase
 * (gee.js, community-modal.js, ag-search.js, admin.js) already handles Escape; the cart was
 * the one that did not.
 *
 * Hand-rolled because no Alpine focus plugin is loaded, so `x-trap` would be an attribute
 * nothing reads. Same shape as the sheets in pages/my-work/interview.twig. */
window.scDialog = (flag) => ({
  returnTo: null, wasOpen: false,

  get _cart(){ return Alpine.store('cart'); },

  /* Driven by x-effect, so it runs whenever the store's flag changes. */
  sync(){
    const now = !!this._cart[flag];
    if (now === this.wasOpen) return;
    this.wasOpen = now;
    if (now) {
      this.returnTo = document.activeElement;
      /* The dialog itself takes focus, not its first control: focusing the first button
         scrolls a long checkout past its own heading, so it opens mid-form with no
         indication of what it is. Tab still walks inward from here. */
      this.$nextTick(() => { if (this.$refs.panel) this.$refs.panel.focus({ preventScroll: true }); });
    } else {
      const back = this.returnTo;
      this.returnTo = null;
      /* Without this, closing drops the caret at the top of the document and a keyboard
         user walks the whole shop again to get back to where they were. Skipped when the
         opener was <body> — which is the case when a bounced checkout reopens this on page
         load, and there is nothing meaningful to go back to. */
      if (back && back !== document.body && back.focus) back.focus();
    }
  },

  close(){ this._cart[flag] = false; },

  focusables(){
    const el = this.$refs.panel;
    if (!el) return [];
    return Array.from(el.querySelectorAll(
      'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
    )).filter(n => !n.disabled && n.offsetParent !== null);
  },

  cycle(e){
    const f = this.focusables();
    if (!f.length) return;
    const first = f[0], last = f[f.length - 1];
    // Focus sits on the panel itself on open, which is neither end of the list — Tab from
    // there has to land inside rather than escaping to the page behind.
    if (document.activeElement === this.$refs.panel) {
      e.preventDefault();
      (e.shiftKey ? last : first).focus();
      return;
    }
    if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
  },
});

document.addEventListener('alpine:init', () => {
  Alpine.store('cart', {
    items: {}, open: false, checkoutOpen: false, toast: '', _t: null,
    /* Discount + delivery state. `q` is the SERVER's answer and nothing here computes it:
       ShopCheckoutController::totals() decides what is owed, and the same function runs again
       at checkout, so a number edited in this object changes what somebody is SHOWN and never
       what they are charged. */
    /* Seeded from a bounced checkout when there is one, so the modal reopens with the
       buyer's own details rather than blank. See ShopCheckoutController::takeRetry(). */
    code: {{ retry.discount|json_encode|raw }},
    email: {{ retry.email|json_encode|raw }},
    region: {{ (retry.region ?: region|default(''))|json_encode|raw }},
    q: {}, quoting: false, adjusted: [], _qt: null,
    /* The last line a minus-tap removed, held only long enough to put it back. */
    removed: null, undoable: false,

    init(){ try { this.items = JSON.parse(localStorage.getItem('afg_cart') || '{}') || {}; } catch (e) { this.items = {}; }
      this.migrate();
      /* Bounced out of checkout: reopen it, already filled in. Without this the buyer lands
         on the shop with a notice, and has to find the cart and the Checkout button again
         before discovering whether anything they typed survived. */
      if ({{ retry.any ? 'true' : 'false' }} && this.count > 0) {
        this.checkoutOpen = true;
        this.quote();
      }
    },

    /* Cart → checkout, as one named step rather than three statements in an @click. */
    toCheckout(){ this.open = false; this.checkoutOpen = true; this.quote(); },
    save(){ try { localStorage.setItem('afg_cart', JSON.stringify(this.items)); } catch (e) {} },

    /* A cart saved before variants existed is keyed by slug and has no `key`. Repaired in
       place rather than discarded — somebody who added three things last week and comes back
       to an empty basket has been robbed of the only state this shop keeps for them. */
    migrate(){
      var fixed = false;
      for (var k in this.items) {
        var l = this.items[k];
        if (!l || typeof l !== 'object') { delete this.items[k]; fixed = true; continue; }
        if (!l.key) { l.key = k; l.variant = l.variant || ''; l.variant_id = l.variant_id || 0; fixed = true; }
      }
      if (fixed) this.save();
    },

    /* `slug|variantId`, matching ShopCheckoutController::key() exactly. The server resolves
       the pairing again and refuses a variant that belongs to another product, so this is a
       convenience for the browser rather than something trusted. */
    keyFor(slug, vid){ return (vid && +vid > 0) ? slug + '|' + (+vid) : slug; },

    add(p){
      if (!p || !p.slug) return;
      const k = this.keyFor(p.slug, p.variant_id);
      if (this.items[k]) this.items[k].qty += (p.qty || 1);
      else this.items[k] = { key: k, slug: p.slug, variant_id: +p.variant_id || 0,
                             variant: p.variant || '', name: p.name,
                             price: +p.price || 0, cover: p.cover || '', qty: p.qty || 1 };
      this.save();
      this.ping((p.name || 'Item') + (p.variant ? ' (' + p.variant + ')' : '') + ' added to cart');
      this.open = true;
      /* The quote goes stale the moment the basket changes — a free-delivery threshold that
         was met a second ago may not be now. Debounced so five taps make one request. */
      this.requote();
    },
    inc(k){ if (this.items[k]) { this.items[k].qty++; this.save(); this.requote(); } },
    /* A minus-tap at quantity 1 removes the line, and a 40px control next to a 40px control
       gets mis-tapped. The line is kept for as long as the toast is up so it can come back,
       rather than being confirmed away with a dialog nobody wants on every decrement. */
    dec(k){
      const l = this.items[k]; if (!l) return;
      if (l.qty > 1) { l.qty--; this.save(); this.requote(); return; }
      this.removed = JSON.parse(JSON.stringify(l));
      delete this.items[k];
      this.save(); this.requote();
      this.ping((l.name || 'Item') + ' removed', true);
    },
    undo(){
      if (!this.removed) return;
      this.items[this.removed.key] = this.removed;
      this.removed = null; this.undoable = false; this.toast = '';
      this.save(); this.requote();
    },

    get lines(){ return Object.values(this.items); },
    get count(){ return this.lines.reduce((a, i) => a + i.qty, 0); },
    get subtotal(){ return this.lines.reduce((a, i) => a + i.price * i.qty, 0); },
    /* What the button says to pay. The server's figure when it has one, the browser's
       arithmetic before that — never a mix of the two. */
    get due(){ return this.q.charged !== undefined ? this.q.charged : this.subtotal; },

    requote(){ clearTimeout(this._qt); this._qt = setTimeout(() => this.quote(), 400); },

    async quote(){
      if (this.count === 0) { this.q = {}; this.adjusted = []; return; }
      this.quoting = true;
      try {
        var r = await fetch('/shop/quote', {
          method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({ _token: {{ csrf_token|json_encode|raw }},
                                      cart: JSON.stringify(this.items),
                                      region: this.region || '',
                                      discount: this.code.trim(), email: this.email })
        });
        var d = await r.json().catch(function(){ return {}; });
        if (d && d.success) { this.q = d; this.adjusted = d.adjusted || []; }
      } catch (e) { /* a failed preview must never block a checkout: the server prices it
                       again on submit, and `due` falls back to the browser subtotal. */ }
      finally { this.quoting = false; }
    },

    ngn(n){ n = Number(n) || 0; var fx = window.AG_FX || {}; if (fx.cur && fx.cur !== 'NGN' && fx.rate) { var v = n * fx.rate; return (fx.sym || '') + v.toLocaleString(undefined, { maximumFractionDigits: v < 100 ? 2 : 0 }); } return '₦' + n.toLocaleString(); },
    ngnRaw(n){ return '₦' + (Number(n) || 0).toLocaleString(); },
    ping(m, undoable){
      this.toast = m;
      this.undoable = !!undoable;
      clearTimeout(this._t);
      /* Longer when there is something to undo — 1.8s is not enough time to read a message
         and decide to reverse it. */
      this._t = setTimeout(() => { this.toast = ''; this.undoable = false; this.removed = null; },
                           undoable ? 7000 : 1800);
    },
  });
});
</script>
