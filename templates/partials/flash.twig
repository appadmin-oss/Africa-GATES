{#
  The public flash rail — what a POST handler says after it redirects.

  `flash_error` is an alert (it interrupts: something the person did was refused);
  `flash_ok` and `flash_notice` are status (polite). Each carries its words as text and
  a mark that is `aria-hidden` — the colour and the mark are never the only signal
  (REFERENCE §13). Rebuilt with the shell because the old layout's rail was destroyed
  with it (docs/handoff/inventory/_partials.md, MUST RESTORE): before a rail existed, a
  controller that wrote "applications for this event are closed" and redirected showed
  the visitor nothing — indistinguishable from a broken link.
#}
{% if flash_error or flash_ok or flash_notice %}
  <div class="ag-flash-rail">
    {% if flash_error %}
      <p class="ag-flash ag-flash--error" role="alert">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7.5v5.5M12 16.5h.01"></path></svg>
        <span>{{ flash_error }}</span>
      </p>
    {% endif %}
    {% if flash_ok %}
      <p class="ag-flash ag-flash--ok" role="status">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10.5 8.5 15 16 5.5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        <span>{{ flash_ok }}</span>
      </p>
    {% endif %}
    {% if flash_notice %}
      <p class="ag-flash ag-flash--notice" role="status">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 11v5.5M12 7.5h.01"></path></svg>
        <span>{{ flash_notice }}</span>
      </p>
    {% endif %}
  </div>
{% endif %}
