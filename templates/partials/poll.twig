{# Reusable poll widget. Expects a `poll` payload from CommunityService::getPoll
   (id, question, options[{index,label,count,pct}], total, multi, is_closed, my_votes[]).
   Works for both thread polls and blog-post polls — votes go to /api/community/poll. #}
{% if poll %}
<div class="ag-poll" x-data="pollApp({{ poll|json_encode|e('html_attr') }})" style="margin-top:18px;border:1px solid rgba(16,41,44,.1);border-radius:14px;padding:16px 18px;background:#f9fbf8">
  <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:10px;margin-bottom:12px">
    <div style="font-weight:700;font-size:15px;color:var(--ag-ink,#10292C)" x-text="poll.question"></div>
    <span x-show="poll.multi" x-cloak style="flex:none;font-size:11px;font-weight:600;color:#5a6d6f;background:#eef4ee;border-radius:999px;padding:3px 9px">Select multiple</span>
  </div>
  <template x-for="o in poll.options" :key="o.index">
    <button type="button" @click="vote(o.index)" :disabled="busy || poll.is_closed" :aria-pressed="chosen(o.index)"
      style="display:block;width:100%;text-align:left;border:1px solid rgba(16,41,44,.12);background:#fff;border-radius:10px;padding:10px 13px;margin-bottom:8px;cursor:pointer;position:relative;overflow:hidden;font-family:inherit;transition:border-color .15s"
      :style="chosen(o.index) ? 'border-color:#237b22' : ''">
      <span :style="`position:absolute;inset:0;width:${voted ? o.pct : 0}%;background:#e7f3e6;transition:width .4s`" aria-hidden="true"></span>
      <span style="position:relative;display:flex;justify-content:space-between;align-items:center;gap:10px">
        <span :style="chosen(o.index) ? 'font-weight:700;color:#1a6118' : 'color:#283133'"><span x-show="chosen(o.index)">✓ </span><span x-text="o.label"></span></span>
        <span x-show="voted" x-cloak style="font-size:12.5px;font-weight:700;color:#5a6d6f" x-text="o.pct+'%'"></span>
      </span>
    </button>
  </template>
  <div style="font-size:12px;color:#5f7273;margin-top:4px">
    <span x-text="poll.total"></span> vote<span x-show="poll.total!==1">s</span>
    <template x-if="!poll.is_closed"><span> · <span x-text="poll.multi ? 'tap options to select' : (voted ? 'tap to change your vote' : 'tap an option to vote')"></span></span></template>
    <template x-if="poll.is_closed"><span> · closed</span></template>
  </div>
</div>
<script>
function pollApp(seed){
  return {
    poll: seed, busy:false,
    get voted(){ return !!(this.poll.my_votes && this.poll.my_votes.length); },
    chosen(i){ return (this.poll.my_votes||[]).includes(i); },
    vote(i){
      if(this.busy || this.poll.is_closed) return;
      this.busy=true;
      fetch('/api/community/poll',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded','X-Requested-With':'XMLHttpRequest'},body:new URLSearchParams({poll_id:this.poll.id,option_index:i})})
        .then(r=>r.json()).then(d=>{ if(d.success){ this.poll={...this.poll, options:d.options, total:d.total, my_vote:d.my_vote, my_votes:d.my_votes||[]}; } this.busy=false; })
        .catch(()=>{ this.busy=false; });
    }
  };
}
</script>
{% endif %}
