{% extends 'admin/layout.twig' %}

{#
  THE RESULT RELEASE.

  Every number that decides an award on this platform comes out of
  NomineeScoringService::scoreCategory(). It had three callers — the promotion that crowns
  winners, a snapshot writer, and a console command on a host with no shell — and no screen
  at all. An operator could see who had been crowned and not one figure behind it.

  This screen DECIDES NOTHING. It draws the promotion's own ranking, using the promotion's
  own comparator, and writes nothing. A page that could crown somebody by being looked at
  is not an audit of a release.
#}

{% block head_styles %}
<style nonce="{{ csp_nonce }}">
  .ja-lede{ background:#fff; border:1px solid rgba(16,41,44,.1); border-radius:14px;
    padding:18px 20px; margin-bottom:16px }
  .ja-lede h2{ margin:0 0 6px; font-size:14.5px; color:#10292C }
  .ja-lede p{ margin:8px 0 0; font-size:12.5px; line-height:1.7; color:#5a6d6f; max-width:76ch }
  .ja-row{ display:flex; gap:10px; flex-wrap:wrap; align-items:flex-end; margin-bottom:14px }

  .ja-stats{ display:grid; grid-template-columns:repeat(auto-fit,minmax(132px,1fr)); gap:1px;
    background:rgba(16,41,44,.1); border:1px solid rgba(16,41,44,.1); border-radius:10px;
    overflow:hidden; margin-bottom:16px }
  .ja-stat{ background:#fff; padding:12px 14px }
  .ja-stat__k{ font-family:var(--ag-font-mono,monospace); font-size:10px; font-weight:700;
    letter-spacing:.09em; text-transform:uppercase; color:#5a6d6f; margin:0 }
  .ja-stat__v{ font-family:var(--ag-font-mono,monospace); font-size:20px; font-weight:700;
    color:#10292C; margin:4px 0 0; line-height:1 }
  /* Reserved for a count that should be zero. Never used for a large number. */
  .ja-stat--bad .ja-stat__v{ color:#8a2b18 }

  .ja-card{ background:#fff; border:1px solid rgba(16,41,44,.1); border-radius:14px;
    padding:18px 20px; margin-bottom:16px }
  .ja-card h3{ margin:0 0 4px; font-size:13.5px; color:#10292C }
  .ja-card > p{ margin:0 0 14px; font-size:12.5px; line-height:1.7; color:#5a6d6f; max-width:76ch }

  .ja-t{ width:100%; border-collapse:collapse; font-size:12.5px }
  .ja-t th{ text-align:left; font-family:var(--ag-font-mono,monospace); font-size:10px;
    font-weight:700; letter-spacing:.09em; text-transform:uppercase; color:#5a6d6f;
    padding:0 10px 8px 0; border-bottom:1px solid rgba(16,41,44,.12) }
  .ja-t td{ padding:10px 10px 10px 0; border-bottom:1px solid rgba(16,41,44,.06);
    color:#3d4b4d; vertical-align:top }
  .ja-t tr:last-child td{ border-bottom:none }
  .ja-num{ font-family:var(--ag-font-mono,monospace); font-variant-numeric:tabular-nums }
  .ja-name{ font-weight:600; color:#10292C }
  /* The denominator, set beside the figure it qualifies rather than under it. */
  .ja-den{ display:block; margin-top:3px; font-size:11px; color:#5a6d6f }
  /* A discount an operator has to be able to SEE — without it the leader's lower
     community half looks like the page has miscounted. */
  .ja-den--warn{ color:#8a6100; font-weight:600 }

  .ja-flag{ font-family:var(--ag-font-mono,monospace); font-size:10px; font-weight:700;
    letter-spacing:.05em; text-transform:uppercase; padding:3px 8px; border-radius:999px;
    background:rgba(16,41,44,.07); color:#3d4b4d; white-space:nowrap }
  .ja-flag--bad{ background:#fdecea; color:#8a2b18 }
  .ja-flag--warn{ background:#fffaf0; color:#7a5605 }

  .ja-fact{ border-left:3px solid #8a2b18; background:#fdf6f5; border-radius:0 10px 10px 0;
    padding:13px 16px; margin-bottom:12px }
  .ja-fact b{ color:#8a2b18 }
  .ja-fact p{ margin:6px 0 0; font-size:12.5px; line-height:1.65; color:#5a4442 }

  /* Six numeric columns do not fold onto a phone. Either the table scrolls in its own
     box or the page does — and the page scrolling sideways is the failure that makes
     every vertical swipe drift. `-webkit-overflow-scrolling` is gone: it has been the
     default on iOS since 13 and the property was removed. */
  .ja-scroll{ overflow-x:auto; }
  /* A repair, so it looks like an action and not like a link in a sentence. */
  .ja-recount{ margin:12px 0 0; }
  .ja-recount__b{ cursor:pointer; font-family:inherit; font-size:13px; font-weight:600;
                  min-height:40px; padding:9px 18px; border-radius:999px;
                  border:1px solid rgba(212,154,14,.55); background:transparent; color:#7a5600; }
  .ja-recount__b:hover{ background:rgba(212,154,14,.08); }
  .ja-card--overall{ border-color:rgba(212,154,14,.45); }
  .ja-overall__name{ margin:14px 0 2px; font-family:var(--ag-font-display,inherit);
                     font-weight:800; font-size:26px; line-height:1.1; color:var(--ag-ink,#10292C); }
  .ja-t tr.is-win td{ font-weight:600; }
  .ja-caveat{ margin:14px 0 0; padding:12px 15px; border-left:3px solid #d49a0e;
    background:#fffaf0; border-radius:0 8px 8px 0; font-size:12.5px; line-height:1.65;
    color:#7a5605 }
  .ja-empty{ font-size:12.5px; line-height:1.7; color:#5a6d6f; margin:0 }

  /* ── THE LINE ─────────────────────────────────────────────────────────────
     Where the award falls. A rule across the table rather than a colour on a row,
     because "these two are the result and these are not" is a boundary, not a state. */
  .ja-t tr.rr--cut td{ border-bottom:2px solid #10292C }
  .ja-t tr.rr--out td{ color:#6b7b7d; background:rgba(16,41,44,.02) }
  .ja-rank{ font-family:var(--ag-font-mono,monospace); font-weight:700; color:#10292C }
  .ja-bar{ display:block; height:5px; margin-top:5px; border-radius:999px;
    background:rgba(16,41,44,.09); overflow:hidden }
  .ja-bar i{ display:block; height:100%; background:#237b22; border-radius:999px }
  .ja-cat{ display:flex; align-items:baseline; justify-content:space-between; gap:12px;
    flex-wrap:wrap; margin:0 0 4px }
</style>
{% endblock %}

{% block topbar_title %}Result release{% endblock %}

{% block content %}

{# ── THE SENTENCE THE PAGE WAS MISSING ────────────────────────────────────────
   "Result release" and "what the release WILL do" read as a screen with a button on
   it, and there is no button anywhere: the release is not something an operator
   performs. CycleMaterialiser advances a cycle on its results_date, from the
   unattended maintenance run, and promotes the winners drawn below.

   So the page was asking somebody to review a decision without telling them it takes
   effect by itself, or when. "This one needs a person to decide" on a category, with
   no indication that the person has until Thursday, is the whole confusion. The date
   was already passed to this template and nothing read it. #}
<div class="ja-lede">
  <h2>What will be published, and when</h2>
  <p>Every scored nominee, in the order the award is decided in. This is not a preview
    computed for this page &mdash; it is the same ranking the promotion itself uses, so
    what is drawn here is what will be published.</p>
  {% if cycle and cycle.results_date %}
    <p><strong>Nobody presses anything.</strong> This cycle turns into a published result
      on <strong>{{ cycle.results_date|date('j F Y') }}</strong>, by itself, from the
      scheduled maintenance run &mdash; the winners below are crowned and told. Anything
      on this page that needs a person needs them <em>before</em> then.</p>
  {% else %}
    <p><strong>Nobody presses anything.</strong> A cycle turns into a published result on
      its results date, by itself, from the scheduled maintenance run. This one has no
      results date set, so nothing will be published until one is
      &mdash; <a href="/admin/programmes">set it on the cycle</a>.</p>
  {% endif %}
  <p>Nothing on this screen changes anything. A nominee out of the running is still
    listed, with the reason: an exclusion nobody can see is the part of a result that is
    hardest to defend later.</p>
  <p><b>Reading the index.</b> Each nominee&rsquo;s score out of 1000 is a community half
    plus a judge half, printed under it so it can be added up. The community half is
    measured against the <em>largest organic vote count in the category</em> rather than
    against the votes cast &mdash; so the leader on votes earns the whole community
    weight, and somebody on half their votes earns half of it. The judge half is the
    panel&rsquo;s weighted average out of ten.</p>
</div>

<form method="get" action="/admin/result-release" class="ja-row">
  <label>
    <span class="ja-den">Cycle</span>
    <select name="cycle" data-ag-do="submit-form">
      {% for c in cycles %}
        <option value="{{ c.id }}"{{ c.id == cycle_id ? ' selected' : '' }}>
          {{ c.programme ?: 'Programme' }} &mdash; {{ c.edition_label ?: c.year }} ({{ c.status }})
        </option>
      {% endfor %}
    </select>
  </label>
  <button type="submit" class="ad-btn">Show</button>
</form>

{% if failed %}
  <div class="ja-fact">
    <b>The scores could not be read.</b>
    <p>This is not &ldquo;nothing has been scored&rdquo; &mdash; the query failed, and the
      two look identical on a screen. The reason is in the error log.</p>
  </div>
{% elseif categories is empty %}
  <div class="ja-card">
    <h3>Nothing has been scored in this cycle</h3>
    <p class="ja-empty">No nominee here has a Cultural Power Index yet. That is the normal
      state of a cycle before judging, and it is not a fault.</p>
  </div>
{% else %}

  {# ── WHAT TO LOOK AT FIRST ───────────────────────────────────────────────
     Six tiles that could not be added up. Three counted CATEGORIES and two counted
     NOMINEES, with nothing saying which was which, and a dead heat was counted twice
     over — once as a dead heat and again under "won by ≤10", because its margin is
     zero and zero is inside ten. So a cycle with three categories needing attention
     presented as four, in units an operator had to guess at, above a page that said
     three. A summary that cannot be reconciled with the evidence under it is worse
     than no summary.

     One headline now — how many categories need a person, counted once — with the
     reasons behind it, and the nominee-level counts kept visibly apart. #}
  {% if recount_said %}
    <p class="ja-caveat" role="status">{{ recount_said }}</p>
  {% endif %}

  <div class="ja-stats">
    <div class="ja-stat{% if attention.needs_person > 0 %} ja-stat--bad{% endif %}">
      <p class="ja-stat__k">Need a person</p>
      <p class="ja-stat__v">{{ attention.needs_person }}</p>
      <span class="ja-den">of {{ attention.categories }}
        categor{{ attention.categories == 1 ? 'y' : 'ies' }}</span>
    </div>
    <div class="ja-stat{% if attention.blocked > 0 %} ja-stat--bad{% endif %}">
      <p class="ja-stat__k">Crown nobody</p>
      <p class="ja-stat__v">{{ attention.blocked }}</p>
      <span class="ja-den">categories</span>
    </div>
    <div class="ja-stat{% if attention.dead_heats > 0 %} ja-stat--bad{% endif %}">
      <p class="ja-stat__k">Dead heats</p>
      <p class="ja-stat__v">{{ attention.dead_heats }}</p>
      <span class="ja-den">categories</span>
    </div>
    <div class="ja-stat{% if attention.thin_margins > 0 %} ja-stat--bad{% endif %}">
      <p class="ja-stat__k">Won by &le;10</p>
      <p class="ja-stat__v">{{ attention.thin_margins }}</p>
      <span class="ja-den">categories, dead heats excluded</span>
    </div>
    <div class="ja-stat">
      <p class="ja-stat__k">Excluded</p>
      <p class="ja-stat__v">{{ attention.excluded }}</p>
      <span class="ja-den">nominees</span>
    </div>
    <div class="ja-stat">
      <p class="ja-stat__k">Provisional</p>
      <p class="ja-stat__v">{{ attention.provisional }}</p>
      <span class="ja-den">nominees</span>
    </div>
  </div>

  {# ── THE ONE AWARD FOR THE WHOLE CYCLE ──────────────────────────────────
     Drawn from the category winners, on the same CPI and the same comparator the
     categories were decided with — nothing recomputed, no second score invented.

     The comparability caveat is printed WITH it rather than left to be discovered.
     A CPI's judge half is absolute; its community half is a share of the winner's own
     cohort, so leading a three-person category on fifty votes is a full community half
     and a close second in a fifty-thousand-vote category is not. There is no neutral
     denominator — normalising across the cycle inverts the bias and hands the award to
     whoever stands in the most popular category. So the screen shows the field size and
     the denominator beside every contender and lets a person decide. #}
  {% if overall and overall.winner %}
    <div class="ja-card ja-card--overall">
      <div class="ja-cat">
        <h3>Overall winner &mdash; the whole cycle</h3>
        <span class="ja-den">{{ overall.contenders|length }} category winner{{ overall.contenders|length == 1 ? '' : 's' }} in contention</span>
      </div>

      <p class="ja-overall__name">{{ overall.winner.name }}</p>
      <p class="ja-den">{{ overall.winner.category }} &middot; CPI {{ overall.winner.cpi }}
        {%- if overall.margin is not null %} &middot; {{ overall.margin }} ahead of {{ overall.runner_up.name }}{% endif %}</p>

      {% if overall.dead_heat %}
        <p class="ja-caveat"><b>Dead heat.</b> {{ overall.winner.name }} and {{ overall.runner_up.name }}
          are level on CPI <b>{{ overall.winner.cpi }}</b> and on <b>{{ overall.winner.organic|number_format }}</b>
          organic votes. The methodology cannot separate them; the order above falls back to the
          lower nominee id, which is deterministic and is not a result. This one needs a person.</p>
      {% endif %}

      <p class="ja-caveat">A CPI compares cleanly <b>inside</b> a category and only half compares
        across them. The judge half is absolute &mdash; six out of ten is six out of ten anywhere.
        The community half is a share of that category&rsquo;s own leader &mdash; but it is
        also scaled by how deep that category&rsquo;s support actually was, so leading a
        field of one on a hundred votes no longer pays what leading a busy one pays.
        {% if overall.thinnest_field is not null and overall.thinnest_field <= 3 %}
          The smallest field here is <b>{{ overall.thinnest_field }}</b>.
        {% endif %}
        What remains uneven is the SHAPE of a field rather than its size: two nominees a
        long way apart and two nominees neck and neck can produce the same winning share.
        The field size and denominator for every contender are below.</p>

      <div class="ja-scroll">
        <table class="ja-t">
          <thead><tr>
            <th>Winner</th><th>Category</th><th class="ja-num">CPI</th>
            <th class="ja-num">Field</th><th class="ja-num">Organic</th>
            <th class="ja-num">Cohort max</th>
          </tr></thead>
          <tbody>
            {% for c in overall.contenders %}
              <tr{% if loop.first %} class="is-win"{% endif %}>
                <td>{{ c.name }}</td>
                <td>{{ c.category }}</td>
                <td class="ja-num">{{ c.cpi }}</td>
                <td class="ja-num">{{ c.field }}
                  {%- if c.field <= 3 %} <span class="ja-den">thin</span>{% endif %}</td>
                <td class="ja-num">{{ c.organic|number_format }}</td>
                <td class="ja-num">{{ c.cohort_max|number_format }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  {% elseif overall %}
    <div class="ja-card">
      <div class="ja-cat"><h3>Overall winner &mdash; the whole cycle</h3></div>
      <p class="ja-empty">No category has crowned anybody yet, so there is nobody to draw an
        overall winner from. This is the ordinary state before a release, not a fault.</p>
    </div>
  {% endif %}

  {% for c in categories %}
    <div class="ja-card">
      <div class="ja-cat">
        <h3>{{ c.category.title|default('Category #' ~ c.category.id|default('?')) }}</h3>
        <span class="ja-den">
          {{ (c.weights.community * 100)|round }}% community &middot;
          {{ (c.weights.judge * 100)|round }}% judges &middot;
          quorum {{ c.quorum }} judge{{ c.quorum == 1 ? '' : 's' }}
          {%- if c.shortlisted is not null %} &middot; shortlisted field of {{ c.shortlisted|length }}{% endif %}
        </span>
      </div>

      {# ── THE DENOMINATOR ──────────────────────────────────────────────────
         The community half is votes measured against the BIGGEST vote count in the
         category, not against the votes cast — so 2,650 organic is worth 247 points
         behind a leader on 4,820 and 450 points on its own. Every column needed to
         check a CPI was on this page except this one, which is the only one that
         cannot be guessed.

         The cohort is the published field where a category shortlists, so somebody taken
         off the list no longer sets the scale for the people still in it. The QUORUM is
         deliberately not applied to it — below quorum is pending rather than out, and
         dropping an unjudged nominee from the denominator would move every score here the
         moment their panel finished. That leaves one case worth saying out loud. #}
      {# ── THE WHOLE COMMUNITY HALF IS OFF ─────────────────────────────────
         Said before the table, not after it, because everything below is a ranking
         decided by the panel alone and a reader has to know that before they read it.

         The number in the heading still says what the rules weigh the community at, and
         that is the point: the gap between "45% of it" at the top and zero in every row
         is the finding. #}
      {#
        ── THIS CAVEAT DESCRIBED A FAULT THAT NO LONGER EXISTS ─────────────────

        It said "not one nominee here has an ORGANIC vote" and then, flatly, "Votes ARE
        recorded against these nominees" — written when the index read
        `organic_vote_count` and a category could hold thousands of votes while scoring
        zero. The index counts every vote now, so `community_dark` means something else
        entirely: NOBODY VOTED AT ALL.

        Left as it was, this told an operator looking at a category with no votes in it
        that their votes existed and their counters had drifted, and offered them a recount
        that would find nothing. Confidently wrong, on the screen an award is signed off
        from.
      #}
      {% if c.community_dark %}
        <p class="ja-caveat"><b>Not one nominee here has a single vote</b>, so the community
          half is zero for the entire field and this category would be decided by the panel
          alone &mdash; at {{ (c.weights.judge * 100)|round }}% of the index doing 100% of
          the work. The order below is the judges&rsquo; order.<br>
          Nothing here is a counter that has drifted: the ballot is empty. The promotion
          refuses to crown this category for that reason, and it needs a person rather than
          a winner.</p>
      {% endif %}

      {% if c.scale_is_out %}
        <p class="ja-caveat">The community half here is measured against
          <b>{{ c.cohort_max|number_format }}</b> votes &mdash; {{ c.scale_set_by }}&rsquo;s,
          and {{ c.scale_set_by }}&rsquo;s panel has <b>not finished</b>. They are in the
          field, so their votes set the scale for it; they are not yet winner-eligible, so
          they are not in the ranking below. Nothing here is wrong &mdash; but if their
          scorecards land before you release, every community half on this page changes,
          and the order can change with it. Finish that panel first.</p>
      {% endif %}

      {# ── THE THINGS THAT NEEDED A HUMAN AND WENT INTO A LOG ─────────────
         "no nominee meets the judge quorum" and "DEAD HEAT ... this one needs a human"
         were written into the maintenance log by the promotion. There is no shell on this
         deployment, so nobody has ever read either sentence. #}
      {% if c.blocked %}
        <div class="ja-fact"><b>This category crowns nobody.</b><p>{{ c.blocked }}</p></div>
      {% elseif c.dead_heat %}
        <div class="ja-fact">
          <b>Dead heat for first place.</b>
          <p>{{ c.winner.name }} and {{ c.runner_up.name }} are on the same Cultural Power
            Index with the same organic support. The methodology cannot separate them, so
            the award goes to the lower nominee id to keep the promotion deterministic.
            <strong>This one needs a person to decide.</strong></p>
          {# The sentence asks for a decision, so it has to point at what the decision is
             made ON. Two nominees can be identical on every figure this page shows and
             have been read completely differently by the panel — a unanimous 8 across the
             board against two judges who disagreed on every criterion and cancelled out.
             That difference exists only in the marks, and until this link the page asked
             for a judgement without offering the evidence for one. #}
          <p><b>What the panel actually said:</b>
            <a href="/admin/scorecard/{{ c.winner.nominee_id }}">{{ c.winner.name }}&rsquo;s marks</a>
            &middot;
            <a href="/admin/scorecard/{{ c.runner_up.nominee_id }}">{{ c.runner_up.name }}&rsquo;s marks</a>.
            Identical averages are not identical judging.</p>
        </div>
      {% endif %}

      {# ── THE WORKING ──────────────────────────────────────────────────────
         The table showed the inputs and the answer and no way between them. An
         operator defending a result could read the votes, the mark, the weights and
         the index and still not say why 2,650 organic votes and an 8 produce 687.

         So the two halves are printed as the points they contribute, and they sum
         EXACTLY to the CPI beside them — ResultRelease gives the judge half the single
         rounding step for that reason. A sum that does not equal the figure next to it
         would be worse than showing no working at all. #}
      <div class="ja-scroll">
      <table class="ja-t">
        <thead>
          <tr>
            <th>#</th><th>Nominee</th><th>Index<span class="ja-den">of 1000</span></th>
            <th>Community<span class="ja-den">{{ (c.weights.community * 100)|round }}% of it</span></th>
            <th>Judges<span class="ja-den">{{ (c.weights.judge * 100)|round }}% of it</span></th>
            <th>Organic</th><th>All votes</th><th>Standing</th>
          </tr>
        </thead>
        <tbody>
          {% for r in c.rows %}
            {# The rule marks WHERE THE AWARD FALLS, so it may only be drawn when there
               is something on the other side of it. Applied to rank 2 unconditionally it
               drew a heavy line under the last row of every two-nominee category — a
               boundary with nothing below it, which reads as a total. #}
            {% set cut = r.rank == 2 and c.rows|length > loop.index %}
            <tr class="{% if not r.in_running %}rr--out{% elseif cut %}rr--cut{% endif %}">
              <td class="ja-rank">{{ r.rank ?: '&mdash;'|raw }}</td>
              <td class="ja-name">{{ r.name }}
                {%- if r.out_reason %}<span class="ja-den">{{ r.out_reason }}</span>{% endif %}</td>
              <td class="ja-num">{{ r.cpi }}
                {# The index as a bar, because a column of four-digit numbers does not
                   show a gap and the gap is the whole question. #}
                <span class="ja-bar"><i style="width:{{ (r.cpi / 10)|round }}%"></i></span>
                <span class="ja-den">{{ r.community_points }} + {{ r.judge_points }}</span>
              </td>
              <td class="ja-num">{{ r.community_points }}
                {# The step nobody could take: from a vote count to a number of points.
                   Except on the row of the nominee who IS the scale, where "100% of their
                   own votes" is a tautology dressed as a denominator — and the fact worth
                   stating there is the other one. #}
                {#
                  THE WORD "ORGANIC" WAS WRONG HERE AND IT LOOKED LIKE FRAUD.

                  These lines said "most organic votes here" and "79% of Ajayi's 1,955"
                  while the ORGANIC column beside them read 0 — because the index counts
                  every vote now and this copy still described the old rule. An operator
                  reading a screen that credits 1,955 "organic" votes to somebody with none
                  is reading, correctly, a screen they cannot trust.
                #}
                {% if c.community_dark %}
                  {# Nobody in the field has a single vote, so there is no scale and no
                     scale-setter, and the fraction printed here came out as "0% of ’s 0" —
                     a broken sentence where the explanation should be. #}
                  <span class="ja-den">no votes to weigh</span>
                {% elseif r.nominee_id == c.scale_set_by_id %}
                  <span class="ja-den">most votes here &mdash; sets the scale</span>
                {% else %}
                  <span class="ja-den">{{ r.community_share }}% of
                    {{ c.scale_set_by }}&rsquo;s {{ c.cohort_max|number_format }}</span>
                {% endif %}
                {#
                  AND WHY THE LEADER'S 450 IS NOT ALWAYS 450.

                  The half is relative to the category leader AND scaled by how deep the
                  support in that category actually was, so the leader of a category with
                  89 votes no longer collects exactly what the leader of one with 1,955
                  collects. Without this line the discount is invisible and the screen
                  looks like it has miscounted.
                #}
                {% if not c.community_dark and c.cohort_max < c.community_full_credit %}
                  <span class="ja-den ja-den--warn">category discounted &mdash;
                    {{ c.cohort_max|number_format }} votes against a full-credit mark of
                    {{ c.community_full_credit|number_format }}</span>
                {% endif %}
              </td>
              {# The judge half is an average of averages of marks, three steps from
                 anything a judge wrote — so it is the one figure on this page that
                 cannot be checked ON this page. The link is the rest of the answer. #}
              <td class="ja-num">{{ r.judge_points }}
                {%- if r.provisional %}
                  <span class="ja-den">judge half not counted</span>
                {%- elseif r.judge_score is not null %}
                  <span class="ja-den">{{ r.judge_score|round(1) }}/10 from
                    {{ r.judges }} judge{{ r.judges == 1 ? '' : 's' }}</span>
                {%- endif %}
                {%- if r.judges < c.quorum %}
                  <span class="ja-flag ja-flag--warn">{{ r.judges }} of {{ c.quorum }}</span>
                {%- endif %}
                <span class="ja-den"><a href="/admin/scorecard/{{ r.nominee_id }}">see the marks</a></span>
              </td>
              <td class="ja-num">{{ r.organic|number_format }}</td>
              {# BOTH numbers, and the roles have swapped: `vote_count` is what the index
                 counts AND what the public page shows; `organic` is how much of it was not
                 bought, which decides nothing now but is published everywhere the total is
                 so a reader can see what a tally is made of. #}
              <td class="ja-num">{{ r.vote_count|number_format }}
                {%- if r.vote_count > r.organic %}
                  <span class="ja-den">{{ (r.vote_count - r.organic)|number_format }} bought or awarded</span>
                {% endif %}
              </td>
              <td>
                {% if r.status == 'winner' %}<span class="ja-flag">crowned</span>
                {% elseif r.status == 'runner_up' %}<span class="ja-flag">runner-up</span>
                {% elseif r.rank == 1 %}<span class="ja-flag">wins</span>
                {% elseif r.rank == 2 %}<span class="ja-flag">second</span>
                {% else %}&mdash;{% endif %}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
      </div>

      {# ── THE MARGIN, IN ONE PLACE ─────────────────────────────────────────
         It was stated twice: a yellow warning above the table when the gap was ten or
         under, and a grey line below it when the gap was larger. Same fact, two
         locations, two styles — so an operator scanning several categories learnt to
         read the margin off whichever one they happened to find, and a category with
         the warning looked structurally different from one without it rather than
         merely closer. One element, always in the same place; the severity changes,
         the position does not. #}
      {% if c.tie_broken_by_votes %}
        {# "First and second are 0 apart" beside a WINS badge, and nothing saying what
           broke a tie the page had just called exact. This is the single moment the
           tiebreak decides an award, so it is the moment to say what it read.

           IT USED TO SAY "organic support", and printed the two organic counts. That was
           the old comparator, and on any deployment with free voting switched off it
           would have rendered as "takes it on organic support — 0 votes against 0":
           self-refuting, at the exact moment an operator is deciding whether to sign a
           result off. The comparator reads the full tally now, the same figure the index
           normalises over, and this reads it from the same key. #}
        <p class="ja-caveat">The index is <b>exactly level</b> at {{ c.winner.cpi }}.
          {{ c.winner.name }} takes it on <b>votes</b> &mdash;
          {{ c.winner.votes|number_format }} against
          {{ c.runner_up.votes|number_format }}. The tiebreak reads the same tally the
          community half normalises over, so it cannot disagree with the half it is
          breaking.</p>
      {% elseif c.margin is not null and not c.dead_heat %}
        {% if c.margin <= 10 %}
          <p class="ja-caveat">First and second are <b>{{ c.margin }}</b> apart on a
            0&ndash;1000 index. A result this close can turn on one judge changing one
            mark &mdash; the <a href="/admin/judging-audit">judging audit</a> says whether
            one did.</p>
        {% else %}
          <p class="ja-den" style="margin-top:12px">First is {{ c.margin }} ahead of second
            on a 0&ndash;1000 index.</p>
        {% endif %}
      {% endif %}
    </div>
  {% endfor %}

  <p class="ja-den" style="margin-top:16px">&ldquo;Index&rdquo; is the Cultural Power
    Index: the community half and the judge half, weighted as shown on each category and
    scaled to 1000.</p>
  <p class="ja-caveat">A provisional figure is not a Cultural Power Index. Where the judge
    quorum has not been met the judge half is scored as absent rather than renormalised
    away &mdash; the conservative direction, because renormalising would put an unjudged
    nominee at the top of the board on popularity alone, which is the one thing this
    platform exists to prevent.</p>
{% endif %}

{% endblock %}
