{% extends 'admin/layout.twig' %}

{#
  THE RESULT RELEASE.

  Every number that decides an award on this platform comes out of
  NomineeScoringService::scoreCategory(). It had three callers — the promotion that crowns
  winners, a snapshot writer, and a console command on a host with no shell — and no screen
  at all. An operator could see who had been crowned and not one figure behind it.

  This screen DECIDES NOTHING. It draws the promotion's own ranking, using the promotion's
  own comparator, and writes nothing. A page that could crown somebody by being looked at
  is not an audit of a release.
#}

{% block head_styles %}
<style nonce="{{ csp_nonce }}">
  .ja-lede{ background:#fff; border:1px solid rgba(16,41,44,.1); border-radius:14px;
    padding:18px 20px; margin-bottom:16px }
  .ja-lede h2{ margin:0 0 6px; font-size:14.5px; color:#10292C }
  .ja-lede p{ margin:8px 0 0; font-size:12.5px; line-height:1.7; color:#5a6d6f; max-width:76ch }
  .ja-row{ display:flex; gap:10px; flex-wrap:wrap; align-items:flex-end; margin-bottom:14px }

  .ja-stats{ display:grid; grid-template-columns:repeat(auto-fit,minmax(132px,1fr)); gap:1px;
    background:rgba(16,41,44,.1); border:1px solid rgba(16,41,44,.1); border-radius:10px;
    overflow:hidden; margin-bottom:16px }
  .ja-stat{ background:#fff; padding:12px 14px }
  .ja-stat__k{ font-family:var(--ag-font-mono,monospace); font-size:10px; font-weight:700;
    letter-spacing:.09em; text-transform:uppercase; color:#5a6d6f; margin:0 }
  .ja-stat__v{ font-family:var(--ag-font-mono,monospace); font-size:20px; font-weight:700;
    color:#10292C; margin:4px 0 0; line-height:1 }
  /* Reserved for a count that should be zero. Never used for a large number. */
  .ja-stat--bad .ja-stat__v{ color:#8a2b18 }

  .ja-card{ background:#fff; border:1px solid rgba(16,41,44,.1); border-radius:14px;
    padding:18px 20px; margin-bottom:16px }
  .ja-card h3{ margin:0 0 4px; font-size:13.5px; color:#10292C }
  .ja-card > p{ margin:0 0 14px; font-size:12.5px; line-height:1.7; color:#5a6d6f; max-width:76ch }

  .ja-t{ width:100%; border-collapse:collapse; font-size:12.5px }
  .ja-t th{ text-align:left; font-family:var(--ag-font-mono,monospace); font-size:10px;
    font-weight:700; letter-spacing:.09em; text-transform:uppercase; color:#5a6d6f;
    padding:0 10px 8px 0; border-bottom:1px solid rgba(16,41,44,.12) }
  .ja-t td{ padding:10px 10px 10px 0; border-bottom:1px solid rgba(16,41,44,.06);
    color:#3d4b4d; vertical-align:top }
  .ja-t tr:last-child td{ border-bottom:none }
  .ja-num{ font-family:var(--ag-font-mono,monospace); font-variant-numeric:tabular-nums }
  .ja-name{ font-weight:600; color:#10292C }
  /* The denominator, set beside the figure it qualifies rather than under it. */
  .ja-den{ display:block; margin-top:3px; font-size:11px; color:#5a6d6f }
  /* Reserved for a figure that needs an operator to look at it — a nominee whose
     reach could not be counted, not a scoring adjustment. There is no per-category
     discount in this index; see the note further down where one used to be drawn. */
  .ja-den--warn{ color:#8a6100; font-weight:600 }

  .ja-flag{ font-family:var(--ag-font-mono,monospace); font-size:10px; font-weight:700;
    letter-spacing:.05em; text-transform:uppercase; padding:3px 8px; border-radius:999px;
    background:rgba(16,41,44,.07); color:#3d4b4d; white-space:nowrap }
  .ja-flag--bad{ background:#fdecea; color:#8a2b18 }
  .ja-flag--warn{ background:#fffaf0; color:#7a5605 }

  .ja-fact{ border-left:3px solid #8a2b18; background:#fdf6f5; border-radius:0 10px 10px 0;
    padding:13px 16px; margin-bottom:12px }
  .ja-fact b{ color:#8a2b18 }
  .ja-fact p{ margin:6px 0 0; font-size:12.5px; line-height:1.65; color:#5a4442 }

  /* Six numeric columns do not fold onto a phone. Either the table scrolls in its own
     box or the page does — and the page scrolling sideways is the failure that makes
     every vertical swipe drift. `-webkit-overflow-scrolling` is gone: it has been the
     default on iOS since 13 and the property was removed. */
  .ja-scroll{ overflow-x:auto; }
  /* A repair, so it looks like an action and not like a link in a sentence. */
  .ja-recount{ margin:12px 0 0; }
  .ja-recount__b{ cursor:pointer; font-family:inherit; font-size:13px; font-weight:600;
                  min-height:40px; padding:9px 18px; border-radius:999px;
                  border:1px solid rgba(212,154,14,.55); background:transparent; color:#7a5600; }
  .ja-recount__b:hover{ background:rgba(212,154,14,.08); }
  .ja-card--overall{ border-color:rgba(212,154,14,.45); }
  .ja-overall__name{ margin:14px 0 2px; font-family:var(--ag-font-display,inherit);
                     font-weight:800; font-size:26px; line-height:1.1; color:var(--ag-ink,#10292C); }
  .ja-t tr.is-win td{ font-weight:600; }
  .ja-caveat{ margin:14px 0 0; padding:12px 15px; border-left:3px solid #d49a0e;
    background:#fffaf0; border-radius:0 8px 8px 0; font-size:12.5px; line-height:1.65;
    color:#7a5605 }
  .ja-empty{ font-size:12.5px; line-height:1.7; color:#5a6d6f; margin:0 }

  /* ── THE LINE ─────────────────────────────────────────────────────────────
     Where the award falls. A rule across the table rather than a colour on a row,
     because "these two are the result and these are not" is a boundary, not a state. */
  .ja-t tr.rr--cut td{ border-bottom:2px solid #10292C }
  .ja-t tr.rr--out td{ color:#6b7b7d; background:rgba(16,41,44,.02) }
  .ja-rank{ font-family:var(--ag-font-mono,monospace); font-weight:700; color:#10292C }
  .ja-bar{ display:block; height:5px; margin-top:5px; border-radius:999px;
    background:rgba(16,41,44,.09); overflow:hidden }
  .ja-bar i{ display:block; height:100%; background:#237b22; border-radius:999px }
  .ja-cat{ display:flex; align-items:baseline; justify-content:space-between; gap:12px;
    flex-wrap:wrap; margin:0 0 4px }
</style>
{% endblock %}

{% block topbar_title %}Result release{% endblock %}

{% block content %}

{# ── THE SENTENCE THE PAGE WAS MISSING ────────────────────────────────────────
   "Result release" and "what the release WILL do" read as a screen with a button on
   it, and there is no button anywhere: the release is not something an operator
   performs. CycleMaterialiser advances a cycle on its results_date, from the
   unattended maintenance run, and promotes the winners drawn below.

   So the page was asking somebody to review a decision without telling them it takes
   effect by itself, or when. "This one needs a person to decide" on a category, with
   no indication that the person has until Thursday, is the whole confusion. The date
   was already passed to this template and nothing read it. #}
<div class="ja-lede">
  <h2>What will be published, and when</h2>
  {#
    ── THIS CLAIM STOPPED BEING TRUE WHEN SEALING SHIPPED ─────────────────

    "What is drawn here is what will be published" was exactly right while every
    published page recomputed on view. A released cycle now publishes the standing
    SEALED at its announcement, and this screen still draws live — deliberately, because
    asking the promotion's own comparator is what makes it an audit of a release rather
    than a report about one.

    So for a sealed cycle the sentence is a false promise on the page an award is signed
    off from, and the disagreement it hides is the one an operator gets called about.
    Both halves are said now, and which one is showing is decided by the seal rather
    than by the phase: a cycle can sit in `results` with nothing sealed (released before
    sealing existed) and that is a third state, not the second.
  #}
  {% if sealed %}
    <p>Every scored nominee, in the order the award is decided in &mdash; computed
      <strong>now</strong>, from the same comparator the promotion uses. This cycle has
      already been announced, so <strong>this is not what the public pages are
      showing</strong>: they publish the standing sealed on
      {{ sealed.sealed_at ? sealed.sealed_at|date('j F Y') : 'announcement' }}, and they
      will go on publishing it. Read this table as today&rsquo;s arithmetic beside a
      result that has been given, and see the panel below for wherever the two differ.</p>
  {% else %}
    <p>Every scored nominee, in the order the award is decided in. This is not a preview
      computed for this page &mdash; it is the same ranking the promotion itself uses, so
      what is drawn here is what will be published.</p>
  {% endif %}
  {% if cycle and cycle.results_date %}
    <p><strong>Nobody presses anything.</strong> This cycle turns into a published result
      on <strong>{{ cycle.results_date|date('j F Y') }}</strong>, by itself, from the
      scheduled maintenance run &mdash; the winners below are crowned and told. Anything
      on this page that needs a person needs them <em>before</em> then.</p>
  {% else %}
    <p><strong>Nobody presses anything.</strong> A cycle turns into a published result on
      its results date, by itself, from the scheduled maintenance run. This one has no
      results date set, so nothing will be published until one is
      &mdash; <a href="/admin/programmes">set it on the cycle</a>.</p>
  {% endif %}
  <p>Nothing on this screen changes anything. A nominee out of the running is still
    listed, with the reason: an exclusion nobody can see is the part of a result that is
    hardest to defend later.</p>
  {#
    THIS PARAGRAPH DESCRIBED A RULE THE SCORER HAD ALREADY STOPPED FOLLOWING — TWICE.

    It said the community half is measured against "the largest ORGANIC vote count in the
    CATEGORY". Organic stopped deciding anything when the index started counting every
    vote, and the denominator stopped being the category when it became the edition's. So
    the one paragraph on this screen that tells an operator how to read the numbers was
    wrong about both terms of the thing it was explaining, on the page an award is signed
    off from.
  #}
  {#
    THIS PARAGRAPH HAS BEEN WRONG ABOUT THE DENOMINATOR TWICE ALREADY — it said "the
    largest ORGANIC vote count IN THE CATEGORY" while the scorer had moved on from both
    words. It is now driven off the cycle's OWN basis rather than describing whichever rule
    was current when somebody last edited the template, because this is the page an award
    is signed off from and a lede that describes a different arithmetic is worse than none.
  #}
  {% if categories is not empty and categories[0].community_basis == 'ideal' %}
    <p><b>Reading the index.</b> Each nominee&rsquo;s score out of 1000 is a community half
      plus a judge half, printed under it so it can be added up. The community half is two
      counts against <em>one</em> yardstick: the <em>largest vote total anyone in this cycle
      reached</em>, counted as if every one of those votes had come from a different person.
      Seventy per cent of the half is <em>how many verified people</em> backed a nominee as a
      share of that; thirty per cent is their <em>total votes</em> as a share of the same
      figure. So a full community half means as many separate supporters as the biggest
      total anybody managed. Because both counts divide by one number, the gap between a
      nominee&rsquo;s backer count and their vote total is readable straight off the row.
      The judge half is the panel&rsquo;s weighted average out of ten, straight.</p>
  {% else %}
    <p><b>Reading the index.</b> Each nominee&rsquo;s score out of 1000 is a community half
      plus a judge half, printed under it so it can be added up. The community half is two
      counts: <em>how many verified people</em> backed them (the larger part of it) and their
      <em>total votes</em>. Both are measured against the highest figure any nominee reached
      <em>anywhere in this cycle</em> &mdash; not in their own category &mdash; so a community
      figure means the same thing on every category below and the cycle standing can be drawn
      from them. The judge half is the panel&rsquo;s weighted average out of ten, straight.</p>
  {% endif %}
</div>

<form method="get" action="/admin/result-release" class="ja-row">
  <label>
    <span class="ja-den">Cycle</span>
    <select name="cycle" data-ag-do="submit-form">
      {% for c in cycles %}
        <option value="{{ c.id }}"{{ c.id == cycle_id ? ' selected' : '' }}>
          {{ c.programme ?: 'Programme' }} &mdash; {{ c.edition_label ?: c.year }} ({{ c.status }})
        </option>
      {% endfor %}
    </select>
  </label>
  <button type="submit" class="ad-btn">Show</button>
</form>

{% if failed %}
  <div class="ja-fact">
    <b>The scores could not be read.</b>
    <p>This is not &ldquo;nothing has been scored&rdquo; &mdash; the query failed, and the
      two look identical on a screen. The reason is in the error log.</p>
  </div>
{% elseif categories is empty %}
  <div class="ja-card">
    <h3>Nothing has been scored in this cycle</h3>
    <p class="ja-empty">No nominee here has a Cultural Power Index yet. That is the normal
      state of a cycle before judging, and it is not a fault.</p>
  </div>
{% else %}

  {# ── WHAT TO LOOK AT FIRST ───────────────────────────────────────────────
     Six tiles that could not be added up. Three counted CATEGORIES and two counted
     NOMINEES, with nothing saying which was which, and a dead heat was counted twice
     over — once as a dead heat and again under "won by ≤10", because its margin is
     zero and zero is inside ten. So a cycle with three categories needing attention
     presented as four, in units an operator had to guess at, above a page that said
     three. A summary that cannot be reconciled with the evidence under it is worse
     than no summary.

     One headline now — how many categories need a person, counted once — with the
     reasons behind it, and the nominee-level counts kept visibly apart. #}
  {% if recount_said %}
    <p class="ja-caveat" role="status">{{ recount_said }}</p>
  {% endif %}

  {#
    ── THE ANNOUNCEMENT, BESIDE TODAY'S ARITHMETIC ─────────────────────────

    The support call this exists for begins "my score has changed". Before this, the
    operator taking it had the recomputed figure on this screen and the nominee had the
    sealed one on theirs, and no screen anywhere held both — so the honest answer ("your
    result has not changed; our method has, and yours is still the one you were given")
    was not available to the person who had to give it.

    Only the three things a person asks about their own result are compared: the index,
    the placing, and whether they were in the running. A community half that reaches the
    same 693 by a different route has moved nothing anybody was told, and listing it
    would bury the rows that matter.

    `added` and `gone` are counted apart and not called discrepancies, because they are
    not: a nominee entered after the announcement, or one this draw no longer scores.
  #}
  {% if sealed %}
    <div class="ja-fact">
      <b>This cycle&rsquo;s standing is sealed, and the public pages publish the seal.</b>
      <p>Sealed on
        <strong>{{ sealed.sealed_at ? sealed.sealed_at|date('j F Y, H:i') : 'announcement' }}</strong>,
        covering {{ sealed.checked }} scored nominee{{ sealed.checked == 1 ? '' : 's' }}.
        {% if sealed.moved is empty %}
          Every one of them scores, places and stands exactly as announced under
          today&rsquo;s rules, so the table below and the published pages agree.
        {% else %}
          <strong>{{ sealed.moved|length }}</strong> of them
          {{ sealed.moved|length == 1 ? 'scores' : 'score' }} differently now. The
          published pages are unaffected &mdash; they read the seal &mdash; but the table
          below is today&rsquo;s arithmetic, and this is where the two part company.
        {% endif %}
        {%- if sealed.added > 0 %} {{ sealed.added }}
          nominee{{ sealed.added == 1 ? '' : 's' }} scored here
          {{ sealed.added == 1 ? 'was' : 'were' }} not in the announced standing at all, so
          {{ sealed.added == 1 ? 'it is' : 'they are' }} not published in it.{% endif %}
        {%- if sealed.gone > 0 %} {{ sealed.gone }} nominee{{ sealed.gone == 1 ? '' : 's' }}
          in the seal {{ sealed.gone == 1 ? 'is' : 'are' }} no longer scored here and
          {{ sealed.gone == 1 ? 'is' : 'are' }} still published from it.{% endif %}
      </p>
      {% if sealed.moved is not empty %}
        <div class="ja-scroll" style="margin-top:10px">
          <table class="ja-t">
            <thead><tr>
              <th>Nominee</th><th>Category</th>
              <th class="ja-num">Announced</th><th class="ja-num">Today</th>
              <th>Placing</th><th>In the running</th>
            </tr></thead>
            <tbody>
              {% for m in sealed.moved %}
                <tr{% if m.in_sealed != m.in_now %} class="rr--out"{% endif %}>
                  <td class="ja-name">{{ m.name }}</td>
                  <td><span class="ja-den">{{ m.category }}</span></td>
                  <td class="ja-num">{{ m.cpi_sealed }}</td>
                  <td class="ja-num">{{ m.cpi_now }}{% if m.cpi_now != m.cpi_sealed %}
                    <span class="ja-den">{{ m.cpi_now > m.cpi_sealed ? '+' : '' }}{{ m.cpi_now - m.cpi_sealed }}</span>
                  {% endif %}</td>
                  {# Set once: a null placing prints as a dash, and repeating the
                     conditional inline three times is how the two halves of one cell come
                     to disagree about what "no rank" looks like. #}
                  {% set was = m.rank_sealed is null ? '—' : m.rank_sealed %}
                  {% set now = m.rank_now is null ? '—' : m.rank_now %}
                  <td>{% if m.rank_sealed == m.rank_now %}
                        <span class="ja-den">{{ was }} &middot; unchanged</span>
                      {% else %}{{ was }} &rarr; {{ now }}{% endif %}</td>
                  <td>{% if m.in_sealed == m.in_now %}
                        <span class="ja-den">{{ m.in_sealed ? 'yes' : 'no' }} &middot; unchanged</span>
                      {% elseif m.in_now %}
                        {# The case that would rewrite a published award: they were not in
                           the standing that was announced and today's rules put them in
                           it. The public page keeps them out, which is the whole point of
                           sealing `in_running` — but an operator must be able to see that
                           this is what happened rather than discover it from a complaint. #}
                        <span class="ja-flag ja-flag--bad">in now, not announced</span>
                      {% else %}
                        <span class="ja-flag ja-flag--warn">announced, out now</span>
                      {% endif %}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        <p style="margin:8px 0 0"><span class="ja-den">Announced is read from
          <code>gates_vote_snapshots</code>, the sealed capture taken at promotion. Nothing
          on this screen can change it, and neither can a rules change &mdash; that is what
          it is for.</span></p>
      {% endif %}
    </div>
  {% elseif cycle %}
    {#
      ── NOT SEALED, WHICH IS TWO DIFFERENT SITUATIONS ──────────────────────────

      `sealed` is null both for an edition nobody has released and for one that reached
      `results` with its announcements suppressed — a boundary crossed more than
      ANNOUNCE_GRACE_DAYS late, where withholding the seal was correct because nothing was
      announced. The second is the expensive one: the public page publishes live figures
      labelled as recomputed, every figure moves whenever the panel or the rules do, and
      the date-driven sweep will never revisit the cycle because the transitions ledger's
      unique key is already claimed.

      So the copy has to distinguish them, and the action is the same either way: one
      audited release that promotes through the quorum-checked path and seals what it
      crowned. `CycleService::manualTransitionError()` still refuses a hand-set status —
      nobody writes `results` here, they ask for a release.
    #}
    <div class="ja-fact">
      {% if cycle.status == 'results' or cycle.status == 'archived' %}
        <b>This edition is published, and its standing is NOT sealed.</b>
        <p>The public pages are recomputing every figure on every view, so a nominee&rsquo;s
          score moves whenever the panel finishes a card or the scoring settings change —
          and the page says so, which is honest and is not a result anybody can be held to.
          Sealing it publishes today&rsquo;s standing as the announced one and freezes it
          there. Do this once you are satisfied the figures below are the ones you mean to
          stand behind.</p>
      {% else %}
        <b>This edition has not been released.</b>
        <p>Releasing it promotes the winners through the same quorum-checked path the
          scheduled run uses, seals the standing below as the announced one, and starts
          publishing it. The seal is what stops a later rules change moving a published
          score &mdash; one real released nominee went from 693 to 885 across a week of
          scoring changes before sealing existed.</p>
      {% endif %}
      <form method="post" action="/admin/result-release/release"
            data-confirm="Release this edition? Winners are promoted and the standing below is sealed as the announcement. This is what tells a nominee they won.">
        <input type="hidden" name="_token" value="{{ csrf_token }}">
        <input type="hidden" name="cycle" value="{{ cycle.id }}">
        <button type="submit" class="ad-btn ad-btn--primary">
          {{ (cycle.status == 'results' or cycle.status == 'archived')
             ? 'Seal this standing as announced' : 'Release this edition' }}
        </button>
      </form>
    </div>
  {% endif %}

  <div class="ja-stats">
    <div class="ja-stat{% if attention.needs_person > 0 %} ja-stat--bad{% endif %}">
      <p class="ja-stat__k">Need a person</p>
      <p class="ja-stat__v">{{ attention.needs_person }}</p>
      <span class="ja-den">of {{ attention.categories }}
        categor{{ attention.categories == 1 ? 'y' : 'ies' }}</span>
    </div>
    <div class="ja-stat{% if attention.blocked > 0 %} ja-stat--bad{% endif %}">
      <p class="ja-stat__k">Crown nobody</p>
      <p class="ja-stat__v">{{ attention.blocked }}</p>
      <span class="ja-den">categories</span>
    </div>
    <div class="ja-stat{% if attention.dead_heats > 0 %} ja-stat--bad{% endif %}">
      <p class="ja-stat__k">Dead heats</p>
      <p class="ja-stat__v">{{ attention.dead_heats }}</p>
      <span class="ja-den">categories</span>
    </div>
    <div class="ja-stat{% if attention.thin_margins > 0 %} ja-stat--bad{% endif %}">
      <p class="ja-stat__k">Won by &le;10</p>
      <p class="ja-stat__v">{{ attention.thin_margins }}</p>
      <span class="ja-den">categories, dead heats excluded</span>
    </div>
    <div class="ja-stat">
      <p class="ja-stat__k">Excluded</p>
      <p class="ja-stat__v">{{ attention.excluded }}</p>
      <span class="ja-den">nominees</span>
    </div>
    <div class="ja-stat">
      <p class="ja-stat__k">Provisional</p>
      <p class="ja-stat__v">{{ attention.provisional }}</p>
      <span class="ja-den">nominees</span>
    </div>
  </div>

  {# ── THE ONE AWARD FOR THE WHOLE CYCLE ──────────────────────────────────
     Drawn from the category winners, on the same CPI and the same comparator the
     categories were decided with — nothing recomputed, no second score invented.

     The comparability caveat is printed WITH it rather than left to be discovered.
     A CPI's judge half is absolute; its community half is a share of the winner's own
     cohort, so leading a three-person category on fifty votes is a full community half
     and a close second in a fifty-thousand-vote category is not. There is no neutral
     denominator — normalising across the cycle inverts the bias and hands the award to
     whoever stands in the most popular category. So the screen shows the field size and
     the denominator beside every contender and lets a person decide. #}
  {% if overall and overall.winner %}
    <div class="ja-card ja-card--overall">
      <div class="ja-cat">
        <h3>Overall winner &mdash; the whole cycle</h3>
        {#- Every nominee who finished, not one per category. It said "N category winners
            in contention" while ranking exactly those — which excluded the cycle's
            second-strongest nominee for the accident of who else entered his category. -#}
        <span class="ja-den">{{ overall.contenders|length }} nominee{{ overall.contenders|length == 1 ? '' : 's' }} across every category</span>
      </div>

      <p class="ja-overall__name">{{ overall.winner.name }}</p>
      <p class="ja-den">{{ overall.winner.category }} &middot; CPI {{ overall.winner.cpi }}
        {%- if overall.margin is not null %} &middot; {{ overall.margin }} ahead of {{ overall.runner_up.name }}{% endif %}</p>

      {% if overall.dead_heat %}
        {# The comparator is [cpi, votes, id], so a dead heat is a tie on CPI AND on the
           TALLY. This printed the organic counts, which are 0 on any paid-only
           deployment — "level on 0 organic votes" as the explanation of a tie between
           two nominees with thousands of votes each. #}
        <p class="ja-caveat"><b>Dead heat.</b> {{ overall.winner.name }} and {{ overall.runner_up.name }}
          are level on CPI <b>{{ overall.winner.cpi }}</b> and on <b>{{ overall.winner.votes|number_format }}</b>
          votes. The methodology cannot separate them; the order above falls back to the
          lower nominee id, which is deterministic and is not a result. This one needs a person.</p>
      {% endif %}

      {#
        AND THIS ONE DESCRIBED THE DEPTH DISCOUNT, WHICH NO LONGER EXISTS.

        It said the community half "is a share of that category's own leader" and "is also
        scaled by how deep that category's support actually was". Both were true of the old
        curve. The half is now two plain shares of the cycle's best, with no depth term at
        all — so this box was explaining an arithmetic that had been removed, immediately
        above a table of numbers produced by its replacement.

        What it says now is the caveat that actually remains, which is about the SIZE OF A
        FIELD rather than the depth of its support: the figures are comparable, and beating
        one rival is still not the same as beating five.
      #}
      <p class="ja-caveat">These figures are <b>comparable</b>. The judge half is absolute
        &mdash; six out of ten is six out of ten anywhere &mdash; and the community half is
        a share of the highest figure in this whole cycle, not of each category&rsquo;s own
        leader, so a community score means the same thing in every row below.
        {% if overall.thinnest_field is not null and overall.thinnest_field <= 3 %}
          What is still uneven is <b>how many people somebody had to beat</b>: the smallest
          field here is <b>{{ overall.thinnest_field }}</b>, and winning a field of that
          size is not the same achievement as winning a crowded one. The field size for
          every nominee is below.
        {% else %}
          What is still uneven is how many people somebody had to beat &mdash; the field
          size for every nominee is below.
        {% endif %}</p>

      {#- The list ranks EVERY nominee who finished, so a deep category may hold several
          places. Said out loud, because a table with two rows from one category reads
          like a bug to anybody expecting one winner each. -#}
      <p class="ja-caveat">This ranks <b>every nominee who finished</b>, not one per
        category &mdash; so a strong second in a deep field can stand above the winner of a
        thin one, which is the whole point of looking at the cycle as a whole. Nominees
        below the judge quorum are excluded: their judge half is not withheld, it is
        <b>zero</b>, so their figure is a community-only score and does not belong in a
        column of finished results.</p>

      <div class="ja-scroll">
        <table class="ja-t">
          {#- One denominator for the whole cycle, so it is stated once rather than
              repeated identically on every row. `overall_reach` is zero when no nominee
              anywhere has a countable ballot row, which is the case where the tally takes
              the whole community half and there is no reach column to fill. -#}
          {% set overall_scale = 0 %}{% set overall_reach = 0 %}
          {% for cat in categories %}
            {% if loop.first %}{% set overall_scale = cat.cohort_max %}
              {% set overall_reach = cat.cohort_max_unique %}{% endif %}
          {% endfor %}
          <thead><tr>
            <th>Nominee</th><th>Category</th><th class="ja-num">CPI</th>
            <th class="ja-num">Field</th>
            <th class="ja-num">{{ paid_only ? 'Free' : 'Organic' }}
              {%- if paid_only %}<span class="ja-den">not offered</span>{% endif %}</th>
            {#
              THIS COLUMN WAS THE COHORT MAX, AND IT IS THE SAME NUMBER ON EVERY ROW NOW.

              It existed to show that the comparison was uneven: each nominee was measured
              against their own category's leader, so the CPIs in this table were shares of
              different things and the column was the evidence. The denominator is the
              edition's now, so it is a constant down the page — the very fact that made
              the column worth printing is what removed the need for it.

              Backers is the figure that varies and that decides 70% of each community
              half, and it appeared in this table nowhere.
            #}
            <th class="ja-num">Backers</th>
          </tr></thead>
          <tbody>
            {% for c in overall.contenders %}
              <tr{% if loop.first %} class="is-win"{% endif %}>
                {#- A list mixing winners and runners-up has to say which is which, or it
                    reads as a second set of category results disagreeing with the first. -#}
                <td>{{ c.name }}
                  {%- if not c.won_category %} <span class="ja-den">2nd or lower in their category</span>{% endif %}</td>
                <td>{{ c.category }}</td>
                <td class="ja-num">{{ c.cpi }}</td>
                <td class="ja-num">{{ c.field }}
                  {%- if c.field <= 3 %} <span class="ja-den">thin</span>{% endif %}</td>
                {# An em dash, not a zero. "0" in a column headed Free reads as a fact
                   about this winner's support; there was no free vote to have. #}
                <td class="ja-num">{% if paid_only %}&mdash;{% else %}{{ c.organic|number_format }}{% endif %}</td>
                <td class="ja-num">
                  {%- if c.reach_unmeasured %}<span class="ja-den">not counted</span>
                  {%- elseif overall_reach > 0 %}{{ c.unique_voters|number_format }}
                  {%- else %}&mdash;{% endif %}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  {% elseif overall %}
    <div class="ja-card">
      <div class="ja-cat"><h3>Overall winner &mdash; the whole cycle</h3></div>
      <p class="ja-empty">No category has crowned anybody yet, so there is nobody to draw an
        overall winner from. This is the ordinary state before a release, not a fault.</p>
    </div>
  {% endif %}

  {% for c in categories %}
    <div class="ja-card">
      <div class="ja-cat">
        <h3>{{ c.category.title|default('Category #' ~ c.category.id|default('?')) }}</h3>
        <span class="ja-den">
          {{ (c.weights.community * 100)|round }}% community &middot;
          {{ (c.weights.judge * 100)|round }}% judges &middot;
          quorum {{ c.quorum }} judge{{ c.quorum == 1 ? '' : 's' }}
          {%- if c.shortlisted is not null %} &middot; shortlisted field of {{ c.shortlisted|length }}{% endif %}
          {#- Said ONCE, here, rather than as a sub-label on every row. On a paid-only
              ballot every vote in the category was contributed, so "N bought or awarded"
              under each nominee marked out the entire field and singled out nobody. #}
          {%- if c.paid_only %} &middot; <b>every vote here was contributed</b> &mdash; free
          voting is switched off, so there was no other way to vote{% endif %}
        </span>
      </div>

      {# ── THE DENOMINATOR ──────────────────────────────────────────────────
         The community half is votes measured against the BIGGEST vote count in the
         category, not against the votes cast — so 2,650 organic is worth 247 points
         behind a leader on 4,820 and 450 points on its own. Every column needed to
         check a CPI was on this page except this one, which is the only one that
         cannot be guessed.

         The cohort is the published field where a category shortlists, so somebody taken
         off the list no longer sets the scale for the people still in it. The QUORUM is
         deliberately not applied to it — below quorum is pending rather than out, and
         dropping an unjudged nominee from the denominator would move every score here the
         moment their panel finished. That leaves one case worth saying out loud. #}
      {# ── THE WHOLE COMMUNITY HALF IS OFF ─────────────────────────────────
         Said before the table, not after it, because everything below is a ranking
         decided by the panel alone and a reader has to know that before they read it.

         The number in the heading still says what the rules weigh the community at, and
         that is the point: the gap between "45% of it" at the top and zero in every row
         is the finding. #}
      {#
        ── THIS CAVEAT DESCRIBED A FAULT THAT NO LONGER EXISTS ─────────────────

        It said "not one nominee here has an ORGANIC vote" and then, flatly, "Votes ARE
        recorded against these nominees" — written when the index read
        `organic_vote_count` and a category could hold thousands of votes while scoring
        zero. The index counts every vote now, so `community_dark` means something else
        entirely: NOBODY VOTED AT ALL.

        Left as it was, this told an operator looking at a category with no votes in it
        that their votes existed and their counters had drifted, and offered them a recount
        that would find nothing. Confidently wrong, on the screen an award is signed off
        from.
      #}
      {% if c.community_dark %}
        <p class="ja-caveat"><b>Not one nominee here has a single vote</b>, so the community
          half is zero for the entire field and this category would be decided by the panel
          alone &mdash; at {{ (c.weights.judge * 100)|round }}% of the index doing 100% of
          the work. The order below is the judges&rsquo; order.<br>
          Nothing here is a counter that has drifted: the ballot is empty. The promotion
          refuses to crown this category for that reason, and it needs a person rather than
          a winner.</p>
      {% endif %}

      {% if c.scale_is_out %}
        <p class="ja-caveat">The community half here is measured against
          <b>{{ c.cohort_max|number_format }}</b> votes &mdash; {{ c.scale_set_by }}&rsquo;s{% if not c.scale_in_category %},
          in {{ c.scale_category ?: 'another category' }}{% endif %} &mdash; and
          {{ c.scale_set_by }}&rsquo;s panel has <b>not finished</b>. They are in the field,
          so their votes set the scale for it; they are not yet winner-eligible, so they are
          not in a ranking. Nothing here is wrong &mdash; but if their scorecards land before
          you release, every community half <b>in this cycle</b> changes, and the order can
          change with it. Finish that panel first.</p>
      {% endif %}

      {#
        ── WHERE THE DENOMINATOR CAME FROM, WHEN IT CAME FROM SOMEWHERE ELSE ──

        The community half is a share of the largest tally in the whole EDITION, not in this
        category, so the nominee holding it is usually in a different category and the
        percentages below refer to a number that appears nowhere on this part of the page.
        Without this line an operator reading "5% of 1,955" in a category whose own leader
        has 89 votes has no way to find the 1,955.
      #}
      {#
        ── AND WHAT THAT LEAVES THIS CATEGORY TO WIN ─────────────────────────

        Stated as a number rather than as a caveat about every category at once. The first
        version of this box fired on nearly every category — the scale-setter is normally
        somewhere else — and said something vague about panels deciding. A warning that
        appears everywhere and quantifies nothing is one an operator learns to scroll past,
        which is how the findings that matter stop being read.

        `community_dark` does not cover this: these nominees have votes. They just have very
        few against the edition, and every figure on the page looks entirely ordinary.
      #}
      {% if c.scale_set_by and c.local_max > 0 and c.cohort_max > 0 %}
        {% set localpct = (c.local_max / c.cohort_max * 100)|round %}
        {% if localpct < 25 %}
          <p class="ja-caveat">The best-supported nominee here has
            <b>{{ c.local_max|number_format }}</b> votes against a cycle scale of
            <b>{{ c.cohort_max|number_format }}</b> &mdash; {{ localpct }}% of it. So the
            most community credit anybody in this category can earn is roughly
            <b>{{ (c.weights.community * 1000 * c.local_max / c.cohort_max)|round }}</b> of
            {{ (c.weights.community * 1000)|round }} points, and the panel&rsquo;s
            {{ (c.weights.judge * 1000)|round }} decides this award very largely on its own.
            That is the rule working, not a fault: a share of the cycle means the same thing
            in every category, which is what makes the standing below addable. It is here so
            you know before you release, not after.</p>
        {% endif %}
      {% endif %}

      {#
        THE LEGACY SCOPE, SAID OUT LOUD. `community_scope = category` changes every number
        on this page, and without this line a cycle running under it looks identical to one
        that is not — which is the whole reason a setting nobody can see is dangerous.
      #}
      {% if c.cohort_scope == 'category' %}
        <p class="ja-caveat"><b>This cycle is scored on the old per-category scale.</b>
          Every category is normalised to its own leader, so each category&rsquo;s leader
          takes the full {{ (c.weights.community * 1000)|round }} community points however
          small their field &mdash; and the cycle standing then ranks those figures against
          each other, which is not a comparison that means anything. The setting exists to
          reproduce a standing that has already been announced. If this cycle has not been
          announced, this is not the scale you want.</p>
      {% endif %}

      {#
        ── A TALLY WITH NO VOTE ROWS BEHIND IT ───────────────────────────────

        Seventy per cent of the community half is REACH — how many people, counted from
        `gates_votes`. A nominee whose tally says there is support while the ledger holds no
        row for them scores zero on that term, and every other figure on their line looks
        entirely normal. The fix is a data one and nothing else on this screen would ever
        point at it.
      #}
      {% if c.reach_unmeasured > 0 %}
        <p class="ja-caveat"><b>{{ c.reach_unmeasured }} nominee{{ c.reach_unmeasured > 1 ? 's' : '' }}
          here {{ c.reach_unmeasured > 1 ? 'have' : 'has' }} a vote total with no votes
          behind it.</b> The tally is on the nominee record and the ballot holds no row for
          it &mdash; an import, a restore, or a cycle whose rows were cleared. Seventy per
          cent of the community half counts PEOPLE, and there are no people to count, so
          that part scores zero for them. Their totals still count toward the other thirty
          per cent. Nothing here is fraud and nothing here is wrong with their support; the
          rows are missing.</p>
      {% endif %}

      {# ── THE THINGS THAT NEEDED A HUMAN AND WENT INTO A LOG ─────────────
         "no nominee meets the judge quorum" and "DEAD HEAT ... this one needs a human"
         were written into the maintenance log by the promotion. There is no shell on this
         deployment, so nobody has ever read either sentence. #}
      {% if c.blocked %}
        <div class="ja-fact"><b>This category crowns nobody.</b><p>{{ c.blocked }}</p></div>
      {% elseif c.dead_heat %}
        <div class="ja-fact">
          <b>Dead heat for first place.</b>
          <p>{{ c.winner.name }} and {{ c.runner_up.name }} are on the same Cultural Power
            Index with the same organic support. The methodology cannot separate them, so
            the award goes to the lower nominee id to keep the promotion deterministic.
            <strong>This one needs a person to decide.</strong></p>
          {# The sentence asks for a decision, so it has to point at what the decision is
             made ON. Two nominees can be identical on every figure this page shows and
             have been read completely differently by the panel — a unanimous 8 across the
             board against two judges who disagreed on every criterion and cancelled out.
             That difference exists only in the marks, and until this link the page asked
             for a judgement without offering the evidence for one. #}
          <p><b>What the panel actually said:</b>
            <a href="/admin/scorecard/{{ c.winner.nominee_id }}">{{ c.winner.name }}&rsquo;s marks</a>
            &middot;
            <a href="/admin/scorecard/{{ c.runner_up.nominee_id }}">{{ c.runner_up.name }}&rsquo;s marks</a>.
            Identical averages are not identical judging.</p>
        </div>
      {% endif %}

      {# ── THE WORKING ──────────────────────────────────────────────────────
         The table showed the inputs and the answer and no way between them. An
         operator defending a result could read the votes, the mark, the weights and
         the index and still not say why 2,650 organic votes and an 8 produce 687.

         So the two halves are printed as the points they contribute, and they sum
         EXACTLY to the CPI beside them — ResultRelease gives the judge half the single
         rounding step for that reason. A sum that does not equal the figure next to it
         would be worse than showing no working at all. #}
      <div class="ja-scroll">
      <table class="ja-t">
        <thead>
          <tr>
            <th>#</th><th>Nominee</th><th>Index<span class="ja-den">of 1000</span></th>
            <th>Community<span class="ja-den">{{ (c.weights.community * 100)|round }}% of it</span></th>
            <th>Judges<span class="ja-den">{{ (c.weights.judge * 100)|round }}% of it</span></th>
            <th>{{ c.paid_only ? 'Free' : 'Organic' }}
              {%- if c.paid_only %}<span class="ja-den">not offered</span>{% endif %}</th>
            <th>All votes</th><th>Standing</th>
          </tr>
        </thead>
        <tbody>
          {% for r in c.rows %}
            {# The rule marks WHERE THE AWARD FALLS, so it may only be drawn when there
               is something on the other side of it. Applied to rank 2 unconditionally it
               drew a heavy line under the last row of every two-nominee category — a
               boundary with nothing below it, which reads as a total. #}
            {% set cut = r.rank == 2 and c.rows|length > loop.index %}
            <tr class="{% if not r.in_running %}rr--out{% elseif cut %}rr--cut{% endif %}">
              <td class="ja-rank">{{ r.rank ?: '&mdash;'|raw }}</td>
              <td class="ja-name">{{ r.name }}
                {%- if r.out_reason %}<span class="ja-den">{{ r.out_reason }}</span>{% endif %}</td>
              <td class="ja-num">{{ r.cpi }}
                {# The index as a bar, because a column of four-digit numbers does not
                   show a gap and the gap is the whole question. #}
                <span class="ja-bar"><i style="width:{{ (r.cpi / 10)|round }}%"></i></span>
                <span class="ja-den">{{ r.community_points }} + {{ r.judge_points }}</span>
              </td>
              <td class="ja-num">{{ r.community_points }}
                {# The step nobody could take: from a vote count to a number of points.
                   Except on the row of the nominee who IS the scale, where "100% of their
                   own votes" is a tautology dressed as a denominator — and the fact worth
                   stating there is the other one. #}
                {#
                  THE WORD "ORGANIC" WAS WRONG HERE AND IT LOOKED LIKE FRAUD.

                  These lines said "most organic votes here" and "79% of Ajayi's 1,955"
                  while the ORGANIC column beside them read 0 — because the index counts
                  every vote now and this copy still described the old rule. An operator
                  reading a screen that credits 1,955 "organic" votes to somebody with none
                  is reading, correctly, a screen they cannot trust.
                #}
                {% if c.community_dark %}
                  {# Nobody in the field has a single vote, so there is no scale and no
                     scale-setter, and the fraction printed here came out as "0% of ’s 0" —
                     a broken sentence where the explanation should be. #}
                  <span class="ja-den">no votes to weigh</span>
                {% elseif r.nominee_id == c.scale_set_by_id %}
                  <span class="ja-den">most votes in the cycle &mdash; sets the tally scale</span>
                {% else %}
                  <span class="ja-den">{{ r.community_share }}% of
                    {{ c.scale_set_by }}&rsquo;s {{ c.cohort_max|number_format }}
                    {%- if not c.scale_in_category %} in
                      {{ c.scale_category ?: 'another category' }}{% endif %}</span>
                {% endif %}
                {#
                  ── THE BIGGER TERM OF THE TWO, WHICH HAD NO READER AT ALL ──

                  Seventy per cent of the community half is people, measured against the
                  most any nominee in the cycle has. The scorer computed that denominator
                  and named who holds it, and no screen printed either — so the line above
                  explained 135 of the 450 while reading like the whole of it, and the term
                  that actually decides the half was invisible.
                #}
                {#
                  ── AND UNDER `ideal` NOBODY "SETS THE REACH SCALE" ─────────

                  On `reach` the denominator of the 70% is the most PEOPLE anybody had, so
                  naming its holder is the whole point of this cell. On `ideal` there is no
                  such denominator: both terms divide by the largest TALLY. Printing "most
                  in the cycle, sets the reach scale" there would name a scale that does not
                  exist, on the screen an award is signed off from — the same shape of fault
                  as the four help-centre promises this rule change has already retired
                  once. So the two bases get two cells.
                #}
                {% if c.community_basis == 'ideal' and c.cohort_max_unique > 0 and not r.reach_unmeasured %}
                  <span class="ja-den">{{ r.unique_voters|number_format }} backer{{ r.unique_voters == 1 ? '' : 's' }}
                    {#- Of the IDEAL, which is the tally denominator — the same figure the
                        community share above is measured against, so an operator can check
                        the 70% and the 30% against one number. -#}
                    {%- if c.cohort_max > 0 %} of {{ c.cohort_max|number_format }} possible
                      {%- if c.scale_set_by %} &mdash; {{ c.scale_set_by }}&rsquo;s tally
                        {%- if c.scale_category and not c.scale_in_category %},
                          in {{ c.scale_category }}
                        {%- endif %}
                      {%- endif %}
                    {%- endif %}</span>
                {% elseif c.community_basis == 'reach' and c.cohort_max_unique > 0 and not r.reach_unmeasured %}
                  <span class="ja-den">{{ r.unique_voters|number_format }} backer{{ r.unique_voters == 1 ? '' : 's' }}
                    {%- if c.cohort_max_unique_by and r.nominee_id == c.cohort_max_unique_by.id %}
                      &mdash; most in the cycle, sets the reach scale
                    {%- else %} of {{ c.cohort_max_unique|number_format }}
                      {#- the holder, because 70% of the half is measured against them -#}
                      &mdash; {{ c.cohort_max_unique_by.name|default('') }}&rsquo;s
                      {%- if c.cohort_max_unique_by and c.cohort_max_unique_by.category_id != c.category.id %},
                        in {{ c.cohort_max_unique_by.category_title|default('another category') }}
                      {%- endif %}
                    {%- endif %}</span>
                {% endif %}
                {# The reach term is 70% of the half and it is counted from vote rows.
                   Said on the row it applies to as well as in the caveat above, because
                   the caveat is a count and this is the person it happened to. #}
                {% if r.reach_unmeasured %}
                  <span class="ja-den ja-den--warn">no vote rows &mdash; the 70% that counts
                    people scores zero</span>
                {% endif %}
                {#
                  ── THERE IS NO SUCH THING AS A CATEGORY DISCOUNT ──────────

                  A warning used to sit here saying this category's community weight had
                  been scaled down, against a full-credit mark. It described
                  `CpiService::depth()`, which once scaled a category's whole community
                  weight by how deep that category's own support was.

                  Its exact wording is deliberately NOT reproduced in this comment: the
                  sweep that keeps it gone is a plain text scan over every template
                  ({@see \Tests\Unit\EditionScaleTest}), and a comment quoting the phrase
                  would trip it — which is the sweep working, and a good reason to describe
                  the removed label rather than repeat it.

                  It cannot be right under any basis this platform now runs:

                    · under the default the depth term is never called at all — the
                      full-credit mark decides nothing;
                    · under `relative` it reads the cohort maximum, and that is the whole
                      EDITION's maximum now, so it is one constant applied identically to
                      every category in the cycle. Not a category discount: a uniform
                      scaling that changes no order anywhere;
                    · under `absolute` it reads the nominee's own tally, so it is not about
                      categories either.

                  A screen that names a per-category adjustment is describing a mechanism
                  the arithmetic no longer has, on the page an award is signed off from. The
                  scale is the edition and the category is not a scoring unit.
                #}
              </td>
              {# The judge half is an average of averages of marks, three steps from
                 anything a judge wrote — so it is the one figure on this page that
                 cannot be checked ON this page. The link is the rest of the answer. #}
              <td class="ja-num">{{ r.judge_points }}
                {%- if r.provisional %}
                  <span class="ja-den">judge half not counted</span>
                {%- elseif r.judge_score is not null %}
                  {#
                    TWO DECIMALS, BECAUSE ONE CANNOT EXPLAIN THE NUMBER ABOVE IT.

                    The scorer keeps the panel average to two places and computes the judge
                    half from that. This printed ONE — so 7.62 and 7.63 both read "7.6"
                    while paying 419 and 420, and the screen showed two nominees with
                    apparently identical marks and different judge halves, on the page whose
                    whole job is showing how a number was reached. `round(2)` rather than a
                    fixed format so a clean 7.5 still reads 7.5 and only a mark that needs
                    the second place carries one.
                  #}
                  <span class="ja-den">{{ r.judge_score|round(2) }}/10 from
                    {{ r.judges }} judge{{ r.judges == 1 ? '' : 's' }}</span>
                {%- endif %}
                {%- if r.judges < c.quorum %}
                  <span class="ja-flag ja-flag--warn">{{ r.judges }} of {{ c.quorum }}</span>
                {%- endif %}
                <span class="ja-den"><a href="/admin/scorecard/{{ r.nominee_id }}">see the marks</a></span>
              </td>
              <td class="ja-num">{% if c.paid_only %}&mdash;{% else %}{{ r.organic|number_format }}{% endif %}</td>
              {# BOTH numbers, and the roles have swapped: `vote_count` is what the index
                 counts AND what the public page shows; `organic` is how much of it was not
                 bought, which decides nothing now but is published everywhere the total is
                 so a reader can see what a tally is made of.

                 EXCEPT WHERE THERE IS NO FREE VOTE TO HAVE. This sub-label fired on every
                 row of every category on a paid-only deployment — "1,955 bought or
                 awarded", "1,536 bought or awarded", all the way down — so a mark that
                 exists to single out an unusually purchased tally was applied to the whole
                 field. Said once under the category heading instead. #}
              <td class="ja-num">{{ r.vote_count|number_format }}
                {%- if not c.paid_only and r.vote_count > r.organic %}
                  <span class="ja-den">{{ (r.vote_count - r.organic)|number_format }} bought or awarded</span>
                {% endif %}
              </td>
              <td>
                {% if r.status == 'winner' %}<span class="ja-flag">crowned</span>
                {% elseif r.status == 'runner_up' %}<span class="ja-flag">runner-up</span>
                {% elseif r.rank == 1 %}<span class="ja-flag">wins</span>
                {% elseif r.rank == 2 %}<span class="ja-flag">second</span>
                {% else %}&mdash;{% endif %}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
      </div>

      {# ── THE MARGIN, IN ONE PLACE ─────────────────────────────────────────
         It was stated twice: a yellow warning above the table when the gap was ten or
         under, and a grey line below it when the gap was larger. Same fact, two
         locations, two styles — so an operator scanning several categories learnt to
         read the margin off whichever one they happened to find, and a category with
         the warning looked structurally different from one without it rather than
         merely closer. One element, always in the same place; the severity changes,
         the position does not. #}
      {% if c.tie_broken_by_votes %}
        {# "First and second are 0 apart" beside a WINS badge, and nothing saying what
           broke a tie the page had just called exact. This is the single moment the
           tiebreak decides an award, so it is the moment to say what it read.

           IT USED TO SAY "organic support", and printed the two organic counts. That was
           the old comparator, and on any deployment with free voting switched off it
           would have rendered as "takes it on organic support — 0 votes against 0":
           self-refuting, at the exact moment an operator is deciding whether to sign a
           result off. The comparator reads the full tally now, the same figure the index
           normalises over, and this reads it from the same key. #}
        <p class="ja-caveat">The index is <b>exactly level</b> at {{ c.winner.cpi }}.
          {{ c.winner.name }} takes it on <b>votes</b> &mdash;
          {{ c.winner.votes|number_format }} against
          {{ c.runner_up.votes|number_format }}. The tiebreak reads the same tally the
          community half normalises over, so it cannot disagree with the half it is
          breaking.</p>
      {% elseif c.margin is not null and not c.dead_heat %}
        {% if c.margin <= 10 %}
          <p class="ja-caveat">First and second are <b>{{ c.margin }}</b> apart on a
            0&ndash;1000 index. A result this close can turn on one judge changing one
            mark &mdash; the <a href="/admin/judging-audit">judging audit</a> says whether
            one did.</p>
        {% else %}
          <p class="ja-den" style="margin-top:12px">First is {{ c.margin }} ahead of second
            on a 0&ndash;1000 index.</p>
        {% endif %}
      {% endif %}
    </div>
  {% endfor %}

  <p class="ja-den" style="margin-top:16px">&ldquo;Index&rdquo; is the Cultural Power
    Index: the community half and the judge half, weighted as shown on each category and
    scaled to 1000.<br>
    {#
      AND THE ±1 THAT SURVIVES SHOWING THE MARK PRECISELY.

      The index rounds the SUM once and the community half rounds separately, so the judge
      half — printed as the remainder — absorbs the difference. Two nominees on the same
      panel mark can therefore show judge halves a point apart. That is deliberate: the
      alternative is two independently rounded halves that do not add up to the figure
      printed beside them, which defeats the only reason to publish the working. Said here
      because otherwise it reads as a miscalculation on the screen an award is signed off
      from. {@see CpiService::split()}
    #}
    The two halves always add to the index exactly, so the <em>judge</em> half carries the
    rounding &mdash; which is why two nominees on the same panel mark can show judge halves
    one point apart. Nothing has been miscounted; the alternative is halves that do not add
    up to the number beside them.</p>
  <p class="ja-caveat">A provisional figure is not a Cultural Power Index. Where the judge
    quorum has not been met the judge half is scored as absent rather than renormalised
    away &mdash; the conservative direction, because renormalising would put an unjudged
    nominee at the top of the board on popularity alone, which is the one thing this
    platform exists to prevent.</p>
{% endif %}

{% endblock %}
