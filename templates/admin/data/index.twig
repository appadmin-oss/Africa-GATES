{% extends "admin/layout.twig" %}
{% block topbar_title %}Data{% endblock %}
{% block content %}
<p style="margin:0 0 16px;color:var(--ad-text-mute,#5a6d6f);font-size:14px">Every dataset collected across the platform. Each opens a filterable, paginated table with full-detail records and CSV export.</p>
<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:14px">
  {% for c in cards %}
  <a href="/admin/data/{{ c.key }}" class="ad-card" style="text-decoration:none;color:inherit;padding:16px 18px;display:block">
    <div style="font-size:10.5px;font-weight:600;letter-spacing:.07em;text-transform:uppercase;color:var(--ad-text-mute,#8a9a9c)">{{ c.group }}</div>
    <div style="font-weight:700;font-size:15.5px;color:var(--ad-text,#10292C);margin-top:5px">{{ c.label }}</div>
    <div style="font-family:'Space Mono',monospace;font-size:22px;font-weight:700;color:var(--ad-accent,#237b22);margin-top:8px">{{ c.count|number_format }}</div>
  </a>
  {% endfor %}
</div>
{% endblock %}
