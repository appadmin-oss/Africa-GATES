{% extends 'admin/layout.twig' %}

{#
  How one award programme judged, and who judged it.

  The spine of this page is `gates_judge_score_log`, which has recorded every change to
  every mark since the day it was added and which nothing read. An organiser asked "did
  anybody change a score after the panel met" had to answer that they could not tell — on
  the platform whose whole argument is that its results can be checked.

  Two things here are FACTS and are styled as such: a judge who declared a conflict and
  scored anyway, and a mark changed after the results date. Everything else is arithmetic
  over small samples and carries its denominator in the same row as its number, because a
  lean with no comparison count is a rumour about a named person.
#}

{% block head_styles %}
<style nonce="{{ csp_nonce }}">
  .ja-lede{ background:#fff; border:1px solid rgba(16,41,44,.1); border-radius:14px;
    padding:18px 20px; margin-bottom:16px }
  .ja-lede h2{ margin:0 0 6px; font-size:14.5px; color:#10292C }
  .ja-lede p{ margin:8px 0 0; font-size:12.5px; line-height:1.7; color:#5a6d6f; max-width:76ch }
  .ja-row{ display:flex; gap:10px; flex-wrap:wrap; align-items:flex-end; margin-bottom:14px }

  .ja-stats{ display:grid; grid-template-columns:repeat(auto-fit,minmax(132px,1fr)); gap:1px;
    background:rgba(16,41,44,.1); border:1px solid rgba(16,41,44,.1); border-radius:10px;
    overflow:hidden; margin-bottom:16px }
  .ja-stat{ background:#fff; padding:12px 14px }
  .ja-stat__k{ font-family:var(--ag-font-mono,monospace); font-size:10px; font-weight:700;
    letter-spacing:.09em; text-transform:uppercase; color:#5a6d6f; margin:0 }
  .ja-stat__v{ font-family:var(--ag-font-mono,monospace); font-size:20px; font-weight:700;
    color:#10292C; margin:4px 0 0; line-height:1 }
  /* Reserved for a count that should be zero. Never used for a large number. */
  .ja-stat--bad .ja-stat__v{ color:#8a2b18 }

  .ja-card{ background:#fff; border:1px solid rgba(16,41,44,.1); border-radius:14px;
    padding:18px 20px; margin-bottom:16px }
  .ja-card h3{ margin:0 0 4px; font-size:13.5px; color:#10292C }
  .ja-card > p{ margin:0 0 14px; font-size:12.5px; line-height:1.7; color:#5a6d6f; max-width:76ch }

  .ja-t{ width:100%; border-collapse:collapse; font-size:12.5px }
  .ja-t th{ text-align:left; font-family:var(--ag-font-mono,monospace); font-size:10px;
    font-weight:700; letter-spacing:.09em; text-transform:uppercase; color:#5a6d6f;
    padding:0 10px 8px 0; border-bottom:1px solid rgba(16,41,44,.12) }
  .ja-t td{ padding:10px 10px 10px 0; border-bottom:1px solid rgba(16,41,44,.06);
    color:#3d4b4d; vertical-align:top }
  .ja-t tr:last-child td{ border-bottom:none }
  .ja-num{ font-family:var(--ag-font-mono,monospace); font-variant-numeric:tabular-nums }
  .ja-name{ font-weight:600; color:#10292C }
  /* The denominator, set beside the figure it qualifies rather than under it. */
  .ja-den{ display:block; margin-top:3px; font-size:11px; color:#5a6d6f }

  .ja-flag{ font-family:var(--ag-font-mono,monospace); font-size:10px; font-weight:700;
    letter-spacing:.05em; text-transform:uppercase; padding:3px 8px; border-radius:999px;
    background:rgba(16,41,44,.07); color:#3d4b4d; white-space:nowrap }
  .ja-flag--bad{ background:#fdecea; color:#8a2b18 }
  .ja-flag--warn{ background:#fffaf0; color:#7a5605 }

  .ja-fact{ border-left:3px solid #8a2b18; background:#fdf6f5; border-radius:0 10px 10px 0;
    padding:13px 16px; margin-bottom:12px }
  .ja-fact b{ color:#8a2b18 }
  .ja-fact p{ margin:6px 0 0; font-size:12.5px; line-height:1.65; color:#5a4442 }

  .ja-caveat{ margin:14px 0 0; padding:12px 15px; border-left:3px solid #d49a0e;
    background:#fffaf0; border-radius:0 8px 8px 0; font-size:12.5px; line-height:1.65;
    color:#7a5605 }
  .ja-empty{ font-size:12.5px; line-height:1.7; color:#5a6d6f; margin:0 }
</style>
{% endblock %}

{% block topbar_title %}Judging audit{% endblock %}

{% block content %}

<div class="ja-lede">
  <h2>How this award decides, and who has been deciding it</h2>
  <p>Every mark and every change to a mark, across every cycle this programme has run.
    Two things on this page are records of what happened and need no interpretation: a
    judge who declared a conflict and scored anyway, and a mark changed after the results
    date. Everything else is arithmetic over small numbers, and carries the count it was
    computed from.</p>
  <p>For whether one cycle&rsquo;s result is sound &mdash; bias, collusion, vote fraud &mdash;
    see <a href="/admin/integrity">Integrity</a>, which asks that question of a single cycle
    with the caveats that belong to it. For what these marks became &mdash; the score
    each nominee carries, and who it crowns &mdash; see the
    <a href="/admin/result-release">result release</a>.</p>
</div>

{# ══ DISPUTED DOSSIER MAPS ═══════════════════════════════════════════════════
   Programme-independent, so it sits above the selector rather than inside it: a
   judge disputing a map is a fact about one entry, and hiding it behind whichever
   programme happens to be selected is how it goes unseen.

   Shown only when there is something to show. An empty "no maps disputed" panel
   on every load teaches an operator to skip the region it appears in. #}
{% if disputed|default([])|length %}
  <div class="ja-lede" style="border-left:4px solid #f3b416;padding-left:14px">
    <h2>Dossier maps the panel has disputed</h2>
    <p>The map is written above a nominee&rsquo;s evidence and read before it, so it frames
      everything after. A judge saying it misreads the dossier has hidden it for
      themselves; whether to withdraw it from the whole panel is a decision for you.
      <strong>One judge disagreeing is a judge. Three is a map.</strong></p>

    <div class="iv-scroll">
      <table class="ad-table">
        <thead><tr><th>Nominee</th><th class="an-num">Judges</th><th>What they said</th><th>Last</th></tr></thead>
        <tbody>
        {% for d in disputed %}
          <tr>
            <td>{{ d.nominee }}</td>
            <td class="an-num">{{ d.flags }}</td>
            <td>
              {% if d.reasons|length %}
                {# A judge's own words, escaped by Twig. They are typed mid-ballot and are
                   not public, but they are still somebody's free text on an admin page. #}
                {% for r in d.reasons|slice(0, 3) %}<div>&ldquo;{{ r }}&rdquo;</div>{% endfor %}
                {% if d.reasons|length > 3 %}<div class="iv-mute">and {{ d.reasons|length - 3 }} more</div>{% endif %}
              {% else %}
                <span class="iv-mute">no reason given</span>
              {% endif %}
            </td>
            <td>{{ d.last }}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
{% endif %}

<form method="get" action="/admin/judging-audit" class="ja-row">
  <div>
    <label for="jaProg" style="display:block;font-size:12px;font-weight:600;color:#10292C">Award programme</label>
    {# data-ag-do, NOT an inline onchange: the admin CSP has no 'unsafe-inline' in
       script-src, so an inline handler silently never runs and CspTest fails the build
       over it. The button below is not decoration — it is what makes the selector work
       if admin.js ever fails to load. #}
    <select id="jaProg" name="programme" data-ag-do="submit-form" style="margin-top:5px">
      {% for p in programmes %}
        <option value="{{ p.id }}"{% if p.id == programme_id %} selected{% endif %}>{{ p.title }}</option>
      {% endfor %}
    </select>
  </div>
  <button type="submit" class="ad-btn">Show</button>
</form>

{% if failed %}
  <div class="ja-fact">
    <b>This audit could not be built.</b>
    <p>The error is in the server log. Nothing below is missing because it is empty &mdash;
      it is missing because the query did not run, and those two look the same on a screen.</p>
  </div>
{% elseif audit.totals.scores == 0 %}
  <div class="ja-card">
    <h3>Nothing has been judged yet</h3>
    <p class="ja-empty">No marks have been recorded for this programme. That is not a
      finding &mdash; a programme in nominations or voting has nothing to audit until a
      panel has scored.</p>
  </div>
{% else %}

  <div class="ja-stats">
    <div class="ja-stat">
      <p class="ja-stat__k">Cycles</p>
      <p class="ja-stat__v">{{ audit.totals.cycles }}</p>
    </div>
    <div class="ja-stat">
      <p class="ja-stat__k">Nominees</p>
      <p class="ja-stat__v">{{ audit.totals.nominees }}</p>
    </div>
    <div class="ja-stat{% if audit.totals.unjudged > 0 %} ja-stat--bad{% endif %}">
      <p class="ja-stat__k">Never scored</p>
      <p class="ja-stat__v">{{ audit.totals.unjudged }}</p>
    </div>
    <div class="ja-stat">
      <p class="ja-stat__k">Judges</p>
      <p class="ja-stat__v">{{ audit.totals.judges }}</p>
    </div>
    <div class="ja-stat">
      <p class="ja-stat__k">Marks</p>
      <p class="ja-stat__v">{{ audit.totals.scores }}</p>
    </div>
    <div class="ja-stat{% if audit.conflicts|length > 0 %} ja-stat--bad{% endif %}">
      <p class="ja-stat__k">Conflicts breached</p>
      <p class="ja-stat__v">{{ audit.conflicts|length }}</p>
    </div>
  </div>

  {# ── CRITERIA IN FORCE THAT NOBODY HAS EVER BEEN ASKED ───────────────────
     The largest single fact about how an award decides, and it had no row to appear
     in. `JudgeRubric::effective()` is the programme's own criteria PLUS the global
     rubric it inherits, so a programme that adds three without retiring the four it
     inherits has a seven-criterion rubric its ballot only ever asks three of. The
     scorer divides by the weight actually marked, so the missing share is silently
     reweighted onto the criteria the panel did use.

     Before this, the only trace was a "what each criterion did" table whose weights
     added up to 57%, and a part-marked card that listed every scorecard in the
     programme as half-finished — a rubric fault reported as a panel of judges who
     could not finish anything. #}
  {% if audit.incomplete.never_marked|length %}
    <div class="ja-card">
      <h3>Criteria in force that nobody has ever marked</h3>
      <div class="ja-fact">
        <b>{{ audit.incomplete.dead_share }}% of every mark in this programme was decided
          by criteria no judge has been asked.</b>
        <p>These are active in the rubric and carry their share of the weight, and no
          scorecard in any cycle has ever covered them. A part-marked scorecard is not
          discarded &mdash; the weighted average divides by the weight actually marked
          &mdash; so that share was reweighted onto the
          {{ audit.incomplete.in_play }} criteri{{ audit.incomplete.in_play == 1 ? 'on' : 'a' }}
          the panel did use, on every nominee, in every cycle.</p>
        <p>Either they belong on the ballot or they belong out of the rubric. Leaving
          them is a published methodology this award has never applied.</p>
      </div>
      <table class="ja-t">
        <thead><tr><th>Criterion</th><th>Worth</th><th>Marks</th></tr></thead>
        <tbody>
          {% for c in audit.incomplete.never_marked %}
            <tr>
              <td class="ja-name">{{ c.label }}</td>
              <td class="ja-num">{% if c.share is not null %}{{ c.share }}%{% else %}&mdash;{% endif %}</td>
              <td class="ja-num"><span class="ja-flag ja-flag--bad">never asked</span></td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
      <p class="ja-caveat">Fixed on the <a href="/admin/rubric">rubric</a>: retire a
        criterion this award does not use, or put it on the ballot. Retiring shrinks the
        required set going forward and does not make old scorecards incomplete
        retrospectively.</p>
    </div>
  {% endif %}

  {# ── THE ONE THING THAT IS NOT A SIGNAL ──────────────────────────────────
     A declaration in gates_judge_coi, and marks recorded afterwards. Two records
     of two events. It was collected and stored and never compared. #}
  {% if audit.conflicts %}
    <div class="ja-card">
      <h3>Declared a conflict on this programme, and scored in it</h3>
      <p>Not an inference. Each of these is a conflict-of-interest declaration held against
        this programme, and marks by the same judge on nominees inside it.</p>
      {% for c in audit.conflicts %}
        <div class="ja-fact">
          <b>{{ c.judge }}</b> &mdash; {{ c.scores }} mark{{ c.scores == 1 ? '' : 's' }}
          {% if c.declared_first %}
            recorded <b>after</b> declaring the conflict on {{ c.declared_at|slice(0, 10) }}.
          {% else %}
            recorded <b>before</b> declaring the conflict on {{ c.declared_at|slice(0, 10) }},
            which reads as a judge recusing themselves partway through.
          {% endif %}
          {% if c.reason %}<p>Reason given: {{ c.reason }}</p>{% endif %}
        </div>
      {% endfor %}
    </div>
  {% endif %}

  {# ── THE PROCESS, PER CYCLE ─────────────────────────────────────────────── #}
  <div class="ja-card">
    <h3>Coverage, cycle by cycle</h3>
    <p>The smallest panel any single nominee faced, not the average one. An average of four
      can contain a nominee seen by one judge, and that nominee is the question.</p>
    <table class="ja-t">
      <thead>
        <tr>
          <th>Cycle</th><th>Status</th><th>Nominees</th><th>Never scored</th>
          <th>One judge only</th><th>Smallest panel</th><th>No dossier</th>
        </tr>
      </thead>
      <tbody>
        {% for c in audit.cycles %}
          <tr>
            <td class="ja-name">{{ c.edition_label|default(c.year) }}</td>
            <td>{{ c.status }}</td>
            <td class="ja-num">{{ c.nominees }}</td>
            <td class="ja-num">
              {% if c.unjudged > 0 %}<span class="ja-flag ja-flag--bad">{{ c.unjudged }}</span>
              {% else %}0{% endif %}
            </td>
            <td class="ja-num">
              {% if c.thin > 0 %}<span class="ja-flag ja-flag--warn">{{ c.thin }}</span>
              {% else %}0{% endif %}
            </td>
            <td class="ja-num">{{ c.min_panel }}</td>
            {# A nominee whose orientation dossier failed was judged without the briefing
               every other nominee's judges had. Written since day one, shown here first. #}
            <td class="ja-num">
              {% if c.no_dossier > 0 %}<span class="ja-flag ja-flag--warn">{{ c.no_dossier }}</span>
              {% else %}0{% endif %}
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  {# ── THE JUDGES ─────────────────────────────────────────────────────────── #}
  <div class="ja-card">
    <h3>The panel</h3>
    <p>What each judge did, ordered by how much of the field they saw. The lean is measured
      against the rest of the panel on the same nominee and criterion &mdash; never against
      a mean that includes the judge&rsquo;s own mark, which would flatten it.</p>
    <table class="ja-t">
      <thead>
        <tr><th>Judge</th><th>Marks</th><th>Nominees</th><th>Mean given</th>
            <th>Lean vs panel</th><th>Typical gap</th><th>Scored between</th></tr>
      </thead>
      <tbody>
        {% for j in audit.judges %}
          <tr>
            <td class="ja-name">{{ j.judge }}</td>
            <td class="ja-num">{{ j.scores }}</td>
            <td class="ja-num">{{ j.nominees }}</td>
            <td class="ja-num">{{ j.mean }}</td>
            <td class="ja-num">
              {% if j.lean is null %}
                &mdash;
                <span class="ja-den">nobody else scored the same work</span>
              {% else %}
                {{ j.lean > 0 ? '+' : '' }}{{ j.lean }}
                <span class="ja-den">over {{ j.compared }} comparison{{ j.compared == 1 ? '' : 's' }}</span>
              {% endif %}
            </td>
            {# THE MEDIAN gap between one SCORECARD and the next, not the mean: judges
               score in sittings across days, and a single overnight gap swamps two hundred
               real ones. Four seconds a nominee across a hundred of them is not reading.

               One unit per magnitude, and the boundaries are where the unit changes rather
               than where the flag does. This mixed them — anything under an hour printed
               as seconds and anything over it as minutes — so a column meant to be scanned
               put "1260s" directly above "750m" and asked the reader to convert. #}
            <td class="ja-num">
              {% if j.median_gap is null %}
                &mdash;<span class="ja-den">one scorecard only</span>
              {% elseif j.median_gap < 10 %}
                <span class="ja-flag ja-flag--warn">{{ j.median_gap }}s</span>
              {% elseif j.median_gap < 60 %}{{ j.median_gap }}s
              {% elseif j.median_gap < 3600 %}{{ (j.median_gap / 60)|round }}m
              {% else %}{{ (j.median_gap / 3600)|round(1) }}h{% endif %}
            </td>
            <td>{{ j.first_at|slice(0, 10) }} &ndash; {{ j.last_at|slice(0, 10) }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
    <p class="ja-caveat">A lean is arithmetic over whatever number is in the column beside
      it. Across a panel of twenty, some leans look striking by chance; a figure computed
      over six comparisons is not the same claim as one computed over sixty. This is a
      place to ask a question, never a finding on its own.</p>
  </div>

  {# ── DID THE RUBRIC DECIDE ANYTHING? ─────────────────────────────────────
     Weights say what the award CLAIMS to value. This says what separated the field. A
     criterion every judge marked the same decided nothing, and because it keeps its
     weight, the share of the mark it was given went nowhere — so a five-criterion rubric
     with one inert criterion was really decided by four, invisibly. #}
  {% if audit.criteria %}
  <div class="ja-card">
    <h3>What each criterion actually did</h3>
    <p>Weights say what this award claims to value. This is what separated the field. A
      criterion every judge marked the same has decided nothing &mdash; and it still
      carries its share of the mark.</p>
    <table class="ja-t">
      <thead>
        <tr><th>Criterion</th><th>Worth</th><th>Marks</th><th>Mean</th>
            <th>Range used</th><th>Different values</th></tr>
      </thead>
      <tbody>
        {% for c in audit.criteria %}
          <tr>
            <td class="ja-name">{{ c.label }}
              {% if c.unmarked %}<span class="ja-flag ja-flag--bad">never asked</span>
              {% elseif c.inert %}<span class="ja-flag ja-flag--bad">decided nothing</span>{% endif %}</td>
            <td class="ja-num">{% if c.share is not null %}{{ c.share }}%{% else %}&mdash;{% endif %}</td>
            {# A criterion nobody has marked is listed rather than omitted, and the columns
               that need a mark to exist say so. Omitting the row is how the "worth" column
               came to add up to 57% with nothing on the page to explain the other 43%. #}
            {% if c.unmarked %}
              <td class="ja-num" colspan="4">
                <span class="ja-den">no judge has ever been asked this &mdash; its share is
                  reweighted onto the rest of the rubric on every nominee</span>
              </td>
            {% else %}
              <td class="ja-num">{{ c.marks }}
                <span class="ja-den">over {{ c.nominees }} nominee{{ c.nominees == 1 ? '' : 's' }}</span></td>
              <td class="ja-num">{{ c.mean }}</td>
              <td class="ja-num">{{ c.low }} &ndash; {{ c.high }}</td>
              <td class="ja-num">
                {% if c.distinct <= 2 %}<span class="ja-flag ja-flag--warn">{{ c.distinct }}</span>
                {% else %}{{ c.distinct }}{% endif %}
              </td>
            {% endif %}
          </tr>
        {% endfor %}
      </tbody>
    </table>
    <p class="ja-caveat">A narrow range is not automatically wrong &mdash; a strong shortlist
      genuinely scores alike. It is worth asking of a criterion that carries a quarter of the
      mark and uses two of its ten points.</p>
  </div>
  {% endif %}

  {# ── SCORECARDS LEFT PART-MARKED ─────────────────────────────────────────
     Different from "never scored" above, and worse in a quieter way: a partial scorecard
     is NOT discarded. The weighted average divides by the weight actually marked, so it
     is silently reweighted onto whichever criteria the judge happened to finish. #}
  {% if audit.incomplete.pairs > 0 %}
  <div class="ja-card">
    <h3>Scorecards left part-marked</h3>
    <p><b>{{ audit.incomplete.pairs }}</b> scorecard{{ audit.incomplete.pairs == 1 ? '' : 's' }}
      cover fewer than the {{ audit.incomplete.in_play }}
      criteri{{ audit.incomplete.in_play == 1 ? 'on' : 'a' }} this panel was actually asked.
      These were not discarded: the weighted average divides by the weight actually marked,
      so each one was reweighted onto whichever criteria that judge finished.</p>
    {# Measured against what was IN PLAY, not against the whole rubric. Against the rubric,
       a judge who answered every question on the ballot appeared here beside one who
       abandoned a scorecard halfway — which is a rubric fault wearing somebody's name.
       That fault is now stated once, above, and this card is about judges again. #}
    <table class="ja-t">
      <thead><tr><th>Judge</th><th>Nominee</th><th>Marked</th><th>Of the rubric</th></tr></thead>
      <tbody>
        {% for r in audit.incomplete.rows %}
          <tr>
            <td class="ja-name">{{ r.judge }}</td>
            <td>{{ r.nominee }}</td>
            <td class="ja-num">{{ r.marked }} of {{ r.required }}</td>
            <td class="ja-num">
              {% if r.covered < 60 %}<span class="ja-flag ja-flag--bad">{{ r.covered }}%</span>
              {% else %}<span class="ja-flag ja-flag--warn">{{ r.covered }}%</span>{% endif %}
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
    {% if audit.incomplete.pairs > audit.incomplete.rows|length %}
      <p class="ja-caveat">Showing the {{ audit.incomplete.rows|length }} least complete of
        {{ audit.incomplete.pairs }}.</p>
    {% endif %}
  </div>
  {% endif %}

  {# ── WHERE THE PANEL DISAGREED ───────────────────────────────────────────
     Not the lowest scores and not the closest results — the widest disagreement. A
     nominee two judges rated 8.4 and 4.1 carries a mark neither judge held, and that is
     the row somebody appeals. #}
  {% if audit.disagreement %}
  <div class="ja-card">
    <h3>Where the panel disagreed most</h3>
    <p>Each judge&rsquo;s own weighted average for the same nominee, furthest apart first. A
      nominee rated 8.4 by one judge and 4.1 by another carries a mark neither of them
      held. Rows marked <span class="ja-flag ja-flag--bad">crowned</span> or
      <span class="ja-flag ja-flag--warn">runner-up</span> are the ones where the
      disagreement landed on a published result &mdash; the same spread on a nominee who
      finished ninth is a note about the rubric, and on the winner it is the challenge.</p>
    <table class="ja-t">
      <thead><tr><th>Nominee</th><th>Judges</th><th>Lowest</th><th>Highest</th>
                 <th>Apart by</th><th>Who said what</th></tr></thead>
      <tbody>
        {% for d in audit.disagreement %}
          <tr>
            {# Straight to the marks. This card says two judges were 4.4 apart and names
               neither number, which is the point at which a reader has to go and look —
               and until this link there was nowhere to look. #}
            <td class="ja-name"><a href="/admin/scorecard/{{ d.nominee_id }}">{{ d.nominee }}</a>
              {%- if d.crowned == 'winner' %}
                <span class="ja-flag ja-flag--bad">crowned</span>
              {%- elseif d.crowned == 'runner_up' %}
                <span class="ja-flag ja-flag--warn">runner-up</span>
              {%- endif %}</td>
            <td class="ja-num">{{ d.judges }}</td>
            <td class="ja-num">{{ d.low }}</td>
            <td class="ja-num">{{ d.high }}</td>
            <td class="ja-num">
              {% if d.spread >= 3 %}<span class="ja-flag ja-flag--bad">{{ d.spread }}</span>
              {% elseif d.spread >= 1.5 %}<span class="ja-flag ja-flag--warn">{{ d.spread }}</span>
              {% else %}{{ d.spread }}{% endif %}
            </td>
            <td>
              {% for name, avg in d.marks %}<span class="ja-den">{{ name }} {{ avg }}</span>{% endfor %}
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
    <p class="ja-caveat">Disagreement is not misconduct. Two readers of the same work
      differing is what a panel is for &mdash; this says where it happened, so that a
      challenge to one nominee can be answered with the marks rather than with an average.</p>
  </div>
  {% endif %}

  {# ── THE TRAIL ──────────────────────────────────────────────────────────── #}
  <div class="ja-card">
    <h3>Marks that were changed</h3>
    <p>Every mark that was set and then set again. A first mark is not listed &mdash; that
      is the judging. A second is the audit.

      {% if audit.changes.total > audit.changes.rows|length %}
        {# Said out loud. A truncated list presented as the whole record is how an audit
           reassures somebody with a number that is not the number. #}
        Showing the most recent {{ audit.changes.rows|length }} of
        <strong>{{ audit.changes.total }}</strong>.
      {% endif %}</p>
    {% if audit.changes.rows %}
      <table class="ja-t">
        <thead>
          <tr><th>When</th><th>Judge</th><th>Nominee</th><th>Criterion</th>
              <th>Change</th><th></th></tr>
        </thead>
        <tbody>
          {% for c in audit.changes.rows %}
            <tr>
              <td class="ja-num">{{ c.changed_at|slice(0, 16) }}</td>
              <td class="ja-name">{{ c.judge }}</td>
              <td>{{ c.nominee }}</td>
              <td>{{ c.criterion|default('—') }}</td>
              <td class="ja-num">{{ c.old }} &rarr; {{ c.new }}</td>
              {# The flag read "After results" and the page never said when the results
                 were, so the one row here that is a plain FACT rather than arithmetic was
                 the one thing on the page a reader could not check. The date is the
                 claim. #}
              <td>
                {% if c.after_results %}
                  <span class="ja-flag ja-flag--bad">After results</span>
                  {% if c.results_at %}
                    <span class="ja-den">published {{ c.results_at|date('j M Y') }}</span>
                  {% endif %}
                {% endif %}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    {% else %}
      <p class="ja-empty">No mark in this programme has ever been changed after it was
        first set.</p>
    {% endif %}
  </div>

{% endif %}

{% endblock %}
