{% extends 'admin/layout.twig' %}

{#
  Every integrity signal on one page, with its caveats attached rather than implied.

  These were four screens: vote fraud on vote delivery, collusion behind the dashboard,
  judge anomalies inside the judges list, and an AI brief summarising things you could not
  then go and look at. The question they answer is asked at one specific moment — a result
  has been challenged, or is about to be published — and at that moment four screens is the
  same as none.
#}

{% block head_styles %}
<style nonce="{{ csp_nonce }}">
  .in-lede{ background:#fff; border:1px solid rgba(16,41,44,.1); border-radius:14px;
    padding:18px 20px; margin-bottom:16px }
  .in-lede h2{ margin:0 0 6px; font-size:14.5px; color:#10292C }
  .in-lede p{ margin:8px 0 0; font-size:12.5px; line-height:1.7; color:#5a6d6f; max-width:76ch }
  .in-brief{ border-left:3px solid #237b22; background:#f6faf6; border-radius:0 10px 10px 0;
    padding:13px 16px; margin-top:12px; font-size:13.5px; line-height:1.7; color:#3d5254 }
  .in-brief small{ display:block; margin-top:7px; font-size:11.5px; color:#5a6d6f }
  .in-caveat{ margin:12px 0 0; padding:12px 15px; border-left:3px solid #d49a0e;
    background:#fffaf0; border-radius:0 8px 8px 0; font-size:12.5px; line-height:1.65;
    color:#7a5605 }
  .in-find{ border-top:1px solid rgba(16,41,44,.08); padding:14px 0 }
  .in-find:first-of-type{ border-top:none }
  .in-eff{ font-family:var(--ag-font-mono,monospace); font-weight:700; font-size:13px }
  .in-eff--up{ color:#8a2b18 }
  .in-eff--dn{ color:#1c5f1b }
  .in-mut{ font-size:12px; color:#5a6d6f; line-height:1.6 }
  .in-row{ display:flex; gap:10px; flex-wrap:wrap; align-items:flex-end; margin-bottom:14px }
  .in-tag{ font-size:10.5px; font-weight:700; letter-spacing:.05em; text-transform:uppercase;
    padding:3px 8px; border-radius:999px; background:rgba(16,41,44,.07); color:#3d4b4d }

  /* Four numbers, read at a glance before anything below them is read at all. */
  .in-stats{ display:grid; grid-template-columns:repeat(auto-fit,minmax(140px,1fr)); gap:1px;
    background:rgba(16,41,44,.1); border:1px solid rgba(16,41,44,.1); border-radius:10px;
    overflow:hidden; margin-bottom:14px }
  .in-stat{ background:#fff; padding:12px 14px }
  .in-stat__k{ font-family:var(--ag-font-mono,monospace); font-size:10px; font-weight:700;
    letter-spacing:.09em; text-transform:uppercase; color:#5a6d6f; margin:0 }
  .in-stat__v{ font-family:var(--ag-font-mono,monospace); font-size:20px; font-weight:700;
    color:#10292C; margin:4px 0 0; line-height:1 }
  .in-stat--open .in-stat__v{ color:#8a2b18 }
  /* The one action on this page. Emerald is reserved for it. */
  .in-act{ display:inline-flex; align-items:center; gap:7px; margin-top:12px; cursor:pointer;
    border:none; border-radius:999px; padding:9px 18px; background:#237b22; color:#fff;
    font-family:inherit; font-size:12.5px; font-weight:700 }
  .in-act:disabled{ background:#9db39c; cursor:not-allowed }
  .in-act:focus-visible{ outline:3px solid #f3b416; outline-offset:2px }
  .in-check{ width:17px; height:17px; accent-color:#237b22 }
</style>
{% endblock %}

{% block topbar_title %}Integrity{% endblock %}

{% block content %}

<div class="in-lede">
  <h2>What the platform can and cannot tell you</h2>
  <p>Everything below is a <strong>question to ask a person</strong>. Nothing here has
     changed a score, removed a vote or dropped a judge, and nothing here can — these are
     measurements, and every one of them has a way of being wrong that is worth knowing
     before you act on it.</p>
  <p>The detection is arithmetic, not AI: a mean and a subtraction you could reproduce by
     hand from the same tables. A model is only used to write the summary immediately below,
     from the same numbers shown further down — so if the summary and the tables ever
     disagree, the tables are right.</p>

  {% if brief.text %}
    <div class="in-brief">
      {{ brief.text }}
      <small>{{ brief.ai ? 'Written by a model from the counts below. Advisory — it decides nothing.'
                         : 'Written from the counts below by a fixed template; no model was available.' }}</small>
    </div>
  {% endif %}
</div>

{# ── JUDGE BIAS ────────────────────────────────────────────────────────────
   The new one, and the one most easily misread, so it leads with its method
   rather than with its findings. #}
<div class="ad-card" id="bias" style="margin-bottom:16px">
  <div class="ad-card__head"><div class="ad-card__title">Does a judge score differently by group?
    <small>a pattern across many scores — not a disagreement about one nominee</small></div></div>

  <div class="ad-card__body">
    <p style="margin:0;font-size:12.5px;line-height:1.7;color:#5a6d6f;max-width:76ch">
      For every nominee and criterion a judge scored, we take their score minus the average
      of the <em>other</em> judges on that same nominee and criterion. That removes the
      nominee's actual quality from the measurement — otherwise this would only discover
      which judges were given the stronger entries.
      Those deviations are then grouped by an attribute of the nominee, and compared against
      <strong>that judge's own overall deviation</strong>. A judge who marks everybody down
      is strict; a judge who marks one group down and nobody else is the finding.
    </p>

    <form method="get" action="/admin/integrity" class="in-row" style="margin-top:16px">
      <div>
        <label for="inCycle" style="display:block;font-size:12px;font-weight:600;color:#10292C">Cycle</label>
        <select id="inCycle" name="cycle" data-ag-do="submit-form" style="margin-top:5px">
          {% for c in cycles %}
            <option value="{{ c.id }}"{% if c.id == cycle_id %} selected{% endif %}>
              {{ c.label }} — {{ c.status }}</option>
          {% endfor %}
        </select>
      </div>
      {# A visible button as well as the change handler: the admin CSP has no
         'unsafe-inline', so if the delegated listener ever fails to load the select must
         still be operable. #}
      <button class="ad-btn ad-btn--sm" type="submit">Show</button>
    </form>

    {# THE DENOMINATOR, ABOVE THE FINDINGS AND NOT BELOW THEM.
       "Three judges show a lean" is alarming. "Three out of two hundred and forty
       comparisons" is normal, and it is the same fact. Whichever one is read first is
       the one that sticks. #}
    <div class="in-caveat">{{ bias.note }}</div>

    {% if bias.findings|length %}
      <div style="margin-top:16px">
        {% for f in bias.findings %}
          <div class="in-find">
            <div style="display:flex;gap:10px;align-items:baseline;flex-wrap:wrap">
              <strong style="font-size:13.5px;color:#10292C">{{ f.judge }}</strong>
              <span class="in-tag">{{ f.axis_label }}</span>
              <span class="in-tag">{{ f.group }}</span>
              {# Sign, word AND colour — never colour alone. #}
              <span class="in-eff {{ f.relative > 0 ? 'in-eff--up' : 'in-eff--dn' }}">
                {{ f.relative > 0 ? '+' : '' }}{{ f.relative }} pts {{ f.direction }}</span>
              <span class="in-mut">{{ f.scores }} scores</span>
            </div>
            <div class="in-mut" style="margin-top:6px;max-width:74ch">{{ f.sentence }}</div>
          </div>
        {% endfor %}
      </div>
    {% else %}
      <p class="in-mut" style="margin-top:14px">
        No group sat more than {{ min_effect }} of a point from the judge's own baseline.
        {% if bias.scores %}{{ bias.scores }} scores across {{ bias.judges }} judge(s) were checked.{% endif %}
      </p>
    {% endif %}

    {% if bias.thin|length %}
      {# Named rather than dropped. If the thin groups are invisible, the absence of a
         finding reads as a clean bill of health for groups nobody could actually test. #}
      <div style="margin-top:18px;padding-top:14px;border-top:1px solid rgba(16,41,44,.08)">
        <p style="margin:0;font-size:12.5px;font-weight:600;color:#10292C">
          Asked, and could not be answered</p>
        <p class="in-mut" style="margin-top:5px;max-width:74ch">
          These groups had fewer than {{ min_obs }} scores, which is too few for an average to
          mean anything. They are listed so a quiet result is not mistaken for a clean one.</p>
        <p class="in-mut" style="margin-top:8px">
          {% for t in bias.thin|slice(0, 40) %}
            {{ t.judge }} · {{ t.group }} ({{ t.scores }}){% if not loop.last %} — {% endif %}
          {% endfor %}
          {% if bias.thin|length > 40 %} … and {{ bias.thin|length - 40 }} more{% endif %}
        </p>
      </div>
    {% endif %}
  </div>
</div>

{# ── JUDGE ANOMALIES ──────────────────────────────────────────────────────── #}
<div class="ad-card" id="anomalies" style="margin-bottom:16px">
  <div class="ad-card__head"><div class="ad-card__title">Judges out of step on a single nominee
    <small>disagreement, which is what a panel is for — read it as a prompt, not a problem</small></div></div>
  <div class="ad-card__body">
    {% if anomalies.flags|length %}
      <p class="in-mut" style="max-width:74ch">
        {{ anomalies.flags|length }} flag(s) across {{ anomalies.judges|length }} judge(s). A
        single outlying score is frequently the judge who actually read the evidence; what is
        worth investigating is the same judge appearing repeatedly.
      </p>
      <div style="margin-top:12px">
        {% for j in anomalies.judges|slice(0, 10) %}
          <div class="in-find">
            <strong style="font-size:13px;color:#10292C">{{ j.name|default('Judge #' ~ j.judge_id) }}</strong>
            <span class="in-mut"> · {{ j.flags|default(0) }} flag(s)</span>
          </div>
        {% endfor %}
      </div>
    {% else %}
      <p class="in-mut">No judge is currently out of step with their panel on any nominee.</p>
    {% endif %}
  </div>
</div>

{# ── VOTE FRAUD ────────────────────────────────────────────────────────────────
   The per-vote signal, and the one that had no screen at all: every vote has been
   scored and stamped since fraud detection shipped, and FraudService::summary() —
   written for this panel — was called from nowhere.

   The checkboxes are the point as much as the table. `reviewed` was read by the
   summary and written by nothing, so "12 unreviewed" could only ever become 13. #}
<div class="ad-card" id="fraud">
  <div class="ad-card__head"><div class="ad-card__title">Votes that scored as suspicious
    <small>one voter, one attempt — scored as it was cast</small></div></div>
  <div class="ad-card__body">
    {% if fraud is not empty %}
      <div class="in-stats">
        <div class="in-stat"><p class="in-stat__k">Flagged today</p><p class="in-stat__v">{{ fraud.flagged_today|default(0) }}</p></div>
        <div class="in-stat"><p class="in-stat__k">Blocked today</p><p class="in-stat__v">{{ fraud.blocked_today|default(0) }}</p></div>
        <div class="in-stat{{ fraud.unreviewed|default(0) > 0 ? ' in-stat--open' : '' }}">
          <p class="in-stat__k">Not yet read</p><p class="in-stat__v">{{ fraud.unreviewed|default(0) }}</p></div>
        <div class="in-stat"><p class="in-stat__k">Avg risk, 24h</p><p class="in-stat__v">{{ fraud.avg_score_24h|default(0) }}</p></div>
      </div>

      {% if fraud.recent_flags|default([])|length %}
        <form method="post" action="/admin/integrity/fraud-reviewed">
          <input type="hidden" name="_token" value="{{ csrf_token }}">
          <div class="ad-table-wrap">
            <table class="ad-table">
              <caption class="sr-only">Recent flagged and blocked vote attempts</caption>
              <thead><tr>
                <th scope="col"><span class="sr-only">Mark reviewed</span></th>
                <th scope="col">Decision</th><th scope="col">Risk</th>
                <th scope="col">Nominee</th><th scope="col">When</th><th scope="col">Read</th>
              </tr></thead>
              <tbody>
              {% for f in fraud.recent_flags %}
                <tr>
                  <td>
                    {% if may_review and not f.reviewed %}
                      <input class="in-check" type="checkbox" name="ids[]" value="{{ f.id }}"
                             aria-label="Mark attempt {{ f.id }} as reviewed">
                    {% endif %}
                  </td>
                  <td><span class="ad-chip ad-chip--{{ f.decision == 'block' ? 'red' : 'gold' }}">{{ f.decision }}</span></td>
                  <td style="font-family:var(--ag-font-mono,monospace)">{{ f.risk_score|default(0) }}/100</td>
                  {# A BLOCKED attempt never became a vote, so it has no nominee to name.
                     Said rather than left blank, because an empty cell in a fraud table
                     reads as missing data. #}
                  <td>{{ f.nominee_name|default('') ?: '— not cast —' }}</td>
                  <td class="in-mut">{{ f.created_at|default('—') }}</td>
                  <td>{% if f.reviewed %}<span class="in-tag">read</span>{% endif %}</td>
                </tr>
              {% endfor %}
              </tbody>
            </table>
          </div>
          {% if may_review %}
            <button class="in-act" type="submit">Mark selected as reviewed</button>
          {% endif %}
        </form>
      {% else %}
        <p class="in-mut">Nothing has been flagged or blocked.</p>
      {% endif %}

      <p class="in-caveat">
        A score is a guess made in the half-second before a vote lands, from one device,
        one address and how fast the last few arrived. Sharing a phone, a school network or
        an office connection all look exactly like this. Marking one read records that
        somebody looked — it does not remove the vote, and nothing here has.
      </p>
    {% else %}
      <p class="in-mut">Vote scoring is not recording anything yet.</p>
    {% endif %}
  </div>
</div>

{# ── VOTER COLLUSION ──────────────────────────────────────────────────────── #}
<div class="ad-card" id="collusion">
  <div class="ad-card__head"><div class="ad-card__title">Voting rings and bursts
    <small>shared devices, shared addresses, and votes arriving faster than people do</small></div></div>
  <div class="ad-card__body">
    {% if collusion.open|length %}
      <div class="ad-table-wrap" style="margin-top:6px">
        <table class="ad-table">
          <caption class="sr-only">Open collusion findings</caption>
          <thead><tr>
            <th scope="col">Kind</th><th scope="col">Risk</th><th scope="col">Detail</th>
          </tr></thead>
          <tbody>
          {% for f in collusion.open %}
            <tr>
              <td>{{ f.kind|default('—') }}</td>
              <td style="font-family:var(--ag-font-mono,monospace)">{{ f.risk_score|default(0) }}/100</td>
              <td class="in-mut">{{ f.detail|default(f.summary)|default('—') }}</td>
            </tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
      <p class="in-caveat">
        A shared address is often a household, an office or a school computer room, and a
        burst is often a class being shown how to vote. These are patterns worth a look,
        not proof of anything.
      </p>
    {% else %}
      <p class="in-mut">No open findings.</p>
    {% endif %}
  </div>
</div>
{% endblock %}
