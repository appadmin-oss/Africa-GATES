{% extends "admin/layout.twig" %}

{# The vetting record. Everything a reviewer needs to decide, on one page, with every
   decision written down against the admin who took it. #}

{% block content %}
<div class="ad-topbar">
  <div class="ad-h1"><small>Partner organisation</small>{{ org.name }}</div>
  <div class="ad-actions">
    <a class="ad-btn ad-btn--sm" href="/admin/partner-orgs">← All partners</a>
    {% if live %}<a class="ad-btn ad-btn--sm" href="/donate/{{ org.slug }}" target="_blank" rel="noopener">View appeal</a>{% endif %}
  </div>
</div>

{% set chip = {'approved':'green','pending':'gold','draft':'grey','suspended':'red','rejected':'red'}[org.status]|default('grey') %}

<div class="ad-card" style="margin-bottom:16px"><div class="ad-card__body"
     style="display:flex;gap:22px;flex-wrap:wrap;align-items:center">
  <div>
    <div style="font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--ad-text-soft)">Status</div>
    <span class="ad-chip ad-chip--{{ chip }}" style="margin-top:5px">{{ org.status|capitalize }}</span>
  </div>
  <div>
    <div style="font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--ad-text-soft)">Collecting</div>
    <div style="margin-top:5px;font-weight:600">{{ live ? 'Yes' : 'No' }}</div>
  </div>
  <div>
    <div style="font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--ad-text-soft)">Received</div>
    <div style="margin-top:5px;font-family:'Space Mono',monospace;font-weight:700">₦{{ totals.gross|number_format }}</div>
  </div>
  <div>
    <div style="font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--ad-text-soft)">Our share</div>
    <div style="margin-top:5px;font-family:'Space Mono',monospace;font-weight:700">₦{{ totals.platform_fee|number_format }}</div>
  </div>
  <div>
    <div style="font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--ad-text-soft)">Theirs</div>
    <div style="margin-top:5px;font-family:'Space Mono',monospace;font-weight:700">₦{{ totals.net|number_format }}</div>
  </div>
</div></div>

{% if org.status == 'suspended' and org.suspended_reason %}
  <div class="ad-card" style="margin-bottom:16px;border-left:4px solid var(--ad-danger)">
    <div class="ad-card__body"><strong>Suspended.</strong> {{ org.suspended_reason }}</div>
  </div>
{% endif %}

{# ── 1 · THE SETTLEMENT ACCOUNT ─────────────────────────────────────────────
   The one thing on this page that IS verified automatically: Paystack is asked who owns
   the account number before a subaccount is created, and the answer sits here beside the
   registered name for a human to judge. #}
<div class="ad-card" style="margin-bottom:16px">
  <div class="ad-card__head"><div class="ad-card__title">Settlement account
    <small>where this partner's share lands — never held by us</small></div></div>
  <div class="ad-card__body">

  {% if org.subaccount_code %}
    <table class="ad-table" style="max-width:640px">
      <caption class="sr-only">Settlement account details</caption>
      <tbody>
        <tr><th scope="row" style="width:210px">Account</th>
            <td>{{ org.account_last4 ? '••••' ~ org.account_last4 : '—' }} · bank {{ org.settlement_bank }}</td></tr>
        <tr><th scope="row">Bank says the name is</th>
            <td><strong>{{ org.account_name_resolved|default('—') }}</strong></td></tr>
        <tr><th scope="row">Registered as</th>
            <td>{{ org.legal_name|default(org.name) }}</td></tr>
        <tr><th scope="row">Name match</th>
            <td>
              {% if name_match is null %}<span style="color:var(--ad-text-soft)">Not compared</span>
              {% elseif name_match >= 0.86 %}
                <span class="ad-chip ad-chip--green">Strong ({{ (name_match * 100)|round }}%)</span>
              {% else %}
                <span class="ad-chip ad-chip--red">Weak ({{ (name_match * 100)|round }}%)</span>
                <div style="margin-top:6px;font-size:12.5px;line-height:1.6;color:var(--ad-text-soft)">
                  The bank's name for this account does not closely match the registered name.
                  That can be a legitimate trading name — or somebody collecting donations into
                  a personal account. Confirm before approving.
                </div>
              {% endif %}
            </td></tr>
        <tr><th scope="row">Platform share</th>
            <td>{{ org.platform_fee_bps > 0 ? (org.platform_fee_bps / 100)|number_format(2) ~ '%' : 'Nothing — 100% goes to them' }}</td></tr>
        <tr><th scope="row">Settlement schedule</th><td>{{ org.settlement_schedule }}</td></tr>
        <tr><th scope="row">Payout recipient</th>
            <td>{% if org.payout_recipient_code %}On file
                {% else %}<span style="color:#b91c1c">Missing — transfers cannot be built.
                Re-attach the account to create one.</span>{% endif %}</td></tr>
      </tbody>
    </table>
  {% elseif may_decide %}
    <p style="font-size:13.5px;line-height:1.7;color:var(--ad-text-soft);margin:0 0 12px">
      The account number is sent to Paystack once and <strong>never stored here</strong>. We keep
      the subaccount code, the bank, the last four digits and the name the bank resolved.
    </p>
    <form method="post" action="/admin/partner-orgs/{{ org.id }}/account">
      <input type="hidden" name="_token" value="{{ csrf_token }}">
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:14px">
        <div>
          <label for="poBank">Bank</label>
          <select id="poBank" name="bank_code" required>
            <option value="">Choose…</option>
            {% for b in banks %}<option value="{{ b.code }}">{{ b.name }}</option>{% endfor %}
          </select>
          {% if banks is empty %}
            <small style="color:#b91c1c">Paystack is unreachable, so the bank list is empty.</small>
          {% endif %}
        </div>
        <div>
          <label for="poAcct">Account number</label>
          <input id="poAcct" name="account_number" type="text" inputmode="numeric" maxlength="20" required>
        </div>
        <div>
          <label for="poFee">Platform share (%)</label>
          <input id="poFee" name="fee_percent" type="number" min="0" max="100" step="0.01" value="0">
          <small style="color:var(--ad-text-mute)">0 keeps the “100% goes to the cause” promise</small>
        </div>
        <div>
          <label for="poSched">Settlement schedule</label>
          <select id="poSched" name="settlement_schedule">
            <option value="auto">Auto (T+1 to their bank)</option>
            <option value="weekly">Weekly</option>
            <option value="monthly">Monthly</option>
            <option value="manual">Manual (only on request)</option>
          </select>
        </div>
      </div>
      <div style="margin-top:14px">
        <button class="ad-btn ad-btn--primary" type="submit">Resolve and attach</button>
      </div>
    </form>
  {% else %}
    <p style="color:var(--ad-text-soft);margin:0">No settlement account attached.</p>
  {% endif %}
  </div>
</div>

{# ── 2 · REGISTRY CHECKS ────────────────────────────────────────────────────
   Honest about what is automated. There is no free public API for the CAC register — the
   Commission runs a search page for humans — so unless a verifier is configured, the only
   truthful states are "a named admin checked this" and "nobody has". #}
<div class="ad-card" style="margin-bottom:16px">
  <div class="ad-card__head"><div class="ad-card__title">Registry checks
    <small>CAC and SCUML — both legal requirements, not paperwork</small></div></div>
  <div class="ad-card__body">

    {% if not verifier_on %}
      <p style="font-size:13px;line-height:1.7;color:var(--ad-text-soft);margin:0 0 14px">
        No registry verifier is configured, so these numbers are <strong>stored, not verified</strong>.
        The CAC public search is a page for people — open it, check the number, then record
        what you found. Set <code>CAC_VERIFY_URL</code> and <code>CAC_VERIFY_KEY</code> to
        enable an automated lookup.
      </p>
    {% endif %}

    <table class="ad-table" style="max-width:760px">
      <caption class="sr-only">Registration numbers and their check state</caption>
      <thead><tr><th scope="col">Register</th><th scope="col">Number</th><th scope="col">State</th><th scope="col">Record</th></tr></thead>
      <tbody>
        <tr>
          <th scope="row">CAC</th>
          <td>
            {{ org.cac_number|default('—') }}
            {% if org.cac_number and not cac_format.ok %}
              <div style="font-size:12px;color:#b91c1c;margin-top:4px">{{ cac_format.message }}</div>
            {% elseif cac_format.ok and not cac_format.nonprofit %}
              <div style="font-size:12px;color:#84610b;margin-top:4px">{{ cac_format.message }}</div>
            {% endif %}
            {% if org.cac_registered_name %}
              <div style="font-size:12px;color:var(--ad-text-soft);margin-top:4px">
                Register says: <strong>{{ org.cac_registered_name }}</strong></div>
            {% endif %}
          </td>
          <td>
            {% set cs = org.cac_check|default('unchecked') %}
            <span class="ad-chip ad-chip--{{ cs == 'verified' or cs == 'confirmed' ? 'green' : (cs == 'rejected' ? 'red' : 'grey') }}">
              {{ check_states[cs]|default(cs) }}</span>
          </td>
          <td>
            {% if may_decide %}
              <a class="ad-btn ad-btn--xs" href="{{ cac_search }}" target="_blank" rel="noopener">Open CAC search</a>
              <form method="post" action="/admin/partner-orgs/{{ org.id }}/check" style="display:inline">
                <input type="hidden" name="_token" value="{{ csrf_token }}">
                <input type="hidden" name="which" value="cac">
                <button class="ad-btn ad-btn--xs" name="verdict" value="confirmed" type="submit">I checked it</button>
                <button class="ad-btn ad-btn--xs ad-btn--danger" name="verdict" value="rejected" type="submit">Not found</button>
                {% if verifier_on %}
                  <button class="ad-btn ad-btn--xs ad-btn--primary" name="verdict" value="api" type="submit">Verify via API</button>
                {% endif %}
              </form>
            {% endif %}
          </td>
        </tr>
        <tr>
          <th scope="row">SCUML</th>
          <td>{{ org.scuml_number|default('—') }}
            <div style="font-size:12px;color:var(--ad-text-soft);margin-top:4px">
              No public lookup exists. Check the certificate itself.</div>
          </td>
          <td>
            {% set ss = org.scuml_check|default('unchecked') %}
            <span class="ad-chip ad-chip--{{ ss == 'verified' or ss == 'confirmed' ? 'green' : (ss == 'rejected' ? 'red' : 'grey') }}">
              {{ check_states[ss]|default(ss) }}</span>
          </td>
          <td>
            {% if may_decide %}
              <form method="post" action="/admin/partner-orgs/{{ org.id }}/check" style="display:inline">
                <input type="hidden" name="_token" value="{{ csrf_token }}">
                <input type="hidden" name="which" value="scuml">
                <button class="ad-btn ad-btn--xs" name="verdict" value="confirmed" type="submit">I checked it</button>
                <button class="ad-btn ad-btn--xs ad-btn--danger" name="verdict" value="rejected" type="submit">Not valid</button>
              </form>
            {% endif %}
          </td>
        </tr>
      </tbody>
    </table>

    {% if org.checked_at %}
      <p style="font-size:12.5px;color:var(--ad-text-soft);margin:12px 0 0">
        Last recorded {{ org.checked_at }}{% if org.checked_by %} by admin #{{ org.checked_by }}{% endif %}.
      </p>
    {% endif %}
  </div>
</div>

{# ── 3 · DOCUMENTS ──────────────────────────────────────────────────────────#}
<div class="ad-card" style="margin-bottom:16px">
  <div class="ad-card__head"><div class="ad-card__title">Certificates
    <small>an expiry that lapsed is the thing nobody notices</small></div></div>
  <div class="ad-card__body">

  {% if documents %}
    <table class="ad-table" style="max-width:760px">
      <caption class="sr-only">Uploaded certificates</caption>
      <thead><tr><th scope="col">Kind</th><th scope="col">File</th><th scope="col">Expires</th><th scope="col">Added</th></tr></thead>
      <tbody>
      {% for d in documents %}
        {% set expired = d.expires_on and d.expires_on < "now"|date('Y-m-d') %}
        <tr>
          <td>{{ doc_kinds[d.kind]|default(d.kind) }}</td>
          <td><a href="/{{ d.stored_path }}" target="_blank" rel="noopener">{{ d.original_name|default('document') }}</a></td>
          <td>
            {% if d.expires_on %}
              <span class="ad-chip ad-chip--{{ expired ? 'red' : 'green' }}">
                {{ expired ? 'Expired ' : '' }}{{ d.expires_on }}</span>
            {% else %}<span style="color:var(--ad-text-soft)">—</span>{% endif %}
          </td>
          <td style="font-size:12.5px;color:var(--ad-text-soft)">{{ d.created_at }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  {% else %}
    <p style="color:var(--ad-text-soft);margin:0 0 12px">Nothing uploaded yet.</p>
  {% endif %}

  {% if may_decide %}
    <form method="post" action="/admin/partner-orgs/{{ org.id }}/document" enctype="multipart/form-data"
          style="margin-top:14px;display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px;align-items:end">
      <input type="hidden" name="_token" value="{{ csrf_token }}">
      <div>
        <label for="poKind">Kind</label>
        <select id="poKind" name="kind">
          {% for k, label in doc_kinds %}<option value="{{ k }}">{{ label }}</option>{% endfor %}
        </select>
      </div>
      <div>
        <label for="poFile">File (PDF or image)</label>
        <input id="poFile" name="document" type="file" accept=".pdf,image/*" required>
      </div>
      <div>
        <label for="poExp">Expires (optional)</label>
        <input id="poExp" name="expires_on" type="date">
      </div>
      <div><button class="ad-btn" type="submit">Attach</button></div>
    </form>
  {% endif %}
  </div>
</div>

{# ── 4 · DASHBOARD LOGINS ───────────────────────────────────────────────────#}
<div class="ad-card" style="margin-bottom:16px">
  <div class="ad-card__head"><div class="ad-card__title">Dashboard logins
    <small>they sign in at /org — an owner can request payouts, a viewer cannot</small></div></div>
  <div class="ad-card__body">

  {% if users %}
    <table class="ad-table" style="max-width:700px">
      <caption class="sr-only">Dashboard logins</caption>
      <thead><tr><th scope="col">Email</th><th scope="col">Name</th><th scope="col">Role</th><th scope="col">Last sign-in</th></tr></thead>
      <tbody>
      {% for u in users %}
        <tr>
          <td>{{ u.email }}</td>
          <td>{{ u.name|default('—') }}</td>
          <td><span class="ad-chip ad-chip--{{ u.role == 'owner' ? 'blue' : 'grey' }}">{{ u.role }}</span></td>
          <td style="font-size:12.5px;color:var(--ad-text-soft)">{{ u.last_login_at|default('never') }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  {% else %}
    <p style="color:var(--ad-text-soft);margin:0 0 12px">No logins yet.</p>
  {% endif %}

  {% if may_decide %}
    <form method="post" action="/admin/partner-orgs/{{ org.id }}/user"
          style="margin-top:14px;display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px;align-items:end">
      <input type="hidden" name="_token" value="{{ csrf_token }}">
      <div><label for="poUEmail">Email</label><input id="poUEmail" name="email" type="email" required></div>
      <div><label for="poUName">Name</label><input id="poUName" name="name" type="text" maxlength="160"></div>
      <div>
        <label for="poURole">Role</label>
        <select id="poURole" name="role"><option value="owner">Owner</option><option value="viewer">Viewer</option></select>
      </div>
      <div><button class="ad-btn" type="submit">Create login</button></div>
    </form>
    <p style="font-size:12.5px;color:var(--ad-text-soft);margin:10px 0 0">
      A password is generated and shown <strong>once</strong> on the next screen. It is never
      emailed — a credential that can request payouts should not live in two mailboxes.
    </p>
  {% endif %}
  </div>
</div>

{# ── 5 · THE DECISION ───────────────────────────────────────────────────────#}
{% if may_decide %}
<div class="ad-card">
  <div class="ad-card__head"><div class="ad-card__title">Decision</div></div>
  <div class="ad-card__body" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px">

    <form method="post" action="/admin/partner-orgs/{{ org.id }}/approve">
      <input type="hidden" name="_token" value="{{ csrf_token }}">
      <label for="poNote">Approval note (recorded)</label>
      <input id="poNote" name="note" type="text" maxlength="255" placeholder="What you checked, in one line">
      <div style="margin-top:12px">
        <button class="ad-btn ad-btn--primary" type="submit"
                data-confirm="Approve {{ org.name }}? Their appeal page goes live and they can start receiving donations immediately.">
          Approve and go live
        </button>
      </div>
      <p style="font-size:12.5px;color:var(--ad-text-soft);margin:10px 0 0">
        Refused unless a settlement account, a CAC number and a SCUML number are all on file.
      </p>
    </form>

    <form method="post" action="/admin/partner-orgs/{{ org.id }}/suspend">
      <input type="hidden" name="_token" value="{{ csrf_token }}">
      <label for="poReason">Reason for suspending</label>
      <input id="poReason" name="reason" type="text" maxlength="255" placeholder="e.g. CAC restricted its trustees">
      <div style="margin-top:12px">
        <button class="ad-btn ad-btn--danger" type="submit"
                data-confirm="Suspend {{ org.name }}? Their appeal page stops accepting donations immediately and payouts go on hold. Everything already given to them is unaffected.">
          Suspend
        </button>
      </div>
    </form>

  </div>
</div>
{% endif %}
{% endblock %}
