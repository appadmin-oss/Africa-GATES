{% extends "admin/layout.twig" %}
{% block topbar_eyebrow %}<small>Programmes</small>{% endblock %}
{% block topbar_title %}Awards & Cycles{% endblock %}
{% block topbar_actions %}<a class="ad-btn ad-btn--primary" href="/admin/programmes/new">+ New Programme</a>{% endblock %}

{% block content %}
<div class="ad-card"><div class="ad-table-wrap">
  <table class="ad-table">
    <thead><tr><th>Programme</th><th>Active</th><th>Current Cycle</th><th>Status</th><th class="col-actions">Actions</th></tr></thead>
    <tbody>
      {% for r in rows %}
      <tr>
        <td>
          <strong>{{ r.icon_emoji }} {{ r.title }}</strong>
          <div style="font-size:12px;color:var(--ad-text-soft)">{{ r.slug }} · {{ r.scope|capitalize }}</div>
        </td>
        <td>{% if r.is_active %}<span class="ad-chip ad-chip--green">Active</span>{% else %}<span class="ad-chip ad-chip--grey">Inactive</span>{% endif %}</td>
        <td>{{ r.cycle ? r.cycle.year ~ ' · ' ~ (r.cycle.edition_label|default('—')) : '—' }}</td>
        <td>
          {% if r.cycle %}
            {% set chip = {'voting':'green','nominations':'gold','results':'blue','judging':'purple','archived':'grey','upcoming':'grey'}[r.cycle.status]|default('grey') %}
            <span class="ad-chip ad-chip--{{ chip }}">{{ r.cycle.status|capitalize }}</span>
          {% else %}—{% endif %}
        </td>
        <td class="col-actions">
          <a class="ad-btn ad-btn--sm" href="/admin/programmes/{{ r.id }}">Edit</a>
          <a class="ad-btn ad-btn--sm ad-btn--primary" href="/admin/programmes/{{ r.id }}/cycle">Manage Cycle</a>
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div></div>
{% endblock %}
