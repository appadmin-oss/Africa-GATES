{% extends "admin/layout.twig" %}
{% block topbar_title %}{{ programme.title }} · Cycle{% endblock %}
{% block topbar_actions %}<a class="ad-btn" href="/admin/programmes">← Back</a>{% endblock %}

{% block head_styles %}
<style nonce="{{ csp_nonce }}">
  .ed-list{ display:grid; gap:8px }
  .ed{ display:flex; align-items:baseline; gap:10px; flex-wrap:wrap; min-height:44px;
    padding:10px 12px; border:1px solid rgba(16,41,44,.14); border-radius:10px;
    text-decoration:none; color:#3d4b4d; background:#fff }
  .ed:hover{ border-color:rgba(16,41,44,.3) }
  .ed:focus-visible{ outline:3px solid #237b22; outline-offset:2px }
  .ed--here{ border-color:#237b22; background:rgba(35,123,34,.05) }
  .ed__y{ font-weight:700; color:#10292C; font-size:14px }
  .ed__s, .ed__l, .ed__e{ font-family:var(--ag-font-mono,monospace); font-size:10px;
    font-weight:700; letter-spacing:.08em; text-transform:uppercase }
  .ed__s{ color:#5a6d6f }
  .ed__l{ color:#18571a }
  .ed__e{ color:#7a5605 }
  .ed__c{ font-size:12px; color:#5a6d6f; margin-left:auto }
  .ed__warn{ margin:12px 0 0; padding:11px 14px; border-left:3px solid #d49a0e;
    background:#fffaf0; border-radius:0 8px 8px 0; font-size:12.5px; line-height:1.65;
    color:#7a5605 }
  .ed-new{ margin-top:14px }
  .ed-new__f{ display:grid; grid-template-columns:repeat(auto-fit,minmax(160px,1fr));
    gap:10px; align-items:end }
  .ed-new label{ display:block; font-size:11px; font-weight:700; letter-spacing:.05em;
    text-transform:uppercase; color:#5a6d6f; margin-bottom:4px }
  .ed-new input[type=text], .ed-new input[type=number]{ width:100%; min-height:40px;
    padding:8px 10px; font:inherit; font-size:13px; border-radius:8px;
    border:1px solid rgba(16,41,44,.2); background:#fff; color:#10292C }
</style>
{% endblock %}

{% block content %}
<div class="ad-grid-2">
  <div>
    <form method="post" action="/admin/programmes/{{ programme.id }}/cycle" class="ad-form">
      <input type="hidden" name="_token" value="{{ csrf_token }}">
      {% if phase %}
      {# WHAT THE PLATFORM ACTUALLY THINKS. The editor previously showed only the
         stored status and five bare date fields, so an admin had no way to know
         which phase the site was really in — and the phase is COMPUTED from
         these dates, not from the dropdown. `drifted` means the cached column
         disagrees with the dates; the dates win everywhere that matters. #}
      <div class="ad-card" style="margin-bottom:14px">
        <div class="ad-card__head">
          <div class="ad-card__title">Current phase<small>Computed from the date windows below — this is what the public site does</small></div>
          <span class="ad-chip ad-chip--{{ phase.is_open ? 'green' : (phase.is_finished ? 'grey' : 'gold') }}">{{ phase.label }}</span>
        </div>
        <div class="ad-card__body">
          <p style="margin:0;font-size:14px;color:var(--ad-text)">{{ phase.detail }}</p>
          <p style="margin:8px 0 0;font-size:12.5px;color:var(--ad-text-mute)">
            Votes accepted: <strong>{{ phase.is_voting_open ? 'yes' : 'no' }}</strong> ·
            Nominations accepted: <strong>{{ phase.is_nominations_open ? 'yes' : 'no' }}</strong>
            {% if cycle.next_boundary_at %} · Next change <strong>{{ cycle.next_boundary_at|date('j M Y, H:i') }}</strong>{% endif %}
          </p>
          {% if phase.drifted %}
          <div class="ad-flash ad-flash--err" role="alert" style="margin:14px 0 0">
            ⚠ The stored status column says <code>{{ phase.stored_status }}</code> but the dates compute
            <code>{{ phase.phase }}</code>. The dates are authoritative for voting and nominations, so the
            site is behaving correctly — but reports and lists reading the column will be wrong until the
            scheduled task catches up. Saving this form re-syncs it.
          </div>
          {% endif %}
        </div>
      </div>
      {% endif %}

      <div class="ad-card">
        <div class="ad-card__head"><div class="ad-card__title">Cycle window<small>Entered in {{ timezone }} · stored as UTC</small></div></div>
        <div class="ad-card__body">
          <div class="ad-form">
            {# Target this cycle by ID. Matching on the submitted YEAR meant that
               editing the year field silently created a brand-new empty cycle. #}
            <input type="hidden" name="cycle_id" value="{{ cycle.id|default('') }}">
            <div class="row">
              <div><label for="f-year">Year</label><input type="number" name="year" id="f-year" value="{{ cycle.year|default('now'|date('Y')) }}" required></div>
              <div><label for="f-status">Status <span class="hint" style="font-weight:400">cached · dates decide the real phase</span></label>
                {# Only transitions the guard will accept. The list used to
                   include 'results', which is refused unconditionally. #}
                <select name="status" id="f-status">{% for s in selectable %}<option value="{{ s }}" {% if cycle.status == s %}selected{% endif %}>{{ s|capitalize }}</option>{% endfor %}</select>
              </div>
            </div>
            <div><label for="f-edition_label">Edition label</label><input type="text" name="edition_label" id="f-edition_label" value="{{ cycle.edition_label|default('') }}"></div>
            <div class="row">
              <div><label for="f-nominations_open">Nominations open</label><input type="datetime-local" name="nominations_open" id="f-nominations_open" value="{{ cycle.nominations_open|default('')|when_input }}" step="1"></div>
              <div><label for="f-nominations_close">Nominations close</label><input type="datetime-local" name="nominations_close" id="f-nominations_close" value="{{ cycle.nominations_close|default('')|when_input }}" step="1"></div>
            </div>
            <div class="row">
              <div><label for="f-voting_open">Voting open</label><input type="datetime-local" name="voting_open" id="f-voting_open" value="{{ cycle.voting_open|default('')|when_input }}" step="1"></div>
              <div><label for="f-voting_close">Voting close</label><input type="datetime-local" name="voting_close" id="f-voting_close" value="{{ cycle.voting_close|default('')|when_input }}" step="1"></div>
            </div>
            <div><label for="f-results_date">Results date</label><input type="datetime-local" name="results_date" id="f-results_date" value="{{ cycle.results_date|default('')|when_input }}" step="1"></div>

            {#
              ── WHY A RESULT IS LATE, IF IT IS ────────────────────────────────

              A results date is a promise made in public. The public pages used to serve
              the live standing once it passed — announced or not — so a cycle still in
              judging published a named winner from an open panel, unsealed. They publish
              only an announced cycle now, and state the delay instead.

              The DELAY is derived: a date in the past, a status that is not `results` or
              `archived`. Nothing here switches it on and nothing has to switch it off, so
              it cannot be left up in March. This field is the one part only a person can
              write — the reason — and the page says what it knows without it.
            #}
            <div>
              <label for="f-results_delay_note">Why the result is late
                <span class="hint" style="font-weight:400">shown publicly · optional</span></label>
              <textarea name="results_delay_note" id="f-results_delay_note" rows="3"
                        maxlength="1000"
                        placeholder="e.g. Two categories are being re-checked after a counting fault. We will announce as soon as every award can be published in full.">{{ cycle.results_delay_note|default('') }}</textarea>
            </div>
            {#
              WHETHER IT IS LIVE, said here. An operator typing into this box otherwise
              cannot tell whether the sentence is on the site now or filed for a delay
              that has not happened — and those are very different things to be writing.
              Same call the public page makes, so the two cannot disagree.
            #}
            {% if late %}
              <p class="hint" style="margin:0;color:#b4451f">
                <strong>This cycle&rsquo;s results are late right now.</strong> The public
                results page is telling people the result was expected on
                {{ late.promised|date('j F Y') }} and has not been announced.
                {% if late.note %}Your note is showing with it.{% else %}Nothing you have
                written is showing &mdash; the page states the date and that the award is
                not decided, and nothing else.{% endif %}
                It stops by itself when the cycle is announced.
              </p>
            {% else %}
              <p class="hint" style="margin:0">
                Nothing is showing publicly: this cycle is not past its results date, or it
                has already been announced. A note saved here appears only if the date
                passes before the announcement does.
              </p>
            {% endif %}
            <p class="hint" style="margin:0">
              {# Was `Entered and stored in UTC`, with the value round-tripped by an inline
                 `|when_input` — which put a `T` separator into the
                 column and dropped the seconds. Both now go through DisplayTime, which is
                 also why `step="1"` is on every field above: without it the browser hides
                 the seconds it was given and hands back a value one minute coarser. #}
              Entered in <strong>{{ timezone }}</strong> and stored as UTC — your browser's timezone is not applied.
              Leave a field blank to skip that phase. A voting close date with no open date is accepted,
              but setting both is strongly preferred.
            </p>
          </div>
        </div>
      </div>

      {% if history|length %}
      {# The transitions ledger was written but never displayed, so an admin
         could not see what changed the phase or when. `boundary_at` is the date
         that caused it; `observed_at` is when the platform noticed — a large gap
         means the scheduled task was not running. #}
      <div class="ad-card" style="margin-top:14px">
        <div class="ad-card__head"><div class="ad-card__title">Phase history<small>Most recent first</small></div></div>
        <div class="ad-table-wrap">
          <table class="ad-table">
            <thead><tr><th scope="col">Change</th><th scope="col">Due</th><th scope="col">Applied</th><th scope="col">By</th><th scope="col">Notified</th></tr></thead>
            <tbody>
              {% for h in history %}
              <tr>
                <td><code style="font-size:11px">{{ h.from_status|default('—') }} → {{ h.to_status }}</code></td>
                <td>{{ h.boundary_at ? h.boundary_at|date('j M Y, H:i') : '—' }}</td>
                <td>{{ (h.observed_at ?: h.created_at)|date('j M Y, H:i') }}</td>
                <td>{{ h.actor|default('—') }}</td>
                <td>{% if h.notify is defined and not h.notify %}<span class="ad-chip ad-chip--grey">suppressed</span>{% else %}<span class="ad-chip ad-chip--green">sent</span>{% endif %}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
      {% endif %}

      {#
        ══ EVERY EDITION OF THIS PROGRAMME ═══════════════════════════════════

        These used to be CHIPS YOU COULD NOT CLICK, with a line saying "you are editing the
        one the site is running" — true, and a dead end: last year's dates, label and
        categories were unreachable from a console on a host with no shell.

        They are links now, and each carries what is actually in it. "2025" orients nobody;
        "2025 · 5 categories · 41 nominees · archived" tells an operator which one they
        want before they click.

        The one the PUBLIC SITE is running is marked separately from the one being edited,
        because the whole hazard of making these clickable is somebody changing a date on
        last year's edition believing it is this year's.
      #}
      {% if editions|length > 0 %}
      <div class="ad-card" style="margin-top:14px">
        <div class="ad-card__head"><div class="ad-card__title">Editions<small>{{ editions|length }} on this programme. The one you are editing is marked.</small></div></div>
        <div class="ad-card__body">
          <div class="ed-list">
            {% for e in editions %}
              {% set is_here = e.row.id == cycle.id %}
              {% set is_live = e.row.id == live_cycle_id %}
              <a class="ed{% if is_here %} ed--here{% endif %}"
                 href="/admin/programmes/{{ programme.id }}/cycle?cycle={{ e.row.id }}"
                 {% if is_here %}aria-current="true"{% endif %}>
                <span class="ed__y">{{ e.row.edition_label ?: e.row.year }}</span>
                <span class="ed__s">{{ e.row.status }}</span>
                <span class="ed__c">{{ e.categories }} categor{{ e.categories == 1 ? 'y' : 'ies' }}
                  &middot; {{ e.nominees }} nominee{{ e.nominees == 1 ? '' : 's' }}</span>
                {% if is_live %}<span class="ed__l">live on the site</span>{% endif %}
                {% if is_here %}<span class="ed__e">editing</span>{% endif %}
              </a>
            {% endfor %}
          </div>
          {% if cycle and live_cycle_id and cycle.id != live_cycle_id %}
            <p class="ed__warn"><strong>You are editing an edition the public site is not
              running.</strong> Its dates and status still take effect when the schedule
              reaches them &mdash; this is a real edition, not a draft.</p>
          {% endif %}
        </div>
      </div>
      {% endif %}
      <div style="display:flex;justify-content:flex-end;margin-top:14px">
        <button class="ad-btn ad-btn--primary" type="submit">Save cycle</button>
      </div>
    </form>

    {#
      ══ OPENING NEXT YEAR'S EDITION ═══════════════════════════════════════════

      OUTSIDE the cycle form, and that is not a layout preference. An HTML parser DISCARDS
      a `<form>` start tag while one is already open — not nested, not errored: dropped,
      with its children adopted by the outer form. This button would have rendered, styled
      and enabled, and posted to `/cycle`, which saves the current edition. It has happened
      three times in this codebase.

      A separate ACTION as well as a separate form. The cycle form posts the current
      cycle's id, so an operator who changed the year on it did not open next year's
      edition — they renamed this year's, taking its nominees, votes and scores with it.
    #}
    <div class="ad-card ed-new">
      <div class="ad-card__head"><div class="ad-card__title">Open the next edition<small>A new cycle of this programme, with its categories carried over</small></div></div>
      <div class="ad-card__body">
        <form method="post" action="/admin/programmes/{{ programme.id }}/editions"
              data-confirm="Open the {{ next_year }} edition of {{ programme.title }}? This creates a new cycle. Nothing is taken from the current one.">
          <input type="hidden" name="_token" value="{{ csrf_token }}">
          <div class="ed-new__f">
            <div>
              <label for="ed-year">Year</label>
              <input type="number" name="year" id="ed-year" min="{{ 'now'|date('Y') - 5 }}"
                     max="{{ 'now'|date('Y') + 5 }}" step="1" value="{{ next_year }}" required>
            </div>
            <div>
              <label for="ed-label">Edition name (optional)</label>
              <input type="text" name="edition_label" id="ed-label" maxlength="100"
                     placeholder="e.g. {{ next_year }} edition">
            </div>
            <div>
              <button class="ad-btn ad-btn--primary" type="submit">Open {{ next_year }}</button>
            </div>
          </div>
          <label class="checkbox" style="display:flex;align-items:flex-start;gap:8px;margin-top:12px">
            <input type="checkbox" name="copy_categories" value="1" checked>
            <span><strong>Carry the categories over</strong> &mdash; slug, title, description
              and order, from the most recent edition that has any. Nothing else comes with
              them: no nominees, no votes, no shortlists, no scorecards.</span>
          </label>
          <p style="margin:10px 0 0;font-size:12px;line-height:1.65;color:var(--ad-text-mute,#5a6d6f)">
            The new edition opens as <strong>upcoming with no dates</strong>. A results date
            inherited from last year is a promise nobody made, arriving already passed
            &mdash; the public site would publish a &ldquo;this award is late&rdquo; notice
            on an edition that has not opened. Set its dates once it exists.</p>
        </form>
      </div>
    </div>
  </div>

  <div>
    <div class="ad-card">
      <div class="ad-card__head"><div class="ad-card__title">Categories<small>For the current cycle</small></div></div>
      <div class="ad-card__body">
        {% if categories|length == 0 %}<p style="color:var(--ad-text-mute);font-size:13px">No categories yet.</p>{% endif %}
        {% for c in categories %}
        <details style="border:1px solid var(--ad-line);border-radius:8px;padding:12px;margin-bottom:8px">
          <summary style="font-weight:600;cursor:pointer">{{ c.title }} <span style="color:var(--ad-text-mute);font-weight:500">· {{ c.slug }}</span></summary>
          <form class="ad-form" method="post" action="/admin/programmes/{{ programme.id }}/categories" style="margin-top:12px">
            <input type="hidden" name="_token" value="{{ csrf_token }}"><input type="hidden" name="id" value="{{ c.id }}">
            <div class="row">
              <div><label for="f-title-{{ c.id }}">Title</label><input type="text" name="title" id="f-title-{{ c.id }}" value="{{ c.title }}" required></div>
              <div><label for="f-slug-{{ c.id }}">Slug</label><input type="text" name="slug" id="f-slug-{{ c.id }}" value="{{ c.slug }}" required></div>
            </div>
            <div><label for="f-description-{{ c.id }}">Description</label><textarea name="description" id="f-description-{{ c.id }}" rows="2">{{ c.description }}</textarea></div>
            <div class="row">
              <div><label for="f-sort_order-{{ c.id }}">Sort order</label><input type="number" name="sort_order" id="f-sort_order-{{ c.id }}" value="{{ c.sort_order }}"></div>
              <div style="display:flex;gap:8px;align-items:flex-end">
                <button class="ad-btn ad-btn--primary ad-btn--sm" type="submit">Update</button>
                {# `formaction`, NOT a nested <form>. This WAS a nested form, and an HTML
                   parser DISCARDS a <form> start tag inside an open one — so this button
                   kept its markup, lost its action, and posted to the UPDATE route above
                   it. Pressing Delete saved the category. `formnovalidate` because the
                   title and slug fields beside it are `required` and a delete has no
                   business being blocked by them. The confirm text says `title` because
                   `c.name` does not exist on a category row, so it used to read
                   “Delete “” permanently?”. #}
                <button class="ad-btn ad-btn--danger ad-btn--sm" type="submit"
                        formaction="/admin/categories/{{ c.id }}/delete" formnovalidate
                        data-confirm="Delete the category “{{ c.title }}” permanently? Anything already nominated or judged in it points at it by id, so this cannot be undone.">Delete</button>
              </div>
            </div>
          </form>
        </details>
        {% endfor %}

        <form class="ad-form" method="post" action="/admin/programmes/{{ programme.id }}/categories" style="margin-top:18px;padding:14px;background:var(--ad-bg);border-radius:8px">
          <input type="hidden" name="_token" value="{{ csrf_token }}">
          <strong style="font-size:13px">+ Add category</strong>
          <div class="row">
            <div><label for="f-title">Title</label><input type="text" name="title" id="f-title" required></div>
            <div><label for="f-slug">Slug</label><input type="text" name="slug" id="f-slug" required></div>
          </div>
          <div><label for="f-description">Description</label><textarea name="description" id="f-description" rows="2"></textarea></div>
          <div class="row">
            <div><label for="f-sort_order">Sort order</label><input type="number" name="sort_order" id="f-sort_order" value="0"></div>
            <div style="display:flex;align-items:flex-end"><button class="ad-btn ad-btn--primary ad-btn--sm" type="submit">Add</button></div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{% endblock %}
