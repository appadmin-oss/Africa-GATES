<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ page_title|default('Sign in with a link — Africa GATES') }}</title>
<link rel="icon" type="image/svg+xml" href="/assets/img/logo-mark.svg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,800;1,600&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&family=JetBrains+Mono:wght@500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ asset('/assets/css/base/tokens.css') }}">
<link rel="stylesheet" href="{{ asset('/assets/css/components/auth.css') }}">
</head>
<body>
<div class="ag-auth">
  <aside class="ag-auth__brand">
    <div class="ag-auth__orb" aria-hidden="true"></div>
    <a class="ag-auth__logo" href="/" aria-label="Africa GATES — home">
      <span class="ag-auth__logo-glyph" aria-hidden="true">G</span>
      <span class="ag-auth__logo-word"><b>Africa</b><span>GATES</span></span>
    </a>
    <div class="ag-auth__pitch">
      <h1>The console<br>behind the cycle.</h1>
      <p>Programmes, nominations, judging and results — managed in one secure place.</p>
    </div>
    <p class="ag-auth__copy">© {{ "now"|date("Y") }} Africa GATES · Admin Console</p>
  </aside>

  <div class="ag-auth__panel">
    <div class="ag-auth__form-wrap">
      <p class="ag-auth__eyebrow">Admin Console</p>
      <h1 class="ag-auth__h">Sign in with a link</h1>
      <p class="ag-auth__sub">We'll email you a one-tap sign-in link valid for 15 minutes — no password needed.</p>

      {% if error %}<div class="ag-auth__alert ag-auth__alert--err" role="alert">{{ error }}</div>{% endif %}
      {% if notice %}<div class="ag-auth__alert ag-auth__alert--note" role="status">{{ notice }}</div>{% endif %}

      <form method="post" action="/admin/magic/request">
        <input type="hidden" name="_token" value="{{ csrf_token }}">
        <div class="ag-auth__field">
          <label class="ag-auth__label" for="email">Your admin email</label>
          <input class="ag-auth__input" id="email" type="email" name="email" autocomplete="email" required autofocus>
        </div>
        <button class="ag-auth__cta" type="submit">Send sign-in link →</button>
      </form>

      <div class="ag-auth__hr"></div>
      <p class="ag-auth__alt"><a href="/admin/login">← Back to password sign-in</a></p>
    </div>
  </div>
</div>
</body>
</html>
