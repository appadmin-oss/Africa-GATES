{% extends "admin/layout.twig" %}
{% block topbar_eyebrow %}<small>Nominations</small>{% endblock %}
{% block topbar_title %}Review · {{ nom.nominee_name }}{% endblock %}
{% block topbar_actions %}
  {% if nom.status == 'pending' %}<a class="ad-btn ad-btn--primary" href="/admin/nominations/review">▶ Open review desk</a>{% endif %}
  <a class="ad-btn" href="/admin/nominations">← Back</a>
{% endblock %}

{% block content %}
{% include 'admin/nominations/_review_body.twig' with {
  nom: nom, categories: categories, eligibility: eligibility,
  duplicates: duplicates, insight: insight, spa: false
} %}

<script>
/* AI "Suggest with AI" for decision notes — fills the textarea; hides the
   button if no AI provider is configured (503). Single-page only; the SPA desk
   has its own delegated handler. */
document.addEventListener('click', function (e) {
  var b = e.target.closest('[data-suggest]');
  if (!b) return;
  e.preventDefault();
  var ta = document.getElementById(b.getAttribute('data-target'));
  if (!ta) return;
  var nom = b.getAttribute('data-nom');
  var orig = b.textContent; b.disabled = true; b.textContent = '✦ Thinking…';
  fetch('/admin/nominations/' + nom + '/suggest-reason', {
    method: 'POST',
    headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-CSRF-Token': '{{ csrf_token }}' },
    body: 'decision=' + encodeURIComponent(b.getAttribute('data-suggest'))
  }).then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
    .then(function (res) {
      if (res.ok && res.j.reason) { ta.value = res.j.reason; ta.focus(); b.textContent = orig; b.disabled = false; }
      else if (res.j && res.j.error && String(res.j.error).indexOf('No AI') === 0) { b.style.display = 'none'; }
      else { b.textContent = orig; b.disabled = false; }
    }).catch(function () { b.textContent = orig; b.disabled = false; });
});
</script>
{% endblock %}
