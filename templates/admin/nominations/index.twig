{% extends "admin/layout.twig" %}
{% import "admin/partials/ui.twig" as ui %}
{% block topbar_eyebrow %}<small>Moderation</small>{% endblock %}
{% block topbar_title %}Nominations{% endblock %}
{% block topbar_actions %}
  {% if counts.pending > 0 %}<a class="ad-btn ad-btn--primary" href="/admin/nominations/review" title="Work through pending nominations one by one, oldest first, with keyboard shortcuts">▶ Review desk <span style="opacity:.85">({{ counts.pending }})</span></a>{% endif %}
{% endblock %}

{% block content %}
{% set qp = qs_base ? '&' ~ qs_base : '' %}
<div class="ad-card" style="display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-bottom:12px;padding:12px 14px">
  <span style="font-size:12px;font-weight:600;color:var(--ad-text-mute,#5a6d6f)">Quick filters <span class="ad-info" data-tip="One-click presets to triage nominations. Start with the review queue (oldest pending first) to work through fairly in order." tabindex="0" aria-label="Filter presets">i</span></span>
  <a class="ad-tab {% if filters.status == 'pending' and filters.sort == 'oldest' %}is-active{% endif %}" href="/admin/nominations?status=pending&sort=oldest{{ qp }}">📋 Review queue <span class="n">{{ counts.pending }}</span></a>
  <a class="ad-tab {% if filters.status == 'pending' and filters.sort != 'oldest' %}is-active{% endif %}" href="/admin/nominations?status=pending&sort=newest{{ qp }}">🕘 Latest pending</a>
  <a class="ad-tab {% if filters.status == 'approved' %}is-active{% endif %}" href="/admin/nominations?status=approved{{ qp }}">✓ Approved <span class="n">{{ counts.approved }}</span></a>
  <a class="ad-tab {% if filters.status == 'rejected' %}is-active{% endif %}" href="/admin/nominations?status=rejected{{ qp }}">✕ Rejected <span class="n">{{ counts.rejected }}</span></a>
  <a class="ad-tab {% if filters.status == 'all' %}is-active{% endif %}" href="/admin/nominations?status=all{{ qp }}">All</a>
</div>
<form class="ad-filters" method="get" action="/admin/nominations" style="display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap">
  <input type="hidden" name="status" value="{{ filters.status }}">
  <input type="hidden" name="sort" value="{{ filters.sort }}">
  <div style="flex:1;min-width:200px">
    <label style="display:block;font-size:12px;font-weight:600;color:var(--ad-text-mute,#5a6d6f);margin-bottom:4px">Search</label>
    <input type="search" name="q" value="{{ filters.q }}" placeholder="Search nominee or nominator…" aria-label="Search nominee or nominator" style="width:100%">
  </div>
  {% include 'admin/partials/datefields.twig' with {range: filters.range, from: filters.from, to: filters.to} only %}
  <button class="ad-btn ad-btn--primary" type="submit">Filter</button>
  {% if filters.q or (filters.range not in ['','all']) or filters.from or filters.to %}<a class="ad-btn" href="/admin/nominations?status={{ filters.status }}&sort={{ filters.sort }}">Clear</a>{% endif %}
</form>

<div class="ad-card"><div class="ad-table-wrap">
  <div style="display:flex;justify-content:space-between;align-items:center;padding:4px 4px 12px">
    <strong style="font-size:14px">{{ total|number_format }} nomination{{ total == 1 ? '' : 's' }}</strong>
    {% if pages > 1 %}<span style="font-size:12px;color:var(--ad-text-mute,#5a6d6f)">Page {{ page }} of {{ pages }}</span>{% endif %}
  </div>
  <table class="ad-table">
    <thead><tr>
      <th scope="col">Nominee</th>
      <th scope="col">Contact</th>
      <th scope="col">Programme</th>
      <th scope="col">Nominated by</th>
      <th scope="col">Reason</th>
      <th scope="col">When</th>
      <th scope="col">Status</th>
      <th scope="col" class="col-actions">Actions</th>
    </tr></thead>
    <tbody>
      {% for r in rows %}
      <tr>
        <td>
          <div style="display:flex;align-items:center;gap:9px">
            {% if r.nominee_photo_path %}
            <button type="button" class="ad-avatar-btn" data-view-media="{{ r.nominee_photo_path }}" data-view-title="{{ r.nominee_name }}" aria-label="View photo of {{ r.nominee_name }}"
                    style="flex:none;width:34px;height:34px;border-radius:8px;border:1px solid var(--ad-line,#dfe4e3);background-image:url('{{ r.nominee_photo_path }}');background-size:cover;background-position:center;cursor:zoom-in"></button>
            {% endif %}
            <div style="min-width:0">
              <strong>{{ r.nominee_name }}</strong>
              <div style="font-size:11px;color:var(--ad-text-mute);font-family:'Space Mono',monospace">{{ r.reference|default('—') }}</div>
            </div>
          </div>
        </td>
        <td style="font-size:12.5px;color:var(--ad-text-soft)">
          {% if r.nominee_email %}<div>✉ {{ ui.cell(r.nominee_email, 26, 'Nominee email') }}</div>{% endif %}
          {% if r.nominee_phone %}<div>☎ {{ r.nominee_phone }}</div>{% endif %}
          {% if not r.nominee_email and not r.nominee_phone %}<span class="ad-dim">—</span>{% endif %}
          <div style="color:var(--ad-text-mute)">{{ r.country_code|default('—') }}{% if r.nominee_state %} · {{ r.nominee_state }}{% endif %}</div>
        </td>
        <td>{{ r.programme_title|default('—') }}<div style="font-size:11px;color:var(--ad-text-mute)">{{ r.cycle_year }}</div></td>
        <td style="font-size:12.5px">
          {{ ui.cell(r.nominator_name, 22, 'Nominator') }}
          <div style="font-size:11.5px;color:var(--ad-text-soft)">{{ ui.cell(r.nominator_email, 24, 'Nominator email') }}</div>
        </td>
        <td style="max-width:240px">{{ ui.cell(r.reason, 60, 'Reason for nominating ' ~ r.nominee_name) }}</td>
        <td style="font-size:12px;color:var(--ad-text-soft);font-family:'Space Mono',monospace;white-space:nowrap">{{ r.created_at|slice(0, 16) }}</td>
        <td>
          {% set chip = {'approved':'green','pending':'gold','rejected':'red'}[r.status]|default('grey') %}
          <span class="ad-chip ad-chip--{{ chip }}">{{ r.status|capitalize }}</span>
        </td>
        <td class="col-actions">
          <a class="ad-btn ad-btn--sm" href="/admin/nominations/{{ r.id }}">Review</a>
          {% if r.status != 'rejected' %}
          <form method="post" action="/admin/nominations/{{ r.id }}/reject" style="display:inline"><input type="hidden" name="_token" value="{{ csrf_token }}"><button class="ad-btn ad-btn--sm ad-btn--danger" type="submit" data-confirm="Reject this nomination?">Reject</button></form>
          {% endif %}
        </td>
      </tr>
      {% else %}
      <tr><td colspan="8" style="text-align:center;color:var(--ad-text-mute);padding:30px">Nothing here.</td></tr>
      {% endfor %}
    </tbody>
  </table>
  {% include 'admin/partials/pager.twig' with {base: '/admin/nominations', qs: qs, page: page, pages: pages, window: window} only %}
</div></div>
{% endblock %}
