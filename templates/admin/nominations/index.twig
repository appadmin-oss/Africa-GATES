{% extends "admin/layout.twig" %}
{#
  ALL NOMINATIONS — the console's list pattern (21 Oct 2026, rebuilt).

  Every nomination, any status, sliced by programme, edition, country and date. The
  review queue is where pending ones are decided; this is where any one is found. A row
  opens the nomination. The filters are one GET form and apply on change (console-ux.js).
#}
{% block head_styles %}<link rel="stylesheet" href="{{ asset('/assets/css/console/list.css') }}">{% endblock %}

{% block topbar_title %}All nominations{% endblock %}
{% block topbar_actions %}
  {% if counts.pending > 0 %}<a class="ad-btn ad-btn--primary" href="/admin/nominations/review">Review {{ counts.pending|number_format }}</a>{% endif %}
{% endblock %}

{% block content %}
{% set qp = qs_base ? '&' ~ qs_base : '' %}
{% set sep = qs ? '?' ~ qs ~ '&' : '?' %}
<div class="ls">
  <div class="ls-bar">
    <nav class="ls-tabs" aria-label="Status">
      {% for k, l in {pending: 'Pending', approved: 'Approved', rejected: 'Rejected', all: 'All'} %}
        <a class="ls-tab" href="/admin/nominations?status={{ k }}&sort={{ filters.sort }}{{ qp }}"{% if filters.status == k %} aria-current="page"{% endif %}>{{ l }}{% if counts[k] is defined %} <span class="ls-tab__num">{{ counts[k]|number_format }}</span>{% endif %}</a>
      {% endfor %}
    </nav>
  </div>

  {% if ai_enabled|default(false) %}
    {# The phrase becomes the same whitelisted GET filters below, applied by redirect. #}
    <form method="post" action="/admin/nominations/ai-filter" class="ls-bar">
      <input type="hidden" name="_token" value="{{ csrf_token }}">
      <label class="ls-search" style="flex:1;width:auto">
        <span class="sr-only">Ask in plain English</span>
        <input type="text" name="ai_query" maxlength="200" placeholder="Ask, e.g. pending from Kenya this month">
      </label>
      <button class="ad-btn ad-btn--sm" type="submit">Ask</button>
    </form>
  {% endif %}

  <form class="ls-bar" method="get" action="/admin/nominations">
    <input type="hidden" name="status" value="{{ filters.status }}">
    <label class="ls-search">
      <svg aria-hidden="true" focusable="false"><use href="#ic-search"/></svg>
      <span class="sr-only">Search</span>
      <input type="search" name="q" value="{{ filters.q }}" placeholder="Nominee or nominator">
    </label>
    <select class="ls-select" name="programme" aria-label="Programme">
      <option value="">All programmes</option>
      {% for pr in programmes %}<option value="{{ pr.id }}"{% if filters.programme == pr.id %} selected{% endif %}>{{ pr.title }}</option>{% endfor %}
    </select>
    <select class="ls-select" name="cycle" aria-label="Edition">
      <option value="">All editions</option>
      {% for c in cycles %}<option value="{{ c.id }}"{% if filters.cycle == c.id %} selected{% endif %}>{{ c.title }} {{ c.year }}</option>{% endfor %}
    </select>
    {% if countries|length > 1 %}
      <select class="ls-select" name="country" aria-label="Country">
        <option value="">All countries</option>
        {% for cc in countries %}<option value="{{ cc }}"{% if filters.country == cc %} selected{% endif %}>{{ cc }}</option>{% endfor %}
      </select>
    {% endif %}
    <select class="ls-select" name="range" aria-label="When">
      {% for key, label in {'all': 'Any time', 'today': 'Today', '7d': 'Last 7 days', '30d': 'Last 30 days', 'month': 'This month', 'year': 'This year', 'custom': 'Dates…'} %}
        <option value="{{ key }}"{% if filters.range == key or (key == 'all' and filters.range in ['', 'all']) %} selected{% endif %}>{{ label }}</option>
      {% endfor %}
    </select>
    <span class="ls-bar" data-ux-show-when="range=custom"{% if filters.from or filters.to %} data-ux-keep{% endif %}>
      <input class="ls-select" type="date" name="from" value="{{ filters.from }}" aria-label="From">
      <input class="ls-select" type="date" name="to" value="{{ filters.to }}" aria-label="To">
    </span>
    <span class="ls-bar__gap"></span>
    <select class="ls-select" name="sort" aria-label="Order">
      <option value="newest"{% if filters.sort != 'oldest' %} selected{% endif %}>Newest first</option>
      <option value="oldest"{% if filters.sort == 'oldest' %} selected{% endif %}>Oldest first</option>
    </select>
    <noscript><button class="ad-btn ad-btn--sm" type="submit">Show</button></noscript>
  </form>

  {% if rows %}
    <div class="ls-table" style="--ls-cols: minmax(0, 2fr) minmax(0, 1.4fr) minmax(0, 1.4fr) 110px 96px" role="table" aria-label="Nominations">
      <div class="ls-row ls-head" role="row">
        <span role="columnheader">Nominee</span>
        <span role="columnheader" class="ls-opt">Programme</span>
        <span role="columnheader" class="ls-opt">Nominated by</span>
        <span role="columnheader" class="ls-opt">When</span>
        <span role="columnheader">Status</span>
      </div>
      {% for r in rows %}
        {% set tone = {approved: 'green', pending: 'gold', rejected: 'red'}[r.status]|default('grey') %}
        <a class="ls-row ls-item" role="row" href="/admin/nominations/{{ r.id }}">
          <span class="ls-cell ls-cell--primary" role="cell">
            <strong>{{ r.nominee_name }}</strong>
            <span>{{ r.country_code|default('') }}{% if r.nominee_state %} · {{ r.nominee_state }}{% endif %}{% if r.reference %} · {{ r.reference }}{% endif %}</span>
          </span>
          <span class="ls-cell ls-cell--primary ls-opt" role="cell">
            <strong>{{ r.programme_title|default('No programme') }}</strong>
            <span>{{ r.cycle_year }}</span>
          </span>
          <span class="ls-cell ls-cell--primary ls-opt" role="cell">
            <strong>{{ r.nominator_name|default('Unknown') }}</strong>
            <span>{{ r.nominator_email }}</span>
          </span>
          <span class="ls-cell ls-opt" role="cell"><span class="ls-cell__time">{{ r.created_at|slice(0, 10) }}</span></span>
          <span class="ls-cell ls-cell--end" role="cell"><span class="ls-pill ls-pill--{{ tone }}">{{ r.status|capitalize }}</span></span>
        </a>
      {% endfor %}
    </div>
    <div class="ls-bar ls-foot">
      <span>{{ total|number_format }} nomination{{ total == 1 ? '' : 's' }}{% if pages > 1 %} · page {{ page }} of {{ pages }}{% endif %}</span>
      <span class="ls-bar__gap"></span>
      {% if page > 1 %}<a class="ad-btn ad-btn--sm" href="/admin/nominations{{ sep }}page={{ page - 1 }}" rel="prev">Previous</a>{% endif %}
      {% if page < pages %}<a class="ad-btn ad-btn--sm" href="/admin/nominations{{ sep }}page={{ page + 1 }}" rel="next">Next</a>{% endif %}
    </div>
  {% else %}
    <div class="ls-empty">
      <span class="ls-empty__t">No nominations</span>
      <span class="ls-empty__m">Nothing matches these filters.</span>
      <a class="ad-btn ad-btn--sm" href="/admin/nominations?status={{ filters.status }}">Clear filters</a>
    </div>
  {% endif %}
</div>
{% endblock %}
