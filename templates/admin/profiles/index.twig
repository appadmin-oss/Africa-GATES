{% extends "admin/layout.twig" %}
{% block topbar_eyebrow %}<small>Moderation</small>{% endblock %}
{% block topbar_title %}Profiles{% endblock %}

{% block content %}
<form class="ad-filters" method="get" action="/admin/profiles">
  <input type="search" name="q" value="{{ filters.q }}" placeholder="Search name, email, category…" aria-label="Search profiles">
  <select name="status" aria-label="Filter by status">
    <option value="">All statuses</option>
    {% for s in ['pending','approved','suspended','rejected'] %}
    <option value="{{ s }}" {% if filters.status == s %}selected{% endif %}>{{ s|capitalize }}</option>
    {% endfor %}
  </select>
  <select name="tier" aria-label="Filter by tier">
    <option value="">All tiers</option>
    {% for t in ['diamond','platinum','gold','silver','bronze','unranked'] %}
    <option value="{{ t }}" {% if filters.tier == t %}selected{% endif %}>{{ t|capitalize }}</option>
    {% endfor %}
  </select>
  <button class="ad-btn ad-btn--primary" type="submit">Filter</button>
  {% if filters.q or filters.status or filters.tier %}<a class="ad-btn ad-btn--ghost" href="/admin/profiles">Reset</a>{% endif %}
  <div style="margin-left:auto;display:flex;gap:6px">
    <a class="ad-tab {% if not filters.status %}is-active{% endif %}" href="/admin/profiles">All <span class="n">{{ counts.all }}</span></a>
    <a class="ad-tab {% if filters.status == 'pending' %}is-active{% endif %}" href="/admin/profiles?status=pending">Pending <span class="n">{{ counts.pending }}</span></a>
    <a class="ad-tab {% if filters.status == 'approved' %}is-active{% endif %}" href="/admin/profiles?status=approved">Approved <span class="n">{{ counts.approved }}</span></a>
    <a class="ad-tab {% if filters.status == 'suspended' %}is-active{% endif %}" href="/admin/profiles?status=suspended">Suspended <span class="n">{{ counts.suspended }}</span></a>
  </div>
</form>

{% if admin_role in ['superadmin','admin'] %}
{# Merge duplicate profiles: tick the duplicates + one KEEP, then submit. Inputs
   live in the rows but belong to this form via form="pmergeForm". Reversible. #}
<form id="pmergeForm" method="post" action="/admin/profiles/merge" style="margin:10px 0;display:flex;gap:10px;align-items:center;flex-wrap:wrap"
      data-confirm="Merge the ticked profiles into the KEEP one? Their linked nominees, CPI history and community reactions combine; duplicates are hidden but can be restored with Undo merge.">
  <input type="hidden" name="_token" value="{{ csrf_token }}">
  <span style="font-size:12px;color:var(--ad-text-soft)">Tick duplicate profiles + one KEEP, then</span>
  <button class="ad-btn ad-btn--sm ad-btn--primary" type="submit">Merge selected</button>
</form>
{% endif %}

<div class="ad-card">
  <div class="ad-table-wrap">
    <table class="ad-table">
      <thead><tr>{% if admin_role in ['superadmin','admin'] %}<th scope="col">Merge</th>{% endif %}<th scope="col">Profile</th><th scope="col">Type</th><th scope="col">Country</th><th scope="col">CPI</th><th scope="col">Status</th><th scope="col" class="col-actions">Actions</th></tr></thead>
      <tbody>
        {% for r in rows %}
        <tr>
          {% if admin_role in ['superadmin','admin'] %}
          <td style="white-space:nowrap">
            <label style="display:inline-flex;align-items:center;gap:3px;font-size:11px" title="Include in a merge">
              <input type="checkbox" name="merge_ids[]" value="{{ r.id }}" form="pmergeForm" aria-label="Select {{ r.display_name }} for merge"></label>
            <label style="display:inline-flex;align-items:center;gap:3px;font-size:11px">
              <input type="radio" name="keep_id" value="{{ r.id }}" form="pmergeForm" aria-label="Keep {{ r.display_name }} as the merge survivor"> keep</label>
          </td>
          {% endif %}
          <td>
            <strong>{{ r.display_name }}</strong>
            <div style="font-size:12px;color:var(--ad-text-soft)">{{ r.email }} · {{ r.category }}</div>
          </td>
          <td><span class="ad-chip ad-chip--grey">{{ r.profile_type|capitalize }}</span></td>
          <td><span style="font-family:'Space Mono',monospace">{{ r.country_code }}</span> · {{ r.region|capitalize }}</td>
          <td>
            <strong style="font-family:'Space Mono',monospace">{{ r.cpi_score }}</strong>
            <div style="font-size:11px;color:var(--ad-text-soft);text-transform:uppercase">{{ r.cpi_tier }}</div>
          </td>
          <td>
            {% set chip = {'approved':'green','pending':'gold','suspended':'red','rejected':'red'}[r.status]|default('grey') %}
            <span class="ad-chip ad-chip--{{ chip }}">{{ r.status|capitalize }}</span>
          </td>
          <td class="col-actions">
            <a class="ad-btn ad-btn--sm" href="/admin/profiles/{{ r.id }}">Edit</a>
            {% if r.status != 'approved' %}<form method="post" action="/admin/profiles/{{ r.id }}/approve"><input type="hidden" name="_token" value="{{ csrf_token }}"><button class="ad-btn ad-btn--sm ad-btn--primary" type="submit">Approve</button></form>{% endif %}
            {% if r.status == 'approved' %}<form method="post" action="/admin/profiles/{{ r.id }}/suspend"><input type="hidden" name="_token" value="{{ csrf_token }}"><button class="ad-btn ad-btn--sm ad-btn--danger" type="submit" data-confirm="Suspend {{ r.display_name }}? Their profile stops being publicly visible and they cannot be voted for while suspended. You can approve them again from this same screen.">Suspend</button></form>{% endif %}
          </td>
        </tr>
        {% else %}
        <tr><td colspan="{{ admin_role in ['superadmin','admin'] ? 7 : 6 }}" style="text-align:center;color:var(--ad-text-mute);padding:30px">No profiles match.</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>

{% set last_page = (total / (per ?: 1))|round(0, 'ceil') %}
{% if last_page > 1 %}
<div class="ad-pager">
  {% for p in 1..last_page %}
    {% if p == page %}<span class="is-current">{{ p }}</span>
    {% else %}<a href="?page={{ p }}{% if filters.q %}&q={{ filters.q }}{% endif %}{% if filters.status %}&status={{ filters.status }}{% endif %}{% if filters.tier %}&tier={{ filters.tier }}{% endif %}">{{ p }}</a>
    {% endif %}
  {% endfor %}
</div>
{% endif %}

{% if admin_role in ['superadmin','admin'] and merged is defined and merged|length %}
<details class="ad-card" style="margin-top:18px">
  <summary style="cursor:pointer;font-weight:600;font-size:13px">↩ Recently merged profiles ({{ merged|length }}) — undo a merge</summary>
  <p style="font-size:11.5px;color:var(--ad-text-mute,#61728e);margin:6px 0 10px">
    These profiles were folded into a survivor and hidden from the registry, leaderboard and search.
    Undoing restores the profile and moves its linked nominees + reactions back off the survivor.
  </p>
  <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:6px">
    {% for m in merged %}
    <li style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;font-size:13px">
      <span><strong>{{ m.name }}</strong> → kept as <strong>{{ m.keep_name ?? ('#' ~ m.keep_id) }}</strong>
        {% if m.merged_at %}<small style="color:var(--ad-text-mute,#61728e)"> · {{ m.merged_at }}</small>{% endif %}</span>
      <form method="post" action="/admin/profiles/unmerge" style="margin-left:auto">
        <input type="hidden" name="_token" value="{{ csrf_token }}">
        <input type="hidden" name="merged_id" value="{{ m.id }}">
        <button class="ad-btn ad-btn--xs" type="submit" data-confirm="Undo this merge? {{ m.name }} becomes live again and its linked nominees + reactions move back off the survivor.">Undo merge</button>
      </form>
    </li>
    {% endfor %}
  </ul>
</details>
{% endif %}
{% endblock %}
