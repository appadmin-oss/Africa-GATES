{# ── Admin UI kit: cell truncation + a shared detail / media modal ──────────
   Loaded once site-wide from the admin layout. Gives every admin table a
   consistent way to keep rows scannable and reveal full content on demand,
   with no per-page JS:

     • Truncated cell (macro `cell` below, or hand-written):
         <span class="ad-trunc" data-full="…long text…">short preview<button …>View</button></span>

     • Any "View" trigger opens the modal via data attributes — no inline JS:
         <button type="button" data-view-title="Reason" data-view-text="{{ x }}">View</button>
         <button type="button" data-view-title="Evidence" data-view-media="/admin/media/42/view">Open</button>
         <button type="button" data-view-title="Bio"      data-view-html="{{ x|sanitize_html }}">View</button>

   Accessible: focus moves into the dialog, Escape / backdrop / close button
   dismiss it, focus returns to the trigger, body scroll locks while open. #}

{% macro cell(text, limit, title) %}
  {%- set t = text|default('')|trim -%}
  {%- if t == '' -%}
    <span class="ad-dim">—</span>
  {%- elseif t|length <= (limit|default(80)) -%}
    {{ t }}
  {%- else -%}
    <span class="ad-trunc">{{ t|slice(0, (limit|default(80)))|trim }}…</span>
    <button type="button" class="ad-view-btn" data-view-title="{{ title|default('Details') }}" data-view-text="{{ t }}">View</button>
  {%- endif -%}
{% endmacro %}

<style>
  .ad-trunc{ color:var(--ad-text,#10292c); }
  .ad-dim{ color:var(--ad-text-mute,#8a9a9c); }
  .ad-view-btn{ display:inline-flex; align-items:center; gap:3px; margin-left:6px; padding:2px 9px;
    border:1px solid var(--ad-line,#dfe4e3); background:#fff; color:var(--ad-accent,#237b22);
    border-radius:999px; font:600 11.5px/1.4 inherit; cursor:pointer; white-space:nowrap; vertical-align:baseline; }
  .ad-view-btn:hover{ background:var(--ad-bg,#f4f6f5); border-color:var(--ad-accent,#237b22); }
  .ad-view-btn:focus-visible{ outline:2px solid var(--ad-accent,#237b22); outline-offset:2px; }

  .ad-modal{ position:fixed; inset:0; z-index:1200; display:none; }
  .ad-modal.is-open{ display:block; }
  .ad-modal__scrim{ position:absolute; inset:0; background:rgba(8,20,18,.55); backdrop-filter:blur(2px); }
  .ad-modal__box{ position:absolute; top:50%; left:50%; transform:translate(-50%,-50%);
    width:min(760px,94vw); max-height:88vh; display:flex; flex-direction:column;
    background:#fff; border-radius:16px; box-shadow:0 24px 60px -20px rgba(0,0,0,.5); overflow:hidden; }
  .ad-modal__hd{ display:flex; align-items:center; gap:12px; padding:14px 18px; border-bottom:1px solid var(--ad-line,#e5eae8); }
  .ad-modal__ttl{ margin:0; font:700 15px/1.3 inherit; color:var(--ad-text,#10292c); flex:1; }
  .ad-modal__x{ border:none; background:var(--ad-bg,#f1f4f3); width:32px; height:32px; border-radius:8px; cursor:pointer; font-size:17px; color:var(--ad-text,#10292c); line-height:1; }
  .ad-modal__x:hover{ background:#e2e8e6; }
  .ad-modal__body{ padding:18px; overflow:auto; font-size:14px; line-height:1.65; color:var(--ad-text,#10292c); white-space:pre-wrap; word-break:break-word; }
  .ad-modal__body.is-rich{ white-space:normal; }
  .ad-modal__body.is-rich :where(h2,h3){ margin:.6em 0 .3em; } .ad-modal__body.is-rich a{ color:var(--ad-accent,#237b22); }
  .ad-modal__body.is-media{ padding:0; background:#0d1614; display:flex; }
  .ad-modal__frame{ width:100%; height:74vh; border:0; background:#0d1614; }
  .ad-modal__img{ max-width:100%; max-height:74vh; margin:auto; display:block; }
  .ad-modal__ft{ padding:10px 18px; border-top:1px solid var(--ad-line,#e5eae8); display:flex; justify-content:flex-end; gap:8px; }
  @media (prefers-reduced-motion:no-preference){ .ad-modal.is-open .ad-modal__box{ animation:adModalIn .18s ease both; } }
  @keyframes adModalIn{ from{ opacity:0; transform:translate(-50%,-46%);} to{ opacity:1; transform:translate(-50%,-50%);} }
</style>

<div class="ad-modal" id="adModal" role="dialog" aria-modal="true" aria-labelledby="adModalTtl" aria-hidden="true">
  <div class="ad-modal__scrim" data-modal-close></div>
  <div class="ad-modal__box" role="document">
    <div class="ad-modal__hd">
      <h2 class="ad-modal__ttl" id="adModalTtl">Details</h2>
      <a class="ad-modal__x" id="adModalOpen" href="#" target="_blank" rel="noopener" title="Open in a new tab" style="display:none;text-decoration:none;text-align:center">↗</a>
      <button type="button" class="ad-modal__x" data-modal-close aria-label="Close">×</button>
    </div>
    <div class="ad-modal__body" id="adModalBody" tabindex="-1"></div>
  </div>
</div>

<script nonce="{{ csp_nonce }}">
(function(){
  var modal = document.getElementById('adModal');
  if(!modal || modal.dataset.wired) return;
  modal.dataset.wired = '1';
  var body    = document.getElementById('adModalBody');
  var titleEl = document.getElementById('adModalTtl');
  var openTab = document.getElementById('adModalOpen');
  var lastFocus = null;

  function close(){
    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden','true');
    document.body.style.overflow = '';
    body.innerHTML = '';
    openTab.style.display = 'none';
    if(lastFocus && lastFocus.focus) lastFocus.focus();
  }
  function open(title, render, externalUrl){
    lastFocus = document.activeElement;
    titleEl.textContent = title || 'Details';
    body.className = 'ad-modal__body';
    body.innerHTML = '';
    render(body);
    if(externalUrl){ openTab.href = externalUrl; openTab.style.display = ''; } else { openTab.style.display = 'none'; }
    modal.classList.add('is-open');
    modal.setAttribute('aria-hidden','false');
    document.body.style.overflow = 'hidden';
    body.focus();
  }

  // Public API for pages that build content programmatically.
  //   text()  — safe: rendered via textContent.
  //   html()  — CONTRACT: `html` MUST already be server-sanitized (Twig
  //             `|sanitize_html`, the platform's allowlist filter). The
  //             declarative data-view-html triggers always pass sanitized
  //             output; never hand this raw user input.
  //   media() — safe: sets img.src / iframe.src, never innerHTML.
  window.agAdminModal = {
    text: function(title, text){ open(title, function(el){ el.textContent = text || ''; }); },
    html: function(title, html){ open(title, function(el){ el.className = 'ad-modal__body is-rich'; el.innerHTML = html || ''; }); },
    media: function(title, url, mime){
      open(title, function(el){
        el.className = 'ad-modal__body is-media';
        var isImg = (mime||'').indexOf('image/') === 0 || /\.(png|jpe?g|webp|gif)(\?|$)/i.test(url);
        if(isImg){ var img = document.createElement('img'); img.className='ad-modal__img'; img.alt = title||''; img.src = url; el.appendChild(img); }
        else { var f = document.createElement('iframe'); f.className='ad-modal__frame'; f.title = title||'Preview'; f.src = url; el.appendChild(f); }
      }, url);
    }
  };

  // Declarative triggers — any element with data-view-* opens the modal.
  document.addEventListener('click', function(e){
    var t = e.target.closest('[data-view-text],[data-view-html],[data-view-media]');
    if(t){
      e.preventDefault();
      var title = t.getAttribute('data-view-title') || 'Details';
      if(t.hasAttribute('data-view-media'))      agAdminModal.media(title, t.getAttribute('data-view-media'), t.getAttribute('data-view-mime')||'');
      else if(t.hasAttribute('data-view-html'))  agAdminModal.html(title, t.getAttribute('data-view-html'));
      else                                       agAdminModal.text(title, t.getAttribute('data-view-text'));
      return;
    }
    if(e.target.closest('[data-modal-close]')) close();
  });
  document.addEventListener('keydown', function(e){ if(e.key === 'Escape' && modal.classList.contains('is-open')) close(); });
})();
</script>
