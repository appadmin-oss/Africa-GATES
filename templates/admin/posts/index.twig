{% extends "admin/layout.twig" %}
{% block topbar_title %}Blog Posts{% endblock %}
{% block topbar_actions %}<a class="ad-btn ad-btn--primary" href="/admin/posts/new">+ New Post</a>{% endblock %}
{% block content %}
<div class="ad-card"><div class="ad-table-wrap">
  <table class="ad-table">
    <thead><tr><th>Post</th><th>Tag</th><th>Published</th><th>Status</th><th class="col-actions">Actions</th></tr></thead>
    <tbody>
      {% for r in rows %}
      <tr>
        <td><strong>{{ r.title }}</strong><div style="font-size:12px;color:var(--ad-text-soft)">/blog/{{ r.slug }}</div></td>
        <td>{% if r.tag %}<span class="ad-chip ad-chip--grey">{{ r.tag }}</span>{% else %}—{% endif %}</td>
        <td style="font-family:'Space Mono',monospace;font-size:12px">{{ r.published_at|date('Y-m-d') }}</td>
        <td>
          {% set chip = {'published':'green','draft':'gold'}[r.status]|default('grey') %}
          <span class="ad-chip ad-chip--{{ chip }}">{{ r.status|capitalize }}</span>
        </td>
        <td class="col-actions">
          <a class="ad-btn ad-btn--sm" href="/admin/posts/{{ r.id }}">Edit</a>
          <form method="post" action="/admin/posts/{{ r.id }}/delete" style="display:inline"><input type="hidden" name="_token" value="{{ csrf_token }}"><button class="ad-btn ad-btn--sm ad-btn--danger" type="submit" data-confirm="Delete this post?">×</button></form>
        </td>
      </tr>
      {% else %}<tr><td colspan="5" style="text-align:center;color:var(--ad-text-mute);padding:30px">No posts yet.</td></tr>{% endfor %}
    </tbody>
  </table>
</div></div>
{% endblock %}
