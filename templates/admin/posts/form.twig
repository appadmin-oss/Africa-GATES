{% extends "admin/layout.twig" %}
{% block topbar_title %}{{ is_new ? 'New Post' : 'Edit Post' }}{% endblock %}
{% block content %}
<div class="ad-card" style="max-width:820px">
  <form method="post" action="{{ is_new ? '/admin/posts/new' : '/admin/posts/' ~ row.id }}" class="ad-form">
    <input type="hidden" name="_token" value="{{ csrf_token }}">
    <div class="ad-form__row">
      <label>Title *<input type="text" name="title" value="{{ row.title|default('') }}" required></label>
      <label>Slug <small>(blank = from title)</small><input type="text" name="slug" value="{{ row.slug|default('') }}" placeholder="auto"></label>
    </div>
    <label>Excerpt <small>(card + meta description)</small><textarea name="excerpt" rows="2" maxlength="400">{{ row.excerpt|default('') }}</textarea></label>
    <label>Body <small>(HTML — &lt;p&gt;, &lt;h2&gt;, &lt;a&gt;)</small><textarea name="body" rows="14" style="font-family:'Space Mono',monospace;font-size:12.5px">{{ row.body|default('') }}</textarea></label>
    <div class="ad-form__row">
      <label>Cover image URL<input type="url" name="cover_image" value="{{ row.cover_image|default('') }}" placeholder="https://…"></label>
      <label>Tag<input type="text" name="tag" value="{{ row.tag|default('') }}" placeholder="Announcements"></label>
    </div>
    <div class="ad-form__row">
      <label>Author<input type="text" name="author" value="{{ row.author|default('Africa GATES Editorial') }}"></label>
      <label>Published at<input type="datetime-local" name="published_at" value="{{ row.published_at|default('')|replace({' ':'T'})|slice(0,16) }}"></label>
    </div>
    <label>Status
      <select name="status">
        <option value="published" {% if row.status|default('draft') == 'published' %}selected{% endif %}>Published</option>
        <option value="draft" {% if row.status|default('draft') == 'draft' %}selected{% endif %}>Draft</option>
      </select>
    </label>
    <div class="ad-form__actions">
      <button class="ad-btn ad-btn--primary" type="submit">Save post</button>
      <a class="ad-btn" href="/admin/posts">Cancel</a>
    </div>
  </form>
</div>
{% endblock %}
