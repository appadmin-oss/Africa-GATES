{% extends "admin/layout.twig" %}
{% block topbar_title %}Support queue{% endblock %}

{#
  THE QUEUE.

  Ordered by LAST ACTIVITY, not by creation — a ticket somebody replied to an hour
  ago is live, and a three-week-old one nobody has touched is a different problem.
  Sorting by created_at, the obvious choice, buries every active conversation under
  the backlog.

  A table, not cards. Thirty rows scanned for "which of these is oldest and still
  unanswered" is exactly what a table is for, and a card grid makes that comparison
  impossible by putting the timestamps in different places on every row.
#}

{% block head_styles %}
<style nonce="{{ csp_nonce }}">
  .sq-tabs{ display:flex; gap:8px; flex-wrap:wrap; margin-bottom:16px; }
  .sq-tab{ display:inline-flex; align-items:center; gap:7px; padding:8px 15px; border-radius:999px;
    border:1px solid rgba(16,41,44,.14); background:#fff; color:#4a5256; text-decoration:none;
    font-size:13px; font-weight:600; }
  .sq-tab.is-on{ background:#10292C; border-color:#10292C; color:#fff; }
  .sq-tab span{ font-size:11.5px; opacity:.75 }

  .sq-search{ display:flex; gap:8px; margin-bottom:16px; }
  .sq-search input{ flex:1; max-width:340px; border:1px solid rgba(16,41,44,.16); border-radius:10px;
    padding:10px 13px; font-family:inherit; font-size:13.5px; outline:none; }
  .sq-search input:focus{ border-color:#3f9c3c }
  .sq-search button{ cursor:pointer; border:none; background:#10292C; color:#fff; font-family:inherit;
    font-weight:600; font-size:13.5px; padding:10px 18px; border-radius:10px; }

  .sq-wrap{ background:#fff; border:1px solid rgba(16,41,44,.09); border-radius:14px; overflow:hidden; }
  /* The table scrolls inside its own box. The page body must never scroll
     sideways, and a reference plus a subject plus three timestamps will exceed a
     laptop at some zoom level. */
  .sq-scroll{ overflow-x:auto; }
  table.sq{ width:100%; border-collapse:collapse; min-width:760px; }
  .sq th{ text-align:left; font:600 10.5px/1 var(--ag-font-body,inherit); letter-spacing:.08em;
    text-transform:uppercase; color:#5a6d6f; padding:12px 14px; background:#f7f9f7;
    border-bottom:1px solid rgba(16,41,44,.09); white-space:nowrap; }
  .sq td{ padding:13px 14px; border-bottom:1px solid rgba(16,41,44,.06); font-size:13.5px; color:#39464a; vertical-align:top; }
  .sq tr:last-child td{ border-bottom:none }
  .sq tr:hover td{ background:#fafcfa }
  .sq__ref{ font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:12px; white-space:nowrap; }
  .sq__ref a{ color:#177015; text-decoration:none; font-weight:600 }
  .sq__subj{ font-weight:600; color:#10292C; }
  .sq__who{ font-size:12px; color:#5a6d6f; margin-top:3px; }
  .sq__when{ white-space:nowrap; font-size:12.5px; color:#5a6d6f; }

  .sq-pill{ display:inline-block; font:700 10px/1 var(--ag-font-body,inherit); letter-spacing:.05em;
    text-transform:uppercase; padding:5px 9px; border-radius:999px; white-space:nowrap; }
  .sq-pill--open{ background:#fff8df; color:#7a5600 }
  .sq-pill--answered{ background:#e8f1f7; color:#1c5a86 }
  .sq-pill--resolved{ background:#eef7ee; color:#1a6118 }
  /* Severity is the one thing that must survive a fast scan of thirty rows. */
  .sq-pill--urgent{ background:#fdf3f3; color:#8a2020 }

  .sq-empty{ padding:44px 20px; text-align:center; color:#5a6d6f; font-size:14px; }
  .sq-page{ display:flex; align-items:center; justify-content:space-between; gap:12px; margin-top:14px; font-size:13px; color:#5a6d6f; }
  .sq-page a{ color:#177015; text-decoration:none; font-weight:600 }
</style>
{% endblock %}

{% block content %}

<div class="sq-tabs">
  {% for key, label in {'open':'Open','answered':'Answered','resolved':'Resolved','all':'All'} %}
    <a class="sq-tab {% if status == key %}is-on{% endif %}" href="/admin/support?status={{ key }}">
      {{ label }} <span>{{ counts[key]|default(0) }}</span>
    </a>
  {% endfor %}
</div>

<form class="sq-search" method="get" action="/admin/support">
  <input type="hidden" name="status" value="{{ status }}">
  <input type="search" name="q" value="{{ q }}" placeholder="Reference, subject, name or email…" aria-label="Search tickets">
  <button type="submit">Search</button>
  {% if q %}<a class="sq-tab" href="/admin/support?status={{ status }}">Clear</a>{% endif %}
</form>

<div class="sq-wrap">
  {% if tickets %}
    <div class="sq-scroll">
      <table class="sq">
        <thead>
          <tr>
            <th>Ticket</th>
            <th>Subject</th>
            <th>Status</th>
            <th>Replies</th>
            <th>Last activity</th>
            <th>Opened</th>
          </tr>
        </thead>
        <tbody>
          {% for t in tickets %}
            <tr>
              <td class="sq__ref"><a href="/admin/support/{{ t.reference }}">{{ t.reference }}</a></td>
              <td>
                <div class="sq__subj">{{ t.subject }}</div>
                <div class="sq__who">
                  {{ t.name ?: 'Someone' }}{% if t.email %} · {{ t.email }}{% endif %}
                  {% if t.severity == 'urgent' %}
                    &nbsp;<span class="sq-pill sq-pill--urgent">urgent</span>
                  {% endif %}
                </div>
              </td>
              <td><span class="sq-pill sq-pill--{{ t.status }}">{{ t.status }}</span></td>
              <td>{{ replies[t.id]|default(0) }}</td>
              <td class="sq__when">{{ t.last_activity ?: '—' }}</td>
              <td class="sq__when">{{ t.created_at }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% else %}
    <div class="sq-empty">
      {% if q %}Nothing matches “{{ q }}”.{% else %}No {{ status == 'all' ? '' : status }} tickets.{% endif %}
    </div>
  {% endif %}
</div>

{% if pages > 1 %}
  <div class="sq-page">
    <span>Page {{ page }} of {{ pages }} · {{ total }} ticket{{ total == 1 ? '' : 's' }}</span>
    <span>
      {% if page > 1 %}<a href="/admin/support?status={{ status }}&q={{ q|url_encode }}&page={{ page - 1 }}">← Previous</a>{% endif %}
      {% if page < pages %}&nbsp;&nbsp;<a href="/admin/support?status={{ status }}&q={{ q|url_encode }}&page={{ page + 1 }}">Next →</a>{% endif %}
    </span>
  </div>
{% endif %}

{% endblock %}
