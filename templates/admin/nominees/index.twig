{% extends "admin/layout.twig" %}
{% block topbar_title %}Nominees{% endblock %}
{% block head_styles %}<link rel="stylesheet" href="{{ asset('/assets/css/console/manage.css') }}">{% endblock %}
{% block content %}
<form class="ad-filters" method="get" action="/admin/nominees" style="display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap">
  <input type="search" name="q" value="{{ filters.q }}" placeholder="Name, organisation or short line…" aria-label="Search nominees">
  <select name="cycle" aria-label="Filter by cycle">
    <option value="">All cycles</option>
    {% for c in cycles %}<option value="{{ c.id }}" {% if filters.cycle == c.id %}selected{% endif %}>{{ c.title }} · {{ c.year }}</option>{% endfor %}
  </select>
  {% if categories %}
  <select name="category" aria-label="Filter by category">
    <option value="">All categories</option>
    {% for c in categories %}<option value="{{ c.id }}" {% if filters.category == c.id %}selected{% endif %}>{{ c.title }}{% if not filters.cycle %} · {{ c.programme }} {{ c.year }}{% endif %}</option>{% endfor %}
  </select>
  {% endif %}
  <select name="status" aria-label="Filter by status">
    <option value="">All statuses</option>
    {% for s in statuses %}<option value="{{ s }}" {% if filters.status == s %}selected{% endif %}>{{ s|capitalize|replace({'_':' '}) }}</option>{% endfor %}
  </select>
  <select name="sort" aria-label="Order the list">
    {% for k, label in {'votes': 'Most votes first', 'name': 'Name, A to Z', 'newest': 'Newest first'} %}<option value="{{ k }}" {% if filters.sort == k %}selected{% endif %}>{{ label }}</option>{% endfor %}
  </select>
  {% include 'admin/partials/datefields.twig' with {range: filters.range, from: filters.from, to: filters.to} only %}
  <button class="ad-btn ad-btn--primary" type="submit">Filter</button>
  {% if filters.q or filters.cycle or filters.category or filters.status or filters.sort != 'votes' or (filters.range not in ['','all']) or filters.from or filters.to %}<a class="ad-btn" href="/admin/nominees">Clear</a>{% endif %}
</form>

{% if total is defined %}
<div class="nm-sum">
  <p role="status">{{ total|number_format }} nominee{{ total == 1 ? '' : 's' }}{% if pages > 1 %} · page {{ page }} of {{ pages }}{% endif %}</p>
  {# How many in each state, under the other filters — the "needs attention" number is
     the pending one, and it should not take a click to learn it. #}
  <nav class="nm-states" aria-label="Show by status">
    {% for s in statuses %}{% set k = counts[s]|default(0) %}
      <a href="?{{ export_qs ? export_qs ~ '&' : '' }}status={{ s }}" {% if filters.status == s %}aria-current="true"{% endif %}>{{ s|capitalize|replace({'_':' '}) }} <span class="nm-states__n">{{ k|number_format }}</span></a>
    {% endfor %}
  </nav>
  <a class="ad-btn ad-btn--sm" href="/admin/nominees/export.csv{{ export_qs ? '?' ~ export_qs : '' }}" download>Download this list (CSV)</a>
</div>
{% endif %}

{# BULK: approve, or send back to pending, every ticked row in one press. The ticks live
   in the rows and join this form through form="bulkForm" — a form inside the table would
   nest inside each row's own action forms, and the parser silently drops a nested form. #}
<form id="bulkForm" class="nm-bulk" method="post" action="/admin/nominees/bulk">
  <input type="hidden" name="_token" value="{{ csrf_token }}">
  <span class="nm-bulk__n" data-nm-picked aria-live="polite">None ticked</span>
  <label for="nm-bulk-act" class="sr-only">With the ticked nominees</label>
  <select id="nm-bulk-act" name="bulk_action">
    <option value="approve">Approve</option>
    <option value="pending">Return to pending</option>
  </select>
  <button class="ad-btn ad-btn--sm ad-btn--primary" type="submit">Apply to ticked</button>
  <span class="nm-bulk__note">Crowning a winner is never a bulk action — it is in each row's More menu.</span>
</form>

<p style="margin:0 0 12px;font-size:13px"><a href="/admin/nominees/duplicates">Duplicates and people counts</a> — who is entered twice, who stands in several categories, and how many people (not entries) were nominated and voted.</p>
{% if admin_role in ['superadmin','admin'] %}
{# Merge duplicates: tick the rows that are the same person, choose which one to
   KEEP, then merge — votes + judge scores fold together. The inputs live in the
   rows but belong to this form via form="mergeForm" (so they don't nest inside
   the per-row action forms). All merged nominees must be in one category. #}
<form id="mergeForm" method="post" action="/admin/nominees/merge"
      style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin:0 0 12px;padding:10px 14px;background:var(--cn-panel);border:1px solid var(--cn-line-card);border-radius:10px">
  <input type="hidden" name="_token" value="{{ csrf_token }}">
  <strong style="font-size:13px">Merge duplicates</strong>
  {# The tick and "keep" columns are only in the way until somebody is merging, so with
     script they appear on demand (console-ux.js, data-ux-reveal · .ux-when-on); without
     script they simply show, as before. #}
  <button class="ad-btn ad-btn--sm" type="button" data-ux-reveal="#nmTable, #mergeForm" aria-expanded="false" hidden>Choose rows to merge</button>
  <span class="ux-when-on" style="font-size:12px;color:var(--cn-ink-3)">Tick the duplicate rows, pick one to <em>keep</em>, then:</span>
  <button class="ad-btn ad-btn--sm ad-btn--primary ux-when-on" type="submit"
          data-confirm="Merge the ticked nominees into the one marked “keep”? Their votes and judge scores will be combined and the duplicates hidden. You can undo it from Duplicates → Recently merged.">Merge selected</button>
  <button class="ad-btn ad-btn--sm" type="button" id="dupScanBtn" style="margin-left:auto">Scan for duplicates</button>
</form>
<div id="dupScanPanel" aria-live="polite" style="margin:0 0 12px"></div>
{% endif %}

<div class="ad-card"><div class="ad-table-wrap">
  <table class="ad-table nm-table" id="nmTable">
    <thead><tr><th scope="col" class="nm-pick"><input type="checkbox" data-nm-all aria-label="Tick every nominee on this page"></th>{% if admin_role in ['superadmin','admin'] %}<th scope="col" class="nm-merge ux-when-on">Merge</th>{% endif %}<th scope="col">Nominee</th><th scope="col">Programme · Category</th><th scope="col">Country</th><th scope="col">Votes</th><th scope="col">Profile (CPI link)</th><th scope="col">Status</th><th scope="col" class="col-actions">Actions</th></tr></thead>
    <tbody>
      {% for r in rows %}
      <tr>
        <td class="nm-pick"><input type="checkbox" name="ids[]" value="{{ r.id }}" form="bulkForm" aria-label="Tick {{ r.name }}"></td>
        {% if admin_role in ['superadmin','admin'] %}
        <td class="nm-merge ux-when-on" style="white-space:nowrap">
          <label style="display:inline-flex;align-items:center;gap:4px;font-size:11px;color:var(--cn-ink-3)" title="Include in a merge">
            <input type="checkbox" name="merge_ids[]" value="{{ r.id }}" form="mergeForm" aria-label="Select {{ r.name }} for merge">
          </label>
          <label style="display:inline-flex;align-items:center;gap:4px;font-size:11px;color:var(--cn-ink-3)" title="Keep this one as the survivor">
            <input type="radio" name="keep_id" value="{{ r.id }}" form="mergeForm" aria-label="Keep {{ r.name }} as the merge survivor"> keep
          </label>
        </td>
        {% endif %}
        <td>
          <div style="display:flex;gap:10px;align-items:center">
            {% if r.photo_path %}
              <img src="{{ r.photo_path|media_url('avatar') }}" alt="Photo of {{ r.name }}" width="40" height="40" loading="lazy" style="width:40px;height:40px;border-radius:8px;object-fit:cover;border:1px solid var(--cn-line-card);flex:none">
            {% else %}
              <span aria-hidden="true" style="width:40px;height:40px;border-radius:8px;background:var(--cn-panel);border:1px solid var(--cn-line-card);display:flex;align-items:center;justify-content:center;font-weight:700;color:var(--cn-soft);flex:none">{{ r.name|first|upper }}</span>
            {% endif %}
            <div><a href="/admin/nominees/{{ r.id }}/edit"><strong>{{ r.name }}</strong></a><div style="font-size:12px;color:var(--cn-ink-3)">{{ r.tagline }}</div></div>
          </div>
        </td>
        <td>{{ r.programme }} · {{ r.category }}<div style="font-size:11px;color:var(--cn-soft)">Cycle {{ r.year }}</div></td>
        <td><span style="font-family:'Space Mono',monospace">{{ r.country_code|default('—') }}</span></td>
        <td><strong style="font-family:'Space Mono',monospace">{{ r.vote_count|number_format }}</strong></td>
        <td>
          {% if r.profile_id %}
            <a href="/registry/{{ r.profile_slug }}" target="_blank" rel="noopener noreferrer" style="font-size:12px">{{ r.profile_name }}<span class="sr-only"> (opens in a new tab)</span></a>
            {% if admin_role in ['superadmin','admin'] %}
            <form method="post" action="/admin/nominees/{{ r.id }}/link" style="display:inline">
              <input type="hidden" name="_token" value="{{ csrf_token }}"><input type="hidden" name="profile_slug" value="">
              <button class="ad-btn ad-btn--xs ad-btn--danger" type="submit" title="Unlink">unlink</button>
            </form>
            {% endif %}
          {% elseif admin_role in ['superadmin','admin'] %}
            <form method="post" action="/admin/nominees/{{ r.id }}/link" style="display:flex;gap:4px">
              <input type="hidden" name="_token" value="{{ csrf_token }}">
              <input type="text" name="profile_slug" placeholder="profile slug" aria-label="Profile slug" style="width:110px;font-size:12px;padding:2px 6px">
              <button class="ad-btn ad-btn--xs" type="submit">Link</button>
            </form>
          {% else %}
            <span style="font-size:12px;color:var(--cn-soft)">—</span>
          {% endif %}
        </td>
        <td>
          {% set chip = {'winner':'gold','runner_up':'blue','approved':'green','pending':'grey'}[r.status]|default('grey') %}
          <span class="ad-chip ad-chip--{{ chip }}">{{ r.status|replace({'_':' '})|capitalize }}</span>
        </td>
        <td class="col-actions">
          <a class="ad-btn ad-btn--xs" href="/admin/nominees/{{ r.id }}/edit" aria-label="Edit {{ r.name }}">Edit</a>
          {% set photo_count = r.photos|default([])|length %}
          <details class="ad-photo-edit" style="display:inline-block;margin-bottom:4px">
            <summary class="ad-btn ad-btn--xs" style="list-style:none;cursor:pointer">{{ photo_count > 0 ? '🖼 Photos (' ~ photo_count ~ ')' : '＋ Photo' }}</summary>
            <div style="margin-top:6px;padding:8px;border:1px solid var(--cn-line-card);border-radius:8px;background:var(--cn-panel);width:230px">
              {% if photo_count > 0 %}
              <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:8px">
                {% for ph in r.photos %}
                {% set is_primary = (ph == r.photo_path) %}
                <div style="width:64px;text-align:center">
                  <img src="{{ ph }}" alt="Photo {{ loop.index }} of {{ r.name }}" width="64" height="64" loading="lazy"
                       style="width:64px;height:64px;object-fit:cover;border-radius:7px;border:2px solid {{ is_primary ? 'var(--cn-ink)' : 'var(--cn-line-card)' }}">
                  {% if is_primary %}
                    <div style="font-size:10px;font-weight:700;color:var(--cn-ink);margin-top:2px">★ Primary</div>
                  {% else %}
                    <form method="post" action="/admin/nominees/{{ r.id }}/photo/primary" style="margin-top:2px">
                      <input type="hidden" name="_token" value="{{ csrf_token }}"><input type="hidden" name="path" value="{{ ph }}">
                      <button class="ad-btn ad-btn--xs" type="submit" style="font-size:10px;padding:1px 5px" title="Make primary">Set ★</button>
                    </form>
                  {% endif %}
                  <form method="post" action="/admin/nominees/{{ r.id }}/photo/delete" style="margin-top:2px">
                    <input type="hidden" name="_token" value="{{ csrf_token }}"><input type="hidden" name="path" value="{{ ph }}">
                    <button class="ad-btn ad-btn--xs ad-btn--danger" type="submit" style="font-size:10px;padding:1px 5px" data-confirm="Remove this photo from {{ r.name }}? It comes off their public profile immediately and would have to be uploaded again." title="Remove">×</button>
                  </form>
                </div>
                {% endfor %}
              </div>
              {% endif %}
              <form method="post" action="/admin/nominees/{{ r.id }}/photo" enctype="multipart/form-data" style="display:flex;flex-direction:column;gap:6px">
                <input type="hidden" name="_token" value="{{ csrf_token }}">
                {% include 'partials/photo-upload.twig' with {id: 'photo-' ~ r.id, label: 'Add a nominee photo', required: true, min_side: 200} only %}
                <button class="ad-btn ad-btn--xs ad-btn--primary" type="submit">Upload</button>
              </form>
            </div>
          </details>
          {% if admin_role in ['superadmin','admin'] %}
          {#
            UNDER "MORE", AND NEVER ONE PRESS. Winner and Runner-up used to be bare buttons
            in every row: one stray tap on a dense list crowned somebody, with nothing to
            say who or why. They confirm with a reason now (it lands on the audit row), and
            they sit behind More with Delete so the row's visible controls are the ones
            used every day.
          #}
          <details class="cn-more">
            <summary class="ad-btn ad-btn--xs" aria-label="More actions for {{ r.name }}">More</summary>
            <div class="cn-more__menu">
              {% if r.status != 'winner' %}<form method="post" action="/admin/nominees/{{ r.id }}/winner"><input type="hidden" name="_token" value="{{ csrf_token }}"><button class="cn-more__i" type="submit" data-confirm="Mark {{ r.name }} as the winner of {{ r.category }}? Their status becomes Winner wherever it is shown, and the reason you give is kept on the audit log.">Mark as winner</button></form>{% endif %}
              {% if r.status != 'runner_up' %}<form method="post" action="/admin/nominees/{{ r.id }}/runner_up"><input type="hidden" name="_token" value="{{ csrf_token }}"><button class="cn-more__i" type="submit" data-confirm="Mark {{ r.name }} as runner-up in {{ r.category }}? Their status becomes Runner-up wherever it is shown, and the reason you give is kept on the audit log.">Mark as runner-up</button></form>{% endif %}
              <form method="post" action="/admin/nominees/{{ r.id }}/delete"><input type="hidden" name="_token" value="{{ csrf_token }}"><button class="cn-more__i cn-more__i--danger" type="submit" data-confirm="Delete {{ r.name }}? Their votes and judge scores are deleted with them. This cannot be undone — use Merge instead if this is a duplicate.">Delete…</button></form>
            </div>
          </details>
          {% endif %}
        </td>
      </tr>
      {% else %}<tr><td colspan="9" style="text-align:center;color:var(--cn-soft);padding:30px">No nominees.</td></tr>{% endfor %}
    </tbody>
  </table>
</div></div>

{% if pages is defined and pages > 1 %}
{# `qs` is built by the controller (Filters::qs, url-encoded, every filter kept). This used to
   be rebuilt here by hand, which dropped the date range and did not escape the search. #}
<div class="ad-pager">
  {% if page > 1 %}<a href="?page={{ page - 1 }}{{ qs }}" rel="prev">← Prev</a>{% endif %}
  {% for p in 1..pages %}
    {% if p == page %}<span class="is-current">{{ p }}</span>
    {% elseif p == 1 or p == pages or (p >= page - 2 and p <= page + 2) %}<a href="?page={{ p }}{{ qs }}">{{ p }}</a>
    {% elseif p == page - 3 or p == page + 3 %}<span class="ad-pager__gap">…</span>
    {% endif %}
  {% endfor %}
  {% if page < pages %}<a href="?page={{ page + 1 }}{{ qs }}" rel="next">Next →</a>{% endif %}
</div>
{% endif %}

{# Merges are undone in one place — Duplicates → Recently merged — not two. #}
{% if admin_role in ['superadmin','admin'] and merged is defined and merged|length %}
<p style="margin:18px 0 0"><a class="ad-btn ad-btn--sm" href="/admin/nominees/duplicates?tab=merged">Recently merged · {{ merged|length }}</a></p>
{% endif %}

<script nonce="{{ csp_nonce }}" data-nav="rerun">
/* Tick-all and the running count for the bulk bar. Bound to this page's own elements only,
   so it is safe to run again on every console swap (ConsoleNavTest). */
(function () {
  var all = document.querySelector('[data-nm-all]');
  var out = document.querySelector('[data-nm-picked]');
  var boxes = function () { return Array.prototype.slice.call(document.querySelectorAll('input[name="ids[]"][form="bulkForm"]')); };
  if (!out) return;
  function count() {
    var b = boxes(), n = b.filter(function (x) { return x.checked; }).length;
    out.textContent = n === 0 ? 'None ticked' : n + ' ticked';
    if (all) { all.checked = n > 0 && n === b.length; all.indeterminate = n > 0 && n < b.length; }
  }
  if (all) all.addEventListener('change', function () { boxes().forEach(function (x) { x.checked = all.checked; }); count(); });
  boxes().forEach(function (x) { x.addEventListener('change', count); });
  count();
})();
</script>
{% if admin_role in ['superadmin','admin'] %}
<script nonce="{{ csp_nonce }}" data-nav="rerun">
/* AI-assisted duplicate scan: fetch likely-same-person nominee groups for the
   selected cycle and render each as a one-click merge form. Deterministic
   groups always appear; AI-refined ones too when a provider is configured. */
(function () {
  var btn = document.getElementById('dupScanBtn');
  var panel = document.getElementById('dupScanPanel');
  if (!btn || !panel) return;
  var csrf = (document.querySelector('meta[name="csrf-token"]') || {}).content || '';
  var cycle = {{ (filters.cycle|default(0)) ?: 0 }};

  function esc(s) { var d = document.createElement('div'); d.textContent = (s == null ? '' : String(s)); return d.innerHTML; }

  /* WHICH nominee survives is now the admin's choice, on the evidence.
     It used to be nominee_ids[0] — after sorting, the LOWEST ID, i.e. the oldest
     row, picked for no reason connected to its quality. A merge keeps the
     survivor's name, photo and profile link, so that silently discarded the better
     record whenever the good entry happened to be the newer one. The server
     recommends (keep_id) and a radio per member lets it be changed. */
  function groupForm(g, gi) {
    var members = g.members || (g.nominee_ids || []).map(function (id, i) {
      return { id: id, name: (g.names || [])[i] || '', votes: 0, country: '', has_photo: false, linked: false, status: '' };
    });
    var keep = g.keep_id || members[0].id;
    var name = 'keep_' + gi;

    var rows = members.map(function (m) {
      var facts = [];
      if (m.votes)     facts.push(m.votes.toLocaleString() + ' vote' + (m.votes === 1 ? '' : 's'));
      if (m.country)   facts.push(m.country);
      if (m.has_photo) facts.push('photo');
      if (m.linked)    facts.push('linked profile');
      if (m.status && m.status !== 'approved') facts.push(m.status.replace('_', ' '));
      var id = name + '_' + m.id;
      return '<label for="' + id + '" style="display:flex;gap:8px;align-items:baseline;padding:4px 0;cursor:pointer">'
        + '<input type="radio" id="' + id + '" name="' + name + '" value="' + parseInt(m.id, 10) + '"'
        + (m.id === keep ? ' checked' : '') + ' style="flex:none;margin-top:3px">'
        + '<span style="font-size:13px">' + esc(m.name)
        + (facts.length ? '<br><small style="color:var(--cn-soft)">' + esc(facts.join(' · ')) + '</small>' : '')
        + '</span></label>';
    }).join('');

    var hidden = '<input type="hidden" name="_token" value="' + esc(csrf) + '">'
               + '<input type="hidden" name="keep_id" value="' + parseInt(keep, 10) + '">';
    members.forEach(function (m) { hidden += '<input type="hidden" name="merge_ids[]" value="' + parseInt(m.id, 10) + '">'; });

    var conf = Math.round((g.confidence || 0) * 100);
    /* What the AI made of it, said in words: a 97% rule match the AI did not confirm is
       the group most worth a second look, and a bare "rule" label hid that. */
    var verdict = { agrees: 'AI agrees', unconfirmed: 'AI did not confirm', found: 'found by AI' }[g.ai_verdict]
               || (g.source === 'ai' ? 'found by AI' : 'name rules');
    var meta = [g.category, conf + '% match', verdict].filter(Boolean).map(esc).join(' · ');

    return '<form method="post" action="/admin/nominees/merge" data-dup-group style="padding:10px 12px;border:1px solid var(--cn-line-card);border-radius:8px;background:#fff;margin-bottom:8px">'
      + hidden
      + '<fieldset style="border:0;padding:0;margin:0 0 6px">'
      + '<legend style="font-size:12px;color:var(--cn-soft);padding:0">Keep which record? Votes and judge scores combine either way.</legend>'
      + rows
      + '</fieldset>'
      + '<div style="display:flex;gap:10px;align-items:center;justify-content:space-between">'
      + '<small style="color:var(--cn-soft)">' + meta + (g.reason ? ' — ' + esc(g.reason) : '') + '</small>'
      + '<span style="display:flex;gap:6px;flex:none">'
      /* formaction, never a second form element: one opened inside another is dropped by the parser
         and its button posts to the outer action — here, the merge. */
      + '<button class="ad-btn ad-btn--xs" type="submit" formaction="/admin/nominees/not-duplicate">Not the same person</button>'
      + '<button class="ad-btn ad-btn--xs ad-btn--primary" type="submit" data-confirm="Merge these into one nominee? Their votes and judge scores combine; the duplicates are hidden but can be restored with Undo merge.">Merge</button>'
      + '</span>'
      + '</div></form>';
  }

  /* Keep the hidden keep_id in step with the radio. The form posts keep_id, so a
     changed radio that did not update it would merge into the recommendation the
     admin just rejected — silently, and in the direction that loses a record. */
  panel.addEventListener('change', function (e) {
    var r = e.target;
    if (!r || r.type !== 'radio' || r.name.indexOf('keep_') !== 0) return;
    var form = r.closest('form[data-dup-group]');
    if (form) form.querySelector('input[name="keep_id"]').value = r.value;
  });

  btn.addEventListener('click', function () {
    var orig = btn.textContent; btn.disabled = true; btn.textContent = '⏳ Scanning…'; panel.innerHTML = '';
    fetch('/admin/nominees/duplicate-scan' + (cycle ? ('?cycle=' + cycle) : ''), { headers: { 'X-Requested-With': 'fetch', 'Accept': 'application/json' }, credentials: 'same-origin' })
      /* A server fault is not a network error. Read the JSON either way — the error
         handler answers JSON with a reference when it is asked for JSON — and only
         call it the network when nothing came back at all. */
      .then(function (r) {
        return r.json().catch(function () { return { ok: false, error: 'The scan failed on the server (HTTP ' + r.status + '). Nothing was changed.' }; });
      })
      .then(function (j) {
        btn.disabled = false; btn.textContent = orig;
        if (!j.ok) {
          panel.innerHTML = '<p style="color:#b42318;font-size:13px">' + esc(j.error || 'Scan failed.')
            + (j.reference && (j.error || '').indexOf(j.reference) < 0 ? ' Reference ' + esc(j.reference) + '.' : '') + '</p>';
          return;
        }
        /* "No duplicates" must not quietly mean "did not look". The scan reports
           how many nominees it could not reach (skipped, over the per-category cap)
           and how many name groups were too generic to compare (crowded), and both
           are stated here — a clean result over a partial scan is not a clean
           result. */
        var caveats = [];
        if (j.skipped) caveats.push(j.skipped.toLocaleString() + ' nominee' + (j.skipped === 1 ? '' : 's') + ' beyond the per-category scan limit were not checked');
        if (j.crowded) caveats.push(j.crowded + ' name group' + (j.crowded === 1 ? '' : 's') + ' were too generic to compare');
        if (j.ai && j.ai_partial) caveats.push('the AI read part of this cycle (' + j.ai_batches + ' batch' + (j.ai_batches === 1 ? '' : 'es') + ' of names that share a word with another); the name rules read all of it');
        if (!j.ai && j.ai_batches) caveats.push('the AI could not be reached, so only the name rules ran');
        var caveatHtml = caveats.length
          ? '<p style="font-size:12px;color:#8a6d00;margin:6px 0 0">Partial scan: ' + esc(caveats.join('; ')) + '.</p>' : '';

        if (!j.groups || !j.groups.length) {
          panel.innerHTML = '<p style="color:var(--cn-ink-3);font-size:13px">No likely duplicates found'
            + (j.ai ? ' (AI-assisted)' : '') + ' across ' + (j.scanned || 0).toLocaleString() + ' nominees.</p>' + caveatHtml;
          return;
        }
        var head = '<div style="padding:10px 14px;border-left:4px solid var(--cn-ink);background:var(--cn-panel);border-radius:8px">'
          + '<strong style="font-size:13px">' + j.groups.length + ' possible duplicate group' + (j.groups.length === 1 ? '' : 's') + '</strong>'
          + (j.ai ? ' <span style="font-size:11px;color:var(--cn-soft)">· AI-assisted</span>' : '')
          + '<p style="font-size:12px;color:var(--cn-soft);margin:2px 0 10px">Review each. The recommended record to keep is preselected — change it if the other entry is the better one.</p>';
        panel.innerHTML = head + j.groups.map(groupForm).join('') + caveatHtml + '</div>';
      })
      .catch(function () { btn.disabled = false; btn.textContent = orig; panel.innerHTML = '<p style="color:#b42318;font-size:13px">Network error — try again.</p>'; });
  });
})();
</script>
{% endif %}
{% endblock %}
