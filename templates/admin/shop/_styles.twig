{#
  The shop screens' shared styles (shop upgrade, 18 Nov 2026). One copy, included by every new
  shop page, so the order page, stock, till and reports cannot drift into four looks. The
  console CSP has no 'unsafe-inline', hence the nonce. No !important anywhere: a rule that
  needs one is a rule fighting another rule, and the fix is the other rule.
#}
<style nonce="{{ csp_nonce }}">
  .sh-sub{ font-size:13px; color:#5a6d6f; margin:2px 0 18px }
  .sh-grid{ display:grid; gap:14px; grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr)); align-items:start }
  .sh-stat{ display:grid; gap:10px; grid-template-columns:repeat(auto-fit,minmax(min(100%,160px),1fr)); margin-bottom:16px }
  .sh-s{ background:#fff; border:1px solid rgba(16,41,44,.1); border-radius:12px; padding:13px 15px; text-decoration:none; color:inherit; display:block }
  .sh-s__k{ font-size:12px; font-weight:600; color:#5a6d6f }
  .sh-s__v{ font-size:22px; font-weight:700; color:#10292C; margin-top:7px }
  .sh-s__n{ font-size:12px; line-height:1.5; color:#67797b; margin-top:4px }
  .sh-s--alarm{ background:#fdf2f2; border-color:rgba(180,35,24,.28) }
  .sh-s--alarm .sh-s__v{ color:#8a2020 }
  .sh-sec{ background:#fff; border:1px solid rgba(16,41,44,.1); border-radius:14px; padding:18px 20px; margin-bottom:14px }
  .sh-sec h2{ margin:0 0 6px; font-size:15px; color:#10292C }
  .sh-sec p{ margin:6px 0 0; font-size:13px; line-height:1.7; color:#5a6d6f }
  .sh-sec--warn{ border-color:#f3d38a; background:#fffbeb }
  .sh-sec--danger{ border-color:rgba(180,35,24,.28) }
  .sh-row{ display:flex; gap:8px; flex-wrap:wrap; align-items:center; margin-top:10px }
  .sh-row input, .sh-row select, .sh-row textarea, .sh-field input, .sh-field select, .sh-field textarea{ border:1px solid rgba(16,41,44,.18); border-radius:10px; padding:9px 12px; font-family:inherit; font-size:13px; color:#10292C; background:#fff }
  .sh-field{ display:flex; flex-direction:column; gap:5px; margin-top:10px; font-size:12px; font-weight:600; color:#3d4b4d }
  .sh-field textarea{ min-height:70px; resize:vertical }
  .sh-num{ width:84px }
  .sh-grow{ flex:1 1 200px }
  .sh-btn{ cursor:pointer; font-weight:650; font-size:13px; line-height:1; font-family:inherit; border:none; padding:10px 18px; border-radius:999px; background:#10292C; color:#fff; text-decoration:none; display:inline-block }
  .sh-btn--ghost{ background:none; border:1px solid rgba(16,41,44,.2); color:#10292C }
  .sh-btn--danger{ background:#8a2020 }
  .sh-btn--tiny{ padding:7px 13px; font-size:12px }
  .sh-list{ width:100%; border-collapse:collapse; font-size:13px }
  .sh-list th{ text-align:left; font-size:12px; font-weight:600; color:#5a6d6f; padding:0 8px 8px 0 }
  .sh-list td{ padding:10px 8px 10px 0; border-top:1px solid rgba(16,41,44,.07); vertical-align:top }
  .sh-list .is-num{ text-align:right; font-variant-numeric:tabular-nums }
  .sh-list tr.is-short td, .sh-list tr.is-low td{ background:#fdf2f2 }
  .sh-ref{ font-family:var(--ag-font-mono,monospace); font-weight:700; font-size:13px }
  .sh-tag{ font-size:11px; font-weight:700; padding:3px 8px; border-radius:999px; background:rgba(16,41,44,.07); color:#3d4b4d; display:inline-block }
  .sh-tag--ok{ background:#eaf7ea; color:#1c5f1b }
  .sh-tag--wait{ background:#fff8df; color:#6b5312 }
  .sh-tag--no{ background:#fdeaea; color:#8a2020 }
  .sh-muted{ color:#67797b }
  .sh-small{ font-size:12px }
  .sh-warn{ background:#fdf2f2; border:1px solid rgba(180,35,24,.24); color:#8a2020; border-radius:10px; padding:9px 12px; font-size:12px; font-weight:600; margin-top:7px }
  .sh-dl{ display:grid; grid-template-columns:max-content 1fr; gap:6px 16px; font-size:13px; margin:8px 0 0 }
  .sh-dl dt{ color:#5a6d6f }
  .sh-dl dd{ margin:0; color:#10292C }
  .sh-dl .is-total{ font-weight:700 }
  .sh-tl{ list-style:none; margin:8px 0 0; padding:0 }
  .sh-tl li{ border-left:2px solid rgba(16,41,44,.12); padding:0 0 12px 14px; position:relative; font-size:13px; line-height:1.6 }
  .sh-tl li::before{ content:""; position:absolute; left:-5px; top:6px; width:8px; height:8px; border-radius:50%; background:#10292C }
  .sh-tl__meta{ font-size:12px; color:#67797b }
  .sh-pager{ display:flex; gap:8px; align-items:center; justify-content:space-between; margin-top:12px; font-size:13px }
  .sh-check{ width:18px; height:18px }
  .sh-bulk{ display:flex; gap:8px; flex-wrap:wrap; align-items:center; padding:10px 12px; border-radius:12px; background:#f1efe9; margin-bottom:10px }
</style>
