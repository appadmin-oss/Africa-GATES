<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ page_title|default('Admin — Africa GATES') }}</title>
<meta name="csrf-token" content="{{ csrf_token }}">
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%230b1220'/%3E%3Ctext x='32' y='44' text-anchor='middle' font-family='Georgia' font-size='34' font-weight='700' fill='%23f3b416'%3EG%3C/text%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Montserrat:wght@500;600;700;800&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/nprogress@0.2.0/nprogress.css">
<link rel="stylesheet" href="/assets/css/admin.css?v={{ asset_version }}">
{% block head_styles %}{% endblock %}
</head>
<body data-page-admin>

<div class="ad-shell">

  {# Sidebar #}
  <aside class="ad-side" id="adSide">
    <div class="ad-side__brand">
      <span class="mark">G</span>
      <span class="label">Africa GATES<small>Admin Console</small></span>
    </div>

    <nav class="ad-side__group">
      <h6>Overview</h6>
      <a class="ad-side__link {% if admin_page == 'dashboard' %}is-active{% endif %}" href="/admin/dashboard">
        <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9"/><rect x="14" y="3" width="7" height="5"/><rect x="14" y="12" width="7" height="9"/><rect x="3" y="16" width="7" height="5"/></svg>
        Dashboard
      </a>
    </nav>

    <nav class="ad-side__group">
      <h6>Moderation</h6>
      <a class="ad-side__link {% if admin_page == 'profiles' %}is-active{% endif %}" href="/admin/profiles">
        <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        Profiles
      </a>
      <a class="ad-side__link {% if admin_page == 'nominations' %}is-active{% endif %}" href="/admin/nominations">
        <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 15.09 8.26 22 9.27l-5 4.87 1.18 6.88L12 17.77 5.82 21.02 7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        Nominations
      </a>
      <a class="ad-side__link {% if admin_page == 'nominees' %}is-active{% endif %}" href="/admin/nominees">
        <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
        Nominees
      </a>
    </nav>

    <nav class="ad-side__group">
      <h6>Programmes</h6>
      <a class="ad-side__link {% if admin_page == 'programmes' %}is-active{% endif %}" href="/admin/programmes">
        <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        Awards & Cycles
      </a>
      <a class="ad-side__link {% if admin_page == 'judges' %}is-active{% endif %}" href="/admin/judges">
        <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="5"/><path d="M20 21v-2a4 4 0 0 0-3-3.87"/><path d="M4 21v-2a4 4 0 0 1 3-3.87"/></svg>
        Judges Panel
      </a>
    </nav>

    <nav class="ad-side__group">
      <h6>Content</h6>
      <a class="ad-side__link {% if admin_page == 'events' %}is-active{% endif %}" href="/admin/events">
        <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><path d="M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01"/></svg>
        Events
      </a>
      <a class="ad-side__link {% if admin_page == 'posts' %}is-active{% endif %}" href="/admin/posts">
        <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
        Blog Posts
      </a>
      <a class="ad-side__link {% if admin_page == 'legacy' %}is-active{% endif %}" href="/admin/legacy">
        <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>
        Legacy Events
      </a>
      <a class="ad-side__link {% if admin_page == 'opportunities' %}is-active{% endif %}" href="/admin/opportunities">
        <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M16 12l-4-4-4 4"/><path d="M12 16V8"/></svg>
        Opportunities
      </a>
      <a class="ad-side__link {% if admin_page == 'partners' %}is-active{% endif %}" href="/admin/partners">
        <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        Partner Enquiries
      </a>
    </nav>

    {% if admin_role == 'superadmin' %}
    <nav class="ad-side__group">
      <h6>Configuration</h6>
      <a class="ad-side__link {% if admin_page == 'admins' %}is-active{% endif %}" href="/admin/admins">
        <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        Admins
      </a>
      <a class="ad-side__link {% if admin_page == 'settings' %}is-active{% endif %}" href="/admin/settings">
        <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        Settings
      </a>
    </nav>
    {% endif %}

    <div class="ad-side__foot">
      <span class="avatar">{{ admin_name|default('A')|first|upper }}</span>
      <div class="who">
        <div class="n">{{ admin_name|default('Admin') }}</div>
        <div class="e">{{ admin_email|default('') }}</div>
      </div>
      <a href="/admin/logout" class="out" data-tip="Sign out" aria-label="Sign out">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
      </a>
    </div>
  </aside>

  {# Main #}
  <main class="ad-main">

    <div class="ad-topbar">
      <button class="ad-mobile-toggle" id="adMobileToggle" aria-label="Open menu">
        <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <h1 class="ad-h1">
        {% block topbar_eyebrow %}{% endblock %}
        {% block topbar_title %}{{ page_title }}{% endblock %}
      </h1>
      <div class="ad-actions">{% block topbar_actions %}{% endblock %}</div>
    </div>

    {% if flash_ok %}<div class="ad-flash ad-flash--ok">✓ {{ flash_ok }}</div>{% endif %}
    {% if flash_error %}<div class="ad-flash ad-flash--err">⚠ {{ flash_error }}</div>{% endif %}
    {% if flash_notice %}<div class="ad-flash ad-flash--note">ℹ {{ flash_notice }}</div>{% endif %}

    {% block content %}{% endblock %}

  </main>

</div>

<script defer src="https://unpkg.com/@popperjs/core@2"></script>
<script defer src="https://unpkg.com/tippy.js@6"></script>
<script defer src="https://cdn.jsdelivr.net/npm/nprogress@0.2.0/nprogress.min.js"></script>
{% block foot_scripts %}{% endblock %}
<script defer src="/assets/js/admin.js?v={{ asset_version }}"></script>
</body>
</html>
