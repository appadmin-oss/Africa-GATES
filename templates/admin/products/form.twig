{% extends "admin/layout.twig" %}
{% block topbar_title %}{{ is_new ? 'New product' : 'Edit · ' ~ row.name }}{% endblock %}
{% block topbar_actions %}<a class="ad-btn" href="/admin/products">← Back</a>{% endblock %}
{% block content %}
<form class="ad-form" method="post" action="{{ is_new ? '/admin/products/new' : '/admin/products/' ~ row.id }}" enctype="multipart/form-data">
  <input type="hidden" name="_token" value="{{ csrf_token }}">
  <div class="ad-card"><div class="ad-card__body">
    <div class="ad-form">
      <div class="row">
        <div><label for="f-name">Name</label><input type="text" name="name" id="f-name" value="{{ row.name|default('') }}" required></div>
        <div><label for="f-slug">Slug <span style="font-weight:400;color:var(--ad-text-mute)">(auto if blank)</span></label><input type="text" name="slug" id="f-slug" value="{{ row.slug|default('') }}"></div>
      </div>
      <div class="row">
        <div><label for="f-category">Category</label><select name="category" id="f-category">{% for c in categories %}<option value="{{ c }}" {% if row.category == c %}selected{% endif %}>{{ c }}</option>{% endfor %}</select></div>
        <div><label for="f-price_naira">Price (₦)</label><input type="number" name="price_naira" id="f-price_naira" min="0" step="1" value="{{ row.price_naira|default(0) }}" required></div>
      </div>
      <div class="row">
        <div><label for="f-tag">Tag</label><select name="tag" id="f-tag"><option value="">None</option>{% for t in tags %}<option value="{{ t }}" {% if row.tag == t %}selected{% endif %}>{{ t }}</option>{% endfor %}</select></div>
        <div><label for="f-stock">Stock <span style="font-weight:400;color:var(--ad-text-mute)">(blank = untracked)</span></label><input type="number" name="stock" id="f-stock" min="0" step="1" value="{{ row.stock|default('') }}"></div>
        <div><label for="f-sort_order">Sort order</label><input type="number" name="sort_order" id="f-sort_order" step="1" value="{{ row.sort_order|default(0) }}"></div>
      </div>
      <div><label for="f-description">Description</label><textarea name="description" id="f-description" rows="4" placeholder="Materials, fit, what the purchase funds…">{{ row.description|default('') }}</textarea></div>
      <div>
        <label>Cover image</label>
        {% if row.cover_path %}<div style="margin-bottom:8px"><img src="{{ row.cover_path }}" alt="" style="width:90px;height:90px;object-fit:cover;border-radius:10px;border:1px solid var(--ad-line,rgba(16,41,44,.12))"></div>{% endif %}
        <input type="file" name="cover" accept="image/png,image/jpeg,image/webp" aria-label="Cover image file">
        <div style="font-size:12px;color:var(--ad-text-mute);margin-top:4px">PNG / JPG / WebP, min 300×300px. Leave blank to keep the current image.</div>
      </div>
      <div>
        <label>Delivery regions <span style="font-weight:400;color:var(--ad-text-mute)">(none selected = available nationwide)</span></label>
        <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:6px">
          {% for r in regions %}
          <label class="checkbox" style="display:inline-flex;align-items:center;gap:7px;border:1px solid var(--ad-line,rgba(16,41,44,.12));border-radius:9px;padding:8px 12px;font-weight:500"><input type="checkbox" name="delivery_regions[]" value="{{ r }}" {% if r in sel_regions %}checked{% endif %}> {{ r }}</label>
          {% endfor %}
        </div>
      </div>
      <div><label class="checkbox"><input type="checkbox" name="is_active" {% if is_new or row.is_active %}checked{% endif %}> Active — visible in the shop</label></div>
    </div>
  </div></div>
  <div style="display:flex;justify-content:flex-end;gap:10px">
    <a class="ad-btn" href="/admin/products">Cancel</a>
    <button class="ad-btn ad-btn--primary" type="submit">Save product</button>
  </div>
</form>
{% endblock %}
