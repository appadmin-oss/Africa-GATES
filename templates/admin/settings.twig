            </tr></thead>
            <tbody>
            {% for p in ai_probe %}
              <tr>
                <td style="font-weight:600">{{ p.provider|capitalize }}</td>
                <td><code style="font-size:11.5px">{{ p.model ?: '—' }}</code></td>
