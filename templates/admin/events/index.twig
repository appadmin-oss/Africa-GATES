{% extends "admin/layout.twig" %}
{% block topbar_title %}Events{% endblock %}
{% block topbar_actions %}<a class="ad-btn ad-btn--primary" href="/admin/events/new">+ New Event</a>{% endblock %}
{% block content %}
<div class="ad-card"><div class="ad-table-wrap">
  <table class="ad-table">
    <thead><tr><th>Event</th><th>When</th><th>Location</th><th>Status</th><th class="col-actions">Actions</th></tr></thead>
    <tbody>
      {% for r in rows %}
      <tr>
        <td><strong>{{ r.title }}</strong><div style="font-size:12px;color:var(--ad-text-soft)">{{ r.tagline }}</div></td>
        <td style="font-family:'Space Mono',monospace;font-size:12px">{{ r.event_date|date('Y-m-d H:i') }}</td>
        <td>{{ r.location }}</td>
        <td>
          {% set chip = {'published':'green','draft':'gold'}[r.status]|default('grey') %}
          <span class="ad-chip ad-chip--{{ chip }}">{{ r.status|capitalize }}</span>
        </td>
        <td class="col-actions">
          <a class="ad-btn ad-btn--sm" href="/admin/events/{{ r.id }}">Edit</a>
          <form method="post" action="/admin/events/{{ r.id }}/delete" style="display:inline"><input type="hidden" name="_token" value="{{ csrf_token }}"><button class="ad-btn ad-btn--sm ad-btn--danger" type="submit" data-confirm="Delete this event?">×</button></form>
        </td>
      </tr>
      {% else %}<tr><td colspan="5" style="text-align:center;color:var(--ad-text-mute);padding:30px">No events yet.</td></tr>{% endfor %}
    </tbody>
  </table>
</div></div>
{% endblock %}
