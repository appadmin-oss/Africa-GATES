{% extends "admin/layout.twig" %}
{#
  EVENT LEADS — who runs this event, given by staff to a member's email (owner, 29 Oct 2026).
  A lead is not staff: they open "Events I lead" from their own Africa GATES account at /lead,
  never this console. Linked from the event's own page; the role ends with the event.
#}
{% import 'admin/partials/kit.twig' as kit %}
{% block topbar_sub %}Who leads and who works {{ event.title }}. They run it from their own account, not this console. <a href="/admin/events/leads">Every event’s leads</a>{% endblock %}
{% block head_styles %}<link rel="stylesheet" href="{{ asset('/assets/css/console/volunteers.css') }}">{% endblock %}

{% block content %}
{% include 'admin/events/navigation.twig' with {event_id: event.id, current: 'leads'} only %}
{% if flash_ok %}<p class="vl-ok" role="status">{{ flash_ok }}</p>{% endif %}
{% if flash_error %}<div class="cn-error" role="alert"><span class="cn-error__t">That didn’t go through</span><span class="cn-error__m">{{ flash_error }}</span></div>{% endif %}
<section class="cn-card vl-sec" aria-labelledby="ah">
  <h2 class="vl-h" id="ah">Awards presented at this event</h2>
  {% if awards is empty %}
    <p class="vl-help">None. Tick the awards on the <a href="/admin/events/{{ event.id }}">event’s page</a>; they then show on the public event page and decide who can be invited.</p>
  {% else %}
    <ul class="vl-list">{% for a in awards %}<li class="vl-li"><span class="vl-li__t">{{ a.title }}</span><a class="vl-help" href="/awards/{{ a.slug|url_encode }}">Public page</a></li>{% endfor %}</ul>
    <p class="vl-help">Change these on the <a href="/admin/events/{{ event.id }}">event’s page</a>.</p>
  {% endif %}
</section>

<section class="cn-card vl-sec" aria-labelledby="lh">
  <h2 class="vl-h" id="lh">Leads</h2>
  {% if leads is empty %}
    {{ kit.empty('Nobody leads this event yet', 'Give it to somebody below. We email them, and it shows under Events I lead in their account.', 'users') }}
  {% else %}
    <ul class="vl-list">
      {% for l in leads %}
        <li class="vl-li">
          <span class="vl-li__t">{{ l.name }}</span>
          <span class="vl-help">{{ l.email }} · until {{ l.until }}</span>
          <form method="post" action="/admin/events/{{ event.id }}/leads" data-confirm="End {{ l.name }}’s access to this event now? They can no longer see or change its plan, budget or guests.">
            <input type="hidden" name="_token" value="{{ csrf_token }}"><input type="hidden" name="do" value="end"><input type="hidden" name="grant" value="{{ l.id }}">
            <button class="cn-btn" type="submit">End<span class="sr-only">, {{ l.name }}</span></button>
          </form>
        </li>
      {% endfor %}
    </ul>
  {% endif %}
</section>

<section class="cn-card vl-sec" aria-labelledby="oh">
  <h2 class="vl-h" id="oh">Owners</h2>
  <p class="vl-help">An owner decides what this event’s leads propose: its teams and committees, the roles they define and what each may do, and who is put in them. An owner never decides their own proposal; with no other owner, you do, below.</p>
  {% if owners is empty %}
    {{ kit.empty('Nobody owns this event yet', 'Name an owner below — your staff, or the organiser’s own person. Until then, what its leads propose waits for you here.', 'users') }}
  {% else %}
    <ul class="vl-list">
      {% for o in owners %}
        <li class="vl-li">
          <span class="vl-li__t">{{ o.name }}</span>
          <span class="vl-help">{{ o.email }} · until {{ o.until }}</span>
          <form method="post" action="/admin/events/{{ event.id }}/leads" data-confirm="End {{ o.name }}’s ownership of this event now? They no longer decide its teams and roles.">
            <input type="hidden" name="_token" value="{{ csrf_token }}"><input type="hidden" name="do" value="owner_end"><input type="hidden" name="grant" value="{{ o.id }}">
            <button class="cn-btn" type="submit">End<span class="sr-only">, {{ o.name }}</span></button>
          </form>
        </li>
      {% endfor %}
    </ul>
  {% endif %}
  <form class="vl-form" method="post" action="/admin/events/{{ event.id }}/leads">
    <input type="hidden" name="_token" value="{{ csrf_token }}"><input type="hidden" name="do" value="owner_give">
    <label for="oe">Their email<input id="oe" type="email" name="email" required autocomplete="off"></label>
    <label for="ou">Ownership ends<input id="ou" type="date" name="until"></label>
    <p class="vl-acts vl-wide"><button class="cn-btn cn-btn--primary" type="submit">Make them an owner</button></p>
  </form>
  <p class="vl-help">Leave the date empty and it ends the day after the event. We email them either way.</p>
</section>

<section class="cn-card vl-sec" aria-labelledby="fh">
  <h2 class="vl-h" id="fh">Finance admin</h2>
  <p class="vl-help">Decides this event’s spend requests — anything over the lead’s limit comes to them instead of the platform’s finance team — approves its spend lines and signs off its money gates. They never plan spend themselves, so whoever asks for money is never the one who approves it.</p>
  {% for c in finance_asks|default([]) %}
    <div class="vl-ask">
      <p><strong>Asked by the lead:</strong> {{ c.summary }}{% if c.reason %} — “{{ c.reason }}”{% endif %}. An owner of the event normally decides this; with no owner, it is yours.</p>
      <form class="vl-form" method="post" action="/admin/events/{{ event.id }}/leads">
        <input type="hidden" name="_token" value="{{ csrf_token }}"><input type="hidden" name="do" value="finance_decide"><input type="hidden" name="change" value="{{ c.id }}">
        <label for="fv{{ c.id }}">Decision<select id="fv{{ c.id }}" name="verdict"><option value="approve">Approve</option><option value="reject">Reject</option></select></label>
        <label for="fn{{ c.id }}">Why (needed to reject)<input id="fn{{ c.id }}" name="note" autocomplete="off"></label>
        <p class="vl-acts vl-wide"><button class="cn-btn cn-btn--primary" type="submit">Decide</button></p>
      </form>
    </div>
  {% endfor %}
  {% if finance is empty %}
    {{ kit.empty('No finance admin yet', 'Until there is one, this event’s spend requests go to the platform’s finance team.', 'users') }}
  {% else %}
    <ul class="vl-list">
      {% for f in finance %}
        <li class="vl-li">
          <span class="vl-li__t">{{ f.name }}</span>
          <span class="vl-help">{{ f.email }} · until {{ f.until }}</span>
          <form method="post" action="/admin/events/{{ event.id }}/leads" data-confirm="End {{ f.name }}’s finance access to this event now? Its spend requests go to the platform’s finance team again.">
            <input type="hidden" name="_token" value="{{ csrf_token }}"><input type="hidden" name="do" value="finance_end"><input type="hidden" name="grant" value="{{ f.id }}">
            <button class="cn-btn" type="submit">End<span class="sr-only">, {{ f.name }}</span></button>
          </form>
        </li>
      {% endfor %}
    </ul>
  {% endif %}
  <form class="vl-form" method="post" action="/admin/events/{{ event.id }}/leads">
    <input type="hidden" name="_token" value="{{ csrf_token }}"><input type="hidden" name="do" value="finance_give">
    <label for="fe">Their email<input id="fe" type="email" name="email" required autocomplete="off"></label>
    <label for="fu">Access ends<input id="fu" type="date" name="until"></label>
    <p class="vl-acts vl-wide"><button class="cn-btn cn-btn--primary" type="submit">Make them finance admin</button></p>
  </form>
  <p class="vl-help">Leave the date empty and it ends the day after the event. We email them either way.</p>
</section>

<section class="cn-card vl-sec" aria-labelledby="th">
  <h2 class="vl-h" id="th">Teams and roles{% if team.waiting %} · {{ team.waiting }} waiting{% endif %}</h2>
  {% if team.rows is empty %}
    <p class="vl-help">No teams or roles yet. The event’s leads propose them from their own console.</p>
  {% else %}
    <p class="vl-help">Everything the leads have proposed, and what was decided. You can decide anything still waiting, and end a person’s role or archive a role; each needs a reason, which is recorded and shown to the lead.</p>
    <ul class="vl-list">
      {% for r in team.rows %}
        <li class="vl-li">
          <span class="vl-li__t">{{ r.title }}</span>
          <span class="vl-help">{{ r.label }}{% if r.sub %} · {{ r.sub }}{% endif %}</span>
          {% if r.status == 'proposed' %}
            <form class="vl-form" method="post" action="/admin/events/{{ event.id }}/leads">
              <input type="hidden" name="_token" value="{{ csrf_token }}"><input type="hidden" name="do" value="team_decide">
              <input type="hidden" name="subject" value="{{ r.subject }}"><input type="hidden" name="id" value="{{ r.id }}">
              <label for="tv{{ r.subject }}{{ r.id }}">Decision<select id="tv{{ r.subject }}{{ r.id }}" name="verdict"><option value="approve">Approve</option><option value="refuse">Refuse</option></select></label>
              <label for="tr{{ r.subject }}{{ r.id }}">Reason<input id="tr{{ r.subject }}{{ r.id }}" type="text" name="reason" required></label>
              <p class="vl-acts"><button class="cn-btn" type="submit">Record<span class="sr-only"> the decision on {{ r.title }}</span></button></p>
            </form>
          {% elseif r.status == 'approved' and r.subject != 'team' %}
            <form class="vl-form" method="post" action="/admin/events/{{ event.id }}/leads">
              <input type="hidden" name="_token" value="{{ csrf_token }}"><input type="hidden" name="do" value="team_end">
              <input type="hidden" name="subject" value="{{ r.subject }}"><input type="hidden" name="id" value="{{ r.id }}">
              <label for="te{{ r.subject }}{{ r.id }}">Reason<input id="te{{ r.subject }}{{ r.id }}" type="text" name="reason" required></label>
              <p class="vl-acts"><button class="cn-btn" type="submit">{{ r.subject == 'role' ? 'Archive' : 'End' }}<span class="sr-only"> {{ r.title }}</span></button></p>
            </form>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  {% endif %}
</section>

{% if invites is not empty %}
<section class="cn-card vl-sec" aria-labelledby="ih">
  <h2 class="vl-h" id="ih">Invited, not yet switched on</h2>
  <p class="vl-help">Each switches on by itself when they sign in with that address confirmed. Nobody has to give it again.</p>
  <ul class="vl-list">
    {% for i in invites %}
      <li class="vl-li">
        <span class="vl-li__t">{{ i.email }}</span>
        <span class="vl-help">{{ i.role }} · waiting {{ i.waiting }} · invited by {{ i.by }} · until {{ i.until }}</span>
        <form method="post" action="/admin/events/{{ event.id }}/leads" data-confirm="Withdraw the invitation to {{ i.email }}? It will not switch on.">
          <input type="hidden" name="_token" value="{{ csrf_token }}"><input type="hidden" name="do" value="invite_cancel"><input type="hidden" name="invite" value="{{ i.id }}">
          <button class="cn-btn" type="submit">Withdraw<span class="sr-only"> the invitation to {{ i.email }}</span></button>
        </form>
      </li>
    {% endfor %}
  </ul>
</section>
{% endif %}

<section class="cn-card vl-sec" aria-labelledby="gh">
  <h2 class="vl-h" id="gh">Give this event to a lead</h2>
  <p class="vl-help">Any email address: your staff, or the organiser’s own people. If they already have an Africa GATES account with that address confirmed, they lead it at once; if not, they are invited and it switches on when they sign up and confirm it. Either way we email them.</p>
  <form class="vl-form" method="post" action="/admin/events/{{ event.id }}/leads">
    <input type="hidden" name="_token" value="{{ csrf_token }}"><input type="hidden" name="do" value="give">
    <label for="le">Their email<input id="le" type="email" name="email" required autocomplete="off"></label>
    <label for="lu">Access ends<input id="lu" type="date" name="until"></label>
    <p class="vl-acts vl-wide"><button class="cn-btn cn-btn--primary" type="submit">Make them a lead</button></p>
  </form>
  <p class="vl-help">Leave the date empty and it ends the day after the event.</p>
</section>
<section class="cn-card vl-sec" aria-labelledby="vh">
  <h2 class="vl-h" id="vh">Volunteers on this event</h2>
  {% if crew is empty %}
    {{ kit.empty('No volunteers on this event yet', may_staff ? 'Add door stewards, ushers and a team lead below. The event then shows in their volunteer workspace.' : 'Staff who manage volunteers can add them here.', 'users') }}
  {% else %}
    <ul class="vl-list">
      {% for g in crew %}
        <li class="vl-li">
          <span class="vl-li__t">{{ g.name }}</span>
          <span class="vl-help">{{ g.label }} · until {{ g.expires_at|date('j M Y') }}</span>
          {% if may_staff %}
          <form method="post" action="/admin/events/{{ event.id }}/leads" data-confirm="Remove {{ g.name }} from this event? It leaves their volunteer workspace on their next page.">
            <input type="hidden" name="_token" value="{{ csrf_token }}"><input type="hidden" name="do" value="vol_end"><input type="hidden" name="grant" value="{{ g.id }}">
            <button class="cn-btn" type="submit">Remove<span class="sr-only"> {{ g.name }}</span></button>
          </form>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  {% endif %}
  {% if may_staff %}
    {% if pool is empty %}
      <p class="vl-help">There are no approved volunteers yet. Approve applicants under <a href="/admin/volunteers">Volunteers</a> first.</p>
    {% else %}
    <form class="vl-form" method="post" action="/admin/events/{{ event.id }}/leads">
      <input type="hidden" name="_token" value="{{ csrf_token }}"><input type="hidden" name="do" value="vol_give">
      <label for="vv">Volunteer<select id="vv" name="volunteer" required><option value="">Choose…</option>{% for p in pool %}<option value="{{ p.id }}">{{ p.name }}</option>{% endfor %}</select></label>
      <label for="vr">Role<select id="vr" name="capability">{% for k, l in vol_roles %}<option value="{{ k }}">{{ l }}</option>{% endfor %}</select></label>
      <label for="vu">Ends<input id="vu" type="date" name="until" required value="{{ default_until }}" min="{{ 'now'|date('Y-m-d') }}"></label>
      <p class="vl-acts vl-wide"><button class="cn-btn cn-btn--primary" type="submit">Add to this event</button></p>
    </form>
    <p class="vl-help">The role ends on that date with nothing to tidy up. Only approved volunteers are listed; a team lead here confirms the hours of everybody else on this event.</p>
    {% endif %}
  {% endif %}
</section>
{% endblock %}
