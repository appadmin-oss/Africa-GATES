{% extends "admin/layout.twig" %}
{% block topbar_title %}{{ is_new ? 'New Event' : 'Edit Event' }}{% endblock %}

{% block head_styles %}
<style nonce="{{ csp_nonce }}">
  /* ── the ticket preview ──────────────────────────────────────────────────
     A sketch of templates/pages/events/ticket.twig, not a copy of it. It exists so a
     colour can be judged before saving; the real ticket is rendered server-side from
     validated values. Everything the accent touches is bound in Alpine, so no rule here
     may set a `style` on the same tags — AlpineStyleClobberTest fails the build on a tag
     carrying both a static `style` and a bound `:style`. */
  .tkp{ --tkp-card:#fff; --tkp-line:rgba(16,41,44,.10); --tkp-text:#10292C; --tkp-mute:#5a6d6f;
    background:var(--tkp-card); border:1px solid var(--tkp-line); border-radius:14px;
    overflow:hidden; box-shadow:0 12px 30px -22px rgba(16,41,44,.5) }
  .tkp--dark{ --tkp-card:#0f1c1e; --tkp-line:rgba(255,255,255,.14); --tkp-text:#eef5f0;
    --tkp-mute:#9fb3ad }
  .tkp__head{ position:relative; padding:12px 13px 13px; overflow:hidden }
  .tkp__shot{ position:absolute; inset:0; width:100%; height:100%; object-fit:cover }
  .tkp__scrim{ position:absolute; inset:0 }
  .tkp__headin{ position:relative }
  .tkp__eyebrow{ display:block; font-size:8px; font-weight:700; letter-spacing:.14em;
    text-transform:uppercase; opacity:.85 }
  .tkp__title{ display:block; margin-top:5px; font-size:13px; font-weight:800; line-height:1.25 }
  .tkp__when{ display:block; margin-top:4px; font-size:9.5px; opacity:.9 }
  .tkp__tear{ position:relative; height:14px; background:var(--tkp-card) }
  .tkp__tear::before, .tkp__tear::after{ content:""; position:absolute; top:50%; width:13px;
    height:13px; border-radius:50%; transform:translateY(-50%); background:#f4f7f4;
    border:1px solid var(--tkp-line) }
  .tkp--dark .tkp__tear::before, .tkp--dark .tkp__tear::after{ background:#0a1315 }
  .tkp__tear::before{ left:-7px } .tkp__tear::after{ right:-7px }
  .tkp__tear i{ position:absolute; left:9px; right:9px; top:50%; height:0;
    border-top:1.5px dashed var(--tkp-line) }
  .tkp__stub{ padding:2px 13px 12px; text-align:center }
  /* A placeholder grid, not a real symbol: generating one per keystroke would be a request
     per keystroke, and what is being judged here is the colour rather than the code. */
  .tkp__qr{ display:block; width:52px; height:52px; margin:4px auto 7px; border-radius:6px;
    background:
      repeating-linear-gradient(90deg,#10292C 0 4px,#fff 4px 8px),
      repeating-linear-gradient(0deg,#10292C 0 4px,#fff 4px 8px);
    background-blend-mode:difference; background-color:#fff;
    box-shadow:0 0 0 4px #fff, 0 1px 6px -2px rgba(16,41,44,.4) }
  .tkp__code{ display:inline-block; font-family:var(--ag-font-mono,monospace); font-size:15px;
    font-weight:700; letter-spacing:.05em; color:var(--tkp-text) }
  .tkp__note{ display:block; margin-top:6px; font-size:9px; font-weight:600; color:var(--tkp-text) }
  .tkp__rows{ display:flex; gap:1px; background:var(--tkp-line); border-top:1px solid var(--tkp-line) }
  .tkp__rows span{ flex:1; background:var(--tkp-card); padding:7px 9px; font-size:9.5px;
    font-weight:700; color:var(--tkp-text) }
  /* The panel's two columns. `min-width:0` is also set on each child inline — a grid item's
     default `min-width:auto` is its content's minimum, and the form's inputs are width:100%
     of that, so without it the left column grew past its track and slid under the preview. */
  .tk-des{ display:grid; grid-template-columns:minmax(0,1fr) minmax(0,236px); gap:18px;
    align-items:start }
  /* `box-sizing:border-box` on the fields, because the admin stylesheet's inputs are
     content-box: a `width:100%` input came out exactly 30px wider than its column (measured
     — 472px track, 502px input), which is its 14px padding and 1px border on each side. In
     the single-column forms elsewhere that overflow is invisible; beside a preview it puts
     the field under the card. Scoped here rather than fixed globally, because every other
     admin form is laid out against the current widths. */
  .tk-des input, .tk-des select, .tk-des textarea{ box-sizing:border-box; max-width:100% }
  @media (max-width:720px){
    /* One column, preview first: on a phone the point of the preview is to be seen at all. */
    .tk-des{ grid-template-columns:minmax(0,1fr) }
    .tkp{ max-width:236px }
  }
</style>
{% endblock %}

{% block content %}
{# The shared stepped-form structure. See the partial for why the fields all stay in one POST. #}
{% include 'admin/partials/form-steps.twig' %}

<div class="ad-card" style="max-width:820px">
  <form method="post" action="{{ is_new ? '/admin/events/new' : '/admin/events/' ~ row.id }}" class="ad-form af"
        x-data="afSteps(['The event','Tickets','The day','The ticket'])">
    <input type="hidden" name="_token" value="{{ csrf_token }}">

    {# ── THE RAIL ─────────────────────────────────────────────────────────────
       Four steps, grouped by the JOB rather than by the table's column order: what the event
       is, how it sells, what happens on the day, and what an attendee is handed. Cover image
       used to sit between capacity and status purely because that is the order of the columns. #}
    <nav class="af__rail" aria-label="Sections of this form">
      <template x-for="(t, i) in titles" :key="i">
        <button type="button" class="af__tab" :class="isOn(i) ? 'is-on' : ''"
                @click="go(i)" :aria-current="isOn(i) ? 'step' : 'false'">
          <span class="af__n" x-text="i + 1"></span>
          <span x-text="t"></span>
          <template x-if="todo[i] > 0">
            <span class="af__todo" x-text="todo[i]"
                  :aria-label="todo[i] + ' required fields still empty'"></span>
          </template>
        </button>
      </template>
    </nav>

    {# ══ STEP 1 · THE EVENT ══════════════════════════════════════════════════ #}
    <section class="af__step" :class="isOn(0) ? 'is-on' : ''">
      <div class="af__head">
        <h2>What the event is</h2>
        <p>The name, when it happens and where. Only the title and the start are required —
          everything else can wait, and an event saved as a draft is not visible to anybody.</p>
      </div>

      <div class="row">
        <label>Title <span class="af-req" title="Required">*</span>
          <input type="text" name="title" value="{{ row.title|default('') }}" required></label>
        <label>Slug <span class="af-opt">blank = made from the title</span>
          <input type="text" name="slug" value="{{ row.slug|default('') }}" placeholder="auto"></label>
      </div>
      <div class="row">
        <label>Starts <span class="af-req" title="Required">*</span>
          <input type="datetime-local" name="event_date" value="{{ row.event_date|default('')|replace({' ':'T'})|slice(0,16) }}" required></label>
        <label>Ends <span class="af-opt">optional</span>
          <input type="datetime-local" name="end_date" value="{{ row.end_date|default('')|replace({' ':'T'})|slice(0,16) }}"></label>
      </div>
      <div class="row">
        <label>Town or city <span class="af-opt">optional</span>
          <input type="text" name="location" value="{{ row.location|default('') }}" placeholder="Lagos · Nigeria"></label>
        <label>Venue <span class="af-opt">optional</span>
          <input type="text" name="venue" value="{{ row.venue|default('') }}" placeholder="Eko Hotel"></label>
      </div>
      <label>Tagline <span class="af-opt">one line, shown under the title</span>
        <input type="text" name="tagline" value="{{ row.tagline|default('') }}" maxlength="255"></label>
      <label>Description <span class="af-opt">optional</span>
        <textarea name="description" rows="5">{{ row.description|default('') }}</textarea></label>

      <div class="row">
        <label>Status
          <select name="status">
            <option value="published" {% if row.status|default('draft') == 'published' %}selected{% endif %}>Published — visible to everybody</option>
            <option value="draft" {% if row.status|default('draft') == 'draft' %}selected{% endif %}>Draft — only you can see it</option>
          </select>
        </label>
        <label>Cover image <span class="af-opt">also used on the ticket</span>
          <input type="url" name="cover_image" value="{{ row.cover_image|default('') }}" placeholder="https://…"></label>
      </div>
      <div class="row">
        <label>Map link <span class="af-opt">optional</span>
          <input type="url" name="map_embed" value="{{ row.map_embed|default('') }}" placeholder="https://maps.google.com/…"></label>
        <label>External details page <span class="af-opt">optional</span>
          <input type="text" name="rsvp_url" value="{{ row.rsvp_url|default('') }}" placeholder="/partner or https://…"></label>
      </div>
    </section>

    {# ══ STEP 2 · TICKETS ════════════════════════════════════════════════════ #}
    <section class="af__step" :class="isOn(1) ? 'is-on' : ''">
      <div class="af__head">
        <h2>How it sells</h2>
        <p>Leave the tiers empty for one simple free RSVP. Add rows and each gets its own price
          and its own limit — <strong>a price of 0 is a free ticket</strong>, and a blank limit
          means as many as the room allows.</p>
      </div>

      <div class="row">
        <label>Total capacity <span class="af-opt">blank = unlimited</span>
          <input type="number" name="capacity" min="0" step="1" value="{{ row.capacity|default('') }}" placeholder="Unlimited"></label>
        <div></div>
      </div>

    {# ── WHAT HAPPENS AROUND THE TICKET ────────────────────────────────────────
       These columns have been saved by the controller since ticketing shipped and have
       never had a field on this form — so every save silently blanked them. The marker
       below is what makes the panel's absence mean "not shown" rather than "cleared";
       see the note beside `event_extras_posted` in the controller. #}
    {% if refund_missing|default([]) is empty %}
    <input type="hidden" name="event_extras_posted" value="1">

    <div class="af__head" style="margin-top:26px">
      <h2>Cancellations and refunds</h2>
      <p>What an attendee can do for themselves once they have paid. Off by default: it is your
        event and your money, so nothing here changes unless you set it.</p>
    </div>

      <label class="af-check">
        <input type="checkbox" name="self_cancel" value="1"
               {% if row.self_cancel|default(0) %}checked{% endif %}>
        Let attendees cancel their own place
      </label>
      <p class="af-note">With this off, the ticket page shows your contact details instead of a
        cancel button — which is what it does today. With it on, giving a seat up frees it for
        the waiting list immediately.</p>

      <div class="row">
        <label>What comes back
          <select name="refund_mode">
            {% for key, label in refund_modes|default({}) %}
              <option value="{{ key }}" {% if (row.refund_mode|default('none')) == key %}selected{% endif %}>{{ label }}</option>
            {% endfor %}
          </select></label>
        <label>If partial, how much <span class="af-opt">percent</span>
          <input type="number" name="refund_percent" min="1" max="100" step="1"
                 value="{{ row.refund_percent|default(50) }}"></label>
      </div>

      <div class="row">
        <label>Refunds close this long before the event <span class="af-opt">hours · 0 = right up to it</span>
          <input type="number" name="refund_cutoff_hours" min="0" max="8760" step="1"
                 value="{{ row.refund_cutoff_hours|default(0) }}" placeholder="48"></label>
        <div></div>
      </div>
      <p class="af-note">After the cutoff an attendee can still give the seat up so somebody on
        the waiting list can have it — they just get nothing back. Those are two different
        things and this keeps them separate.</p>

      <label>Refund policy, in your own words
        <textarea name="refund_policy" rows="3" maxlength="1000"
                  placeholder="Shown before anybody buys.">{{ row.refund_policy|default('') }}</textarea></label>
      <p class="af-note">The rule above is what the platform DOES automatically. This is what you
        MEAN, and it is shown on the event page before anybody pays.</p>

    <div class="af__head" style="margin-top:26px">
      <h2>Before they come</h2>
      <p>Who to contact, when registration shuts, and anything they need to know on the day.</p>
    </div>
      <div class="row">
        <label>Organiser email <span class="af-opt">for questions</span>
          <input type="email" name="organiser_email" maxlength="190"
                 value="{{ row.organiser_email|default('') }}"></label>
        <label>Organiser phone <span class="af-opt">optional</span>
          <input type="text" name="organiser_phone" maxlength="40"
                 value="{{ row.organiser_phone|default('') }}"></label>
      </div>
      <div class="row">
        <label>Registration closes <span class="af-opt">blank = when the event starts</span>
          <input type="datetime-local" name="sales_close_at" value="{{ sales_close_input|default('') }}"></label>
        <label class="af-check" style="align-self:end">
          <input type="checkbox" name="waitlist_open" value="1"
                 {% if row.waitlist_open|default(0) %}checked{% endif %}>
          Offer a waiting list when a tier sells out
        </label>
      </div>
      <label>Note to attendees <span class="af-opt">joining links, parking, dress code</span>
        <textarea name="attendee_note" rows="3">{{ row.attendee_note|default('') }}</textarea></label>
    {% endif %}

    {# ── TICKET TIERS ─────────────────────────────────────────────────────────
       These are real rows now, not a JSON blob the public page printed as prose. Each
       carries its OWN attendee limit, which is what makes "40 early-bird, 40 standard, in
       a hall of 60" expressible — the event's capacity above is still the ceiling for the
       whole room and is checked on top of every tier's.

       A tier with a price is CHARGED: the registration goes to the gateway and no ticket
       exists until Paystack confirms it. Leave the price at 0 for a free RSVP, which is
       confirmed on the spot. #}
    <div style="border:1px solid var(--ad-line,#e2e8e6);border-radius:12px;padding:14px 16px;margin-top:6px;background:#fafcfa" x-data="evRepeater({{ tier_seed|json_encode|e('html_attr') }}, {name:'',price:0,perk:'',cap:'',code:'',active:true,sold:0})">
      <strong style="font-size:14px">Ticket tiers <small style="font-weight:400;color:#8a9a9c">(a price of 0 is a free RSVP — leave the list empty for one simple free ticket)</small></strong>
      <template x-for="r in rows" :key="r.id">
        <div style="border-top:1px solid var(--ad-line,#e2e8e6);margin-top:10px;padding-top:10px">
          <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
            <input type="hidden" name="tier_id[]" :value="r.tid || ''">
            <input type="hidden" name="tier_active[]" :value="r.active ? '1' : '0'">
            <input name="tier_name[]" aria-label="Ticket tier name" x-model="r.name" maxlength="120" placeholder="Tier (e.g. VIP)" style="width:150px">
            <input name="tier_price[]" aria-label="Ticket tier price in naira" type="number" min="0" step="1" x-model.number="r.price" placeholder="₦ 0" style="width:110px">
            {# THE point of this change. Blank = as many as the room allows. #}
            <input name="tier_capacity[]" aria-label="Seats available at this tier" type="number" min="0" step="1" x-model="r.cap" placeholder="Seats (blank = no limit)" style="width:170px">
            <input name="tier_perk[]" aria-label="What this tier includes" x-model="r.perk" maxlength="500" placeholder="What's included" style="flex:1;min-width:140px">
            <button type="button" @click="rm(r.id)" aria-label="Remove row" style="border:none;background:#fbeaea;color:#a4243a;font-weight:700;border-radius:8px;width:34px;height:34px;cursor:pointer">×</button>
          </div>
          <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:6px">
            <input name="tier_from[]" aria-label="Sales open at" type="datetime-local" x-model="r.from" style="width:200px">
            <input name="tier_until[]" aria-label="Sales close at" type="datetime-local" x-model="r.until" style="width:200px">
            {# A code-gated tier is hidden from the public list and refused without the
               code, which is how a sponsor or speaker allocation stays out of sight
               without needing a second, secret event. #}
            <input name="tier_code[]" aria-label="Access code" x-model="r.code" maxlength="60" placeholder="Access code (optional — hides the tier)" style="flex:1;min-width:180px">
            <label style="display:flex;align-items:center;gap:5px;font-size:12px;white-space:nowrap"><input type="checkbox" x-model="r.active"> On sale</label>
            <span x-show="r.sold > 0" x-cloak style="font-size:12px;color:#1a6118;font-weight:700"
                  x-text="r.sold + ' sold'"></span>
          </div>
        </div>
      </template>
      <button type="button" @click="add()" style="margin-top:10px;border:none;background:#eef7ee;color:#1a6118;font-weight:600;border-radius:999px;padding:8px 14px;cursor:pointer;font-size:13px">+ Add tier</button>
      <p style="font-size:12px;color:#8a9a9c;margin:8px 0 0">
        Prices in ₦. A tier is never deleted once anything has been sold against it — clearing
        "On sale" takes it off the page and keeps the record straight for the people who bought one.
        {% if row.id is defined %}<a href="/admin/events/{{ row.id }}/tickets" style="font-weight:600">See who is coming →</a>{% endif %}
      </p>
    </div>

    {# Early-bird banner (the promo strip across the top of the event page) #}
    <div style="border:1px solid var(--ad-line,#e2e8e6);border-radius:12px;padding:14px 16px;margin-top:6px;background:#fafcfa">
      <strong style="font-size:14px">Early-bird banner <small style="font-weight:400;color:#8a9a9c">(optional — auto-hides after the deadline)</small></strong>
      <label style="margin-top:8px">Banner text<input type="text" name="early_bird_text" value="{{ row.early_bird_text|default('') }}" maxlength="255" placeholder="Save ₦8,000 with Early Bird tickets"></label>
      <div class="row">
        <label>Deadline<input type="datetime-local" name="early_bird_deadline" value="{{ row.early_bird_deadline|default('')|replace({' ':'T'})|slice(0,16) }}"></label>
        <label>Link URL<input type="text" name="early_bird_url" value="{{ row.early_bird_url|default('') }}" placeholder="#tickets or https://…"></label>
      </div>
    </div>

    </section>

    {# ══ STEP 3 · THE DAY ════════════════════════════════════════════════════ #}
    <section class="af__step" :class="isOn(2) ? 'is-on' : ''">
      <div class="af__head">
        <h2>What happens on the day</h2>
        <p>The agenda and the rules the event runs by. All optional — an event with none of this
          still sells tickets and still works at the door.</p>
      </div>

    {# ── AGENDA (sessions as rows) ────────────────────────────────────────────
       The run-of-show blob above still works and is still read by the public page when
       there are no sessions. Sessions exist for the day an event has two rooms: a blob
       cannot be grouped by day, filtered by track, or attached to — two parallel items at
       14:00 read as a contradiction rather than a choice. #}
    <div style="border:1px solid var(--ad-line,#e2e8e6);border-radius:12px;padding:14px 16px;margin-top:6px;background:#fafcfa" x-data="evRepeater({{ session_seed|default([])|json_encode|e('html_attr') }}, {sid:0,title:'',body:'',from:'',until:'',room:'',track:'',who:'',live:true})">
      <strong style="font-size:14px">Agenda <small style="font-weight:400;color:#8a9a9c">(sessions — use this instead of the run of show for anything with tracks or more than one room)</small></strong>
      <template x-for="r in rows" :key="r.id">
        <div style="border-top:1px solid var(--ad-line,#e2e8e6);margin-top:10px;padding-top:10px">
          <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
            <input type="hidden" name="ses_id[]" :value="r.sid || ''">
            <input type="hidden" name="ses_live[]" :value="r.live ? '1' : '0'">
            <input name="ses_title[]" aria-label="Session title" x-model="r.title" maxlength="200" placeholder="Session title" style="flex:1;min-width:180px">
            <button type="button" @click="rm(r.id)" aria-label="Remove session" style="border:none;background:#fbeaea;color:#a4243a;font-weight:700;border-radius:8px;width:34px;height:34px;cursor:pointer;flex:none">×</button>
          </div>
          <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:6px">
            <input name="ses_from[]" aria-label="Session starts" type="datetime-local" x-model="r.from" style="width:200px">
            <input name="ses_until[]" aria-label="Session ends" type="datetime-local" x-model="r.until" style="width:200px">
            <input name="ses_room[]" aria-label="Room" x-model="r.room" maxlength="120" placeholder="Room" style="width:130px">
            <input name="ses_track[]" aria-label="Track" x-model="r.track" maxlength="80" placeholder="Track" style="width:130px">
            <label style="display:flex;align-items:center;gap:5px;font-size:12px;white-space:nowrap"><input type="checkbox" x-model="r.live"> Published</label>
          </div>
          <div style="display:flex;gap:8px;margin-top:6px">
            <input name="ses_who[]" aria-label="Speakers" x-model="r.who" maxlength="500" placeholder="Speakers, comma separated" style="width:260px">
            <input name="ses_body[]" aria-label="Session detail" x-model="r.body" maxlength="1000" placeholder="What happens in this session (optional)" style="flex:1;min-width:160px">
          </div>
        </div>
      </template>
      <button type="button" @click="add()" style="margin-top:10px;border:none;background:#eef7ee;color:#1a6118;font-weight:600;border-radius:999px;padding:8px 14px;cursor:pointer;font-size:13px">+ Add session</button>
      <p style="font-size:12px;color:#8a9a9c;margin:8px 0 0">
        Sessions with no time are kept and shown under “timings to be confirmed”, so you can
        type the titles now and the times later. Leave this list empty to keep using the run of show above.
      </p>
    </div>

    {# Run-of-show repeater #}
    <div style="border:1px solid var(--ad-line,#e2e8e6);border-radius:12px;padding:14px 16px;margin-top:6px;background:#fafcfa" x-data="evRepeater({{ sched_seed|json_encode|e('html_attr') }}, {time:'',title:'',body:''})">
      <strong style="font-size:14px">Run of show <small style="font-weight:400;color:#8a9a9c">(optional — renders as a timeline)</small></strong>
      <template x-for="r in rows" :key="r.id">
        <div style="display:flex;gap:8px;align-items:flex-start;margin-top:8px">
          <input name="sched_time[]" aria-label="Schedule time" x-model="r.time" maxlength="40" placeholder="18:00" style="width:88px;flex:none">
          <div style="flex:1;display:flex;flex-direction:column;gap:6px;min-width:0">
            <input name="sched_title[]" aria-label="Schedule item title" x-model="r.title" maxlength="160" placeholder="Item title">
            <input name="sched_body[]" aria-label="Schedule item detail" x-model="r.body" maxlength="300" placeholder="Short detail (optional)">
          </div>
          <button type="button" @click="rm(r.id)" aria-label="Remove row" style="border:none;background:#fbeaea;color:#a4243a;font-weight:700;border-radius:8px;width:34px;height:34px;cursor:pointer;flex:none">×</button>
        </div>
      </template>
      <button type="button" @click="add()" style="margin-top:10px;border:none;background:#eef7ee;color:#1a6118;font-weight:600;border-radius:999px;padding:8px 14px;cursor:pointer;font-size:13px">+ Add item</button>
    </div>

    </section>

    {# ══ STEP 4 · THE TICKET ═════════════════════════════════════════════════ #}
    <section class="af__step" :class="isOn(3) ? 'is-on' : ''">
      <div class="af__head">
        <h2>What the attendee is handed</h2>
        <p>Leave this alone and tickets look exactly as they do now. Change anything and only
          this event's tickets change.</p>
      </div>

    {# ── THE TICKET'S APPEARANCE ─────────────────────────────────────────────
       Per event, not per site: this platform runs an awards ceremony, a summit and a
       training day in the same year, and they do not share a look. A site-wide ticket
       theme would mean every event after the first wears somebody else's clothes.

       The preview is live but it is a PREVIEW — the real ticket is rendered by
       templates/pages/events/ticket.twig from values EventTicketDesign has validated. The
       colour is the one field here whose value ends up inside a `style` attribute, so it is
       refused rather than escaped on save AND again on render.

       `x-data` sits on a wrapper with no static `style`, and every bound style below is on
       a tag that has none of its own — AlpineStyleClobberTest fails the build otherwise. #}
    {% if design_missing is not empty %}
      <div style="border:1px solid #ecd9a0;border-radius:12px;padding:14px 16px;margin-top:6px;background:#fffdf5">
        <strong style="font-size:14px">Ticket design needs one more step</strong>
        <p style="font-size:12.5px;color:#6b5312;margin:6px 0 0;line-height:1.7">
          These columns are not in the database yet:
          <code>{{ design_missing|join('</code>, <code>')|raw }}</code>. Run
          <strong>/__setup/migrate</strong> and this section appears. Until then tickets use
          the standard design, which is exactly what they did before.
        </p>
      </div>
    {% else %}
    <div style="border:1px solid var(--ad-line,#e2e8e6);border-radius:12px;padding:14px 16px;margin-top:6px;background:#fafcfa"
         x-data="tkDesign({{ {
            accent: design.accent,
            theme: design.theme,
            note: design.note,
            image: design.image,
            title: row.title|default('Your event'),
            when: row.event_date|default(''),
            venue: row.venue|default(''),
            showQr: design.show_qr
         }|json_encode }})">
      <input type="hidden" name="ticket_design_posted" value="1">
      <strong style="font-size:14px">The ticket <small style="font-weight:400;color:#8a9a9c">(what an attendee shows at the door)</small></strong>
      <p style="font-size:12px;color:#8a9a9c;margin:6px 0 12px">
        {% if design.customised %}This event has its own ticket design.{% else %}Using the
        standard design. Change anything below and only this event's tickets change.{% endif %}
      </p>

      {# `min-width:0` on the CHILD, not only `minmax(0,…)` on the track. A grid item's
         default `min-width:auto` is its content's minimum, and the form's inputs are
         `width:100%` of that — so the left column grew past its track and slid under the
         preview. The track sizing alone does not prevent it. #}
      <div class="tk-des">
        <div style="min-width:0">
          <div class="row">
            <label>Accent colour
              {# Two inputs, one value: the picker is unusable for typing a brand hex and the
                 text box is unusable for choosing one by eye. They are kept in step in
                 Alpine, and only `ticket_accent` is submitted. #}
              <span style="display:flex;gap:8px;align-items:center">
                <input type="color" x-model="accent" aria-label="Accent colour picker"
                       style="width:44px;height:38px;padding:2px;flex:none;cursor:pointer">
                <input type="text" name="ticket_accent" x-model="accent" maxlength="7"
                       placeholder="#10292C" spellcheck="false"
                       style="font-family:var(--ag-font-mono,monospace)">
              </span>
            </label>
            <label>Card
              <select name="ticket_theme" x-model="theme">
                <option value="dark">Dark card</option>
                <option value="light">Light card</option>
              </select>
            </label>
          </div>

          <label>Ticket image <small>(blank = the event's cover image)</small>
            <input type="text" name="ticket_image" x-model="image"
                   placeholder="/uploads/ticket-art.jpg or https://…"></label>
          <p style="font-size:12px;color:#8a9a9c;margin:-2px 0 10px">
            A wide cover photograph often crops badly into a ticket header, so this is
            separate — you do not have to choose between a good event page and a good ticket.
          </p>

          <label>Line on the stub <small>(printed — “Doors 5pm · Black tie”)</small>
            <input type="text" name="ticket_note" x-model="note" maxlength="160"></label>

          <fieldset style="border:1px solid var(--ad-line,#e2e8e6);border-radius:10px;padding:10px 12px;margin:10px 0 0">
            <legend style="font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#8a9a9c;padding:0 4px">Show on the ticket</legend>
            <div style="display:flex;flex-wrap:wrap;gap:10px 16px;margin-top:4px">
              {% for key, label in design_rows %}
                <label style="display:flex;align-items:center;gap:7px;font-size:13px;margin:0">
                  <input type="checkbox" name="ticket_rows[]" value="{{ key }}"
                         {% if key in design.rows %}checked{% endif %}
                         style="width:auto;flex:none;margin:0">
                  <span>{{ label }}</span>
                </label>
              {% endfor %}
            </div>
            <p style="font-size:12px;color:#8a9a9c;margin:10px 0 0">
              The holder's name, the ticket type and the reference always show — a ticket
              without them is not a ticket. A row with nothing in it is skipped, so ticking
              “Seat” costs nothing on events that do not use one.
            </p>
          </fieldset>

          <label style="display:flex;align-items:center;gap:8px;margin-top:12px">
            <input type="checkbox" name="ticket_show_qr" value="1" x-model="showQr"
                   style="width:auto;flex:none;margin:0">
            <span>Print a QR code on the ticket</span>
          </label>
          <p style="font-size:12px;color:#8a9a9c;margin:4px 0 0">
            Leave this on unless your door checks names against a printed list. Typing nine
            characters per attendee is what makes a queue stationary — at three hundred people
            it is about twenty minutes of queue that need not exist. The code is printed
            either way, so a phone with a dead battery is never locked out.
          </p>
        </div>

        {# ── the preview ────────────────────────────────────────────────────
           Not the real template — it is a sketch at a quarter of the detail, and it exists
           so a colour choice can be judged before saving. The QR is a placeholder grid
           rather than a real symbol: generating one per keystroke would be a request per
           keystroke, and what is being judged here is the colour, not the code. #}
        <div style="min-width:0">
          <span style="display:block;font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#8a9a9c;margin-bottom:7px">Preview</span>
          <div :class="theme === 'dark' ? 'tkp tkp--dark' : 'tkp'">
            <div class="tkp__head" :style="'background:' + accent + ';color:' + ink()">
              <template x-if="image">
                <img class="tkp__shot" :src="image" alt="" aria-hidden="true">
              </template>
              <template x-if="image">
                <span class="tkp__scrim" :style="'background:linear-gradient(180deg,' + accent + 'F0,' + accent + 'FC)'"></span>
              </template>
              <div class="tkp__headin">
                <span class="tkp__eyebrow">Admit one</span>
                <strong class="tkp__title" x-text="title || 'Your event'"></strong>
                <span class="tkp__when" x-text="[when, venue].filter(Boolean).join(' · ')"></span>
              </div>
            </div>
            <div class="tkp__tear"><i></i></div>
            <div class="tkp__stub">
              <template x-if="showQr"><span class="tkp__qr" aria-hidden="true"></span></template>
              <span class="tkp__code">ABCD-2468</span>
              <template x-if="note"><span class="tkp__note" x-text="note"></span></template>
            </div>
            <div class="tkp__rows">
              <span>Ada Obi</span><span>Ceremony</span>
            </div>
          </div>
        </div>
      </div>
    </div>
    {% endif %}

    </section>

    {# ── THE BAR ──────────────────────────────────────────────────────────────
       Sticky, so Save is never a scroll away — correcting one field used to mean finding it,
       changing it, then scrolling past everything else to commit it. And it SAYS what state the
       form is in: a Save button that looks identical whether or not anything has changed is a
       button somebody presses again just in case.

       Back/Next move between steps and submit NOTHING; only Save posts, and it posts every
       field on every step at once. #}
    <div class="af__bar">
      <span class="af__state" :class="stateClass()" x-text="state()">Everything saved</span>
      <div class="af__steps">
        <button type="button" class="af__ghost" @click="back()" :disabled="at === 0">← Back</button>
        <button type="button" class="af__ghost" @click="next()"
                :disabled="at === titles.length - 1">Next →</button>
      </div>
      <button class="ad-btn ad-btn--primary" type="submit">Save event</button>
      <a class="ad-btn" href="/admin/events">Cancel</a>
    </div>

    {# The sibling screens, out of the save bar. They are navigation, not actions on this form,
       and sitting beside Save is how somebody loses an edit by pressing one of them. #}
    {% if row.id is defined %}
    <p style="margin:12px 0 0;font-size:12.5px;color:var(--ad-text-mute,#5a6d6f)">
      Also for this event:
      <a href="/admin/events/{{ row.id }}/tickets" style="font-weight:600">Who is coming</a> ·
      <a href="/admin/events/{{ row.id }}/codes" style="font-weight:600">Discount codes</a> ·
      <a href="/admin/events/{{ row.id }}/stands" style="font-weight:600">Vendor stands</a>
    </p>
    {% endif %}
  </form>
</div>
<script nonce="{{ csp_nonce }}">
function evRepeater(seed, blank){
  let nextId = 1000;
  const rows = (seed && seed.length) ? seed.map(r => Object.assign({}, r)) : [Object.assign({id:1}, blank)];
  return {
    rows,
    add(){ this.rows.push(Object.assign({id: nextId++}, blank)); },
    rm(id){ this.rows = this.rows.filter(r => r.id !== id); if(!this.rows.length) this.add(); }
  };
}

/* ── the ticket preview ─────────────────────────────────────────────────────
   Presentation only. Nothing here validates anything: the server refuses a non-colour on
   save and again on render (EventTicketDesign::colour), so a malformed value typed here
   shows as a broken preview and is then simply not stored. Doing the validation twice in
   two languages would mean two places to disagree.

   `ink()` mirrors EventTicketDesign::contrastInk so the preview picks the same readable
   text colour the real ticket will. Same relative-luminance formula and the same 0.36
   threshold — a naive channel average hands white text to a bright green header. */
function tkDesign(seed){
  return {
    accent: seed.accent || '#10292C',
    theme:  seed.theme  || 'dark',
    note:   seed.note   || '',
    image:  seed.image  || '',
    title:  seed.title  || '',
    when:   (seed.when || '').slice(0, 16).replace('T', ' '),
    venue:  seed.venue  || '',
    showQr: seed.showQr !== false,

    ink(){
      const h = String(this.accent || '').trim().replace(/^#/, '');
      if (!/^[0-9a-f]{6}$/i.test(h)) return '#FFFFFF';
      const lin = c => { c /= 255; return c <= 0.03928 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4); };
      const l = 0.2126 * lin(parseInt(h.slice(0, 2), 16))
              + 0.7152 * lin(parseInt(h.slice(2, 4), 16))
              + 0.0722 * lin(parseInt(h.slice(4, 6), 16));
      return l > 0.36 ? '#10292C' : '#FFFFFF';
    }
  };
}
</script>
{% endblock %}
