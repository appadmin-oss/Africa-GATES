{% extends "admin/layout.twig" %}
{% block topbar_title %}Judges Panel{% endblock %}
{% block topbar_actions %}<a class="ad-btn ad-btn--primary" href="/admin/judges/new">+ Invite Judge</a>{% endblock %}
{% block content %}
<div class="ad-card"><div class="ad-table-wrap">
  <table class="ad-table">
    <thead><tr><th>Judge</th><th>Affiliation</th><th>Country</th><th>Programmes</th><th>Status</th><th class="col-actions">Actions</th></tr></thead>
    <tbody>
      {% for r in rows %}
      <tr>
        <td>
          {% if r.avatar_path %}<span class="ad-avatar" style="background-image:url('{{ r.avatar_path }}')"></span>{% endif %}
          <strong>{{ r.name }}</strong>
          <div style="font-size:12px;color:var(--ad-text-soft)">{{ r.email }}</div>
        </td>
        <td>{{ r.title }}{% if r.organisation %} · {{ r.organisation }}{% endif %}</td>
        <td><span style="font-family:'Space Mono',monospace">{{ r.country_code }}</span></td>
        <td>
          {% for pid in r.programme_ids %}
            {% for p in programmes %}{% if p.id == pid %}<span class="ad-chip ad-chip--grey" style="margin-right:4px">{{ p.icon_emoji }} {{ p.title|slice(0,20) }}</span>{% endif %}{% endfor %}
          {% else %}—{% endfor %}
        </td>
        <td>{% if r.is_active %}<span class="ad-chip ad-chip--green">Active</span>{% else %}<span class="ad-chip ad-chip--grey">Inactive</span>{% endif %}</td>
        <td class="col-actions">
          <a class="ad-btn ad-btn--sm" href="/admin/judges/{{ r.id }}">Edit</a>
          <form method="post" action="/admin/judges/{{ r.id }}/delete" style="display:inline"><input type="hidden" name="_token" value="{{ csrf_token }}"><button class="ad-btn ad-btn--sm ad-btn--danger" type="submit" data-confirm="Remove judge?">×</button></form>
        </td>
      </tr>
      {% else %}<tr><td colspan="6" style="text-align:center;color:var(--ad-text-mute);padding:30px">No judges yet.</td></tr>{% endfor %}
    </tbody>
  </table>
</div></div>
{% endblock %}
