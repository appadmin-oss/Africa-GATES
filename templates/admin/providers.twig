{% extends "admin/layout.twig" %}
{% block topbar_title %}Integrations{% endblock %}

{#
  ── THE PAGE THAT ANSWERS "IS IT ACTUALLY WORKING" ──────────────────────────

  Every integration here could tell an operator whether a KEY WAS PRESENT and none
  could tell them whether it WORKED. That gap is the most expensive thing in this
  codebase: the door voice was reported broken for days with a correct key, a
  correct provider and a correct request, because the one screen built to test it
  asked a different provider and nothing would say so.

  So this page asks each vendor a real question and prints their own answer.

  ── THREE STATES, NOT TWO ───────────────────────────────────────────────────

  "Not set" is not a fault — most deployments use a handful of these. What matters
  is the difference between OK and FAILING, which is the state every expensive bug
  here was sitting in: configured, and refusing.
#}

{% block head_styles %}
<style nonce="{{ csp_nonce }}">
  .pv-lead{ margin:0 0 18px; max-width:62ch; font-size:13.5px; line-height:1.65;
            color:var(--ad-text-mute,#5a6d6f); }
  .pv-grp{ margin:0 0 22px; }
  .pv-grp h3{ margin:0 0 8px; font:600 11px/1 var(--ad-font-mono,ui-monospace,monospace);
              letter-spacing:.14em; text-transform:uppercase; color:var(--ad-text-mute,#5a6d6f); }
  .pv-t{ width:100%; border-collapse:collapse; }
  .pv-t td{ padding:11px 10px; border-top:1px solid rgba(16,41,44,.09); vertical-align:top;
            font-size:13.5px; }
  .pv-t tr:first-child td{ border-top:0; }
  .pv-n{ font-weight:600; white-space:nowrap; }
  .pv-d{ color:var(--ad-text-mute,#5a6d6f); line-height:1.55; }
  .pv-ms{ text-align:right; white-space:nowrap; font:11.5px/1 var(--ad-font-mono,ui-monospace,monospace);
          color:var(--ad-text-mute,#5a6d6f); }
  .pv-s{ display:inline-block; min-width:74px; padding:3px 9px; border-radius:999px;
         font:600 11px/1.6 var(--ad-font-mono,ui-monospace,monospace); letter-spacing:.06em;
         text-align:center; }
  .pv-s--ok{ background:rgba(35,123,34,.12); color:#1a6118; border:1px solid rgba(35,123,34,.3); }
  .pv-s--no{ background:rgba(138,32,32,.10); color:#8a2020; border:1px solid rgba(138,32,32,.3); }
  .pv-s--off{ background:rgba(16,41,44,.05); color:var(--ad-text-mute,#5a6d6f);
              border:1px solid rgba(16,41,44,.12); }
  .pv-s--run{ background:rgba(243,180,22,.14); color:#8a6a00; border:1px solid rgba(243,180,22,.35); }
  .pv-bar{ display:flex; gap:10px; align-items:center; margin:0 0 16px; flex-wrap:wrap; }

  /* The send test. Set apart on purpose: everything above it is free and reversible and
     this is neither, so it must not read as one more row in the table. */
  .pv-send{ margin:26px 0 0; padding:18px 18px 16px; border:1px solid rgba(243,180,22,.45);
            border-radius:10px; background:rgba(243,180,22,.05); }
  .pv-send h3{ margin:0 0 6px; font:600 11px/1 var(--ad-font-mono,ui-monospace,monospace);
               letter-spacing:.14em; text-transform:uppercase; color:#8a6a00; }
  .pv-send p{ margin:0 0 14px; max-width:60ch; font-size:13px; line-height:1.6;
              color:var(--ad-text-mute,#5a6d6f); }
  .pv-send__row{ display:flex; gap:10px; align-items:flex-end; flex-wrap:wrap; }
  .pv-f{ display:flex; flex-direction:column; gap:5px; }
  .pv-f label{ font:600 10.5px/1 var(--ad-font-mono,ui-monospace,monospace); letter-spacing:.1em;
               text-transform:uppercase; color:var(--ad-text-mute,#5a6d6f); }
  .pv-f input, .pv-f select{ min-height:40px; padding:8px 11px; font-size:14px;
               border:1px solid rgba(16,41,44,.22); border-radius:7px; background:#fff; }
  .pv-f input{ min-width:210px; font-family:var(--ad-font-mono,ui-monospace,monospace); }
  .pv-out{ margin:14px 0 0; padding:12px 13px; border-radius:8px; font-size:13px;
           line-height:1.6; border:1px solid transparent; }
  .pv-out--ok{ background:rgba(35,123,34,.09); border-color:rgba(35,123,34,.3); color:#1a5518; }
  .pv-out--no{ background:rgba(138,32,32,.08); border-color:rgba(138,32,32,.3); color:#7a1c1c; }
  .pv-out b{ display:block; margin:0 0 3px; font-size:12px; letter-spacing:.04em;
             text-transform:uppercase; font-family:var(--ad-font-mono,ui-monospace,monospace); }
  .pv-note{ margin:8px 0 0; padding-top:8px; border-top:1px solid rgba(16,41,44,.12);
            color:#8a6a00; }
</style>
{% endblock %}

{% block content %}
<div class="ad-card"><div class="ad-card__body">

  <p class="pv-lead">Each check asks the provider a real question and prints their answer.
    The checks are all <strong>reads</strong> &mdash; a balance, an account, a model list
    &mdash; so running them sends nothing and is safe during an event. The one exception is
    the send test below, which is the only thing on this page that costs a message, and it
    only ever runs when you press it.</p>

  <div class="pv-bar">
    <button type="button" class="ad-btn ad-btn--primary" data-ag-do="pv-all">Run all checks</button>
    <span class="pv-d" data-pv-summary></span>
  </div>

  {% for gid, gname in groups %}
    <div class="pv-grp">
      <h3>{{ gname }}</h3>
      <table class="pv-t">
        <tbody>
        {% for c in catalogue|filter(c => c.group == gid) %}
          <tr data-pv-row="{{ c.id }}">
            <td class="pv-n">{{ c.label }}</td>
            <td style="width:96px"><span class="pv-s pv-s--off" data-pv-state>not run</span></td>
            <td class="pv-d" data-pv-detail>&mdash;</td>
            <td class="pv-ms" data-pv-ms></td>
            <td style="width:60px;text-align:right">
              <button type="button" class="ad-btn ad-btn--sm" data-ag-do="pv-one"
                      data-pv-id="{{ c.id }}">Run</button>
            </td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
  {% endfor %}

  {#
    ── THE ONE QUESTION A READ CANNOT ANSWER ────────────────────────────────
    Three real gateways authenticate, report a balance and accept a message while
    delivering nothing: the Africa's Talking sandbox (its own hostname, a simulator on
    the other end), a Termii sender ID that has not been approved (refused inside a 200),
    and a Twilio trial account (only console-verified recipients). Every probe above
    reads OK on all three.
  #}
  <div class="pv-send">
    <h3>Send a real test message</h3>
    <p>This sends one actual message, to a phone you can pick up, through whichever gateway
      is configured. It is the only way to tell a working gateway from one that accepts
      everything and delivers nothing. Capped at {{ msg_cap }} an hour
      ({{ msg_left }} left); numbers that have opted out are refused.</p>

    <div class="pv-send__row">
      <div class="pv-f">
        <label for="pv-ch">Channel</label>
        <select id="pv-ch" data-pv-channel>
          <option value="sms"{% if not msg.sms %} disabled{% endif %}>
            SMS{% if msg.sms_provider %} — {{ msg.sms_provider }}{% else %} — not configured{% endif %}
          </option>
          <option value="whatsapp"{% if not msg.whatsapp %} disabled{% endif %}>
            WhatsApp{% if msg.wa_provider %} — {{ msg.wa_provider }}{% else %} — not configured{% endif %}
          </option>
        </select>
      </div>
      <div class="pv-f">
        <label for="pv-num">Number, in full international form</label>
        <input id="pv-num" type="tel" inputmode="tel" placeholder="+234 801 234 5678"
               autocomplete="off" data-pv-number>
      </div>
      <button type="button" class="ad-btn ad-btn--primary" data-ag-do="pv-send">Send it</button>
    </div>

    <div class="pv-out" data-pv-out hidden></div>
  </div>

</div></div>
{% endblock %}

{% block foot_scripts %}
<script nonce="{{ csp_nonce }}">
(function () {
  'use strict';
  // Delegated on `data-ag-do`, never an inline handler: the admin CSP has no
  // 'unsafe-inline', so an onclick= here is a button that does nothing at all.
  var TOKEN = (document.querySelector('meta[name="csrf-token"]') || {}).content || '';

  function row(id) { return document.querySelector('[data-pv-row="' + id + '"]'); }

  function paint(r) {
    var tr = row(r.id); if (!tr) return;
    var s = tr.querySelector('[data-pv-state]');
    var d = tr.querySelector('[data-pv-detail]');
    var m = tr.querySelector('[data-pv-ms]');

    // Three states, deliberately. "not set" is not a failure and must not read as one —
    // most deployments use a handful of these, and colouring them red teaches an operator
    // to ignore the colour on the row that matters.
    var cls = r.ok ? 'ok' : (r.configured ? 'no' : 'off');
    var txt = r.ok ? 'OK'  : (r.configured ? 'FAILING' : 'not set');
    s.className = 'pv-s pv-s--' + cls;
    s.textContent = txt;
    d.textContent = r.detail || '';
    m.textContent = r.ms ? r.ms + 'ms' : '';
  }

  function busy(id) {
    var tr = row(id); if (!tr) return;
    var s = tr.querySelector('[data-pv-state]');
    s.className = 'pv-s pv-s--run';
    s.textContent = 'asking…';
  }

  function run(id) {
    if (id) busy(id);
    return fetch('/admin/settings/providers/run', {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-CSRF-Token': TOKEN },
      body: id ? 'id=' + encodeURIComponent(id) : '',
    })
      .then(function (r) { return r.json(); })
      .then(function (d) { (d.results || []).forEach(paint); return d.results || []; })
      .catch(function () {
        // The check itself could not be reached — which is a different fault from a
        // provider refusing, and must not be reported as one.
        if (!id) return [];
        var tr = row(id), s = tr && tr.querySelector('[data-pv-state]');
        if (s) { s.className = 'pv-s pv-s--no'; s.textContent = 'FAILING'; }
        var dd = tr && tr.querySelector('[data-pv-detail]');
        if (dd) dd.textContent = 'The check could not be run from this browser.';
        return [];
      });
  }

  // ── THE SEND TEST ─────────────────────────────────────────────────────────
  //
  // Its own path, deliberately not folded into run(): everything run() drives is free and
  // repeatable, and this costs a message every time it is pressed. The button disables
  // itself for the duration so a double tap cannot spend two.
  function sendTest(btn) {
    var ch  = document.querySelector('[data-pv-channel]');
    var num = document.querySelector('[data-pv-number]');
    var out = document.querySelector('[data-pv-out]');
    if (!ch || !num || !out) return;

    var n = (num.value || '').trim();
    if (!n) {
      out.hidden = false;
      out.className = 'pv-out pv-out--no';
      out.innerHTML = '<b>Nothing sent</b>Type the number to send it to first.';
      num.focus();
      return;
    }

    btn.disabled = true;
    out.hidden = false;
    out.className = 'pv-out';
    out.textContent = 'Sending…';

    fetch('/admin/settings/providers/send-test', {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-CSRF-Token': TOKEN },
      body: 'channel=' + encodeURIComponent(ch.value) + '&number=' + encodeURIComponent(n),
    })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        btn.disabled = false;
        out.className = 'pv-out pv-out--' + (d.ok ? 'ok' : 'no');

        // Built as nodes, not innerHTML: `detail` is the PROVIDER'S own words and goes
        // straight onto an admin page. Their error text is not ours to trust with markup.
        out.textContent = '';
        var h = document.createElement('b');
        h.textContent = d.ok
          ? 'Accepted by ' + (d.provider || 'the gateway')
              + (d.ms ? ' in ' + d.ms + 'ms' : '')
          : (d.sent ? 'Refused by ' + (d.provider || 'the gateway') : 'Nothing sent');
        out.appendChild(h);
        out.appendChild(document.createTextNode(d.detail || ''));

        if (d.note) {
          var p = document.createElement('div');
          p.className = 'pv-note';
          p.textContent = d.note;
          out.appendChild(p);
        }
      })
      .catch(function () {
        btn.disabled = false;
        out.className = 'pv-out pv-out--no';
        // Never "the message failed": we do not know that. The request did not complete,
        // which on a send is the one outcome where a message may still be on its way.
        out.textContent = 'The send could not be run from this browser, so whether a '
                        + 'message went out is unknown. Check the message log before '
                        + 'pressing it again.';
      });
  }

  document.addEventListener('click', function (e) {
    var snd = e.target.closest('[data-ag-do="pv-send"]');
    if (snd) { sendTest(snd); return; }

    var one = e.target.closest('[data-ag-do="pv-one"]');
    if (one) { run(one.getAttribute('data-pv-id')); return; }

    var all = e.target.closest('[data-ag-do="pv-all"]');
    if (!all) return;

    // ── ONE AT A TIME, IN SERIES ─────────────────────────────────────────────
    //
    // Sixteen probes at eight seconds each is two minutes of one held-open request, and a
    // proxy will cut it in the middle leaving a blank screen and no idea which provider
    // hung. Asked one by one, each row answers as it lands and a provider that times out
    // costs its own row rather than the page.
    var ids = Array.prototype.map.call(
      document.querySelectorAll('[data-pv-row]'),
      function (n) { return n.getAttribute('data-pv-row'); });

    var sum = document.querySelector('[data-pv-summary]');
    all.disabled = true;
    var done = 0, bad = 0, off = 0;

    ids.forEach(busy);

    ids.reduce(function (p, id) {
      return p.then(function () {
        return run(id).then(function (rs) {
          done++;
          rs.forEach(function (r) { if (!r.configured) off++; else if (!r.ok) bad++; });
          if (sum) sum.textContent = done + ' of ' + ids.length + ' checked'
                 + (bad ? ' · ' + bad + ' failing' : '')
                 + (off ? ' · ' + off + ' not set' : '');
        });
      });
    }, Promise.resolve()).then(function () {
      all.disabled = false;
      if (sum && !bad) sum.textContent = done + ' checked · everything configured is answering'
                                       + (off ? ' · ' + off + ' not set' : '');
    });
  });
})();
</script>
{% endblock %}
