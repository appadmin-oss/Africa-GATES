{% extends "admin/layout.twig" %}
{% block topbar_title %}Admins{% endblock %}
{% block topbar_actions %}<a class="ad-btn ad-btn--primary" href="/admin/admins/new">+ Invite Admin</a>{% endblock %}
{% block content %}
<div class="ad-card"><div class="ad-table-wrap">
  <table class="ad-table">
    <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Last login</th><th>Status</th><th class="col-actions">Actions</th></tr></thead>
    <tbody>
      {% for r in rows %}
      <tr>
        <td><strong>{{ r.name }}</strong></td>
        <td>{{ r.email }}</td>
        <td><span class="ad-chip ad-chip--{% if r.role == 'superadmin' %}gold{% elseif r.role == 'admin' %}green{% else %}grey{% endif %}">{{ r.role|capitalize }}</span></td>
        <td style="font-family:'Space Mono',monospace;font-size:12px;color:var(--ad-text-soft)">{{ r.last_login_at|default('Never') }}</td>
        <td>{% if r.is_active %}<span class="ad-chip ad-chip--green">Active</span>{% else %}<span class="ad-chip ad-chip--red">Disabled</span>{% endif %}</td>
        <td class="col-actions">
          <a class="ad-btn ad-btn--sm" href="/admin/admins/{{ r.id }}">Edit</a>
          <form method="post" action="/admin/admins/{{ r.id }}/toggle" style="display:inline"><input type="hidden" name="_token" value="{{ csrf_token }}"><button class="ad-btn ad-btn--sm ad-btn--danger" type="submit" data-confirm="Toggle account?">{{ r.is_active ? 'Disable' : 'Enable' }}</button></form>
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div></div>
{% endblock %}
