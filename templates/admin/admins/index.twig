{% extends "admin/layout.twig" %}
{% block topbar_title %}Team{% endblock %}
{% block topbar_sub %}Staff console access and roles. Public member accounts are managed in Members.{% endblock %}
{% block head_styles %}<link rel="stylesheet" href="{{ asset('/assets/css/console/people.css') }}">{% endblock %}
{% block topbar_actions %}<a class="ad-btn ad-btn--primary" href="/admin/admins/new">+ Invite Admin</a>{% endblock %}
{% block content %}
<section class="aw-summary"><div><span class="aw-kicker">Console access</span><h2>{{ total|number_format }} staff accounts{{ q ? ' matching your search' : '' }}</h2><p>Review each person’s role and access before making a change. Disabling an account signs that person out.</p></div><a class="ad-btn" href="/admin/users">Member accounts</a></section>
<form class="aw-filters" action="/admin/admins" method="get" role="search"><div><label for="team-search">Staff name or email</label><input id="team-search" type="search" name="q" value="{{ q }}" maxlength="160" placeholder="Find a staff account"></div><button class="ad-btn ad-btn--primary" type="submit">Find staff</button>{% if q %}<a class="ad-btn" href="/admin/admins">Clear search</a>{% endif %}</form>

<div class="ad-card"><div class="ad-table-wrap">
  <table class="ad-table"><caption class="aw-caption">Staff accounts — page {{ page }} of {{ pages }}</caption>
    <thead><tr><th scope="col">Name</th><th scope="col">Email</th><th scope="col">Role</th><th scope="col">Last login</th><th scope="col">Status</th><th scope="col" class="col-actions">Actions</th></tr></thead>
    <tbody>
      {% for r in rows %}
      <tr>
        <td><strong>{{ r.name }}</strong></td>
        <td>{{ r.email }}</td>
        <td><span class="ad-chip ad-chip--{% if r.role == 'superadmin' %}gold{% elseif r.role == 'admin' %}green{% else %}grey{% endif %}">{{ r.role|capitalize }}</span></td>
        <td style="font-family:'Space Mono',monospace;font-size:12px;color:var(--cn-ink-3)">{{ r.last_login_at|default('Never') }}</td>
        <td>{% if r.is_active %}<span class="ad-chip ad-chip--green">Active</span>{% else %}<span class="ad-chip ad-chip--red">Disabled</span>{% endif %}</td>
        <td class="col-actions">
          <a class="ad-btn ad-btn--sm" href="/admin/admins/{{ r.id }}">Edit</a>
          <form method="post" action="/admin/admins/{{ r.id }}/toggle" style="display:inline"><input type="hidden" name="_token" value="{{ csrf_token }}"><button class="ad-btn ad-btn--sm ad-btn--danger" type="submit" data-confirm="Change this account’s access? A disabled admin is signed out and cannot sign back in until re-enabled.">{{ r.is_active ? 'Disable' : 'Enable' }}</button></form>
        </td>
      </tr>
      {% else %}<tr><td colspan="6"><div class="aw-empty"><h2>No staff accounts match</h2><p>Try another name or email.</p><a href="/admin/admins">Show all staff</a></div></td></tr>
      {% endfor %}
    </tbody>
  </table>
</div></div>
{% if pages > 1 %}<nav class="aw-pager" aria-label="Staff directory pages">{% if page > 1 %}<a class="ad-btn" href="/admin/admins?{{ query }}&page={{ page - 1 }}">Previous</a>{% endif %}<span>Page {{ page }} of {{ pages }}</span>{% if page < pages %}<a class="ad-btn" href="/admin/admins?{{ query }}&page={{ page + 1 }}">Next</a>{% endif %}</nav>{% endif %}
{% endblock %}
