{% extends "admin/layout.twig" %}
{% block topbar_title %}Legacy Events{% endblock %}
{% block topbar_actions %}<a class="ad-btn ad-btn--primary" href="/admin/legacy/new">+ New Event</a>{% endblock %}
{% block content %}
<div class="ad-card"><div class="ad-table-wrap">
  <table class="ad-table">
    <thead><tr><th scope="col">Event</th><th scope="col">Date</th><th scope="col">Location</th><th scope="col">Stats</th><th scope="col">Status</th><th scope="col" class="col-actions">Actions</th></tr></thead>
    <tbody>
      {% for r in rows %}
      <tr>
        <td>
          {% if r.cover_path %}<span class="ad-avatar" style="background-image:url('{{ r.cover_path }}')"></span>{% endif %}
          <strong>{{ r.icon }} {{ r.title }}</strong>
          <div style="font-size:12px;color:var(--ad-text-soft)">{{ r.tagline }}</div>
        </td>
        <td style="font-family:'Space Mono',monospace;font-size:12px">{{ r.event_date }}</td>
        <td>{{ r.location }}</td>
        <td style="font-size:12px;color:var(--ad-text-soft)">{{ r.attendee_count|number_format }} attendees · {{ r.award_count }} awards</td>
        <td>{% if r.is_published %}<span class="ad-chip ad-chip--green">Published</span>{% else %}<span class="ad-chip ad-chip--grey">Draft</span>{% endif %}</td>
        <td class="col-actions">
          <a class="ad-btn ad-btn--sm" href="/admin/legacy/{{ r.id }}">Edit</a>
          <a class="ad-btn ad-btn--sm" href="/legacy/{{ r.slug }}" target="_blank" rel="noopener noreferrer">View<span class="sr-only"> (opens in a new tab)</span></a>
          <form method="post" action="/admin/legacy/{{ r.id }}/delete" style="display:inline"><input type="hidden" name="_token" value="{{ csrf_token }}"><button class="ad-btn ad-btn--sm ad-btn--danger" type="submit" data-confirm="Delete “{{ r.title }}” for good? The page at /legacy/{{ r.slug }} stops existing, and anyone who has linked to it gets a 404. There is no undo.">×</button></form>
        </td>
      </tr>
      {% else %}<tr><td colspan="6" style="text-align:center;color:var(--ad-text-mute);padding:30px">No events yet. <a href="/admin/legacy/new" style="color:var(--ad-primary)">Add the first one.</a></td></tr>{% endfor %}
    </tbody>
  </table>
</div></div>
{% endblock %}
