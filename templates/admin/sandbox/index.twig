{% extends "admin/layout.twig" %}
{% block topbar_eyebrow %}<small>System</small>{% endblock %}
{% block topbar_title %}Test data{% endblock %}

{% block content %}

<div class="ad-card">
  <div class="ad-card__head"><div class="ad-card__title">A nominee you can drive through everything
    <small>Builds a hidden rehearsal programme with three nominees, a questionnaire in each state, evidence, an interview, a judge with scores, and votes.</small>
  </div></div>
  <div class="ad-card__body">
    <p style="margin:0 0 12px;font-size:13.5px;line-height:1.7">
      Everything it creates lives inside one <strong>inactive</strong> programme called
      <code>{{ slug }}</code>, and every name starts with <strong>{{ prefix }}</strong>.
    </p>
    {# The containment argument, stated where an operator can check it — because "will this
       affect the real awards" is the only question that matters before pressing the button,
       and "trust me" is not an answer. #}
    <div class="ad-callout">
      <strong>Why it cannot touch a real award</strong>
      <ul>
        <li>Tallies, ranks, gaps and shortlist cuts are all computed <em>per category</em>. The
          sandbox has its own category, so a real one is never reached — not filtered out,
          never queried.</li>
        <li>The programme is inactive, and the public site only reads active programmes. It
          does not appear on <code>/vote</code>, <code>/awards</code> or anywhere else.</li>
        <li>Every email address is at <code>demo.invalid</code>, which no mail server will
          ever accept — so a stray send cannot reach a person.</li>
      </ul>
    </div>
  </div>
</div>

{% if exists %}
<div class="ad-card">
  <div class="ad-card__head"><div class="ad-card__title" style="color:var(--ad-accent,#237b22)">
    A sandbox is live
    <small>Walk these in order — it is roughly the path a real nominee takes.</small>
  </div>
  <form method="post" action="/admin/sandbox/remove">
    <input type="hidden" name="_token" value="{{ csrf_token }}">
    <button class="ad-btn ad-btn--sm ad-btn--danger" type="submit"
      data-confirm="Remove the sandbox — the programme, its cycle, category, nominees, votes, questionnaires, evidence, interview and judge? Real data is untouched.">Remove it</button>
  </form>
  </div>
  <div class="ad-table-wrap">
    <table class="ad-table">
      <thead><tr><th scope="col">#</th><th scope="col">Screen</th></tr></thead>
      <tbody>
        {% for l in current.links %}
        <tr>
          <td style="color:var(--ad-text-mute);font-variant-numeric:tabular-nums">{{ loop.index }}</td>
          <td><a href="{{ l.href }}" style="color:var(--ad-accent,#237b22);font-weight:600">{{ l.label }} →</a>
            <br><span style="font-size:11.5px;color:var(--ad-text-mute)"><code>{{ l.href }}</code></span></td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>

{# ── THE OTHER HALF OF THE SANDBOX ────────────────────────────────────────────
   Everything above is an ADMIN screen — the half an operator can already reach, and not
   the half they are nervous about. What a nominee sees when they open the questionnaire,
   what the consent page asks before an interview, whether the judge's ballot makes sense:
   none of that is visible from the console, and all three sit behind a token or a login
   the sandbox never handed anybody.

   The judge portal was the worst of it. Judges sign in with a six-digit code EMAILED to
   them, and the sandbox judge is at demo.invalid — a domain RFC 2606 reserves precisely so
   no mail server will ever accept it. So the demo judge could not sign in AT ALL, and the
   instruction that used to sit here was to go and read var/logs/outgoing-mail.log on a host
   with no shell. #}
<div class="ad-card">
  <div class="ad-card__head"><div class="ad-card__title">The three portals
    <small>What a nominee, a judge and an interviewee actually see. None of this is reachable from the console.</small>
  </div></div>
  <div class="ad-card__body">

    {# ── the judge ─────────────────────────────────────────────────────────── #}
    <h3 style="margin:0 0 6px;font-size:14px">Sign in as the test judge</h3>
    <p style="margin:0 0 10px;font-size:12.5px;line-height:1.65;color:var(--ad-text-mute,#5a6d6f)">
      The real sign-in screen, the real code, the real fifteen-minute expiry — it just is not
      emailed, because <code>{{ doors.judge_email }}</code> is at a domain no mail server
      will ever accept.
    </p>

    {% if judge_code %}
      {# Shown once and not persisted: a code still on screen after a refresh is one still
         there when somebody walks past the desk, and it is valid for fifteen minutes. #}
      <div class="ad-callout" style="margin:0 0 12px">
        <strong>Your code — this is the only time it is shown</strong>
        <div style="font-family:var(--ag-font-mono,ui-monospace,Consolas,monospace);font-weight:700;font-size:30px;letter-spacing:.3em;padding:10px 0 4px">{{ judge_code }}</div>
        <p style="margin:0;font-size:12.5px">
          Go to <a href="{{ doors.judge_login }}" target="_blank" rel="noopener" style="color:var(--ad-accent,#237b22);font-weight:600">{{ doors.judge_login }}</a>,
          enter <code>{{ doors.judge_email }}</code>, then this code. It expires in 15 minutes.
        </p>
      </div>
    {% endif %}

    <form method="post" action="/admin/sandbox/judge-code" style="margin:0 0 20px">
      <input type="hidden" name="_token" value="{{ csrf_token }}">
      <button class="ad-btn ad-btn--sm" type="submit">{{ judge_code ? 'Get another code' : 'Get a sign-in code' }}</button>
    </form>

    {# ── the interviewee ───────────────────────────────────────────────────── #}
    <h3 style="margin:0 0 6px;font-size:14px;padding-top:16px;border-top:1px solid var(--ad-line)">The interviewee's own page</h3>
    {% if doors.interview %}
      <p style="margin:0 0 6px;font-size:12.5px;line-height:1.65;color:var(--ad-text-mute,#5a6d6f)">
        Consent, the appointment, and rescheduling — what <strong>{{ doors.interview.label }}</strong>
        opens{% if doors.interview.when %}, for the sitting on {{ doors.interview.when }}{% endif %}.
      </p>
      <a href="{{ doors.interview.href }}" target="_blank" rel="noopener"
         style="color:var(--ad-accent,#237b22);font-weight:600;font-size:13px">Open it →</a>
      <div><code style="font-size:11.5px;color:var(--ad-text-mute)">{{ doors.interview.href }}</code></div>
    {% else %}
      <p style="margin:0;font-size:12.5px;color:var(--ad-text-mute,#5a6d6f)">
        No sitting is scheduled. Rebuild the sandbox — it opens one three days out.
      </p>
    {% endif %}

    {# ── the nominee ───────────────────────────────────────────────────────── #}
    <h3 style="margin:22px 0 6px;font-size:14px;padding-top:16px;border-top:1px solid var(--ad-line)">The questionnaire, as the nominee sees it</h3>
    <p style="margin:0 0 10px;font-size:12.5px;line-height:1.65;color:var(--ad-text-mute,#5a6d6f)">
      One in each state, because they are three different experiences: a submitted one is
      read-only, a draft is the form mid-flight, and an untouched one is what a nominee meets
      on the first open. Walking one tells you nothing about the other two.
    </p>
    {% for q in doors.questionnaires %}
      <div style="padding:7px 0;border-bottom:1px solid var(--ad-line)">
        <a href="{{ q.href }}" target="_blank" rel="noopener"
           style="color:var(--ad-accent,#237b22);font-weight:600;font-size:13px">{{ q.label }}</a>
        <span style="font-size:11.5px;color:var(--ad-text-mute);margin-left:8px">{{ q.state }}</span>
        <div><code style="font-size:11.5px;color:var(--ad-text-mute)">{{ q.href }}</code></div>
      </div>
    {% else %}
      <p style="margin:0;font-size:12.5px;color:var(--ad-text-mute,#5a6d6f)">None yet — build the sandbox.</p>
    {% endfor %}
  </div>
</div>

<div class="ad-card">
  <div class="ad-card__head"><div class="ad-card__title">Rebuild it
    <small>Tears the current one down first. Pressing this is how you get a clean rehearsal.</small>
  </div>
  <form method="post" action="/admin/sandbox/build">
    <input type="hidden" name="_token" value="{{ csrf_token }}">
    <button class="ad-btn" type="submit"
      data-confirm="Rebuild the sandbox? The current one is removed first, including any scores you added to it.">Rebuild</button>
  </form>
  </div>
</div>

{% else %}
<div class="ad-card">
  <div class="ad-card__head"><div class="ad-card__title">No sandbox yet</div>
  <form method="post" action="/admin/sandbox/build">
    <input type="hidden" name="_token" value="{{ csrf_token }}">
    <button class="ad-btn ad-btn--primary" type="submit">Build it</button>
  </form>
  </div>
  <div class="ad-card__body">
    <p style="margin:0;font-size:13px;color:var(--ad-text-soft)">
      Takes a moment. When it is done this page lists every screen the sandbox makes
      reachable, so you can click straight through instead of hunting for the rows.
    </p>
  </div>
</div>
{% endif %}

{% endblock %}
