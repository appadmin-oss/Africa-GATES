{% extends "admin/layout.twig" %}
{% block topbar_title %}Referral payouts{% endblock %}

{#
  Paying members what their referrals earned.

  ── WHY THE REFERENCE FIELD IS REQUIRED ──────────────────────────────────────
  Marking one paid writes paid_out_at on the credits it covers, and that column is the
  whole definition of "owed" everywhere else. So it is a claim that money moved. The
  transfer reference is what a bank statement can be reconciled against; without it,
  "paid" means only that somebody clicked — and the evidence that they had NOT been
  paid is gone.

  Plain form posts, no Alpine: this is the screen where somebody is moving money and
  reading a bank app on their phone at the same time.
#}
{% block content %}
<style nonce="{{ csp_nonce }}">
  .po-note{margin:0 0 14px;font-size:12.5px;line-height:1.6;color:#5a6d6f;max-width:88ch}
  .po-kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px;margin-bottom:16px}
  .po-kpi{border:1px solid rgba(16,41,44,.1);border-radius:10px;padding:12px 14px;background:#fff}
  .po-kpi__l{font-size:10.5px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:#5a6d6f}
  .po-kpi__v{font-size:23px;font-weight:800;margin-top:4px;line-height:1.1}
  .po-card{border:1px solid rgba(16,41,44,.12);border-radius:11px;padding:14px 16px;margin-bottom:12px;background:#fff}
  .po-head{display:flex;gap:12px;flex-wrap:wrap;align-items:baseline;justify-content:space-between;margin-bottom:10px}
  .po-amt{font-size:21px;font-weight:800}
  .po-bank{font-size:12.5px;line-height:1.7;color:#43473f;background:#f7f9f7;border-radius:8px;padding:9px 12px;margin:0 0 12px}
  .po-bank b{font-variant-numeric:tabular-nums;letter-spacing:.04em}
  .po-acts{display:flex;gap:16px;flex-wrap:wrap;align-items:flex-end}
  .po-acts form{display:flex;gap:8px;align-items:flex-end;flex-wrap:wrap}
  .po-acts label{font-size:11.5px;font-weight:700;color:#5a6d6f}
  .po-acts input{display:block;font:inherit;font-size:13px;padding:7px 9px;margin-top:3px;
    border:1px solid rgba(16,41,44,.18);border-radius:7px;min-width:190px}
  .po-pill{display:inline-block;border-radius:999px;padding:2px 10px;font-size:11px;font-weight:700}
  .po-requested{background:#fff3d6;color:#8a6100}
  .po-paid{background:#e4f5e3;color:#177015}
  .po-rejected{background:#f3eeee;color:#7a5252}
  .po-tabs{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px}
  .po-tabs a{border:1px solid rgba(16,41,44,.14);background:#fff;color:#10292c;border-radius:999px;
    padding:6px 14px;font-size:12.5px;font-weight:600;text-decoration:none}
  .po-tabs a.is-on{background:#237b22;border-color:transparent;color:#fff}
</style>

<p class="po-note">
  Members withdraw by bank transfer. You move the money however the organisation normally
  does, then record the transfer reference here — that is what stamps the commission as
  settled. Nothing on this page moves money by itself.
  The smallest withdrawal is ₦{{ min_naira|number_format }}.
</p>

<div class="po-kpis">
  <div class="po-kpi">
    <div class="po-kpi__l">Waiting to be paid</div>
    <div class="po-kpi__v">₦{{ totals.pending_naira|number_format }}</div>
    <div style="font-size:12px;color:#5a6d6f;margin-top:3px">{{ totals.pending|number_format }} request{{ totals.pending == 1 ? '' : 's' }}</div>
  </div>
  <div class="po-kpi">
    <div class="po-kpi__l">Paid all time</div>
    <div class="po-kpi__v">₦{{ totals.paid_naira|number_format }}</div>
  </div>
  <div class="po-kpi">
    <div class="po-kpi__l">Owed but not requested</div>
    <div class="po-kpi__v">₦{{ (liability.payable_naira - totals.pending_naira) > 0 ? (liability.payable_naira - totals.pending_naira)|number_format : 0 }}</div>
    <div style="font-size:12px;color:#5a6d6f;margin-top:3px">members past the threshold who have not asked yet</div>
  </div>
</div>

<div class="po-tabs">
  {% for key, label in statuses %}
    <a href="/admin/payouts?status={{ key }}" class="{{ status == key ? 'is-on' : '' }}">{{ label }}</a>
  {% endfor %}
  <a href="/admin/payouts?status=all" class="{{ status == 'all' ? 'is-on' : '' }}">All</a>
</div>

{% if rows %}
  {% for r in rows %}
    {% set p = r.row %}
    <div class="po-card">
      <div class="po-head">
        <div>
          <strong>{{ r.name }}</strong>
          {% if r.email %}<span style="color:#5a6d6f;font-size:12px"> · {{ r.email }}</span>{% endif %}
          <br><span style="color:#5a6d6f;font-size:11.5px">
            requested {{ p.requested_at ? p.requested_at|slice(0,16) : '—' }}
            {% if p.settled_at %} · settled {{ p.settled_at|slice(0,16) }}{% endif %}
          </span>
        </div>
        <div style="text-align:right">
          <div class="po-amt">₦{{ p.amount_naira|number_format }}</div>
          <span class="po-pill po-{{ p.status }}">{{ statuses[p.status]|default(p.status) }}</span>
        </div>
      </div>

      <p class="po-bank">
        {{ p.bank_name }} · {{ p.account_name }} · <b>{{ p.account_number }}</b>
      </p>

      {% if p.status == 'requested' %}
        <div class="po-acts">
          <form method="post" action="/admin/payouts/{{ p.id }}/pay">
            <input type="hidden" name="_token" value="{{ csrf_token }}">
            <label>Transfer reference
              <input type="text" name="reference" required maxlength="120" placeholder="e.g. GTB/2026/08/44192">
            </label>
            <button class="ad-btn ad-btn--primary" type="submit">Record as paid</button>
          </form>
          <form method="post" action="/admin/payouts/{{ p.id }}/reject">
            <input type="hidden" name="_token" value="{{ csrf_token }}">
            <label>Or refuse, with a reason
              <input type="text" name="why" required maxlength="400" placeholder="e.g. account name does not match">
            </label>
            <button class="ad-btn" type="submit">Refuse</button>
          </form>
        </div>
        <p class="po-note" style="margin:10px 0 0">
          Transfer the money first, then record it. Refusing leaves the balance owed — the
          usual reason is bank details that do not match, and the member can correct them
          and ask again.
        </p>
      {% else %}
        <p class="po-note" style="margin:0">
          {% if p.payment_ref %}Reference <strong>{{ p.payment_ref }}</strong>.{% endif %}
          {% if p.note %}{{ p.note }}{% endif %}
        </p>
      {% endif %}
    </div>
  {% endfor %}
{% else %}
  <p style="color:#5a6d6f">
    {% if status == 'requested' %}
      No withdrawals waiting. Members request them from their own account page once they
      pass the referral threshold.
    {% else %}
      Nothing here yet.
    {% endif %}
  </p>
{% endif %}
{% endblock %}
