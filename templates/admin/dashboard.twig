{% extends "admin/layout.twig" %}
{#
  HOME — destroyed and rebuilt 4 Oct 2026 from the admin handoff (README §3,
  `01-admin-1.jpg`, `01-admin-5.jpg`). What the old dashboard carried and where each
  thing went: docs/handoff/inventory/_admin.md.

  Top to bottom: the hero (heading, ask box, shortcut tiles), "N things need a person",
  "The quiet numbers". Every figure is real (HomeBoard), and every tile and card is one
  this role can open — "Only jobs you can act on are shown" is true by construction.
#}
{% block content %}
<section class="cn-hero" aria-labelledby="cnHeroH">
  <h2 class="cn-hero__h" id="cnHeroH">What needs doing today?</h2>

  {# A real form to the assistant's own page, so it works with no script; with the
     drawer present admin.js opens it with the question instead. #}
  <form class="cn-ask" method="get" action="/admin/assistant" data-ag-do="hero-ask" role="search">
    <label for="cnHeroQ" class="sr-only">Ask the assistant</label>
    <input id="cnHeroQ" name="q" type="text" maxlength="2000" autocomplete="off" placeholder="Ask about the queue, money, results…">
    <button type="submit" class="cn-send" aria-label="Ask">↑</button>
  </form>

  {% if shortcuts %}
    <ul class="cn-tiles" aria-label="Shortcuts">
      {% for t in shortcuts %}
        <li>
          <a class="cn-tile" href="{{ t.href }}">
            <span class="cn-tile__box">
              <svg aria-hidden="true" focusable="false"><use href="#ic-{{ t.icon }}"/></svg>
              {% if t.badge %}<span class="cn-tile__badge{% if t.tone == 'danger' %} cn-tile__badge--danger{% endif %}">{{ t.badge }}<span class="sr-only"> waiting</span></span>{% endif %}
            </span>
            <span class="cn-tile__l">{{ t.label }}</span>
          </a>
        </li>
      {% endfor %}
    </ul>
  {% endif %}
</section>

<section class="cn-sec" aria-labelledby="cnBoardH">
  <div class="cn-sec__h">
    <h2 class="cn-sec__t" id="cnBoardH">{{ board|length }} thing{{ board|length == 1 ? '' : 's' }} need{{ board|length == 1 ? 's' : '' }} a person</h2>
    <span class="cn-sec__n">Only jobs you can act on are shown</span>
  </div>
  {% if board is empty %}
    <div class="cn-empty">
      <span class="cn-empty__t">Nothing is waiting on you</span>
      <span class="cn-empty__m">Jobs appear here the moment something needs a person.</span>
    </div>
  {% else %}
    <ul class="cn-board">
      {% for b in board %}
        <li class="cn-job cn-job--{{ b.tone }}">
          <span class="cn-job__n">{{ b.count|number_format }}</span>
          <div class="cn-job__t">
            <span class="cn-job__hub">{{ b.hub }}</span>
            <span class="cn-job__l">{{ b.label }}</span>
            <p class="cn-job__w">{{ b.why }}</p>
          </div>
          <a class="cn-pillbtn cn-pillbtn--sm" href="{{ b.href }}">{{ b.cta }}<span class="sr-only">: {{ b.label }}</span></a>
        </li>
      {% endfor %}
    </ul>
  {% endif %}
</section>

<section class="cn-sec" aria-labelledby="cnQuietH">
  <h2 class="cn-quiet__t" id="cnQuietH">The quiet numbers</h2>
  <dl class="cn-quiet">
    {% for p in quiet %}
      <div class="cn-quiet__c">
        <dt>{{ p.k }}</dt>
        <dd class="cn-quiet__v">{{ p.v }}</dd>
        <dd class="cn-quiet__note">{{ p.n }}</dd>
      </div>
    {% endfor %}
  </dl>
</section>
{% endblock %}
