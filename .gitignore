.env
/vendor/
var/cache/twig/*.php
var/data/
public/assets/vendor/*.map
var/logs/

# Off-host build output + user uploads (not committed)
public/assets/dist/
# `public/uploads/*`, not `public/uploads/` — git cannot re-include a file whose
# PARENT DIRECTORY is excluded, so the directory form made the negation below
# impossible. That is why public/uploads/.htaccess — the "Layer 2" the root
# .htaccess has always pointed at — did not exist in any deployment: it could not
# be committed. The uploaded files themselves stay ignored.
public/uploads/*
!public/uploads/.htaccess

# OS / editor
.DS_Store
Thumbs.db

# Local Composer binary (tool, not project code)
composer.phar

# PHPUnit cache
.phpunit.cache/

# Node modules — only the browser QA tools in tools/browser and tools/qa need
# these, and they are installed on demand (npm i --no-save playwright). Nothing
# the application serves comes from here, and Chromium already ships with the
# environment at /opt/pw-browsers.
/node_modules/
package-lock.json
